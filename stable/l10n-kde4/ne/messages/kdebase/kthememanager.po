#: knewthemedlg.cpp:31
msgid "New Theme"
msgstr "नयाँ विषयवस्तु"

#: kthememanager.cpp:62
msgid "KDE Theme Manager"
msgstr "केडीई विषयवस्तु प्रबन्धक"

#: kthememanager.cpp:63 kthememanager.cpp:69
msgid ""
"This control module handles installing, removing and creating visual KDE "
"themes."
msgstr ""
"यो नियन्त्रण मोड्युलले दृश्यात्मक केडीई विषयवस्तुहरू स्थापना, हटाइ र सिर्जना ह्यान्डल गर्दछ ।"

#: kthememanager.cpp:65
msgid "(c) 2003, 2004 Lukáš Tinkl"
msgstr "(c) 2003, 2004 लुकास टिन्कल"

#: kthememanager.cpp:266
msgid "Theme Files"
msgstr "विषयवस्तु फाइल"

#: kthememanager.cpp:267
msgid "Select Theme File"
msgstr "विषयवस्तु फाइल चयन गर्नुहोस्"

#: kthememanager.cpp:301
#, kde-format
msgid "Do you really want to remove the theme <b>%1</b>?"
msgstr "तपाईँ साँच्चै<b>%1</b> विषयवस्तु हटाउन चाहनुहुन्छ ?"

#: kthememanager.cpp:302
msgid "Remove Theme"
msgstr "विषयवस्तु हटाउनुहोस्"

#: kthememanager.cpp:324
msgid "My Theme"
msgstr "मेरो विषयवस्तु"

#: kthememanager.cpp:335
#, kde-format
msgid "Theme %1 already exists."
msgstr "%1 विषयवस्तु पहिले नै अवस्थित छ ।"

#: kthememanager.cpp:355
#, kde-format
msgid "Your theme has been successfully created in %1."
msgstr "तपाईँको विषयवस्तु सफलतापूर्वक %1 मा सिर्जना भयो ।"

#: kthememanager.cpp:356
msgid "Theme Created"
msgstr "विषयवस्तु सिर्जना गरियो"

#: kthememanager.cpp:358
msgid "An error occurred while creating your theme."
msgstr "तपाईँको विषयवस्तु सिर्जना गर्दा त्रुटि देखा पर्यो ।"

#: kthememanager.cpp:359
msgid "Theme Not Created"
msgstr "विषयवस्तु सिर्जना गरिएन"

#: kthememanager.cpp:386
msgid "This theme does not contain a preview."
msgstr "यो विषयवस्तुले पूर्वावलोकन समावेश गर्दैन ।"

#: kthememanager.cpp:390
#, kde-format
msgid "Author: %1<br />Email: %2<br />Version: %3<br />Homepage: %4"
msgstr "लेखक: %1<br />इमेल: %2<br>संस्करण: %3<br>गृहपृष्ठ: %4"

