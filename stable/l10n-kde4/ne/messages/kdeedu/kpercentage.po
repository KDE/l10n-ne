#: kpercentage.cpp:84
msgid "Number of tasks:"
msgstr "कार्यको सङ्ख्या:"

#: kpercentage.cpp:85
msgid "Level:"
msgstr "स्तर:"

#: kpercentage.cpp:86
msgid "Choose an exercise type:"
msgstr "एउटा अभ्यास प्रकार रोज्नुहोस्:"

#: kpercentage.cpp:94
#, no-c-format
msgid "x% &of ?? = y"
msgstr "x% को ?? = y"

#: kpercentage.cpp:96
#, no-c-format
msgid "x% of &y = ??"
msgstr "x% को y = ??"

#: kpercentage.cpp:98
#, no-c-format
msgid "??% o&f x = y"
msgstr "??% को x = y"

#: kpercentage.cpp:99
msgid "??"
msgstr "??"

#: kpercentage.cpp:104
msgid "E&xit"
msgstr "अन्त्य गर्नुहोस्"

#: kpercentage.cpp:108
msgid "Easy"
msgstr "सजिलो"

#: kpercentage.cpp:109
msgid "Medium"
msgstr "मध्यम"

#: kpercentage.cpp:110
msgid "Crazy"
msgstr "उत्तेजित"

#: kpercentage.cpp:183
msgid "Exercises with base value omitted"
msgstr "हटाएको आधार मानसँग अभ्यास गर्दछ"

#: kpercentage.cpp:184
msgid "Exercises with percent value omitted"
msgstr "हटाएको प्रतिशत मानसँग अभ्यास गर्दछ"

#: kpercentage.cpp:185
msgid "Exercises with percentage omitted"
msgstr "हटाएको प्रतिशतसँग अभ्यास गर्दछ"

#: kpercentage.cpp:186
msgid "Several exercise types in random"
msgstr "अनियमित रूपमा विभिन्न अभ्यास प्रकार"

#: kpercentage.cpp:187
msgid "Choose the number of exercises from 1 to 10."
msgstr "१ देखि १० सम्म अभ्यासको सङ्ख्या रोज्नुहोस् ।"

#: kpercentage.cpp:188
msgid "Choose the level of difficulty."
msgstr "कठिनताको तह रोज्नुहोस् ।"

#: kpercentage.cpp:189 kpercentage.cpp:200
msgid "Close KPercentage."
msgstr "केडीई प्रतिशत बन्द गर्नुहोस् ।"

#: kpercentage.cpp:190 kpercentage.cpp:201
msgid "Get some help."
msgstr "केही मद्दत प्राप्त गर्नुहोस् ।"

#: kpercentage.cpp:194
msgid ""
"Click here to start a sequence of exercises where the base value is omitted."
msgstr "अभ्यासको क्रम सुरु गर्न यहाँ क्लिक गर्नुहोस् जहाँ आधार मान हटाइएको हुन्छ ।"

#: kpercentage.cpp:195
msgid ""
"Click here to start a sequence of exercises where the percent value is "
"omitted."
msgstr "अभ्यासको क्रम सुरु गर्न यहाँ क्लिक गर्नुहोस् जहाँ प्रतिशत मान हटाइएको हुन्छ ।"

#: kpercentage.cpp:196
msgid ""
"Click here to start a sequence of exercises where the percentage is omitted."
msgstr "अभ्यासको क्रम सुरु गर्न यहाँ क्लिक गर्नुहोस् जहाँ प्रतिशत हटाइएको हुन्छ ।"

#: kpercentage.cpp:197
msgid ""
"Click here to start a sequence of exercises where one value is omitted at "
"random."
msgstr ""
"अभ्यासको क्रम सुरु गर्न यहाँ क्लिक गर्नुहोस् जहाँ एउटा मान अनियमित रूपमा हटाइएको छ ।"

#: kpercentage.cpp:198
msgid "Here you can adjust the number of exercises from 1 to 10."
msgstr "यहाँ तपाईँ १ देखि १० सम्म अभ्यासको सङ्ख्या समायोजन गर्न सक्नुहुन्छ ।"

#: kpercentage.cpp:199
msgid "Choose one of the levels <i>easy</i>, <i>medium</i>, and <i>crazy</i>."
msgstr "कुनै एउटा तह <i>सजिलो</i>, <i>मध्यम</i>, र <i>उत्तेजित</i> रोज्नुहोस् ।"

#: main.cpp:30
msgid "A program to improve your skills in calculating with percentages"
msgstr "प्रतिशतसँगै तपाईँको गणना गर्ने दक्षता सुधार गर्नको लागि कार्यक्रम"

