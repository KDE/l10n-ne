msgstr "ग्रिडमा पर्दा विभाजन गर्दछ, र तिनीहरूलाई टिप्दछ । डान बोर्नस्टेनद्वारा लिखित ।"

#: hacks/config/twang.xml.h:6
msgid "Jumpy"
