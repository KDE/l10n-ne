#: gamelogic.cc:180
#, kde-format
msgid "The once mighty empire of %1 has fallen in ruins."
msgstr "एकपटक %1 शक्तिशाली अधिपत्यको पतन भयो ।"

#: gamelogic.cc:187
#, kde-format
msgid "The fallen empire of %1 has staggered back to life."
msgstr "%1 को पतन अधिपत्य पुन: जीवनमा फर्कन सन्देह गर्यो ।"

#: gamelogic.cc:208
#, kde-format
msgid "Reinforcements (1 ship) have arrived for planet %2."
msgid_plural "Reinforcements (%1 ships) have arrived for planet %2."
msgstr[0] "%2 ग्रहका लागि थप शक्ति (1 जहाज) आईपुगेको छ ।"
msgstr[1] "%2 ग्रहका लागि थप शक्ति (%1 जहाज) आईपुगेको छ ।"

#: gamelogic.cc:258
#, kde-format
msgid "Planet %2 has held against an attack from %1."
