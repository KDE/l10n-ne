#: kio_finger.cpp:153
msgid "Could not find the Perl program on your system, please install."
msgstr "तपाईँको प्रणालीमा पर्ल कार्यक्रम फेला पार्न सकेन, कृपया स्थापना गर्नुहोस् ।"

#: kio_finger.cpp:166
msgid "Could not find the Finger program on your system, please install."
msgstr "तपाईँको प्रणालीमा फिङ्गर कार्यक्रम फेला पार्न सकेन, कृपया स्थापना गर्नुहोस् ।"

#: kio_finger.cpp:179
msgid "kio_finger Perl script not found."
msgstr "किव फिङ्गर पर्ल लिपि फेला परेन ।"

#: kio_finger.cpp:191
msgid "kio_finger CSS script not found. Output will look ugly."
msgstr "किव फिङ्गर CSS लिपि फेला परेन । प्रतिफल नराम्रो देखिने छ ।"
