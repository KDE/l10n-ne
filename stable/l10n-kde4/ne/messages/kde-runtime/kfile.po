msgstr "कार्स्टेन पिफिफर"

#: fileprops.cpp:245
#, kde-format
msgid "Do not print the mimetype of the given file(s)"
msgstr "दिएको फाइल(हरू)को माइमप्रकार मुद्रण नगर्नुहोस्"

#: fileprops.cpp:247
#, kde-format
msgid "List all supported metadata keys."
msgstr "समर्थित सबै मेटाडेटा कुञ्जी सुचीकृत गर्नुहोस् ।"

#: fileprops.cpp:249
#, kde-format
msgid "List all metadata keys which have a value in the given file(s)."
msgstr "दिएका फाइल(हरू) मा मान भएका सबै मेटाडेटा कुञ्जी सूचीकृत गर्नुहोस् ।"

#: fileprops.cpp:252
#, kde-format
msgid ""
"Do not print a warning when more than one file was given and they do not all "
"have the same mimetype."
msgstr ""
"एकभन्दा बढी फाइल दिएको र तिनीहरूसँग समान माइमप्रकार नहुँदा सावधानी मुद्रण नगर्नुहोस् ।"

#: fileprops.cpp:255
#, kde-format
msgid "Prints all metadata values, available in the given file(s)."
msgstr "दिएका फाइल(हरू) मा उपलब्ध भएका सबै मेटाडेटा मान मुद्रण गर्दछ ।"

#: fileprops.cpp:257
#, kde-format
msgid ""
"Opens a KDE properties dialog to allow viewing and modifying of metadata of "
"the given file(s)"
msgstr ""
"दिएका फाइल(हरू) का मेटाडेटा हेर्न र परिमार्जन गर्न अनुमति दिन केडीई गुण संवाद खोल्छ ।"

#: fileprops.cpp:259
#, kde-format
msgid ""
"Prints the value for 'key' of the given file(s). 'key' may also be a comma-"
"separated list of keys"
msgstr ""
"दिएका फाइल(हरू) का 'कुञ्जी' मा मान मुद्रण गर्छ । 'कुञ्जी' अल्पविराम-विभाजित कुञ्जीको "
"सूची हुन सक्छ ।"

#: fileprops.cpp:261
#, kde-format
msgid ""
"Attempts to set the value 'value' for the metadata key 'key' for the given "
"file(s)"
msgstr ""
"दिएका फाइल(हरू) का लागि 'key' कुञ्जी मेटाडेटाका लागि मान 'value' सेट गर्ने प्रयास गर्छ "
"।"

#: fileprops.cpp:263
#, kde-format
msgid "The file (or a number of files) to operate on."
msgstr "यसमा सञ्चालनका लागि फाइल (वा फाइलहरूका सङ्ख्या) ।"

#: fileprops.cpp:277
#, kde-format
msgid "No files specified"
msgstr "फाइल निर्दिष्ट गरिएको छैन"

#: fileprops.cpp:297
#, kde-format
msgid "Cannot determine metadata"
msgstr "मेटाडेटा निर्धारण गर्न सकिँदैन"
