#: kvaio.cpp:156
msgid "Memory Stick inserted"
msgstr "स्मृति स्टिक घुसाइयो"

#: kvaio.cpp:159
msgid "Memory Stick ejected"
msgstr "स्मृति स्टिक निकालियो"

#: kvaio.cpp:168
msgid "Unhandled event: "
msgstr "ह्यान्डल नगरिएको घटना: "

#: kvaio.cpp:417
msgid "AC Connected"
msgstr "AC जडान गरियो"

#: kvaio.cpp:417
msgid "AC Disconnected"
msgstr "AC जडान विच्छेद गरियो"

#: kvaio.cpp:423
msgid "Battery is Fully Charged. "
msgstr "ब्याट्री पूर्ण चार्ज भयो ।"

#: kvaio.cpp:430
#, kde-format
msgid "Caution: Battery is Almost Empty (%1% remaining)."
msgstr "सावधान: ब्याट्री लगभग खाली छ (%1% बाँकी) ।"

#: kvaio.cpp:433
msgid "Alert: Battery is Empty"
msgstr "सावधान: ब्याट्री खाली छ"

#: kvaio.cpp:436
msgid "No Battery Inserted."
msgstr "ब्याट्री घुसाएको छैन ।"

#: kvaio.cpp:439
#, kde-format
msgid "Remaining Battery Capacity: %1%"
msgstr "ब्याट्रीको बाँकी क्षमता: %1%"

#: kvaio.cpp:464 kvaio.cpp:477
msgid "Brightness"
msgstr "चम्किलोपन"

#: kvaio.cpp:485
msgid "Volume"
msgstr "भोल्युम"

#: kvaio.cpp:522 kvaio.cpp:587
msgid "It seems that KMix is not running."
msgstr "केडीई मिक्स चलिरहेको जस्तो देखिदैन ।"

#: kvaio.cpp:565
msgid "Starting KMix..."
msgstr "केडीई मिक्स सुरु गर्दैछ..."

#: kvaio.cpp:608
msgid "Mute on"
msgstr "मौन पार्नुहोस्"

#: kvaio.cpp:611
msgid "Mute off"
msgstr "मौन हटाउनुहोस्"

