msgstr "*|सादा पाठ फाइल"

#: pwmanager/pwm.cpp:744 pwmanager/pwm.cpp:837
msgid ""
"Error: unable to write to file.\n"
"Please check if you have permission to write to the file in that directory."
msgstr ""
"त्रुटि: फाइलमा लेख्न असक्षम।\n"
"कृपया जाँच गर्नुहोस् यदि तपाईं सँग त्यो डाइरेक्टरीको फाइलमा लेख्ने अनुमति छ कि "
"छैन।"

#: pwmanager/pwm.cpp:747 pwmanager/pwm.cpp:840 pwmanager/pwmdocui.cpp:108
#: pwmanager/pwmdocui.cpp:150
msgid "Error While Writing"
msgstr "लेख्ने क्रममा त्रुटि"

#: pwmanager/pwm.cpp:749 pwmanager/pwm.cpp:842 pwmanager/pwm.cpp:868
#: pwmanager/pwm.cpp:1138
msgid "Successfully exported data."
msgstr "डेटा सफलतापूर्वक निर्यात गरियो।"

#: pwmanager/pwm.cpp:757 pwmanager/pwm.cpp:879 pwmanager/pwm.cpp:965
#: pwmanager/pwm.cpp:1147
msgid ""
"Do you want to import the data into the current document? (If you select "
"\"no\", a new document will be opened.)"
msgstr ""
"के तपाईं हालको कागजातमा डेटा आयात गर्न चाहनुहुन्छ? (यदि तपाईंले \"no\" चयन "
"गर्नुभयो भने, नयाँ कागजात खोलिन्छ।)"

#: pwmanager/pwm.cpp:761 pwmanager/pwm.cpp:883 pwmanager/pwm.cpp:969
#: pwmanager/pwm.cpp:1151
msgid "Import into This Document?"
msgstr "यो कागजातमा आयात गर्न चाहनुहुन्छ?"

#: pwmanager/pwm.cpp:777
msgid "*|PwManager Exported Text File"
msgstr "*|PwManager निर्यात गरिएको पाठ फाइल"

#: pwmanager/pwm.cpp:785
msgid ""
"Could not read file format.\n"
"This seems to be _not_ a valid file exported by PwM."
msgstr ""
"फाइल ढाँचा पढ्न सकिँदैन।\n"
"यसलाई हेर्दा पासवर्ड व्यवस्थापक द्वारा वैध _फाइल_ होइन देखिन्छ।"

#: pwmanager/pwm.cpp:788
msgid "Invalid File Format"
msgstr "अवैध फाइल ढाँचा"

#: pwmanager/pwm.cpp:795
msgid ""
"Could not import file.\n"
"Do you have permission to read this file? Do you have enough free memory?"
msgstr ""
"फाइल आयात गर्न सकिँदैन।\n"
"के तपाईंसँग यो फाइल पढ्ने अनुमति छ? के तपाईंसँग पर्याप्त खाली ठाउँ छ?"

#: pwmanager/pwm.cpp:798 pwmanager/pwm.cpp:920
msgid "Import Failed"
msgstr "आयात असफल भयो"

#: pwmanager/pwm.cpp:823 pwmanager/pwm.cpp:899
msgid "*|GPasman or KPasman File"
msgstr "*|GPasman वा KPasman फाइल"

#: pwmanager/pwm.cpp:865
msgid "Successfully exported the data of the current document to KWallet."
msgstr "केवालेटमा हालको कागजातको डेटा सफलतापूर्वक निर्यात गरियो"

#: pwmanager/pwm.cpp:867
msgid "Successfully Exported Data"
msgstr "सफलतापूर्वक डेटा निर्यात गरियो"

#: pwmanager/pwm.cpp:906
msgid ""
"You have probably typed in the wrong master password.\n"
"There is no way of accurately determining the correctness of the password in "
"the Gpasman file format, but it is likely that it is wrong.\n"
"Do you want to continue regardless?"
msgstr ""
"तपाईंले सम्भावित तरिकाले गलत पासवर्ड टाइप गर्नुभयो।\n"
"त्यहाँ जिपासमान फाइल ढाँचामा पासवर्डको सुधारता गर्न कुनै यथार्थता निर्दिष्ट "
"गर्ने बाटो छैन, तर यसको मतलब त्यो गलत हो।\n"
"के तपाईं लापरवाहलाई सुचारू गर्न चाहनुहुन्छ?"

#: pwmanager/pwm.cpp:912
msgid "Password Error"
msgstr "पासवर्ड त्रुटि"

#: pwmanager/pwm.cpp:918
msgid ""
"Could not import file;\n"
"do you have permission to read it?"
msgstr ""
"फाइल आयात गर्न सकिँदैन;\n"
"के तपाईंसँग यो पढ्ने अनुमति छ?"

#: pwmanager/pwm.cpp:940
msgid ""
"KWallet emulation is enabled.\n"
"You cannot import or export data from/to the original KWallet, while the "
"emulation is active.\n"
"Do you want to temporary disable the KWallet emulation?"
msgstr ""
"केवालेट यंत्रानुकरण सक्षम गरियो।\n"
"तपाईं सक्कली केवालेटबाट/मा डेटा आयात वा निर्यात गर्न सक्नुहुन्न, जबसम्म "
"यंत्रानुकरण सक्षम हुँदैन।\n"
"के तपाईं अस्थायी रूपमा केवालेट यंत्रानुकरण असक्षम गर्न चाहनुहुन्छ?"

#: pwmanager/pwm.cpp:945
msgid "Temporarily Disable KWallet Emulation?"
msgstr "अस्थायी रूपमा केवालेट यंत्रानुकरण असक्षम गर्न चाहनुहुन्छ?"

#: pwmanager/pwm.cpp:986
msgid "KWallet import failed"
msgstr "केवालेट आयात असफल भयो"

#: pwmanager/pwm.cpp:990
msgid "Successfully imported the KWallet data into the current document."
msgstr "हालको कागजातमा केवालेट डेटा सफलतापूर्वक आयात गरियो।"

#: pwmanager/pwm.cpp:992 pwmanager/pwm.cpp:1178
msgid "Successfully Imported"
msgstr "सफलतापूर्वक आयात गरियो"

#: pwmanager/pwm.cpp:993 pwmanager/pwm.cpp:1179
msgid "Successfully imported"
msgstr "सफलतापूर्वक आयात गरियो"

