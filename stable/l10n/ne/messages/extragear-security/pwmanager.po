#: pwmanager/pwm.cpp:1171
msgid "CSV file import failed."
msgstr "CSV फाइल आयात असफल भयो।"

#: pwmanager/pwm.cpp:1176
msgid "Successfully imported the CSV data into the current document."
msgstr "हालको कागजातमा CSV डेटा सफलतापूर्वक आयात गरियो।"

#: pwmanager/subtbleditimpl.cpp:37
