msgid "Entry Already Exists"
msgstr "द्रष्टव्य पहिले नै अवस्थित छ"

#: pwmanager/pwm.cpp:544
msgid ""
"The maximum possible number of entries has been reached: you cannot add more "
"entries."
msgstr ""
"द्रष्टव्यको अधिकतम सम्भावित सङ्ख्या पुग्यो: तपाई बढि द्रष्टव्य थप गर्न "
"सक्नुहुन्न।"

#: pwmanager/pwm.cpp:546
msgid "Maximum Number of Entries"
msgstr "द्रष्टव्यको अधिकतम सङ्ख्या"

#: pwmanager/pwm.cpp:617
msgid ""
"Could not edit the entry;\n"
"maybe you changed the category and this entry is already present in the new "
"category?"
msgstr ""
"द्रष्टव्य सम्पादन गर्न सकिँदैन;\n"
"पक्कै पनि तपाईंले कोटि परिवर्तन गर्नुभयो र यो द्रष्टव्य पहिले नै नयाँ कोटिमा "
"उपस्थित भइसक्यो?"

#: pwmanager/pwm.cpp:621
msgid "Could Not Edit Entry"
msgstr "द्रष्टव्य सम्पादन गर्न सकिँदैन"

#: pwmanager/pwm.cpp:654
msgid "Do you really want to delete the selected entry \"%1\"?"
msgstr "के तपाई साँच्चै चयन द्रष्टव्य \"%1\" मेटाउन चाहनुहुन्छ?"

#: pwmanager/pwm.cpp:654
msgid "Delete?"
msgstr "मेटाउनुहुन्छ?"

#: pwmanager/pwm.cpp:727 pwmanager/pwm.cpp:816 pwmanager/pwm.cpp:855
#: pwmanager/pwm.cpp:1118
