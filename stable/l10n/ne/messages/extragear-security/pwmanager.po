msgstr "\"Launcher\" कार्यन्वयन गर्नुहोस्।"

#: pwmanager/pwm.cpp:1028
msgid "ERROR: Could not execute the \"Launcher\"."
msgstr "ERROR: \"Launcher\" कार्यन्वयन गर्न सकिँदैन।"

#: pwmanager/pwm.cpp:1042
msgid "Started browser with current URL."
msgstr "हालको यूआरएलसँग ब्राउजर शुरू गर्नुहोस्।"

#: pwmanager/pwm.cpp:1044
msgid "ERROR: Could not start browser; maybe the URL is invalid?"
msgstr "ERROR: ब्राउजर शुरू गर्न सकिँदैन; पक्कै पनि यूआरएल अबैध हुनसक्छ?"

#: pwmanager/pwm.cpp:1125 pwmanager/pwm.cpp:1164
msgid "*|CSV Text File"
msgstr "*|CSV पाठ फाइल"

#: pwmanager/pwm.cpp:1135
