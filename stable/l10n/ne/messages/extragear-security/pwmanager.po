#: pwmanager/pwm.cpp:785
msgid ""
"Could not read file format.\n"
"This seems to be _not_ a valid file exported by PwM."
msgstr ""
"फाइल ढाँचा पढ्न सकिँदैन ।\n"
"यो पासवर्ड प्रबन्धकद्वारा निर्यात गरेको वैध फाइल होइन जस्तो देखिन्छ ।"

#: pwmanager/pwm.cpp:788
msgid "Invalid File Format"
