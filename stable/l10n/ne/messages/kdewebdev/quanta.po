#: rc.cpp:4605 rc.cpp:4694
#, no-c-format
msgid "Forms"
msgstr "फारम"

#. i18n: file extrafiles line 385
#: rc.cpp:4608 rc.cpp:4744 rc.cpp:4821
#, no-c-format
msgid ""
"The <b>B</b> element suggests that text be rendered as <i>bold text</i>.\n"
"     "
"<br>- common attributes\n"
"   "
msgstr ""
"<b>B</b> तत्वले पाठ <i>बाक्लो पाठ</i> का रुपमा बदलिने सुझाव गर्छ ।\n"
"     "
"<br>- साझा विशेषताहरू\n"
"   "

#. i18n: file extrafiles line 392
#: rc.cpp:4613 rc.cpp:4749 rc.cpp:4826
#, no-c-format
msgid ""
"The <b>I</b> element suggests that text be rendered as <i>italic text</i>.\n"
"     "
"<br>- common attributes\n"
"   "
msgstr ""
"<b>I</b> तत्वले पाठ <i>छड्के पाठ</i> का रुपमा बदलिने सङ्केत गर्छ ।\n"
"     "
"<br>- साझा विशेषताहरू\n"
"   "

#. i18n: file extrafiles line 401
#: rc.cpp:4618 rc.cpp:4754 rc.cpp:4831
#, no-c-format
msgid ""
"The <b>U</b> element, deprecated in HTML 4.0, suggests that text be rendered as "
"<i>underlined text</i>.\n"
"     "
"<br>- common attributes\n"
"   "
msgstr ""
"एचटीएमएल ४.० मा अनुचित ठानिएको, <b>U</b> तत्वले, पाठ <i>अधोरेखित पाठ</i> "
"का रुपमा बदलिने सुझाव गर्छ ।\n"
"     "
"<br>- साझा विशेषताहरू\n"
"   "

#. i18n: file extrafiles line 408
#: rc.cpp:4623 rc.cpp:4759 rc.cpp:4836
#, no-c-format
msgid ""
"The <b>BR</b> element forces a <i>break</i> in the current line of text.\n"
"     "
"<br>- CLEAR=[ left | all | right | none ] (clear floating objects)\n"
"     "
"<br>- core attributes\n"
"   "
msgstr ""
"<b>BR</b> तत्वले पाठको हालको लाइनमा <i>विच्छेद</i> गर्न प्रयत्न गर्छ ।\n"
"     "
"<br>- CLEAR=[ left | all | right | none ] ( उत्प्लावन वस्तुहरू खाली गर्नुहोस्)\n"
"     "
"<br>- मुख्य विशेषताहरू\n"
"   "

#. i18n: file extrafiles line 416
#: rc.cpp:4629 rc.cpp:4765 rc.cpp:4842
#, no-c-format
msgid ""
"The <b>P</b> element defines a <i>paragraph</i>.\n"
"     "
"<br>- ALIGN=[ left | center | right | justify ] (horizontal alignment)\n"
"     "
"<br>- common attributes\n"
"   "
msgstr ""
"<b>P</b> तत्वले <i>अनुच्छेद</i> परिभाषित गर्छ ।\n"
"     "
"<br>- ALIGN=[ left | center | right | justify ] (तेर्सो पङ्क्तिबद्धता)     "
"<br>- साझा विशेषताहरू\n"
"   "

#. i18n: file extrafiles line 419
#: rc.cpp:4635 rc.cpp:4771 rc.cpp:4848
#, no-c-format
msgid "&nbsp;"
msgstr "&nbsp;"

#. i18n: file extrafiles line 422
#: rc.cpp:4638 rc.cpp:4774 rc.cpp:4851
#, no-c-format
msgid ""
"Inserting <b>nbsp</b>.\n"
"     Non breaking <i>space</i>.\n"
"   "
msgstr ""
"घुसाउदैछ <b>nbsp</b> ।\n"
"     विच्छेद नहुने <i>रिक्तस्थान</i> ।\n"
"   "

#. i18n: file extrafiles line 429
#: rc.cpp:4643 rc.cpp:4779 rc.cpp:4856
#, no-c-format
msgid ""
"The <b>A</b> element denotes an <i>anchor</i>--a hypertext link or the "
"destination of a link.\n"
"     The <b>HREF</b> attribute specifies a hypertext link to another resource, "
"such as an <i>HTML</i> document or a <i>JPEG</i> image.\n"
"   "
msgstr ""
"<b>A</b> तत्वले एउटा <i>एङ्कर</i>--एउटा हाइपरटेक्स्ट लिङ्क वा लिङ्कको गन्तव्य "
"सङ्केत गर्छ ।\n"
"     <b>HREF</b> विशेषताले अन्य संसाधनमा हाइपरटेक्स्ट लिङ्क निर्दिष्ट गर्छ, "
"जस्तै एउटा <i>HTML</i> कागजात वा एउटा <i>JPEG</i> छवि ।\n"
"   "

#. i18n: file extrafiles line 435
#: rc.cpp:4648 rc.cpp:4784 rc.cpp:4861 rc.cpp:5089
#, no-c-format
msgid ""
"The <b>IMG</b> element specifies an <i>inline</i> image.\n"
"     The required <b>SRC</b> attribute specifies the location of the image.\n"
"   "
msgstr ""
"<b>IMG</b> तत्वले एउटा <i>inline</i> छवि निर्दिष्ट गर्छ ।\n"
"     आवश्यक <b>SRC</b> विशेषताले छविको स्थान निर्दिष्ट गर्दछ ।\n"
"   "

#. i18n: file extrafiles line 441
#: rc.cpp:4653 rc.cpp:4789 rc.cpp:4866
#, no-c-format
msgid ""
"The <b>HR</b> element defines a <i>horizontal rule</i> for visual browsers.\n"
"     While this element is inherently presentational, it can be used "
"structurally as a section divider.\n"
"   "
msgstr ""
"<b>HR</b> तत्वले दृश्यात्मक ब्राउजरका लागि एउटा <i>तेर्सो नियम</i> "
"परिभाषित गर्छ ।\n"
"     यो तत्व अन्तर्निहित रुपमा प्रस्तुतयोग्य हुँदा, यसलाई सेक्सन बिभाजकका रुपमा "
"संरचनात्मक रुपमा प्रयोग गर्न सकिनेछ ।\n"
"   "

#. i18n: file extrafiles line 447
#: rc.cpp:4658 rc.cpp:4794 rc.cpp:4871 rc.cpp:4930
#, no-c-format
msgid ""
"The <b>!-- --></b> element <i>comment</i> a text inside.\n"
"   "
msgstr ""
"<b>!-- --></b>एउटा पाठ भित्रपट्टि तत्व <i>टिप्पणी</i> ।\n"
"   "

#. i18n: file extrafiles line 454
#: rc.cpp:4662 rc.cpp:4798 rc.cpp:4875
#, no-c-format
msgid ""
"The <b>DIV ALIGN</b>=<i>left</i>\n"
"     suggests the horizontal alignment for the content of the division to <i>"
"left</i>.\n"
"   "
msgstr ""
"<b>DIV ALIGN</b>=<i>left</i>\n"
"     ले बिभाजन गर्नका लागि सामाग्रीको तेर्सो पङ्क्तिबद्धता <i>बायाँ</i> "
"सुझाव गर्छ ।\n"
"   "

#. i18n: file extrafiles line 461
#: rc.cpp:4667 rc.cpp:4803 rc.cpp:4880
#, no-c-format
msgid ""
"The <b>DIV ALIGN</b>=<i>center</i> or <b>CENTER</b>\n"
"     suggests the horizontal alignment for the content of the division to <i>"
"center</i>.\n"
"   "
msgstr ""
"<b>DIV ALIGN</b>=<i>center</i> वा <b>CENTER</b>\n"
