#. i18n: file extrafiles line 38
#: rc.cpp:4484 rc.cpp:4546
#, no-c-format
msgid ""
"The <b>FONT</b> element allows authors to suggest rudimentary <i>"
"font changes</i>.\n"
"   "
msgstr ""
"<b>FONT</b> तत्वले मूल <i>फन्ट परिवर्तन</i> गर्ने सुझावका लागि लेखहरूलाई अनुमति "
"दिन्छ ।\n"
"   "

#. i18n: file extrafiles line 45
#: rc.cpp:4488 rc.cpp:4550
#, no-c-format
msgid ""
"This <b>SIZE=+1</b> element allows to <i>increase</i> font.\n"
"   "
msgstr ""
"यो <b>SIZE=+1</b> तत्वले फन्ट <i>बढाउन</i> अनुमति दिन्छ ।\n"
"   "

#. i18n: file extrafiles line 51
#: rc.cpp:4492 rc.cpp:4554
#, no-c-format
msgid ""
"This <b>SIZE=-1</b> element allows to <i>decrease</i> font.\n"
"   "
msgstr ""
"यो <b>SIZE=-1</b> तत्वले फन्ट <i>घटाउन</i> अनुमति दिन्छ ।\n"
"   "

#. i18n: file extrafiles line 57
#: rc.cpp:4496 rc.cpp:4558 rc.cpp:4697 rc.cpp:5057
#, no-c-format
msgid ""
"The <b>PRE</b> element allows to view <i>preformatted</i> text.\n"
"   "
msgstr ""
"<b>PRE</b> तत्वले <i>पूर्वढाँचाबद्ध</i> पाठ हेर्न अनुमति दिन्छ ।\n"
"   "

#. i18n: file extrafiles line 64
#: rc.cpp:4500 rc.cpp:4562 rc.cpp:4701
#, no-c-format
msgid ""
"The <b>SUB</b> element is used for <i>subscripts</i>.\n"
"     "
"<br>- common attributes\n"
"   "
msgstr ""
"<b>SUB</b> तत्व <i>सबस्क्रिप्टहरू</i> का लागि प्रयोग गरिन्छ ।\n"
"     "
"<br>- साझा विशेषताहरू\n"
"   "

#. i18n: file extrafiles line 71
#: rc.cpp:4505 rc.cpp:4567 rc.cpp:4706
#, no-c-format
msgid ""
"The <b>SUP</b> element is used for <i>superscripts</i>.\n"
"     "
"<br>- common attributes\n"
"   "
msgstr ""
"<b>SUP</b> तत्व <i>सूपरस्क्रप्ट</i> का लागि प्रयोग गरिन्छ ।\n"
"     "
"<br>- साझा विशेषताहरू\n"
"   "

#. i18n: file extrafiles line 79
#: rc.cpp:4510 rc.cpp:4572 rc.cpp:4711
#, no-c-format
msgid ""
"The <b>H1</b> element defines a <i>level-one heading</i>.\n"
"     "
"<br>- ALIGN=[ left | center | right | justify ] (horizontal alignment)\n"
"     "
"<br>- common attributes\n"
"   "
msgstr ""
"<b>H1</b> तत्वले एउटा <i>स्तर-एक हेडिङ</i> परिभाषित गर्छ ।\n"
"     "
"<br>- ALIGN=[ left | center | right | justify ] (तेर्सो पङ्क्तिबद्धता)\n"
"     "
"<br>- साझा विशेषताहरू\n"
"   "

#. i18n: file extrafiles line 87
#: rc.cpp:4516 rc.cpp:4578 rc.cpp:4717
#, no-c-format
msgid ""
"The <b>H2</b> element defines a <i>level-two heading</i>.\n"
"     "
"<br>- ALIGN=[ left | center | right | justify ] (horizontal alignment)\n"
"     "
"<br>- common attributes\n"
"   "
msgstr ""
"<b>H2</b>तत्वले <i>स्तर-दुइ हेडिङ</i> परिभाषित गर्छ ।\n"
"     "
"<br>- ALIGN=[ left | center | right | justify ] (तेर्सो पङ्क्तिबद्धता)\n"
"     "
"<br>- साझा विशेषताहरू\n"
"   "

#. i18n: file extrafiles line 95
#: rc.cpp:4522 rc.cpp:4584 rc.cpp:4723
#, no-c-format
msgid ""
"The <b>H3</b> element defines a <i>level-three heading</i>.\n"
"     "
"<br>- ALIGN=[ left | center | right | justify ] (horizontal alignment)\n"
"     "
"<br>- common attributes\n"
"   "
msgstr ""
"<b>H3</b> तत्वले <i>स्तर-तिन हेडिङ</i> परिभाषित गर्छ ।\n"
"     "
"<br>- ALIGN=[ left | center | right | justify ] (तेर्सो पङ्क्तिबद्धता)\n"
"     "
"<br>- साझा विशेषताहरू\n"
"   "

#. i18n: file extrafiles line 103
#: rc.cpp:4528 rc.cpp:4590 rc.cpp:4729
#, no-c-format
msgid ""
"The <b>H4</b> element defines a <i>level-four heading</i>.\n"
"     "
"<br>- ALIGN=[ left | center | right | justify ] (horizontal alignment)\n"
"     "
"<br>- common attributes\n"
"   "
msgstr ""
"<b>H4</b> तत्वले <i>स्तर-चार हेडिङ</i> परिभाषित गर्छ ।\n"
"     "
"<br>- ALIGN=[ left | center | right | justify ] (तेर्सो पङ्क्तिबद्धता)\n"
"     "
"<br>- साझा विशेषताहरू\n"
"   "

#. i18n: file extrafiles line 111
#: rc.cpp:4534 rc.cpp:4596 rc.cpp:4735
#, no-c-format
msgid ""
"The <b>H5</b> element defines a <i>level-five heading</i>.\n"
"     "
"<br>- ALIGN=[ left | center | right | justify ] (horizontal alignment)\n"
"     "
"<br>- common attributes\n"
"   "
msgstr ""
"<b>H5</b> तत्वले <i>स्तर-पाँच हेडिङ</i> परिभाषित गर्छ ।\n"
"     "
"<br>- ALIGN=[ left | center | right | justify ] (तेर्सो पङ्क्तिबद्धता)\n"
"     "
"<br>- साझा विशेषताहरू\n"
"   "

