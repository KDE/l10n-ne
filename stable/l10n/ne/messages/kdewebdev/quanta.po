"&lt;tag name=\"I18n\" common=\"yes\">"
"<br>\n"
"&nbsp;&nbsp;&lt;attr name=\"lang\" type=\"input\" />"
"<br>\n"
"&nbsp;&nbsp;&lt;attr name=\"dir\" type=\"input\" />"
"<br>\n"
"&lt;/tag>\n"
"</b></p>"
msgstr ""
"अल्पविरामद्वारा बिभाजित साझा विशेषता समूहको सूची । यो पृष्ठमा सूचीकृत समूहका "
"विशेषता देखिने छन् ।"
"<br>साझा विशेषताहरू प्रत्येक DTEP's <i>common.tag</i> "
"फाइलमा निर्दिष्ट गरिन्छन्, जहाँ <i>common=\"yes\"</i> "
"विशेषता सेट भएको हुनुपर्छ ।"
"<br>निम्न उदाहरणले साझा I18n विशेषता समूहको परिभाषित गर्छ:"
"<br>"
"<p><b>\n"
"&lt;tag name=\"I18n\" common=\"yes\">"
"<br>\n"
"&nbsp;&nbsp;&lt;attr name=\"lang\" type=\"input\" />"
"<br>\n"
"&nbsp;&nbsp;&lt;attr name=\"dir\" type=\"input\" />"
"<br>\n"
"&lt;/tag>\n"
"</b></p>"

