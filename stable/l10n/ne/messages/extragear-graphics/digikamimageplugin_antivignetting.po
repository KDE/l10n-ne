#: imageeffect_antivignetting.cpp:61 imageeffect_antivignetting.cpp:359
#: imageplugin_antivignetting.cpp:62
msgid "Anti-Vignetting"
msgstr "बेलबुट्टा-बिरोधी"

#: imageeffect_antivignetting.cpp:63
msgid "A digiKam image plugin to reduce image vignetting."
msgstr "छविको बेलबुट्टा घटाउनका लागि डिजिक्याम छवि प्लगइन"

#: imageeffect_antivignetting.cpp:69
msgid "Author and maintainer"
msgstr "लेखक र मर्मतकर्ता"

#: imageeffect_antivignetting.cpp:72
msgid "Anti Vignetting algorithm"
msgstr "बेलबुट्टा अल्गोरिदम बिरोधी"

#: imageeffect_antivignetting.cpp:84
msgid ""
"<p>You can see here a thumbnail preview of the anti-vignetting mask applied "
"to the image."
msgstr ""
"<p>तपाईँले यहाँ छविमा लागू गरिएको बिरोधी बेलबुट्टा मास्कको थम्बनेल पूर्वावलोकन "
"हेर्न सक्नुहुन्छ ।"

#: imageeffect_antivignetting.cpp:90
msgid "Density:"
msgstr "घनत्व:"

#: imageeffect_antivignetting.cpp:95
msgid ""
"<p>This value controls the degree of intensity attenuation by the filter at "
"its point of maximum density."
msgstr "<p>यसको अधिकतम घनत्वको बिन्दुमा यो मानले घनत्व न्यूनताको डिग्री नियन्त्रण गर्दछ ।"

#: imageeffect_antivignetting.cpp:103
msgid "Power:"
msgstr "शक्ति:"

#: imageeffect_antivignetting.cpp:108
msgid ""
"<p>This value is used as the exponent controlling the fall-off in density "
"from the center of the filter to the periphery."
msgstr ""
"<p>यो मान परिधिमा फिल्टरको केन्द्रबाट घनत्वमा घातांक घट्न "
"नियन्त्रण गर्नमा प्रयोग गरिन्छ"

#: imageeffect_antivignetting.cpp:116
msgid "Radius:"
msgstr "अर्धव्यास:"

#: imageeffect_antivignetting.cpp:121
msgid ""
"<p>This value is the radius of the center filter. It is a multiple of the "
"half-diagonal measure of the image, at which the density of the filter falls "
"to zero."
msgstr ""
"<p>यो मान केन्द्रीय फिल्टरको अर्धव्यास हो । यो छविको बहु आधा-कर्णरेखा "
"मापन हो, जहाँ फिल्टरको घनत्व शून्यमा खस्दछ ।"

#: imageeffect_antivignetting.cpp:133
msgid "Brightness:"
msgstr "चम्किलोपन:"

#: imageeffect_antivignetting.cpp:137
msgid "<p>Set here the brightness re-adjustment of the target image."
msgstr "<p>लक्षित छविको चम्किलोपन यहाँ पुन:-समायोजन गर्नुहोस् ।"

#: imageeffect_antivignetting.cpp:144
msgid "Contrast:"
msgstr "व्यतिरेक:"

#: imageeffect_antivignetting.cpp:148
msgid "<p>Set here the contrast re-adjustment of the target image."
msgstr "<p>लक्षित छविको व्यतिरेक यहाँ पुन:-समायोजन गर्नुहोस् ।"

#: imageeffect_antivignetting.cpp:155
msgid "Gamma:"
msgstr "गामा:"

#: imageeffect_antivignetting.cpp:161
msgid "<p>Set here the gamma re-adjustment of the target image."
msgstr "<p>लक्षित छविको गामा यहाँ पुन:-समायोजन गर्नुहोस् ।"

#: imageplugin_antivignetting.cpp:42
msgid "Anti Vignetting..."
msgstr "बिरोधी बेलबुट्टा..."

