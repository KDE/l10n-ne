#: adjustlevels.cpp:91 imageplugin_adjustlevels.cpp:64
msgid "Adjust Color Levels"
msgstr "रङ स्तर समायोजन गर्नुहोस्"

#: adjustlevels.cpp:93
msgid "An image-histogram-levels adjustment plugin for digiKam."
msgstr "डिजिक्यामका लागि छवि-हिस्टोग्राम-वक्र समायोजन"

#: adjustlevels.cpp:99
msgid "Author and maintainer"
msgstr "लेखक र मर्मतकर्ता"

#: adjustlevels.cpp:107
msgid ""
"<p>Here you can see the image's level-adjustments preview. You can pick "
"color on image to see the color level corresponding on histogram."
msgstr ""
"<p>तपाईँले यहाँ छविको वक्र-समायोजन पूर्वावलोकन हेर्न सक्नुहुन्छ । तपाईँले हिस्टोग्राम अनुरूप "
"रङ स्तर हेर्नका लागि छविमा रङ छनोट गर्न सक्नुहुन्छ ।"

#: adjustlevels.cpp:117
msgid "Channel:"
msgstr "च्यानल:"

#: adjustlevels.cpp:120 adjustlevels.cpp:125
msgid "Luminosity"
msgstr "ज्योति"

#: adjustlevels.cpp:121
msgid "Red"
msgstr "रातो"

#: adjustlevels.cpp:122
msgid "Green"
msgstr "हरियो"

#: adjustlevels.cpp:123
msgid "Blue"
msgstr "निलो"

#: adjustlevels.cpp:124
msgid "Alpha"
msgstr "अल्फा"

#: adjustlevels.cpp:126
msgid ""
"<p>Select here the histogram channel to display:<p><b>Luminosity</b>: "
"display the image's luminosity values.<p><b>Red</b>: display the red "
"image-channel values.<p><b>Green</b>: display the green image-channel "
"values.<p><b>Blue</b>: display the blue image-channel "
"values.<p><b>Alpha</b>: display the alpha image-channel values. This channel "
"corresponds to the transparency value and is supported by some image "
"formats, such as PNG or TIF."
msgstr ""
"<p>यहाँ हिस्टोग्राम च्यानल चयन गर्नुहोस्:<p><b>ज्योति प्रदर्शन गर्नका लागि</b>: "
"छविको ज्योतिय मानहरू प्रदर्शन गर्नुहोस्<p><b>Red</b>: रातो छवि-च्यानल "
"मानहरू प्रदर्शन गर्नुहोस्<p><b>हरियो</b>: हरियो छवि-च्यानल मानहरू "
"प्रदर्शन गर्नुहोस्<p><b>निलो</b>: निलो छवि-च्यानल मानहरू प्रदर्शन "
"गर्नुहोस्।<p><b>अल्फा</b>: अल्फा छवि-च्यानल मानहरू प्रदर्शन गर्नुहोस्। यो च्यानल "
"पारदर्शिता मानसँग अनुकूल छ र PNG वा TIF जस्ता छवि ढाँचाद्वारा यसलाई समर्थन गर्दछ ।"

#: adjustlevels.cpp:139
msgid ""
"<p>Select here the histogram scale.<p>If the image's maximal counts are "
"small, you can use the linear scale.<p>Logarithmic scale can be used when "
"the maximal counts are big; if it is used, all values (small and large) will "
"be visible on the graph."
msgstr ""
"<p>यहाँ हिस्टोग्राम मापन चयन गर्नुहोस्<p>यदि छविको अधिकतम गणनाहरू सानो "
"छ भने, तपाईँ लिनियर मापन प्रयोग गर्न सक्नुहुन्छ<p>जब अधिकतम गणना ठूलो हुन्छ तब तपाईँले "
"लोगारदमिक मापन प्रयोग गर्नसक्नुहुन्छ; यदि यो प्रयोग भयो भने, सबै मानहरू (साना र ठूला) ग्राफमा "
"हेर्न सकिन्छ ।"

#: adjustlevels.cpp:145
msgid "<p>Linear"
msgstr "<p>लिनियर"

#: adjustlevels.cpp:153
msgid "<p>Logarithmic"
msgstr "<p>लोगारदमिक"

#: adjustlevels.cpp:171
msgid ""
"<p>Here you can see the target preview image histogram drawing of the "
"selected image channel. This one is re-computed at any levels settings "
"changes."
msgstr ""
"<p>तपाईँले यहाँ चयन गरेका छवि च्यानलको लक्षित पूर्वावलोकन छवि हिस्टोग्राम "
"रेखाचित्र हेर्न सक्नुहुन्छ । यसलाई कुनै पनि तह सेटिङ परिवर्तन गर्दा पुन: गणना गरिन्छ ।"

#: adjustlevels.cpp:181
msgid "<p>This is the histogram drawing of the selected channel from original image"
msgstr "<p>यो मौलिक छविबाट चयन गरेको च्यानलको हिस्टोग्राम रेखाचित्र हो ।"

#: adjustlevels.cpp:190 adjustlevels.cpp:206
msgid "<p>Select here the minimal intensity input value of the histogram."
msgstr "<p>यहाँ हिस्टोग्रामको न्यूनतम तीव्रता आगत मान चयन गर्नुहोस् ।"

#: adjustlevels.cpp:191 adjustlevels.cpp:207
msgid "Minimal intensity input."
msgstr "न्यूनतम तीव्रता आगत"

#: adjustlevels.cpp:199 adjustlevels.cpp:217
msgid "<p>Select here the maximal intensity input value of the histogram."
msgstr "<p>यहाँ हिस्टोग्रामको अधिकतम तीव्रता आगत मान चयन गर्नुहोस् ।"

#: adjustlevels.cpp:200 adjustlevels.cpp:216
msgid "Maximal intensity input."
msgstr "अधिकतम तीव्रता आगत"

#: adjustlevels.cpp:212
msgid "Gamma input value."
msgstr "गामा आगत मान"

#: adjustlevels.cpp:213
msgid "<p>Select here the gamma input value."
msgstr "<p>यहाँ गामा आगत मान चयन गर्नुहोस् ।"

#: adjustlevels.cpp:224 adjustlevels.cpp:243
msgid "<p>Select here the minimal intensity output value of the histogram."
msgstr "<p>यहाँ हिस्टोग्रामको न्यूनतम तीव्रता प्रतिफल मान चयन गर्नुहोस् ।"

#: adjustlevels.cpp:225 adjustlevels.cpp:242
msgid "Minimal intensity output."
msgstr "न्यूनतम तीव्रता निर्गत"

#: adjustlevels.cpp:233 adjustlevels.cpp:247
msgid "<p>Select here the maximal intensity output value of the histogram."
msgstr "<p>यहाँ हिस्टोग्रामको अधिकतम तीव्रता निर्गत मान चयन गर्नुहोस् ।"

#: adjustlevels.cpp:234 adjustlevels.cpp:246
msgid "Maximal intensity output."
msgstr "अधिकतम तीव्रता निर्गत"

#: adjustlevels.cpp:261
msgid "All channels shadow tone color picker"
msgstr "सबै च्यानलको छायाँ टोन रङ पिकर"

#: adjustlevels.cpp:262
msgid ""
"<p>With this button, you can pick the color from original image used to set "
"<b>Shadow Tone</b> levels input on Red, Green, Blue, and Luminosity channels."
msgstr ""
"<p>यो बटनसँग, तपाईँले रातो, हरियो, निलो र ज्योति च्यानलमा "
"<b>छायाँ टोन</b> स्तर आगत सेट गर्न प्रयोग गरिने मौलिक छविबाट रङ टिप्न सक्नुहुन्छ ।"

#: adjustlevels.cpp:271
msgid "All channels middle tone color picker"
msgstr "सबै च्यानलको मध्य टोन रङ पिकर"

#: adjustlevels.cpp:272
msgid ""
"<p>With this button, you can pick the color from original image used to set "
"<b>Middle Tone</b> levels input on Red, Green, Blue, and Luminosity channels."
msgstr ""
"<p>यो बटनसँग, तपाईँले रातो, हरियो, निलो र ज्योति च्यानलमा "
"<b>मध्य टोन</b> स्तर आगत सेट गर्न प्रयोग गरिने मौलिक छविबाट रङ टिप्न सक्नुहुन्छ ।"

#: adjustlevels.cpp:281
msgid "All channels highlight tone color picker"
msgstr "सबै च्यानलका हाइलाइट टोन रङ पिकर"

#: adjustlevels.cpp:282
msgid ""
"<p>With this button, you can pick the color from original image used to set "
"<b>Highlight Tone</b> levels input on Red, Green, Blue, and Luminosity "
"channels."
msgstr ""
"<p>यो बटनसँग, तपाईँले रातो, हरियो, निलो र ज्योतिमा "
"<b>हाइलाइट टोन</b> स्तर आगत सेट गर्न प्रयोग गरिने मौलिक छविबाट रङ टिप्न सक्नुहुन्छ ।"

#: adjustlevels.cpp:289
msgid "Adjust all levels automatically."
msgstr "सबै स्तर स्वचालित तरिकाले समायोजन गर्नुहोस् ।"

#: adjustlevels.cpp:290
msgid ""
"<p>If you press this button, all channel levels will be adjusted "
"automatically."
msgstr ""
"<p>यदि तपाईँले यो बटन थिच्नुभयो भने, सबै च्यानल स्तर स्वचालित रुपमा "
"समायोजन गरिन्छ ।"

#: adjustlevels.cpp:293
msgid "&Reset"
msgstr "रिसेट"

#: adjustlevels.cpp:295
msgid "Reset current channel levels' values."
msgstr "हालको च्यानल स्तरका मान रिसेट गर्नुहोस् ।"

#: adjustlevels.cpp:296
msgid ""
"<p>If you press this button, all levels' values from the current selected "
"channel will be reset to the default values."
msgstr "<p>यदि तपाईँले यो बटन थिच्नुभयो भने, हाल चयन गरेको च्यानलबाट सबै स्तरको मानहरू पूर्वनिर्धारित मानमा रिसेट हुन्छ ।"

#: adjustlevels.cpp:584
msgid "Adjust Level"
msgstr "स्तर समायोजन गर्नुहोस्"

#: adjustlevels.cpp:742
msgid "Select Gimp Levels File to Load"
msgstr "लोड गर्नका लागि गिम्प स्तर फाइल चयन गर्नुहोस्"

#: adjustlevels.cpp:748
msgid "Cannot load from the Gimp levels text file."
msgstr "गिम्प स्तर पाठ फाइलबाट लोड गर्न सकिँदैन ।"

#: adjustlevels.cpp:763
msgid "Gimp Levels File to Save"
msgstr "बचत गर्नका लागि गिम्प स्तर फाइल"

#: adjustlevels.cpp:769
msgid "Cannot save to the Gimp levels text file."
msgstr "गिम्प स्तर पाठ फाइलमा बचत गर्न सकिँदैन ।"

#: imageplugin_adjustlevels.cpp:43
msgid "Levels Adjust..."
msgstr "स्तर समायोजन गर्नुहोस्..."

