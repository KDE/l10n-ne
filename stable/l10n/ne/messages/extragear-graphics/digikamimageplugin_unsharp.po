#: imageeffect_unsharp.cpp:58 imageeffect_unsharp.cpp:223
#: imageplugin_unsharp.cpp:63
msgid "Unsharp Mask"
msgstr "अनसार्प मास्क"

#: imageeffect_unsharp.cpp:60
msgid "An unsharp mask image filter plugin for digiKam."
msgstr "डिजिक्यामका लागि अनसार्प मास्क छवि फिल्टर प्लगइन"

#: imageeffect_unsharp.cpp:66
msgid "Author and maintainer"
msgstr "लेखक र मर्मतकर्ता"

#: imageeffect_unsharp.cpp:76
msgid "Radius:"
msgstr "रेडियस:"

#: imageeffect_unsharp.cpp:81
msgid ""
"<p>Radius value is the gaussian blur matrix radius value used to determines "
"how much to blur the image."
msgstr "<p>रेडियस मान भनेको छविलाई अस्पष्ट पार्नका लागि प्रयोग गरिने गउसियन अस्पष्ट म्याट्रिक्स रेडियस मान हो ।"

#: imageeffect_unsharp.cpp:88
msgid "Amount:"
msgstr "मात्रा:"

#: imageeffect_unsharp.cpp:94
msgid ""
"<p>The value of the difference between the original and the blur image that "
"is added back into the original."
msgstr "<p>मौलिक छविमा थपिने मौलिक र अस्पष्ट छवि बिचको फरक मान"

#: imageeffect_unsharp.cpp:101
msgid "Threshold:"
msgstr "थ्रेसहोल्ड:"

#: imageeffect_unsharp.cpp:107
msgid ""
"<p>The threshold, as a fraction of the maximum luminosity value, needed to "
"apply the difference amount."
msgstr "<p>अधिकतम ज्योति मानको खण्डको रूपमा, थ्रेसहोल्ड फरक मात्रा लागू गर्न आवश्यक पर्दछ ।"

#: imageplugin_unsharp.cpp:43
msgid "Unsharp Mask..."
msgstr "अनसार्प मार्क..."

