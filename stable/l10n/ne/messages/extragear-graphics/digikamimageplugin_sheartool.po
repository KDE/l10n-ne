#: imageeffect_sheartool.cpp:64 imageeffect_sheartool.cpp:299
#: imageplugin_sheartool.cpp:62
msgid "Shear Tool"
msgstr "बाँडफाँट उपकरण"

#: imageeffect_sheartool.cpp:66
msgid "A digiKam image plugin to shear an image."
msgstr "छवि बाँडफाँट गर्ने डिजिक्याम छवि प्लगइन ।"

#: imageeffect_sheartool.cpp:72
msgid "Author and maintainer"
msgstr "लेखक र सम्भारकर्ता"

#: imageeffect_sheartool.cpp:75
msgid "Shear algorithm"
msgstr "बाँडफाँट अलगोरिदम"

#: imageeffect_sheartool.cpp:80
msgid ""
"<p>This is the shearing image operation preview. If you move the mouse "
"cursor on this preview, a vertical and horizontal dashed line will be drawn "
"to guide you in adjusting the shearing correction. Release the left mouse "
"button to freeze the dashed line's position."
msgstr "<p>यो बाँडफाँट छवि सञ्चालन पूर्वावलोकन हो । यदि तपाईँले पूर्वावलोकनमा यो माउस कर्सर सार्नुभयो भने, तपाईँलाई बाँडफाँट सुधार समायोजनको मार्गनिर्देश गर्न एउटा ठाडो र तेर्सो ड्यास गरिएको लाइन देखिन्छ । ड्यास लाइनको वस्तुस्थिति निस्क्रिय पार्न माउसको बाँया बटन छोड्नुहोस् ।"

#: imageeffect_sheartool.cpp:95
msgid "New width:"
msgstr "नयाँ चौडाई:"

#: imageeffect_sheartool.cpp:96 imageeffect_sheartool.cpp:100
#: imageeffect_sheartool.cpp:291 imageeffect_sheartool.cpp:292
msgid " px"
msgstr " px"

#: imageeffect_sheartool.cpp:99
msgid "New height:"
msgstr "नयाँ उचाइ:"

#: imageeffect_sheartool.cpp:111
msgid "Main horizontal angle:"
msgstr "मूख्य तेर्सो कोण:"

#: imageeffect_sheartool.cpp:115
msgid "<p>The main horizontal shearing angle, in degrees."
msgstr "<p>डिग्रीको, मूख्य तेर्सो बाँडफाँट कोण ।"

#: imageeffect_sheartool.cpp:119
msgid "Fine horizontal angle:"
msgstr "ठीक तेर्सो कोण:"

#: imageeffect_sheartool.cpp:123
msgid ""
"<p>This value in degrees will be added to main horizontal angle value to set "
"fine adjustments."
msgstr "<p>ठीक समायोजन सेट गर्नका लागि मुख्य तेर्सो कोण मानमा डिग्रीको यो मान थपिनेछ ।"

#: imageeffect_sheartool.cpp:128
msgid "Main vertical angle:"
msgstr "मूख्य ठाडो कोण:"

#: imageeffect_sheartool.cpp:132
msgid "<p>The main vertical shearing angle, in degrees."
msgstr "<p>डिग्रीको, मूख्य ठाडो बाँडफाँट कोण ।"

#: imageeffect_sheartool.cpp:136
msgid "Fine vertical angle:"
msgstr "ठीक ठाडो कोण:"

#: imageeffect_sheartool.cpp:140
msgid ""
"<p>This value in degrees will be added to main vertical angle value to set "
"fine adjustments."
msgstr "<p>ठीक समायोजन सेट गर्नका लागि मुख्य ठाडो कोण मानमा डिग्रीको यो मान थपिनेछ ।"

#: imageeffect_sheartool.cpp:145
msgid "Anti-Aliasing"
msgstr "एन्टी-एलाइजिङ"

#: imageeffect_sheartool.cpp:146
msgid ""
"<p>Enable this option to process anti-aliasing filter to the sheared image. "
"To smooth the target image, it will be blurred a little."
msgstr ""
"<p>बाँडफाँट गरिएका छविमा एन्टी-एलाइजिङ फिल्टर प्रक्रिया गर्न यो विकल्प सक्षम पार्नुहोस् ।"
"लक्षित छविलाई महिन पार्न, यो केही अस्पष्ट हुनेछ ।"

#: imageplugin_sheartool.cpp:42
msgid "Shear..."
msgstr "बाँडफाँट..."

