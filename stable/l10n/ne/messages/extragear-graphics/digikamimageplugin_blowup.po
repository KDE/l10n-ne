#: imageeffect_blowup.cpp:82 imageeffect_blowup.cpp:101
#: imageeffect_blowup.cpp:128
msgid "Blowup Photograph"
msgstr "फोटोग्राफ हटाउनुहोस्"

#: imageeffect_blowup.cpp:86
msgid "&Save As..."
msgstr "यस रूपमा बचत गर्नुहोस्..."

#: imageeffect_blowup.cpp:87
msgid "&Load..."
msgstr "लोड गर्नुहोस्..."

#: imageeffect_blowup.cpp:91
msgid "<p>Reset all filter parameters to their default values."
msgstr "<p>सबै फिल्टर परामितिलाई पूर्वनिर्धारित मानमा रिसेट गर्नुहोस् ।"

#: imageeffect_blowup.cpp:92
msgid "<p>Load all filter parameters from settings text file."
msgstr "<p>सेटिङ पाठ फाइलबाट सबै फिल्टर परामिति लोड गर्नुहोस् ।"

#: imageeffect_blowup.cpp:93
msgid "<p>Save all filter parameters to settings text file."
msgstr "<p>सबै फिल्टर परामितिलाई सेटिङ पाठ फाइलमा बचत गर्नुहोस् ।"

#: imageeffect_blowup.cpp:103
msgid "A digiKam image plugin to blowup a photograph."
msgstr "फोटोग्राफ हटाउनका लागि डिजिक्याम छवि प्लगइन"

#: imageeffect_blowup.cpp:109
msgid "Author and maintainer"
msgstr "लेखक र मर्मतकर्ता"

#: imageeffect_blowup.cpp:112
msgid "CImg library"
msgstr "CImg लाइब्रेरी"

#: imageeffect_blowup.cpp:115
msgid "Feedback and plugin polishing"
msgstr "पृष्ठपोषण र प्लगइन चम्किलोपना"

#: imageeffect_blowup.cpp:121
msgid "Plugin Handbook"
msgstr "प्लगइन हातेपुस्तक"

#: imageeffect_blowup.cpp:138
msgid "New Size"
msgstr "नयाँ साइज"

#: imageeffect_blowup.cpp:146
msgid "Visit CImg library website"
msgstr "CImg लाइब्रेरी वेबसाइट अवलोकन गर्नुहोस्"

#: imageeffect_blowup.cpp:148
msgid "Width:"
msgstr "चौडाइ:"

#: imageeffect_blowup.cpp:152
msgid "<p>Set here the new imager width in pixels."
msgstr "<p>यहाँ पिक्सेलमा नयाँ इमेजर चौडाइ सेट गर्नुहोस् ।"

#: imageeffect_blowup.cpp:154
msgid "Height:"
msgstr "उचाइ:"

#: imageeffect_blowup.cpp:158
msgid "<p>Set here the new image height in pixels."
msgstr "<p>यहाँ पिक्सेलमा नयाँ छवि उचाइ सेट गर्नुहोस् ।"

#: imageeffect_blowup.cpp:160
msgid "Maintain aspect ratio"
msgstr "आकार अनुपात कायम राख्नुहोस्"

#: imageeffect_blowup.cpp:161
msgid "<p>Enable this option to maintain aspect ratio with new image sizes."
msgstr "<p>नयाँ छवि साइजसँग आकार अनुपात कायम राख्नका लागि यो विकल्प सक्षम पार्नुहोस् ।"

#: imageeffect_blowup.cpp:172
msgid "<p>This is the current percentage of the task completed."
msgstr "<p>यो सम्पन्न भएको कामको प्रतिशत हो ।"

#: imageeffect_blowup.cpp:179
msgid "Smoothing"
msgstr "महिन"

#: imageeffect_blowup.cpp:181
msgid "Detail preservation:"
msgstr "विवरण सुरक्षा:"

#: imageeffect_blowup.cpp:186
msgid ""
"<p>Preservation of details to set the sharpening level of the small features "
"in the target image. Higher values leave details sharp."
msgstr "<p>लक्ष्य छविको सानो सुविधाको तिखोपन स्तर सेट गर्न विवरणको सुरक्षा । उच्च मानले विवरणलाई राम्रो बनाउछ ।"

#: imageeffect_blowup.cpp:192
msgid "Anisotropy:"
msgstr "एनिसोट्रोपी:"

#: imageeffect_blowup.cpp:197
msgid ""
"<p>Anisotropic (directional) modifier of the details. Keep it small for "
"Gaussian noise."
msgstr ""
"<p>विवरणका एनिसोट्रोपिक (दिशा) परिमार्जक । गौसियन नोइजका लागि यसलाई "
"सानो कायम राख्नुहोस् ।"

#: imageeffect_blowup.cpp:201
msgid "Smoothing:"
msgstr "महिन:"

#: imageeffect_blowup.cpp:206
msgid ""
"<p>Total smoothing power: if Detail Factor sets the relative smoothing and "
"Gradient Factor the direction, Time Step sets the overall effect."
msgstr ""
"<p>कूल महिन शक्ति: यदि विवरण तत्वले दिशाको सम्बन्धित महिन र ग्रेडियन्ट तत्व "
"सेट गर्दछ भने, समय चरणले समस्त प्रभाव सेट गर्दछ ।"

#: imageeffect_blowup.cpp:211
msgid "Regularity:"
msgstr "निरन्तरता:"

#: imageeffect_blowup.cpp:216
msgid ""
"<p>This value controls the smoothing regularity of the target image. Do not "
"use an high value here, else the target image will be completely blurred."
msgstr ""
"<p>मानले लक्षित छविको महिन निरन्तरतालाई नियन्त्रण गर्दछ । यहाँ उच्च मानलाई "
"प्रयोग नगर्नुहोला, नत्र लक्षित छवि पूर्ण रूपमा अस्पष्ट हुन जान्छ ।"

#: imageeffect_blowup.cpp:222
msgid "Iterations:"
msgstr "पुनरावृत्ति:"

#: imageeffect_blowup.cpp:227
msgid "<p>Sets the number of times the filter is applied on the target image."
msgstr "<p>लक्षित छविमा लागू गरिएको फिल्टरलाई धेरै पटक सम्म सेट गर्दछ ।"

#: imageeffect_blowup.cpp:235
msgid "Advanced Settings"
msgstr "उन्नत सेटिङ"

#: imageeffect_blowup.cpp:237
msgid "Angular step:"
msgstr "कोणीय चरण:"

#: imageeffect_blowup.cpp:242
msgid "<p>Set here the angular integration step in degrees in analogy to anisotropy."
msgstr "<p>यहाँ डिग्रिको रूपमा कोणीय अनुकूलन चरण एनिसोट्रोपीमा समानता सेट गर्दछ ।"

#: imageeffect_blowup.cpp:246
msgid "Integral step:"
msgstr "समस्त चरण:"

#: imageeffect_blowup.cpp:251
msgid "<p>Set here the spatial integral step. Stay below 1."
msgstr "<p>यहाँ आकाशिय इन्टिग्रल चरण सेट गर्नुहोस् । १ भन्दा तल रहनुहोस् ।"

#: imageeffect_blowup.cpp:255
msgid "Gaussian:"
msgstr "गौसियन:"

#: imageeffect_blowup.cpp:260
msgid "<p>Set here the precision of the Gaussian function."
msgstr "<p>यहाँ गौसियन कार्यको यथार्थता सेट गर्नुहोस् ।"

#: imageeffect_blowup.cpp:264
msgid "Use linear interpolation"
msgstr "रेखिय इन्टरपोलेसन प्रयोग गर्नुहोस्"

#: imageeffect_blowup.cpp:265
msgid "<p>Enable this option to quench the last bit of quality (slow)."
msgstr "<p>गुण (बिस्तारै) को अन्तिम बिटलाई शान्त गर्नका लागि यो विकल्प सक्षम पार्नुहोस् ।"

#: imageeffect_blowup.cpp:268
msgid "Normalize photograph"
msgstr "फोटोग्राफलाई सामान्यीकरण गर्नुहोस्"

#: imageeffect_blowup.cpp:269
msgid "<p>Enable this option to process an output image normalization."
msgstr "<p>प्रतिफल छवि सामान्यीकरणलाई प्रकृयामा लैजान यो विकल्पलाई सक्षम पार्नुहोस् ।"

#: imageeffect_blowup.cpp:465
msgid "BlowUp"
msgstr "हटाउनुहोस्"

#: imageeffect_blowup.cpp:490
msgid "Photograph Blowup Settings File to Load"
msgstr "लोड गर्नका लागि फोटोग्राफ हटाउने सेटिङ"

#: imageeffect_blowup.cpp:502
msgid "\"%1\" is not a Photograph Blowup settings text file."
msgstr "\"%1\" फोटोग्राफ हटाउने सेटिङ पाठ फाइल होइन ।"

#: imageeffect_blowup.cpp:523
msgid "Cannot load settings from the Photograph Blowup text file."
msgstr "फोटोग्राफ हटाउने पाठ फाइलबाट सेटिङ लोड गर्न सकिँदैन ।"

#: imageeffect_blowup.cpp:532
msgid "Photograph Blowup Settings File to Save"
msgstr "बचत गर्नका लागि फोटोग्राफ हटाउने सेटिङ"

#: imageeffect_blowup.cpp:554
msgid "Cannot save settings to the Photograph Blowup text file."
msgstr "फोटोग्राफ हटाउने पाठ फाइलमा सेटिङ बचत गर्न सकिँदैन ।"

#: imageplugin_blowup.cpp:41
msgid "Blowup..."
msgstr "हटाउनुहोस्..."

