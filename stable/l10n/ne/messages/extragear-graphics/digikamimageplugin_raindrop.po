#: imageeffect_raindrop.cpp:79
msgid ""
"<p>This is the preview of the Raindrop effect.<p>Note: if you have "
"previously selected an area in the editor, this will be unaffected by the "
"filter. You can use this method to disable the Raindrops effect on a human "
"face, for example."
msgstr ""
"<p>यो रेनड्रप प्रभावको पूर्वावलोकन हो ।<p>द्रष्टब्य: यदि तपाईँले सम्पादकमा "
"पहिले नै एउटा क्षेत्र चयन गर्नु भएको छ भने, यो फिल्टरद्वारा प्रभावित हुनेछैन । उदाहरणका लागि, तपाईँ यो विधि मानिसको अनुहारमा रेनड्रप प्रभाव अक्षम पार्न प्रयोग गर्न सक्नुहुन्छ ।"

#: imageeffect_raindrop.cpp:89
msgid "Drop size:"
msgstr "ड्रप साइज:"

#: imageeffect_raindrop.cpp:94
msgid "<p>Set here the raindrops' size."
msgstr "<p>यहाँ रेनड्रपको साइज सेट गर्नुहोस् ।"

#: imageeffect_raindrop.cpp:101
msgid "Number:"
msgstr "सङ्ख्या:"

#: imageeffect_raindrop.cpp:106
msgid "<p>This value controls the maximum number of raindrops."
msgstr "<p>यो मानले वर्षाको अधिकतम सङ्ख्यालाई नियन्त्रण गर्दछ ।"

#: imageeffect_raindrop.cpp:113
msgid "Fish eyes:"
msgstr "फिस आई:"

#: imageeffect_raindrop.cpp:118
msgid "<p>This value is the fish-eye-effect optical distortion coefficient."
msgstr "<p>यो मान फिस-आई-प्रभाव अप्टिकल विरुपण गुणाङ्क हो ।"

#: imageeffect_raindrop.cpp:249
msgid "RainDrop"
msgstr "रेनड्रप"

#: imageplugin_raindrop.cpp:42
