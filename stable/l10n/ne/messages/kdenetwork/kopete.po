#: protocols/irc/ircprotocol.cpp:150
msgid "USAGE: /raw <text> - Sends the text in raw form to the server."
msgstr "USAGE: /raw <text> - सर्भरमा कच्चा रूपमा पाठ पठाउँदछ ।"

#: protocols/irc/ircprotocol.cpp:154
msgid "USAGE: /quote <text> - Sends the text in quoted form to the server."
msgstr "USAGE: /quote <text> - सर्भरमा उद्धरण गरिएको रूपमा पाठ पठाउँदछ ।"

#: protocols/irc/ircprotocol.cpp:158
msgid "USAGE: /ctcp <nick> <message> - Send the CTCP message to nick<action>."
msgstr "USAGE: /ctcp <nick> <message> - उपनाममा CTCP सन्देश पठाउनुहोस्<action> ।"

#: protocols/irc/ircprotocol.cpp:162
msgid "USAGE: /ping <nickname> - Alias for /CTCP <nickname> PING."
msgstr "USAGE: /ping <nickname> - /CTCP <nickname> पिङका लागि उपनाम ।"

#: protocols/irc/ircprotocol.cpp:166
msgid ""
"USAGE: /motd [<server>] - Shows the message of the day for the current or "
"the given server."
msgstr "USAGE: /motd [<server>] - हालको वा दिएको सर्भरका लागि दिनको सन्देश देखाउँछ ।"

#: protocols/irc/ircprotocol.cpp:170
msgid "USAGE: /list - List the public channels on the server."
msgstr "USAGE: /list - सर्भरमा सार्वजनिक च्यानल सूचीबद्ध गर्नुहोस् ।"

#: protocols/irc/ircprotocol.cpp:174
msgid "USAGE: /join <#channel 1> [<password>] - Joins the specified channel."
msgstr "USAGE: /join <#channel 1> [<password>] - निर्दिष्ट गरेको च्यानल जडान गर्दछ ।"

#: protocols/irc/ircprotocol.cpp:178
msgid ""
"USAGE: /topic [<topic>] - Sets and/or displays the topic for the active "
"channel."
msgstr "USAGE: /topic [<topic>] - सक्रिय च्यानलका लागि विषय सेट गर्दछ र/वा प्रदर्शन गर्दछ ।"

#: protocols/irc/ircprotocol.cpp:183
msgid "USAGE: /whois <nickname> - Display whois info on this user."
msgstr "USAGE: /whois <nickname> - यो प्रयोकर्तामा सूचना को हो देखाउँछ ।"

#: protocols/irc/ircprotocol.cpp:187
msgid "USAGE: /whowas <nickname> - Display whowas info on this user."
msgstr "USAGE: /whowas <nickname> - यो प्रयोगकर्तामा सूचना को थियो देखाउँछ ।"

#: protocols/irc/ircprotocol.cpp:191
msgid "USAGE: /who <nickname|channel> - Display who info on this user/channel."
msgstr "USAGE: /who <nickname|channel> - यो प्रयोगकर्ता/च्यानलमा को सूचना छ प्रदर्शन गर्नुहोस् ।"

#: protocols/irc/ircprotocol.cpp:195
msgid "USAGE: /query <nickname> [<message>] - Open a private chat with this user."
msgstr "USAGE: /query <nickname> [<message>] - यो प्रयोगकर्तासँग निजी कुराकानी खोल्नुहोस् ।"

#: protocols/irc/ircprotocol.cpp:199
msgid "USAGE: /mode <channel> <modes> - Set modes on the given channel."
msgstr "USAGE: /mode <channel> <modes> - दिएको च्यानलमा मोड सेट गर्दछ ।"

#: protocols/irc/ircprotocol.cpp:203
msgid "USAGE: /nick <nickname> - Change your nickname to the given one."
msgstr "USAGE: /nick <nickname> - दिएको एउटामा तपाईँको उपनाम परिवर्तन गर्नुहोस् ।"

#: protocols/irc/ircprotocol.cpp:207
msgid "USAGE: /me <action> - Do something."
msgstr "USAGE: /me <action> - केही गर्नुहोस् ।"

#: protocols/irc/ircprotocol.cpp:211
msgid "USAGE: /ame <action> - Do something in every open chat."
msgstr "USAGE: /ame <action> - हरेक खुल्ला कुराकानीमा केही गर्नुहोस् ।"

#: protocols/irc/ircprotocol.cpp:215
msgid ""
"USAGE: /kick <nickname> [<reason>] - Kick someone from the channel (requires "
"operator status)."
msgstr "USAGE: /kick <nickname> [<reason>] - च्यानलबाट कसैलाई हटाउनुहोस् (सञ्चालक वस्तुस्थिति आवश्यक पर्दछ) ।"

#: protocols/irc/ircprotocol.cpp:220
msgid ""
"USAGE: /ban <mask> - Add someone to this channel's ban list. (requires "
"operator status)."
msgstr "USAGE: /ban <mask> - यो च्यानलको निषेध सूचीमा कसैलाई थप्नुहोस् । (सञ्चालक वस्तुस्थिति आवश्यक पर्दछ) ।"

#: protocols/irc/ircprotocol.cpp:225
msgid ""
"USAGE: /bannick <nickname> - Add someone to this channel's ban list. Uses "
"the hostmask nickname!*@* (requires operator status)."
msgstr "USAGE: /bannick <nickname> - यो च्यानलको निषेधित सूचीमा कसैलाई थप्नुहोस् । होस्टमास्क उपनाम!*@* प्रयोग गर्दछ (सञ्चालक वस्तुस्थिति आवश्यक पर्दछ) ।"

#: protocols/irc/ircprotocol.cpp:229
msgid ""
"USAGE: /op <nickname 1> [<nickname 2> <...>] - Give channel operator status "
"to someone (requires operator status)."
msgstr "USAGE: /op <nickname 1> [<nickname 2> <...>] - च्यानल सञ्चालक वस्तुस्थिति कसैलाई दिनुहोस् (सञ्चालक वस्तुस्थिति आवश्यक पर्दछ) ।"

#: protocols/irc/ircprotocol.cpp:234
msgid ""
"USAGE: /deop <nickname> [<nickname 2> <...>]- Remove channel operator status "
"from someone (requires operator status)."
msgstr "USAGE: /deop <nickname> [<nickname 2> <...>]- कसैबाट च्यानल सञ्चालक वस्तुस्थिति हटाउनुहोस् (सञ्चालक वस्तुस्थिति आवश्यक पर्दछ) ।"

#: protocols/irc/ircprotocol.cpp:238
msgid ""
"USAGE: /voice <nickname> [<nickname 2> <...>]- Give channel voice status to "
"someone (requires operator status)."
msgstr "USAGE: /voice <nickname> [<nickname 2> <...>]- च्यानल आवाज वस्तुस्थिति कसैलाई दिनुहोस् (सञ्चालक वस्तुस्थिति आवश्यक पर्दछ) ।"

#: protocols/irc/ircprotocol.cpp:243
msgid ""
"USAGE: /devoice <nickname> [<nickname 2> <...>]- Remove channel voice status "
"from someone (requires operator status)."
msgstr "USAGE: /devoice <nickname> [<nickname 2> <...>]- कसैबाट च्यानल आवाज वस्तुस्थिति हटाउनुहोस् (सञ्चालक वस्तुस्थिति आवश्यक पर्दछ) ।"

#: protocols/irc/ircprotocol.cpp:247
msgid "USAGE: /quit [<reason>] - Disconnect from IRC, optionally leaving a message."
msgstr "USAGE: /quit [<reason>] - वैकल्पिक रूपमा सन्देश छोडेर, आई आर सीबाट विच्छेदन गर्नहोस् ।"

#: protocols/irc/ircprotocol.cpp:251
msgid "USAGE: /part [<reason>] - Part from a channel, optionally leaving a message."
msgstr "USAGE: /part [<reason>] - वैकल्पिक रूपमा सन्देश छोडेर, च्यानलबाट भाग गर्नुहोस् ।"

#: protocols/irc/ircprotocol.cpp:255
msgid "USAGE: /invite <nickname> [<channel>] - Invite a user to join a channel."
msgstr "USAGE: /invite <nickname> [<channel>] - च्यानल जडान गर्न प्रयोगकर्तालाई निमन्त्रणा गर्नुहोस् ।"

#: protocols/irc/ircprotocol.cpp:259
msgid "USAGE: /j <#channel 1> [<password>] - Alias for JOIN."
msgstr "USAGE: /j <#channel 1> [<password>] - जडानका लागि उपनाम ।"

#: protocols/irc/ircprotocol.cpp:264
msgid "USAGE: /msg <nickname> [<message>] - Alias for QUERY <nickname> <message>."
msgstr "USAGE: /msg <nickname> [<message>] - QUERY का लागि उपनाम <nickname> <message> ।"

