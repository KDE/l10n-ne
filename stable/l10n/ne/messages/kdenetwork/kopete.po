msgstr "गोपनीयता प्रबन्ध गर्नुहोस्..."

#: protocols/groupwise/gwaccount.cpp:247
msgid "GroupWise SSL Error"
msgstr "समूहगत SSL त्रुटि"

#: protocols/groupwise/gwaccount.cpp:556
msgid ""
"A change happened to your GroupWise contact list while you were offline "
"which was impossible to reconcile."
msgstr "तपाईँ अफलाइन हुँदा तपाईँको समूहगत सम्पर्क सूचीमा परिवर्तन भयो जुन मिलाउन असम्भव थियो ।"

#: protocols/groupwise/gwaccount.cpp:556
msgid "Conflicting Changes Made Offline"
msgstr "परिवर्तनको द्वन्दले अफलाइन बनायो"

#: protocols/groupwise/gwaccount.cpp:629
msgid ""
"_: Error shown when connecting failed\n"
"Kopete was not able to connect to the GroupWise Messenger server for account "
"'%1'.\n"
"Please check your server and port settings and try again."
msgstr ""
"Kopete खाता '%1' का लागि समूहगत मेसेन्जर सर्भरमा जडान गर्न अक्षम भयो ।\n"
"कृपया तपाईँको सर्भर र पोर्ट सेटिङ जाँच गर्नुहोस् र फेरि प्रयास गर्नुहोस् ।"

#: protocols/groupwise/gwaccount.cpp:629
msgid "Unable to Connect '%1'"
msgstr " '%1' मा जडान गर्न अक्षम भयो"

#: protocols/groupwise/gwaccount.cpp:748
msgid "The certificate of server %1 could not be validated for account %2: %3"
msgstr "सर्भर %1 को प्रमाणपत्र खाता %2: %3 का लागि वैधता हुन सकेन"

#: protocols/groupwise/gwaccount.cpp:752
msgid "GroupWise Connection Certificate Problem"
msgstr "समूहगत जडान प्रमाणपत्र समस्या"

#: protocols/groupwise/gwaccount.cpp:794
msgid ""
"_: Prefix used for automatically generated auto-reply messages when the "
"contact is Away, contains contact's name\n"
"Auto reply from %1: "
msgstr " %1 बाट स्वत: जवाफ: "

#: protocols/groupwise/gwaccount.cpp:800
msgid ""
"_: Prefix used for broadcast messages\n"
"Broadcast message from %1: "
msgstr " %1 बाट प्रसारण सन्देश: "

#: protocols/groupwise/gwaccount.cpp:806
msgid ""
"_: Prefix used for system broadcast messages\n"
"System Broadcast message from %1: "
msgstr " %1 बाट प्रणाली प्रसारण सन्देश: "

#: protocols/groupwise/gwaccount.cpp:1170
msgid "The contact %1 could not be added to the contact list, with error message: %2"
msgstr "सम्पर्क %1 त्रुटि सन्देश: %2 सँग, सम्पर्क सूचीमा थप्न सकेन"

#: protocols/groupwise/gwaccount.cpp:1172
msgid "Error Adding Contact"
msgstr "सम्पर्क थप्दा त्रुटि"

#: protocols/groupwise/gwaccount.cpp:1217
msgid ""
"_: The parameter is the user's own account id for this protocol\n"
"You have been disconnected from GroupWise Messenger because you signed in as "
"%1 elsewhere"
msgstr ""
"तपाईँ समूहगत मेसेन्जरबाट विच्छेदन भयो किनभने तपाईँले अन्यत्र "
"%1 को रूपमा साइन इन गर्नुभयो"

#: protocols/groupwise/gwaccount.cpp:1217
msgid "Signed in as %1 Elsewhere"
msgstr "अन्यत्र %1 को रूपमा साइन इन गरियो"

#: protocols/groupwise/gwaccount.cpp:1325
msgid "%1 has been invited to join this conversation."
msgstr "%1 लाई यो वार्तालाप जडान गर्न निमन्त्रणा गरियो ।"

#: protocols/groupwise/gwaccount.cpp:1346
msgid "Enter Auto-Reply Message"
msgstr "स्वत: जवाफ सन्देश प्रविष्ट गर्नुहोस्"

#: protocols/groupwise/gwaccount.cpp:1347
msgid ""
"Please enter an Auto-Reply message that will be shown to users who message "
"you while Away or Busy"
msgstr "कृपया एउटा स्वत: जवाफ सन्देश प्रविष्ट गर्नुहोस् जुन प्रयोगकर्तालाई देखाइनेछ जसले तपाईँ टाढा वा व्यस्त हुँदा सन्देश गर्छ"

#: protocols/groupwise/gwmessagemanager.cpp:68
#: protocols/groupwise/gwmessagemanager.cpp:506
msgid "Security Status"
msgstr "सुरक्षा वस्तुस्थिति"

#: protocols/groupwise/gwmessagemanager.cpp:69
msgid "Conversation is secure"
msgstr "वार्तालाप सुरक्षित छ"

#: protocols/groupwise/gwmessagemanager.cpp:71
#: protocols/groupwise/gwmessagemanager.cpp:513
msgid "Archiving Status"
msgstr "वस्तुस्थिति सङग्रह गर्दै"

#: protocols/groupwise/gwmessagemanager.cpp:199
#, c-format
msgid "An error occurred when trying to start a chat: %1"
msgstr "कुराकानी सुरु गर्ने प्रयास गर्दा एउटा त्रुटि देकापर्यो: %1"

#: protocols/groupwise/gwmessagemanager.cpp:226
msgid ""
"Your message could not be sent. You cannot send messages while your status "
"is Appear Offline. "
msgstr "तपाईँको सन्देश पठाउन सकेन । तपाईँको वस्तुस्थिति अफलाइन देखिदा तपाईँले सन्देश पठाउन सक्नुहुन्न ।"

#: protocols/groupwise/gwmessagemanager.cpp:319
msgid "&Other..."
msgstr "अन्य..."

#: protocols/groupwise/gwmessagemanager.cpp:338
#: protocols/groupwise/gwmessagemanager.cpp:384
msgid "Enter Invitation Message"
msgstr "निमन्त्रणा सन्देश प्रविष्ट गर्नुहोस्"

#: protocols/groupwise/gwmessagemanager.cpp:339
#: protocols/groupwise/gwmessagemanager.cpp:385
msgid "Enter the reason for the invitation, or leave blank for no reason:"
msgstr "निमन्त्रणाका लागि कारण प्रविष्ट गर्नुहोस्, वा कुनै कारण नभएका लागि खाली छोड्नुहोस्:"

#: protocols/groupwise/gwmessagemanager.cpp:363
msgid "Search for Contact to Invite"
msgstr "निमन्त्रणा गर्न सम्पर्कका लागि खोजी गर्नुहोस्"

#: protocols/groupwise/gwmessagemanager.cpp:398
msgid ""
"_: label attached to contacts who have been invited but are yet to join a "
"chat\n"
"(pending)"
msgstr "(विचारधीन)"

#: protocols/groupwise/gwmessagemanager.cpp:445
msgid ""
"All the other participants have left, and other invitations are still "
"pending. Your messages will not be delivered until someone else joins the "
"chat."
msgstr "अन्य सबै सहभागीहरू छोडिए, र अन्य निमन्त्रणा अझै विचारधीनमा छन् । तपाईँको सन्देश कसैले पनि कुराकानीमा जडान नगरे सम्म हस्तान्तरण हुनेछैन ।"

#: protocols/groupwise/gwmessagemanager.cpp:471
msgid "%1 has rejected an invitation to join this conversation."
msgstr "%1 ले यो वार्तालाप जडान गर्न एउटा निमन्त्रणा अस्वीकार गर्यो ।"

#: protocols/groupwise/gwmessagemanager.cpp:493
msgid "Conversation is being administratively logged"
msgstr "वार्तालाप प्रशासनिक रूपमा लग गरियो"

#: protocols/groupwise/gwmessagemanager.cpp:498
msgid "Conversation is not being administratively logged"
msgstr "वार्तालाप प्रशासनिक रूपमा लग गरियो"

#: protocols/groupwise/gwmessagemanager.cpp:506
msgid "This conversation is secured with SSL security."
msgstr "यो वार्तालाप SSL सुरक्षासँग सुरक्षित गरिएको छ ।"

#: protocols/groupwise/gwmessagemanager.cpp:513
msgid "This conversation is being logged administratively."
msgstr "वार्तालाप प्रशासनिक रूपमा लग गरियो ।"

