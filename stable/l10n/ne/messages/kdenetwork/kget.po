#: kmainwidget.cpp:440
msgid ""
"<b>Resume</b> button starts selected transfers\n"
"and sets their mode to <i>queued</i>."
msgstr ""
"<b>पुन: निरन्तरता</b> बटनले चयन गरिएको स्थानान्तरण सुरु गर्दछ\n"
"र तिनीहरूको मोडलाई <i>लाम लगाइएको</i> मा सेट गर्दछ ।"

#: kmainwidget.cpp:443
msgid ""
"<b>Pause</b> button stops selected transfers\n"
"and sets their mode to <i>delayed</i>."
msgstr ""
"<b>पज</b> बटनले चयन गरिएको स्थानान्तरण रोक्दछ\n"
"र तिनीहरूको मोड <i>विलम्ब गरिएको</i> मा सेट गर्दछ ।"

#: kmainwidget.cpp:446
msgid ""
"<b>Delete</b> button removes selected transfers\n"
"from the list."
msgstr ""
"<b>मेट्नुहोस्</b> बटनले सूचीबाट चयन गरिएको\n"
" स्थानान्तरण हटाउँदछ ।"

#: kmainwidget.cpp:449
msgid ""
"<b>Restart</b> button is a convenience button\n"
"that simply does Pause and Resume."
msgstr ""
"<b>फेरि सुरु गर्नुहोस्</b> बटन सुविधाजनक बटन हो\n"
"जसले साधारण तरिकाले पज र पुन: निरन्तरता गर्छ ।"

#: kmainwidget.cpp:452
msgid ""
"<b>Queued</b> button sets the mode of selected\n"
"transfers to <i>queued</i>.\n"
"\n"
"It is a radio button -- you can choose between\n"
"three modes."
msgstr ""
"<b>लाम लगाइएको</b> बटनले <i>लाम लगाइएको</i> मा चयन\n"
"गरिएको स्थानान्तरणको मोड सेट गर्दछ ।\n"
"\n"
"यो तपाईँले तीन मोडहरूको बीच रोज्न\n"
"सक्नुहुने -- रेडियो बटन हो ।"

#: kmainwidget.cpp:455
msgid ""
"<b>Scheduled</b> button sets the mode of selected\n"
"transfers to <i>scheduled</i>.\n"
"\n"
"It is a radio button -- you can choose between\n"
"three modes."
msgstr ""
"<b>कार्यतालिका</b> गरिएको बटनले <i>कार्यतालिका गरिएको</i> मा\n"
"चयन गरिएको स्थानान्तरणको मोड सेट गर्दछ ।\n"
"\n"
"यो तपाईँले तीन मोडहरूको बीच रोज्न\n"
"सक्नुहुने -- रेडियो बटन हो ।"

#: kmainwidget.cpp:458
msgid ""
"<b>Delayed</b> button sets the mode of selected\n"
"transfers to <i>delayed</i>.This also causes the selected transfers to stop.\n"
"\n"
"It is a radio button -- you can choose between\n"
"three modes."
msgstr ""
"<b>विलम्ब </b> गरिएको बटनले <i>विलम्ब गरिएको</i> मा चयन\n"
"गरिएको स्थानान्तरणको मोड सेट गर्दछ । यसले पनि चयन गरिएको स्थानान्तरण रोक्दछ ।\n"
"\n"
"यो तपाईँले तीन मोडहरूको बीच रोज्न\n"
"सक्नुहुने -- रेडियो बटन हो ।"

#: kmainwidget.cpp:461
msgid ""
"<b>Preferences</b> button opens a preferences dialog\n"
"where you can set various options.\n"
"\n"
"Some of these options can be more easily set using the toolbar."
msgstr ""
"<b>प्राथमिकता</b> बटनले तपाईँले विभिन्न विकल्प सेट गर्ने ठाउँमा\n"
"प्राथमिकता संवाद खोल्दछ ।\n"
"\n"
"यी मध्य केही विकल्प उपकरणपट्टी प्रयोग गरेर सजिलै सेट गर्न सकिन्छ ।"

#: kmainwidget.cpp:464
msgid ""
"<b>Log window</b> button opens a log window.\n"
"The log window records all program events that occur\n"
"while KGet is running."
msgstr ""
"<b>लग सञ्झ्याल</b> बटनले लग सञ्झ्याल खोल्दछ ।\n"
"केडीइ गेट चलिरहेको बेलामा देखापर्ने सबै कार्यक्रम घटना\n"
"लग सञ्झ्यालले रेकर्ड गर्दछ ।"

#: kmainwidget.cpp:467
msgid ""
"<b>Paste transfer</b> button adds a URL from\n"
"the clipboard as a new transfer.\n"
"\n"
"This way you can easily copy&paste URLs between\n"
"applications."
msgstr ""
"<b>स्थानान्तरण टाँस्नुहोस्</b> बटनले नयाँ स्थानान्तरणको रूपमा\n"
"क्लिपबोर्डबाट यूआरएल थप्दछ ।\n"
"\n"
"यो तरिकाबाट तपाईँले सजिलै अनुप्रयोगहरू बीच\n"
"यूआरएल प्रतिलिपि गर्न र टाँस्न सक्नुहुन्छ ।"

#: kmainwidget.cpp:470
msgid ""
"<b>Expert mode</b> button toggles the expert mode\n"
"on and off.\n"
"\n"
"Expert mode is recommended for experienced users.\n"
"When set, you will not be \"bothered\" by confirmation\n"
"messages.\n"
"<b>Important!</b>\n"
"Turn it on if you are using auto-disconnect or\n"
"auto-shutdown features and you want KGet to disconnect \n"
"or shut down without asking."
msgstr ""
"<b>सिपालु मोड</b> बटनले सिपालु मोड\n"
"खुल्ला र बन्दलाई टगल गर्दछ ।\n"
"\n"
"सिपालु मोड अनुभवी प्रयोगकर्ताका लागि सिफारिस गरिन्छ ।\n"
"सेट गर्दा, तपाईँ यकीन\n"
"सन्देशबाट \"झन्झट\" हुनेछैन ।\n"
"<b>महत्वपूर्ण!</b>\n"
"यदि तपाईँ स्वत: विच्छेदन वा स्वत: बन्द\n"
"सुविधा प्रयोग गरिरहनु भएको छ भने यसलाई खोल्नुहोस् र तपाईँ नसोधीकन\n"
"विच्छेदन र बन्द गर्न चाहनुहुन्छ ।"

#: kmainwidget.cpp:473
msgid ""
"<b>Use last folder</b> button toggles the\n"
"use-last-folder feature on and off.\n"
"\n"
"When set, KGet will ignore the folder settings\n"
"and put all new added transfers into the folder\n"
"where the last transfer was put."
msgstr ""
"<b>अन्तिम बटन प्रयोग गर्नुहोस्</b> बटनले प्रयोग गर्ने\n"
"अन्तिम फोल्डर सुविधा खुल्ला र बन्द टगल गर्दछ ।\n"
"\n"
"सेट गर्दा, केडीई गेटले फोल्डर सेटिङ उपेक्षा गर्नेछ\n"
"र फोल्डरमा सबै नयाँ थपिएको स्थानान्तरण राख्नुहोस्\n"
"जहाँ अन्तिम स्थानान्तरण राखिएको हुन्छ ।"

#: kmainwidget.cpp:476
msgid ""
"<b>Auto disconnect</b> button toggles the auto-disconnect\n"
"mode on and off.\n"
"\n"
"When set, KGet will disconnect automatically\n"
"after all queued transfers are finished.\n"
"\n"
"<b>Important!</b>\n"
"Also turn on the expert mode when you want KGet\n"
"to disconnect without asking."
msgstr ""
"<b>स्वत: विच्छेदन</b> बटनले स्वत: विच्छेदन\n"
"मोड खुल्ला र बन्द टगल गर्दछ ।\n"
"\n"
"सेट गर्दा, के गेटले सबै लाम लगाइएको स्थानान्तरण\n"
"समाप्त भएपछि स्वचालित रूपमा विच्छेदन गर्नेछ ।\n"
"\n"
"<b>महत्वपूर्ण!</b>\n"
"यदि तपाईँ नसोधीकन केडीई गेट विच्छेदन गर्न चाहनुहुन्छ भने\n"
"सिपालु मोड पनि खोल्नुहोस् ।"

#: kmainwidget.cpp:479
msgid ""
"<b>Auto shutdown</b> button toggles the auto-shutdown\n"
"mode on and off.\n"
"\n"
"When set, KGet will quit automatically\n"
"after all queued transfers are finished.\n"
"<b>Important!</b>\n"
"Also turn on the expert mode when you want KGet\n"
"to quit without asking."
msgstr ""
"<b>स्वत: बन्द</b> बटनले स्वत: बन्द मोड\n"
"खुल्ला र बन्द टगल गर्दछ ।\n"
"\n"
"सेट गर्दा, लाम लगाइएका सबै स्थानान्तरण समाप्त भएपछि\n"
"स्वचालित रूपमा के गेटले अन्त्य गर्नेछ ।\n"
"<b>महत्वपूर्ण!</b>\n"
"यदि तपाईँ नसोधीकन केडीई गेट अन्त्य गर्न चाहनुहुन्छ भने\n"
"सिपालु मोड खोल्नुहोस् ।"

#: kmainwidget.cpp:482
msgid ""
"<b>Offline mode</b> button toggles the offline mode\n"
"on and off.\n"
"\n"
"When set, KGet will act as if it was not connected\n"
"to the Internet.\n"
"\n"
"You can browse offline, while still being able to add\n"
"new transfers as queued."
msgstr ""
"<b>अफलाइन मोड</b> बटनले अफलाइन मोड\n"
"खुल्ला र बन्द टगल गर्दछ ।\n"
"\n"
"सेट गर्दा, यदि इन्टरनेटमा जडान गरिएको छैन भने\n"
"केडीई गेटले यसरूपमा कार्य गर्नेछ ।\n"
"\n"
"लाम लगाइएको रूपमा नयाँ स्थानान्तरण थप्ने सक्षम हुँदा,\n"
"तपाईँ अफलाइन ब्राउज गर्न सक्नुहुन्छ ।"

#: kmainwidget.cpp:485
msgid ""
"<b>Auto paste</b> button toggles the auto-paste mode\n"
"on and off.\n"
"\n"
"When set, KGet will periodically scan the clipboard\n"
"for URLs and paste them automatically."
msgstr ""
"<b>स्वत: टाँस्नुहोस्</b> बटनले स्वत: टाँस्ने मोड\n"
"खुल्ला र बन्द टगल गर्दछ ।\n"
"\n"
"सेट गर्दा, केडीई गेटले यूआरएलका लागि आवधिक रूपमा\n"
"क्लिपबोर्डमा स्क्यान गर्नेछ र तिनीहरुलाई स्वचालित रूपमा टाँस्नेछ ।"

#: kmainwidget.cpp:488
msgid ""
"<b>Drop target</b> button toggles the window style\n"
"between a normal window and a drop target.\n"
"\n"
"When set, the main window will be hidden and\n"
"instead a small shaped window will appear.\n"
"\n"
"You can show/hide a normal window with a simple click\n"
"on a shaped window."
msgstr ""
"<b>लक्ष्य छोड्नुहोस्</b> बटनले सामन्य सञ्झ्याल र छोड्ने लक्ष्य बीच\n"
"सञ्झ्याल शैली टगल गर्दछ ।\n"
"\n"
"सेट गर्दा, मुख्य सञ्झ्ञाल लुक्नेछ र\n"
"सट्टामा सानो आकारको सञ्झ्याल देखिनेछ ।\n"
"\n"
"तपाईँ आकार गरिएको सञ्झ्यालमा साधारण क्लिक गरेर\n"
"सामान्य सञ्झ्याल देखाउन/लुकाउन सक्नुहुन्छ ।"

