#: keycapturedialog.cpp:50
msgid "Enter Key Combination"
msgstr "कुञ्जी संयोजन प्रविष्ट गर्नुहोस्"

#: krdc.cpp:133 krdc.cpp:156
msgid "The entered host does not have the required form."
msgstr "प्रविष्ट गरिएको होस्टसँग आवश्यक फाराम छैन ।"

#: krdc.cpp:134 krdc.cpp:157
msgid "Malformed URL or Host"
msgstr "विकृत गरिएको यू आर एल वा होस्ट"

#: krdc.cpp:163
msgid "%1 - Remote Desktop Connection"
msgstr "%1 - टाढाको डेस्कटप जडान"

#: krdc.cpp:192
msgid ""
"Here you can see the remote desktop. If the other side allows you to control "
"it, you can also move the mouse, click or enter keystrokes. If the content does "
"not fit your screen, click on the toolbar's full screen button or scale button. "
"To end the connection, just close the window."
msgstr ""
"यहाँ तपाईँले टाढाको डेस्कटप हेर्न सक्नुहुन्छ । यदि अन्य पक्षले तपाईँलाई "
"नियन्त्रण गर्न अनुमति दिन्छ भने, तपाईँले पनि माउस सार्न सक्नुहुन्छ, कुञ्जी "
"स्ट्रोक क्लिक वा प्रविष्ट गर्नुहोस् । यदि सामग्री तपाईँको पर्दासँग मिलेन भने, "
"उपकरणपट्टीको पूरा पर्दा बटन क्लिक गर्नुहोस् वा बटन मापन गर्नुहोस । जडान अन्त्य "
"गर्न, सञ्झ्याल मात्र बन्द गर्नुहोस् ।"

#: krdc.cpp:225
msgid "Establishing connection..."
msgstr "जडान स्थापना गरिँदैछ..."

#: krdc.cpp:231
msgid "Authenticating..."
msgstr "प्रमाणीकरण गर्दैछ..."

#: krdc.cpp:236
msgid "Preparing desktop..."
msgstr "डेस्कटप तयार गरिँदैछ..."

#: krdc.cpp:383
msgid "View Only"
msgstr "हेर्ने मात्र"

#: krdc.cpp:387
msgid "Always Show Local Cursor"
msgstr "सधै स्थानिय कर्सर देखाउनुहोस्"

#: krdc.cpp:472
msgid "Autohide on/off"
msgstr "स्वत: लुकाउने खोल्नुहोस्/बन्द गर्नुहोस्"

#: krdc.cpp:479 krdc.cpp:573 krdc.cpp:575
msgid "Fullscreen"
msgstr "पूरा पर्दा"

#: krdc.cpp:485 krdc.cpp:487 krdc.cpp:605
msgid "Advanced options"
msgstr "उन्नत विकल्प"

#: krdc.cpp:500 krdc.cpp:584
msgid "Scale view"
msgstr "दृश्य मापन गर्नुहोस्"

#: krdc.cpp:508
msgid "Minimize"
msgstr "सानो पार्नुहोस्"

#: krdc.cpp:576
msgid ""
"Switches to full screen. If the remote desktop has a different screen "
"resolution, Remote Desktop Connection will automatically switch to the nearest "
"resolution."
msgstr ""
"पूरा पर्दामा स्वीच गर्दछ । यदि टाढाको डेस्कटपसँग विभिन्न पर्दा रिजोल्युसन छ "
"भने, टाढाको डेस्कटप जडान नजिकको रिजोल्युसनमा स्वचालित रूपमा स्वीच हुनेछ ।"

#: krdc.cpp:582
msgid "Scale"
msgstr "मापन गर्नुहोस्"

#: krdc.cpp:585
msgid "This option scales the remote screen to fit your window size."
msgstr "यो विकल्पले तपाईँ सञ्झ्याल साइज मिलाउन टाढाको पर्दा मापन गर्दछ ।"

#: krdc.cpp:591
msgid "Special Keys"
msgstr "विशेष कुञ्जी"

#: krdc.cpp:593
msgid "Enter special keys."
msgstr "विशेष कुञ्जी प्रविष्ट गर्नुहोस् ।"

#: krdc.cpp:594
msgid ""
"This option allows you to send special key combinations like Ctrl-Alt-Del to "
"the remote host."
msgstr ""
"यो विकल्पले तपाईँलाई विशेष कुञ्जी संयोजन पठाउन अनुमति दिन्छ जस्तै टाढाको "
"होस्टमा Ctrl-Alt-Del ।"

#: krdc.cpp:603
msgid "Advanced"
msgstr "उन्नत"

#: main.cpp:46
msgid "Remote desktop connection"
msgstr "टाढाको डेस्कप जडान"

#: main.cpp:51
msgid "Start in fullscreen mode"
msgstr "पूरापर्दा मोडमा सुरु गर्नुहोस्"

#: main.cpp:53
msgid "Start in regular window"
msgstr "नियमित सञ्झ्यालमा सुरु गर्नुहोस्"

#: main.cpp:55
msgid "Low quality mode (Tight Encoding, 8 bit color)"
msgstr "न्यून गुणस्तर मोड (कसिलो सङ्केतन, ८ बिट रङ)"

#: main.cpp:57
msgid "Medium quality mode (Tight Encoding, lossy)"
msgstr "मध्यम गुणस्तर मोड (कसिलो सङ्केतन, लसी)"

#: main.cpp:59
msgid "High quality mode, default (Hextile Encoding)"
msgstr "उच्च गुणस्तर मोड, पूर्वानिर्धारित (हेक्सटायल सङ्केतन)"

#: main.cpp:61
msgid "Start VNC in scaled mode"
msgstr "मापन गरिएको मोडमा भीएनसी सुरु गर्नुहोस्"

#: main.cpp:63
msgid "Show local cursor (VNC only)"
msgstr "स्थानिय कर्सर (भीएनसी मात्र) देखाउनुहोस्"

#: main.cpp:65
msgid "Override VNC encoding list (e.g. 'hextile raw')"
msgstr "भीएनसी सङ्केतन सूची अधिलेखन गर्नुहोस् (उदाहरणका लागि 'हेक्सटायल र')"

#: main.cpp:67
msgid "Provide the password in a file"
msgstr "फाइलमा पासवर्ड उपलब्ध गर्नुहोस्"

#: main.cpp:68
msgid "The name of the host, e.g. 'localhost:1'"
msgstr "होस्टको नाम, जस्तै 'स्थानिय होस्ट:१'"

#: main.cpp:75 maindialog.cpp:29
msgid "Remote Desktop Connection"
msgstr "टाढाको डेस्कटप जडान"

#: main.cpp:86
msgid "RDP backend"
msgstr "आरडीपी ब्याकइन्ड"

#: main.cpp:88
msgid "Original VNC viewer and protocol design"
msgstr "मौलिक भीएनसी दर्शक र प्रोटोकल डिजाइन"

#: main.cpp:90
msgid "TightVNC encoding"
msgstr "भीएनसी सङ्केतन कसिलो गर्नुहोस्"

#: main.cpp:92
msgid "ZLib encoding"
msgstr "ZLib सङ्केतन"

#: main.cpp:136
msgid "The password file '%1' does not exist."
msgstr "पासवर्ड फाइल '%1' अवस्थित छैन ।"

#: main.cpp:150
msgid "Wrong geometry format, must be widthXheight"
msgstr "गलत ज्यामितिय ढाँचा, चौडाइXउचाइ हुनुपर्छ"

#: maindialog.cpp:30
msgid "&Preferences"
msgstr "प्राथमिकता"

#: maindialog.cpp:36
msgid "Connect"
msgstr "जडान गर्नुहोस्"

#: maindialogwidget.cpp:45
msgid "unknown"
msgstr "अज्ञात"

#: maindialogwidget.cpp:52
msgid "Shared Desktop"
msgstr "साझेदार गरिएको डेस्कटप"

#: maindialogwidget.cpp:55
msgid "Standalone Desktop"
msgstr "स्टान्ड एलोन डेस्कटप"

#: maindialogwidget.cpp:196 maindialogwidget.cpp:357
msgid "default"
msgstr "पूर्वनिर्धारित"

#: maindialogwidget.cpp:261
msgid ""
"Browsing the network is not possible. You probably did not install SLP support "
"correctly."
msgstr ""
"सञ्जाल ब्राउजिङ गर्नु सम्भव छैन । तपाईँले सम्भवत SLP समर्थन सही तरिकाले स्थापना "
"गर्नुभएन ।"

#: maindialogwidget.cpp:263
msgid "Browsing Not Possible"
msgstr "ब्राउजिङ सम्भव छैन"

#: maindialogwidget.cpp:280
msgid "An error occurred while scanning the network."
msgstr "सञ्जाल स्क्यान गर्दा एउटा त्रुटि देखापर्यो ।"

#: maindialogwidget.cpp:281
msgid "Error While Scanning"
msgstr "स्क्यान गर्दा त्रुटि"

#: preferencesdialog.cpp:36
msgid "Preferences"
msgstr "प्राथमिकता"

#: preferencesdialog.cpp:42
msgid "&Host Profiles"
msgstr "होस्ट प्रोफाइल"

#: preferencesdialog.cpp:47
msgid "&VNC Defaults"
msgstr "भीएनसी पूर्वानिर्धारण"

#: preferencesdialog.cpp:52 preferencesdialog.cpp:60
msgid "Do not &show the preferences dialog on new connections"
msgstr "नयाँ जडानमा प्राथमिकता संवाद नदेखाउनुहोस्"

#: preferencesdialog.cpp:55
msgid "RD&P Defaults"
msgstr "आरडीपी पूर्वानिर्धारण"

