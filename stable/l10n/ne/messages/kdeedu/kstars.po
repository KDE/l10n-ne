#: tools/scriptbuilder.cpp:120
msgid ""
"Point the display at the specified location. %1 can be the name of an object, a "
"cardinal point on the compass, or 'zenith'."
msgstr ""
"निर्दिष्ट गरिएको स्थानमा प्रदर्शन इङ्कित गर्नुहोस् । %1 एउटा वस्तुको नाम, "
"कम्पासमा मुख्य बिन्दु, वा 'जेनिथ' हुन सक्छ ।"

#: tools/scriptbuilder.cpp:122
msgid ""
"Point the display at the specified RA/Dec coordinates.  %1 is expressed in "
"Hours; %2 is expressed in Degrees."
msgstr ""
"निर्दिष्ट गरिएको RA/Dec समकक्षमा प्रदर्शन इङ्कित गर्नुहोस् । %1 घण्टामा "
"अभिव्यक्त गरिन्छ; %2 डिग्रीमा अभिव्यक्त गरिन्छ ।"

#: tools/scriptbuilder.cpp:124
msgid ""
"Point the display at the specified Alt/Az coordinates.  %1 and %2 are expressed "
"in Degrees."
msgstr ""
"निर्दिष्ट गरिएको Alt/Az समकक्षमा प्रदर्शन इङ्कित गर्नुहोस् । %1 र %2 डिग्रीमा "
"प्रस्तुत गरिन्छन् ।"

#: tools/scriptbuilder.cpp:126
msgid "Increase the display Zoom Level."
msgstr "जुम स्तर प्रदर्शन बढाउनुहोस् ।"

#: tools/scriptbuilder.cpp:127
msgid "Decrease the display Zoom Level."
msgstr "जुम स्तर प्रदर्शन घटाउनुहोस् ।"

#: tools/scriptbuilder.cpp:128
msgid "Set the display Zoom Level to its default value."
msgstr "यसको पूर्वानिर्धारित मानमा जुम स्तर प्रदर्शन सेट गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:129
msgid "Set the display Zoom Level manually."
msgstr "म्यानुल्ली जुम स्तर प्रदर्शन सेट गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:130
msgid "Set the system clock to the specified Local Time."
msgstr "निर्दिष्ट गरिएको स्थानिय समयमा प्रणाली घडी सेट गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:132
msgid "Pause script execution for %1 seconds."
msgstr " %1 सेकेन्डका लागि स्क्रिप्ट कार्यान्वयन पज गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:133
msgid ""
"Halt script execution until the key %1 is pressed.  Only single-key strokes are "
"possible; use 'space' for the spacebar."
msgstr ""
"कुञ्जी %1 थिचिए सम्म स्क्रिप्ट कार्यान्वयन रोक्नुहोस् । मात्र एकल-कुञ्जी प्रभाव "
"सम्भव छ; खाली स्थानपट्टीका लागि 'खाली स्थान' प्रयोग गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:135
msgid "Set whether the display is tracking the current location."
msgstr "प्रदर्शनले हालको स्थान ट्रयाकिङ गरिरहेको छ छैन सेट गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:136
msgid "Change view option named %1 to value %2."
msgstr " %1 नामकरण गरिएको दृश्य विकल्प मान %2 मा परिवर्तन गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:137
msgid "Set the geographic location to the city specified by %1, %2 and %3."
msgstr ""
" %1, %2 र %3 द्वारा निर्दिष्ट गरिएको शहरमा भौगोलिक स्थान सेट गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:139
msgid "Set the color named %1 to the value %2."
msgstr " %1 नामकरण गरिएको रङ मान %2 मा सेट गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:140
#, c-format
msgid "Load the color scheme named %1."
msgstr " %1 नामकरण गरिएको रङ योजना लोड गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:141
msgid "Export the sky image to the file %1, with width %2 and height %3."
msgstr "चौडाइ %2 र उचाइ %3 सँग, फाइल %1 मा आकाशे छवि निर्यात गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:142
msgid ""
"Print the sky image to a printer or file.  If %1 is true, it will show the "
"print dialog.  If %2 is true, it will use the Star Chart color scheme for "
"printing."
msgstr ""
"मुद्रक वा फाइलमा आकाशे छवि मुद्रण गर्नुहोस् । यदि %1 ठीक छ भने, यसले मुद्रण "
"संवाद देखाउँनेछ । यदि %2 ठीक छ भने, यसले मुद्रणका लागि तारा चित्रपट् रङ योजना "
"प्रयोग गर्नेछ ।"

#: tools/scriptbuilder.cpp:143
msgid "Halt the simulation clock."
msgstr "नक्कली घडी रोक्नुहोस् ।"

#: tools/scriptbuilder.cpp:144
msgid "Start the simulation clock."
msgstr "नक्कली घडी सुरु गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:145
msgid ""
"Set the timescale of the simulation clock to %1.  1.0 means real-time; 2.0 "
"means twice real-time; etc."
msgstr ""
" %1 मा नक्कली घडीको समयमापन सेट गर्नुहोस् । १.० को अर्थ वास्तविक समय हो; २.० को "
"अर्थ डबल वास्तविक समय हो; इत्यादि ।"

#: tools/scriptbuilder.cpp:150
msgid "Establish an INDI device either in local mode or server mode."
msgstr "एउटा इन्डी यन्त्र या त स्थानिय मोड वा सर्भर मोडमा स्थापना गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:153
msgid "Shutdown an INDI device."
msgstr "एउटा इन्डी यन्त्र बन्द गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:156
msgid "Connect or Disconnect an INDI device."
msgstr "एउटा इन्डी यन्त्र जडान गर्नुहोस् वा विच्छेदन गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:160
msgid "Set INDI's device connection port."
msgstr "इन्डीको यन्त्र जडान पोर्ट सेट गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:164
msgid ""
"Set the telescope action. Available actions are SLEW, TRACK, SYNC, PARK, and "
"ABORT."
msgstr ""
"टेलिस्कोप कार्य सेट गर्नुहोस् । उपलब्ध कार्यहरू SLEW, TRACK, SYNC, PARK, र "
"ABORT हुन् ।"

#: tools/scriptbuilder.cpp:168
msgid ""
"Set the telescope target coordinates to the RA/Dec coordinates.  RA is "
"expressed in Hours; DEC is expressed in Degrees."
msgstr ""
"RA/Dec समकक्षमा टेलिस्कोप लक्षित समकक्ष सेट गर्नुहोस् । RA घण्टा अभिव्यक्त "
"गरिन्छ; Dec डिग्रीमा अभिव्यक्त गरिन्छ ।"

#: tools/scriptbuilder.cpp:172
msgid ""
"Set the telescope target coorinates to the RA/Dec coordinates of the selected "
"object."
msgstr ""
"चयन गरिएको वस्तुको RA/Dec समकक्षमा टेलिस्कोप लक्षित समकक्ष सेट गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:176
msgid "Set the telescope longitude and latitude. The longitude is E of N."
msgstr ""
"टेलिस्कोप देशान्तर र अक्षांश सेट गर्नुहोस् । देशान्तर दक्षिणको पूर्व हो ।"

#: tools/scriptbuilder.cpp:180
msgid "Set the device UTC time in ISO 8601 format YYYY/MM/DDTHH:MM:SS."
msgstr ""
"यन्त्र यूटीसी समय आईएसओ ८६०१ ढाँचा YYYY/MM/DDTHH:MM:SS मा सेट गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:184
msgid ""
"Activate an INDI action. The action is the name of any INDI switch property "
"element supported by the device."
msgstr ""
"एउटा इन्डी कार्य सक्रिय गर्नुहोस् । कार्य यन्त्रद्वारा समर्थन गरेको कुनै इन्डी "
"स्विच गुण तत्व हो ।"

#: tools/scriptbuilder.cpp:187
msgid ""
"Pause script execution until action returns with OK status. The action can be "
"the name of any INDI property supported by the device."
msgstr ""
"कार्य ठीक छ वस्तुस्थितिसँग नफर्केसमम स्क्रिप्ट कार्यन्वयन पज गर्नुहोस् । कार्य "
"यन्त्रद्वारा समर्थन गरेको कुनै इन्डी स्विच गुण तत्व हो ।"

#: tools/scriptbuilder.cpp:190
msgid ""
"Set the telescope focuser speed. Set speed to 0 to halt the focuser. 1-3 "
"correspond to slow, medium, and fast speeds respectively."
msgstr ""
"टेलिस्कोप फोकसर गति सेट गर्नुहोस् । फोकसर रोक्न ० मा गति सेट गर्नुहोस् । १-३ "
"क्रमश ढिलो, मध्यम, र छिटो गतिसँग सम्बन्धित छ ।"

#: tools/scriptbuilder.cpp:194
msgid ""
"Start moving the focuser in the direction Dir, and for the duration specified "
"by setINDIFocusTimeout."
msgstr "f"

#: tools/scriptbuilder.cpp:198
msgid ""
"Set the telescope focuser timer in seconds. This is the duration of any "
"focusing procedure performed by calling startINDIFocus."
msgstr ""
"टेलिस्कोप फोकसर समय सूचक सेकेन्डमा सेट गर्नुहोस् । यो आह्वान startINDIFocus "
"द्वारा सम्पादन गरिएको कुनै फोकसिङ प्रक्रियाको अवधि हो ।"

#: tools/scriptbuilder.cpp:202
msgid "Set the target CCD chip temperature."
msgstr "लक्षित सीसीडी चिप तापक्रम सेट गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:206
msgid "Set the target filter position."
msgstr "लक्षित फिल्टर स्थिति सेट गर्नुहोस् ।"

#: tools/scriptbuilder.cpp:210
msgid ""
"Set the CCD camera frame type. Available options are FRAME_LIGHT, FRAME_BIAS, "
"FRAME_DARK, and FRAME_FLAT."
msgstr ""
"सीसीडी फ्रेम प्रकार सेट गर्नुहोस् । उपलब्ध विकल्पहरू FRAME_LIGHT, FRAME_BIAS, "
"FRAME_DARK, र FRAME_FLAT हुन् ।"

#: tools/scriptbuilder.cpp:214
msgid "Start Camera/CCD exposure. The duration is in seconds."
msgstr "क्यामेरा/सीसीडी प्रदर्शन सुरु गर्नुहोस् । अवधि सेकेन्डमा छ ।"

