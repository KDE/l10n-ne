msgstr "'भानाडिस' भनेको भगवति फ्रिज्याको अर्को नाम हो"

#. i18n: file data/data.xml line 1233
#: rc.cpp:661
msgid "Greek 'chroma' means 'color'"
msgstr "ग्रिकमा 'क्रोमा' को अर्थ 'रङ' हुन्छ"

#. i18n: file data/data.xml line 1279
#: rc.cpp:663
msgid ""
"It was discovered near a town named Magnesia in a black earth. Thus. it was "
"named 'magnesia nigra'. short: Manganese"
msgstr ""
"यसलाई पृथ्वीको म्याग्नेसिया नाम गरेको शहरमा फेला पारिएको हो । त्यसैले यसलाई "
"'म्याग्नेसिया निग्रा' र छोटकरीमा: म्याग्नेनेसे भनिन्छ"

#. i18n: file data/data.xml line 1325
#: rc.cpp:665
msgid "Latin 'ferrum'"
msgstr "ल्याटिन 'फेरम'"

#. i18n: file data/data.xml line 1382
#: rc.cpp:667
msgid "Named after the German word 'Kobold' for 'goblin'"
msgstr "जर्मन शब्द 'कोबोल्ड' लाई 'गोब्लिन'"

#. i18n: file data/data.xml line 1433
#: rc.cpp:669
msgid "'Nickel' was the name of a mountain goblin"
msgstr "गोब्लिन हिमालको नाम 'निक्केल' थियो"

#. i18n: file data/data.xml line 1489
#: rc.cpp:671
msgid "Greek 'cuprum' for Cypres"
msgstr "साइप्रेसलाई ग्रिक 'कुपरुम'"

#. i18n: file data/data.xml line 1540
#: rc.cpp:673
msgid "German 'zinking' for 'rough'. because zinc ore is very rough"
msgstr "'रफ' लाई जर्मन 'जिङ्किङ' किनभने जिन ओर धेरै रफ हुन्छ"

#. i18n: file data/data.xml line 1592
#: rc.cpp:675
msgid "'Gallia' is an old name for France"
msgstr "'गालिया' भनेको फ्रान्सको पुरानो नाम हो"

#. i18n: file data/data.xml line 1634
#: rc.cpp:677
msgid "Latin 'germania' is an old name for Germany"
msgstr "जर्मनको पुरानो नाम ल्याटिनमा 'जर्मानिया' हो"

#. i18n: file data/data.xml line 1688
#: rc.cpp:679
msgid "Greek 'arsenikos' for 'male' or 'bold'"
msgstr "'पुरुष' वा 'बलियो' लाई ग्रिकमा 'आर्सेनिकोस' भनिन्छ"

#. i18n: file data/data.xml line 1733
#: rc.cpp:681
msgid "Greek 'selena' for 'moon'"
msgstr "'चन्द्रमा' लाई ग्रिकमा 'सेलेना' भनिन्छ"

#. i18n: file data/data.xml line 1784
#: rc.cpp:683
msgid "Greek 'bromos' for 'smells badly'"
msgstr "'खराब वास्ना' लाई ग्रिकमा 'ब्रोम्रोस' भनिन्छ"

#. i18n: file data/data.xml line 1830
#: rc.cpp:685
msgid "Greek 'kryptos' for 'hidden'"
msgstr "'लुकाइएको' लाई ग्रिकमा 'क्रिपटोस' भनिन्छ"

#. i18n: file data/data.xml line 1884
#: rc.cpp:687
msgid "Latin 'rubidus' for 'dark red'"
msgstr "'गाढा रातो' लाई ल्याटिनमा 'रुबिडोस' भनिन्छ"

#. i18n: file data/data.xml line 1926
#: rc.cpp:689
msgid "Named after the mineral Strontianit"
msgstr "स्टोन्टिनिट मिनरल पछि नामकरण गरिएको"

#. i18n: file data/data.xml line 1978
#: rc.cpp:691
msgid ""
"Named after the small town of Ytterby near Stockholm in Sweden. Terbium. "
"Ytterbium and Gadolinium are also named after this town."
msgstr ""
"स्विडेनको स्टकहोम नजिकको सानो शहरबाट नामकरण गरिएको हो, टर्बिम । उत्तरबिम र "
"गाडोलिनिउमलाई पनि सो शहरबाट नामकरण गरिएको हो ।"

#. i18n: file data/data.xml line 2023
#: rc.cpp:693
msgid "Named after the mineral zircon"
msgstr "मिनरल जिर्कोन पछि नामकरण गरिएको"

#. i18n: file data/data.xml line 2082
#: rc.cpp:695
msgid "Named after Niobe. the daughter of the Greek god Tantalus"
msgstr "भगवान टान्टालुसको छोरि नोवबे पछि नामकरण गरिएको, "

#. i18n: file data/data.xml line 2133
#: rc.cpp:697
msgid ""
"This name has Greek roots. It means 'like Platinum' - it was difficult to "
"distinguish Molybdenum from Platinum."
msgstr ""
"यो नाम ग्रिक मूलको हो । यसको अर्थ 'जस्तै प्याटुनियम' - प्याटुनियमबाट मोल्डेनुम "
"फरक छुट्टाउन कठिन हुन्छ ।"

#. i18n: file data/data.xml line 2190
#: rc.cpp:699
msgid "Greek 'technetos' for artificial"
msgstr "ग्रिकमा कृत्रिमका लागि 'टेक्नोटोस' हुन्छ"

#. i18n: file data/data.xml line 2240
#: rc.cpp:701
msgid "Ruthenia is the old name of Russia"
msgstr "रूसको पुरानो नाम रूथेनिया हो"

#. i18n: file data/data.xml line 2293
#: rc.cpp:703
msgid "Greek 'rhodeos' means 'red like a rose'"
msgstr "ग्रिकमा 'रोथेवस' को अर्थ 'गुलाब जस्तै रातो' हुन्छ"

#. i18n: file data/data.xml line 2337
#: rc.cpp:705
msgid "Named after the planetoid Pallas"
msgstr "प्लेनतोइड पालास पछि नामकरण गरिएको"

#. i18n: file data/data.xml line 2391
#: rc.cpp:707
msgid "Latin 'argentum' for silver"
msgstr "सिल्भरलाई ल्याटिनमा 'आर्गेटम' "

#. i18n: file data/data.xml line 2432
#: rc.cpp:709
msgid "Greek 'kadmia' ('Galmei' = Zinc carbonate)"
msgstr "ग्रिक 'काडमिया' ('गाल्मेइ' = जिन्क कार्बोनेट)"

#. i18n: file data/data.xml line 2486
#: rc.cpp:711
msgid "Named after 'Indigo' because of its blue spectrum"
msgstr "यसको निलो स्पेकट्रमको कारणले 'इन्डिगो' नामकरण गरिएको"

#. i18n: file data/data.xml line 2536
#: rc.cpp:713
msgid "Latin 'stannum' for tin"
msgstr "टिनलाई ल्याटिनमा 'स्ट्यानुम'"

#. i18n: file data/data.xml line 2599
#: rc.cpp:715
msgid "Arabic 'anthos ammonos' for 'blossom of the god Ammon'"
msgstr "'भगवान आम्मोन' लाई अरबीमा 'आन्टोस आमोनोस' "

#. i18n: file data/data.xml line 2649
#: rc.cpp:717
msgid "Latin 'tellus' or 'telluris' for 'Planet Earth'"
msgstr "'पृथ्वी ग्रह' लाई ल्याटिनमा 'टेलुस' वा ' टेलुरिस' "

#. i18n: file data/data.xml line 2707
#: rc.cpp:719
msgid "Greek 'ioeides' for 'violett'"
msgstr "'भायोलेट' लाई ग्रिकमा 'आइवेडेस'"

#. i18n: file data/data.xml line 2752
#: rc.cpp:721
msgid "Greek 'xenos' for 'foreigner'"
msgstr "'विदेशी' लाई ग्रिकमा 'जेनोस'"

#. i18n: file data/data.xml line 2809
#: rc.cpp:723
msgid "Latin 'caesius' for 'heavenblue'"
msgstr "'ह्याभेब्लु' लाई ल्याटिनमा 'काएसिउस'"

#. i18n: file data/data.xml line 2854
#: rc.cpp:725
msgid "Greek 'barys' for 'heavy'"
msgstr "'गह्यौ' लाई ग्रिकमा 'बार्यास'"

#. i18n: file data/data.xml line 2910
#: rc.cpp:727
msgid ""
"Greek 'lanthanein' for 'hidden'. The Lanthanoids are also called the 'rare "
"earth'"
msgstr ""
"लुकाउनुलाई ग्रिकमा 'लान्थानेइन' । लान्थानोड्सलाई 'दुर्लभ पृथ्वी' पनि भनिन्छ ।"

#. i18n: file data/data.xml line 2965
#: rc.cpp:729
msgid "Named after the planetoid Ceres"
msgstr "प्लानेटोइड केरेस पछि नामकरण गरिएको"

#. i18n: file data/data.xml line 3007
#: rc.cpp:731
msgid "Greek 'prasinos didymos' for 'green twin'"
msgstr "'हरियो ट्विन' लाई ग्रिकमा 'पर्सिनोस डिड्योमोस '"

#. i18n: file data/data.xml line 3041
#: rc.cpp:733
msgid "Greek 'neos didymos' for 'new twin'"
msgstr "'नयाँ ट्विन' का लागि ग्रिकमा 'नेवस डिड्योमोस'"

#. i18n: file data/data.xml line 3080
#: rc.cpp:735
msgid ""
"Named after the greek Prometheus. Prometheus stole the fire from the gods and "
"gave it to mankind."
msgstr ""
"ग्रिक प्रमिथस पछि नामकरण गरिएको । प्रमिथसले भगवानबाट आगो चोरेर मानिस जातिलाई "
"दिएका थिए ।"

#. i18n: file data/data.xml line 3115
#: rc.cpp:737
msgid "Named after the mineral Samarskit"
msgstr "मिनरल समरस्कृत पछि नामकरण गरिएको"

#. i18n: file data/data.xml line 3156
#: rc.cpp:739
msgid "Named after Europe"
msgstr "युरोप पछि नामकरण गरिएको"

#. i18n: file data/data.xml line 3189
#: rc.cpp:741
msgid "Named after the Finnish chemist Johan Gadolin"
msgstr "फिनल्यान्डको रसायनविद्ध जोहान गाड्लिन पछि नामकरण गरिएको"

#. i18n: file data/data.xml line 3229
#: rc.cpp:743
msgid "Named after the Swedish town of Ytterby"
msgstr "स्विडिस शहर पछि नामकरण गरिएको"

#. i18n: file data/data.xml line 3262
#: rc.cpp:745
msgid "Greek 'dysprositor' for 'difficult to reach'"
msgstr "'पुग्न गाह्रो' लाई ग्रिकमा 'डेस्प्रोसिटोर'"

#. i18n: file data/data.xml line 3301
#: rc.cpp:747
msgid "Latin 'holmia' for the old name of Stockholm"
msgstr "स्टकहोमको पुरानो नामका लागि ल्याटिन 'होल्मिया'"

#. i18n: file data/data.xml line 3335
#: rc.cpp:749
msgid ""
"Named ofter the Swedish town of Ytterby. Terbium and Ytterbium are also named "
"after this town."
msgstr ""
"स्विडिस शहर पछि नामकरण गरिएको । यो शहर पछि टेर्बिउम र उत्तरबिउम पनि नामकरण "
"गरियो ।"

#. i18n: file data/data.xml line 3374
#: rc.cpp:751
msgid "Named after the old name of Scandinavia. 'Thule'"
msgstr "स्क्यानडिनाभिया, 'थुले' को पुरानो नाम पछि नामकरण गरिएको"

#. i18n: file data/data.xml line 3408
#: rc.cpp:753
msgid ""
"Like Terbium and Gadolinium. this is named after the Swedish town of Ytterby"
msgstr "टेर्बिउम र गाडोलिनिउम जस्तै, यसको नामकरण स्विडिस शहरबाट गरिएको हो"

#. i18n: file data/data.xml line 3449
#: rc.cpp:755
msgid "Named after the Roman name 'Lutetia' for Paris"
msgstr "पेरिसलाई रोमन नाम 'लुटेटिया' बाट नामकण गरिएको"

#. i18n: file data/data.xml line 3485
#: rc.cpp:757
msgid "'Hafnia' is the old name of Kopenhagen (Denmark)"
msgstr "कोपोनहेगन (डेनमार्क) को पुरानो नाम 'हाफिना' हो"

#. i18n: file data/data.xml line 3525
#: rc.cpp:759
msgid "Named after the Greek myth of Tantalos"
msgstr "टान्टालोसको ग्रिक कथा पछि नामकरण गरिएको"

#. i18n: file data/data.xml line 3561
#: rc.cpp:761
msgid ""
"'tung sten' means 'heavy stone' in Swedish. The old name (and thus the symbol "
"'W') was Wolfram. named after a mineral"
msgstr ""
"स्विडेनमा 'ट्युङ स्टेन' को अर्थ 'गह्रौ चट्टान' भन्ने हुन्छ । पुरानो नाम "
"वालफ्रेम (र त्यसैले 'W' प्रतीक) थियो, पछिको नाम मिनेरल नामकरण गरियो ।"

#. i18n: file data/data.xml line 3602
#: rc.cpp:763
msgid "Named after the German river Rhine (latin 'Rhenium')"
msgstr "जर्मन नदी राइन (ल्याटिनमा 'रेनियम') पछि नामकरण गरिएको"

#. i18n: file data/data.xml line 3640
#: rc.cpp:765
msgid "Greek for 'smell'. Its oxides smell strongly like radishes"
msgstr "'गन्ध' लाई ग्रिकमा, . यसले गन्धलाई अक्साइड गर्दछ जस्तै र्याडिस"

#. i18n: file data/data.xml line 3683
#: rc.cpp:767
msgid "Greek 'iris' for 'rainbow'"
msgstr "इन्द्रेणीलाई ग्रिकमा 'इरिस'"

#. i18n: file data/data.xml line 3720
#: rc.cpp:769
msgid "Spanish 'platina' means 'small silver'"
msgstr "स्प्यानिश 'प्लाटिना' को अर्थ 'सानो नदी' हुन्छ "

#. i18n: file data/data.xml line 3761
#: rc.cpp:771
msgid "Latin 'aurum'. named after Aurora. the goddess of sunrise"
msgstr "ल्याटिन 'आर्रुम', सूर्यदयको भगवति उरुरो पछि नामकरण गरिएको"

#. i18n: file data/data.xml line 3799
#: rc.cpp:773
msgid "Graeco-Latin 'hydrargyrum' for 'liquid silver'"
msgstr "'तरल सिल्भर' लाई ग्राएको-ल्याटिन 'हाइड्राग्रुरुम'"

#. i18n: file data/data.xml line 3842
#: rc.cpp:775
msgid "Greek 'tallos' for 'young twig'"
msgstr "'जवान टुसो' लाई ग्रिकमा 'टाल्लोस'"

#. i18n: file data/data.xml line 3881
#: rc.cpp:777
msgid "Latin 'plumbum' for Lead"
msgstr "लिड्लाई ल्याटिनमा 'प्लुमबुम'"

#. i18n: file data/data.xml line 3919
#: rc.cpp:779
msgid "The old name of Bismuth is 'Wismut'. This stood for 'white mass'"
msgstr "बिस्मुथको पुरानो नाम 'विस्मुथ' हो । यो 'सेतो मास' मा रहन्छ"

#. i18n: file data/data.xml line 3956
#: rc.cpp:781
msgid "Named after Poland to honor Marie Curie"
msgstr "म्यारी क्युरीलाई सम्मान गर्नका लागि पोल्याड पछि नामकरण गरिएको"

#. i18n: file data/data.xml line 3999
#: rc.cpp:783
msgid "Greek 'astator' for 'changing'"
msgstr "'चार्जिङ' लाई ग्रिकमा 'यस्टाटोर'"

#. i18n: file data/data.xml line 4038
#: rc.cpp:785
msgid ""
"Named after Radium. It ends with 'on' to make it clear that it is a noble gas"
msgstr ""
"रेडियम पछि नामकरण गरिएको । यो नोबल ग्यास भएको निश्चित गर्न यो 'on' सँग अन्त्य "
"हुन्छ ।"

#. i18n: file data/data.xml line 4070
#: rc.cpp:787
msgid "Named after France to honor Marguerite Perey"
msgstr "मार्गुइरिट पेरेलाई सम्मान गर्न फ्रान्स पछि नामकरण गरिएको"

#. i18n: file data/data.xml line 4102
#: rc.cpp:789
msgid "Latin 'radius' for 'beam', as it is radioactive"
msgstr "'बिम' लाई रेडियोयाक्टिभको रूपमा ल्याटिनमा 'रेडियस'"

#. i18n: file data/data.xml line 4135
#: rc.cpp:791
msgid "Greek 'aktis' for 'beam' - actinium is radioactive"
msgstr "'बिम' लाई ग्रिकमा ' आक्टिस' - याक्टिनुम रेडियोक्याक्टिभ हो ।"

#. i18n: file data/data.xml line 4168
#: rc.cpp:793
msgid "Named after the German god of thunder: Thor"
msgstr "जर्मनको भगवान थन्डर: थोर पछि नामकरण गरिएको"

#. i18n: file data/data.xml line 4210
#: rc.cpp:795
msgid ""
"Greek 'protos' for 'ancester'. Protactinium is before Actinium in the periodic "
"table."
msgstr ""
"'प्राचिन' लाई ग्रिकमा 'प्रोटोस' । आवधिक तालिकामा याक्टिनुम पहिले "
"प्रोट्याक्टिनुम हो ।"

#. i18n: file data/data.xml line 4247
#: rc.cpp:797
msgid "Greek 'ouranos' for 'heaven'. Named after the planet Uranus"
msgstr "'स्वर्ग' लाई ग्रिकमा 'वर्यानोस' । युरानुस ग्रह पछि नामकरण गरिएको"

#. i18n: file data/data.xml line 4292
#: rc.cpp:799
msgid "Named after the planet Neptune."
msgstr "नेप्टुन ग्रह पछि नामकरण गरिएको ।"

#. i18n: file data/data.xml line 4329
#: rc.cpp:801
msgid "Named after the planet Pluto."
msgstr "प्लुटो ग्रह पछि नामकरण गरिएको ।"

#. i18n: file data/data.xml line 4371
#: rc.cpp:803
msgid "Named after America."
msgstr "अमेरिका पछि नामकरण गरिएको ।"

#. i18n: file data/data.xml line 4409
#: rc.cpp:805
msgid "Named after Marie Curie."
msgstr "म्यारी क्युरि पछि नामकरण गरिएको ।"

#. i18n: file data/data.xml line 4439
#: rc.cpp:807
msgid "Named after the town Berkeley where it was discovered."
msgstr "यसलाई पत्ता लगाइएको बार्केले शहर पछि नामकरण गरिएको ।"

#. i18n: file data/data.xml line 4469
#: rc.cpp:809
msgid "Named after the US-State of California."
msgstr "अमेरिकाको राज्य क्यालिफोर्निया पछि नामकरण गरिएको ।"

#. i18n: file data/data.xml line 4499
#: rc.cpp:811
msgid "Named after the scientist Albert Einstein."
msgstr "वैज्ञानिक अल्बर्ट आइस्टाइन पछि नामकरण गरिएको ।"

#. i18n: file data/data.xml line 4530
#: rc.cpp:813
msgid "Named after the scientist Enrico Fermi."
msgstr "वैज्ञानिक इन्रिको फर्मी पछि नामकरण गरिएको ।"

#. i18n: file data/data.xml line 4561
#: rc.cpp:815
msgid "Named after the scientist D.I. Mendeleev."
msgstr "वैज्ञानिक डी आई मान्डेलेभ पछि नामकरण गरिएको ।"

#. i18n: file data/data.xml line 4592
#: rc.cpp:817
msgid "Named after the scientist Alfred Nobel."
msgstr "वैज्ञानिक अल्फ्रेड नोबल पछि नामकरण गरिएको ।"

#. i18n: file data/data.xml line 4623
#: rc.cpp:819
msgid "Named after the scientist Ernest Orlando Lawrence."
msgstr "वैज्ञानिक अर्नेस्ट ओर्नाल्डो लरेन्स पछि नामकरण गरिएको ।"

#. i18n: file data/data.xml line 4658
#: rc.cpp:821
msgid "Named after the scientist Ernest Rutherford"
msgstr "वैज्ञानिक अर्नेस्ट रूथर्फोर्ड पछि नामकरण गरिएको"

#. i18n: file data/data.xml line 4692
