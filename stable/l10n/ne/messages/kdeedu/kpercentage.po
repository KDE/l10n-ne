#: kpercentage.cpp:71
msgid "Number of tasks:"
msgstr "कार्यको सङ्ख्या:"

#: kpercentage.cpp:72
msgid "Level:"
msgstr "स्तर:"

#: kpercentage.cpp:73
msgid "Choose an exercise type:"
msgstr "एउटा अभ्यास प्रकार रोज्नुहोस्:"

#: kpercentage.cpp:83
msgid "x% &of ?? = y"
msgstr "x% &of ?? = y"

#: kpercentage.cpp:84
#, c-format
msgid "x% of &y = ??"
msgstr "x% of &y = ??"

#: kpercentage.cpp:85
#, c-format
msgid "??% o&f x = y"
msgstr "??% o&f x = y"

#: kpercentage.cpp:86
msgid "??"
msgstr "??"

#: kpercentage.cpp:95
msgid "Easy"
msgstr "सजिलो"

#: kpercentage.cpp:96
msgid "Medium"
msgstr "मध्यम"

#: kpercentage.cpp:97
msgid "Crazy"
msgstr "उत्तेजित"

#: kpercentage.cpp:153
msgid "Exercises with base value omitted"
msgstr "हटाएको आधार मानसँग अभ्यास गर्दछ"

#: kpercentage.cpp:154
msgid "Exercises with percent value omitted"
msgstr "हटाएको प्रतिशत मानसँग अभ्यास गर्दछ"

#: kpercentage.cpp:155
msgid "Exercises with percentage omitted"
msgstr "हटाएको प्रतिशतसँग अभ्यास गर्दछ"

#: kpercentage.cpp:156
msgid "Several exercise types in random"
msgstr "अनियमित रूपमा विभिन्न अभ्यास प्रकार"

#: kpercentage.cpp:157
msgid "Choose the number of exercises from 1 to 10."
msgstr "१ देखि १० सम्म अभ्यासको सङ्ख्या रोज्नुहोस् ।"

#: kpercentage.cpp:158
msgid "Choose the level of difficulty."
msgstr "कठिनताको तह रोज्नुहोस् ।"

#: kpercentage.cpp:159 kpercentage.cpp:170
msgid "Close KPercentage."
msgstr "केडीई प्रतिशत बन्द गर्नुहोस् ।"

#: kpercentage.cpp:160 kpercentage.cpp:171
msgid "Get some help."
msgstr "केही मद्दत प्राप्त गर्नुहोस् ।"

#: kpercentage.cpp:164
msgid ""
"Click here to start a sequence of exercises where the base value is omitted."
msgstr ""
"अभ्यासको क्रम सुरु गर्न यहाँ क्लिक गर्नुहोस् जहाँ आधार मान हटाइएको हुन्छ ।"

#: kpercentage.cpp:165
msgid ""
"Click here to start a sequence of exercises where the percent value is omitted."
msgstr ""
"अभ्यासको क्रम सुरु गर्न यहाँ क्लिक गर्नुहोस् जहाँ प्रतिशत मान हटाइएको हुन्छ ।"

#: kpercentage.cpp:166
msgid ""
"Click here to start a sequence of exercises where the percentage is omitted."
msgstr ""
"अभ्यासको क्रम सुरु गर्न यहाँ क्लिक गर्नुहोस् जहाँ प्रतिशत हटाइएको हुन्छ ।"

#: kpercentage.cpp:167
msgid ""
"Click here to start a sequence of exercises where one value is omitted at "
"random."
msgstr ""
"अभ्यासको क्रम सुरु गर्न यहाँ क्लिक गर्नुहोस् जहाँ एउटा मान अनियमित रूपमा "
"हटाइएको छ ।"

#: kpercentage.cpp:168
msgid "Here you can adjust the number of exercises from 1 to 10."
msgstr "यहाँ तपाईँ १ देखि १० सम्म अभ्यासको सङ्ख्या समायोजन गर्न सक्नुहुन्छ ।"

#: kpercentage.cpp:169
msgid "Choose one of the levels <i>easy</i>, <i>medium</i>, and <i>crazy</i>."
msgstr ""
"कुनै एउटा तह <i>सजिलो</i>, <i>मध्यम</i>, र <i>उत्तेजित</i> रोज्नुहोस् ।"

#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "श्यामकृष्ण बल"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "shyamkrishna_bal@yahoo.com"

#: main.cpp:30
msgid "A program to improve your skills in calculating with percentages"
msgstr "प्रतिशतसँगै तपाईँको गणना गर्ने दक्षता सुधार गर्नको लागि कार्यक्रम"

#: main.cpp:42
msgid "KPercentage"
msgstr "केडीई प्रतिशत"

#: main.cpp:48
msgid "coding, coding and coding"
msgstr "कोडिङ, कोडिङ र कोडिङ"

#: main.cpp:49
msgid "CVS, coding and sed-script"
msgstr "CVS, कोडिङ र सेड-स्क्रिप्ट"

#: main.cpp:50
msgid "CVS, coding and Makefile stuff"
msgstr "CVS, कोडिङ र मेकफाइल स्टफ"

#: main.cpp:51 main.cpp:52
msgid "Pixmaps"
msgstr "पिक्सम्याप"

#: main.cpp:53
msgid "Spelling and Language"
msgstr "हिज्जे र भाषा"

#: main.cpp:54
msgid "Cleaning and bugfixing code"
msgstr "सफा गर्ने र बग फिक्स गर्ने कोड"

#: main.cpp:55
msgid "SVG icon"
msgstr "SVG प्रतिमा"

#: kpercentmain.cpp:102
#, c-format
msgid " % of "
msgstr "% of "

#: kpercentmain.cpp:107
msgid " = "
msgstr " = "

#: kpercentmain.cpp:114
msgid "Task no. MM:"
msgstr "कार्य नम्बर । MM:"

#: kpercentmain.cpp:117
msgid "You got MM of MM."
msgstr "तपाईँले MM को MM प्राप्त गर्नुभयो ।"

#: kpercentmain.cpp:178
msgid "Number of managed exercises"
msgstr "प्रबन्ध गरिएको अभ्यासको सङ्ख्या"

#: kpercentmain.cpp:179
msgid "Relation of right to wrong inputs"
msgstr "आगत गलत गर्न बायाँको सम्बन्ध"

#: kpercentmain.cpp:180
msgid "Check your answer"
msgstr "तपाईँको जवाफ जाँच गर्नुहोस्"

#: kpercentmain.cpp:181
msgid "Back to the main window"
msgstr "मुख्य सञ्झ्यालमा जानुहोस्"

#: kpercentmain.cpp:205
msgid "You got %1 of %2 exercises."
msgstr "तपाईँले %2 अभ्यासको को %1 प्राप्त गर्नुभयो ।"

#: kpercentmain.cpp:210
msgid "Exercise no. %1:"
msgstr "अभ्यास नम्बर %1:"

#: kpercentmain.cpp:295 kpercentmain.cpp:307
msgid ""
"%1%\n"
"right"
msgstr ""
"%1%\n"
"सही"

#: kpercentmain.cpp:296 kpercentmain.cpp:308
msgid ""
"%1%\n"
"wrong"
msgstr ""
"%1%\n"
"गलत"

#: feedback_i18n.cpp:2
msgid "Good choice!"
msgstr "राम्रो छनौट!"

#: feedback_i18n.cpp:3
msgid "Well done!"
msgstr "राम्रो गर्नुहोस्!"

#: feedback_i18n.cpp:4
msgid "Pretty good!"
msgstr "अति उत्तम!"

#: feedback_i18n.cpp:5
msgid "Fine!"
msgstr "राम्रो!"

#: feedback_i18n.cpp:6
msgid "Right!"
msgstr "सही!"

#: feedback_i18n.cpp:7
msgid "Yes!"
msgstr "हो!"

#: feedback_i18n.cpp:8
msgid "Great!"
msgstr "महान!"

#: feedback_i18n.cpp:9
msgid "Good work!"
msgstr "राम्रो काम!"

#: feedback_i18n.cpp:11
msgid "Wrong!"
msgstr "गलत!"

#: feedback_i18n.cpp:12
msgid "Not right!"
msgstr "त्यति राम्रो होइन!"

#: feedback_i18n.cpp:13
msgid "Think twice!"
msgstr "द्व सोच्नुहोस्!"

#: feedback_i18n.cpp:14
msgid "Sorry, no!"
msgstr "माफ गर्नुहोस्, होइन!"

#: feedback_i18n.cpp:15
msgid "False!"
msgstr "बेठीक!"

#: feedback_i18n.cpp:16
msgid "Try again!"
msgstr "फेरि प्रयास गर्नुहोस्!"

#: feedback_i18n.cpp:17
msgid "Oh no!"
msgstr "ओह नो !"

#: feedback_i18n.cpp:18
msgid "That's not right!"
msgstr "त्यो ठीक होइन!"

#: kanswer.cpp:153 kanswer.cpp:168
msgid "Congratulations!"
msgstr "बधाई छ !"

#: kanswer.cpp:158
msgid "Error!"
msgstr "त्रुटि !"

#: kanswer.cpp:163
msgid "Oops!"
msgstr "उफ!"

#: kanswer.cpp:164
msgid "Mistyped!"
msgstr "गलत टाइप गरियो!"

#: kanswer.cpp:169
msgid ""
"Great!\n"
"You managed all\n"
"the exercises!"
msgstr ""
"महान!\n"
"तपाईँले सबै अभ्यास\n"
"प्रबन्ध गर्नुभयो!"
