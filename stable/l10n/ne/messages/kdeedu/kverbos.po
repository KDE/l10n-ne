#: kerfassen.cpp:276
msgid ""
"The current verb is not in the list yet.\n"
"Do you want to add it?"
msgstr ""
"हालको क्रिया अहिले सम्म सूचीमा छैन ।\n"
"तपाईँ यसलाई अधिलेखन गर्न चाहनुहुन्छ ?"

#: kerfassen.cpp:277
msgid "Do Not Add"
msgstr "नथप्नुहोस्"

#: kerfassen.cpp:423
msgid ""
"The current verb is already in the list.\n"
"Do you want to replace it?\n"
"If you do not want to change the list press 'Cancel'."
msgstr ""
"हालको क्रिया सूचीमा पहिल्यै छ ।\n"
"तपाईँ यसलाई अधिलेखन गर्न चाहनुहुन्छ ?\n"
"यदि तपाईँ सूची परिवर्तन गर्न चाहनुहुन्न भने 'रद्द गर्नुहोस्' थिच्नुहोस् ।"

#: kerfassen.cpp:424
msgid "Do Not Replace"
msgstr "प्रतिस्थापन नगर्नुहोस्"

