#: optiondialog.cc:544
msgid "Cursor jumps to &nearest byte when moved"
msgstr "सार्दा कर्सर नजिकको बाइटमा जान्छ"

#: optiondialog.cc:550
msgid "Sounds"
msgstr "ध्वनि"

#: optiondialog.cc:553
msgid "Make sound on data &input (eg. typing) failure"
msgstr "डेटा आगत असफलतामा ध्वनि बजाउनुहोस् (उदाहरणका लागि टाइपिङ)"

#: optiondialog.cc:557
msgid "Make sound on &fatal failure"
