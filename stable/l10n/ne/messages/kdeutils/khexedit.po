msgid "&Editor starts in \"insert\" mode"
msgstr "\"घुसाउनुहोस्\" मोडमा सम्पादक सुरु हुन्छ"

#: optiondialog.cc:538
msgid "Confirm &wrapping (to beginning or end) during search"
