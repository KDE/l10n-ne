msgid "ThinkLight is on"
msgstr "थिङ्कलाइट खुला छ"

#: thinkpad.cpp:107
msgid "ThinkLight is off"
msgstr "थिङ्कलाइट बन्द छ"

#: thinkpad.cpp:142
msgid "Zoom button pressed"
msgstr "जुम बटन थिचियो"

#: thinkpad.cpp:151
msgid "Home button pressed"
msgstr "गृह बटन थिचियो"

#: thinkpad.cpp:159
msgid "Search button pressed"
msgstr "खोजी बटन थिचियो"

#: thinkpad.cpp:167
msgid "Mail button pressed"
msgstr "पत्र बटन थिचियो"

#: thinkpad.cpp:190
msgid "Display changed: LCD on, CRT off"
msgstr "प्रर्दशन परिवर्तन गरियो: LCD खुला, CRT बन्द"

#: thinkpad.cpp:194
msgid "Display changed: LCD off, CRT on"
msgstr "प्रर्दशन परिवर्तन गरियो: LCD खुला, CRT बन्द"

#: thinkpad.cpp:198
msgid "Display changed: LCD on, CRT on"
msgstr "प्रर्दशन परिवर्तन गरियो: LCD खुला, CRT खुला"

