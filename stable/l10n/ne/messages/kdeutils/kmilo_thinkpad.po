#: thinkpad.cpp:90
msgid "Mute on"
msgstr "मौन पार्नुहोस्"

#: thinkpad.cpp:90
msgid "Mute off"
msgstr "मौन हटाउनुहोस्"

#: thinkpad.cpp:99
msgid "Thinkpad Button Pressed"
