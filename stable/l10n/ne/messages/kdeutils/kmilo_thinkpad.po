msgid "HV Expansion is off"
msgstr "HV विस्तार बन्द छ"

#: thinkpad.cpp:212
msgid "Power management mode AC changed: PM AC high"
msgstr "शक्ति व्यवस्थापन मोड AC परिवर्तन गरियो: PM AC उच्च"

#: thinkpad.cpp:216
msgid "Power management mode AC changed: PM AC auto"
msgstr "शक्ति व्यवस्थापन मोड AC परिवर्तन गरियो: PM AC स्वत"

#: thinkpad.cpp:220
msgid "Power management mode AC changed: PM AC manual"
