#: main.cpp:34
msgid "KDE Floppy Disk Utility"
msgstr "KDE फ्लपी डिस्क उपयोगिता"

#: main.cpp:38
msgid "Default device"
msgstr "पूर्वनिर्धारित यन्त्र"

#: main.cpp:45
msgid "KFloppy"
msgstr "केडीई फ्लपी"

#: main.cpp:51
msgid "KFloppy helps you format floppies with the filesystem of your choice."
msgstr "केडीई फ्लपीले तपाईँको छनोटको फाइल प्रणालीसँग फ्लपीहरू ढाँचाबद्ध गर्न मद्दत गर्दछ ।"

#: main.cpp:54
msgid "Author and former maintainer"
msgstr "लेखक र पूर्व सम्भारकर्ता"

#: main.cpp:55
msgid "User interface re-design"
msgstr "प्रयोगकर्ता इन्टरफेस पुन: डिजाइन"

#: main.cpp:56
msgid "Add BSD support"
msgstr "BSD समर्थन थप्नुहोस्"

#: main.cpp:57
msgid "Make KFloppy work again for KDE 3.4"
msgstr "केडीई फ्लपीलाई KDE 3.4 का लागि फेरि काम गर्ने बनाउनुहोस्"

#: format.cpp:269
#, c-format
msgid "Unexpected drive number %1."
msgstr "अनपेक्षित ड्राइभ नम्बर %1 ।"

#: format.cpp:275
#, c-format
msgid "Unexpected density number %1."
msgstr "अनपेक्षित घनत्व नम्बर %1 ।"

#: format.cpp:290
msgid "Cannot find a device for drive %1 and density %2."
msgstr "%1 ड्राइभ र %2 घनत्वका लागि यन्त्र फेला पार्न सकिँदैन ।"

#: format.cpp:309
msgid ""
"Cannot access %1\n"
"Make sure that the device exists and that you have write permission to it."
msgstr ""
"%1 पहुँच गर्न सकिँदैन\n"
"यन्त्र रहेकोमा र त्यसमा लेख्ने अनुमति भएकोमा निश्चित गर्नुहोस् ।"

#: format.cpp:340
msgid "The program %1 terminated with an error."
msgstr "%1 कार्यक्रम एउटा त्रुटिसँग बन्द भयो ।"

#: format.cpp:346
msgid "The program %1 terminated abnormally."
msgstr "%1 कार्यक्रम असामान्य तरिकाले बन्द भयो ।"

#: format.cpp:409 format.cpp:570 format.cpp:669 format.cpp:770 format.cpp:849
#: format.cpp:943
msgid "Internal error: device not correctly defined."
msgstr "आन्तरिक त्रुटि: यन्त्र राम्रोसँग परिभाषित गरिएको छैन ।"

#: format.cpp:416
msgid "Cannot find fdformat."
msgstr "fdformat फेला पार्न सकिँदैन ।"

#: format.cpp:448
msgid "Could not start fdformat."
msgstr "fdformat सुरु गर्न सकिँदैन ।"

#: format.cpp:475
#, c-format
msgid "Error formatting track %1."
msgstr "%1 ट्रयाक ढाँचा गर्दा त्रुटि ।"

#: format.cpp:483 format.cpp:516
msgid ""
"Cannot access floppy or floppy drive.\n"
"Please insert a floppy and make sure that you have selected a valid floppy "
"drive."
msgstr ""
"फ्लपी वा फ्लपी ड्राइभमा पहुँच गर्न सकिँदैन ।\n"
"फ्लपी घुसाउनुहोस् र तपाईँसँग वैध फ्लपी ड्राइभ भएकोमा यकिन गर्नुहोस् ।"

#: format.cpp:504
#, c-format
msgid "Low-level formatting error at track %1."
msgstr "%1 ट्रयाकमा न्यून-स्तरको ढाँचा त्रुटि ।"

#: format.cpp:509
#, c-format
msgid "Low-level formatting error: %1"
msgstr "न्यून-स्तरको ढाँचा त्रुटि: %1"

#: format.cpp:523 format.cpp:726 format.cpp:892 format.cpp:983
msgid ""
"Device busy.\n"
"Perhaps you need to unmount the floppy first."
msgstr ""
"यन्त्र व्यस्त ।\n"
"सम्भवत तपाईँले फ्लपीलाई पहिला अनमाउन्ट गर्नु पर्दछ ।"

#: format.cpp:529
#, c-format
msgid "Low-level format error: %1"
msgstr "न्यून-स्तर ढाँचा त्रुटि: %1"

#: format.cpp:577
msgid "Cannot find dd."
msgstr "dd फेला पार्न सकिँदैन ।"

#: format.cpp:592
msgid "Could not start dd."
msgstr "dd सुरु गर्न सकेन ।"

#: format.cpp:676
msgid "Cannot find a program to create FAT filesystems."
msgstr "FAT फाइल प्रणाली सिर्जना गर्न कार्यक्रम फेला पार्न सकिँदैन ।"

#: format.cpp:707
msgid "Cannot start FAT format program."
msgstr "FAT ढाँचा कार्यक्रम सुरु गर्न सकिँदैन ।"

#: format.cpp:721 format.cpp:887 format.cpp:978
msgid ""
"Floppy is mounted.\n"
"You need to unmount the floppy first."
msgstr ""
"फ्लपी माउन्ट गरियो ।\n"
"तपाईँले पहिला फ्लपी अनमाउन्ट गर्नु पर्दछ ।"

#: format.cpp:777
msgid ""
"_: BSD\n"
"Cannot find a program to create UFS filesystems."
msgstr "UFS फाइल प्रणाली सिर्जना गर्न कार्यक्रम सिर्जना गर्न सकिँदैन ।"

#: format.cpp:795
msgid ""
"_: BSD\n"
"Cannot start UFS format program."
msgstr "UFS ढाँचा कार्यक्रम सुरु गर्न सकिँदैन ।"

#: format.cpp:856
msgid "Cannot find a program to create ext2 filesystems."
msgstr "ext2 फाइल प्रणाली सिर्जना गर्न कार्यक्रम फेला पार्न सकिँदैन ।"

#: format.cpp:873
msgid "Cannot start ext2 format program."
msgstr "ext2 ढाँचा कार्यक्रम सुरु गर्न सकिँदैन ।"

#: format.cpp:950
msgid "Cannot find a program to create Minix filesystems."
msgstr "मिनिक्स फाइल प्रणाली सिर्जना गर्न कार्यक्रम फेला पार्न सकिँदैन ।"

#: format.cpp:967
msgid "Cannot start Minix format program."
msgstr "मिनिक्स ढाँचा कार्यक्रम सुरु गर्न सकिँदैन ।"

#: floppy.cpp:70
msgid "Floppy &drive:"
msgstr "फ्लपी ड्राइभ:"

#: floppy.cpp:77 floppy.cpp:356 floppy.cpp:704
msgid "Primary"
msgstr "प्राथमिक"

#: floppy.cpp:78 floppy.cpp:360
msgid "Secondary"
msgstr "गौण"

#: floppy.cpp:80
msgid "<qt>Select the floppy drive.</qt>"
msgstr "<qt>फ्लपी ड्राइभ चयन गर्नुहोस्</qt>"

#: floppy.cpp:87
msgid "&Size:"
msgstr "साइज:"

#: floppy.cpp:92
msgid "Auto-Detect"
msgstr "स्वत: पत्ता लगाउनुहोस्"

#: floppy.cpp:94 floppy.cpp:367 floppy.cpp:705
msgid "3.5\" 1.44MB"
msgstr "3.5\" १.४४ एम बी"

#: floppy.cpp:95 floppy.cpp:371
msgid "3.5\" 720KB"
msgstr "3.5\" ७२० के बी"

#: floppy.cpp:96 floppy.cpp:375
msgid "5.25\" 1.2MB"
msgstr "5.25\" १.२ एम बी"

#: floppy.cpp:97 floppy.cpp:379
msgid "5.25\" 360KB"
msgstr "5.25\" ३६० के बी"

#: floppy.cpp:100
msgid "<qt>This allows you to select the floppy disk's size and density.</qt>"
msgstr "<qt>यसले तपाईँलाई फ्लपी डिस्कको साइज र घनत्व चयन गर्न अनुमति दिन्छ ।</qt>"

#: floppy.cpp:108
msgid "F&ile system:"
msgstr "फाइल प्रणाली:"

#: floppy.cpp:115 floppy.cpp:127
msgid ""
"_: Linux\n"
"KFloppy supports three file formats under Linux: MS-DOS, Ext2, and Minix"
msgstr "केडीई फ्लपी ले लिनक्स: अन्तर्गतको तीनवटा फाइल ढाँचा MS-DOS, Ext2 र मिनिक्स समर्थन गर्दछ ।"

#: floppy.cpp:118
msgid ""
"_: BSD\n"
"KFloppy supports three file formats under BSD: MS-DOS, UFS, and Ext2"
msgstr "केडीई फ्लपीले BSD: अन्तर्गतको तिनवटा फाइल ढाँचा MS-DOS, UFS र Ext2 समर्थन गर्दछ"

#: floppy.cpp:129 floppy.cpp:158 floppy.cpp:578 floppy.cpp:706
msgid "DOS"
msgstr "DOS"

#: floppy.cpp:131
msgid ""
"_: Linux\n"
"Program mkdosfs found."
msgstr "कार्यक्रम mkdosfs फेला पर्यो ।"

#: floppy.cpp:134
msgid ""
"_: Linux\n"
"Program mkdosfs <b>not found</b>. MSDOS formatting <b>not available</b>."
msgstr "कार्यक्रम mkdosfs <b>फेला परेन</b> । MSDOS ढाँचा <b>उपलब्ध छैन</b> ।"

#: floppy.cpp:138 floppy.cpp:176 floppy.cpp:595
msgid "ext2"
msgstr "ext2"

#: floppy.cpp:140 floppy.cpp:178
msgid "Program mke2fs found."
msgstr "कार्यक्रम mke2fs फेला पर्यो ।"

#: floppy.cpp:143 floppy.cpp:181
msgid "Program mke2fs <b>not found</b>. Ext2 formatting <b>not available</b>"
msgstr "कार्यक्रम mke2fs <b>फेला परेन </b>। Ext2 ढाँचा <b>उपलब्ध छैन </b>"

#: floppy.cpp:147 floppy.cpp:622
msgid "Minix"
msgstr "मिनिक्स"

#: floppy.cpp:149
msgid ""
"_: Linux\n"
"Program mkfs.minix found."
msgstr "कार्यक्रम mkfs.minix फेला पर्यो ।"

#: floppy.cpp:152
msgid ""
"_: Linux\n"
"Program mkfs.minix <b>not found</b>. Minix formatting <b>not available</b>"
msgstr "कार्यक्रम mkfs.minix <b>फेला परेन</b> । मिनिक्स ढाँचा <b>उपलब्ध छैन</b>"

#: floppy.cpp:156
msgid ""
"_: BSD\n"
"KFloppy supports two file formats under BSD: MS-DOS and UFS"
msgstr "केडीई फ्लपीले BSD: अन्तर्गतको दुईवटा फाइल ढाँचा MS-DOS र UFS समर्थन गर्दछ "

#: floppy.cpp:160
msgid ""
"_: BSD\n"
"Program newfs_msdos found."
msgstr "कार्यक्रम newfs_msdos फेला पर्यो ।"

#: floppy.cpp:163
msgid ""
"_: BSD\n"
"Program newfs_msdos <b>not found</b>. MSDOS formatting <b>not available</b>."
msgstr "कार्यक्रम newfs_msdos <b>फेला परेन</b> । MSDOS ढाँचा <b>उपलब्ध छैन</b> ।"

#: floppy.cpp:167 floppy.cpp:488 floppy.cpp:613
msgid "UFS"
msgstr "UFS"

#: floppy.cpp:169
msgid ""
"_: BSD\n"
"Program newfs found."
msgstr "कार्यक्रम newfs फेला परेन ।"

#: floppy.cpp:172
msgid ""
"_: BSD\n"
"Program newfs <b>not found</b>. UFS formatting <b>not available</b>."
msgstr "कार्यक्रम newfs <b>फेला परेन</b> । UFS ढाँचा <b>उपलब्ध छैन</b> ।"

#: floppy.cpp:187
msgid "&Formatting"
msgstr "ढाँचा"

#: floppy.cpp:190
msgid "Q&uick format"
msgstr "शीघ्र ढाँचा"

#: floppy.cpp:192
msgid ""
"<qt>Quick format is only a high-level format: it creates only a file "
"system.</qt>"
msgstr "<qt>शीघ्र ढाँचा मात्र उच्च‍-स्तरको ढाँचा हो: यसले केबल फाइल प्रणाली सिर्जना गर्दछ </qt>"

#: floppy.cpp:195
msgid "&Zero out and quick format"
msgstr "शून्य बनाउनुहोस् र ढाँचा शीघ्र गर्नुहोस्"

#: floppy.cpp:197
msgid ""
"<qt>This first erases the floppy by writing zeros and then it creates the "
"file system.</qt>"
msgstr "<qt>यसले पहिले शून्य लेखेर फ्लपी मेट्दछ र त्यसपछि यसले फाइल प्रणाली सिर्जना गर्दछ ।</qt>"

#: floppy.cpp:199
msgid "Fu&ll format"
msgstr "पूरा ढाँचा"

#: floppy.cpp:201
msgid ""
"Full format is a low-level and high-level format. It erases everything on "
"the disk."
msgstr "पूरा ढाँचा न्यून-स्तर र उच्च-स्तर ढाँचा हो । यसले डिस्कमा सबैकुरा मेट्दछ ।"

#: floppy.cpp:210
msgid "Program fdformat found."
msgstr "कार्यक्रम fdformat फेला पर्यो ।"

#: floppy.cpp:215
msgid "Program fdformat <b>not found</b>. Full formatting <b>disabled</b>."
msgstr "कार्यक्रम fdformat <b>फेला पर्यो</b>। पूरा ढाँचा <b>अक्षम पारिएको छ </b> ।"

#: floppy.cpp:222
msgid "Program dd found."
msgstr "कार्यक्रम dd फेला पर्यो ।"

#: floppy.cpp:226
msgid "Program dd <b>not found</b>. Zeroing-out <b>disabled</b>."
msgstr "कार्यक्रम dd <b>फेला परेन </b> । शून्य पार्ने <b>अक्षम पारिएको छ</b> ।"

#: floppy.cpp:230
msgid "&Verify integrity"
msgstr "पूर्णता रुजु गर्नुहोस्"

#: floppy.cpp:234
msgid ""
"<qt>Check this if you want the floppy disk to be checked after formatting. "
"Please note that the floppy will be checked twice if you have selected full "
"formatting.</qt>"
msgstr ""
"<qt>यदि तपाईँले ढाँचाबद्धता पछि फ्लपी डिस्क जाँच गरियो भन्ने चाहनुहुन्छ भने यो जाँच गर्नुहोस् । "
"यदि तपाईँले पूरा ढाँचाबद्धता चयन गर्नुभएको छ भने फ्लपी जाँच गरिन्छ भन्ने कृपया याद राख्नुहोस् ।</qt>"

#: floppy.cpp:238
msgid "Volume la&bel:"
msgstr "भोल्युम लेबुल:"

#: floppy.cpp:242
msgid ""
"<qt>Check this if you want a volume label for your floppy. Please note that "
"Minix does not support labels at all.</qt>"
msgstr "<qt>तपाईँको फ्लपीका लागि भोल्युम लेबुल चाहनुहुन्छ भने यसलाई जाँच गर्नुहोस् । मिनिक्सले सबै लेबुलमा समर्थन नगर्ने कुरा याद राख्नुहोस् ।</qt>"

#: floppy.cpp:250 floppy.cpp:702
msgid ""
"_: Volume label, maximal 11 characters\n"
"KDE Floppy"
msgstr "KDE फ्लपी"

#: floppy.cpp:254
msgid ""
"<qt>This is for the volume label. Due to a limitation of MS-DOS the label "
"can only be 11 characters long. Please note that Minix does not support "
"labels, whatever you enter here.</qt>"
msgstr "<qt>यो भोल्युम लेबुलका लागि हो । MS-DOS को सीमाको कारणले गर्दा लेबुल ११ क्यारेक्टर भन्दा लामो हुन सक्दैन । तपाईँले जे प्रविष्ट गरेपनि मिनिक्सले लेबुल समर्थन गर्दैन भन्ने कुरा याद राख्नुहोस् ।</qt>"

#: floppy.cpp:263 floppy.cpp:470
msgid "&Format"
msgstr "ढाँचाबद्ध गर्नुहोस्"

#: floppy.cpp:270
msgid "<qt>Click here to start formatting.</qt>"
msgstr "<qt>ढाँचा सुरु गर्न यहाँ क्लिक गर्नुहोस् ।</qt>"

#: floppy.cpp:293
msgid "<qt>This is the status window, where error messages are displayed.</qt>"
msgstr "<qt>यो वस्तुस्थित सञ्झ्याल हो, जहाँ त्रुटि सन्देश प्रर्दशित हुन्छ ।</qt>"

#: floppy.cpp:307
msgid "<qt>Shows progress of the format.</qt>"
msgstr "<qt>ढाँचाको प्रगति देखाउँदछ ।</qt>"

#: floppy.cpp:315
msgid ""
"KFloppy cannot find any of the needed programs for creating file systems; "
"please check your installation.<br><br>Log:"
msgstr ""
"केडीई फ्लपीले फाइल प्रणाली सिर्जना गर्नका लागि आवश्यक कुनै कार्यक्रम फेला पार्न सकेन; "
"कृपया तपाईँको स्थापना जाँच गर्नुहोस् ।<br><br>लग:"

#: floppy.cpp:347
msgid "KDE Floppy Formatter"
msgstr "KDE फ्लपी ढाँचाकर्ता"

#: floppy.cpp:490
msgid ""
"_: BSD\n"
"Formatting with BSD on a user-given device is only possible with UFS"
msgstr "प्रयोगकर्ता दिइएको यन्त्रमा BSD सँगको ढाँचाबद्धता केबल UFS सँग मात्र सम्भव हुन्छ ।"

#: floppy.cpp:498
msgid ""
"<qt>Formatting will erase all data on the device:<br/><b>%1</b><br/>(Please "
"check the correctness of the device name.)<br/>Are you sure you wish to "
"proceed?</qt>"
msgstr "<qt>ढाँचाबद्ध गर्नाले यन्त्रबाट सबै डेटा मेटिन्छ:<br/><b>%1</b><br/>(कृपया तपाईँको यन्त्र नामको शुद्धता जाँच गर्नुहोस् ।)<br/>के तपाईँ अगाडि बढ्न निश्चित हुनुहुन्छ ?</qt>"

#: floppy.cpp:501 floppy.cpp:516
msgid "Proceed?"
msgstr "अगाडि बढ्नुहुन्छ ?"

#: floppy.cpp:515
msgid ""
"Formatting will erase all data on the disk.\n"
"Are you sure you wish to proceed?"
msgstr ""
"ढाँचाबद्ध गर्नाले डिस्कबाट सबै डेटा मेटिन्छ ।\n"
"के तपाईँ अगाडि बढ्न चाहनुहुन्छ ?"

