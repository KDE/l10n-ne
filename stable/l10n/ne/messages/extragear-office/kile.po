#: kilestdactions.cpp:272
msgid ""
"\\begin{array}{col1col2...coln}\n"
"column 1 entry & column 2 entry ... & column n entry \\\\ \n"
"...\n"
"\\end{array}\n"
"Each column, coln, is specified by a single letter that tells how items in "
"that column should be formatted.\n"
"     c -- for centered \n"
"     l -- for flush left \n"
"     r -- for flush right\n"
msgstr ""
"\\सुरुआत{एरे}{स्तम्भ १ स्तम्भ २...स्तम्भ एन}\n"
"स्तम्भ १ प्रविष्टि र स्तम्भ २ प्रविष्टि ... र स्तम्भ एन प्रविष्टि \\\\ \n"
"...\n"
"\\अन्त्य{एरे}\n"
"प्रत्येक स्तम्भ, स्तम्भ एन एकल अक्षरद्वारा निर्दिष्ट गरिन्छ जसले वस्तुलाई कसरि स्तम्भमा ढाँचाबद्ध गर्नुपर्दछ भनेर भन्छ ।\n"
"     c -- केन्द्रित गर्नका लागि \n"
"     l -- फ्ल्युस बायाँका लागि \n"
"     r -- फ्ल्युस दायाँका लागि\n"

