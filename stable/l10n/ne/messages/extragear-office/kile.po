#: kileprojectdlgs.cpp:58
msgid "Extensions for Image Files"
msgstr "छवि फाइलका लागि विस्तार"

#: kileprojectdlgs.cpp:59
msgid "Use extension list as a regular expression"
msgstr "नियमित अभिव्यक्तिको रूपमा विस्तार सूची प्रयोग गर्नुहोस्"

