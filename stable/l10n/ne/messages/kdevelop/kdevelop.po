msgstr "केडीई विकासमा डिबग गर्नुहोस्"

#: languages/cpp/debugger/debuggerpart.cpp:508
#: languages/ruby/debugger/debuggerpart.cpp:311
msgid "<b>Toggle breakpoint</b><p>Toggles breakpoint at the current line."
msgstr ""
"<b>विच्छेदन बिन्दु टगल गर्नुहोस्</b>"
"<p>हालको लाइनमा विच्छेदन बिन्दु टगल गर्दछ ।"

