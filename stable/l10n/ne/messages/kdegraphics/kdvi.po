#: TeXFontDefinition.cpp:108
msgid "Cannot find font %1, file %2."
msgstr "%1 फन्ट, %2 फाइल फेला पार्न सकेन ।"

#: TeXFontDefinition.cpp:124
#, c-format
msgid "Checksum mismatch for font file %1"
msgstr "%1 फाइलका लागि जाँचयोग बेमेल छ"

#: TeXFontDefinition.cpp:133
msgid "TeX virtual"
msgstr "TeX अवास्तविक"

#: TeXFontDefinition.cpp:142
msgid "TeX Font Metric"
msgstr "TeX फन्ट मेट्रिक"

#: TeXFontDefinition.cpp:167
msgid "FreeType"
msgstr "स्वतन्त्र प्रकार"

#: TeXFontDefinition.cpp:172
#, c-format
msgid "Cannot recognize format for font file %1"
msgstr "%1 फन्ट फाइलका लागि ढाँचा पहिचान गर्न सकिदैन"

#: TeXFont_PFB.cpp:44
msgid ""
"The font file %1 could be opened and read, but its font format is unsupported."
msgstr "%1 फन्ट फाइल खोल्न र पढ्न सक्नेछ, तर यसको फन्ट ढाँचा असमर्थित छ ।"

#: TeXFont_PFB.cpp:50
msgid "The font file %1 is broken, or it could not be opened or read."
msgstr "%1 फन्ट फाइल बिग्रेको छ, वा यसलाई खोल्न वा पढ्न सकिने छैन ।"

#: TeXFont_PFB.cpp:171
#, c-format
msgid ""
"FreeType reported an error when setting the character size for font file %1."
msgstr ""
"%1 फन्ट फाइलका लागि क्यारेक्टर साइज सेटिङ गर्दा स्वतन्त्र प्रकारले त्रुटि "
"प्रतिवेदन गर्यो ।"

#: TeXFont_PFB.cpp:187
msgid "FreeType is unable to load glyph #%1 from font file %2."
msgstr "%2 फन्ट फाइलबाट glyph #%1 लोड गर्न स्वतन्त्र प्रकार अक्षम छ ।"

#: TeXFont_PFB.cpp:199
msgid "FreeType is unable to render glyph #%1 from font file %2."
msgstr "%2 फन्ट फाइलबाट glyph #%1 रेन्डर गर्न स्वतन्त्र प्रकार अक्षम छ ।"

#: TeXFont_PFB.cpp:212
msgid "Glyph #%1 is empty."
msgstr "Glyph #%1 रित्तो छ ।"

#: TeXFont_PFB.cpp:213
msgid "Glyph #%1 from font file %2 is empty."
msgstr "%2 फन्ट फाइल देखि Glyph #%1 सम्म रित्तोछ ।"

#: TeXFont_PFB.cpp:282
msgid "FreeType is unable to load metric for glyph #%1 from font file %2."
msgstr ""
"%2 फन्ट फाइलबाट glyph #%1 का लागि मेट्रिक लोड गर्न स्वतन्त्र प्रकार अक्षम छ ।"

#: TeXFont_PK.cpp:94
#, c-format
msgid "Cannot open font file %1."
msgstr "%1 फन्ट फाइल खोल्न सकिदैन ।"

#: TeXFont_PK.cpp:139
msgid "TexFont_PK::operator[]: Character %1 not defined in font %2"
msgstr "TexFont_PK::operator[]: %2 फन्टमा %1 क्यारेक्टर परिभाषित छैन"

#: TeXFont_PK.cpp:457
msgid "Unexpected %1 in PK file %2"
msgstr "%2 PK फाइलमा अनपेक्षित %1"

#: TeXFont_PK.cpp:524
msgid "The character %1 is too large in file %2"
msgstr "%2 फाइलमा %1 क्यारेक्टर धेरै ठूलो भयो"

#: TeXFont_PK.cpp:629 TeXFont_PK.cpp:715
msgid "Wrong number of bits stored:  char. %1, font %2"
msgstr "संग्रहको बिटको गलत नम्बर:  %1 क्यारेक्टर, %2 फन्ट"

#: TeXFont_PK.cpp:631 TeXFont_PK.cpp:717
msgid "Bad pk file (%1), too many bits"
msgstr "खराब pk फाइल (%1), धेरै बिट छ"

#: TeXFont_PK.cpp:748
msgid "Font has non-square aspect ratio "
msgstr "फन्टसँग वर्ग विहिन आकार अनुपात छ "

#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Mahesh Subedi"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "submanesh@gmail.com"

#: dviFile.cpp:112
msgid "The DVI file does not start with the preamble."
msgstr "DVI फाइल प्रस्तावनासँग सुरु हुदैन ।"

#: dviFile.cpp:117
msgid ""
"The DVI file contains the wrong version of DVI output for this program. Hint: "
"If you use the typesetting system Omega, you have to use a special program, "
"such as oxdvi."
msgstr ""
"यो कार्यक्रमका लागि DVI फाइलले DVI निर्गतको गलत संस्करण समावेश गर्दछ । सङ्केत: "
"यदि तपाईँले टाइपसेटिङ प्रणाली ओमेगा प्रयोग गर्नु भएमा तपाईँले विशेष कार्यक्रम "
"जस्तै oxdvi प्रयोग गर्नु पर्ने हुन्छ ।"

#: dviFile.cpp:155
msgid ""
"The DVI file is badly corrupted. KDVI was not able to find the postamble."
msgstr ""
"DVI फाइल नराम्रोसँग बिग्रेको छ । KDVI ले पोष्टएम्बल फेला पार्न सेकको थिएन ।"

#: dviFile.cpp:170
msgid "The postamble does not begin with the POST command."
msgstr "पोष्टएम्बल POST आदेशसँग सुरु हुदैन ।"

#: dviFile.cpp:225
msgid "The postamble contained a command other than FNTDEF."
msgstr "पोष्टएम्बलले FNTDEF भन्दा बाहेकको आदेश समावेश गर्दछ ।"

#: dviFile.cpp:259
msgid "The page %1 does not start with the BOP command."
msgstr "%1 पृष्ठ BOP आदेशसँग सुरु हुदैन ।"

#: dviFile.cpp:294
msgid "Not enough memory to load the DVI-file."
msgstr "DVI-फाइल लोड गर्न पर्याप्त स्मृति छैन ।"

#: dviFile.cpp:300
msgid "Could not load the DVI-file."
msgstr "DVI-फाइल लोड गर्न सकेन ।"

#: dviRenderer.cpp:210
msgid ""
"<qt><strong>File corruption!</strong> KDVI had trouble interpreting your DVI "
"file. Most likely this means that the DVI file is broken.</qt>"
msgstr ""
"<qt><strong>बिग्रेको फाइल!</strong> KDVI लाई तपाईँको DVI फाइल चलाउदा अप्ठारो "
"भयो । यसको अर्थ DVI फाइल बिग्रेको हुन सक्छ ।</qt>"

#: dviRenderer.cpp:212 dviRenderer.cpp:483
msgid "DVI File Error"
msgstr "DVI फाइल त्रुटि"

#: dviRenderer.cpp:262
msgid "KDVI: Information"
msgstr "KDVI: सूचना"

#: dviRenderer.cpp:277
msgid ""
"<qt>This DVI file contains source file information. You may click into the text "
"with the middle mouse button, and an editor will open the TeX-source file "
"immediately.</qt>"
msgstr ""
"<qt>यो DVI फाइलले स्रोत फाइल सूचना समावेश गर्दछ । तपाईँले मध्य माउस बटनसँग "
"पाठमा क्लिक गर्न सक्नुहुन्छ, र सम्पादकले तुरुन्तै TeX-स्रोत खोल्दछ ।</qt>"

#: dviRenderer.cpp:286
msgid "Explain in more detail..."
msgstr "विस्तारमा वर्णन गर्नुहोस्..."

#: dviRenderer.cpp:315
msgid "Embedding PostScript Files"
msgstr "पोष्टस्क्रिप्ट फाइलहरू सम्मिलित गर्दैछ"

#: dviRenderer.cpp:345
msgid "Not all PostScript files could be embedded into your document."
msgstr "कुनै पनि पोष्टस्क्रिप्ट फाइल तपाईँको कागजातमा सम्मिलित गर्न सकेन ।"

#: dviRenderer.cpp:348
msgid ""
"All external PostScript files were embedded into your document. You will "
"probably want to save the DVI file now."
msgstr ""
"सबै बाह्य पोष्टस्क्रिप्ट फाइल तपाईँको कागजातमा सम्मिलित गरिएको थिए । तपाईँले "
"अहिले DVI फाइल बचत गर्न चाहन सक्नुहुन्छ ।"

#: dviRenderer.cpp:439
msgid ""
"<qt><strong>File error.</strong> The specified file '%1' does not exist. KDVI "
"already tried to add the ending '.dvi'.</qt>"
msgstr ""
"<qt><strong>फाइल त्रुटि ।</strong> निदिष्ट गरिएको फाइल '%1' अवस्थित छैन । KDVI "
"ले पहिल्यै अन्तिम '.dvi' थप्ने प्रयास गरि सक्यो ।</qt>"

#: dviRenderer.cpp:441
msgid "File Error!"
msgstr "फाइल त्रुटि!"

#: dviRenderer.cpp:452
msgid ""
"<qt>Could not open file <nobr><strong>%1</strong></nobr> which has type <strong>"
"%2</strong>. KDVI can only load DVI (.dvi) files.</qt>"
msgstr ""
"<qt><nobr><strong>%1</strong></nobr> फाइल खोल्न सकेन जुनसँग<strong>%2</strong> "
"प्रकार छ । KDVI ले मात्र DVI (.dvi) फाइल लोड गर्न सक्दछ ।</qt>"

#: dviRenderer.cpp:463 dviRenderer.cpp:481
msgid ""
"<qt>File corruption! KDVI had trouble interpreting your DVI file. Most likely "
"this means that the DVI file is broken.</qt>"
msgstr ""
"<qt>बिग्रेको फाइल! KDVI लाई तपाईँको DVI फाइल चलाउन अप्ठारो छ । यसको अर्थ DVI "
"फाइल बिग्रेको हुन सक्दछ ।</qt>"

#: dviRenderer.cpp:640
msgid ""
"<qt>You have asked KDVI to locate the place in the DVI file which corresponds "
"to line %1 in the TeX-file <strong>%2</strong>. It seems, however, that the DVI "
"file does not contain the necessary source file information. We refer to the "
"manual of KDVI for a detailed explanation on how to include this information. "
"Press the F1 key to open the manual.</qt>"
msgstr ""
"<qt>TeX-फाइल <strong>%2</strong> मा %1 रेखासँग सङ्गत DVI फाइलमा स्थान तोक्न "
"KDVI ले तपाईँलाई भनेको छ । तर DVI फाइलले आवश्यक स्रोत फाइल सूचना समावेश गरेको "
"जस्तो देखिदैन । यो सूचना कसरी समावेश गर्ने बारेमा जानकारीका लागि KDVI को "
"म्यानुअल प्रयोग गर्न सुझाव गर्दछौ । म्यानुअल खोल्न F1 कुञ्जी थिच्नुहोस् ।</qt>"

#: dviRenderer.cpp:645 dviRenderer.cpp:685
msgid "Could Not Find Reference"
msgstr "सन्दर्भ फेला पार्न सकेन"

#: dviRenderer.cpp:683
msgid ""
"<qt>KDVI was not able to locate the place in the DVI file which corresponds to "
"line %1 in the TeX-file <strong>%2</strong>.</qt>"
msgstr ""
"<qt>TeX-फाइल <strong>%2</strong> मा %1 रेखासँग सङ्गत DVI फाइलको स्थान तोक्न "
"KDVI अक्षम भयो ।</qt>"

#: dviRenderer.cpp:737
msgid ""
"The DVI-file refers to the TeX-file <strong>%1</strong> "
"which could not be found."
msgstr ""
"DVI फाइलले सन्दर्भ गर्ने TeX-file <strong>%1</strong> फेला पार्न सकिने छैन ।"

#: dviRenderer.cpp:740
msgid "Could Not Find File"
msgstr "फाइल फेला पार्न सकेन"

#: dviRenderer.cpp:747
msgid ""
"You have not yet specified an editor for inverse search. Please choose your "
"favorite editor in the <strong>DVI options dialog</strong> "
"which you will find in the <strong>Settings</strong>-menu."
msgstr ""
"उल्टो खोजीका लागि तपाईँले अझसम्म पनि सम्पादक निर्दिष्ट गर्नु भएको छैन । कृपया "
"<strong>सेटिङ</strong>-मेनुमा तपाईँले फेला पार्ने <strong>"
"DVI विकल्प संवाद</strong> मा रूचाउनु भएको सम्पादक छनोट गर्नुहोस् ।"

#: dviRenderer.cpp:752
msgid "Need to Specify Editor"
msgstr "सम्पादक निर्दिष्ट गर्न आवश्यक"

#: dviRenderer.cpp:753
msgid "Use KDE's Editor Kate for Now"
msgstr "केटका लागि अहिले केडीई को सम्पादक प्रयोग गर्नुहोस्"

#: dviRenderer.cpp:785
msgid ""
"<qt>The external program"
"<br>"
"<br><tt><strong>%1</strong></tt>"
"<br/>"
"<br/>which was used to call the editor for inverse search, reported an error. "
"You might wish to look at the <strong>document info dialog</strong> "
"which you will find in the File-Menu for a precise error report. The manual for "
"KDVI contains a detailed explanation how to set up your editor for use with "
"KDVI, and a list of common problems.</qt>"
msgstr ""
"<qt>उल्टो खोजीका लागि सम्पादक कल गर्न प्रयोग गरिने "
"<br>"
"<br><tt><strong>%1</strong></tt>"
"<br/>"
"<br/> बाह्य कार्यक्रमले त्रुटि प्रतिवेदन गर्यो । तपाईँको त्रुटि प्रतिवेदनका "
"लागि फाइल-मेनुमा फेला पर्ने <strong>कागजात सूचना संवाद</strong> "
"मा हेर्ने चाहना हुन सक्दछ । KDVI को म्यानुअलमा KDVI सँग प्रयोग गर्नका लागि "
"तपाईँको सम्पादक कसरी सेटअप गर्ने र साझा समस्या बारेमा विस्तारित वर्णनसमावेश "
"गर्दछ ।</qt>"

#: dviRenderer.cpp:791
msgid "Starting the editor..."
msgstr "सम्पादक सुरु गर्दैछ..."

#: dviRenderer_draw.cpp:269
msgid "The DVI code set a character of an unknown font."
msgstr "DVI कोडले अज्ञात फन्टको क्यारेक्टर सेट गर्यो ।"

#: dviRenderer_draw.cpp:294 dviRenderer_prescan.cpp:636
msgid "The DVI code referred to font #%1, which was not previously defined."
msgstr ""
"DVI कोडले फन्ट #%1 मा सन्दर्भ गर्यो, जुन पहिल्यै परिभाषित गरिएको थिएन ।"

#: dviRenderer_draw.cpp:379
msgid "The stack was not empty when the EOP command was encountered."
msgstr "EOP आदेशसँग भेट हुदा थाक रित्तो थिएन ।"

#: dviRenderer_draw.cpp:391
msgid "The stack was empty when a POP command was encountered."
msgstr "POP आदेश भेट हुदा थाक रित्तो थियो ।"

#: dviRenderer_draw.cpp:515 dviRenderer_draw.cpp:524
msgid "The DVI code referred to a font which was not previously defined."
msgstr "DVI कोडले पहिले नै परिभाषित नगरिएको फन्ट सन्दर्भ गर्यो ।"

#: dviRenderer_draw.cpp:564
msgid "An illegal command was encountered."
msgstr "एउटा गैरकानुनी आदेश भेटियो ।"

#: dviRenderer_draw.cpp:569
msgid "The unknown op-code %1 was encountered."
msgstr "एउटा गैरकानुनी op-कोड %1 भेटियो ।"

#: dviRenderer_export.cpp:83
msgid ""
"KDVI could not locate the program 'dvipdfm' on your computer. That program is "
"essential for the export function to work. You can, however, convert the "
"DVI-file to PDF using the print function of KDVI, but that will often produce "
"documents which print ok, but are of inferior quality if viewed in the Acrobat "
"Reader. It may be wise to upgrade to a more recent version of your TeX "
"distribution which includes the 'dvipdfm' program.\n"
"Hint to the perplexed system administrator: KDVI uses the shell's PATH variable "
"when looking for programs."
msgstr ""
"KDVI ले तपाईँको कम्प्युटरमा 'dvipdfm' कार्यक्रम तोक्न सकेन । यो कार्यक्रम "
"निर्यात प्रकार्य काम गर्न आवश्यक पर्दछ । यद्यपि तपाईँले KDVI को मुद्रण प्रकार्य "
"प्रयोग गरेर DVI फाइललाई PDF मा रूपान्तरण गर्न सक्नुहुन्छ, तर सामान्यतया यसले "
"मुद्रण ठीक छ भन्ने कागजात उत्पादन गर्दछ तर एक्रोब्यट रिडरमा हेरिएमा नराम्रो "
"देखिन्छ । तपाईँले 'dvipdfm' कार्यक्रम समवेश गर्ने TeX वितरणको हालको संस्करणमा "
"अद्यावधिक गर्नु बुद्धिमता हुन्छ ।\n"
"पूर्व पिक्सेल गरिएको प्रणाली प्रशासकका लागि सङ्केत: कार्यक्रमका लागि हेर्दा "
"KDVI ले शेलको PATH चल प्रयोग गर्दछ ।"

#: dviRenderer_export.cpp:98
msgid "*.pdf|Portable Document Format (*.pdf)"
msgstr "*.pdf|चलायमान कागजात ढाँचा (*.pdf)"

#: dviRenderer_export.cpp:98 dviRenderer_export.cpp:197
msgid "Export File As"
msgstr "यस रूपमा फाइल निर्यात गर्नुहोस्"

#: dviRenderer_export.cpp:103 dviRenderer_export.cpp:202
#: kdvi_multipage.cpp:164
msgid ""
"The file %1\n"
"exists. Do you want to overwrite that file?"
msgstr ""
"%1 फाइल\n"
"अवस्थित छ । तपाईँले सो फाइल माथि अधिलेखन गर्न चाहनुहुन्छ ?"

#: dviRenderer_export.cpp:104 dviRenderer_export.cpp:203
#: kdvi_multipage.cpp:165
msgid "Overwrite File"
msgstr "फाइल अधिलेखन गर्नुहोस्"

#: dviRenderer_export.cpp:104 kdvi_multipage.cpp:165
msgid "Overwrite"
msgstr "अधिलेखन गर्नुहोस्"

#: dviRenderer_export.cpp:111
msgid "Using dvipdfm to export the file to PDF"
msgstr "फाइललाई PDF मा निर्यात गर्न dvipdfm को प्रयोग"

#: dviRenderer_export.cpp:113
msgid ""
"KDVI is currently using the external program 'dvipdfm' to convert your DVI-file "
"to PDF. Sometimes that can take a while because dvipdfm needs to generate its "
"own bitmap fonts Please be patient."
msgstr ""
"KDVI ले अहिले तपाईँको DVI फाइललाई PDF मा रूपान्तरण गर्न बाह्य कार्यक्रम "
"'dvipdfm' प्रयोग गर्दैछ । dvipdfm लाई यसको बिटम्याप फन्ट उत्पन्न गर्न समय "
"लाग्ने हुनाले केही बेर प्रतिक्षा गर्नुहोस् ।"

#: dviRenderer_export.cpp:117
msgid "Waiting for dvipdfm to finish..."
msgstr "dvipdfm ले समाप्त गर्ने बेला प्रतिक्षा गर्दैछ..."

#: dviRenderer_export.cpp:118
