#: kfaximage.cpp:189
msgid "Unable to open file for reading."
msgstr "पढ्नका लागि फाइल खोल्न अक्षम ।"

#: kfaximage.cpp:194
msgid "Unable to read file header (file too short)."
msgstr "फाइल हेडर पढ्न अक्षम (फाइल अति छोटो छ) ।"

#: kfaximage.cpp:203
msgid "This is not a TIFF FAX file."
msgstr "यो TIFF FAX फाइल होइन ।"

#: kfaximage.cpp:228
msgid "Invalid or incomplete TIFF file."
msgstr "अवैध वा अपूर्ण TIFF टिफ फाइल ।"

#: kfaximage.cpp:329
msgid ""
"In file %1\n"
"StripsPerImage tag 273=%2,tag279=%3\n"
msgstr ""
"फाइल %1\n"
"मा स्ट्रिप प्रति छवि ट्याग २७३=%2,ट्याग२७९=%3\n"

#: kfaximage.cpp:372
msgid ""
"Due to patent reasons LZW (Lempel-Ziv & Welch) compressed Fax files cannot "
"be loaded yet.\n"
msgstr "विशिष्ट अधिकारका कारणले LZW (lempel-Ziv  Welch) संकुचन गरिएका फ्याक्स फाइल अहिले सम्म लोड गर्न सकिदैन ।\n"

#: kfaximage.cpp:377
msgid "This version can only handle Fax files\n"
msgstr "यो संस्करणले फ्याक्स फाइल मात्र ह्यान्डल गर्न सक्छ\n"

#: kfaximage.cpp:406
msgid "%1: Bad Fax File"
msgstr "%1: खराब फ्याक्स फाइल"

#: kfaximage.cpp:472
msgid "Trying to expand too many strips."
msgstr "धेरै स्ट्रिपहरू विस्तार गर्ने प्रयास ।"

#: kfaximage.cpp:498
msgid "Only the first page of the PC Research multipage file will be shown."
msgstr "पीसी अनुसन्धान बहुपृष्ठ फाइलको पहिलो पृष्ठ मात्र देखिनेछ ।"

#: kfaximage.cpp:511
msgid "No fax found in file."
msgstr "फाइलमा कुनै फ्याक्स फेला परेन ।"

#: kfaximage.cpp:631
msgid "Fax G3 format not yet supported."
msgstr "फ्याक्स G3 ढाँचा अहिले सम्म समर्थन गरेको छैन ।"

