#, no-c-format
msgid " sec"
msgstr " सेकेन्ड"

#. i18n: file ksnapshotwidget.ui line 62
#: rc.cpp:13
#, no-c-format
msgid "No delay"
msgstr "कुनै विलम्ब छैन"

#. i18n: file ksnapshotwidget.ui line 65
