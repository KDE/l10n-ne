#: kviewconfmodules.cpp:40
msgid "Resizing"
msgstr "रिसाइज"

#: kviewconfmodules.cpp:45
msgid "Only resize window"
msgstr "रिसाइज सञ्झ्याल मात्र"

#: kviewconfmodules.cpp:46
msgid "Resize image to fit window"
msgstr "सञ्झ्यालमा मिलाउन छवि रिसाइज गर्नुहोस्"

#: kviewconfmodules.cpp:47
msgid "Don't resize anything"
msgstr "केहि पनि रिसाइज नगर्नुहोस्"

#: kviewconfmodules.cpp:48
msgid "Best fit"
msgstr "ठीक मिलेको"

#: kviewconfmodules.cpp:49
msgid ""
"<p>KView will resize the window to fit the image. The image will never be "
"scaled up but if it is too large for the screen the image will be scaled "
"down.</p>"
msgstr ""
"<p>केडीई दृश्यले छवि मिलाउन सञ्झ्याल रिसाइज गर्दछ । छविलाई कहिल्यै पनि ठूलो "
"मापन गरिदैन तर पर्दाका लागि छवि ठूलो भएमा सानो मापन गरिन्छ ।</p>"
