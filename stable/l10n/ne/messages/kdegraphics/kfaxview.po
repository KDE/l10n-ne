#: faxrenderer.cpp:139
msgid ""
"<qt><strong>File error.</strong> The specified file '%1' does not exist.</qt>"
msgstr ""
"<qt><strong>फाइल त्रुटि ।</strong> निर्दिष्ट फाइल '%1' अवस्थित छैन ।</qt>"

