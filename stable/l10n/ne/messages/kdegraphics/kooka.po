msgstr "रेखाचित्र छवि (श्यामश्वेत, १ बिट गहिराइ)"

#: img_saver.cpp:497
msgid "high (or true-) color image, not palleted"
msgstr "उच्च (वा सही) रङ छवि, रङदानीमा राखिएको छैन"

