#: img_saver.cpp:63
msgid "Kooka Save Assistant"
msgstr "कोका बचत सहयोगि"

#: img_saver.cpp:81
msgid ""
"<B>Save Assistant</B><P>Select an image format to save the scanned image."
msgstr ""
"<B>सहायक बचत गर्नुहोस्</B><P>स्क्यान गरिएको छवि बचत गर्न एउटा छवि ढाँचा चयन "
"गर्नुहोस् ।"

#: img_saver.cpp:99
msgid "Available image formats:"
msgstr "उपलब्ध छवि ढाँचा:"

#: img_saver.cpp:118
msgid "-No format selected-"
msgstr "कुनै ढाँचा चयन गरिएको छैन"

#: img_saver.cpp:125
msgid "Select the image sub-format"
msgstr "छवि उप-ढाँचा चयन गर्नुहोस्"

#: img_saver.cpp:130
msgid "Don't ask again for the save format if it is defined."
msgstr "ढाँचा परिभाषित भएमा बचतका लागि फेरि नसोध्नुहोस् ।"

#: img_saver.cpp:164
msgid "-no hint available-"
msgstr "कुनै सङ्केत उपलब्ध छैन"

#: img_saver.cpp:278
msgid ""
"The folder\n"
"%1\n"
" does not exist and could not be created;\n"
"please check the permissions."
msgstr ""
"फोल्डर\n"
"%1\n"
" अवस्थित छैन र सिर्जना गर्न सकेने छैन;\n"
"कृपया अनुमति जाँच गर्नुहोस् ।"

#: img_saver.cpp:285
msgid ""
"The directory\n"
"%1\n"
" is not writeable;\n"
"please check the permissions."
msgstr ""
"डाइरेक्टरी\n"
"%1\n"
"लेखनयोग्य छैन;\n"
"कृपया अनुमति जाँच गर्नुहोस् ।"

#: img_saver.cpp:344
msgid "Filename"
msgstr "फाइलनाम"

#: img_saver.cpp:344
