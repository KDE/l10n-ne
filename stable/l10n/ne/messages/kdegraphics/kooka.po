msgid "Unknown image type"
msgstr "अज्ञात छवि प्रकार"

#: img_saver.cpp:711
msgid " image save OK      "
msgstr " छवि बचत ठीक छ      "

#: img_saver.cpp:712
msgid " permission error   "
msgstr " अनुमति त्रुटि   "

#: img_saver.cpp:713
msgid " bad filename       "
msgstr " गलत फाइलनाम       "

#: img_saver.cpp:714
msgid " no space on device "
msgstr " यन्त्रमा खालीस्थान छैन "

#: img_saver.cpp:715
