msgstr " अज्ञात त्रुटि      "

#: img_saver.cpp:719
msgid " parameter wrong    "
msgstr " परिमिति गल्ति    "

#: img_saver.cpp:768 img_saver.cpp:865
msgid ""
"The filename you supplied has no file extension.\n"
"Should the correct one be added automatically? "
msgstr ""
"तपाईँले पूर्ति गर्नु भएको फाइलनामसँग फाइल विस्तार छैन ।\n"
"सही एउटा स्वचालित रूपमा थप्न सकिन्छ ? "

#: img_saver.cpp:769 img_saver.cpp:866
#, c-format
msgid "That would result in the new filename: %1"
msgstr "त्यसले नयाँ फाइलनाममा असर गर्नेछ: %1"

#: img_saver.cpp:771 img_saver.cpp:868
msgid "Extension Missing"
msgstr "विस्तार हराइरहेको छ"

#: img_saver.cpp:772 img_saver.cpp:869
msgid "Add Extension"
msgstr "विस्तार थप्नुहोस्"

#: img_saver.cpp:772 img_saver.cpp:869
msgid "Do Not Add"
msgstr "नथप्नुहोस्"

#: img_saver.cpp:789 img_saver.cpp:883
msgid "Format changes of images are currently not supported."
msgstr "छविको ढाँचा परिवर्तनहरू हालै समर्थन गरिएका छैनन् ।"

#: img_saver.cpp:790 img_saver.cpp:884
msgid "Wrong Extension Found"
msgstr "गलत विस्तार फेला पर्यो"

#: imgprintdialog.cpp:55
msgid "Image Printing"
msgstr "छवि मुद्रण"

#: imgprintdialog.cpp:60 imgprintdialog.cpp:113
msgid "Image Print Size"
msgstr "छवि मुद्रण साइज"

#: imgprintdialog.cpp:64
msgid "Scale to same size as on screen"
msgstr "पर्दामा जस्तै एउटै साइजमा मापन गर्नुहोस्"

#: imgprintdialog.cpp:66
msgid "Screen scaling. That prints according to the screen resolution."
msgstr "पर्दा मापन । त्यसले पर्दा रिजोल्युसनको आधारमा मुद्रण गर्दछ ।"

#: imgprintdialog.cpp:70
msgid "Original size (calculate from scan resolution)"
msgstr "मौलिक साइज (स्क्यान रिजोल्युसनबाट गणना गर्नुहोस्)"

#: imgprintdialog.cpp:73
msgid ""
"Calculates the print size from the scan resolution. Enter the scan resolution "
"in the dialog field below."
msgstr ""
"स्क्यान रिजोल्युसनबाट मुद्रण साइज गणना गर्दछ । तलको संवाद फिल्डमा स्क्यान "
"रिजोल्युसन प्रविष्ट गर्नुहोस् ।"

#: imgprintdialog.cpp:77
msgid "Scale image to custom dimension"
msgstr "आयाम अनुकूलन गर्न छवि मापन गर्नुहोस्"

#: imgprintdialog.cpp:79
msgid ""
"Set the print size yourself in the dialog below. The image is centered on the "
"paper."
msgstr ""
"तलको संवादमा आफैले मुद्रण साइज सेट गर्नुहोस् । छवि कागजमा केन्द्रिकृत गरिएको छ "
"।"

#: imgprintdialog.cpp:83
msgid "Scale image to fit to page"
msgstr "पृष्ठमा मिलाउन छवि मापन गर्नुहोस्"

#: imgprintdialog.cpp:84
msgid ""
"Printout uses maximum space on the selected pager. Aspect ratio is maintained."
msgstr ""
"चयन गरिएको पेजरमा मुद्रणले अधिकतम खाली स्थान प्रयोग गर्छ । आकृति अनुपात राखिएको "
"छ ।"

#: imgprintdialog.cpp:94
msgid "Resolutions"
msgstr "रिजोल्युसन"

#: imgprintdialog.cpp:98
msgid "Generate low resolution PostScript (fast draft print)"
msgstr ""
"न्युन रिजोल्युसन पोस्टस्क्रिप्ट सिर्जना गर्नुहोस् (द्रुत ड्राफ्ट मुद्रण)"

#: imgprintdialog.cpp:105
msgid "Scan resolution (dpi) "
msgstr "(डीपीआई) रिजोल्युसन स्क्यान गर्नुहोस् "

#: imgprintdialog.cpp:107
msgid " dpi"
msgstr " डीपीआई"

#: imgprintdialog.cpp:117
msgid "Image width:"
msgstr "छवि चौडाइ:"

#: imgprintdialog.cpp:118 imgprintdialog.cpp:122
msgid " mm"
msgstr " मिलिमिटर"

#: imgprintdialog.cpp:121
msgid "Image height:"
msgstr "छवि उचाइ:"

#: imgprintdialog.cpp:125
msgid "Maintain aspect ratio"
msgstr "आकृति अनुपात राख्नुहोस्"

#: imgprintdialog.cpp:170
msgid "Screen resolution: %1 dpi"
msgstr "पर्दा रिजोल्युसन: %1 डीपीआई"

#: imgprintdialog.cpp:214
msgid "Please specify a scan resolution larger than 0"
msgstr "कृपया ० भन्दा ठूलो स्क्यान रिजोल्युसन निर्दिष्ट गर्नुहोस्"

#: imgprintdialog.cpp:219
msgid ""
"For custom printing, a valid size should be specified.\n"
"At least one dimension is zero."
msgstr ""
"अनुकूल मुद्रणका लागि, एउटा वैध साइज निर्दिष्ट गर्नुपर्नेछ ।\n"
"कम्तिमा एउटा आयाम शून्य हुन्छ ।"

