#: rc.cpp:18
#, no-c-format
msgid "&Add..."
msgstr "थप्नुहोस्..."

#. i18n: file ./src/part/dialog.ui line 202
#: rc.cpp:21
#, no-c-format
msgid "Exclude remote files&ystems"
msgstr "टाढाको फाइल प्रणालीहरू हटाउनुहोस्"

#. i18n: file ./src/part/dialog.ui line 208
#: rc.cpp:24
#, no-c-format
msgid ""
"Prevents scanning of filesystems that are not on this computer, e.g. NFS or "
"Samba mounts."
msgstr ""
"यो कम्प्युटरमा नभएको फाइलप्रनालीहरूको स्क्यानिङ रोक्दछ, जस्तै एनएफएस वा साम्बा "
"माउन्ट ।"

#. i18n: file ./src/part/dialog.ui line 216
#: rc.cpp:27
#, no-c-format
msgid "Scan across filesystem &boundaries"
msgstr "फाइलप्रणाली सीमा वारपार स्क्यान गर्नुहोस्"

#. i18n: file ./src/part/dialog.ui line 219
#: rc.cpp:30
#, no-c-format
msgid ""
"Allows scans to enter directories that are part of other filesystems. For "
"example, when unchecked, this will usually prevent the contents of <b>/mnt</b> "
"from being scanned if you scan <b>/</b>."
msgstr ""
"डाइरेक्टरीहरू प्रविष्ट गर्न स्क्यान अनुमति दिन्छ जुन अन्य फाइलप्रणालीका भाग "
"हुन् । उदाहरणका लागि, जाँचबाट हटाउँदा, तिनीहरूले प्रायजसो तपाईँले स्क्यान गर्दा "
"स्क्यान हुनुबाट <b>/mnt</b> को सामग्रीलाई रोक्नेछ <b>/</b> ।"

#. i18n: file ./src/part/dialog.ui line 230
#: rc.cpp:33
#, no-c-format
msgid "E&xclude removable media"
msgstr "हटाउन मिल्ने मिडिया हटाउनुहोस्"

#. i18n: file ./src/part/dialog.ui line 236
#: rc.cpp:36
#, no-c-format
