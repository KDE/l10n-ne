msgid "CVS Remove"
msgstr "CVS Remove"

#: addremovedlg.cpp:46
msgid "Add the following files to the repository:"
msgstr "भण्डारमा निम्न फाइल थप्नुहोस्:"

#: addremovedlg.cpp:47
msgid "Add the following binary files to the repository:"
msgstr "भण्डारमा निम्न बाइनरी फाइल थप्नुहोस्:"

#: addremovedlg.cpp:48
msgid "Remove the following files from the repository:"
msgstr "भण्डारबाट निम्न फाइल हटाउनुहोस्:"

#: addremovedlg.cpp:68
msgid "This will also remove the files from your local working copy."
msgstr "तपाईँको कार्य प्रतिबाट पनि यसले फाइल हटाउनेछ ।"

#: addrepositorydlg.cpp:37
msgid "Add Repository"
msgstr "भण्डार थप्नुहोस्"

#: addrepositorydlg.cpp:45 checkoutdlg.cpp:72
msgid "&Repository:"
msgstr "भण्डार:"

#: addrepositorydlg.cpp:58
msgid "Use remote &shell (only for :ext: repositories):"
msgstr "टाढाको शेल प्रयोग गर्नुहोस् (ext: भण्डार: का लागि मात्र):"

#: addrepositorydlg.cpp:65
msgid "Invoke this program on the server side:"
msgstr "सर्भर साइडमा यो कार्यक्रम आमन्त्रण गर्नुहोस्:"

#: addrepositorydlg.cpp:74
msgid "Use different &compression level:"
msgstr "भिन्न सङ्कुचन स्तर प्रयोग गर्नुहोस्:"

#: addrepositorydlg.cpp:80
msgid "Download cvsignore file from server"
msgstr "सर्भरबाट cvsignore फाइल डाउनलोड गर्नुहोस्"

#: addrepositorydlg.cpp:172
msgid "Repository Settings"
msgstr "भण्डार सेटिङ"

#: annotatectl.cpp:82
#, c-format
msgid "CVS Annotate: %1"
msgstr "CVS Annotate: %1"

#: annotatectl.cpp:93
msgid "CVS Annotate"
msgstr "CVS Annotate"

#: cervisiapart.cpp:116
msgid "Starting cvsservice failed with message: "
msgstr "सन्देशसँगको cvsservice सुरुआत गर्न असफल: "

#: cervisiapart.cpp:152
msgid ""
"This KPart is non-functional, because the cvs DCOP service could not be "
"started."
msgstr "यो केडीई भाग अप्रकार्यात्मक हो, किनभने cvs DCOP कार्य सुरुआत गर्न सकिने छैन ।"

#: cervisiapart.cpp:193
msgid "Remote CVS working folders are not supported."
msgstr "टाढाको CVS कार्य फोल्डर समर्थन गरिदैनन् ।"

#: cervisiapart.cpp:202
msgid "You cannot change to a different folder while there is a running cvs job."
msgstr "cvs कार्य चलिराखेको समयमा तपाईँले भिन्न फोल्डरमा परिवर्तन गर्न सक्नुहुदैन ।"

#: cervisiapart.cpp:219
msgid ""
"F - All files are hidden, the tree shows only folders\n"
"N - All up-to-date files are hidden\n"
"R - All removed files are hidden"
msgstr ""
"F - सबै फाइल लुकेका छन्, ट्रीले फोल्डरहरू मात्र देखाउछ\n"
"N - अद्यावधिक सबै फाइल लुकेका छन्\n"
"R - हटाइएका सबै फाइल लुकेका छन्"

#: cervisiapart.cpp:235
msgid "O&pen Sandbox..."
msgstr "स्यान्डबाकस खोल्नुहोस्..."

#: cervisiapart.cpp:238
msgid "Opens a CVS working folder in the main window"
msgstr "मूख्य सञ्झ्यालमा CVS कार्य फोल्डर खोल्दछ"

#: cervisiapart.cpp:242
msgid "Recent Sandboxes"
msgstr "हालैका स्यान्डबाकसहरू"

#: cervisiapart.cpp:246
msgid "&Insert ChangeLog Entry..."
msgstr "ChangeLog प्रविष्टि घुसाउनुहोस्..."

#: cervisiapart.cpp:249
msgid "Inserts a new intro into the file ChangeLog in the toplevel folder"
msgstr "माथिल्लो स्तरको फोल्डरको फाइल ChangeLog मा एउटा नयाँ intro घुसाउदछ"

#: cervisiapart.cpp:256
msgid "Updates (cvs update) the selected files and folders"
msgstr "चयन गरिएका फाइल र फोल्डर अद्यावधिक गर्छ (cvs update)"

#: cervisiapart.cpp:260
msgid "&Status"
msgstr "वस्तुस्थिति"

#: cervisiapart.cpp:263
msgid "Updates the status (cvs -n update) of the selected files and folders"
msgstr "चयन गरिएका फाइल र फोल्डरको वस्तुस्थिति अद्यावधिक गर्छ (cvs -n update)"

#: cervisiapart.cpp:270
msgid "Opens the marked file for editing"
msgstr "सम्पादनका लागि चिनो लगाइएका फाइल खोल्दछ"

#: cervisiapart.cpp:274
msgid "Reso&lve..."
msgstr "समाधान गर्नुहोस्..."

#: cervisiapart.cpp:277
msgid "Opens the resolve dialog with the selected file"
msgstr "चयन गरिएका फाइलसँग समाधान संवाद खोल्दछ"

#: cervisiapart.cpp:281
msgid "&Commit..."
msgstr "commit गर्नुहोस्..."

#: cervisiapart.cpp:284
msgid "Commits the selected files"
msgstr "चयन गरिएका फाइल कमिट गर्छ"

#: cervisiapart.cpp:288
msgid "&Add to Repository..."
msgstr "भण्डारमा थप्नुहोस्..."

#: cervisiapart.cpp:291
msgid "Adds (cvs add) the selected files to the repository"
msgstr "चयन गरिएका फाइललाई भण्डारमा (cvs add) थप्दछ"

#: cervisiapart.cpp:295
msgid "Add &Binary..."
msgstr "बाइनरी थप्नुहोस्..."

#: cervisiapart.cpp:298
msgid "Adds (cvs -kb add) the selected files as binaries to the repository"
msgstr "चयन गरिएका फाइललाई बाइनरी फाइलका रुपमा भण्डारमा (cvs -kb add) थप्दछ"

#: cervisiapart.cpp:302
msgid "&Remove From Repository..."
msgstr "भण्डारबाट हटाउनुहोस्..."

#: cervisiapart.cpp:305
msgid "Removes (cvs remove) the selected files from the repository"
msgstr "चयन गरिएका फाइललाई भण्डारबाट (cvs remove) हटाउदछ"

#: cervisiapart.cpp:309
msgid "Rever&t"
msgstr "पछाडि फर्कनुहोस्"

#: cervisiapart.cpp:312
msgid "Reverts (cvs update -C) the selected files (only cvs 1.11)"
msgstr "चयन गरिएका फाइलहरू (only cvs 1.11) लाई फर्काउछ (cvs update -C)"

#: cervisiapart.cpp:317
msgid "&Properties"
msgstr "विशेषताहरू"

#: cervisiapart.cpp:328
msgid "Stops any running sub-processes"
msgstr "चलिराखेका कुनै पनि उप- प्रक्रियालाई रोक्दछ"

#: cervisiapart.cpp:333
msgid "Browse &Log..."
msgstr "लग ब्राउज गर्नुहोस्..."

#: cervisiapart.cpp:336
msgid "Shows the revision tree of the selected file"
msgstr "चयन गरिएका फाइलको पुनरावृत्ती ट्री देखाउछ"

#: cervisiapart.cpp:341
msgid "Browse Multi-File Log..."
msgstr "बहु- फाइल लग ब्राउज गर्नुहोस्..."

#: cervisiapart.cpp:345
msgid "&Annotate..."
msgstr "ब्याख्या गर्नुहोस्..."

#: cervisiapart.cpp:348
msgid "Shows a blame-annotated view of the selected file"
msgstr "चयन गरिएका फाइलको दोष- ब्याख्या गर्ने दृश्य देखाउछ"

#: cervisiapart.cpp:352
msgid "&Difference to Repository (BASE)..."
msgstr "भण्डारमा भिन्नता (BASE)..."

#: cervisiapart.cpp:355
msgid ""
"Shows the differences of the selected file to the checked out version (tag "
"BASE)"
msgstr ""
"चेक आउट संस्करणमा चयन गरिएका फाइलको भिन्नता देखाउछ (tag "
"BASE)"

#: cervisiapart.cpp:359
msgid "Difference to Repository (HEAD)..."
msgstr "भण्डारमा भिन्नता (HEAD)..."

#: cervisiapart.cpp:362
msgid ""
"Shows the differences of the selected file to the newest version in the "
"repository (tag HEAD)"
msgstr "भण्डारको नयाँ संस्करणमा चयन गरिएका फाइलको भिन्नता देखाउछ (tag HEAD)"

#: cervisiapart.cpp:366
msgid "Last &Change..."
msgstr "अन्तिम परिवर्तन..."

#: cervisiapart.cpp:369
msgid "Shows the differences between the last two revisions of the selected file"
msgstr "चयन गरिएका फाइलको अन्तिम दुई पुनरावृत्ती बीचमा भिन्नता देखाउछ"

#: cervisiapart.cpp:373
msgid "&History..."
msgstr "इतिहास..."

#: cervisiapart.cpp:376
msgid "Shows the CVS history as reported by the server"
msgstr "सर्भरद्वारा प्रतिवेदन गरिए अनुरुपका CVS इतिहास देखाउछ"

#: cervisiapart.cpp:380
msgid "&Unfold File Tree"
msgstr "अनफोल्ड फाइल ट्री"

#: cervisiapart.cpp:384
msgid "Opens all branches of the file tree"
msgstr "फाइल ट्रीका सबै शाखा खोल्दछ"

#: cervisiapart.cpp:388
msgid "&Fold File Tree"
msgstr "फोल्ड फाइल ट्री"

#: cervisiapart.cpp:391
msgid "Closes all branches of the file tree"
msgstr "फाइल ट्रीका सबै शाखा बन्द गर्छ"

#: cervisiapart.cpp:398
msgid "&Tag/Branch..."
msgstr "ट्याग/शाखा..."

#: cervisiapart.cpp:401
msgid "Creates a tag or branch for the selected files"
msgstr "चयन गरिएका फाइलका लागि ट्याग वा शाखा सिर्जना गर्छ"

#: cervisiapart.cpp:405
msgid "&Delete Tag..."
msgstr "ट्याग मेट्नुहोस्..."

#: cervisiapart.cpp:408
msgid "Deletes a tag from the selected files"
msgstr "चयन गरिएका फाइलबाट ट्याग मेट्दछ"

#: cervisiapart.cpp:412
msgid "&Update to Tag/Date..."
msgstr "ट्याग/मितिलाई अद्यावधिक गर्नुहोस्..."

#: cervisiapart.cpp:415
msgid "Updates the selected files to a given tag, branch or date"
msgstr "चयन गरिएको फाइललाई दिएको ट्याग, शाखा वा मितिमा अद्यावधिक गर्छ"

#: cervisiapart.cpp:419
msgid "Update to &HEAD"
msgstr "HEAD मा अद्यावधिक गर्छ"

#: cervisiapart.cpp:422
msgid "Updates the selected files to the HEAD revision"
msgstr "HEAD पुनरावृत्तीमा चयन गरिएका फाइल अद्यावधिक गर्छ"

#: cervisiapart.cpp:426
msgid "&Merge..."
msgstr "गाभ्नुहोस्..."

#: cervisiapart.cpp:429
msgid "Merges a branch or a set of modifications into the selected files"
msgstr "चयन गरिएका फाइलमा परिमार्जनहरूको शाखा वा सेट गाभ्दछ"

#: cervisiapart.cpp:433
msgid "&Add Watch..."
msgstr "घडी थप्नुहोस्..."

#: cervisiapart.cpp:436
msgid "Adds a watch for the selected files"
msgstr "चयन गरिएका फाइलका लागि घडी थप्दछ"

#: cervisiapart.cpp:440
msgid "&Remove Watch..."
msgstr "घडी हटाउनुहोस्..."

#: cervisiapart.cpp:443
msgid "Removes a watch from the selected files"
msgstr "चयन गरिएका फाइलबाट घडी हटाउदछ"

#: cervisiapart.cpp:447
msgid "Show &Watchers"
msgstr "दर्शक देखाउनुहोस्"

#: cervisiapart.cpp:450
msgid "Shows the watchers of the selected files"
msgstr "चयन गरिएका फाइलका दर्शक देखाउछ"

#: cervisiapart.cpp:454
msgid "Ed&it Files"
msgstr "फाइल सम्पादन गर्नुहोस्"

#: cervisiapart.cpp:457
msgid "Edits (cvs edit) the selected files"
msgstr "चयन गरिएका फाइलहरू (cvs edit) सम्पादन गर्छ"

#: cervisiapart.cpp:461
msgid "U&nedit Files"
msgstr "फाइल सम्पादन नगर्नुहोस्"

#: cervisiapart.cpp:464
msgid "Unedits (cvs unedit) the selected files"
msgstr "चयन गरिएका फाइलहरू (cvs unedit) सम्पादन गर्दैन"

#: cervisiapart.cpp:468
msgid "Show &Editors"
msgstr "सम्पादक देखाउनुहोस्"

#: cervisiapart.cpp:471
msgid "Shows the editors of the selected files"
msgstr "चयन गरिएका फाइलका सम्पादक देखाउछ"

#: cervisiapart.cpp:475
msgid "&Lock Files"
msgstr "फाइलहरूमा ताल्चा लगाउनुहोस्"

#: cervisiapart.cpp:478
msgid "Locks the selected files, so that others cannot modify them"
msgstr "चयन गरिएका फाइलहरूमा ताल्चा लगाउछ, त्यसले गर्दा अन्यले तिनीहरूलाई परिमार्जन गर्न सक्दैनन्"

#: cervisiapart.cpp:482
msgid "Unl&ock Files"
msgstr "ताल्चा खोल्नुहोस्"

#: cervisiapart.cpp:485
msgid "Unlocks the selected files"
msgstr "चयन गरिएका फाइलको ताल्चा खोल्दछ"

#: cervisiapart.cpp:489
msgid "Create &Patch Against Repository..."
msgstr "भण्डारका बिरुद्धमा प्याच सिर्जना गर्नुहोस्..."

#: cervisiapart.cpp:492
msgid "Creates a patch from the modifications in your sandbox"
msgstr "परिमार्जन गरेर तपाईँको स्यान्डबाकसमा प्याच सिर्जना गर्दछ"

#: cervisiapart.cpp:499
msgid "&Create..."
msgstr "सिर्जना गर्नुहोस्..."

#: cervisiapart.cpp:503
msgid "&Checkout..."
msgstr "जाँच गर्नुहोस्..."

#: cervisiapart.cpp:506
msgid "Allows you to checkout a module from a repository"
msgstr "तपाईँलाई भण्डारबाट मोड्युल जाँच गर्न अनुमति दिन्छ"

#: cervisiapart.cpp:510
msgid "&Import..."
msgstr "आयात गर्नुहोस्..."

#: cervisiapart.cpp:513
msgid "Allows you to import a module into a repository"
msgstr "तपाईँलाई भण्डारमा मोड्युल आयात गर्न अनुमति दिन्छ"

#: cervisiapart.cpp:517
msgid "&Repositories..."
msgstr "भण्डारहरू..."

#: cervisiapart.cpp:520
msgid "Configures a list of repositories you regularly use"
msgstr "तपाईँले नियमित प्रयोग गरेका भण्डारको सूची कन्फिगर गर्छ"

#: cervisiapart.cpp:527
msgid "Hide All &Files"
msgstr "सबै फाइल लुकाउनुहोस्"

#: cervisiapart.cpp:530
msgid "Show All &Files"
msgstr "सबै फाइल देखाउनुहोस्"

#: cervisiapart.cpp:531
msgid "Determines whether only folders are shown"
msgstr "फोल्डर मात्र देखिएका छन् वा छैनन् निर्धारण गर्दछ"

#: cervisiapart.cpp:535
msgid "Hide Unmodified Files"
msgstr "अपरिमार्जित फाइल लुकाउनुहोस्"

#: cervisiapart.cpp:538
msgid "Show Unmodified Files"
msgstr "अपरिमार्जित फाइल देखाउनुहोस्"

#: cervisiapart.cpp:539
msgid "Determines whether files with status up-to-date or unknown are hidden"
msgstr "वस्तुस्थितिसँग फाइललाई अद्यावधिक गर्ने वा अज्ञात फाइललाई लुकाउने निर्धारण गर्छ"

#: cervisiapart.cpp:544
msgid "Hide Removed Files"
msgstr "हटाइएका फाइल लुकाउनुहोस्"

#: cervisiapart.cpp:547
msgid "Show Removed Files"
msgstr "हटाइएका फाइल देखाउनुहोस्"

#: cervisiapart.cpp:548
msgid "Determines whether removed files are hidden"
msgstr "हटाइएका फाइल लुकेका छन् वा छैनन् निर्धारण गर्छ"

#: cervisiapart.cpp:552
msgid "Hide Non-CVS Files"
msgstr "CVS बिहीन फाइल लुकाउनुहोस्"

#: cervisiapart.cpp:555
msgid "Show Non-CVS Files"
msgstr "CVS बिहीन फाइल देखाउनुहोस्"

#: cervisiapart.cpp:556
msgid "Determines whether files not in CVS are hidden"
msgstr "CVS मा नभएका फाइल लुकेका छन् या छैनन् निर्धारण गर्छ"

#: cervisiapart.cpp:560
msgid "Hide Empty Folders"
msgstr "खाली फोल्डर लुकाउनुहोस्"

#: cervisiapart.cpp:563
msgid "Show Empty Folders"
msgstr "खाली फोल्डर देखाउनुहोस्"

#: cervisiapart.cpp:564
msgid "Determines whether folders without visible entries are hidden"
msgstr "दृश्यात्मक प्रविष्टि नभएका फोल्डरहरू लुकेका छन् या छैनन् निर्धारण गर्छ"

#: cervisiapart.cpp:568
msgid "Create &Folders on Update"
msgstr "अद्यावधिक गर्दा फोल्डर सिर्जना गर्दछ"

#: cervisiapart.cpp:571
msgid "Determines whether updates create folders"
msgstr "अद्यावधिक गर्दा फोल्डर सिर्जना हुन्छ या हुदैन निर्धारण गर्छ"

#: cervisiapart.cpp:575
msgid "&Prune Empty Folders on Update"
msgstr "अद्यावधिक गर्दा खाली फोल्डर काँटछाँट गर्दछ"

#: cervisiapart.cpp:578
msgid "Determines whether updates remove empty folders"
msgstr "अद्यावधिक गर्दा खाली फोल्डर हटाउछ वा हटाउदैन निर्धारण गर्दछ"

#: cervisiapart.cpp:582
msgid "&Update Recursively"
msgstr "दोहोर्याएर अद्यावधिक गर्नुहोस्"

#: cervisiapart.cpp:585
msgid "Determines whether updates are recursive"
msgstr "अद्यावधिक दोहोरिएका छन् या छैनन् निर्धारण गर्दछ"

#: cervisiapart.cpp:589
msgid "C&ommit && Remove Recursively"
msgstr "दोहोर्याएर कमिट गर्नुहोस् र हटाउनुहोस्"

