#: commonui/projectprefwidgets.cpp:266
msgid ""
"<qt>"
"<p><b>Update Header</b></p>\n"
"<p>Check this button to update the header information of the file every time it "
"is saved.</p>\n"
"<p>The header normally keeps information about the date and time the file was "
"last\n"
"updated, the last translator etc.</p>\n"
"<p>You can choose which information you want to update from the checkboxes "
"below.\n"
"Fields that do not exist are added to the header.\n"
"If you want to add additional fields to the header, you can edit the header "
"manually by choosing\n"
"<b>Edit->Edit Header</b> in the editor window.</p></qt>"
msgstr ""
"<qt>"
"<p><b>हेडर अद्यावधिक गर्नुहोस्</b></p>\n"
"<p>फाइललाई प्रत्येक पटक बचत गर्दा हेडरको सूचना अद्यावधिक गर्न यो बटन चेक "
"गर्नुहोस् ।</p>\n"
"<p>हेडरले सामान्यतया फाइलको अद्यावधिक\n"
"अन्तिम अनुवादक इत्यादि कार्यको मिति र समय जस्ता सूचना कायम गर्दछ ।</p>\n"
"<p>तपाईँले तलको चेकबाकसबाट अद्यावधिक गर्न चाहनुभएको सूचना छनोट गर्न सक्नुहुन्छ "
"।\n"
"अवस्थित नभएको फिल्डहरू हेडरमा थपिन्छ ।\n"
"तपाईँले हेडरमा अतिरिक्त फिल्ड थप्न चाहनुहुन्छ भने, तपाईँले सम्पादक सञ्झ्यालमा\n"
"<b>सम्पादन->हेडर सम्पादन गर्नुहोस्</b> छनोट गरेर म्यानुअलि सम्पादन गर्न "
"सक्नुहुन्छ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:278
msgid ""
"<qt>"
"<p><b>Fields to update</b></p>\n"
"<p>Choose which fields in the header you want to have updated when saving.\n"
"If a field does not exist, it is appended to the header.</p>\n"
"<p>If you want to add other information to the header, you have to edit the "
"header manually\n"
"by choosing <b>Edit->Edit Header</b> in the editor window.</p>\n"
"<p>Deactivate <b>Update Header</b> above if you do not want to have the header\n"
"updated when saving.</p></qt>"
msgstr ""
"<qt>"
"<p><b>अद्यावधिक गर्ने फिल्ड</b></p>\n"
"<p>तपाईँले बचत गर्दा अद्यावधिक गर्न चाहनुभएको फिल्ड हेडरमा छनोट गर्नुहोस् ।\n"
"फिल्ड अवस्थित छैन भने, यसलाई हेडरमा थपिन्छ ।</p>\n"
"<p>यदि तपाईँले हेडरमा अन्य सूचना थप्न चाहनुहुन्छ भने, तपाईँले सम्पादक "
"सञ्झ्यालमा\n"
" <b>सम्पादन->हेडर सम्पादन गर्नुहोस्</b> छनोट गरेर म्यानुअली सम्पादन गर्नुपर्दछ "
"।</p>\n"
"<p>बचत गर्दा हेडर अद्यावधिक गर्न चाहनुहुन्न भने <b>हेडर अद्यावधिक गर्नुहोस्</b>"
"\n"
" निस्क्रिय पार्नुहोस् ।</p></qt>"

#: commonui/projectprefwidgets.cpp:286
msgid ""
"<qt>"
"<p><b>Encoding</b></p>"
"<p>Choose how to encode characters when saving to a file. If you are unsure "
"what encoding to use, please ask your translation coordinator.</p>"
"<ul>"
"<li><b>%1</b>: this is the encoding that fits the character set of your system "
"language.</li>"
"<li><b>%2</b>: uses Unicode (UTF-8) encoding.</li></ul></qt>"
msgstr ""
"<qt>"
"<p><b>सङ्केतन</b></p>"
"<p>फाइल बचत गर्दा क्यारेक्टर सङ्केतन गर्ने तरिका छनोट गर्नुहोस् । कुन सङ्केतन "
"प्रयोग गर्ने भनेर यकिन हुनहुन्न भने, कृपया तपाईँको अनुवादक टोली नेतालाई "
"सोध्नुहोस् ।</p>"
"<ul>"
"<li><b>%1</b>: यो तपाईँको प्रणाली भाषाको क्यारेक्टर सेटसँग मिल्ने सङ्केतन हो "
"।</li>"
"<li><b>%2</b>: (UTF-8) सङ्केतन प्रयोग गर्दछ ।</li></ul></qt>"

#: commonui/projectprefwidgets.cpp:296
msgid ""
"<qt>"
"<p><b>Keep the encoding of the file</b></p>"
"<p>If this option is activated, files are always saved in the same encoding as "
"they were read in. Files without charset information in the header (e.g. POT "
"files) are saved in the encoding set above.</p></qt>"
msgstr ""
"<qt>"
"<p><b>फाइलको सङ्केतन कायम राख्नुहोस्</b></p>"
"<p>यो विकल्प सक्षम पारिएमा, फाइलहरू पढिएको सङ्केतनमा नै सधै बचत गरिन्छ । हेडरमा "
"चारसेट सूचना बिनाको फाइल (उदाहरणका लागि POT फाइल) माथि सेट गरेको सङ्केतनमा बचत "
"गरिन्छ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:302
msgid ""
"<qt>"
"<p><b>Check syntax of file when saving</b></p>\n"
"<p>Check this to automatically check syntax of file with \"msgfmt "
"--statistics\"\n"
"when saving a file. You will only get a message, if an error occurred.</p></qt>"
msgstr ""
"<qt>"
"<p><b>बचत गर्दा फाइलको वाक्यसंरचना चेक गर्नुहोस्</b></p>\n"
"<p>फाइल बचत गर्दा \"msgfmt --statistics\" सँग फाइलको वाक्यसंरचना स्वचालित "
"रुपमा\n"
"चेक गर्नुपरेमा यसलाई चेक गर्नुहोस् । त्रुटि देखापरेमा, तपाईँले केबल सन्देश "
"प्राप्त गर्नुहुनेछ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:306
msgid ""
"<qt>"
"<p><b>Save obsolete entries</b></p>\n"
"<p>If this option is activated, obsolete entries found when the file was open\n"
"will be saved back to the file. Obsolete entries are marked by #~ and are\n"
"created when the msgmerge does not need the translation anymore.\n"
"If the text will appear again, the obsolete entries will be activated again.\n"
"The main drawback is the size of the saved file.</p></qt>"
msgstr ""
"<qt>"
"<p><b>अप्रचलित प्रविष्टि बचत गर्नुहोस्</b></p>\n"
"<p>यो विकल्प सक्षम पारिएमा, फाइल खुला हुँदा फेला परेको अप्रचलित प्रविष्टिहरू\n"
"फेरि फाइलमा बचत गरिन्छ । अप्रचलित प्रविष्टिहरू #~ द्वारा चिनो लगाइन्छ र\n"
"msgmerge लाई फेरि अनुवाद गर्नुनपरेमा यसलाई सिर्जना गरिन्छ ।\n"
"पाठ फेरि देखापरेमा, अप्रचलित प्रविष्टिहरू पुन: सक्रिय पारिन्छ ।\n"
"मुख्य बेफाइदा नै बचत गरिएको फाइलको साइज हो ।</p></qt>"

#: commonui/projectprefwidgets.cpp:314
msgid ""
"<qt>"
"<p><b>Format of Revision-Date</b></p>"
"<p>Choose in which format the date and time of the header field\n"
"<i>PO-Revision-Date</i> is saved: "
"<ul>\n"
"<li><b>Default</b> is the format normally used in PO files.</li>\n"
"<li><b>Local</b> is the format specific to your country.\n"
"It can be configured in KDE's Control Center.</li>\n"
"<li><b>Custom</b> lets you define your own format.</li></ul></p> "
"<p>It is recommended that you use the default format to avoid creating "
"non-standard PO files.</p>"
"<p>For more information, see section <b>The Preferences Dialog</b> "
"in the online help.</p></qt>"
msgstr ""
"<qt>"
"<p><b>पुनरावलोकन-मितिको ढाँचा</b></p>"
"<p>हेडर फिल्डको मिति र समयको ढाँचामा छनोट गर्नुहोस्\n"
"<i>PO-पुरावलोकन-मिति</i> बचत छ: "
"<ul>\n"
"<li><b>पूर्वनिर्धारित</b> सामान्यतया PO फाइलमा प्रयोग गरिने ढाँचा हो ।</li>\n"
"<li><b>स्थानीय</b> तपाईँको देशमा निर्दिष्ट ढाँचा हो ।\n"
"यसलाई केडीईको नियन्त्रण केन्द्रमा कन्फिगर गर्न सकिन्छ ।</li>\n"
"<li><b>अनुकूल</b> तपाईँको आफ्नै ढाँचा परिभाषित गर्न दिन्छ ।</li></ul></p> "
"<p>मानक विहिन PO फाइल सिर्जना उपेक्षा गर्न तपाईँलाई पूर्वनिर्धारित ढाँचा प्रयोग "
"गर्न सिफारिश गरिन्छ ।</p>"
"<p>बढि जानकारिका लागि, अनलाइन मद्दतका लागि <b>प्राथमिकता संवाद</b> "
"खण्ड हेर्नुहोस् ।</p></qt>"

#: commonui/projectprefwidgets.cpp:412
msgid "<font size=\"+1\">Project: %1</font>"
msgstr "<font size=\"+1\">परियोजना: %1</font>"

#: commonui/projectprefwidgets.cpp:419
msgid "&Name:"
msgstr "नाम:"

#: commonui/projectprefwidgets.cpp:423
msgid "Localized na&me:"
msgstr "स्थानीकृत नाम:"

#: commonui/projectprefwidgets.cpp:427
msgid "E&mail:"
msgstr "इमेल:"

#: commonui/projectprefwidgets.cpp:432
msgid "&Full language name:"
msgstr "पूरा भाषा नाम:"

#: commonui/projectprefwidgets.cpp:438
msgid "Lan&guage code:"
msgstr "भाषा सङ्केत:"

#: commonui/projectprefwidgets.cpp:444
msgid "&Language mailing list:"
msgstr "भाषा पत्राचार सूची:"

#: commonui/projectprefwidgets.cpp:449
msgid "&Timezone:"
msgstr "टाइमजोन:"

#: commonui/projectprefwidgets.cpp:455
msgid ""
"<qt>"
"<p><b>Identity</b></p>\n"
"<p>Fill in information about you and your translation team.\n"
"This information is used when updating the header of a file.</p>\n"
"<p>You can find the options if and what fields in the header should be updated\n"
"on page <b>Save</b> in this dialog.</p></qt>"
msgstr ""
"<qt>"
"<p><b>परिचय</b></p>\n"
"<p>तपाईँको अनुवाद टोली र तपाईँको बारेमा सूचना भर्नुहोस्\n"
"फाइलको हेडर अद्यावधिक गर्दा यो सूचना प्रयोग गरिन्छ ।</p>\n"
"<p>तपाईँले यो संवादको \n"
"<b>बचत</b> पृष्ठमा कुन कुन फिल्डहरू हेडरमा अद्यावधिक गर्ने वा नगर्ने भन्ने "
"विकल्प फेला पार्न सक्नुहुन्छ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:471
msgid "&Number of singular/plural forms:"
msgstr "एकवचन/बहुवचन स्वरूपको सङ्ख्या:"

#: commonui/projectprefwidgets.cpp:474
msgid ""
"_: automatic choose number of plural forms\n"
"Automatic"
msgstr "स्वचालित"

#: commonui/projectprefwidgets.cpp:481
msgid "Te&st"
msgstr "परिक्षण"

#: commonui/projectprefwidgets.cpp:486
msgid ""
"<qt>"
"<p><b>Number of singular/plural forms</b></p>"
"<p><b>Note</b>: This option is KDE specific. If you are not translating a KDE "
"application, you can safely ignore this option.</p>"
"<p>Choose here how many singular and plural forms are used in your language. "
"This number must correspond to the settings of your language team.</p>"
"<p>Alternatively, you can set this option to <i>Automatic</i> "
"and KBabel will try to get this information automatically from KDE. Use the <i>"
"Test</i> button to test if it can find it out.</p></qt>"
msgstr ""
"<qt>"
"<p><b>एकवचन/बहुवचन स्वरूपको सङ्ख्या</b></p>"
"<p><b>द्रष्टव्य</b>: यो विकल्प केडीई निर्दिष्ट हो । तपाईँले केडीई अनुप्रयोग "
"अनुवाद गरिरहनु भएको छैन भने, तपाईँले सुरक्षित रुपमा यसलाई उपेक्षा गर्न "
"सक्नुहुन्छ ।</p>"
"<p>तपाईँको भाषामा प्रयोग गरिने एकवचन र बहुवचन स्वरूप कति छन् यहाँ छनोट "
"गर्नुहोस् । यो सङ्ख्या तपाईँको अनुवाद टोलीको सेटिङसँग संगत हुनुपर्दछ ।</p>"
"<p>वैकल्पिक रुपमा, तपाईँले यो विकल्पलाई <i>स्वचालित</i> "
"मा सेट गर्न सक्नुहुन्छ र केब्याबलले यो सूचना केडीईबाट स्वचालित रुपमा प्राप्त "
"गर्न प्रयास गर्दछ । यसलाई फेला पार्न सकेमा परिक्षण गर्नका लागि <i>परिक्षण</i> "
"बटन प्रयोग गर्नुहोस् ।</p></qt>"

#: commonui/projectprefwidgets.cpp:504
msgid "&GNU plural form header:"
msgstr "जीएनयू बहुवचन स्वरूप हेडर:"

#: commonui/projectprefwidgets.cpp:514
msgid "&Lookup"
msgstr "खोजी गर्नुहोस्"

#: commonui/projectprefwidgets.cpp:518
msgid "Re&quire plural form arguments in translation"
msgstr "अनुवादमा आवश्यक बहुवचन स्वरूप तर्क"

#: commonui/projectprefwidgets.cpp:521
#, c-format
msgid ""
"<qt>"
"<p><b>Require plural form arguments in translation</b></p>\n"
"<p><b>Note</b>: This option is KDE specific at the moment. If you are not "
"translating a KDE application, you can safely ignore this option.</p>\n"
"<p>If is this option enabled, the validation check will require the %n argument "
"to be present in the message.</p></qt>"
msgstr ""
"<qt>"
"<p><b>अनुवादमा बहुवचन स्वरूप तर्क आवश्यक</b></p>\n"
"<p><b>द्रष्टव्य</b>: यो विकल्प अहिले केडीई निर्दिष्ट छ । तपाईँले केडीई "
"अनुप्रयोग अनुवाद गर्दै हुनुहुन्न भने, तपाईँले सुरक्षित रुपमा यसलाई उपेक्षा गर्न "
"सक्नुहुन्छ ।</p>\n"
"<p>यो विकल्प सक्षम पारिएमा, सन्देशमा देखाउनका लागि वैधता जाँचलाई %n आवश्यक "
"पर्दछ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:529
msgid ""
"<qt>"
"<p><b>GNU plural form header</b></p>\n"
"<p>Here you can fill a header entry for GNU plural form handling; if you leave "
"the entry empty, the entry in the PO file will not be changed or added.</p>\n"
"<p>KBabel can automatically try to determine value suggested by the GNU gettext "
"tools for currently set language; just press the <b>Lookup</b> button.</p></qt>"
msgstr ""
"<qt>"
"<p><b>जीएनयू बहुवचन स्वरूप हेडर</b></p>\n"
"<p>यहाँ तपाईँले जीएनयू बहुवचन स्वरूप ह्यान्डलिङका लागि हेडर प्रविष्टि भर्न "
"सक्नुहुन्छ । तपाईँले यसलाई खाली छोड्नुभयो भने, PO फाइलमा प्रविष्टिहरू थपिदैन वा "
"परिवर्तन हुँदैन ।</p>\n"
"<p>केब्याबलले हालै सेट गरेको भाषाका लागि जीएनयू गेटटेक्स उपकरणद्वारा सुझाव "
"गरेको मान स्वचालित रुपमा निर्धारण गर्न प्रयास गर्न सक्दछ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:608 commonui/projectprefwidgets.cpp:642
msgid "Please insert a language code first."
msgstr "कृपया पहिला भाषा सङ्केत घुसाउनुहोस्"

#: commonui/projectprefwidgets.cpp:618
msgid ""
"It is not possible to find out the number of singular/plural forms "
"automatically for the language code \"%1\".\n"
"Do you have kdelibs.po installed for this language?\n"
"Please set the correct number manually."
msgstr ""
"\"%1\" भाषा सङ्केतका लागि एकवचन/बहुवचन स्वरूप स्वचालित रुपमा पत्ता लगाउन सम्भव "
"हुँदैन ।\n"
"यो भाषाका लागि तपाईँले kdelibs.po स्थापना गर्नुभएको छ ?\n"
"कृपया सही सङ्ख्या म्यानुअली सेट गर्नुहोस् ।"

#: commonui/projectprefwidgets.cpp:626
msgid ""
"The number of singular/plural forms found for the language code \"%1\" is %2."
msgstr ""
" \"%1\" भाषा सङ्केतका लागि फेला परेको एकवचन/बहुवचन स्वरूपको सङ्ख्या %2 हो ।"

#: commonui/projectprefwidgets.cpp:650
msgid ""
"It was not possible to determine GNU header for plural forms. Maybe your GNU "
"gettext tools are too old or they do not contain a suggested value for your "
"language."
msgstr ""
"बहुवचन स्वरूपका लागि जीएनयू हेडर निर्धारण गर्न सम्भव हुँदैन । बहुवचन स्वरूपका "
"लागि जीएनयू हेडर धेरै पुरानो वा तपाईँको भाषाका लागि तिनीहरूले सुझाव गरेको मानमा "
"समाविष्ट नगरेको हुनसक्दछ ।"

#: commonui/projectprefwidgets.cpp:677
msgid "&Marker for keyboard accelerator:"
msgstr "कुञ्जीपाटी गतिवर्धकका लागि मार्कर:"

#: commonui/projectprefwidgets.cpp:682
msgid ""
"<qt>"
"<p><b>Marker for keyboard accelerator</b></p>"
"<p>Define here, what character marks the following character as keyboard "
"accelerator. For example in Qt it is '&amp;' and in Gtk it is '_'.</p></qt>"
msgstr ""
"<qt>"
"<p><b>कुञ्जीपाटी गतिवर्धकका लागि मार्कर</b></p>"
"<p>कुञ्जीपाटी गतिवर्धकको रुपमा निम्न क्यारेक्टरमा चिनो लगाउने क्यारेक्टर यहाँ "
"परिभाषित गर्नुहोस् । उदाहरणका लागिQt मा '&amp;' र Gtk मा '_' हुन्छ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:693
msgid "&Regular expression for context information:"
msgstr "प्रसङ्ग सूचनाका लागि नियमित अभिव्यक्ति:"

#: commonui/projectprefwidgets.cpp:699
msgid ""
"<qt>"
"<p><b>Regular expression for context information</b></p>"
"<p>Enter a regular expression here which defines what is context information in "
"the message and must not get translated.</p></qt>"
msgstr ""
"<qt>"
"<p><b>प्रसङ्ग सूचनाका लागि नियमित अभिव्यक्ति</b></p>"
"<p>सन्देशमा प्रसङ्ग सूचना के हो भनेर परिभाषित गर्ने र अनुवाद गर्न नपर्ने नियमित "
"अभिव्यक्ति यहाँ प्रविष्ट गर्नुहोस् ।</p></qt>"

#: commonui/projectprefwidgets.cpp:715
msgid "Compression Method for Mail Attachments"
msgstr "मेल संलग्रका लागि सङ्कुचन विधि"

#: commonui/projectprefwidgets.cpp:720
msgid "tar/&bzip2"
msgstr "tar/bzip2"

#: commonui/projectprefwidgets.cpp:721
msgid "tar/&gzip"
msgstr "tar/gzip"

#: commonui/projectprefwidgets.cpp:723
msgid "&Use compression when sending a single file"
msgstr "एकल फाइल पठाउदा सङ्कुचन प्रयोग गर्नुहोस्"

#: commonui/projectprefwidgets.cpp:802
msgid "On the &fly spellchecking"
msgstr "फ्लाइ हिज्जेपरिक्षणमा"

#: commonui/projectprefwidgets.cpp:805
msgid ""
"<qt>"
"<p><b>On the fly spellchecking</b></p>"
"<p>Activate this to let KBabel spell check the text as you type. Mispelled "
"words will be colored by the error color.</p></qt>"
msgstr ""
"<qt>"
"<p><b>फ्लाइ हिज्जेपरिक्षणमा</b></p>"
"<p>तपाईँले टाइप गरेको पाठको केब्याबलले हिज्जे परिक्षण गर्न दिन यसलाई सक्रिय "
"पार्नुहोस् । गलत हिज्जे भएको शब्द छुट्टै रङमा आउछ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:811
msgid "&Remember ignored words"
msgstr "उपेक्षा गरेको शब्द सम्झनुहोस्"

#: commonui/projectprefwidgets.cpp:817
msgid "F&ile to store ignored words:"
msgstr "उपेक्षा गरेको शब्द भण्डारण गर्ने फाइल:"

#: commonui/projectprefwidgets.cpp:827
msgid ""
"<qt>"
"<p><b>Remember ignored words</b></p>"
"<p>Activate this, to let KBabel ignore the words, where you have chosen <i>"
"Ignore All</i> in the spell check dialog, in every spell check.</p></qt>"
msgstr ""
"<qt>"
"<p><b>उपेक्षा गरेको शब्द सम्झनुहोस्</b></p>"
"<p>प्रत्येक पटक हिज्जेपरिक्षण गर्दा तपाईँले हिज्जे परिक्षण संवादमा <i>"
"सबै उपेक्षा गर्नुहोस्</i> छनोट गर्नुभएको स्थान, केब्याबलले शब्दहरू उपेक्षा गर्न "
"दिन यसलाई सक्रिय पार्नुहोस् ।</p></qt>"

#. i18n: file ./commonui/projectwizardwidget2.ui line 68
#: commonui/projectprefwidgets.cpp:890 rc.cpp:316
#, no-c-format
msgid "&Base folder of PO files:"
msgstr "PO फाइलको आधार फोल्डर:"

#. i18n: file ./commonui/projectwizardwidget2.ui line 110
#: commonui/projectprefwidgets.cpp:903 rc.cpp:319
#, no-c-format
msgid "Ba&se folder of POT files:"
msgstr "POT फाइलको आधार फोल्डर:"

#: commonui/projectprefwidgets.cpp:914
msgid ""
"<qt>"
"<p><b>Base folders</b></p>\n"
"<p>Type in the folders which contain all your PO and POT files.\n"
"The files and the folders in these folders will then be merged into one\n"
"tree.</p></qt>"
msgstr ""
"<qt>"
"<p><b>आधार फोल्डर</b></p>\n"
"<p>तपाईँको सबै PO र POT फाइल समाविष्ट गर्ने फोल्डरमा टाइप गर्नुहोस् ।\n"
"ती फोल्डरमा रहेका फाइल र फोल्डरहरू एउटा ट्रीमा\n"
"गाभिन्छ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:924
msgid "O&pen files in new window"
msgstr "नयाँ सञ्झ्यालमा फाइल खोल्नुहोस्"

#: commonui/projectprefwidgets.cpp:927
msgid ""
"<qt>"
"<p><b>Open files in new window</b></p>\n"
"<p>If this is activated all files that are opened from the Catalog Manager are "
"opened\n"
"in a new window.</p></qt>"
msgstr ""
"<qt>"
"<p><b>नयाँ सञ्झ्यालमा फाइल खोल्नुहोस्</b></p>\n"
"<p>यसलाई सक्रिय पारेमा विवरणिका प्रबन्धकबाट खोलिएका सबै फाइलहरू\n"
"नयाँ सञ्झ्यालमा खोलिन्छ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:931
msgid "&Kill processes on exit"
msgstr "अन्त्य गर्दा प्रक्रियाहरू नष्ट गर्नुहोस्"

#: commonui/projectprefwidgets.cpp:933
msgid ""
"<qt>"
"<p><b>Kill processes on exit</b></p>\n"
"<p>If you check this, KBabel tries to kill the processes, that have not exited "
"already when KBabel exits,\n"
"by sending a kill signal to them.</p>\n"
"<p>NOTE: It is not guaranteed that the processes will be killed.</p></qt>"
msgstr ""
"<qt>"
"<p><b>अन्त्य गर्दा प्रक्रिया नष्ट गर्नुहोस्</b></p>\n"
"<p>तपाईँले यसलाई चेक गर्दा, केब्याबल अन्त्य हुनुपूर्व अन्त्य नभएका प्रक्रियाहरू "
"नष्ट गर्न केब्याबलले\n"
"तिनीहरूमा नष्ट गर्ने सङ्केत पठाएर प्रयास गर्दछ ।</p>\n"
"<p>द्रष्टव्य: प्रक्रियाहरू नष्ट हुन्छ नै भन्ने विश्वास गर्न सकिदैन ।</p></qt>"

#: commonui/projectprefwidgets.cpp:939
msgid "Create inde&x for file contents"
msgstr "फाइल सामग्रीका लागि अनुक्रमणिका सिर्जना गर्नुहोस्"

#: commonui/projectprefwidgets.cpp:941
msgid ""
"<qt>"
"<p><b>Create index for file contents</b></p>\n"
"<p>If you check this, KBabel will create an index for each PO file to speed up "
"the find/replace functions.</p>\n"
"<p>NOTE: This will slow down updating the file information considerably.</p>"
"</qt>"
msgstr ""
"<qt>"
"<p><b>फाइल सामग्रीका लागि अनुक्रमणिका सिर्जना गर्नुहोस्</b></p>\n"
"<p>तपाईँले यसमा चेक गर्दा, केब्याबलले फेला पार्ने/प्रतिस्थापन गर्ने प्रकार्यको "
"गति बढाउन प्रत्येक PO फाइलका लागि अनुक्रमणिका सिर्जना गर्दछ ।</p>\n"
"<p>द्रष्टव्य: यसले फाइल सूचना अद्यावधिकलाई धेरै ढिलो बनाउछ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:945
msgid "Run &msgfmt before processing a file"
msgstr "फाइल प्रक्रिया गर्नुपूर्व msgfmt चलाउनुहोस्"

#: commonui/projectprefwidgets.cpp:947
msgid ""
"<qt>"
"<p><b>Run msgfmt before processing a file</b></p>"
"<p>If you enable this, KBabel will run Gettext's msgfmt tool before processing "
"a file.</p>"
"<p>Enabling this setting is recommended, even if it causes processing to be "
"slower. This setting is enabled by default.</p>"
"<p>Disabling is useful for slow computers and when you want to translate PO "
"files that are not supported by the current version of the Gettext tools that "
"are on your system. The drawback of disabling is that hardly any syntax "
"checking is done by the processing code, so invalid PO files could be shown as "
"good ones, even if Gettext tools would reject such files.</p></qt>"
msgstr ""
"<qt>"
"<p><b>फाइल प्रक्रिया गर्नुपूर्व msgfmt चलाउनुहोस्</b></p>"
"<p>तपाईँले यसलाई सक्षम पार्दा, केब्याबलले फाइल प्रक्रिया गर्नुपूर्व गेटटेक्सको "
"msgfmt उपकरण चलाउछ ।</p>"
"<p>प्रकियालाई केहि ढिला बनाए पनि यो सेटिङ सक्षम पार्न सिफारिश गरिन्छ । यो सेटिङ "
"पूर्वनिर्धारित रुपमा सक्षम हुन्छ ।</p>"
"<p>तपाईँको कम्प्युटर ढिलो हुँदा र तपाईँको प्रणालीको गेटटेक्स उपकरणलाई हालको "
"संस्करणद्वारा समर्थन नहुँने PO फाइल तपाईँले अनुवाद गर्न चाहनुभएमा अक्षम पार्नु "
"नै उपयोगी हुन्छ । अक्षम पार्दा हुने कमजोरी भनेको प्रक्रिया सङ्केतद्वारा "
"वाक्यससंरचना जाँच नगर्ने सम्भावना धेरै हुन्छ, जसले गर्दा गेटटेक्स उपकरणले "
"अस्वीकार गर्न सक्ने अवैध PO फाइलहरू पनि वैध देखिन्छ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:988
msgid "Commands for Folders"
msgstr "फोल्डरका लागि आदेश"

#: commonui/projectprefwidgets.cpp:993
msgid ""
"Replaceables:\n"
"@PACKAGE@, @PODIR@, @POTDIR@\n"
"@POFILES@, @MARKEDPOFILES@"
msgstr ""
"प्रतिस्थापन योग्य:\n"
"@PACKAGE@, @PODIR@, @POTDIR@\n"
"@POFILES@, @MARKEDPOFILES@"

#: commonui/projectprefwidgets.cpp:998
msgid ""
"<qt>"
"<p><b>Commands for folders</b></p>"
"<p>Insert here the commands you want to execute in folders from the Catalog "
"Manager. The commands are then shown in the submenu <b>Commands</b> "
"in the Catalog Manager's context menu.</p>"
"<p>The following strings will be replaced in a command:"
"<ul>"
"<li>@PACKAGE@: The name of the folder without path</li>"
"<li>@PODIR@: The name of the PO-folder with path</li>"
"<li>@POTDIR@: The name of the template folder with path</li>"
"<li>@POFILES@: The names of the PO files with path</li>"
"<li>@MARKEDPOFILES@: The names of the marked PO files with path</li></ul></p>"
"</qt>"
msgstr ""
"<qt>"
"<p><b>फोल्डरका लागि आदेश</b></p>"
"<p>विवरणिका प्रबन्धकबाट फोल्डरमा कार्यान्वयन गर्न चाहनुभएको आदेश यहाँ "
"घुसाउनुहोस् । ती आदेशहरू त्यसपछि विवरणिका प्रबन्ध प्रसङ्ग मेनुको सहायक मेनु <b>"
"आदेश</b> मा देखिन्छन् ।</p>"
"<p>निम्न स्ट्रिङहरू आदेशमा प्रतिमस्थापन गरिन्छ:"
"<ul>"
"<li>@PACKAGE@: मार्ग बिनाको फोल्डरको नाम</li>"
"<li>@PODIR@: मार्ग सहितको PO-फोल्डरको नाम</li>"
"<li>@POTDIR@: मार्ग सहित टेम्प्लेट फोल्डरको नाम </li>"
"<li>@POFILES@: मार्ग सहित PO फाइलको नाम</li>"
"<li>@MARKEDPOFILES@: मार्ग सहित चिनो लगाइएको PO फाइलको नाम</li></ul></p></qt>"

#: commonui/projectprefwidgets.cpp:1051
msgid "Commands for Files"
msgstr "फाइलका लागि आदेश"

#: commonui/projectprefwidgets.cpp:1056
msgid ""
"Replaceables:\n"
"@PACKAGE@, @POFILE@,@POTFILE@,\n"
"@PODIR@, @POTDIR@"
msgstr ""
"प्रतिस्थापन योग्य:\n"
"@PACKAGE@, @POFILE@,@POTFILE@,\n"
"@PODIR@, @POTDIR@"

#: commonui/projectprefwidgets.cpp:1061
msgid ""
"<qt>"
"<p><b>Commands for files</b></p>"
"<p>Insert here the commands you want to execute on files from the Catalog "
"Manager. The commands are then shown in the submenu <b>Commands</b> "
"in the Catalog Manager's context menu.</p>"
"<p>The following strings will be replaced in a command:"
"<ul>"
"<li>@PACKAGE@: The name of the file without path and extension</li>"
"<li>@POFILE@: The name of the PO-file with path and extension</li>"
"<li>@POTFILE@: The name of the corresponding template file with path and "
"extension</li>"
"<li>@POEMAIL@: The name and email address of the last translator</li>"
"<li>@PODIR@: The name of the folder the PO-file is in, with path</li>"
"<li>@POTDIR@: The name of the folder the template file is in, with path</li>"
"</ul></p></qt>"
msgstr ""
"<qt>"
"<p><b>फाइलका लागि आदेश</b></p>"
"<p>विवरणिका प्रबन्धकबाट फाइलमा कार्यान्वयन गर्न चाहनुभएको आदेश यहाँ घुसाउनुहोस् "
"। आदेशहरू त्यसपछि विवरणिका प्रबन्धक मेनुको सहायक मेनु <b>आदेश</b> "
"मा देखिन्छ ।</p>"
"<p>निम्न स्ट्रिङहरू आदेशमा प्रतिस्थापन गरिन्छ:"
"<ul>"
"<li>@PACKAGE@: मार्ग र विस्तार बिनाको फाइलको नाम</li>"
"<li>@POFILE@: मार्ग र विस्तार सहित PO-फाइलको नाम</li>"
"<li>@POTFILE@: मार्ग र विस्तार सहित संगत टेम्प्लेट फाइलको नाम</li>"
"<li>@POEMAIL@: अन्तिम अनुवादकको नाम र इमेल ठेगाना</li>"
"<li>@PODIR@: मार्ग सहित PO-फाइल रहेको फोल्डरको नाम</li>"
"<li>@POTDIR@: मार्ग सहित टेम्प्लेट फाइल रहेको फोल्डरको नाम</li></ul></p></qt>"

