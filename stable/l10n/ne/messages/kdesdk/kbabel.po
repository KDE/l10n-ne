#. i18n: file ./kbabel/editorpreferences.ui line 60
#: rc.cpp:436
#, no-c-format
msgid ""
"<qt>"
"<p><b>Automatically unset fuzzy status</b></p>\n"
"<p>If this is activated and you are editing a fuzzy entry, the fuzzy status is "
"automatically\n"
"unset (this means the string <i>, fuzzy</i>\n"
"is removed from the entry's comment).</p></qt>"
msgstr ""
"<qt>"
"<p><b>फज्जी वस्तुस्थिति स्वचालित रुपमा अनसेट गर्नुहोस्</b></p>\n"
"<p>फज्जी प्रविष्टि सम्पादन गर्दा यसलाई सक्रिय पारिएमा,फज्जी वस्तुस्थिति "
"स्वचालित रुपमा \n"
"अनसेट हुन्छ (यसको अर्थ <i>, फज्जी</i>\n"
"स्ट्रिङ प्रविष्टिको टिप्पणीबाट हटाइन्छ) ।</p></qt>"

#. i18n: file ./kbabel/editorpreferences.ui line 68
#: rc.cpp:442
#, no-c-format
msgid "Use cle&ver editing"
msgstr "चलाख सम्पादन प्रयोग गर्नुहोस्"

#. i18n: file ./kbabel/editorpreferences.ui line 79
#: rc.cpp:445
#, no-c-format
msgid ""
"<qt>"
"<p><b>Use clever editing</b></p>\n"
"<p>Check this to make typing text more comfortable and let \n"
"KBabel take care of some special characters that have to \n"
"be quoted. For example typing '\\\"' will result in \n"
"'\\\\\\\"', pressing Return will automatically add whitespace \n"
"at the end of the line, pressing Shift+Return will add \n"
"'\\\\n' at the end of the line.</p>\n"
"<p>Note that this is just a hint: it is still possible to \n"
"generate syntactically incorrect text.</p></qt>"
msgstr ""
"<qt>"
"<p><b>चलाख सम्पादन प्रयोग गर्नुहोस्</b></p>\n"
"<p>टाइप गरेको पाठ बढि सजिलो बनाउन र केब्याबललाई उद्धरण गरेको \n"
"केहि विशेष क्यारेक्टरहरूको बारेमा ध्यान दिने बनाउन यसलाई चेक गर्नुहोस् \n"
"उदाहरणका लागि, '\\\"' टाइप गर्दा \n"
"'\\\\\\\"' हुन्छ, 'Return' थिच्दा रेखाको अन्त्यमा सेतो खाली स्थान स्वचालित "
"रुपमा \n"
"थप्दछ, Shift+Return थिच्दा रेखाको अन्त्यमा \n"
"'\\\\n' थप्दछ ।</p>\n"
"<p>याद राख्नुहोस् की यो त केबल हिन्ट मात्र हो: वाक्य संरचनागत रुपमा गलत शब्द "
"पनि \n"
"उत्पन्न गर्न सम्भव हुन्छ ।</p></qt>"

