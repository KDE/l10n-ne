#: catalogmanager/catalogmanager.cpp:558
msgid ""
"<qt>"
"<p><b>Statusbar</b></p>\n"
"<p>The statusbar displays information about progress of the current find or "
"replace operation. The first number in <b>Found:</b> "
"displays the number of files with an occurrence of the searched text not yet "
"shown in the KBabel window. The second shows the total number of files "
"containing the searched text found so far.</p></qt>"
msgstr ""
"<qt>"
"<p><b>स्थितिपट्टी</b></p>\n"
"<p>हालको फेला पार्ने वा प्रतिस्थापन गर्ने सञ्चालनका बारेमा वस्तुस्थितिपट्टीले "
"सूचना प्रर्दशन गर्दछ । <b>फेला पर्यो:</b> पहिलो नम्बरले केब्याबल सञ्झ्यालमा अझै "
"नदेखिएको खोजी पाठको घटनासँग फाइलको नम्बर प्रर्दशन गर्दछ । दोस्रोले फेला परेको "
"खोजी पाठ समाविष्ट फाइलको कूल नम्बर देखाउछ ।</p></qt>"

