#: main.cpp:27
msgid "KDE's application finder"
msgstr "KDE अनुप्रयोग प्रापक"

#: main.cpp:30
msgid "Install .desktop files into directory <dir>"
msgstr ".desktop फाइल डाइरेक्टरीमा स्थापना गर्नुहोस् ।<dir>"

#: main.cpp:36 toplevel.cpp:50
msgid "KAppfinder"
msgstr "KAppfinder"

#: toplevel.cpp:53
msgid ""
"The application finder looks for non-KDE applications on your system and adds "
"them to the KDE menu system. Click 'Scan' to begin, select the desired "
"applications and then click 'Apply'."
msgstr ""
"अनुप्रयोग प्रापकले तपाईँको प्रणालीमा KDE बाहेकका अनुप्रयोग खोज्दछ र तीनिहरूलाई "
"KDE मेनु प्रणालीमा थप्दछ । सुरु गर्न 'स्क्यान' क्लिक गर्नुहोस्, "
"अपेक्षितअनुप्रयोगहरू चयन गर्नुहोस् र त्यसपछि 'लागू गर्नुहोस्' क्लिक गर्नुहोस् ।"

#: toplevel.cpp:63
msgid "Application"
msgstr "अनुप्रयोग"

#: toplevel.cpp:64
msgid "Description"
msgstr "वर्णन"

#: toplevel.cpp:65
msgid "Command"
msgstr "आदेश"

#: toplevel.cpp:76
msgid "Summary:"
msgstr "सारांश:"

#: toplevel.cpp:80
msgid "Scan"
msgstr "स्क्यान गर्नुहोस्"

#: toplevel.cpp:85
msgid "Unselect All"
msgstr "सबै चयन हटाउनुहोस्"

#: toplevel.cpp:245
#, c-format
msgid ""
"_n: Summary: found %n application\n"
"Summary: found %n applications"
msgstr ""
"सारांश: %n अनुप्रयोग फेला पारियो\n"
"सारांश: %n अनुप्रयोग फेला पारियो"

#: toplevel.cpp:288
#, c-format
msgid ""
"_n: %n application was added to the KDE menu system.\n"
"%n applications were added to the KDE menu system."
msgstr ""
"%n अनुप्रयोग KDE मेनु प्रणालीमा थपिएको थियो ।\n"
"%n अनुप्रयोगहरू KDE मेनु प्रणालीमा थपिएको थियो ।"

