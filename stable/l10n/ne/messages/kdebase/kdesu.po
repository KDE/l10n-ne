#: kdesu.cpp:56 kdesu.cpp:57
msgid "Specifies the command to run"
msgstr "चलाउन आदेश निर्दिष्ट गर्दछ"

#: kdesu.cpp:58
msgid "Run command under target uid if <file> is not writable"
msgstr "यदि <file> लेखनयोग्य छैन भने यू आई डी लक्ष्य अन्तर्गत आदेश चलाउनुहोस्"

#: kdesu.cpp:59
msgid "Specifies the target uid"
msgstr "लक्ष्य यू आई डी निर्दिष्ट गर्दछ"

#: kdesu.cpp:60
msgid "Do not keep password"
msgstr "पासवर्ड नराख्नुहोस्"

#: kdesu.cpp:61
msgid "Stop the daemon (forgets all passwords)"
msgstr "डेयमन रोक्नुहोस् (सबै पासवर्ड बिर्सनुहोस्)"

#: kdesu.cpp:62
msgid "Enable terminal output (no password keeping)"
msgstr "टर्मिनल निर्गात सक्षम गर्नुहोस् (कुनै पासवर्ड राखिएको छैन)"

#: kdesu.cpp:63
msgid "Set priority value: 0 <= prio <= 100, 0 is lowest"
msgstr "प्राथमिकता मान सेट गर्नुहोस्: 0 <= prio <= 100, 0 कम हो"

#: kdesu.cpp:64
msgid "Use realtime scheduling"
msgstr "वास्तविक समय कार्यतालिका प्रयोग गर्नुहोस्"

#: kdesu.cpp:65
msgid "Let command use existing dcopserver"
msgstr "dcopserver अवस्थित राख्न आदेश प्रयोग गर्न दिनुहोस्"

#: kdesu.cpp:66
msgid "Do not display ignore button"
msgstr ""

#: kdesu.cpp:67
msgid "Specify icon to use in the password dialog"
msgstr "पासवर्ड संवादमा प्रयोग गर्न प्रतिमा निर्दिष्ट गर्नुहोस्"

#: kdesu.cpp:68
msgid "Do not show the command to be run in the dialog"
msgstr "संवादमा सञ्चालन हुनका लागि आदेश नदेखाउनुहोस्"

#: kdesu.cpp:99
msgid "KDE su"
msgstr "KDE su"

#: kdesu.cpp:100
msgid "Runs a program with elevated privileges."
msgstr "उठाइएको विशेषधिकार सहित कार्यक्रम चलाउँदछ"

#: kdesu.cpp:103
msgid "Maintainer"
msgstr "सञ्भारकर्ता"

#: kdesu.cpp:105
msgid "Original author"
msgstr "मौलिक लेखक"

#: kdesu.cpp:128
msgid "Command '%1' not found."
msgstr "आदेश '%1' फेला परेन ।"

#: kdesu.cpp:204
#, c-format
msgid "Illegal priority: %1"
msgstr "गैरकानूनी प्राथमिकता : %1"

#: kdesu.cpp:232
msgid "No command specified."
msgstr "कुनै आदेश निर्दिष्ट गरिएको छैन ।"

#: kdesu.cpp:341
msgid ""
"Su returned with an error.\n"
msgstr ""
"सु एउटा त्रुटि सहित फर्कियो ।\n"

#: kdesu.cpp:362
msgid "Command:"
msgstr "आदेश:"

#: kdesu.cpp:367
msgid "realtime: "
msgstr "वास्तविक समय: "

#: kdesu.cpp:370
msgid "Priority:"
msgstr "प्राथमिकता:"

#: sudlg.cpp:29
#, c-format
msgid "Run as %1"
msgstr "%1 जस्तै चलाउनुहोस्"

#: sudlg.cpp:33
msgid "Please enter your password."
msgstr ""

#: sudlg.cpp:36
msgid ""
"The action you requested needs root privileges. Please enter root's password "
"below or click Ignore to continue with your current privileges."
msgstr ""
"तपाईँले अनुरोध गरिएको कार्यलाई प्रमूल विशेषधिकारको आवश्यक पर्दछ । कृपया तल "
"प्रमूलको पासवर्ड प्रविष्ट गर्नुहोस् वा तपाईँको हालको विशेषधिकार सहित जारी राख्न "
"'उपेक्षा गर्नुहोस्' मा क्लिक गर्नुहोस् ।"

#: sudlg.cpp:40
msgid ""
"The action you requested needs additional privileges. Please enter the password "
"for \"%1\" below or click Ignore to continue with your current privileges."
msgstr ""
"तपाईँले अनुरोध गर्नु भएको कार्यलाई थप विशेषधिकारको आवश्यक पर्दछ । कृपया तल "
"\"%1\" का लागि पासवर्ड प्रविष्ट गर्नुहोस् वा तपाईँको हालको विशेषधिकारहरू सहित "
"जारी राख्न 'उपेक्षा गर्नुहोस्' मा क्लिक गर्नुहोस् ।"

#: sudlg.cpp:48
msgid "&Ignore"
msgstr "उपेक्षा गर्नुहोस्"

#: sudlg.cpp:64
msgid "Conversation with su failed."
msgstr "सु सँगको वार्तालाप असफल भयो ।"

#: sudlg.cpp:73
msgid ""
"The program 'su' is not found;\n"
"make sure your PATH is set correctly."
msgstr ""
"कार्यक्रम 'सु' फेला परेन ;\n"
"तपाईँको मार्ग सही रूपमा सेट भएको छ भन्ने निश्चित गर्नुहोस् ।"

#: sudlg.cpp:80
msgid ""
"You are not allowed to use 'su';\n"
"on some systems, you need to be in a special group (often: wheel) to use this "
"program."
msgstr ""
"तपाईँलाई 'सु' प्रयोग गर्न अनुमति छैन;\n"
"केही प्रणालीहरूमा, यो कार्यक्रम प्रयोग गर्न विशेष समूह (धेरैजसो: घुम्ने) मा "
"तपाईँ हुन आवश्यक छ ।"

#: sudlg.cpp:87
msgid "Incorrect password; please try again."
msgstr "गलत पासवर्ड; कृपया फेरि प्रयास गर्नुहोस् ।"

#: sudlg.cpp:91
msgid "Internal error: illegal return from SuProcess::checkInstall()"
msgstr "आन्तरीक त्रुटि: SuProcess::checkInstall() बाट गैरकानूनी फर्कियो"

