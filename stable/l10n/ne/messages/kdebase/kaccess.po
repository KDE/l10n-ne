msgstr "अहिले क्याप्स लक कुञ्जी निष्क्रिय छ ।"

#: kaccess.cpp:84
msgid "The Scroll Lock key has been activated."
msgstr "स्क्रोल लक कुञ्जी सक्रिय पारिएको छ ।"

#: kaccess.cpp:86
