#: ktrash.cpp:30
msgid "Empty the contents of the trash"
msgstr "रद्दीटोकरीको सामग्रीहरू खाली गर्नुहोस्"

#: ktrash.cpp:32
msgid "Restore a trashed file to its original location"
msgstr "यसको मौलिक स्थानमा रद्दी गरिएको फाइल पूर्वावस्थामा ल्याउनुहोस्"

#: ktrash.cpp:34
msgid "Ignored"
msgstr "उपेक्षित"

#: ktrash.cpp:42
msgid "ktrash"
msgstr "केट्रयास"

#: ktrash.cpp:43
msgid ""
"Helper program to handle the KDE trash can\n"
"Note: to move files to the trash, do not use ktrash, but \"kfmclient move 'url' "
"trash:/\""
msgstr ""
"KDE ट्रयासले मद्दतकर्ता कार्यक्रम ह्यान्डल गर्न सक्छ\n"
"द्रष्टब्य: ट्रयासमा फाइलहरू सार्न, केट्रयास प्रयोग नगर्नुहोस्, तर \"kfmclient "
"ले 'url' ट्रयास सार्दछ:/\""

#: kio_trash.cpp:46
msgid "Protocol name"
msgstr "प्रोटोकल नाम"

#: kio_trash.cpp:47 kio_trash.cpp:48
msgid "Socket name"
msgstr "सकेट नाम"

#: kio_trash.cpp:97 kio_trash.cpp:160 kio_trash.cpp:317 kio_trash.cpp:349
#: kio_trash.cpp:505 kio_trash.cpp:517
#, c-format
msgid "Malformed URL %1"
msgstr "विकृत यू आर एल %1"

#: kio_trash.cpp:116
msgid ""
"The directory %1 does not exist anymore, so it is not possible to restore this "
"item to its original location. You can either recreate that directory and use "
"the restore operation again, or drag the item anywhere else to restore it."
msgstr ""
"डाइरेक्टरी %1 अरू धेरै बेर अवस्थित रहने छैन, त्यसैले यो वस्तुलाई यसको मौलिक "
"स्थान पूर्वावस्थामा लैजान सम्भव छैन । तपाईँ या त त्यो डाइरेक्टरी पुन: सिर्जना "
"गरेर फेरि पूर्वावस्थामा लगिएको सञ्चालन प्रयोग गर्न सक्नुहुन्छ, वा यसलाई कुनै "
"हालतमा पनि पूर्वावस्थामा लैजान वस्तु तान्न सक्नुहुन्छ ।"

#: kio_trash.cpp:145
msgid "This file is already in the trash bin."
msgstr "यो फाइल पहिल्यै ट्रयास बिनमा छ ।"

#: kfile-plugin/kfile_trash.cpp:52
msgid "General"
msgstr "साधारण"

#: kfile-plugin/kfile_trash.cpp:55
msgid "Original Path"
msgstr "मौलिक बाटो"

