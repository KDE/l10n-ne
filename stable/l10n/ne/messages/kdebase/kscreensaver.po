#: blankscrn.cpp:45
msgid "Setup Blank Screen Saver"
msgstr "खाली स्क्रिन सेभर सेटअप गर्नुहोस्"

#: blankscrn.cpp:53
msgid "Color:"
msgstr "रङ्ग:"

#: random.cpp:41
msgid ""
"Usage: %1 [-setup] [args]\n"
"Starts a random screen saver.\n"
"Any arguments (except -setup) are passed on to the screen saver."
msgstr ""
"प्रयोग: %1 [-सेटअप] [तर्कहरू]\n"
"भिन्नभिन्न स्क्रिन सेभर शुरू गर्नुहोस्.\n"
"कुनै तर्कहरू (सेटअप -बाहेक) स्क्रिन सेभर मार्फत जान्छ।"

#: random.cpp:48
msgid "Start a random KDE screen saver"
msgstr "भिन्नभिन्न KDE स्क्रिन सेभर शुरू गर्नुहोस्"

#: random.cpp:54
msgid "Setup screen saver"
msgstr "स्क्रिन सेभर सेटअप गर्नुहोस्"

#: random.cpp:55
msgid "Run in the specified XWindow"
msgstr "निर्दिष्ट एक्ससञ्झ्यालमा चालु गर्नुहोस्"

#: random.cpp:56
msgid "Run in the root XWindow"
msgstr "रुट एक्ससञ्झ्यालमा चालु गर्नुहोस्"

#: random.cpp:66
