#: kcmcss.cpp:37
msgid ""
"<h1>Konqueror Stylesheets</h1> This module allows you to apply your own color "
"and font settings to Konqueror by using stylesheets (CSS). You can either "
"specify options or apply your own self-written stylesheet by pointing to its "
"location."
"<br> Note that these settings will always have precedence before all other "
"settings made by the site author. This can be useful to visually impaired "
"people or for web pages that are unreadable due to bad design."
msgstr ""
"<h1>कन्क्वेरर शैली पानाहरू</h1> यो मोड्युलले तपाईँलाई शैली पानाहरू (CSS) प्रयोग "
"गरेर कनक्वेररमा तपाईँको आफ्नो रङ र फन्ट सेटिङ लागू गर्न अनुमति दिन्छ । तपाईँले "
"या विकल्पहरू निर्दिष्ट गर्न वा तपाईँले यसका स्थानहरूमा देखाएर आफैँले लेखेका "
"शैलीपानाहरू लागू गर्न सक्नुहुन्छ ।"
"<br> याद गर्नुहोस् यि सेटिङले सधैँ लेखक साइटद्वारा बनाइएका अन्य सबै सेटिङ भन्दा "
"पहिला श्रेष्ठता पाउँनेछन् । यो दृश्य कमजोर भएका मानिस वा खराब डिजाइनका कारण "
"पढ्न नसकिने वेब पृष्ठका लागि उपयोगि हुन सक्छ ।"

#. i18n: file cssconfig.ui line 20
#: rc.cpp:3 rc.cpp:33
#, no-c-format
msgid ""
"<b>Stylesheets</b>"
"<p>See http://www.w3.org/Style/CSS for further information on cascading style "
"sheets.</p>"
msgstr ""
"<b>शैली पानाहरू</b>"
"<p> क्यासकेडिङ शैली पानाहरूमा अघिल्ला सूचनाको लागि http://www.w3.org/Style/CSS "
"हेर्नुहोस् </p>"

#. i18n: file cssconfig.ui line 45
#: rc.cpp:6
#, no-c-format
msgid "Stylesheets"
msgstr "शैली पानाहरू"

#. i18n: file cssconfig.ui line 51
#: rc.cpp:9
#, no-c-format
msgid ""
"<b>Stylesheets</b>"
"<p>Use this groupbox to determine how Konqueror will render style sheets.</p>"
msgstr ""
"<b>शैली पानाहरू</b>"
"<p>कसरि कन्क्वेररले शैली पानाहरू दिनेछ निर्धारण गर्न यो समूह बाकस प्रयोग "
"गर्नुहोस् ।</p>"

#. i18n: file cssconfig.ui line 68
#: rc.cpp:12
#, no-c-format
msgid "Us&e default stylesheet"
msgstr "पूर्वनिर्धारित शैली पानाहरू प्रयोग गर्नहोस्"

#. i18n: file cssconfig.ui line 74
#: rc.cpp:15
#, no-c-format
msgid ""
"<b>Use default stylesheet</b>"
"<p>Select this option to use the default stylesheet.</p>"
msgstr ""
"<b>पूर्वनिर्धारित शैली पानाहरू प्रयोग गर्नहोस्</b>"
"<p>पूर्वनिर्धारित शैली पाना प्रयोग गर्न यो विकल्प चयन गर्नुहोस् ।</p>"

#. i18n: file cssconfig.ui line 82
#: rc.cpp:18
#, no-c-format
msgid "Use &user-defined stylesheet"
msgstr "प्रयोगकर्ता परिभाषित गरिएको शैली पाना प्रयोग गर्नुहोस्"

#. i18n: file cssconfig.ui line 85
#: rc.cpp:21
#, no-c-format
msgid ""
"<b>Use user-defined stylesheet</b>"
"<p>If this box is checked, Konqueror will try to load a user-defined style "
"sheet as specified in the location below. The style sheet allows you to "
"completely override the way web pages are rendered in your browser. The file "
"specified should contain a valid style sheet (see http://www.w3.org/Style/CSS "
"for further information on cascading style sheets).</p>"
msgstr ""
"<b>प्रयोग कर्ता परिभाषीत गरिएको शैली पाना प्रयोग गर्नुहोस्</b>"
"<p>यदि यो विकल्प जाँच गरिएमा, कन्क्वेररले तलको स्थानमा निर्दिष्ट गरिए अनुरुप "
"एउटा प्रयोगकर्ता परिभाषीत गरिएको शैली पाना लोड गर्ने प्रयास गर्नेछ । तपाईँलाई "
"शैली पानाले सम्पुर्ण अधिरोहण गर्न अनुमति दिन्छ, तरिका र वेब पृष्ठहरू तपाईँको "
"ब्राउजरमा दिइएका छन् । निर्दिष्ट गरिएको फाइलमा एउटा बैद्य शैली पाना समाबेश "
"गर्नु पर्छ (बढी सुचनाको लागि क्यासकेडिङ शैली पानाहरूमा "
"http://www.w3.org/Style/CSS हेर्नुहोस्) ।</p>"

#. i18n: file cssconfig.ui line 136
