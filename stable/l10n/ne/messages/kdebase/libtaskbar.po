#. i18n: file taskbar.kcfg line 11
#: rc.cpp:3
#, no-c-format
msgid "Show windows from all desktops"
msgstr "सबै डेस्कटपबाट सञ्झ्यालहरू देखाउनुहोस्"

#. i18n: file taskbar.kcfg line 12
#: rc.cpp:6
#, no-c-format
msgid ""
"Turning this option off will cause the taskbar to display <b>only</b> "
"the windows on the current desktop. \\n\\nBy default, this option is selected "
"and all windows are shown."
msgstr ""
"यो विकल्पलाई बन्द गर्दा कार्यपट्टीले हालको डेस्कटपमा <b>एउटा मात्र</b> "
"सञ्झ्याल प्रर्दशन गर्ने हुन्छ । \\n\\nपूर्वनिर्धारितद्वारा, यो विकल्प चयन "
"गरिन्छ र सबै सञ्झ्याल देखाइन्छ ।"

#. i18n: file taskbar.kcfg line 16
#: rc.cpp:9
#, no-c-format
msgid "Show only minimized windows"
msgstr "न्यून पारिएको सञ्झ्याल मात्र देखाउनुहोस्"

#. i18n: file taskbar.kcfg line 17
#: rc.cpp:12
#, no-c-format
msgid ""
"Select this option if you want the taskbar to display <b>only</b> "
"minimized windows. \\n\\nBy default, this option is not selected and the "
"taskbar will show all windows."
msgstr ""
"यदि तपाईँले न्यून पारिएको सञ्झ्याल <b>मात्र</b> कार्यपट्टीमा देखाउन चाहनुहुन्छ "
"भने यो विकल्प चयन गर्नुहोस् । \\n\\nपूर्वनिर्धारित द्वारा, यो विकल्प चयन गरिएको "
"हुदैन र कार्यपट्टीले सबै सञ्झ्यालहरू देखाउँछ।"

#. i18n: file taskbar.kcfg line 22
#: rc.cpp:15
#, no-c-format
msgid "Never"
msgstr "कहिले पनि"

#. i18n: file taskbar.kcfg line 25
#: rc.cpp:18
#, no-c-format
msgid "When Taskbar Full"
msgstr "कार्यपट्टी पूर्ण हुँदा"

#. i18n: file taskbar.kcfg line 28
#: rc.cpp:21
#, no-c-format
msgid "Always"
msgstr "जहिले पनि"

#. i18n: file taskbar.kcfg line 32
#: rc.cpp:24
#, no-c-format
msgid "Group similar tasks:"
msgstr "समूह समान कार्य:"

#. i18n: file taskbar.kcfg line 33
#: rc.cpp:27
#, no-c-format
msgid ""
"The taskbar can group similar windows into single buttons. When one of these "
"window group buttons are clicked on a menu appears showing all the windows in "
"that group. This can be especially useful with the <em>Show all windows</em> "
"option.\\n\\nYou can set the taskbar to <strong>Never</strong> "
"group windows, to <strong>Always</strong> group windows or to group windows "
"only <strong>When the Taskbar is Full</strong>.\\n\\nBy default the taskbar "
"groups windows when it is full."
msgstr ""
"कार्यपट्टीले उस्तै सञ्झ्यालहरू एकल बटनमा समूहबद्ध गर्न सक्छ । सो समूहमा देखिने "
"सबै सञ्झ्याल देखाउने मेनुमा क्लिक गर्दा ति मध्ये एउटा सञ्झ्याल समूह देखाउदछ । "
"विशेष गरेर यो <em>सबै सञ्झ्यालहरू देखाउनुहोस्</em> विकल्पसँग उपयुक्त हुन्छ "
"।\\n\\n तपाईँ कार्यपट्टीलाई <strong>कहिलेपनि</strong> सञ्झ्याल समूहमा, <strong>"
"सधै</strong>सञ्झ्याल समूह वा <strong>कार्यपट्टी पूर्ण हुँदा</strong> "
"समूह सञ्झ्यालमा सेट गर्न सक्नुहुन्छ । \\n\\n पूर्वनिर्धारित रूपमा सञ्झ्यालहरू "
"पूर्ण हुँदा सञ्झ्याल समूहबद्ध हुन्छ ।"

#. i18n: file taskbar.kcfg line 37
#: rc.cpp:30
#, no-c-format
msgid "Sort windows by desktop"
msgstr "डेस्कटपद्वारा सञ्झ्यालहरू क्रमबद्व गर्नुहोस्"

#. i18n: file taskbar.kcfg line 38
#: rc.cpp:33
#, no-c-format
msgid ""
"Selecting this option causes the taskbar to show windows in order of the "
"desktop they appear on.\\n\\nBy default this option is selected."
msgstr ""
"यो विकल्प चयन गर्दा कार्यपट्टीले सञ्झ्यालहरू देखाउँदछ जुन अनुप्रयोगको अर्डरमा "
"हुन्छ।\\n\\nपूर्वनिर्धारितद्वारा यो विकल्प चयन गरिन्छ ।"

#. i18n: file taskbar.kcfg line 42
#: rc.cpp:36
#, no-c-format
msgid "Sort windows by application"
msgstr "अनुप्रयोगद्वारा सञ्झ्यालहरू क्रमबद्व गर्नुहोस्"

#. i18n: file taskbar.kcfg line 43
#: rc.cpp:39
#, no-c-format
msgid ""
"Selecting this option causes the taskbar to show windows ordered by "
"application.\\n\\nBy default this option is selected."
msgstr ""
"यो विकल्प चयन गर्दा कार्यपट्टीले सञ्झ्यालहरू देखाउँदछ जुन अनुप्रयोगको अर्डरमा "
"हुन्छ।\\n\\nपूर्वनिर्धारितद्वारा यो विकल्प चयन गरिन्छ।"

#. i18n: file taskbar.kcfg line 47
#: rc.cpp:42
#, no-c-format
msgid "Show application icons"
msgstr "अनुप्रयोग प्रतिमाहरू देखाउनुहोस्"

#. i18n: file taskbar.kcfg line 48
#: rc.cpp:45
#, no-c-format
msgid ""
"Select this option if you want window icons to appear along with their titles "
"in the taskbar.\\n\\nBy default this option is selected."
msgstr ""
"यदि तपाई कार्यपट्टीमा सञ्झ्याल प्रतिमाहरू तिनीहरूको शीर्षक सहित देखिएको "
"चाहनुहुन्छ भने यो विकल्प चयन गर्नुहोस्।\\n\\nपूर्वनिर्धारितद्वारा यो विकल्प चयन "
"गरिन्छ।"

#. i18n: file taskbar.kcfg line 64
#: rc.cpp:52
#, no-c-format
msgid "Show windows from all screens"
msgstr "सबै पर्दाहरूबाट सञ्झ्यालहरू देखाउनुहोस्"

#. i18n: file taskbar.kcfg line 65
#: rc.cpp:55
#, no-c-format
msgid ""
"Turning this option off will cause the taskbar to display <b>only</b> "
"windows which are on the same Xinerama screen as the taskbar.\\n\\nBy default, "
"this option is selected and all windows are shown."
msgstr ""
"यो विकल्प बन्द गर्नाले कार्यपट्टीको रूपमा उहि जिरेरामा पर्दामा भएका सञ्झ्याल <b> "
"मात्र <b> देखाउने हुन्छ ।\\n\\n पूर्वनिर्धारित रूपमा, यो विकल्प चयन गरिएको "
"हुन्छ र सबै सञ्झ्यालहरू देखाइएका हुन्छन् ।"

#. i18n: file taskbar.kcfg line 74
#: rc.cpp:60
#, no-c-format
msgid "Show window list button"
msgstr "सञ्झ्याल सूची बटन देखाउनुहोस्"

#. i18n: file taskbar.kcfg line 75
#: rc.cpp:63
#, no-c-format
msgid ""
"Selecting this option causes the taskbar to display a button that, when "
"clicked, shows a list of all windows in a popup menu."
msgstr ""
"यो विकल्प चयन गर्दा कार्यपट्टीले बटन प्रदर्शन गर्दछ, जब क्लिक गरिन्छ, पपअप "
"मेनूमा सबै सञ्झ्यालहरूको सूची देखाउँदछ।"

#. i18n: file taskbar.kcfg line 87
#: rc.cpp:66
#, no-c-format
msgid "Show Task List"
msgstr "कार्य सूची देखाउनुहोस्"

#. i18n: file taskbar.kcfg line 90
#: rc.cpp:69
#, no-c-format
msgid "Show Operations Menu"
msgstr "सञ्चालन मेनु देखाउनुहोस्"

#. i18n: file taskbar.kcfg line 93
#: rc.cpp:72
#, no-c-format
msgid "Activate, Raise or Minimize Task"
msgstr "सक्रिय पार्नुहोस्, कार्य बढाउनुहोस् वा न्यून पार्नुहोस्"

#. i18n: file taskbar.kcfg line 96
#: rc.cpp:75
#, no-c-format
msgid "Activate Task"
msgstr "कार्य सक्रिय गर्नुहोस्"

#. i18n: file taskbar.kcfg line 99
#: rc.cpp:78
#, no-c-format
msgid "Raise Task"
msgstr "कार्य बढाउनुहोस्"

#. i18n: file taskbar.kcfg line 102
#: rc.cpp:81
#, no-c-format
msgid "Lower Task"
msgstr "कार्य घटाउनुहोस्"

#. i18n: file taskbar.kcfg line 105
#: rc.cpp:84
#, no-c-format
msgid "Minimize Task"
msgstr "कार्य न्यून पार्नुहोस्"

#. i18n: file taskbar.kcfg line 108
#: rc.cpp:87
#, no-c-format
msgid "Move To Current Desktop"
msgstr "हालको डेस्कटपमा सार्नुहोस्"

#. i18n: file taskbar.kcfg line 111
#: rc.cpp:90
#, no-c-format
msgid "Close Task"
msgstr "कार्य बन्द गर्नुहोस्"

#. i18n: file taskbar.kcfg line 117
#: rc.cpp:93
#, no-c-format
msgid "Mouse button actions"
msgstr "माउस बटन कार्य"

#. i18n: file taskbar.kcfg line 125
#: rc.cpp:97
#, no-c-format
msgid ""
"The number of times to blink a taskbar button when a window asks for attention. "
"Setting this to 1000 or greater causes the button to blink forever."
msgstr ""
"विन्डोजले ध्यानका लागि सोधेको बेला कार्यपट्टीमा झिम्कने समयको सङ्ख्या । यसलाई "
"१००० मा त्यो भन्दा ठूलोमा सेटिङ गर्नाले सदाको लागि झिम्किरहने हुनसक्छ ।"

#. i18n: file taskbar.kcfg line 130
#: rc.cpp:100
#, no-c-format
msgid "Draw taskbar entries \"flat\" and not as a button"
msgstr "बटन जस्तो नभएर कार्यपट्टी प्रविष्टि \"flat\" कोर्नुहोस्"

#. i18n: file taskbar.kcfg line 131
#: rc.cpp:103
#, no-c-format
msgid ""
"Turning this option on will cause the taskbar to draw visible button frames for "
"each entry in the taskbar. \\n\\nBy default, this option is off."
msgstr ""
"यो विकल्प खुला गर्दा कार्यपट्टीले कार्यपट्टीमा प्रत्येक प्रविष्टिका लागि "
"दृश्यात्मक बटन फ्रेमहरू कोर्न लगाउँदछ । \\n\\nपूर्वनिर्धारितद्वारा, यो विकल्प "
"बन्द हुन्छ ।"

#. i18n: file taskbar.kcfg line 135
#: rc.cpp:106
#, no-c-format
msgid "Draw taskbar text with a halo around it"
msgstr "कार्यपट्टी पाठ यसको वरिपरि ह्यालो सहित कोर्नुहोस्"

#. i18n: file taskbar.kcfg line 136
#: rc.cpp:109
#, no-c-format
msgid ""
"Turning this option on will cause the taskbar to draw fancier text that has an "
"outline around it. While this is useful for transparent panels or particularly "
"dark panel backgrounds, it is slower."
msgstr ""
"यो विकल्प खोल्नाले कार्यपट्टीलाई फ्यानसियर पाठमा कोर्ने बनाउँदछ जोसँग वरिपरि "
"एउटा रूपरेखा छ । जब यो पारदर्शी प्यानलहरू वा निश्चित अध्यारो प्यानल "
"पृष्ठभूमिहरूका लागि उपयुक्त हुन्छ, यो ढिलो हुन्छ ।"

#. i18n: file taskbar.kcfg line 140
#: rc.cpp:112
#, no-c-format
msgid "Show a visible button frame on the task the cursor is positioned over"
msgstr "कार्यमा दृश्यात्मक बटन फ्रेम देखाउनुहोस् जहाँ कर्सर दर्साइएको छ"

#. i18n: file taskbar.kcfg line 144
#: rc.cpp:115
#, no-c-format
msgid "Show thumbnails instead of icons in the mouse-over effects"
msgstr "माउस-माथि प्रभावहरूमा प्रतिमाहरूको सट्टा थम्बनेलहरू देखाउनुहोस्"

#. i18n: file taskbar.kcfg line 145
#: rc.cpp:118
#, no-c-format
msgid ""
"Enabling this option will draw a thumbnail of the window in its mouse-over "
"effect."
"<p>If a window is minimized or resides on a different desktop while the taskbar "
"is starting, an icon is shown until the window is restored or the appropriate "
"desktop is activated, respectively.</p>"
msgstr ""
"यो विकल्पलाई सक्षम गर्नाले यसको माउस-माथि असरमा सञ्झ्यालको थम्बनेल कोर्नेछ ।"
"<p> कार्यपट्टी सुरु गर्दा विभिन्न डेस्कटपमा सञ्झ्याल न्यूनत्तम गरियो वा रिसाइड "
"गरियो भने, सञ्झ्याल पूर्वावस्थामा नल्याए सम्म वा उपयुक्त डेस्कटप सक्रिय नगेसम्म "
"एउटा प्रतिमा क्रमश: देखिन्छ । </p>"

#. i18n: file taskbar.kcfg line 149
#: rc.cpp:121
#, no-c-format
msgid "Maximum width/height of the thumbnail in pixels"
msgstr "पिक्सेलमा थम्बनेलको अधिकतम चौडाइ/उचाइ"

#. i18n: file taskbar.kcfg line 150
#: rc.cpp:124
#, no-c-format
msgid ""
"A thumbnail is created by resizing the window. The scaling factor is determined "
"by its largest dimension and this value. In doing so, the thumbnail's size will "
"not exceed this value in any dimension."
msgstr ""
"थम्बनेल सञ्झ्याल रिसाइज गरेर सिर्जना गरिन्छ । स्केलिङ तत्व त्यसको सबभन्दा ठूलो "
"आयाम र यो मानद्वारा निर्धारण गरिन्छ । यसो गर्दा, थम्बनेलको साइज कुनै आयाममा पनि "
"यो मान भन्दा बढी हुँदैन ।"

#. i18n: file taskbar.kcfg line 154
#: rc.cpp:127
#, no-c-format
msgid "Use custom colors for taskbar buttons text and background"
msgstr ""

#. i18n: file taskbar.kcfg line 155
#: rc.cpp:130
#, no-c-format
msgid ""
"Turning this option on will allow choosing your own colors for taskbar buttons "
"text and background."
msgstr ""

#. i18n: file taskbar.kcfg line 158
#: rc.cpp:133
#, no-c-format
msgid "Color to use for active task button text"
msgstr ""

#. i18n: file taskbar.kcfg line 160
#: rc.cpp:136
#, no-c-format
msgid ""
"This color is used for displaying text on taskbar button for task which is "
"active at the moment."
msgstr ""

#. i18n: file taskbar.kcfg line 163
#: rc.cpp:139
#, no-c-format
msgid "Color to use for inactive tasks button text"
msgstr ""

#. i18n: file taskbar.kcfg line 165
#: rc.cpp:142
#, no-c-format
msgid ""
"This color is used for displaying text on taskbar button for tasks other than "
"active."
msgstr ""

#. i18n: file taskbar.kcfg line 168
#: rc.cpp:145
#, no-c-format
msgid "Color to use for taskbar buttons background"
msgstr ""

#. i18n: file taskbar.kcfg line 170
#: rc.cpp:148
#, no-c-format
msgid "This color is used for displaying background of taskbar buttons."
msgstr ""

#: taskbarbindings.cpp:33
msgid "Next Taskbar Entry"
msgstr "अर्को कार्यपट्टी प्रविष्टि"

#: taskbarbindings.cpp:34
msgid "Previous Taskbar Entry"
msgstr "अघिल्लो कार्यपट्टी प्रविष्टि"

#: taskcontainer.cpp:646 taskcontainer.cpp:1619
msgid "modified"
msgstr "परिमार्जित"

#: taskcontainer.cpp:1536
msgid "Loading application ..."
msgstr "अनुप्रयोग लोड गर्दैछ ..."

#: taskcontainer.cpp:1600
msgid "On all desktops"
msgstr "सबै डेस्कटपमा"

#: taskcontainer.cpp:1605
#, c-format
msgid "On %1"
msgstr "%1 मा"

#: taskcontainer.cpp:1611
msgid "Requesting attention"
msgstr "ध्यान आकृष्ट गर्नुहोस्"

#: taskcontainer.cpp:1617
msgid "Has unsaved changes"
msgstr "यससँग बचत नगरिएको परिवर्तनहरू छन्"
