#. i18n: file minicli_ui.ui line 180
#: rc.cpp:9
#, no-c-format
msgid ""
"<qt>Select whether realtime scheduling should be enabled for the application. "
"The scheduler governs which process will run and which will have to wait. Two "
"schedulers are available:\n"
"<ul>\n"
"<li><em>Normal:</em> This is the standard, timesharing scheduler. It will "
"divide fairly the available processing time between all processes.</li>\n"
"<li><em>Realtime:</em>This scheduler will run your application uninterrupted "
"until it gives up the processor. This can be dangerous. An application that "
"does not give up the processor might hang the system. You need root's password "
"to use the scheduler.</li>\n"
"</ul>\n"
"</qt>"
msgstr ""
"<qt>अनुप्रयोगका लागि सक्षम पार्नु पर्ने रियलटाइम कार्यतालीका चयन गर्नुहोस् । "
"अनुक्रमकले चलाउने प्रक्रिया र प्रतिक्षा गर्ने प्रबन्ध "
"गर्छ । दुइ अनुक्रमक उपलब्ध छन्:\n"
"<ul>\n"
"<li><em>सामान्य:</em> यो मानक, समय सेयर गर्ने अनुक्रमक हो । यसले उपलब्ध "
"प्रक्रिया समय सबै प्रक्रिया बीचमा निश्पक्ष रुपमा विभाजन गर्नेछ ।</li>\n"
"<li><em>रियलटाइम:</em> यो अनुक्रमकले प्रसोधक त्यागे सम्म तपाईँको अनुप्रयोग विना "
"रोकावट चलाउने छ । यो जोखीमयुक्त हुन सक्छ । प्रसोधक त्याग नगर्ने अनुप्रयोगले "
"प्रणाली ह्याङ्ग गर्न सक्छ । अनुक्रमक प्रयोग गर्न तपाईँलाई रूटको पासवर्ड आवश्यक "
"हुन्छ ।</li>\n"
"</ul>\n"
"</qt>"

