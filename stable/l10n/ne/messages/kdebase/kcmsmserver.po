#. i18n: file smserverconfigdlg.ui line 116
#: rc.cpp:37
#, no-c-format
msgid "Default Shutdown Option"
msgstr "पूर्वानिर्धारित बन्द विकल्प"

#. i18n: file smserverconfigdlg.ui line 119
#: rc.cpp:40
#, no-c-format
msgid ""
"Here you can choose what should happen by default when you log out. This only "
"has meaning, if you logged in through KDM."
msgstr ""
"यहाँ तपाईँ लगआउट हुँदा पूर्वानिर्धारित रूपमा के हुन्छ भन्ने रोज्न सक्नुहुन्छ । "
"यदि तपाईँले केडीई मार्फत लग गर्नुभयो भने, मात्र यसको अर्थ हुन्छ ।"

#. i18n: file smserverconfigdlg.ui line 130
#: rc.cpp:43
#, no-c-format
msgid "&End current session"
msgstr "हालको सत्र अन्त्य गर्नुहोस्"

#. i18n: file smserverconfigdlg.ui line 138
#: rc.cpp:46
#, no-c-format
msgid "&Turn off computer"
msgstr "कम्प्युटर बन्द गर्नुहोस्"

#. i18n: file smserverconfigdlg.ui line 146
#: rc.cpp:49
#, no-c-format
msgid "&Restart computer"
msgstr "कम्प्युटर पुन: सुरु गर्नुहोस्"

#. i18n: file smserverconfigdlg.ui line 156
#: rc.cpp:52
#, no-c-format
msgid "Advanced"
msgstr "उन्नत"

#. i18n: file smserverconfigdlg.ui line 167
#: rc.cpp:55
#, no-c-format
msgid "Applications to be e&xcluded from sessions:"
msgstr "सत्रबाट बाहिर गर्नुपर्ने अनुप्रयोगू:"

#. i18n: file smserverconfigdlg.ui line 178
#: rc.cpp:58
#, no-c-format
msgid ""
"Here you can enter a comma-separated list of applications that should not be "
"saved in sessions, and therefore will not be started when restoring a session. "
"For example 'xterm,xconsole'."
msgstr ""
"यहाँ तपाईँले अनुप्रयोगहरूको अल्पविराम-विभाजित सूची प्रविष्ट गर्न सक्नुहुन्छ जुन "
"सत्रहरूमा बचत गर्नुहुँदैन, र तसर्थ सत्र पूर्वावस्थामा लैजाँदा सुरु हुने छैन । "
"उदाहरणका लागि 'xterm,xconsole' ।"
