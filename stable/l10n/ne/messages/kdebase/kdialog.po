#: kdialog.cpp:86
msgid "Progress bar dialog, returns a DCOP reference for communication"
msgstr "प्रगति बार संवादले सञ्चारका लागि डी सी ओ पी सन्दर्भ फर्काउँदछ"

#: kdialog.cpp:90
msgid "Dialog title"
msgstr "संवाद शीर्षक"

#: kdialog.cpp:91
msgid "Default entry to use for combobox and menu"
msgstr "कम्बोबाकस र मेनुका लागि प्रयोग गर्न पूर्वनिर्धारित प्रविष्टि"

#: kdialog.cpp:92
msgid "Allows the --getopenurl and --getopenfilename options to return multiple files"
msgstr "बहुँविध फाइल फर्काउन --getopenurl र --getopenfilename अनुमति दिन्छ"

#: kdialog.cpp:93
msgid ""
"Return list items on separate lines (for checklist option and file open with "
"--multiple)"
msgstr ""
"(बहुविधसँग फाइल खोल्ने र सूची विकल्प चेक सूचीका लागि) अलग अलग रेखाहरूमा सूची "
"वस्तुहरू फर्काउनुहोस्"

#: kdialog.cpp:94
msgid "Outputs the winId of each dialog"
msgstr "हरेक संवादको winId निर्गत गर्दछ"

#: kdialog.cpp:95
msgid "Makes the dialog transient for an X app specified by winid"
msgstr "winId द्वारा निर्दिष्ट गरेको एउटा एक्स app का लागि संवाद चलायमान बनाउँदछ"

#: kdialog.cpp:96
msgid "Config file and option name for saving the \"dont-show/ask-again\" state"
msgstr ""
"\"फेरि नदेखाउनुहोस्/नसोध्नुहोस्\" अवस्था बचत गर्नका लागि फाइल र विकल्प नाम "
"कन्फिग गर्नुहोस्"

#: kdialog.cpp:98
msgid "Arguments - depending on main option"
msgstr "तर्क - मुख्य विकल्पमा आश्रित"

#: kdialog.cpp:666
msgid "KDialog"
msgstr "केडीई संवाद"

#: kdialog.cpp:667
msgid "KDialog can be used to show nice dialog boxes from shell scripts"
msgstr "के संवाद शेल स्क्रिप्टबाट राम्रो संवाद बाकस देखाउन प्रयोग गर्न सकिन्छ"

#: kdialog.cpp:670
msgid "Current maintainer"
msgstr "हालको मर्मतकर्ता"

