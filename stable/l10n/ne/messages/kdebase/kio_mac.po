#: kio_mac.cpp:94
msgid "Unknown mode"
msgstr "अज्ञात मोड"

#: kio_mac.cpp:115
msgid "There was an error with hpcopy - please ensure it is installed"
msgstr "hpcopy सँग त्रुटि थियो - कृपया यो स्थापना भएकोमा यकिन गर्नुहोस् ।"

#: kio_mac.cpp:131
msgid "No filename was found"
msgstr "फाइलनाम फेला परेन"

#: kio_mac.cpp:144
msgid "There was an error with hpls - please ensure it is installed"
msgstr "hpls संगै एउटा त्रुटि थियो - कृपया यो स्थापना गरिएकोमा यकिन गर्नुहोस्"

#: kio_mac.cpp:187
msgid "No filename was found in the URL"
msgstr "URL मा फाइलनाम फेला परेन"

#: kio_mac.cpp:201
msgid "hpls did not exit normally - please ensure you have installed the hfsplus tools"
msgstr ""
"hpls समान्य तरिकाले निस्केन - कृपया तपाईँका hfsplus उपकरणहरू स्थापित "
"भएकोमा यकिन गर्नुहोस् ।"

#: kio_mac.cpp:288
msgid ""
"hpmount did not exit normally - please ensure that hfsplus utils are "
"installed,\n"
"that you have permission to read the partition (ls -l /dev/hdaX)\n"
"and that you have specified the correct partition.\n"
"You can specify partitions by adding ?dev=/dev/hda2 to the URL."
msgstr ""
"hpmount समान्य तरिकाले निस्केन - कृपया hfsplus उपयोगिता स्थापना गरिएकोमा,\n"
"जुनले तपाईँलाई विभाजन (ls -l /dev/hdaX)\n"
"\n"
"पढ्नका लागि र मिल्दो विभाजन निर्दिष्ट गर्न अनुमति छ भन्नेमा यकिन गर्नुहोस् । तपाईँले यू आर एल मा dev=/dev/hda2 थपेर विभाजन निर्दिष्ट गर्न सक्नुहुन्छ ।"

#: kio_mac.cpp:320
msgid "hpcd did not exit normally - please ensure it is installed"
msgstr "hpcd सामान्य तरिकाले निस्केन - कृपया यो स्थापित भएकोमा यकिन गर्नुहोस्"

#: kio_mac.cpp:407
msgid "hpls output was not matched"
msgstr "hpls निर्गत मिलेन"

#: kio_mac.cpp:450
msgid "Month output from hpls -l not matched"
msgstr "hpls -l बाट महिना निर्गत मिलेन"

#: kio_mac.cpp:479
msgid "Could not parse a valid date from hpls"
msgstr "hpls बाट वैध मिति व्याख्या गर्न सकेन"

