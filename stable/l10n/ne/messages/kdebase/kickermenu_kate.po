#: katesessionmenu.cpp:69
msgid "Start Kate (no arguments)"
msgstr "केट सुरु गर्नुहोस् (कुनै तर्क छैन)"

#: katesessionmenu.cpp:72
msgid "New Kate Session"
msgstr "नयाँ केट सत्र"

#: katesessionmenu.cpp:75
msgid "New Anonymous Session"
msgstr "नयाँ बेनामी सत्र"

#: katesessionmenu.cpp:96
msgid "Reload Session List"
msgstr "सत्र सूची पुन: लोड गर्नुहोस्"

#: katesessionmenu.cpp:112
msgid "Session Name"
msgstr "सत्र नाम"

#: katesessionmenu.cpp:113
msgid "Please enter a name for the new session"
msgstr "नयाँ सत्रको लागि कृपया नाम प्रविष्ट गर्नुहोस्"

#: katesessionmenu.cpp:120
msgid ""
"An unnamed session will not be saved automatically. Do you want to create "
"such a session?"
msgstr "एउटा नामकरण नगरिएको सत्र स्वचालित रूपमा बचत गरिने छैन । तपाईँ सो सत्र सिर्जना गर्न चाहनुहुन्छ ?"

#: katesessionmenu.cpp:122
msgid "Create anonymous session?"
msgstr "बेनामी सत्र सिर्जना गर्नुहुन्छ ?"

#: katesessionmenu.cpp:129
msgid "You allready have a session named %1. Do you want to open that session?"
msgstr "तपाईँसँग %1 नामकरण गरिएको सत्र पहिल्यै छ । तपाईँ त्यो सत्र खोल्न चाहनुहुन्छ ?"

#: katesessionmenu.cpp:130
msgid "Session exists"
msgstr "सत्र अवस्थित छ"

