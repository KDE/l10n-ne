#: krdb.cpp:340
msgid ""
"# created by KDE, %1\n"
"#\n"
"# If you do not want KDE to override your GTK settings, select\n"
"# Appearance & Themes -> Colors in the Control Center and disable the checkbox\n"
"# \"Apply colors to non-KDE applications\"\n"
"#\n"
"#\n"
msgstr ""
"# KDE द्वारा सिर्जित, %1\n"
"#\n"
"# यदि तपाईं KDE तपाईंको GTK सेटिङ्ग्समा थप्न चाहनु हुन्न भने, चयन गर्नुहोस्\n"
"# प्रदर्शन र विषयवस्तुहरू -> नियन्त्रण केन्द्रमा रङ्गहरू र जाँचबाकस असक्षम "
"पार्नुहोस्\n"
"# \"नन-KDE अनुप्रयोगहरूमा रङ्गहरू लागू गर्नुहोस्\"\n"
"#\n"
"#\n"
