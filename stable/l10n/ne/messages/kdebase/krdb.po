#: krdb.cpp:344
msgid ""
"# created by KDE, %1\n"
"#\n"
"# If you do not want KDE to override your GTK settings, select\n"
"# Appearance & Themes -> Colors in the Control Center and disable the checkbox\n"
"# \"Apply colors to non-KDE applications\"\n"
"#\n"
"#\n"
msgstr ""
"# केडीई द्वारा सिर्जित, %1\n"
"#\n"
"# यदि तपाईँको GTK सेटिङमा केडीई अधिरोहण गर्न चाहनुहुन्न भने,\n"
"# दृश्य र विषयवस्तु -> नियन्त्रण केन्द्रमा रङ चयन गर्नुहोस् र चेकबाकस अक्षम "
"पार्नुहोस्\n"
"# \"केडीई बाहेकको अनुप्रयोगमा रङ लागू गर्नुहोस्\"\n"
"#\n"
"#\n"
