#: kwriteconfig.cpp:19
msgid "Use <file> instead of global config"
msgstr "विश्वव्यापी कन्फिगको सट्टा <file> प्रयोग गर्नुहोस्"

#: kwriteconfig.cpp:20
msgid "Group to look in"
msgstr "खोजीका लागि समूह"

#: kwriteconfig.cpp:21
msgid "Key to look for"
msgstr "खोजीका लागि कुञ्जी"

#: kwriteconfig.cpp:22
msgid ""
"Type of variable. Use \"bool\" for a boolean, otherwise it is treated as a "
"string"
msgstr ""
"चलको प्रकार । बुलियनका लागि \"bool\" प्रयोग गर्नुहोस् अन्यथा यसलाई स्ट्रिङको "
"रूपमा व्यवहार गरिन्छ ।"

#: kwriteconfig.cpp:23
msgid "The value to write. Mandatory, on a shell use '' for empty"
msgstr "लेख्ने मान । रित्तोका लागि '' शेल प्रयोगमा अनिवार्य"

#: kwriteconfig.cpp:28
msgid "KWriteConfig"
msgstr "KWriteConfig"

#: kwriteconfig.cpp:30
msgid "Write KConfig entries - for use in shell scripts"
msgstr "शेल स्क्रिप्ट प्रयोग गर्नका लागि केडीई कन्फिग प्रविष्टि लेख्नुहोस्"

