msgid "Configure Display..."
msgstr "प्रदर्शन कन्फिगर गर्नुहोस्..."

#: krandrtray.cpp:117
msgid "Screen configuration has changed"
msgstr "पर्दा कन्फिगरेसन परिवर्तन गरियो"

#: krandrtray.cpp:128
msgid "Screen Size"
msgstr "पर्दा साइज"

#: krandrtray.cpp:181
msgid "Refresh Rate"
msgstr "ताजा पार्ने दर"

#: krandrtray.cpp:251
msgid "Configure Display"
msgstr "प्रदर्शन कन्फिगर गर्नुहोस्"

