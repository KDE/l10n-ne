#: appletproxy.cpp:65
msgid "The applet's desktop file"
msgstr "एप्लेटको डेस्कटप फाइल"

#: appletproxy.cpp:66
msgid "The config file to be used"
msgstr "प्रयोग हुने कन्फिग फाइल"

#: appletproxy.cpp:67
msgid "DCOP callback id of the applet container"
msgstr "एप्लेट कन्टेनरको DCOP कलब्याक आई डी"

#: appletproxy.cpp:73 appletproxy.cpp:75
msgid "Panel applet proxy."
msgstr "प्रोक्सी एप्लेट प्यानल ।"

#: appletproxy.cpp:97
msgid "No desktop file specified"
msgstr "डेस्कटप फाइल निर्दिष्ट गरिएको छैन"

#: appletproxy.cpp:132
msgid ""
"The applet proxy could not be started due to DCOP communication problems."
msgstr ""
"DCOP मा सञ्चार समस्याहरूको कारणले गर्दा एप्लेट प्रोक्सी सुरुवात हुन सकेन ।"

#: appletproxy.cpp:133 appletproxy.cpp:141 appletproxy.cpp:174
#: appletproxy.cpp:195 appletproxy.cpp:297 appletproxy.cpp:322
msgid "Applet Loading Error"
msgstr "एप्लेट लोडिङ गर्दा त्रुटि"

#: appletproxy.cpp:140
msgid ""
"The applet proxy could not be started due to DCOP registration problems."
msgstr ""
"DCOP मा दर्ता समस्याहरूको कारणले गर्दा एप्लेट प्रोक्सी सुरुवात हुन सकेन ।"

#: appletproxy.cpp:173
#, c-format
msgid "The applet proxy could not load the applet information from %1."
msgstr "%1 बाट एप्लेट प्रोक्सीले एप्लेट सूचना लोड गर्न सकेन ।."

#: appletproxy.cpp:194
msgid "The applet %1 could not be loaded via the applet proxy."
msgstr "एप्लेट %1 एप्लेट प्रोक्सी हुदैँ लोड हुन सकेन ।"

#: appletproxy.cpp:296
msgid ""
"The applet proxy could not dock into the panel due to DCOP communication "
"problems."
msgstr ""
"DCOP सञ्चार समस्याहरूको कारणले गर्दा एप्लेट प्रोक्सी प्यानलमा छोट्याउन सकेन ।"

#: appletproxy.cpp:321
msgid "The applet proxy could not dock into the panel."
msgstr "एप्लेट प्रोक्सी प्यानलमा छोट्याउन सकेन ।"

