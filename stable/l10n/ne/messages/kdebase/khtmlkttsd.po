#: khtmlkttsd.cpp:43
msgid "&Speak Text"
msgstr "पाठ उच्चारण गर्नुहोस्"

#: khtmlkttsd.cpp:60
msgid "Cannot Read source"
msgstr "स्रोत पढ्न सकिदैन"

#: khtmlkttsd.cpp:61
msgid ""
"You cannot read anything except web pages with\n"
"this plugin, sorry."
msgstr ""
"माफ गर्नुहोस्, तँपाइ यो प्लगइन संग\n"
" कुनै स्वीकार गर्ने वेवपेजहरू पढ्न सक्नुहुन्न ।"

#: khtmlkttsd.cpp:71
msgid "Starting KTTSD Failed"
msgstr "KTTSD शुरूवात गर्दा असफल"

#: khtmlkttsd.cpp:86 khtmlkttsd.cpp:125 khtmlkttsd.cpp:131
msgid "DCOP Call Failed"
msgstr "DCOP बोलावट असफल"

#: khtmlkttsd.cpp:87
msgid "The DCOP call supportsMarkup failed."
msgstr "DCOP बोलावटले मार्कअप असफलता लाई समर्थन गर्दछ ।"

#: khtmlkttsd.cpp:126
msgid "The DCOP call setText failed."
msgstr "DCOP बोलावटले पाठ असफलता सेट गर्छ ।"

#: khtmlkttsd.cpp:132
msgid "The DCOP call startText failed."
msgstr "DCOP बोलावटले पाठ असफलतालाई शुरू गर्दछ ।"
