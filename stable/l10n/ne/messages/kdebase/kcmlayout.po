msgstr "क्याप्सलकले शिफ्ट परिमार्जकलाई मात्र ताल्चा लगाउँछ ।"

#: kcmlayout.cpp:961
msgid "CapsLock toggles normal capitalization of alphabetic characters."
msgstr ""
"क्याप्सलकले वर्णानुक्रम क्यारेक्टरको सामान्य क्यापिटलाइजेसन टगल गर्दछ ।"

#: kcmlayout.cpp:962
msgid "CapsLock toggles Shift so all keys are affected."
msgstr "क्याप्सलकले सबै कुञ्जीलाई प्रभावित पार्न शिफ्ट टगल गर्दछ ।"

#: kcmlayout.cpp:963
msgid "Alt and Meta are on the Alt keys (default)."
msgstr "Alt कुञ्जीमा (पूर्वनिर्धारित) Alt र मेटा ।"

#: kcmlayout.cpp:964
msgid "Alt is mapped to the right Win-key and Super to Menu."
msgstr "Alt दायाँ विन कुञ्जीमा र सुपर मेनुमा नक्शाङ्कन गरिएको छ ।"

#: kcmlayout.cpp:965
msgid "Compose key position"
msgstr "कुञ्जी स्थिति कम्पोज गर्नुहोस्"

#: kcmlayout.cpp:966
msgid "Right Alt is Compose."
msgstr "दायाँ Alt कम्पोज गर्ने हो ।"

#: kcmlayout.cpp:967
msgid "Right Win-key is Compose."
msgstr "दायाँ विन्डोस कुञ्जी कम्पोज गर्ने हो ।"

#: kcmlayout.cpp:968
msgid "Menu is Compose."
msgstr "मेनु कम्पोज गर्ने हो ।"

#: kcmlayout.cpp:969
msgid "Right Ctrl is Compose."
msgstr "दायाँ ctrl कम्पोज गर्ने हो ।"

#: kcmlayout.cpp:970
msgid "Caps Lock is Compose."
msgstr "क्याप्सलक कम्पोज गर्ने हो ।"

#: kcmlayout.cpp:971
msgid "Special keys (Ctrl+Alt+&lt;key&gt;) handled in a server."
msgstr "विशेष कुञ्जी (Ctrl+Alt+<key>) सर्भरमा ह्यान्डल गरिएको छ ।"

#: kcmlayout.cpp:972
msgid "Adding the EuroSign to certain keys"
msgstr "निश्चित कुञ्जीहरूमा युरोसाइन थप्दैछ"

#: kcmlayout.cpp:973
msgid "Add the EuroSign to the E key."
msgstr "ई कुञ्जीमा युरोसाइन थप्नुहोस् ।"

#: kcmlayout.cpp:974
msgid "Add the EuroSign to the 5 key."
msgstr "५ कुञ्जीमा युरोसाइन थप्नुहोस् ।"

#: kcmlayout.cpp:975
msgid "Add the EuroSign to the 2 key."
msgstr "२ कुञ्जीमा युरोसाइन थप्नुहोस् ।"

