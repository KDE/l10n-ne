#: kcmlayout.cpp:814
msgid "CapsLock key behavior"
msgstr "CapsLock कुञ्जी व्यवहार"

#: kcmlayout.cpp:815
msgid "uses internal capitalization. Shift cancels Caps."
msgstr "आन्तरिक क्यापिटलाइजेसन प्रयोग हुन्छ । Shift ले क्याप्स रद्द गर्छ ।"

#: kcmlayout.cpp:816
msgid "uses internal capitalization. Shift doesn't cancel Caps."
msgstr "आन्तरिक क्यापिटलाइजेसन प्रयोग हुन्छ । Shift ले क्याप्स रद्द गर्दैन ।"

#: kcmlayout.cpp:817
msgid "acts as Shift with locking. Shift cancels Caps."
msgstr "ताल्चा लगाउदा Shift का रुपमा कार्य गर्छ । Shift ले क्याप्स रद्द गर्छ ।"

#: kcmlayout.cpp:818
msgid "acts as Shift with locking. Shift doesn't cancel Caps."
msgstr ""
"ताल्चा लगाउदा Shift का रुपमा कार्य गर्छ । Shift ले क्याप्स रद्द गर्दैन ।"

#: kcmlayout.cpp:819
msgid "Alt/Win key behavior"
msgstr "Alt/Win कुञ्जी व्यवहार"

