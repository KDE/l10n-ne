msgstr "सम्पर्क लोड गरिदैछ..."

#: kcal/resourcekolab.cpp:167
msgid "Loading tasks..."
msgstr "कार्य लोड गरिदैछ..."

#: kcal/resourcekolab.cpp:168
msgid "Loading journals..."
msgstr "जर्नल लोड गरिदैछ..."

#: kcal/resourcekolab.cpp:169
