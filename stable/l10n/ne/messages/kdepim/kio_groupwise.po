#: groupwise.cpp:119
msgid ""
"Unknown path. Known paths are '/freebusy/', '/calendar/' and '/addressbook/'."
msgstr ""
"अज्ञात मार्ग । पहिचान भएका मार्ग '/freebusy/', '/calendar/' र '/addressbook/' "
"हुन् ।"

#: groupwise.cpp:164
msgid "Illegal filename. File has to have '.ifb' suffix."
msgstr "अवैध फाइल नाम । फाइलमा '.ifb' प्रत्यय भएको हुनुपर्छ ।"

#: groupwise.cpp:188
msgid "Need username and password to read Free/Busy information."
msgstr "स्वतन्त्र/व्यस्त सूचना पढ्न प्रयोगकर्ता नाम र पासवर्ड आवश्यक हुन्छ ।"

