msgstr "%2 बाट ठेगाना पुस्तक प्रविष्टि %1 पढ्नुहोस्"

#: kmobileview.cpp:328
msgid "Storing contact %1 on %2 failed"
msgstr "%2 मा सम्पर्क %1 मा भण्डारण गर्न असफल"

#: kmobileview.cpp:329
msgid "Contact %1 stored on %2"
msgstr "%2 मा सम्पर्क %1 भण्डारण गरियो"

#: kmobileview.cpp:370
msgid "Read note %1 from %2"
msgstr "%2 बाट द्रष्टव्य %1 पढ्नुहोस्"

