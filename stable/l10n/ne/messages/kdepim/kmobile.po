#: kmobiledevice.cpp:395
#, c-format
msgid ""
"Unable to read lockfile %s. Please check for reason and remove the lockfile by "
"hand."
msgstr ""
"लक फाइल %s पढ्न असमर्थ । कृपया कारणका लागि जाँच गर्नुहोस् र हातैले लक फाइल "
"हटाउनुहोस् ।"

#: kmobiledevice.cpp:414
msgid "Lockfile %1 is stale. Please check permissions."
msgstr "लक फाइल %1 पुरानो हो । कृपया अनुमति जाँच गर्नुहोस् ।"

#: kmobiledevice.cpp:418
msgid "Device %1 already locked."
msgstr "यन्त्र %1 पहिलेनै ताल्चा लगाइएको छ ।"

#: kmobiledevice.cpp:427
msgid "Device %1 seems to be locked by unknown process."
msgstr "यन्त्र %1 अज्ञात प्रक्रिया अनुरुप ताल्चा लगाइने देखिन्छ ।"

#: kmobiledevice.cpp:429
msgid "Please check permission on lock directory."
msgstr "कृपया लक डाइरेक्टरीमा अनुमति जाँच गर्नुहोस् ।"

#: kmobiledevice.cpp:431
msgid "Cannot create lockfile %1. Please check for existence of path."
msgstr ""
"लक फाइल %1 सिर्जना गर्न सकिदैन । कृपया बाटोको अस्तित्वको लागि जाँच गर्नुहोस् ।"

#: kmobiledevice.cpp:433
msgid "Could not create lockfile %1. Error-Code is %2."
msgstr "लक फाइल %1 सिर्जना गर्न सकेन । त्रुटि सङ्केत %2 हो ।"

