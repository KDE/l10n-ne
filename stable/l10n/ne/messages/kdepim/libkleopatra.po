#. i18n: file ui/directoryserviceswidgetbase.ui line 211
#: rc.cpp:68
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Add a Directory Service</h1>\n"
"By clicking this button, you can select a new directory service to be used for "
"retrieving certificates and CRLs. You will be asked for the server name and an "
"optional description.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>डाइरेक्टरी सेवा थप्नुहोस्</h1>\n"
"यो बटन क्लिक गरेर, प्रमाणपत्र र CRL हरू पुन: प्राप्त गर्न प्रयोग गरिने नयाँ "
"डाइरेक्टरी सेवा चयन गर्न सक्नुहुन्छ । तपाईँलाई सर्भर नाम र वैकल्पिक विस्तृत "
"विवरणका लागि सोधिनेछ ।\n"
"</qt>"

