msgid "Unable to load the article."
msgstr "लेख लोड गर्न असमर्थ ।"

#: articlewidget.cpp:373
msgid "The article contains no data."
msgstr "लेखमा कुनै डेटा समावेश छैन ।"

#: articlewidget.cpp:400
msgid "Unknown charset. Default charset is used instead."
msgstr "अज्ञात चारसेट । साटोमा पूर्वनिर्धारित चारसेट प्रयोग गरिएकोछ ।"

#: articlewidget.cpp:460
msgid ""
"<br/><b>This article has the MIME type &quot;message/partial&quot;, which KNode "
"cannot handle yet."
"<br>Meanwhile you can save the article as a text file and reassemble it by "
"hand.</b>"
msgstr ""
"<br/><b>यो लेखमा केडीई नोडले अहिलेसम्म ह्यान्डल गर्न नसकेका, माइम प्रकार "
"&quot;सन्देश/आंशिक &quot;छन् ।"
"<br>यस्तो बेलामा तपाईँले पाठ फाइलका रुपमा लेख बचत गर्न सक्नुहुन्छ र यसलाई "
"हातैले पुन: एकत्रित पार्न सक्नुहुन्छ ।</b>"

#: articlewidget.cpp:477
msgid ""
"<b>Note:</b> This is an HTML message. For security reasons, only the raw HTML "
"code is shown. If you trust the sender of this message then you can activate "
"formatted HTML display for this message <a href=\"knode:showHTML\">"
"by clicking here</a>."
msgstr ""
"<b>द्रष्टव्य:</b> यो एचटीएमएल सन्देश हो । सुरक्षाका कारणले, केवल अपूर्ण "
"एचटीएमएल सङ्केत मात्र देखाइएकोछ । तपाईँले यो सन्देशको प्रेषकलाई विश्वास गरेपछि "
"यो सन्देशका लागि ढाँचाबद्ध गरिएको एचटीएमएल प्रदर्शन यहाँ <a "
"href=\"knode:showHTML\">क्लिक गरेर सक्रिय पार्न सक्नुहुन्छ</a> ।"

#: articlewidget.cpp:523
msgid "An error occurred."
msgstr "एउटा त्रुटि उत्पन्न भयो ।"

#: articlewidget.cpp:656
msgid "References:"
msgstr "सन्दर्भ:"

#: articlewidget.cpp:742
#, c-format
msgid "Message was signed with unknown key 0x%1."
msgstr "अज्ञात कुञ्जी 0x%1 द्वारा सन्देश चिनो लगाइएको थियो ।"

#: articlewidget.cpp:745
msgid "The validity of the signature cannot be verified."
msgstr "हस्ताक्षरको वैद्यता रुजू गर्न सकिँदैन ।"

#: articlewidget.cpp:763
msgid "Message was signed by %1 (Key ID: 0x%2)."
msgstr "सन्देश %1 (कुञ्जी आईडी: 0x%2) द्वारा चिनो लगाइएको थियो ।"

#: articlewidget.cpp:767
#, c-format
msgid "Message was signed by %1."
msgstr "सन्देश %1 द्वारा चिनो लगाइएको थियो ।"

#: articlewidget.cpp:777
msgid "The signature is valid, but the key's validity is unknown."
msgstr "हस्ताक्षर वैद्य छ, तर कुञ्जीको वैद्यता अज्ञात छ ।"

#: articlewidget.cpp:781
msgid "The signature is valid and the key is marginally trusted."
msgstr "हस्ताक्षर वैद्य छ र कुञ्जी आंशिक विश्वासिलो छ ।"

#: articlewidget.cpp:785
msgid "The signature is valid and the key is fully trusted."
msgstr "हस्ताक्षर वैद्य छ र कुञ्जी पूर्ण विश्वासिलो छ ।"

#: articlewidget.cpp:789
msgid "The signature is valid and the key is ultimately trusted."
msgstr "हस्ताक्षर वैद्य छ र कुञ्जी अतिनै विश्वासिलो छ ।"

#: articlewidget.cpp:793
msgid "The signature is valid, but the key is untrusted."
msgstr "हस्ताक्षर वैद्य छ, तर कुञ्जी अविश्वाशिलो छ ।"

#: articlewidget.cpp:797
msgid "Warning: The signature is bad."
msgstr "चेतावनी: हस्ताक्षर गलत छ ।"

#: articlewidget.cpp:814
msgid "End of signed message"
msgstr "चिनो लगाएका सन्देशको अन्त्य"

#: articlewidget.cpp:830
msgid "unnamed"
msgstr "नामकरण नगरिएको"

#: articlewidget.cpp:1024
msgid "An error occurred while downloading the article source:\n"
msgstr "लेख स्रोत डाउनलोड गर्दा एउटा त्रुटि उत्पन्न भयो:\n"

#: articlewidget.cpp:1380 kncomposer.cpp:1218
msgid "Select Charset"
msgstr "चारसेट चयन गर्नुहोस्"

