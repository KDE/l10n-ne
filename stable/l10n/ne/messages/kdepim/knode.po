#: headerview.cpp:76
msgid "Line Count"
msgstr "रेखा गणना गर्नुहोस्"

#: headerview.cpp:222
msgid "Date (thread changed)"
msgstr "मिति (थ्रेड परिवर्तन गरियो)"

#: headerview.cpp:449
msgid "Newsgroups / To"
msgstr "समचार समूह / यसलाई"

#: knaccountmanager.cpp:142
msgid "Cannot create a folder for this account."
msgstr "यो खाताका लागि फोल्डर सिर्जना गर्न सकिदैन ।"

#: knaccountmanager.cpp:156
msgid "This account cannot be deleted since there are some unsent messages for it."
msgstr "खातामा नपठाएका केही सन्देश रहेसम्म यसलाई खाता मेट्न सकिदैन ।"

#: knaccountmanager.cpp:158
msgid "Do you really want to delete this account?"
msgstr "के तपाईँ वास्तवमै यो खाता मेट्न चाहनुहुन्छ?"

#: knaccountmanager.cpp:162
msgid ""
"At least one group of this account is currently in use.\n"
"The account cannot be deleted at the moment."
msgstr ""
"यो खाताको कम्तिमा एउटा समूह हाल प्रयोगमा छ ।\n"
"यो क्षणमा खाता मेट्न सकिने छैन ।"

#: knarticlecollection.cpp:55
msgid ""
"Memory allocation failed.\n"
"You should close this application now\n"
"to avoid data loss."
msgstr ""
"स्मृति बाँडफाड असफल ।\n"
"तपाईँले डेटा हराउन नदिन अहिले\n"
"यो अनुप्रयोग बन्द गर्नुपर्छ ।"

#: knarticlefactory.cpp:143
msgid ""
"The author has requested a reply by email instead\n"
"of a followup to the newsgroup. (Followup-To: poster)\n"
"Do you want to reply in public anyway?"
msgstr ""
"लेखकले समचार समूहलाई अनुगमनको साटोमा\n"
"इमेल मार्फत एउटा जवाफ अनुरोध गरेको छ ।(यसलाई अनुगमन गर्नुहोस्: पोस्टर)\n"
"तपाईँ फेरि पनि सार्वजनिक रुपमा जवाफ दिन चाहनुहुन्छ?"

#: knarticlefactory.cpp:143
msgid "Reply Public"
msgstr "सबैलाई जवाफ दिनुहोस्"

#: knarticlefactory.cpp:143
msgid "Reply by Email"
msgstr "इमेल मार्फत जवाफ दिनुहोस्"

#: knarticlefactory.cpp:194
msgid "The author requested a mail copy of your reply. (Mail-Copies-To header)"
msgstr ""
"तपाईँको जवाफका लागि लेखकले एउटा मेल प्रति अनुरोध गरेको छ । (हेडरलाई मेल "
"प्रतिहरू)"

#: knarticlefactory.cpp:282
msgid "This article contains attachments. Do you want them to be forwarded as well?"
msgstr ""
"यो लेखले सङ्लग्नता समावेश गर्छ । के तपाईँ तिनीहरूलाई यस्तै रुपमा पठाउन "
"चाहनुहुन्छ?"

#: knarticlefactory.cpp:282
msgid "Forward"
msgstr "पठाउनुहोस्"

#: knarticlefactory.cpp:282
msgid "Do Not Forward"
msgstr "नपठाउनुहोस्"

#: knarticlefactory.cpp:309
msgid "Forwarded message (begin)"
msgstr "पठाइएको सन्देश (सुरुआत)"

#: knarticlefactory.cpp:314
msgid "Newsgroup"
msgstr "समाचार समूह"

#: knarticlefactory.cpp:324
msgid "Forwarded message (end)"
msgstr "पठाइएको सन्देश (अन्त्य)"

#: knarticlefactory.cpp:363
msgid "Do you really want to cancel this article?"
msgstr "के तपाईँ वास्तवमै यो लेख रद्द गर्न चाहनुहुन्छ?"

#: knarticlefactory.cpp:363
msgid "Cancel Article"
msgstr "लेख रद्द गर्नुहोस्"

#: knarticlefactory.cpp:367
msgid ""
"Do you want to send the cancel\n"
"message now or later?"
msgstr ""
"के तपाईँले रद्द गरिएको सन्देश\n"
"अहिले वा पछि पठाउन चाहनुहुन्छ?"

#: knarticlefactory.cpp:367
msgid "Question"
msgstr "प्रश्न"

#: knarticlefactory.cpp:367
msgid "&Now"
msgstr "अहिले"

#: knarticlefactory.cpp:367
msgid "&Later"
msgstr "पछि"

#: knarticlefactory.cpp:382 knarticlefactory.cpp:459 kncomposer.cpp:1501
msgid "You have no valid news accounts configured."
msgstr "तपाईँसँग कन्फिगर गरिएका वैद्य समाचार खाता छैनन् ।"

#: knarticlefactory.cpp:443
msgid "Do you really want to supersede this article?"
msgstr "के तपाईँ वास्तवमै यो लेख अलग गर्न चाहनुहुन्छ?"

#: knarticlefactory.cpp:443
msgid "Supersede"
msgstr "अलग गर्नुहोस्"

#: knarticlefactory.cpp:575
msgid "This article cannot be edited."
msgstr "यो लेख सम्पादन गर्न सकिँदैन ।"

#: knarticlefactory.cpp:602 knarticlefactory.cpp:896
msgid ""
"<qt>The signature generator program produced the following output:"
"<br>"
"<br>%1</qt>"
msgstr ""
"<qt>हस्ताक्षर विकास गर्ने कार्यक्रमले निम्न निर्गत उत्पादन गर्यो:"
"<br>"
"<br>%1</qt>"

#: knarticlefactory.cpp:628
msgid "Article has already been sent."
msgstr "लेख पहिलेनै पठाइएको छ ।"

#: knarticlefactory.cpp:645
msgid "Unable to load article."
msgstr "लेख लोड गर्न असमर्थ ।"

#: knarticlefactory.cpp:670
msgid "Unable to load the outbox-folder."
msgstr "प्रेषण-मञ्जूषा फोल्डर लोड गर्न असमर्थ ।"

#: knarticlefactory.cpp:733
msgid ""
"You have aborted the posting of articles. The unsent articles are stored in the "
"\"Outbox\" folder."
msgstr ""
"तपाईँले लेखको पोस्टिङ परित्याग गर्नुभएको छ । नपठाइएका सन्देश \"प्रेषण-मञ्जूषा\" "
"फोल्डरमा भण्डारण गरिएका छन् ।"

#: knarticlefactory.cpp:782
msgid ""
"Please set a hostname for the generation\n"
"of the message-id or disable it."
msgstr ""
"कृपया सन्देश आईडीको उत्पन्न गर्न वा यसलाई अक्षम पार्नका लागि होस्ट नाम सेट "
"गर्नुहोस् ।"

#: knarticlefactory.cpp:825
msgid ""
"Please enter a valid email address at the identity tab of the account "
"configuration dialog."
msgstr ""
"कृपया खाता कन्फिगरेसन संवादको परिचय ट्याबमा वैद्य इमेल ठेगाना प्रविष्ट "
"गर्नुहोस् ।"

#: knarticlefactory.cpp:828
msgid ""
"Please enter a valid email address at the identity section of the configuration "
"dialog."
msgstr "कृपया कन्फिगरेसन संवादको परिचय खण्डमा वैद्य इमेल ठेगाना प्रविष्ट गर्नुहोस् ।"

#: knarticlefactory.cpp:916
msgid "Emails cannot be canceled or superseded."
msgstr "इमेलहरू रद्द गर्न वा अलग गर्न सकिँदैन ।"

#: knarticlefactory.cpp:922
msgid "Cancel messages cannot be canceled or superseded."
msgstr "रद्द गरिएका सन्देश रद्द गर्न वा अलग गर्न सकिँदैन ।"

#: knarticlefactory.cpp:927
msgid "Only sent articles can be canceled or superseded."
msgstr "पठाइएका सन्देश मात्र रद्द गर्न वा अलग गर्न सकिन्छ ।"

#: knarticlefactory.cpp:932
msgid "This article has already been canceled or superseded."
msgstr "यो लेख पहिलेनै रद्द गरिएको वा अलग गरिएको छ ।"

#: knarticlefactory.cpp:939
msgid ""
"This article cannot be canceled or superseded,\n"
"because its message-id has not been created by KNode.\n"
"But you can look for your article in the newsgroup\n"
"and cancel (or supersede) it there."
msgstr ""
"यो लेख रद्द गर्न वा अलग गर्न सकिँदैन,\n"
"कनभने यसको सन्देश आईडी केडीई नोडद्वारा सिर्जना गरिएको छैन ।\n"
"तर तपाईँले लेख समाचार समूहमा हेर्न सक्नुहुन्छ\n"
"र यसलाई त्यहाँ रद्द (वा अलग गर्न) सक्नुहुन्छ ।"

#: knarticlefactory.cpp:973
msgid ""
"This article does not appear to be from you.\n"
"You can only cancel or supersede your own articles."
msgstr ""
"यो लेख तपाईँबाट देखिदैन ।\n"
"तपाईँले आफ्ना लेख केवल रद्द गर्न वा अलग गर्न सक्नुहुन्छ ।"

#: knarticlefactory.cpp:978
msgid ""
"You have to download the article body\n"
"before you can cancel or supersede the article."
msgstr ""
"तपाईँले लेख रद्द र अलग गर्नुभन्दा पहिले\n"
"लेख मुख्य भाग डाउनलोड गर्नुपर्छ ।"

#: knarticlefactory.cpp:1067
msgid "Errors While Sending"
msgstr "पठाउँदा त्रुटि"

#: knarticlefactory.cpp:1073
msgid "Errors occurred while sending these articles:"
msgstr "यी लेख पठाउँदा त्रुटि उत्पन्न भयो:"

