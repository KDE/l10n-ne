#: kmime_mdn.cpp:54
msgid ""
"The message sent on ${date} to ${to} with subject \"${subject}\" has been "
"displayed. This is no guarantee that the message has been read or understood."
msgstr ""
"\"${subject}\" विषयसँग ${date} बाट ${to} मा पठाएको सन्देश प्रर्दशन गरिएको छ । "
"त्यो सन्देश पढेको र बुझेकोमा कुनै निश्चय छैन ।"

#: kmime_mdn.cpp:58
msgid ""
"The message sent on ${date} to ${to} with subject \"${subject}\" has been "
"deleted unseen. This is no guarantee that the message will not be \"undeleted\" "
"and nonetheless read later on."
msgstr ""
"\"${subject}\" विषयसँग ${date} बाट ${to} मा पठाएको सन्देश अदृश्य रूपमा मेटियो । "
"सन्देश \"नमेटिएको\" छ र त्यो पछि पढिन्छ भन्नेमा कुनै निश्चय गर्न सकिदैन ।"

#: kmime_mdn.cpp:63
msgid ""
"The message sent on ${date} to ${to} with subject \"${subject}\" has been "
"dispatched. This is no guarantee that the message will not be read later on."
msgstr ""
"\"${subject}\" विषयसँग ${date} बाट ${to} पठाएको सन्देश छोडियो । त्यो सन्देश "
"पढिन्छ नै भन्ने कुनै निश्चय गर्न सकिदैन ।"

#: kmime_mdn.cpp:67
msgid ""
"The message sent on ${date} to ${to} with subject \"${subject}\" has been "
"processed by some automatic means."
msgstr ""
"सन्देश केही स्वचालित साधनद्वारा \"${subject}\" विषयसँग ${date} बाट ${to} पठाइयो "
"।"

#: kmime_mdn.cpp:70
msgid ""
"The message sent on ${date} to ${to} with subject \"${subject}\" has been acted "
"upon. The sender does not wish to disclose more details to you than that."
msgstr ""
"\"${subject}\" विषयसँग ${date} बाट ${to} पठाएको सन्देश क्रियाशिल गरियो । "
"प्रेषकले यो भन्दा बढी जानकारी तपाईँलाई खोल्न चाहेन ।"

#: kmime_mdn.cpp:74
msgid ""
"Generation of a Message Disposition Notification for the message sent on "
"${date} to ${to} with subject \"${subject}\" failed. Reason is given in the "
"Failure: header field below."
msgstr ""
"सन्देशका लागि \"${subject}\" सँग ${date} बाट ${to} मा सन्देश विन्यास सूचनाको "
"उत्पन्न पठाउन असफल । असफलताको कारण हेडर फिल्ड तलको असफलमा दिएको छ ।"

#: kmime_util.cpp:665
msgid "unknown"
msgstr "अज्ञात"

