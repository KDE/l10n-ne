#: fleetdlg.cc:41
msgid "Fleet Overview"
msgstr "फिल्ट समिक्षा"

#: fleetdlg.cc:44
msgid "Fleet No."
msgstr "फिल्ट नम्बर"

#: fleetdlg.cc:45
msgid "Destination"
msgstr "गन्तव्य"

#: fleetdlg.cc:46
msgid "Ships"
msgstr "जहाज"

#: fleetdlg.cc:47
msgid "Kill Percentage"
msgstr "मार्ने प्रतिशत"

#: fleetdlg.cc:48
msgid "Arrival Turn"
msgstr "मोड आयो"

#: gameboard.cc:65
msgid "End Turn"
msgstr "अन्तिम मोड"

#: gameboard.cc:237
msgid "Select source planet..."
msgstr "स्रोत ग्रह चयन गर्नुहोस्..."

#: gameboard.cc:255
msgid "Select destination planet..."
msgstr "गन्तव्य ग्रह चयन गर्नुहोस्..."

#: gameboard.cc:277
msgid ": How many ships?"
msgstr ": कति जहाज छन्?"

#: gameboard.cc:301
msgid "Ruler: Select starting planet."
msgstr "रुलर: सुरुको ग्रह चयन गर्नुहोस् ।"

#: gameboard.cc:316
msgid ""
"The distance from Planet %1 to Planet %2 is %3 light years.\n"
"A ship leaving this turn will arrive on turn %4"
msgstr ""
"%1 ग्रह देखि %2 ग्रहको दुरि %3 प्रकाश वर्ष छ ।\n"
"यो मोडबाट छोडेको जहाज %4 मोडमा पुग्दछ ।"

#: gameboard.cc:322
msgid "Distance"
msgstr "दुरि"

#: gameboard.cc:327
msgid "Ruler: Select ending planet."
msgstr "रुलर: अन्तिम ग्रह चयन गर्नुहोस् ।"

#: gameboard.cc:339
msgid "Computer Player thinking..."
msgstr "कम्प्युटर खेलाडीले सोचिरहेको छ..."

#: gameboard.cc:434
msgid "Turn #: %1 of %2"
msgstr "घुमाउनुहोस् #: %2 को %1"

#: gameboard.cc:475
msgid "The mighty %1 has conquered the galaxy!"
msgstr "शक्तिशाली %1 ले आकाशगङ्गामाथि विजय प्राप्त गरेको छ !"

#: gameboard.cc:476
msgid "Game Over"
msgstr "खेल समाप्त भयो"

#: gameboard.cc:631
msgid "The once mighty empire of %1 has fallen in ruins."
msgstr "एकपटक %1 शक्तिशाली अधिपत्यको  पतन भयो ।"

#: gameboard.cc:641
msgid "The fallen empire of %1 has staggered back to life."
msgstr "%1 को पतन अधिपत्य पुन: जीवनमा फर्कन सन्देह गर्यो ।"

#: gameboard.cc:662
msgid "Reinforcements (%1 ships) have arrived for planet %2."
msgstr "%2 ग्रहका लागि थप शक्ति (%1 जहाज) आई पुगेको छ ।"

#: gameboard.cc:706
msgid "Planet %2 has held against an attack from %1."
msgstr "%2 ग्रहले %1 बाट भएको आक्रमण रक्षा गरेको छ ।"

#: gameboard.cc:715
msgid "Planet %2 has fallen to %1."
msgstr "%2 ग्रह %1 मा खसेको छ ।"

#: gameboard.cc:777
msgid "Do you wish to retire this game?"
msgstr "के तपाईँले यो खेलबाट निस्कन चाहनुहुन्छ?"

#: gameboard.cc:778
msgid "End Game"
msgstr "खेल अन्त्य"

#: gameboard.cc:790
msgid "Final Standings"
msgstr "अन्तिम अस्तित्व"

#: gameboard.cc:960
msgid "Not enough ships to send."
msgstr "पठाउनका लागि पर्याप्त जहाज छैन ।"

#: gameboard.cc:982
msgid "Current Standings"
msgstr "हालको अस्तित्व"

#: gameenddlg.cc:15
msgid "Out of Turns"
msgstr "चालबाट बाहिर"

#: gameenddlg.cc:22
msgid ""
"This is the last turn.\n"
"Do you wish to add extra turns?"
msgstr ""
"यो अन्तिम चाल हो ।\n"
"तपाईँले अतिरिक्त चाल थप्न चाहनुहुन्छ?"

#: gameenddlg.cc:28
msgid "&Add Turns"
msgstr "चाल थप्नुहोस्"

#: gameenddlg.cc:29
msgid "Add the specified number of turns to the game and continue playing."
msgstr "खेलमा मोडको निर्दिष्ट नम्बर थप्नुहोस् र खेल्न जारी राख्नुहोस् ।"

#: gameenddlg.cc:30
msgid "&Game Over"
msgstr "खेल समाप्त भयो"

#: gameenddlg.cc:31
msgid "Terminate the current game."
msgstr "हालको खेल बन्द गर्नुहोस् ।"

#: gameenddlg.cc:74
#, c-format
msgid "Extra turns: %1"
msgstr "अतिरिक्त चाल: %1"

#: mainwin.cc:26
msgid "Galactic Conquest"
msgstr "गाल्याक्टिक कन्क्वेष्ट"

#: mainwin.cc:47
msgid "&Measure Distance"
msgstr "दुरि मापन गर्नुहोस्"

#: mainwin.cc:49
msgid "&Show Standings"
msgstr "अस्तित्व देखाउनुहोस्"

#: mainwin.cc:51
msgid "&Fleet Overview"
msgstr "द्रुत समिक्षा "

#: newgamedlg.cc:30
msgid "Start New Game"
msgstr "नयाँ खेल सुरु गर्नुहोस्"

#: newgamedlg.cc:106 newgamedlg.cc:151
msgid "Human Player"
msgstr "मानिस खेलाडी"

