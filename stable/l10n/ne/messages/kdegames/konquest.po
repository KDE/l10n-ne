#, c-format
msgid ""
"_: Generated AI player name\n"
"Comp%1"
msgstr "Comp%1"

#: newgamedlg.cc:191
msgid "Computer Player"
msgstr "कम्प्युटर खेलाडी"

#: newgamedlg.cc:232
#, c-format
msgid "Number of &players: %1"
msgstr "खेलाडीको सङ्ख्या: %1"

#: newgamedlg.cc:233
#, c-format
msgid "Number of neutral p&lanets: %1"
msgstr "तटस्थ ग्रहको सङ्ख्या: %1"

#: newgamedlg.cc:234
#, c-format
msgid "Number of &turns: %1"
msgstr "मोडको सङ्ख्या: %1"

#: newgamedlg.cc:251
msgid "The game is much more fun when you add a human player!"
msgstr "तपाईँले मानिस खेलाडी थपे पछि यो खेल बढी रमाइलो हुन्छ!"

