#: toplevel.cpp:262
msgid "Save &as Picture..."
msgstr "तस्विरका रुपमा बचत गर्नुहोस्..."

#: toplevel.cpp:272
msgid "&No Sound"
msgstr "आवाज छैन"

#: toplevel.cpp:312
msgid "Could not load file."
msgstr "फाइल लोड गर्न सकेन ।"

#: toplevel.cpp:335 toplevel.cpp:372
msgid "Only saving to local files is currently supported."
msgstr "स्थानीय फाइलमा बचत भएका मात्र हाल समर्थित छन् ।"

#: toplevel.cpp:350 toplevel.cpp:402
msgid "Could not save file."
msgstr "फाइल बचत गर्न सकेन ।"

#: toplevel.cpp:360
msgid ""
"*.xpm|UNIX Pixmaps (*.xpm)\n"
"*.jpg|JPEG Compressed Files (*.jpg)\n"
"*.png|Next Generation Pictures (*.png)\n"
"*.bmp|Windows Bitmaps (*.bmp)\n"
"*|All Picture Formats"
msgstr ""
"*.xpm|यूनिक्स पिक्सम्याप (*.xpm)\n"
"*.jpg|जेपीईजी सङ्कुचित फाइल (*.jpg)\n"
"*.png|पछिल्लो युगका तस्विर (*.png)\n"
"*.bmp|विन्डोज बिटम्याप (*.bmp)\n"
"*|सबै तस्विर ढाँचा"

#: toplevel.cpp:396
msgid "Unknown picture format."
msgstr "अज्ञात तस्विर ढाँचा ।"

#: toplevel.cpp:411
#, c-format
msgid "Print %1"
msgstr "मुद्रण %1"

#: toplevel.cpp:416
msgid "Could not print picture."
msgstr "तस्विर मुद्रण गर्न सकेन ।"

#: toplevel.cpp:419
msgid "Picture successfully printed."
msgstr "तस्विर सफलतापूर्वक मुद्रण गरियो ।"

#: playground.cpp:504
msgid ""
"Fatal error:\n"
"Unable to load the pictures, aborting."
msgstr ""
"घातक त्रुटि:\n"
"तस्विर लोड गर्न असमर्थ, परित्याग गर्दैछ ।"

#: soundfactory.cpp:73
msgid "Error while loading the sound names."
msgstr "ध्वनि नाम लोड गर्दा त्रुटि ।"

