"Your emails"
msgstr "submanesh@gmail.com"

#: highscores.cpp:9
msgid "Level"
msgstr "स्तर"

#: kbounce.cpp:63
msgid "Level:"
msgstr "स्तर:"

#: kbounce.cpp:68
msgid "Score:"
msgstr "प्राप्ताङ्क:"

#: kbounce.cpp:75
msgid "Filled area:"
msgstr "भरिएको क्षेत्र:"

#: kbounce.cpp:80
msgid "Lives:"
msgstr "जीवित:"

#: kbounce.cpp:85
msgid "Time:"
msgstr "समय:"

#: kbounce.cpp:102
msgid "Press %1 to start a game!"
msgstr "खेल सुरु गर्न %1 थिच्नुहोस्!"

#: kbounce.cpp:135
msgid "&Select Background Folder..."
msgstr "पृष्ठभूमि फोल्डर चयन गर्नुहोस्..."

#: kbounce.cpp:138
msgid "Show &Backgrounds"
msgstr "पृष्ठभूमि देखाउनुहोस्"

#: kbounce.cpp:140
msgid "Hide &Backgrounds"
msgstr "पृष्ठभूमि लुकाउनुहोस्"

#: kbounce.cpp:144
msgid "&Play Sounds"
msgstr "ध्वनि बजाउनुहोस्"

#: kbounce.cpp:180
msgid "Do you really want to close the running game?"
msgstr "के तपाईँ वास्तवमै चलिरहेको खेल बन्द गर्न चाहनुहुन्छ?"

#: kbounce.cpp:200
msgid "Game paused."
msgstr "खेल पज गरियो ।"

#: kbounce.cpp:231
#, c-format
msgid "Game Over! Score: %1"
msgstr "खेल समाप्त! प्राप्ताङ्क: %1"

#: kbounce.cpp:232
msgid "Game over. Press <Space> for a new game"
msgstr "खेल समाप्त । नयाँ खेलका लागि <Space> थिच्नुहोस्"

#: kbounce.cpp:259
msgid "Select Background Image Folder"
msgstr "पृष्ठभूमि छवि फोल्डर चयन गर्नुहोस्"

#: kbounce.cpp:279
msgid "You may now turn on background images."
msgstr "तपाईँले अब पृष्ठभूमि छवि घुमाउनु पर्न सक्छ ।"

#: kbounce.cpp:335
msgid "Game suspended"
msgstr "खेल निलम्बन गरियो"

#: kbounce.cpp:463
#, c-format
msgid ""
"You have successfully cleared more than 75% of the board.\n"
msgstr ""
"तपाईँले सफलतापूर्वक बोर्डको 75% भन्दा बढी खाली गर्नुभयो ।\n"

#: kbounce.cpp:464
msgid ""
"%1 points: 15 points per remaining life\n"
msgstr ""
"%1 अङ्क: प्रत्येक बाँकी रहेको जीवनको १५ अङ्क\n"

#: kbounce.cpp:465
msgid ""
"%1 points: Bonus\n"
msgstr ""
"%1 अङ्क: लाभांश\n"

#: kbounce.cpp:466
msgid ""
"%1 points: Total score for this level\n"
msgstr ""
"%1 अङ्क: यो स्तरका लागि जम्मा प्राप्ताङ्क\n"

#: kbounce.cpp:467
msgid "On to level %1. Remember you get %2 lives this time!"
msgstr "%1 स्तरमा । यो समयमा तपाईँले %2 जीवन प्राप्त गरेको सम्झनुहोस्!"

#: main.cpp:38
msgid "KDE Bounce Ball Game"
msgstr "केडीई उफ्रिने बल खेल"

#: main.cpp:45
msgid "KBounce"
msgstr "केडीई उफ्रिने"

#: main.cpp:49
msgid "Original author"
msgstr "मौलिक लेखक"

#: main.cpp:51
msgid "Contributions"
msgstr "सहयोग"
