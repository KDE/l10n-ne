#: piece.cpp:20
msgid "Color #%1:"
msgstr "रङ #%1:"

#: field.cpp:17
msgid "Remaining blocks"
msgstr "बाँकी रोकावट"

#: field.cpp:20
msgid ""
"<qt>Display the number of remaining blocks.<br/>It turns <font "
"color=\"blue\">blue</font> if it is a highscore and <font "
"color=\"red\">red</font> if it is the best local score.</qt>"
msgstr ""
"<qt>बाँकी रोकावटको सङ्ख्या प्रर्दशन गर्नुहोस् ।<br/>यदि यो सबैभन्दा राम्रो प्राप्ताङ्क भएमा <font "
"color=\"blue\">निलो </font> हुन्छ र यदि उच्च प्राप्ताङ्क भएमा <font "
"color=\"red\">रातो</font> हुन्छ ।</qt>"

#: field.cpp:29
msgid "Elapsed time"
msgstr "व्यतीत समय"

#: main.cpp:16
msgid "Klickety"
msgstr "क्लिकेटी"

#: main.cpp:17
msgid "Klickety is an adaptation of the \"clickomania\" game"
msgstr "क्लिकेटी \"क्लिकोमेनिया\" खेलको रूपान्तरण हो ।"

#: main.cpp:19
msgid "Removed blocks"
msgstr "हटाइएको रोकावट"

#: main.cpp:45
msgid "Icons"
msgstr "प्रतिमा"

