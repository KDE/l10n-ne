#: mathapplet.cpp:67
msgid "Evaluate:"
msgstr "मूल्याङ्कन गर्नुहोस्:"

#: mathapplet.cpp:115
msgid "Use &Degrees"
msgstr "डिग्री प्रयोग गर्नुहोस्"

#: mathapplet.cpp:116
msgid "Use &Radians"
msgstr "रेडियन प्रयोग गर्नुहोस्"

#: mathapplet.cpp:206
msgid "< Eval"
msgstr "< Eval"

#: mathapplet.cpp:213
msgid "Eval >"
msgstr "Eval >"

#: mathapplet.cpp:258
msgid "You have to enter an expression to be evaluated first."
msgstr ""
"तपाईँले पहिले मूल्याङ्कन गर्नका लागि एउटा अभिव्यक्ति प्रविष्ट गर्नुपर्नेछ ।"

#: parser.cpp:658
msgid ""
"Parser error at position %1:\n"
"Syntax error"
msgstr ""
"%1 स्थितिमा पद वर्णक त्रुटि:\n"
"वाक्य संरचना त्रुटि"

#: parser.cpp:659 parser.cpp:663 parser.cpp:667 parser.cpp:671 parser.cpp:675
#: parser.cpp:679 parser.cpp:683 parser.cpp:687 parser.cpp:691 parser.cpp:694
#: parser.cpp:696
msgid "Math Expression Evaluator"
msgstr "गणित अभिव्यक्ति मूल्याङ्कनकर्ता"

#: parser.cpp:662
msgid ""
"Parser error at position %1:\n"
"Missing parenthesis"
msgstr ""
"%1 स्थितिमा पद वर्णक त्रुटि:\n"
"प्यारेनथेसिस हराइरहेको छ"

#: parser.cpp:666
msgid ""
"Parser error at position %1:\n"
"Function name unknown"
msgstr ""
"%1 स्थितिमा पद वर्णक त्रुटि:\n"
"प्रकार्य नाम अज्ञात"

#: parser.cpp:670
msgid ""
"Parser error at position %1:\n"
"Void function variable"
msgstr ""
"%1 स्थितिमा पद वर्णक त्रुटि:\n"
"खाली स्थान प्रकार्य चल"

#: parser.cpp:674
msgid ""
"Parser error at position %1:\n"
"Too many functions"
msgstr ""
"%1 स्थिति पद वर्णक त्रुटि:\n"
"अति धेरै प्रकार्य"

#: parser.cpp:678
msgid ""
"Parser error at position %1:\n"
"Token-memory overflow"
msgstr ""
"%1 स्थितिमा पद वर्णक त्रुटि:\n"
"टोकन स्मृति अधिप्रवाह"

#: parser.cpp:682
msgid ""
"Parser error at position %1:\n"
"Stack overflow"
msgstr ""
"%1 स्थितिमा पद वर्णक त्रुटि:\n"
"थाक अधिप्रवाह"

#: parser.cpp:686
msgid ""
"Parser error at position %1:\n"
"Name of function not free"
msgstr ""
"%1 स्थितिमा पद वर्णक त्रुटि:\n"
"प्रकार्यको नाम खाली छैन"

#: parser.cpp:690
msgid ""
"Parser error at position %1:\n"
"recursive function not allowed"
msgstr ""
"%1 स्थितिमा पद वर्णक त्रुटि:\n"
"पुनरावृत्तिक प्रकार्य अनुमति छैन"

#: parser.cpp:693
#, c-format
msgid "Could not find a defined constant at position %1"
msgstr "%1 स्थितिमा परिभाषित अचल फेला पार्न सकेन"

#: parser.cpp:696
msgid "Empty function"
msgstr "खाली प्रकार्य"
