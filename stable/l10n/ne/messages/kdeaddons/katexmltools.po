#: plugin_katexmltools.cpp:152
msgid "&Insert Element..."
msgstr "तत्व घुसाउनुहोस्..."

#: plugin_katexmltools.cpp:154
msgid "&Close Element"
msgstr "तत्व बन्द गर्नुहोस्"

#: plugin_katexmltools.cpp:156
msgid "Assign Meta &DTD..."
msgstr "मेटा डीटीडी मानाङ्कन गर्नुहोस्..."

#: plugin_katexmltools.cpp:462
msgid "Assign Meta DTD in XML Format"
msgstr "एक्सएमएल ढाँचामा मेटा डेटा मानाङ्कन गर्नुहोस्"

#: plugin_katexmltools.cpp:467
msgid ""
"The current file has been identified as a document of type \"%1\". The meta "
"DTD for this document type will now be loaded."
msgstr "हालको फाइल \"%1\" प्रकारको कागजातको रूपमा परिचित छ । यो कागजातका लागि मेटा डीटीडी अहिले डाउनलोड गरिनेछ ।"

#: plugin_katexmltools.cpp:470
msgid "Loading XML Meta DTD"
msgstr "एक्सएमएल मेटा डीटीडी लोड गर्दै"

#: plugin_katexmltools.cpp:505
msgid "The file '%1' could not be opened. The server returned an error."
msgstr "फाइल '%1' खोल्न सकेन । सर्भरले एउटा त्रुटि फर्कायो ।"

#: plugin_katexmltools.cpp:507 pseudo_dtd.cpp:50 pseudo_dtd.cpp:61
msgid "XML Plugin Error"
msgstr "एक्सएमएल प्लगइन त्रुटि"

#: plugin_katexmltools.cpp:1103
msgid "Insert XML Element"
msgstr "एक्सएमएल तत्व घुसाउनुहोस्"

#: plugin_katexmltools.cpp:1127
msgid ""
"Enter XML tag name and attributes (\"<\", \">\" and closing tag will be "
"supplied):"
msgstr "एक्सएमएल ट्याग नाम र विशेषताहरू प्रविष्ट गर्नुहोस् (\"<\", \">\" र बन्द गर्ने ट्याग पठाइनेछ):"

#: pseudo_dtd.cpp:48
msgid ""
"The file '%1' could not be parsed. Please check that the file is well-formed "
"XML."
msgstr "फाइल '%1' पद वर्णन गर्न सकेन । कृपया फाइल असल-ढाँचाबद्ध एक्सएमएल छ भनी जाँच गर्नुहोस् ।"

#: pseudo_dtd.cpp:56
msgid ""
"The file '%1' is not in the expected format. Please check that the file is "
"of this type:\n"
"-//Norman Walsh//DTD DTDParse V2.0//EN\n"
"You can produce such files with dtdparse. See the Kate Plugin documentation "
"for more information."
msgstr ""
"फाइल '%1' अपेक्षा गरिएको ढाँचामा छैन । कृपया त्यो फाइल यो ढाँचामा छ छैन जाँच गर्नुहोस्:\n"
"-//Norman Walsh//DTD DTDParse V2.0//EN\n"
"तपाइँ त्यस्तो फाइल dtdparse द्वारा उत्पादन गर्न सक्नुहुन्छ । अरू धेरै जानकारीका लागि केट प्लगइन मिसिलिकरण हेर्नुहोस् ।"

#: pseudo_dtd.cpp:71
msgid "Analyzing meta DTD..."
msgstr "मेटा डीटीडी विश्लेषण गर्दै..."

