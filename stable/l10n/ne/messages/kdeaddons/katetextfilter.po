#: plugin_katetextfilter.cpp:66
msgid "Filter Te&xt..."
msgstr "फिल्टर पाठ..."

#: plugin_katetextfilter.cpp:257
msgid ""
"You are not allowed to execute arbitrary external applications. If you want to "
"be able to do this, contact your system administrator."
msgstr ""
"तपाईँलाई स्वेच्छाचारी बाह्य अनुप्रयोग कार्यान्वयन गर्न अनुमति छैन । यदि तपाईँ "
"यो गर्न चाहनुहुन्छ भने, तपाईँको प्रणाली प्रशासकलाई सम्पर्क गर्नुहोस् ।"

#: plugin_katetextfilter.cpp:259
msgid "Access Restrictions"
msgstr "अवरोधहरू पहुँच गर्नुहोस्"

#: plugin_katetextfilter.cpp:268
msgid "Filter"
msgstr "फिल्टर"

#: plugin_katetextfilter.cpp:269
msgid "Enter command to pipe selected text through:"
msgstr "चयन गरिएका पाठ मार्फत पाइप गर्न आदेश प्रविष्ट गर्नुहोस्:"

#: plugin_katetextfilter.cpp:311
msgid ""
"<qt>"
"<p>Usage: <code>textfilter COMMAND</code></p>"
"<p>Replace the selection with the output of the specified shell command.</p>"
"</qt>"
msgstr ""
"<qt>"
"<p>उपयोग: <code>पाठ फिल्टर आदेश</code></p>"
"<p>निर्दिष्ट गरेको शेल आदेशको निर्गतसँग चयन प्रतिस्थापन गर्नुहोस् ।</p></qt>"

#: plugin_katetextfilter.cpp:320
msgid "You need to have a selection to use textfilter"
msgstr "तपाईँलाई पाठ फिल्टर प्रयोग गर्न चयनको आवश्यक पर्दछ"

#: plugin_katetextfilter.cpp:328
msgid "Usage: textfilter COMMAND"
msgstr "उपयोग: पाठ फिल्टर आदेश"
