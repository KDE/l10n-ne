#: dirfilterplugin.cpp:155
msgid "View F&ilter"
msgstr "फिल्टर हेर्नुहोस्"

#: dirfilterplugin.cpp:158
msgid "Allow to filter the currently displayed items by filetype."
msgstr "फिल्टर प्रकारद्वारा हालै प्रदर्शन गरिएको वस्तु फिल्टरलाई अनुमति दिनुहोस्"

#: dirfilterplugin.cpp:175
msgid "Clear Filter Field"
msgstr "फिल्टर फाँट खाली गर्नुहोस्"

#: dirfilterplugin.cpp:179
msgid "Clear filter field<p>Clears the content of the filter field."
msgstr "फिल्टर फाँट खाली गर्नुहोस्<p>फिल्टर फाँटको सामग्री खाली गर्दछ ।"

#: dirfilterplugin.cpp:195
msgid ""
"Enter here a text which an item in the view must contain anywhere to be "
"shown."
msgstr "यहाँ पाठ प्रविष्ट गर्नुहोस् जसमा एउटा वस्तुले जहाँ कही देखाउने समाविष्ट गर्दछ ।"

#: dirfilterplugin.cpp:199
msgid "Filter Field"
msgstr "फिल्टर फाँट"

#: dirfilterplugin.cpp:250
msgid "Only Show Items of Type"
msgstr "वस्तुको प्रकार मात्र देखाउनुहोस्"

#: dirfilterplugin.cpp:316
msgid "Use Multiple Filters"
msgstr "बहुविध फिल्टरहरु प्रयोग गर्नुहोस्"

#: dirfilterplugin.cpp:321
msgid "Show Count"
msgstr "गणना देखाउनुहोस्"

#: dirfilterplugin.cpp:325
msgid "Reset"
msgstr "रिसेट गर्नुहोस्"

