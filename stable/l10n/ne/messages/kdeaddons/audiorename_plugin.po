#: audio_plugin.cpp:76
msgid "An older file named '%1' already exists.\n"
msgstr "'%1' नाम गरिएको एउटा पुरानो फाइल पहिले नै अवस्थित छ ।\n"

#: audio_plugin.cpp:78
msgid "A similar file named '%1' already exists.\n"
msgstr "'%1' नाम गरिएको फाइलसँग मिल्ने फाइल पहिले नै अवस्थित छ ।\n"

#: audio_plugin.cpp:80
msgid "A newer file named '%1' already exists.\n"
msgstr "'%1' नाम गरिएको नयाँ फाइल पहिले नै अवस्थित छ ।\n"

#: audio_plugin.cpp:82
msgid "Source File"
msgstr "स्रोत फाइल"

#: audio_plugin.cpp:83
msgid "Existing File"
msgstr "अवस्थित फाइल"

#: audio_plugin.cpp:84
msgid "Would you like to replace the existing file with the one on the right?"
msgstr "तपाईँ अवस्थित फाइललाई दायाँ भएको एउटा फाइलसँग बदल्न चाहनुहुन्छ ?"

#: audiopreview.cpp:54
msgid ""
"This audio file isn't stored\n"
"on the local host.\n"
"Click on this label to load it.\n"
msgstr ""
"यो अडियो फाइल स्थानीय\n"
"होस्टमा भण्डारण गरिएको छैन ।\n"
"यसलाई लोड गर्न यो लेबुलमा क्लिक गर्नुहोस् ।\n"

#: audiopreview.cpp:60
msgid "Unable to load audio file"
msgstr "अडियो फाइल लोड गर्न असमर्थ"

#: audiopreview.cpp:92
msgid "Artist: %1\n"
msgstr "कलाकार: %1\n"

#: audiopreview.cpp:95
msgid "Title: %1\n"
msgstr "शीर्षक: %1\n"

#: audiopreview.cpp:98
msgid "Comment: %1\n"
msgstr "टिप्पणी: %1\n"

#: audiopreview.cpp:100
msgid ""
"_: Biterate: 160 kbits/s\n"
"Bitrate: %1 %2\n"
msgstr "बिट्रेट: %1 %2\n"

#: audiopreview.cpp:102
msgid "Sample rate: %1 %2\n"
msgstr "नमूना दर: %1 %2\n"

#: audiopreview.cpp:103
msgid "Length: "
msgstr "लम्बाइ: "

