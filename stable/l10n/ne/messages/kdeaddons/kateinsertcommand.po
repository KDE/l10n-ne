#: plugin_kateinsertcommand.cpp:86
msgid "Insert Command..."
msgstr "आदेश घुसाउनुहोस्..."

#: plugin_kateinsertcommand.cpp:113
msgid ""
"You are not allowed to execute arbitrary external applications. If you want to "
"be able to do this, contact your system administrator."
msgstr ""
"तपाईँलाई स्वेच्छाचारी बाह्य अनुप्रयोग कार्यान्वयन गर्न अनुमति छैन । यदि तपाईँ "
"यो गर्न चाहनुहुन्छ भने, तपाईँको प्रणाली प्रशासकलाई सम्पर्क गर्नुहोस् ।"

#: plugin_kateinsertcommand.cpp:113
msgid "Access Restrictions"
msgstr "अवरोधहरू पहुँच गर्नुहोस्"

#: plugin_kateinsertcommand.cpp:117
msgid "A process is currently being executed."
msgstr "प्रक्रिया हालै कार्यान्वयन गरिएको छ ।"

#: plugin_kateinsertcommand.cpp:204
msgid "Could not kill command."
msgstr "आदेश नष्ट गर्न सकेन ।"

#: plugin_kateinsertcommand.cpp:204
msgid "Kill Failed"
msgstr "नष्ट गर्न असफल भयो"

#: plugin_kateinsertcommand.cpp:211
msgid ""
"Executing command:\n"
"%1\n"
"\n"
"Press 'Cancel' to abort."
msgstr ""
"आदेश कार्यानवयन गर्दै:\n"
"%1\n"
"\n"
"परित्याग गर्न 'रद्द गर्नुहोस्' बटन थिच्नुहोस् ।"

#: plugin_kateinsertcommand.cpp:245
#, c-format
msgid "Command exited with status %1"
msgstr "आदेश %1 वस्तुस्थितिसँग निस्कियो"

#: plugin_kateinsertcommand.cpp:246
msgid "Oops!"
msgstr "उफ!"

#: plugin_kateinsertcommand.cpp:286 plugin_kateinsertcommand.h:73
msgid "Insert Command"
msgstr "आदेश घुसाउनुहोस्"

#: plugin_kateinsertcommand.cpp:293
msgid "Enter &command:"
msgstr "आदेश प्रविष्ट गर्नुहोस्:"

#: plugin_kateinsertcommand.cpp:305
msgid "Choose &working folder:"
msgstr "काम गरिरहेको फोल्डर रोज्नुहोस्:"

#: plugin_kateinsertcommand.cpp:315
msgid "Insert Std&Err messages"
msgstr "Std&Err सन्देशहरू घुसाउँनुहोस्"

#: plugin_kateinsertcommand.cpp:318
msgid "&Print command name"
msgstr "आदेश नाम मुद्रण गर्नुहोस्"

#: plugin_kateinsertcommand.cpp:323
msgid ""
"Enter the shell command, the output of which you want inserted into your "
"document. Feel free to use a pipe or two if you wish."
msgstr ""
"तपाईँले आफ्नो कागजातमा घुसाउनु चाहनुभएको निर्गत, शेल आदेश प्रविष्ट गर्नुहोस् । "
"पाइप प्रयोग गर्न सजिलो महशुस गर्नुहोस् वा चाहनुहुन्छ भने दुईवटा प्रयोग "
"गर्नुहोस् ।"

#: plugin_kateinsertcommand.cpp:326
msgid ""
"Sets the working folder of the command. The command executed is 'cd <dir> "
"&& <command>'"
msgstr ""
"आदेशको काम गर्ने फोल्डर सेट गर्दछ । कार्यान्वयन गरिएको आदेश 'cd <dir> "
"र <command>' हो"

#: plugin_kateinsertcommand.cpp:329
msgid ""
"Check this if you want the error output from <command> inserted as well.\n"
"Some commands, such as locate, print everything to STDERR"
msgstr ""
"यदि तपाईँ राम्रोसँग घुसाएको <command> बाट त्रुटि निर्गात चाहनुहुन्छ भने यो जाँच "
"गर्नुहोस् ।\n"
"STDERR मा केही आदेशहरू, जस्तै हरेक चीज मुद्रण, अवस्थित गर्नुहोस्"

#: plugin_kateinsertcommand.cpp:332
msgid ""
"If you check this, the command string will be printed followed by a newline "
"before the output."
msgstr ""
"यदि तपाईँले यो जाँच गर्नुभयो भने, आदेश स्ट्रिङ निर्गत अघि नयाँ रेखाद्वारा निम्न "
"तरीकामा मुद्रण गरिनेछ ।"

#: plugin_kateinsertcommand.cpp:379
msgid "Remember"
msgstr "सम्झनुहोस्"

#: plugin_kateinsertcommand.cpp:381
msgid "Co&mmands"
msgstr "आदेश"

#: plugin_kateinsertcommand.cpp:388
msgid "Start In"
msgstr "भित्र सुरु गर्नुहोस्"

#: plugin_kateinsertcommand.cpp:390
msgid "Application &working folder"
msgstr "अनुप्रयोग कार्य गर्ने फोल्डर"

#: plugin_kateinsertcommand.cpp:391
msgid "&Document folder"
msgstr "कागजात फोल्डर"

#: plugin_kateinsertcommand.cpp:392
msgid "&Latest used working folder"
msgstr "हालै प्रयोग गरिएको काम गर्ने फोल्डर"

#: plugin_kateinsertcommand.cpp:400
msgid ""
"Sets the number of commands to remember. The command history is saved over "
"sessions."
msgstr ""
"सम्झनका लागि आदेशहरूको सङ्ख्या सेट गर्दछ । आदेश इतिहास सत्रहरू माथि बचत गरिएको "
"छ ।"

#: plugin_kateinsertcommand.cpp:403
msgid ""
"<qt>"
"<p>Decides what is suggested as <em>working folder</em> for the command.</p>"
"<p><strong>Application Working Folder (default):</strong> "
"The folder from which you launched the application hosting the plugin, usually "
"your home folder.</p>"
"<p><strong>Document Folder:</strong> The folder of the document. Used only for "
"local documents.</p>"
"<p><strong>Latest Working Folder:</strong> The folder used last time you used "
"this plugin.</p></qt>"
msgstr ""
"<qt>"
"<p>आदेशका लागि <em>काम गर्ने फोल्डर</em> को रूपमा के सुझाव गरिएको छ निर्णय "
"गर्दछ ।</p>"
"<p><strong>अनुप्रयोग काम गर्ने फोल्डर (पूर्वनिर्धारित):</strong> "
"फोल्डर जहाँबाट तपाईँले प्लगइन होस्ट गर्ने अनुप्रयोग सुरु गर्नुभएको थियो, प्राय "
"गरेर तपाईँको गृह फोल्डर ।</p>"
"<p><strong>कागजात फोल्डर:</strong> कागजातको फोल्डर । स्थानीय कागजातहरूका लागि "
"मात्र प्रयोग गरियो ।</p>"
"<p><strong>हालै काम गरिरहेको फोल्डर:</strong> अन्तिम पटक प्रयोग गरिएको फोल्डरमा "
"तपाईँले यो प्लगइन प्रयोग गर्नुभयो ।</p></qt>"

#: plugin_kateinsertcommand.h:75
msgid "Configure Insert Command Plugin"
msgstr "घुसाउने आदेश प्लगइन कन्फिगर गर्नुहोस्"

#: plugin_kateinsertcommand.h:135
msgid "Please Wait"
msgstr "कृपया प्रतिक्षा गर्नुहोस्"
