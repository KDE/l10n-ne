#: filetemplates.cpp:135
msgid "Any File..."
msgstr "कुनै फाइल..."

#: filetemplates.cpp:139
msgid "&Use Recent"
msgstr "भर्खरैको प्रयोग गर्नुहोस्"

#: filetemplates.cpp:251
msgid "&Manage Templates..."
msgstr "टेम्प्लेट प्रबन्ध गर्नुहोस्..."

#: filetemplates.cpp:255
msgid "New From &Template"
msgstr "टेम्प्लेटबाट नयाँ"

#: filetemplates.cpp:353
msgid "Open as Template"
msgstr "टेम्प्लेटको रूपमा खोल्नुहोस्"

#: filetemplates.cpp:384
msgid ""
"<qt>Error opening the file"
"<br><strong>%1</strong>"
"<br>for reading. The document will not be created.</qt>"
msgstr ""
"<qt>पढ्नका लागि फाइल"
"<br><strong>%1</strong>"
"<br>खोल्दा त्रुटि । कागजात सिर्जना गरिने छैन ।</qt>"

#: filetemplates.cpp:385 filetemplates.cpp:979
msgid "Template Plugin"
msgstr "टेम्प्लेट प्लगइन"

#: filetemplates.cpp:462
#, c-format
msgid "Untitled %1"
msgstr "शीर्षक विहिन %1"

#: filetemplates.cpp:538
msgid "Manage File Templates"
msgstr "फाइल टेम्प्लेट प्रबन्ध गर्नुहोस्"

#: filetemplates.cpp:555
msgid "&Template:"
msgstr "टेम्प्लेट:"

#: filetemplates.cpp:560
msgid ""
"<p>This string is used as the template's name and is displayed, for example, in "
"the Template menu. It should describe the meaning of the template, for example "
"'HTML Document'.</p>"
msgstr ""
"<p> यो स्ट्रिङ टेम्प्लेटको नामको रूपमा प्रयोग गरियो र प्रदर्शन गरियो, उदाहरणका "
"लागि, टेम्प्लेट मेनुमा । यसले टेम्प्लेटको अर्थ वर्णन गर्दछ, जस्तै 'एचटीएमएल "
"कागजात' ।</p>"

#: filetemplates.cpp:565
msgid "Press to select or change the icon for this template"
msgstr "यो टेम्प्लेटका लागि प्रतिमा चयन गर्न वा परिवर्तन गर्न थिच्नुहोस्"

#: filetemplates.cpp:567
msgid "&Group:"
msgstr "समूह:"

#: filetemplates.cpp:571
msgid ""
"<p>The group is used for chosing a submenu for the plugin. If it is empty, "
"'Other' is used.</p>"
"<p>You can type any string to add a new group to your menu.</p>"
msgstr ""
"<p> समूह प्लगइनका लागि उपमेनु छनौट गर्न प्रयोग गरिन्छ । यदि यो खाली छ भने, "
"'अन्य' प्रयोग गरिन्छ ।</p>"
"<p> तपाईँले आफ्नो मेनुमा नयाँ समूह थप्न कुनै स्ट्रिङ टाइप गर्न सक्नुहुन्छ ।</p>"

#: filetemplates.cpp:575
msgid "Document &name:"
msgstr "कागजात नाम:"

#: filetemplates.cpp:578
msgid ""
"<p>This string will be used to set a name for the new document, to display in "
"the title bar and file list.</p>"
"<p>If the string contains '%N', that will be replaced with a number increasing "
"with each similarly named file.</p>"
"<p> For example, if the Document Name is 'New shellscript (%N).sh', the first "
"document will be named 'New shellscript (1).sh', the second 'New shellscipt "
"(2).sh', and so on.</p>"
msgstr ""
"<p>यो स्ट्रिङ नयाँ कागजातका लागि, शीर्षक पट्टी र फाइलसूचीमा प्रदर्शन गर्न, नाम "
"सेट गर्न प्रयोग गरिन्छ ।</p>"
"<p>यदि स्ट्रिङले '%N' समाविष्ट गर्दछ भने, त्यो उस्तै नामकरण गरिएको हरेक फाइलसँग "
"बढ्दो सङ्ख्यासँग प्रतिस्थापन गरिन्छ ।</p>"
"<p> उदाहरणका लागि, यदि कागजातको नाम 'नयाँ शेलस्क्रिप्ट (%N).sh' छ भने, पहिलो "
"कागजातको नाम 'नयाँ शेलस्क्रिप्ट (1).sh', दोस्रोको 'नयाँ शेलस्क्रिप्ट (2).sh', र "
"इत्यादि राखिनेछ ।</p>"

#: filetemplates.cpp:586
msgid "&Highlight:"
msgstr "हाइलाइट गर्नुहोस्:"

#: filetemplates.cpp:587
msgid "None"
msgstr "कुनै पनि होइन"

#: filetemplates.cpp:589
msgid ""
"<p>Select the highlight to use for the template. If 'None' is chosen, the "
"property will not be set.</p>"
msgstr ""
"<p> टेम्प्लेटका लागि प्रयोग गर्न हाइलाइट चयन गर्नुहोस् । यदि 'कुनै पनि होइन' "
"छनौट गर्नुभयो भने, गुण सेट गरिने छैन ।</p>"

#: filetemplates.cpp:592
msgid "&Description:"
msgstr "वर्णन:"

#: filetemplates.cpp:595
msgid ""
"<p>This string is used, for example, as context help for this template (such as "
"the 'whatsthis' help for the menu item.)</p>"
msgstr ""
"<p> यो स्ट्रिङ प्रयोग गरिएको छ, जस्तै यो टेम्प्लेटका लागि मद्दत प्रसङ्ग (जस्तै "
"मेनु वस्तुका लागि 'यो के हो' मद्दत ।)</p>"

#: filetemplates.cpp:599
msgid "&Author:"
msgstr "लेखक:"

#: filetemplates.cpp:602
msgid ""
"<p>You can set this if you want to share your template with other users.</p>"
"<p>the recommended form is like an Email address: 'Anders Lund "
"&lt;anders@alweb.dk&gt;'</p>"
msgstr ""
"<p> यदि तपाईँ आफ्नो टेम्प्लेट अन्य प्रयोगकर्तासँग साझेदार गर्न चाहनुहुन्छ भने "
"तपाईँले यो सेट गर्न सकनुहुन्छ ।</p>"
"<p> सिफारिश गरिएको फर्म यो इमेल ठेगाना जस्तो हो 'Anders Lund "
"&lt;anders@alweb.dk&gt;'</p>"

#: filetemplates.cpp:674
msgid ""
"<p>If you want to base this template on an existing file or template, select "
"the appropriate option below.</p>"
msgstr ""
"<p> यदि तपाईँ यो टेम्प्लेट एउटा अवस्थित फाइल वा टेम्प्लेटमा आधार बनाउनु "
"चाहनुहुन्छ भने, तल उपयुक्त विकल्प चयन गर्नुहोस् ।</p>"

#: filetemplates.cpp:681
msgid "Start with an &empty document"
msgstr "एउटा खाली कागजातसँग सुरु गर्नहोस्"

#: filetemplates.cpp:686
msgid "Use an existing file:"
msgstr "एउटा अवस्थित फाइल प्रयोग गर्नुहोस्:"

#: filetemplates.cpp:694
msgid "Use an existing template:"
msgstr "एउटा अवस्थित टेम्प्लेट प्रयोग गर्नुहोस्:"

#: filetemplates.cpp:724
msgid "Choose Template Origin"
msgstr "टेम्प्लेट उत्पत्ति छनौट गर्नुहोस्"

#: filetemplates.cpp:729
msgid "Edit Template Properties"
msgstr "टेम्प्लेट गुण सम्पादन गर्नुहोस्"

#: filetemplates.cpp:749
msgid ""
"<p>Choose a location for the template. If you store it in the template "
"directory, it will automatically be added to the template menu.</p>"
msgstr ""
"<p>टेम्प्लेटका लागि स्थान छनौट गर्नुहोस् । यदि तपाईँले यो टेम्प्लेट "
"डाइरेक्टरीमा भण्डारण गर्नुभयो भने, यो स्वचालित रूपमा टेम्प्लेट मेनुमा थपिनेछ "
"।</p>"

#: filetemplates.cpp:757
msgid "Template directory"
msgstr "टेम्प्लेट डाइरेक्टरी"

#: filetemplates.cpp:764
msgid "Template &file name:"
msgstr "टेम्प्लेट फाइल नाम:"

#: filetemplates.cpp:769
msgid "Custom location:"
msgstr "अनुकूल स्थान:"

#: filetemplates.cpp:783
msgid "Choose Location"
msgstr "स्थान रोज्नुहोस्"

#: filetemplates.cpp:792
msgid ""
"<p>You can replace certain strings in the text with template macros."
"<p>If any of the data below is incorrect or missing, edit the data in the KDE "
"email information."
msgstr ""
"<p>तपाईँले टेम्प्लेट म्याक्रोसद्वारा पाठमा निश्चित स्ट्रिङहरू प्रतिस्थापन गर्न "
"सक्नुहुन्छ ।"
"<p>यदि तलको डेटा कुनै गलत वा हराइरहेको छ भने, डेटा केडीई इमेल सूचनामा सम्पादन "
"गर्नुहोस् ।"

#: filetemplates.cpp:796
msgid "Replace full name '%1' with the '%{fullname}' macro"
msgstr "'%{fullname}' म्याक्रोसँग पूरा नाम '%1' प्रतिस्थापन गर्नुहोस्"

#: filetemplates.cpp:801
msgid "Replace email address '%1' with the '%email' macro"
msgstr "'%email' म्याक्रोसँग इमेल ठेगाना '%1' प्रतिस्थापन गर्नुहोस्"

#: filetemplates.cpp:808
msgid "Autoreplace Macros"
msgstr "म्याक्रोहरू स्वत: प्रतिस्थापन गर्नुहोस्"

#: filetemplates.cpp:815
msgid ""
"<p>The template will now be created and saved to the chosen location. To "
"position the cursor put a caret ('^') character where you want it in files "
"created from the template.</p>"
msgstr ""
"<p>टेम्प्लेट अहिले सिर्जना गरिनेछ र छनौट गरिएको स्थानमा बचत गरिनेछ । कर्सरलाई "
"स्थितिमा राख्न क्यारेट ('^') क्यारेक्टर राख्नुहोस् जहाँ तपाईँ यसलाई "
"टेम्प्लेटबाट सिर्जना भएको फाइलमा राख्न चाहनुहुन्छ ।</p>"

#: filetemplates.cpp:821
msgid "Open the template for editing"
msgstr "सम्पादनका लागि टेम्प्लेट खोल्नुहोस्"

#: filetemplates.cpp:827
msgid "Create Template"
msgstr "टेम्प्लेट सिर्जना गर्नुहोस्"

#: filetemplates.cpp:922
msgid ""
"<p>The file "
"<br><strong>'%1'</strong>"
"<br> already exists; if you do not want to overwrite it, change the template "
"file name to something else."
msgstr ""
"<p>फाइल "
"<br><strong>'%1'</strong>"
"<br> पहिल्यै अवस्थित छ; यदि तपाईँ यसलाई अधिलेखन गर्न चाहनुहुन्न भने, केही गरेर "
"भएपनि टेम्प्लेट फाइल नाम परिवर्तन गर्नुहोस् ।"

#: filetemplates.cpp:925
msgid "File Exists"
msgstr "फाइल अवस्थित छ"

#: filetemplates.cpp:925
msgid "Overwrite"
msgstr "अधिलेखन गर्नुहोस्"

#: filetemplates.cpp:977
msgid ""
"<qt>Error opening the file"
"<br><strong>%1</strong>"
"<br>for reading. The document will not be created</qt>"
msgstr ""
"<qt>पढ्नका लागि"
"<br><strong>%1</strong>"
"<br>फाइल खोल्दा त्रुटि । कागजात सिर्जना गरिने छैन</qt>"

#: filetemplates.cpp:1056
msgid ""
"Unable to save the template to '%1'.\n"
"\n"
"The template will be opened, so you can save it from the editor."
msgstr ""
"'%1' मा टेम्प्लेट बचत गर्न असक्षम भयो ।\n"
"\n"
"टेम्प्लेट खोलिनेछ, त्यसैले तपाईँले सम्पादकबाट यसलाई बचत गर्न सक्नुहुन्छ ।"

#: filetemplates.cpp:1058
msgid "Save Failed"
msgstr "बचत असफल भयो"

#: filetemplates.cpp:1108
msgid "Template"
msgstr "टेम्प्लेट"

#: filetemplates.cpp:1112
msgid "New..."
msgstr "नयाँ..."

#: filetemplates.cpp:1116
msgid "Edit..."
msgstr "सम्पादन गर्नुहोस्..."

#: filetemplates.cpp:1124
msgid "Upload..."
msgstr "अपलोड गर्नुहोस्..."

#: filetemplates.cpp:1128
msgid "Download..."
msgstr "डाउनलोड गर्नुहोस्..."
