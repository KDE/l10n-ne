#: main.cpp:50
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"KIO Exec - टाढाका फाइलहरू खोल्दछ, परिमार्जनहरू निगरानि गर्दछ, अपलोडका लागि "
"सोध्दछ"

#: main.cpp:54
msgid "Treat URLs as local files and delete them afterwards"
msgstr ""
"URL हरूलाई स्थानिय फाइलहरको रूपमा व्यवहार गर्नुहोस् र तिनिहरूलाई त्यसपछी "
"मेट्नुहोस्"

#: main.cpp:55
msgid "Suggested file name for the downloaded file"
msgstr ""

#: main.cpp:56
msgid "Command to execute"
msgstr "कार्यान्वयन गर्ने आदेश"

#: main.cpp:57
msgid "URL(s) or local file(s) used for 'command'"
msgstr "'आदेश' का लागि URL(हरू) वा स्थानिय फाइल(हरू) प्रयोग गरिन्छ"

#: main.cpp:73
msgid ""
"'command' expected.\n"
msgstr ""
"'आदेश' अपेक्षित \n"

#: main.cpp:102
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"URL %1\n"
"विकृत छ"

#: main.cpp:104
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"--टेम्पफाइल स्वीचसँग टाढाको URL %1\n"
"अनुमती प्राप्त छैन"

#: main.cpp:237
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"मानिएको अस्थाई फाइल\n"
"%1\n"
"परिमर्जित गरिएको छ ।\n"
"तपाईँ अझै यसलाई मेट्न चाहनुहुन्छ ?"

#: main.cpp:238 main.cpp:245
msgid "File Changed"
msgstr "फाइल परिवर्तन गरियो"

#: main.cpp:238
msgid "Do Not Delete"
msgstr "नमेट्नुहोस्"

#: main.cpp:244
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"फाइल\n"
"%1\n"
"परिमार्जन गरिएको छ ।\n"
"के तपाईँ परिवर्तनहरू अपलोड गर्न चाहनुहन्छ ?"

#: main.cpp:245
msgid "Upload"
msgstr "अपलोड"

#: main.cpp:245
msgid "Do Not Upload"
msgstr "अपलोड नगर्नुहोस्"

