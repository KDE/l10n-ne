msgstr ""
"तपाईँले अद्यावधिक गर्न चाहनुभएको वाक्य संरचना हाइलाइटिङ फाइलहरू चयन गर्नुहोस्:"

#: part/katedialogs.cpp:1448
msgid "Installed"
msgstr "स्थापित"

#: part/katedialogs.cpp:1449
msgid "Latest"
