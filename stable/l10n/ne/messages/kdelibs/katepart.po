msgstr "तपाईँको खोजी शर्तको एउटा घटना फेला पर्यो । तपाईँ के गर्न चाहनुहुन्छ ?"

#: part/katesearch.cpp:814
msgid "Usage: find[:[bcersw]] PATTERN"
msgstr "उपयोग: फेला पार्नुहोस्[:[bcersw]] PATTERN"

#: part/katesearch.cpp:826
msgid "Usage: ifind[:[bcrs]] PATTERN"
msgstr "उपयोग: ifind[:[bcrs]] PATTERN"

#: part/katesearch.cpp:880
msgid "Usage: replace[:[bceprsw]] PATTERN [REPLACEMENT]"
msgstr "उपयोग: बदल्नुहोस् [:[bceprsw]] PATTERN [REPLACEMENT]"

#: part/katesearch.cpp:914
msgid "<p>Usage: <code>find[:bcersw] PATTERN</code></p>"
msgstr "<p>उपयोग: <code>फेला पार्नुहोस् [:bcersw] PATTERN</code></p>"

#: part/katesearch.cpp:917
msgid ""
"<p>Usage: <code>ifind:[:bcrs] PATTERN</code>"
"<br>ifind does incremental or 'as-you-type' search</p>"
msgstr ""
"<p>उपयोग: <code>ifind:[:bcrs] PATTERN</code>"
"<br>ifind ले बढोत्तरित वा 'तपाईँले टाइप गर्नुभएको' खोजी गर्दछ</p>"

#: part/katesearch.cpp:921
msgid "<p>Usage: <code>replace[:bceprsw] PATTERN REPLACEMENT</code></p>"
msgstr "<p>उपयोग: <code>बदल्नुहोस् [:bceprsw] PATTERN REPLACEMENT</code></p>"

#: part/katesearch.cpp:924
msgid ""
"<h4><caption>Options</h4>"
"<p><b>b</b> - Search backward"
"<br><b>c</b> - Search from cursor"
"<br><b>r</b> - Pattern is a regular expression"
"<br><b>s</b> - Case sensitive search"
msgstr ""
"<h4><caption>विकल्प</h4>"
"<p><b>b</b> - पछिल्तिर खोज्नुहोस् "
"<br><b>c</b> - कर्सरबाट खोज्नुहोस् "
"<br><b>r</b> - बान्की नियमित अभिव्यक्ति हो"
"<br><b>s</b> - केस सम्वेदनशील खोजी"

#: part/katesearch.cpp:933
msgid ""
"<br><b>e</b> - Search in selected text only"
"<br><b>w</b> - Search whole words only"
msgstr ""
"<br><b>e</b> -चयन गरिएका पाठमा मात्र खोजी गर्नुहोस्"
