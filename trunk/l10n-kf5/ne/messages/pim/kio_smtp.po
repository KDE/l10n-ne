#: command.cpp:400
#, kde-format
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"%1"
msgstr ""
"प्रमाणीकरण असफल\n"
"पासवर्ड गलत भएको हुन सक्दछ\n"
"%1"

#: command.cpp:557
msgid "Could not read data from application."
msgstr "अनुप्रयोगबाट डाटा पढ्न सकेन ।"

#: command.cpp:575
#, kde-format
msgid ""
"The message content was not accepted.\n"
"%1"
msgstr ""
"सन्देश सामग्री अस्वीकार गरियो ।\n"
"%1"

#: response.cpp:113
#, kde-format
msgid ""
"The server responded:\n"
"%1"
msgstr ""
"सर्भरले प्रतिक्रिया दियो:\n"
"%1"

#: response.cpp:115
#, kde-format
msgid "The server responded: \"%1\""
msgstr "सर्भरले प्रतिक्रिया दियो: \"%1\""

#: response.cpp:118
msgid "This is a temporary failure. You may try again later."
msgstr "यो अस्थायी असफलता हो । तपाईँ पुन: प्रयास गर्न सक्नुहुन्छ ।"

#: smtp.cpp:148
msgid "The application sent an invalid request."
msgstr "अनुप्रयोगले एउटा अवैध अनुरोध पठायो ।"

#: smtp.cpp:210
msgid "The sender address is missing."
msgstr "प्रेषक ठेगाना छुटेको छ ।"

#: smtp.cpp:217
#, kde-format
msgid "SMTPProtocol::smtp_open failed (%1)"
msgstr "SMTP प्रोटोकल::smtp_open असफल भयो (%1)"

#: smtp.cpp:225
#, fuzzy, kde-format
#| msgid ""
#| "Your server does not support sending of 8-bit messages.\n"
#| "Please use base64 or quoted-printable encoding."
msgid ""
"Your server (%1) does not support sending of 8-bit messages.\n"
"Please use base64 or quoted-printable encoding."
msgstr ""
"तपाईँको सर्भरले ८-बिट सन्देश पठाउन समर्थन गर्दैन ।\n"
"कृपया आधार६४ वा निष्कर्षण गरिएको-मुद्रणयोग्य सङ्केतन प्रयोग गर्नुहोस् ।"

#: smtp.cpp:275
msgid "Writing to socket failed."
msgstr "सकेटमा लेख्न असफल भयो ।"

#: smtp.cpp:315
#, kde-format
msgid "Invalid SMTP response (%1) received."
msgstr "अवैध SMTP प्रतिक्रिया (%1) प्राप्त भयो ।"

#: smtp.cpp:544
#, fuzzy, kde-format
#| msgid ""
#| "The server did not accept the connection.\n"
#| "%1"
msgid ""
"The server (%1) did not accept the connection.\n"
"%2"
msgstr ""
"सर्भरले जडान स्वीकार गरेन ।\n"
"%1"

#: smtp.cpp:610
msgid "Username and password for your SMTP account:"
msgstr "तपाईँको SMTP खाताका लागि प्रयोगकर्ता नाम र पासवर्ड:"

#: transactionstate.cpp:52
#, kde-format
msgid ""
"The server did not accept a blank sender address.\n"
"%1"
msgstr ""
"सर्भरले खाली प्रेषक ठेगाना स्वीकार गरेन ।\n"
"%1"

#: transactionstate.cpp:55
#, kde-format
msgid ""
"The server did not accept the sender address \"%1\".\n"
"%2"
msgstr ""
"सर्भरले \"%1\" प्रेषक ठेगाना स्वीकार गरेन ।\n"
"%2"

#: transactionstate.cpp:114
#, kde-format
msgid ""
"Message sending failed since the following recipients were rejected by the "
"server:\n"
"%1"
msgstr ""
"सर्भरले निम्न प्रापकहरू अस्वीकार गरेकोले सन्देश पठाउन असफल भयो:\n"
"%1"

#: transactionstate.cpp:119
#, kde-format
msgid ""
"The attempt to start sending the message content failed.\n"
"%1"
msgstr ""
"सन्देश सामग्री पठाउन सुरु गर्ने प्रयास असफल भयो ।\n"
"%1"

#: transactionstate.cpp:124
msgid "Unhandled error condition. Please send a bug report."
msgstr "ह्यान्डल नगरिएको त्रुटि स्थिति । कृपया बग प्रतिवेदन पठाउनुहोस् ।"

#~ msgid "Authentication support is not compiled into kio_smtp."
#~ msgstr "kio_smtp मा प्रमाणीकरण समर्थन कम्पाइल गरिएन ।"
