msgid "Text excerpt showing the unknown word in its context."
msgstr "पाठ उद्धरणले यसको प्रसङ्गमा अज्ञात शब्द देखाएकोछ ।"

#. i18n: tag string
#. i18n: file ./kdeui/sonnet/sonnetui.ui line 88
#. i18n: tag string
#. i18n: file ./kde3support/kdeui/k3spellui.ui line 82
#: rc.cpp:124 rc.cpp:784
msgid ""
"<qt>\n"
"<p>Here you can see a text excerpt showing the unknown word in its context. "
"If this information is not sufficient to choose the best replacement for the "
"unknown word, you can click on the document you are proofing, read a larger "
"part of the text and then return here to continue proofing.</p>\n"
"</qt>"
msgstr ""
"<qt>\n"
"<p>तपाईँले यहाँ यसको प्रसङ्गमा अज्ञात शब्द देखाउने पाठ उद्धरण हेर्न सक्नुहुन्छ । यदि यो "
"जानकारी अज्ञात शब्दका लागि उत्तम प्रतिस्थापन रोज्ने पर्याप्त छैन भने, तपाईँले प्रमाणीकरण "
"गर्दै गरेको कागजातमा क्लिक गर्न सक्नुहुन्छ, पाठको ठूलो भाग पढ्नुहोस् र त्यसपछि प्रमाणिकर "
"जारी राख्न यहाँ फर्कनुहोस् ।</p>\n"
"</qt>"

