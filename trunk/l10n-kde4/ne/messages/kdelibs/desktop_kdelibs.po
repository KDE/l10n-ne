#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:18
msgctxt "Name"
msgid "Insert File"
msgstr "फाइल घुसाउँनुहोस्"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:64
msgctxt "Comment"
