#: docwordcompletion.cpp:325
msgid "Shell Completion"
msgstr "शेल समाप्ति"

#: docwordcompletion.cpp:332
msgid "Reuse Word Above"
msgstr "माथि शब्द पुन: प्रयोग गर्नुहोस्"

#: docwordcompletion.cpp:337
msgid "Reuse Word Below"
