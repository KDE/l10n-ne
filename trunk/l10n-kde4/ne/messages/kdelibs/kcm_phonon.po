msgid "Matthias Kretz"
msgstr "माथियस क्रेज"

#: main.cpp:51
msgid "Device Preference"
msgstr "यन्त्र प्राथमिकता"

#: main.cpp:53
msgid "Backend"
msgstr "ब्याकइन्ड"

#. i18n: tag string
#. i18n: file backendselection.ui line 39
#. i18n: tag string
#. i18n: file backendselection.ui line 42
#: rc.cpp:3 rc.cpp:6
msgid ""
"A list of Phonon Backends found on your system.  The order here determines "
"the order Phonon will use them in."
msgstr ""
"फोनोन ब्याकइन्डको सूची तपाईँको प्रणालीमा फेला पर्यो । यहाँको क्रमले फोनोनले प्रयोग गर्ने "
"क्रमलाई निर्धारण गर्दछ ।"

#. i18n: tag string
#. i18n: file backendselection.ui line 58
#. i18n: tag string
#. i18n: file outputdevicechoice.ui line 130
#: rc.cpp:9 rc.cpp:40
msgid "prefer"
msgstr "रूचाउनुहोस्"

#. i18n: tag string
#. i18n: file backendselection.ui line 71
#. i18n: tag string
#. i18n: file outputdevicechoice.ui line 101
#: rc.cpp:12 rc.cpp:31
msgid "defer"
msgstr "रूचिबाट हटाउनुहोस्"

#. i18n: tag string
#. i18n: file outputdevicechoice.ui line 23
#. i18n: tag string
#. i18n: file outputdevicechoice.ui line 26
#: rc.cpp:15 rc.cpp:18
msgid ""
"Various categories of outputs.  For each category you may choose what device "
"you wish to output to."
msgstr ""
"निर्गातहरूको विभिन्न कोटिहरू । हरेक कोटिका लागि तपाईँले निर्गात गर्न चाहनुभएको यन्त्र "
"रोज्न सक्नुहुन्छ ।"

#. i18n: tag string
#. i18n: file outputdevicechoice.ui line 54
#: rc.cpp:21
msgid ""
"Audio Outputs found on your system.  Choose the device that you wish sound "
"to come out of."
msgstr ""
"अडियो निर्गात तपाईँको प्रणालीमा फेला पर्यो । तपाईँले राम्रोसँग ध्वनि बाहिर आउने यन्त्र "
"रोज्नुहोस् ।"

#. i18n: tag string
#. i18n: file outputdevicechoice.ui line 58
#: rc.cpp:24
msgid ""
"The order determines the preference of the output devices. If for some "
"reason the first device cannot be used Phonon will try to use the second, "
"and\n"
"so on."
msgstr ""
"क्रमले निर्गात यन्त्रको प्राथमिकतालाई निर्धारण गर्दछ । यदि केही भएर पहिलो यन्त्र प्रयोग "
"गर्न सकिएन भने फोनोनले दोस्रो र वा अन्य प्रयोग गर्न प्रयास\n"
"गर्नेछ ।"

#. i18n: tag string
#. i18n: file outputdevicechoice.ui line 98
#: rc.cpp:28
msgid "no preference for the selected device"
msgstr "चयन गरिएका यन्त्रका लागि कुनै प्राथमिकता छैन"

#. i18n: tag string
#. i18n: file outputdevicechoice.ui line 114
#: rc.cpp:34
msgid "remove"
msgstr "हटाउनुहोस्"

#. i18n: tag string
#. i18n: file outputdevicechoice.ui line 127
#: rc.cpp:37
msgid "prefer the selected device"
msgstr "चयन गरिएका यन्त्र रूचाउनुहोस्"

