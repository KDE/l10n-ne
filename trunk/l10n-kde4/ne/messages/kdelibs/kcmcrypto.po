#: crypto.cpp:737
msgid "Accept for email signing"
msgstr "इमेल साइनिङका लागि स्वीकार गर्नुहोस्"

#: crypto.cpp:738
msgid "Accept for code signing"
msgstr "सङ्केत साइनिङका लागि स्वीकार गर्नुहोस्"

#: crypto.cpp:772
msgid "Warn on &self-signed certificates or unknown CA's"
