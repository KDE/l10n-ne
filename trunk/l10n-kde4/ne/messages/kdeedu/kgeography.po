msgid "E&xplore Map"
msgstr "मानचित्र खोजी गर्नुहोस्"

#: kgeography.cpp:61
msgid ""
"In this section left click on any part of the map to learn about the "
"divisions"
msgstr "यो सेक्सनमा भागका बारेमा सिक्नका लागि मानचित्रको कुनै भागमा बायाँ क्लिक गर्नुहोस्"

