#: klettres.cpp:151
msgid ""
"The file sounds.xml was not found in\n"
"$KDEDIR/share/apps/klettres/\n"
"\n"
"Please install this file and start KLettres again.\n"
"\n"
msgstr ""
"फाइलको sounds.xml \n"
"$KDEDIR/share/apps/klettres/ मा फेला परेन ।\n"
"\n"
"कृपया यो फाइल स्थापना गरेर केडीई अक्षर फेरि सुरु गर्नुहोस् ।\n"
"\n"

#: klettres.cpp:173
msgid "New Sound"
msgstr "नयाँ ध्वनि"

