#. i18n: tag string
#. i18n: file generalui.ui line 53
#: rc.cpp:53
msgid ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /></head><body style=\" "
"white-space: pre-wrap; font-family:Sans Serif; font-size:9pt; font-"
"weight:400; font-style:normal; text-decoration:none;\"><p style=\" margin-"
"top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-"
"indent:0; text-indent:0px;\">If this box is checked, you will have some "
"sounds played for each new game and when you win a game. If this is not "
"checked, there will be no sound in KHangMan.</p><p style=\" margin-top:0px; "
"margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; "
"text-indent:0px;\">Default is no sound.</p></body></html>"
msgstr ""
"<html><head><meta name=\"qrichtext\" content=\"1\" /></head><body style=\" "
"white-space: pre-wrap; font-family:Sans Serif; font-size:9pt; font-"
"weight:400; font-style:normal; text-decoration:none;\"><p style=\" margin-"
"top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-"
"indent:0; text-indent:0px;\">यदि यो बाकस जाँच गरिएमा, तपाईँले खेल जित्दा हरेक नयाँ "
"खेलका लागि तपाईँले केही ध्वनि बजाउनुपर्नेछ । यो यो जाँच नगरिएमा, त्यहाँ केडीई "
"ह्याङ्गम्यानमा कुनै ध्वनि हुने छैन ।</p><p style=\" margin-top:0px; margin-"
"bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-"
"indent:0px;\">पूर्वनिर्धारितमा कुनै ध्वनि छैन ।</p></body></html>"

