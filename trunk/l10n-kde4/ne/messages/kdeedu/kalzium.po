#~ "(1.60217733 &#177; 0.00000049)e-19 C को ऋणात्मक चार्जको मेससँग सबएटोमिक अणु "
#~ "हो \n"
#~ "\t\t"

#~ msgid ""
#~ "The proton is a subatomic particle with a mass of m[sub]e[/sub]="
#~ "(1.6726231 &#177; 0.0000010) 10[sup]-27[/sup] kg and a positive charge of "
#~ "[i]e[/i]=(1.60217733 &#177; 0.00000049) 10[sup]-19[/sup] C which occurs "
#~ "in the nucleus of an atom."
#~ msgstr ""
#~ "प्रोटोन m[sub]e[/sub]=(1.6726231 &#177; 0.0000010) 10[sup]-27[/sup] kg र "
#~ "एटमको न्यूक्लेसमा हुने[i]e[/i]=(1.60217733 &#177; 0.00000049) 10[sup]-19[/sup] "
#~ "C को धनात्मक चार्जको मेससँग सबएटोमिक अणु हो ।"

#~ msgid ""
#~ "The neutron is a subatomic particle with a mass of m[sub]e[/sub]="
#~ "(1.6749286 &#177; 0.0000010) 10[sup]-27[/sup] kg which occurs in the "
#~ "nucleus of an atom."
#~ msgstr ""
#~ "न्यूट्रोन एटोमको न्यक्लिसमा हुने m[sub]e[/sub]=(1.6749286 &#177; 0.0000010) 10"
