#: main.cpp:1198
msgid "networking: is enabled"
msgstr "नेटवर्किङ: सक्षम पारिएको छ"

#: main.cpp:1200
msgid "networking: is not enabled"
msgstr "नेटवर्किङ: सक्षम पारिएको छैन"

#: main.cpp:1207
msgid "wireless: is enabled"
msgstr "वायरलेस: सक्षम परिएको छ"

#: main.cpp:1209
msgid "wireless: is not enabled"
msgstr "वायरलेस: सक्षम पारिएको छैन"

#: main.cpp:1559
#, qt-format
msgid "Progress: %1%"
msgstr "प्रगति: %1%"

#: main.cpp:1564
#, qt-format
msgid "Info: %1"
msgstr "सूचना: %1"
