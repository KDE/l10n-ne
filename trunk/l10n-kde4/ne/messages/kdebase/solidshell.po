#: main.cpp:59
msgid "solidshell"
msgstr "सोलिड सेल"

#: main.cpp:61
msgid ""
"KDE tool for querying and controlling your hardware from the command line"
msgstr "आदेश लाइनबाट तपाईँको हार्डवेयर क्वेरी गर्ने र नियन्त्रण गर्ने केडीई उपकरण"

#: main.cpp:280
msgid "Syntax Error: Not enough arguments"
msgstr "वाक्य संरचना त्रुटि: पर्याप्त तर्क छैन"

#: main.cpp:286
msgid "Syntax Error: Too many arguments"
msgstr "वाक्य संरचना त्रुटि: अति धेरै तर्क"

#: main.cpp:298
msgid "Show available commands by domains"
msgstr "डोमेनद्वारा उपलब्ध आदेश देखाउनुहोस्"

#: main.cpp:300
msgid "Domain (see --commands)"
msgstr "डोमेन (--आदेश हेर्नुहोस्)"

#: main.cpp:302
msgid "Command (see --commands)"
msgstr "आदेश (--आदेश हेर्नुहोस्)"

#: main.cpp:304
msgid "Arguments for command"
msgstr "आदेशका लागि तर्क"

#: main.cpp:316
msgid "Syntax:"
msgstr "वाक्य संरचना:"

#: main.cpp:319
msgid ""
"             # List the hardware available in the system.\n"
"             # - If the 'nonportableinfo' option is specified, the device\n"
"             # properties are listed (be careful, in this case property "
"names\n"
"             # are backend dependent),\n"
"             # - If the 'details' option is specified, the device "
"interfaces\n"
"             # and the corresponding properties are listed in a platform\n"
"             # neutral fashion,\n"
"             # - Otherwise only device UDIs are listed.\n"
msgstr ""
"             # प्रणालीमा उपलब्ध हार्डवेयरको सूची ।\n"
"             # - यदि 'nonportableinfo' विकल्प निर्दिष्ट गरिएको भएमा, यन्त्र\n"
"             # गुण सूचीबद्ध गरिन्छ (सावधान हुनुहोस्, यस्तो प्रकारकोगुणनाम\n"
"             # ब्याकइन्डमा निर्भर हुन्छन्) ।\n"
"             # - यदि 'विवरण' विकल्प निर्दिष्ट गरिएको भएमा, यन्त्रइन्टरफेस\n"
"             # र सङ्गत गुणप्लेटफर्ममा सूचीबद्ध गरिन्छ\n"
"             # तटस्थ फेसन,\n"
"             # - अन्यथा यन्त्र UDIs सूचीबद्ध गरिन्छ ।\n"

#: main.cpp:329
msgid ""
"             # Display all the interfaces and properties of the device\n"
"             # corresponding to 'udi' in a platform neutral fashion.\n"
msgstr ""
"             # यन्त्रका सबै इन्टरफेस र गुण प्रदर्शन गर्नुहोस्\n"
"             # प्लेटफर्म तटस्थ फेसनको 'udi' सँग सङ्गत हुन्छ ।\n"

#: main.cpp:333
msgid ""
"             # Display all the properties of the device corresponding to "
"'udi'\n"
"             # (be careful, in this case property names are backend "
"dependent).\n"
msgstr ""
"             # 'udi' सँग सङ्गत यन्त्रकासबै गुण प्रदर्शन गर्नुहोस्\n"
"             # (सावधान हुनुहोस्, यस्तो अवस्थामा गुण नाम ब्याकइन्डमा निर्भर हुन्छन्) ।\n"

#: main.cpp:337
msgid ""
"             # List the UDI of devices corresponding to 'predicate'.\n"
"             # - If 'parentUdi' is specified, the search is restricted to "
"the\n"
"             # branch of the corresponding device,\n"
"             # - Otherwise the search is done on all the devices.\n"
msgstr ""
"             # 'घोषणा' सँग सङ्गत यन्त्रको UDI सूचीबद्ध गर्नुहोस् ।\n"
"             # - यदि 'parentUdi' निर्दिष्ट गरिएको छभने, खोजी\n"
"             # सङ्गत यन्त्रको शाखामा निषेध गरिएको हुन्छ,\n"
"             # - अन्यथा सबै यन्त्रमा खोजी गरिन्छ ।\n"

#: main.cpp:343
msgid ""
"             # If applicable, mount the device corresponding to 'udi'.\n"
msgstr "             # प्रयोगयोग्य भएमा, 'udi' सँग सङ्गत यन्त्र माउन्ट गर्नुहोस् ।\n"

#: main.cpp:346
msgid ""
"             # If applicable, unmount the device corresponding to 'udi'.\n"
msgstr "             # प्रयोगयोग्य भएमा, 'udi' सँग सङ्गत यन्त्र अनमाउन्ट गर्नुहोस् ।\n"

#: main.cpp:349
msgid ""
"             # If applicable, eject the device corresponding to 'udi'.\n"
msgstr "             # प्रयोगयोग्य भएमा, 'udi' सँग सङ्गत यन्त्र निकाल्नुहोस् ।\n"

#: main.cpp:356
msgid ""
"             # List a particular set of information regarding power "
"management.\n"
"             # - If the 'suspend' option is specified, give the list of "
"suspend\n"
"             # method supported by the system\n"
"             # - If the 'scheme' option is specified, give the list of\n"
"             # supported power management schemes by this system\n"
"             # - If the 'cpufreq' option is specified, give the list of\n"
"             # supported CPU frequency policy\n"
msgstr ""
"             # शक्ति प्रबन्धसँगसम्बन्धित सूचनाको विशेष सेट सूचीबद्ध गर्नुहोस् ।\n"
"             # - यदि 'निलम्बन' विकल्प निर्दिष्ट गरिएको भएमा, निलम्बनको सूची "
"दिनुहोस्\n"
"             # प्रणालीद्वारा समर्थित\n"
"             # - यदि 'योजना' बिकल्प निर्दिष्ट गरिएको छ भने, सूचीदिनुहोस्\n"
"             # यो प्रणालीद्वारा समर्थित शक्ति प्रबन्ध योजना\n"
"             # - यदि 'cpufreq' विकल्प निर्दिष्टगरिएकोछ भने, सूची दिनुहोस्\n"
"             # समर्थित CPU आवृत्ति नीति\n"

#: main.cpp:365
msgid ""
"             # Set power management options of the system.\n"
"             # - If the 'scheme' option is specified, the power management\n"
"             # scheme set corresponds to 'value'\n"
"             # - If the 'cpufreq' option is specified, the CPU frequency "
"policy\n"
"             # set corresponds to 'value'\n"
msgstr ""
"             # प्रणालीको शक्ति व्वस्थापन विकल्प सेट गर्नुहोस् ।\n"
"             # - यदि 'योजना' विकल्प निर्दिष्ट गरिएको छ भने, शक्ति प्रबन्ध\n"
"             # योजना सेटले 'मान' सङ्केत गर्दछ\n"
"             # - यदि 'cpufreq' विकल्प निर्दिष्ट छ भने, CPU आवृत्तिनीति\n"
"             # सेटले 'मान' लाई सङ्केत गर्दछ\n"

#: main.cpp:372
msgid "             # Suspend the computer using the given 'method'.\n"
msgstr "             # कम्प्युटरले प्रयोग गरेको दिएको 'विधि' निलम्बन गर्नुहोस् ।\n"

#: main.cpp:377
msgid "             # List the network devices present.\n"
msgstr "             # हालको सञ्जाल यन्त्र सूचीबद्ध गर्नुहोस् ।\n"

#: main.cpp:380
msgid ""
"             # List the networks known to the device specified by 'uni'.\n"
msgstr ""
"             # यन्त्रमा परिचित 'uni' द्वारा निर्दिष्ट गरिएका सञ्जाल सूचीबद्ध गर्नुहोस् "
"।\n"

#: main.cpp:383
msgid ""
"             # Query whether networking features are active or not.\n"
"             # - If the 'status' option is given, return whether\n"
"             # networking is enabled for the system\n"
"             # - If the 'wireless' option is is given, return whether\n"
"             # wireless is enabled for the system\n"
"             # - If the 'interface' option is given, print the\n"
"             # properties of the network interface that 'uni' refers to.\n"
"             # - If the 'network' option is given, print the\n"
"             # properties of the network on 'device-uni' that 'network-uni' "
"refers to.\n"
msgstr ""
"             # नेटवर्किङ विशेषता सक्रिय पारेको छ या छैन क्वेरी गर्नुहोस् ।\n"
"             # - यदि 'वस्तुस्थिति' विकल्प दिएको भएमा, यात\n"
"             # प्रणालीका लागि नेटवर्किङ सक्षम पारिएको भएमा फर्कनुहोस्\n"
"             # - यदि 'वायेरलेस' विकल्प दिएको भएमा, यात\n"
"             # प्रणालीका लागि वायेरलेस सक्षम पारिएको भएमा फर्कनुहोस्\n"
"             # - यदि 'इन्टरफेस' विकल्प दिएको भएमा, 'uni' ले सन्दर्भ गरेको\n"
"             # सञ्जाल इन्टरफेसको गुण मुद्रण गर्नुहोस् ।\n"
"             # - यदि 'सञ्जाल' विकल्प दिएको भएमा, 'device-uni' मा 'network-uni' "
"ले सन्दर्भ गर्ने\n"
"             # सञ्जालको गुण मुद्रण गर्नुहोस् ।\n"

#: main.cpp:394 main.cpp:397
msgid "             # Enable or disable networking on this system.\n"
msgstr "             # यो प्रणालीमा नेटवर्किङ सक्षम वा अक्षम पार्नुहोस् ।\n"

#: main.cpp:400
msgid ""
"             # Activate the network 'network-uni' on 'device-uni'.\n"
"             # Optionally, use WEP128, open-system encryption with hex key "
"'key'. (Hardcoded)             # Where 'authentication' is one of:\n"
"             # wep hex64|ascii64|hex128|ascii128|passphrase64|passphrase128 "
"'key' [open|shared]\n"
"             # wpapsk wpa|wpa2 tkip|ccmp-aes password\n"
"             # wpaeap UNIMPLEMENTED IN SOLIDSHELL\n"
msgstr ""
"             # 'device-uni' मा 'network-uni' सञ्जाल सक्रिया पार्नुहोस् ।\n"
"             # विकल्पको रूपमा, WEP128, हेक्स कुञ्जी 'key' सँगको खुला-प्रणाली गुप्तिकरण "
"प्रयोग गर्नुहोस् । (Hardcoded)             # जहाँ 'प्रमाणीकरण' यी मध्ये एक हुन्छ:\n"
"             # wep hex64|ascii64|hex128|ascii128|passphrase64|passphrase128 "
"'key' [open|shared]\n"
"             # wpapsk wpa|wpa2 tkip|ccmp-aes password\n"
"             # wpaeap UNIMPLEMENTED IN SOLIDSHELL\n"

#: main.cpp:410
msgid "             # List bluetooth adapters/interfaces\n"
msgstr "             # ब्लुतुथ एडप्टर/इन्टरफेस सूचीबद्ध गर्नुहोस्\n"

#: main.cpp:413
msgid "             # List bluetooth default adapter/interface\n"
msgstr "             # ब्लुतुथ पूर्वनिर्धारित एडप्टर/इन्टरफेस सूचीबद्ध गर्नुहोस्\n"

#: main.cpp:416
msgid ""
"             # Query information about the bluetooth adapter/interface with "
"'ubi'\n"
msgstr "             # 'ubi' सँगको ब्लुतुथ एडप्टर/इन्टरफेस बारेको क्वेरी सूचना\n"

#: main.cpp:419
msgid ""
"             # Set the bluetooth adapter name.\n"
"             # Set the bluetooth adapter mode. Where 'value' is one of:\n"
"             # off|connectable|discoverable\n"
msgstr ""
"             # ब्लुतुथ एडप्टरको नाम सेट गर्नुहोस् ।\n"
"             # ब्लुतुथ एडप्टर मोड सेट गर्नुहोस् । जहाँ 'मान' यी मध्ये एक हो:\n"
"             # off|connectable|discoverable\n"

#: main.cpp:424
msgid "             # Scan for bluetooth remote devices.\n"
msgstr "             # ब्लुतुथ टाढाको यन्त्रका लागि स्क्यान गर्नुहोस् ।\n"

#: main.cpp:427
msgid "             # List configured input deviceses.\n"
msgstr "             # कन्फिगर गरिएका आगत यन्त्र सूचीबद्ध गर्नुहोस् ।\n"

#: main.cpp:430
msgid ""
"             # Setup bluetooth input device.\n"
"             # Remove configuration of remote input device.\n"
"             # Connect or disconnect bluetooth input device.\n"
msgstr ""
"             # ब्लुतुथ आगत यन्त्र सेटअप गर्नुहोस् ।\n"
"             # टाढाको आगत यन्त्रको कन्फिगरेसन हटाउनुहोस् ।\n"
"             # ब्लुतुथ आगत यन्त्र जडान वा विच्छेद गर्नुहोस् ।\n"

#: main.cpp:435
msgid ""
"             # Create bonding (pairing) with bluetooth remote device.\n"
"             # Remove bonding of bluetooth remote device.\n"
"             # Check for bonding of bluetooth remote device.\n"
msgstr ""
"             # ब्लुतुथ टाढाको यन्त्रसँग बोन्डिङ (पेरिङ) सिर्जना गर्नुहोस् ।\n"
"             # ब्लुतुथ टाढाको यन्त्रको बोन्डिङ हटाउनुहोस् ।\n"
"             # ब्लुतुथ टाढाको यन्त्रको बोन्डिङका लागि जाँच गर्नुहोस् ।\n"

