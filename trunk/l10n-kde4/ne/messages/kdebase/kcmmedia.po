#: managermodule.cpp:42
msgid "No support for HAL on this system"
msgstr "यो प्रणालीमा HAL का लागि समर्थन छैन"

#: managermodule.cpp:49
msgid "No support for CD polling on this system"
msgstr "यो प्रणालीमा सीडी चयनको समर्थन छैन"

#: notifiermodule.cpp:51
msgid "All Mime Types"
msgstr "सबै माइम प्रकार"

#. i18n: tag string
#. i18n: file managermoduleview.ui line 24
#: rc.cpp:3
msgid "Enable HAL backend"
msgstr "HAL ब्याकइन्ड सक्षम पार्नुहोस्"

#. i18n: tag string
#. i18n: file managermoduleview.ui line 27
#: rc.cpp:6
msgid ""
"Select this if you want to enable the Hardware Abstraction Layer (http://hal."
"freedesktop.org/wiki/Software/hal) support."
msgstr ""
"यदि तपाईँ हार्डवयर पृथकिकरण तह समर्थन सक्षम पार्न चाहनुहुन्छ भने (http://hal."
"freedesktop.org/wiki/Software/hal) यो चयन गर्नुहोस् ।"

#. i18n: tag string
#. i18n: file managermoduleview.ui line 35
#: rc.cpp:9
msgid "Enable CD polling"
msgstr "सीडी चयन सक्षम पार्नुहोस्"

#. i18n: tag string
#. i18n: file managermoduleview.ui line 38
#: rc.cpp:12
msgid "Select this to enable the CD polling."
msgstr "सीडी चयन सक्षम पार्न यो चयन गर्नुहोस् ।"

#. i18n: tag string
#. i18n: file managermoduleview.ui line 46
#: rc.cpp:15
msgid "Enable medium application autostart after mount"
msgstr "माउन्ट पछि माध्यम अनुप्रयोग स्वत: सुरुआत सक्षम पार्नुहोस्"

#. i18n: tag string
#. i18n: file managermoduleview.ui line 49
#: rc.cpp:18
msgid ""
"Select this if you want to enable application autostart after mounting a "
"device."
msgstr ""
"यन्त्र माउन्ट गरेपछि यदि तपाईँ अनुप्रयोग स्वत:सुरुआत सक्षम पार्न चाहनुहुन्छ भने यो चयन "
"गर्नुहोस् ।"

#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 48
#: rc.cpp:21
msgid "Medium types:"
msgstr "माध्यम प्रकार:"

#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 64
#: rc.cpp:24
msgid ""
"Here is the list of the availables type of medium which can be monitored. "
"You can filter the availables action by selecting a kind of medium. If you "
"want to see all the actions, select \"All Mime Types\"."
msgstr ""
"यहाँ अनुगमन गर्न सकिने उपलब्ध माध्यम प्रकारको सूची छ । तपाईँले माध्यमका प्रकार चयन गरेर "
"उपलब्ध कार्यका सूची फिल्टर गर्न सक्नुहुन्छ । यदि तपाईँ सबै कार्य हेर्न चाहनहुन्छ भने, \"सबै "
"माइम प्रकार\" चयन गर्नुहोस् ।"

#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 90
#: rc.cpp:27
msgid "&Add..."
msgstr "थप्नुहोस्..."

#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 93
#: rc.cpp:30
msgid "Click here to add an action."
msgstr "कार्य थप्नका लागि यहाँ क्लिक गर्नुहोस् ।"

#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 101
#: rc.cpp:33
msgid "&Delete"
msgstr "मेट्नुहोस्"

#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 104
#: rc.cpp:36
msgid "Click here to delete the selected action if possible."
msgstr "यदि सम्भव: भएमा चयन गरिएको कार्य मेट्न यहाँ क्लिक गर्नुहोस् ।"

#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 112
#: rc.cpp:39
msgid "&Edit..."
msgstr "सम्पादन..."

#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 115
#: rc.cpp:42
msgid "Click here to edit the selected action if possible."
msgstr "यदि सम्भव: भएमा चयन गरिएको कार्य सम्पादन गर्न यहाँ क्लिक गर्नुहोस् ।"

#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 123
#: rc.cpp:45
msgid "&Toggle as Auto Action"
msgstr "स्वत: कार्यका रुपमा टगल गर्नुहोस्"

#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 126
#: rc.cpp:48
msgid ""
"Click here to perform automaticly this action on detection of the selected "
"medium type (this option is disabled when \"All Mime Types\" is selected)."
msgstr ""
"चयन गरिएका माध्यम प्रकारको पत्ता लगाउने कार्य स्वचालित तरिकाले सम्पादन गर्न यहाँ क्लिक "
"गर्नुहोस् (\"सबै माइम प्रकार \" चयन हुदाँ यो विकल्प अक्षम भएको हुन्छ ) ।"

#. i18n: tag string
#. i18n: file notifiermoduleview.ui line 153
#: rc.cpp:51
msgid ""
"Here is the list of the available actions. You can modify them by using the "
"buttons on your right."
msgstr ""
"यहाँ उपलब्ध कार्यको सूची छ । तपाईँले दायाँका बटन प्रयोग गरेर तीनलाई परिमार्जन गर्न "
"सक्नुहुन्छ ।"

