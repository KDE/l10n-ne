#. i18n: tag string
#. i18n: file accessibilityconfigwidget.ui line 32
#: rc.cpp:4
#, no-c-format
msgid "&Bell"
msgstr "घण्टी"

#. i18n: tag string
#. i18n: file accessibilityconfigwidget.ui line 43
#: rc.cpp:8
#, no-c-format
msgid "&Audible Bell"
msgstr "सुनिने घण्टी"

#. i18n: tag string
#. i18n: file accessibilityconfigwidget.ui line 47
#: rc.cpp:12
#, no-c-format
msgid ""
"This is the configuration of the Audible Bell.<br>\n"
"It could be the system bell and/or a custom bell."
msgstr ""
"यो सुनिने घण्टीको कन्फिगरेसन हो ।<br>\n"
"यो प्रणाली घण्टी र/वा अनुकूलन घण्टी हुन सक्छ ।"

#. i18n: tag string
#. i18n: file accessibilityconfigwidget.ui line 58
#: rc.cpp:17
#, no-c-format
msgid "Use &system bell"
msgstr "प्रणाली घण्टी प्रयोग गर्नुहोस्"

#. i18n: tag string
#. i18n: file accessibilityconfigwidget.ui line 62
#: rc.cpp:21
#, no-c-format
msgid ""
"If this option is checked, the default system bell will be used. See the "
"\"System Bell\" control module for how to customize the system bell.<br>\n"
"Normally, this is just a \"beep\"."
msgstr ""
"यदि यो विकल्प प्रयोग गरिएमा, पूर्वनिर्धारित प्रणाली घण्टी प्रयोग हुनेछ । कसरी प्रणाली "
"घण्टी अनुकूलन गर्ने जान्नका लागि \"प्रणाली घण्टी\" नियन्त्रण मोड्युल हेर्नुहोस् ।<br>\n"
"सामान्यतया, यो \"beep\" जस्तो हुन्छ ।"

#. i18n: tag string
#. i18n: file accessibilityconfigwidget.ui line 70
#: rc.cpp:26
#, no-c-format
msgid "Use &customized bell"
msgstr "अनुकूल घण्टी प्रयोग गर्नुहोस्"

#. i18n: tag string
#. i18n: file accessibilityconfigwidget.ui line 74
#: rc.cpp:30
#, no-c-format
msgid ""
"Check this option if you want to use a customized bell, playing a sound "
"file. If you do this, you will probably want to turn off the system bell."
"<br>\n"
"Please note that on slow machines this may cause a \"lag\" between the event "
"causing the bell and the sound being played."
msgstr ""
"ध्वनि फाइल प्ले गर्दा, तपाईँले यदि अनुकूल घण्टी प्रयोग गर्न चाहेमा यो विकल्प जाँच गर्नुहोस् । "
"तपाईँ यो गर्नहुन्छ भने, सम्भवत प्रणाली घण्टी बन्द गर्न चाहनुहुनेछ ।<br>\n"
"कृपया याद गर्नुहोस् सुस्त मेसिनहरूमा घण्टी र ध्वनि बजाउने कारण र परिणाम बीचमा यो \"ढिलाई"
"\" को कारणले हुनसक्छ ।"

#. i18n: tag string
#. i18n: file accessibilityconfigwidget.ui line 110
#: rc.cpp:35
#, no-c-format
msgid "Sound &to play:"
msgstr "बजाउने ध्वनि:"

#. i18n: tag string
#. i18n: file accessibilityconfigwidget.ui line 116
#: rc.cpp:39
#, no-c-format
msgid ""
"If the option \"Use customized bell\" is enabled, you can choose a sound "
"file here."
msgstr ""
"यदि यो विकल्प सक्षम पारिएमा \"अनुकूलन गरिएको घण्टी प्रयोग गर्नुहोस्\", तपाईँले यहाँ ध्वनि "
"फाइल रोज्न सक्नुहुन्छ ।"

#. i18n: tag string
#. i18n: file accessibilityconfigwidget.ui line 136
#: rc.cpp:43
#, no-c-format
msgid "&Visible Bell"
msgstr "दृश्यात्मक घण्टी"

