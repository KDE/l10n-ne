#: kdepasswd.cpp:24
msgid "KDE passwd"
msgstr "केडीई पासवर्ड"

#: kdepasswd.cpp:25
msgid "Changes a UNIX password."
msgstr "युनिक्स पासवर्ड परिवर्तन गर्दछ ।"

#: kdepasswd.cpp:26
msgid "Copyright (c) 2000 Geert Jansen"
msgstr ""

#: kdepasswd.cpp:27
msgid "Geert Jansen"
msgstr ""

#: kdepasswd.cpp:27
msgid "Maintainer"
msgstr "मर्मतकर्ता"

#: kdepasswd.cpp:33
msgid "Change password of this user"
msgstr "यो प्रयोगकर्ताको पासवर्ड परिवर्तन गर्नुहोस्"

#: kdepasswd.cpp:56
msgid "You need to be root to change the password of other users."
msgstr "अन्य प्रयोगकर्ताको पासवर्ड परिवर्तन गर्न तपाईँ रूट हुन आवश्यक छ ।"

#: passwddlg.cpp:18 passwddlg.cpp:85
msgid "Change Password"
msgstr "पासवर्ड परिवर्तन गर्नुहोस्"

#: passwddlg.cpp:19
msgid "Please enter your current password:"
msgstr "कृपया तपाईँको हालको पासवर्ड प्रविष्ट गर्नुहोस्:"

#: passwddlg.cpp:39 passwddlg.cpp:160
msgid "Conversation with 'passwd' failed."
msgstr "पासवर्ड सहितको वार्तालाप असफल भयो ।"

#: passwddlg.cpp:49
msgid "Could not find the program 'passwd'."
msgstr "कार्यक्रमको पासवर्ड फेला पार्न सकिएन ।"

#: passwddlg.cpp:54
msgid "Incorrect password. Please try again."
msgstr "गलत पासवर्ड । कृपया फेरि प्रयास गर्नुहोस् ।"

#: passwddlg.cpp:58
msgid "Internal error: illegal return value from PasswdProcess::checkCurrent."
msgstr "आन्तरिक त्रुटि: पासवर्ड प्रक्रियाबाट अवैध फर्किएको मान ।"

#: passwddlg.cpp:87
msgid "Please enter your new password:"
msgstr "कृपया तपाईँको नयाँ पासवर्ड प्रविष्ट गर्नुहोस्:"

#: passwddlg.cpp:89
#, qt-format
msgid "Please enter the new password for user <b>%1</b>:"
msgstr "कृपया प्रयोगकर्ता <b>%1</b> का लागि नयाँ पासवर्ड प्रविष्ट गर्नुहोस्:"

#: passwddlg.cpp:108
msgid ""
"Your password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it "
"is."
msgstr ""
"तपाईँको पासवर्ड ८ क्यारेक्टर भन्दा लामो छ । यो प्रणालीमा, यसले समस्या उत्पन्न गर्न सक्छ । "
"तपाईँले पासवर्डलाई ८ क्यारेक्टरमा छोट्याउन सक्नुहुन्छ वा यसलाई जस्ताको तस्तै छोड्नुहोस् ।"

#: passwddlg.cpp:111
msgid ""
"The password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it "
"is."
msgstr ""
"तपाईँको पासवर्ड ८ क्यारेक्टर भन्दा लामो छ । मेरो प्रणालीमा, यसले समस्या उत्पन्न गर्न सक्छ "
"। तपाईँले पासवर्डलाई ८ क्यारेक्टरमा छोट्याउन सक्नुहुन्छ वा यसलाई जस्ताको तस्तै छोड्नुहोस् ।"

#: passwddlg.cpp:115
msgid "Password Too Long"
msgstr "पासवर्ड लामो भयो"

#: passwddlg.cpp:116
msgid "Truncate"
msgstr "छोट्याउनुहोस्"

#: passwddlg.cpp:117
msgid "Use as Is"
msgstr "यस्तो प्रयोग गर्नुहोस्"

#: passwddlg.cpp:139
msgid "Your password has been changed."
msgstr "तपाईँको पासवर्ड परिवर्तन भयो ।"

#: passwddlg.cpp:149
msgid "Your password has not been changed."
msgstr "तपाईँको पासवर्ड परिवर्तन भयो ।"

