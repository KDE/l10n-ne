#: command.cc:126
msgid ""
"The server rejected both EHLO and HELO commands as unknown or "
"unimplemented.\n"
"Please contact the server's system administrator."
msgstr ""
"सर्भरले EHLO र HELO आदेशलाई अज्ञात वा कार्यान्वयन नभएको रूपमा दुवैलाई अस्वीकार गर्यो ।\n"
"कृपया सर्भरको प्रणाली प्रशासकसँग सम्पर्क गर्नुहोस् ।"

#: command.cc:140
#, qt-format
msgid ""
"Unexpected server response to %1 command.\n"
"%2"
msgstr ""
"%1 आदेशमा सर्भरले अनपेक्षित प्रतिक्रिया दियो ।\n"
"%2"

#: command.cc:160
msgid ""
"Your SMTP server does not support TLS. Disable TLS, if you want to connect "
"without encryption."
msgstr ""
"तपाईँको STMP सर्भरले TLS लाई समर्थन गर्दैन । यदि तपाईँ गुप्तिकरण बिना जडान गर्न "
"चाहनुहुन्छ भने, TLS अक्षम गर्नुहोस् ।"

#: command.cc:174
msgid ""
"Your SMTP server claims to support TLS, but negotiation was unsuccessful.\n"
"You can disable TLS in KDE using the crypto settings module."
msgstr ""
"तपाईँको SMTP सर्भरले TLS समर्थन गर्न दावी गर्दछ, तर सम्झौता असफल भयो ।\n"
"तपाईँ केडीई मा क्रिप्टो सेटिङ मोड्युल प्रयोग गरेर TLS अक्षम गर्न सक्नुहुन्छ ।"

#: command.cc:179
msgid "Connection Failed"
msgstr "जडान असफल भयो"

#: command.cc:185
#, qt-format
msgid "An error occurred during authentication: %1"
msgstr ""

#: command.cc:230
msgid "Authentication support is not compiled into kio_smtp."
msgstr "kio_smtp मा प्रमाणीकरण समर्थन कम्पाइल गरिएन ।"

#: command.cc:259
msgid "No authentication details supplied."
msgstr "कुनै पनि प्रमाणीकरण विवरण दिएको छैन ।"

#: command.cc:356
#, qt-format
msgid ""
"Your SMTP server does not support %1.\n"
"Choose a different authentication method.\n"
"%2"
msgstr ""
"तपाईँको SMTP सर्भरले %1 लाई समर्थन गर्दैन ।\n"
"फरक प्रमाणीकरण विधि रोज्नुहोस् ।\n"
"%2"

#: command.cc:360
#, fuzzy, qt-format
msgid ""
"Your SMTP server does not support authentication.\n"
"  %1"
msgstr ""
"तपाईँको SMTP सर्भरले प्रमाणीकरण समर्थन गर्दैन ।\n"
"  %2"

#: command.cc:364
#, qt-format
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"%1"
msgstr ""
"प्रमाणीकरण असफल\n"
"पासवर्ड गलत भएको हुन सक्दछ\n"
"%1"

#: command.cc:502
msgid "Could not read data from application."
msgstr "अनुप्रयोगबाट डाटा पढ्न सकेन ।"

#: command.cc:519
#, qt-format
msgid ""
"The message content was not accepted.\n"
"%1"
msgstr ""
"सन्देश सामग्री अस्वीकार गरियो ।\n"
"%1"

#: response.cc:106
#, qt-format
msgid ""
"The server responded:\n"
"%1"
msgstr ""
"सर्भरको प्रतिक्रिया:\n"
"%1"

#: response.cc:109
#, qt-format
msgid "The server responded: \"%1\""
msgstr "सर्भरको प्रतिक्रिया: \"%1\""

#: response.cc:112
msgid "This is a temporary failure. You may try again later."
msgstr "यो अस्थायी असफलता हो । तपाईँ पुन: प्रयास गर्न सक्नुहुन्छ ।"

#: smtp.cc:196
msgid "The application sent an invalid request."
msgstr "अनुप्रयोगले एउटा अवैध अनुरोध पठायो ।"

#: smtp.cc:258
msgid "The sender address is missing."
msgstr "प्रेषक ठेगाना छुटेको छ ।"

#: smtp.cc:266
#, qt-format
msgid "SMTPProtocol::smtp_open failed (%1)"
msgstr "SMTP प्रोटोकल::smtp_open असफल भयो (%1)"

#: smtp.cc:274
msgid ""
"Your server does not support sending of 8-bit messages.\n"
"Please use base64 or quoted-printable encoding."
msgstr ""
"तपाईँको सर्भरले ८-बिट सन्देश पठाउन समर्थन गर्दैन ।\n"
"कृपया आधार६४ वा उद्धरण गरिएको-मुद्रणयोग्य सङ्केतन प्रयोग गर्नुहोस् ।"

#: smtp.cc:356
#, qt-format
msgid "Invalid SMTP response (%1) received."
msgstr "अवैध SMTP प्रतिक्रिया (%1) प्राप्त भयो ।"

#: smtp.cc:540
#, qt-format
msgid ""
"The server did not accept the connection.\n"
"%1"
msgstr ""
"सर्भरले जडान स्वीकार गरेन ।\n"
"%1"

#: smtp.cc:619
msgid "Username and password for your SMTP account:"
msgstr "तपाईँको SMTP खाताका लागि प्रयोगकर्ता नाम र पासवर्ड:"

#: transactionstate.cc:53
#, qt-format
msgid ""
"The server did not accept a blank sender address.\n"
"%1"
msgstr ""
"सर्भरले खाली प्रेषक ठेगाना स्वीकार गरेन ।\n"
"%1"

#: transactionstate.cc:56
#, qt-format
msgid ""
"The server did not accept the sender address \"%1\".\n"
"%2"
msgstr ""
"सर्भरले \"%1\" प्रेषक ठेगाना स्वीकार गरेन ।\n"
"%2"

#: transactionstate.cc:101
#, qt-format
msgid ""
"Message sending failed since the following recipients were rejected by the "
"server:\n"
"%1"
msgstr ""
"सर्भरले निम्न प्रापकहरू अस्वीकार गरेकोले सन्देश पठाउन असफल भयो:\n"
"%1"

#: transactionstate.cc:106
#, qt-format
msgid ""
"The attempt to start sending the message content failed.\n"
"%1"
msgstr ""
"सन्देश सामग्री पठाउन सुरु गर्ने प्रयास असफल भयो ।\n"
"%1"

#: transactionstate.cc:110
msgid "Unhandled error condition. Please send a bug report."
msgstr "ह्यान्डल नगरिएको त्रुटि स्थिति । कृपया बग प्रतिवेदन पठाउनुहोस् ।"
