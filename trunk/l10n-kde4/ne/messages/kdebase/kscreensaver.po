#: random.cpp:44
#, qt-format
msgid ""
"Usage: %1 [-setup] [args]\n"
"Starts a random screen saver.\n"
"Any arguments (except -setup) are passed on to the screen saver."
msgstr ""
"उपयोग: %1 [-setup] [args]\n"
"अनियमित स्क्रिनसेभर सुरु गर्दछ ।\n"
"स्क्रिनसेभरमा (सेटअप-बाहेक) कुनै तर्कहरू पास भयो ।"

#: random.cpp:51
msgid "Start a random KDE screen saver"
msgstr "अनियमित केडीई स्क्रिनसेभर सुरु गर्नुहोस्"

#: random.cpp:59
msgid "Random screen saver"
msgstr "अनियमित स्क्रिनसेभर"

#: random.cpp:64
msgid "Setup screen saver"
msgstr "स्क्रिनसेभर सेटअप गर्नुहोस्"

#: random.cpp:66
msgid "Run in the specified XWindow"
msgstr "निर्दिष्ट एक्स सञ्झ्यालमा चलाउनुहोस्"

#: random.cpp:68
msgid "Run in the root XWindow"
msgstr "रूट एक्स सञ्झ्यालमा चलाउनुहोस्"

#: random.cpp:214
msgid "Setup Random Screen Saver"
msgstr "अनियमित स्क्रिनसेभर सेटअप गर्नुहोस्"

#: random.cpp:223
msgid "Use OpenGL screen savers"
msgstr "ओपन जी एल स्क्रिनसेभर प्रयोग गर्नुहोस्"

#: random.cpp:226
msgid "Use screen savers that manipulate the screen"
msgstr "स्क्रिन मिलाउने स्क्रिनसेभरहरू प्रयोग गर्नुहोस्"

