#: ktrash.cpp:34
msgid "ktrash"
msgstr "केडीई रद्दीटोकरी"

#: ktrash.cpp:36
msgid ""
"Helper program to handle the KDE trash can\n"
"Note: to move files to the trash, do not use ktrash, but \"kfmclient move "
"'url' trash:/\""
msgstr ""
"केडीई रद्दीटोकी ह्यान्डल गर्नका लागि सहयोगी कार्यक्रम\n"
"द्रष्टव्य: रद्दीटोकरीमा फाइलहरू सार्न, केडीई रद्दीटोकरी प्रयोग नगर्नुहोस्, तर "
"\"kfmclient ले 'url' रद्दीटोकरीमा सार्दछ:/\""

#: ktrash.cpp:40
msgid "Empty the contents of the trash"
msgstr "रद्दीटोकरीको सामग्री खाली गर्नुहोस्"

#: ktrash.cpp:42
msgid "Restore a trashed file to its original location"
msgstr "रद्दीटोकरीको फाइलहरू तिनको मौलिक स्थानमा ल्याउनुहोस् ।"

#: ktrash.cpp:44
msgid "Ignored"
msgstr "उपेक्षित"

#: kio_trash.cpp:52
msgid "Protocol name"
msgstr "प्रोटोकल नाम"

#: kio_trash.cpp:53 kio_trash.cpp:54
msgid "Socket name"
msgstr "सकेट नाम"

#: kio_trash.cpp:102 kio_trash.cpp:165 kio_trash.cpp:313 kio_trash.cpp:345
#: kio_trash.cpp:509 kio_trash.cpp:521
#, qt-format
msgid "Malformed URL %1"
msgstr "विकृत यूआरएल %1"

#: kio_trash.cpp:121
#, qt-format
msgid ""
"The directory %1 does not exist anymore, so it is not possible to restore "
"this item to its original location. You can either recreate that directory "
"and use the restore operation again, or drag the item anywhere else to "
"restore it."
msgstr ""
"%1 डाइरेक्टरी अब अवस्थित रहने छैन, त्यसैले यो वस्तुलाई यसको मौलिक स्थानमा लैजान सम्भव छैन "
"। तपाईँ या त त्यो डाइरेक्टरी पुन: सिर्जना गरेर फेरि पूर्वावस्थामा लाने सञ्चालन प्रयोग गर्न "
"सक्नुहुन्छ वा यसलाई अन्य कुनै स्थानमा पूर्वावस्थामा लैजान वस्तु तान्न सक्नुहुन्छ ।"

#: kio_trash.cpp:150
msgid "This file is already in the trash bin."
msgstr "यो फाइल पहिल्यै रद्दीटोकरीमा छ ।"

