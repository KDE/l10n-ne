#: main.cpp:51
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"मानक X11R6 सत्र व्यवस्थापन प्रोटोकल (XSMP) लिने\n"
"विश्वासिलो केडीई सत्र व्यवस्थापक"

#: main.cpp:198
msgid "The KDE Session Manager"
msgstr "केडीई सत्र प्रबन्धक"

#: main.cpp:200
msgid "(C) 2000, The KDE Developers"
msgstr "(C) 2000, केडीई विकासकर्ता"

#: main.cpp:201
msgid "Matthias Ettrich"
msgstr "माथियस इट्रिच"

#: main.cpp:202
msgid "Luboš Luňák"
msgstr "लुबोस लुनाक"

#: main.cpp:202
msgid "Maintainer"
msgstr "मर्मतकर्ता"

#: main.cpp:208
msgid "Restores the saved user session if available"
msgstr "उपलब्ध भएमा बचत गरिएको प्रयोगकर्ता सत्र पूर्वावस्थामा ल्याउदछ"

#: main.cpp:210
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"सत्रमा अन्य सञ्झ्याल प्रबन्धकले भाग नलिएको अवस्थामा\n"
"'wm' सुरु गर्दछ । 'केडीई विन' पूर्वनिर्धारित हो ।"

#: main.cpp:211
msgid "Also allow remote connections"
msgstr "टाढाको जडानहरू पनि अनुमति दिनुहोस्"

#: rc.cpp:1
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Kapil Timilsina।, श्यामकृष्ण बल"

#: rc.cpp:2
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "lipak21@gmail.com, shyamkrishna_bal@yahoo.com"

#: shutdown.cpp:356
#, kde-format
msgid "Logout canceled by '%1'"
msgstr "'%1' द्वारा रद्द गरिएको लगआउट"

#: shutdowndlg.cpp:362
#, kde-format
msgid "End Session for %1"
msgstr "%1 का लागि सत्र अन्त्य गर्नुहोस्"

#: shutdowndlg.cpp:364
#, kde-format
msgid "End Session for %1 (%2)"
msgstr "%1 (%2) का लागि सत्र अन्त्य गर्नुहोस्"

#: shutdowndlg.cpp:381
msgid "Logout"
msgstr "लगआउट गर्नुहोस्"

#: shutdowndlg.cpp:389
msgid "Turn Off Computer"
msgstr "कम्प्युटर बन्द गर्नुहोस्"

#: shutdowndlg.cpp:401
msgid "Standby"
msgstr "स्टान्डबाइ"

#: shutdowndlg.cpp:403
msgid "Suspend to RAM"
msgstr "र्याममा निर्भर गर्नुहोस्"

#: shutdowndlg.cpp:405
msgid "Suspend to Disk"
msgstr "डिस्कमा निर्भर गर्नुहोस्"

#: shutdowndlg.cpp:408
msgid "Restart Computer"
msgstr "कम्प्युटर फेरि सुरु गर्नुहोस्"

#: shutdowndlg.cpp:430
msgctxt "current option in boot loader"
msgid " (current)"
msgstr " (हालको)"

#: shutdowndlg.cpp:439
msgid "Cancel"
msgstr "रद्द गर्नुहोस्"
