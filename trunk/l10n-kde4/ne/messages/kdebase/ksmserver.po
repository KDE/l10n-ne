#: main.cpp:52
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"मानक X11R6 सत्र व्यवस्थापन प्रोटोकल (XSMP) लिने\n"
"विश्वासिलो केडीई सत्र व्यवस्थापक"

#: main.cpp:240
msgid "The KDE Session Manager"
msgstr "केडीई सत्र प्रबन्धक"

#: main.cpp:242
msgid "(C) 2000, The KDE Developers"
msgstr "(C) 2000, केडीई विकासकर्ता"

#: main.cpp:243
msgid "Matthias Ettrich"
msgstr "माथियस इट्रिच"

#: main.cpp:244
msgid "Luboš Luňák"
msgstr "लुबोस लुनाक"

#: main.cpp:244
msgid "Maintainer"
msgstr "मर्मतकर्ता"

#: main.cpp:252
msgid "Restores the saved user session if available"
msgstr "उपलब्ध भएमा बचत गरिएको प्रयोगकर्ता सत्र पूर्वावस्थामा ल्याउदछ"

#: main.cpp:254
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"सत्रमा अन्य सञ्झ्याल प्रबन्धकले भाग नलिएको अवस्थामा\n"
"'wm' सुरु गर्दछ । 'केडीई विन' पूर्वनिर्धारित हो ।"

#: main.cpp:255
msgid "Also allow remote connections"
msgstr "टाढाको जडानहरू पनि अनुमति दिनुहोस्"

