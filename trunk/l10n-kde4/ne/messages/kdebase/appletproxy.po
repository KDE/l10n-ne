#: appletproxy.cpp:118
msgid ""
"The applet proxy could not be started due to DCOP communication problems."
msgstr "DCOP मा सञ्चार समस्याहरूको कारणले गर्दा एप्लेट प्रोक्सी सुरुआत हुन सकेन ।"

#: appletproxy.cpp:119 appletproxy.cpp:127 appletproxy.cpp:161
#: appletproxy.cpp:182
msgid "Applet Loading Error"
msgstr "एप्लेट लोडिङ त्रुटि"

#: appletproxy.cpp:126
msgid ""
"The applet proxy could not be started due to DCOP registration problems."
msgstr "DCOP मा दर्ता समस्याहरूको कारणले गर्दा एप्लेट प्रोक्सी सुरुआत हुन सकेन ।"

#: appletproxy.cpp:160
#, qt-format
msgid "The applet proxy could not load the applet information from %1."
msgstr "%1 बाट एप्लेट प्रोक्सीले एप्लेट सूचना लोड गर्न सकेन ।"

#: appletproxy.cpp:181
#, qt-format
msgid "The applet %1 could not be loaded via the applet proxy."
msgstr "एप्लेट प्रोक्सी हुदैँ एप्लेट %1 लोड हुन सकेन ।"

