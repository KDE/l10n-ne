#: runapplet.cpp:62
msgid "Run command:"
msgstr "आदेश चलाउनुहोस्:"

#: runapplet.cpp:177
msgid "< Run"
msgstr "< चलाउनुहोस्"

#: runapplet.cpp:184
msgid "Run >"
msgstr "चलाउनुहोस् >"

#: runapplet.cpp:233
msgid "You have to enter a command to execute or a URL to be opened first."
msgstr "पहिला यूआरएल खोल्न वा कार्यान्वयन गर्न तपाईँले आदेश प्रविष्ट गर्नुपर्दछ ।"

#: runapplet.cpp:244
msgid ""
"Unable to log out properly.\n"
"The session manager cannot be contacted. You can try to force a shutdown by "
"pressing Ctrl+Alt+Backspace. Note, however, that your current session will "
"not be saved with a forced shutdown."
msgstr ""
"राम्रोसँग लग आउट गर्न अक्षम ।\n"
"सत्र प्रबन्धक सम्पर्क हुन सकेन । तपाईँ ctrl+Alt+Backspace थिचेर बलपूर्वक बन्द गर्न प्रयास "
"गर्न सक्नुहुन्छ । जेभए पनि, तपाईँको हालको सत्र बलपूर्वक बन्दद्वारा बचत हुने छैन भन्ने याद "
"राख्नुहोस् ।"

#: runapplet.cpp:275
#, kde-format
msgid ""
"<qt>The program name or command <b>%1</b>\n"
"cannot be found. Please correct the command\n"
"or URL and try again</qt>"
msgstr ""
"<qt>कार्यक्रम नाम वा आदेश <b>%1</b>\n"
"फेला पार्न सकिएन । कृपया आदेश वा यूआरएल\n"
"सुधार गर्नुहोस् र फेरि प्रयास गर्नुहोस्</qt>"

#: runapplet.cpp:287
#, kde-format
msgid ""
"<qt>Could not run <b>%1</b>.\n"
"Please correct the command or URL and try again.</qt>"
msgstr ""
"<qt><b>%1</b> चल्न सकेन ।\n"
"कृपया आदेश वा यूआरएल सुधार गर्नुहोस् र फेरि प्रयास गर्नुहोस् ।</qt>"
