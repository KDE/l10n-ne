#: rc.cpp:57
msgid ""
"When this option is enabled, the panels may not be moved and items cannot be "
"removed or added"
msgstr "यो विकल्प सक्षम गर्दा, प्यानलहरू सार्न र वस्तु हटाउन वा थप्न मिल्दैन"

#: rc.cpp:60
msgid "Enable conserve space"
msgstr "खाली ठाउँ संरक्षण सक्षम पार्नुहोस्"

#: rc.cpp:63
msgid "Raise when the pointer touches the screen here"
msgstr "यहाँ सूचकले स्क्रिन छुदा बढाउनुहोस्"

#: rc.cpp:66
msgid "Fade out applet handles"
msgstr "एप्लेट ह्यान्डल मधुरो पार्नुहोस्"

#: rc.cpp:69
msgid ""
"Select this option to make applet handles only visible on mouse hover. "
"Applet handles let you move, remove and configure applets."
msgstr ""
"माउस होभरमा मात्र एप्लेट ह्यान्डलहरू दृश्यात्मक बनाउन यो विकल्प चयन गर्नुहोस् । एप्लेट "
"ह्यान्डलले तपाईँलाई एप्लेट सार्न, हटाउन र कन्फिगर गर्न दिन्छ ।"

#: rc.cpp:72
msgid "Hide applet handles"
msgstr "एप्लेट ह्यान्डल लुकाउनुहोस्"

#: rc.cpp:75
msgid ""
"Select this option to always hide the applet handles. Beware this could "
"disable moving, removing or configuring some applets."
msgstr ""
"एप्लेट ह्यान्डल लुकाउन सधै यो विकल्प चयन गर्नुहोस् । यसले केही एप्लेटहरू सार्न, हटाउन वा "
"कन्फिगर गर्न अक्षम गर्न सक्ने हुँदा सचेत रहनुहोस् ।"

#: rc.cpp:78
msgid ""
"A list of applets that have been loaded at runtime. In the case of a crash "
"these applets will not be loaded at the next Kicker start, in case they "
"caused the crash"
msgstr ""
"रनटाइममा लोड भएका एप्लेटहरूको सूची । क्र्याश भएको अवस्थामा तिनिहरू क्र्याशको कारण भएमा "
"ति एप्लेटहरू पछिल्लो किकर सुरुमा लोड गरिदैन ।"

#: rc.cpp:81
msgid ""
"A list of extensions that have been loaded at runtime. In the case of a "
"crash these extensions will not be loaded at the next Kicker start, in case "
"they caused the crash"
msgstr ""
"रनटाइममा लोड गरिने विस्तारहरूको सूची । क्र्याश भएको अवस्थामा यदि तिनिहरू क्र्याशको "
"कारण भएमा पछिल्लो किकर सुरुमा विस्तारहरू लोड गरिदैन ।"

#: rc.cpp:84
msgid "Show simple menu entries"
msgstr "साधारण मेनु प्रविष्टि देखाउनुहोस्"

#: rc.cpp:87
msgid "Show names first on detailed entries"
msgstr "विस्तृत प्रविष्टिमा पहिला नाम देखाउनुहोस्"

#: rc.cpp:90
msgid "Show only description for menu entries"
msgstr "मेनु प्रविष्टिका लागि वर्णन मात्र देखाउनुहोस्"

#: rc.cpp:93
msgid "Show detailed menu entries"
msgstr "विस्तृत मेनु प्रविष्टि देखाउनुहोस्"

#: rc.cpp:96
msgid "Formation of the menu entry text"
msgstr "मेनु प्रविष्टि पाठको बनावट"

#: rc.cpp:99
msgid "Show section titles in Kmenu"
msgstr "केडीई मेनुमा सेक्सन शीर्षक देखाउनुहोस्"

#: rc.cpp:102
msgid "Height of menu entries in pixels"
msgstr "पिक्सेलमा मेनु प्रविष्टिहरूको उचाइ"

#: rc.cpp:105
msgid "Show hidden files in Quick Browser"
msgstr "द्रूत ब्राउजरमा लुकेका फाइलहरू देखाउनुहोस्"

#: rc.cpp:108
msgid "Maximum number of entries"
msgstr "प्रविष्टिहरूका लागि अधिकतम सङ्ख्या"

#: rc.cpp:111
msgid "Show bookmarks in KMenu"
msgstr "केडीई मेनुमा पुस्तकचिनोहरू देखाउनुहोस्"

#: rc.cpp:114
msgid "Use the Quick Browser"
msgstr "द्रूत ब्राउजर प्रयोग गर्नुहोस्"

#: rc.cpp:117
msgid "Optional Menus"
msgstr "वैकल्पिक मेनुहरू"

#: rc.cpp:120
msgid "Recently used applications"
msgstr "हालै प्रयोग भएका अनुप्रयोग"

#: rc.cpp:123
msgid "Number of visible entries"
msgstr "दृश्यात्मक प्रविष्टिहरूको सङख्या"

#: rc.cpp:126
msgid "Show most recently used applications rather than most frequently used"
msgstr "बढि प्रयोग भएका अनुप्रयोग भन्दा हालै प्रयोग गरिएको अनुप्रयोग देखाउनुहोस्"

#: rc.cpp:129
msgid "Use side image in Kmenu"
msgstr "केडीई मेनुमा साइड छवि प्रयोग गर्नुहोस्"

#: rc.cpp:132
msgid "The name of the file to use as the side image in the K Menu"
msgstr "केडीई मेनुमा साइड छविको रूपमा प्रयोग गरिने फाइलको नाम"

#: rc.cpp:135
msgid ""
"The name of the file used as a tile to fill the height of K Menu that "
"SidePixmapName does not cover"
msgstr ""
"SidePixmapName ले पूर्ण नगर्ने केडीई मेनुको उचाइ भर्न टाएलको रुपमा प्रयोग गरिएको फाइलको "
"नाम"

#: rc.cpp:138
msgid "Show text on the K Menu button"
msgstr "केडीई मेनु बटनमा पाठ देखाउनुहोस्"

#: rc.cpp:141
msgid "Text to be shown on K Menu Button"
msgstr "केडीई मेनु बटनमा देखिनु पर्ने पाठ"

#: rc.cpp:144
msgid "Enable icon mouse over effects"
msgstr "प्रभाव माथि प्रतिमा माउस सक्षम पार्नुहोस्"

#: rc.cpp:147
msgid "Show icons in mouse over effects"
msgstr "प्रभाव माथि माउसमा प्रतिमाहरू देखाउनुहोस्"

#: rc.cpp:150
msgid "Show text in mouse over effects"
msgstr "प्रभाव माथि माउसमा पाठ देखाउनुहोस्"

#: rc.cpp:153
msgid ""
"Controls how fast the tooltips fade in, measured in thousandths of a second"
msgstr "सेकेन्डमा मापन गरिने उपकरणटिपको फेड इन को गति नियन्त्रण गर्दछ ।"

#: rc.cpp:156
msgid "Mouse over effects are shown after the defined time (in milliseconds)"
msgstr "निश्चित समय पछि (मिली सेकेण्डमा) माउस माथिको प्रभाव देखाइन्छ ।"

#: rc.cpp:159
msgid "Mouse over effects are hidden after the defined time (in milliseconds)"
msgstr "निश्चित समय (मिली सेकेण्डमा) पछि माउस माथिको प्रभाव लुकाइन्छ"

#: rc.cpp:162
msgid "The margin between panel icons and the panel border"
msgstr "प्यानल प्रतिमा र प्यानल किनारा बीच सीमान्त"

#: rc.cpp:165
msgid ""
"Buttons that represent KServices (applications, primarily) watch for the "
"removal of the service and delete themselves when this happens. This setting "
"turns this off."
msgstr ""
"केडीई सेवा (अनुप्रयोग, प्राथमिक रूपमा) प्रतिनिधित्व गर्ने बटनले सेवाको हटाइ हेर्दछ र यो "
"भएपछि तिनिहरूलाई नै मेट्दछ । यो सेटिङले यसलाई बन्द गर्दछ ।"

#: rc.cpp:168
msgid "Font for the buttons with text."
msgstr "पाठसँग बटनका लागि फन्ट"

#: rc.cpp:171
msgid "Text color for the buttons."
msgstr "बटनका लागि पाठ रङ"

