#: medianotifier/medianotifier.cpp:207
#, qt-format
msgid ""
"An autorun file as been found on your '%1'. Do you want to execute it?\n"
"Note that executing a file on a medium may compromise your system's security"
msgstr ""
"एउटा स्वत: सञ्चालित फाइल तपाईँको '%1' मा फेला पर्यो । तपाईँ यसलाई कार्यान्वयन गर्न चाहनुहुन्छ ?\n"
"याद गर्नुहोस् कि माध्यममा फाइल कार्यान्वयन गर्नाले तपाईँको प्रणालीको सुरक्षासँग सम्झौता गर्न सक्छ"

#: medianotifier/medianotifier.cpp:211
#, qt-format
msgid "Autorun - %1"
msgstr "स्वत: सञ्चालन - %1"

#: medianotifier/medianotifier.cpp:276
#, qt-format
msgid ""
"An autoopen file as been found on your '%1'. Do you want to open '%2'?\n"
"Note that opening a file on a medium may compromise your system's security"
msgstr ""
"एउटा स्वत: सञ्चालित फाइल तपाईँको '%1' मा फेला पर्यो । तपाईँ '%2' खोल्न चाहनुहुन्छ ?\n"
"याद गर्नुहोस् कि माध्यममा फाइल खोल्नाले तपाईँको प्रणालीको सुरक्षासँग सम्झौता गर्न सक्छ"

#: medianotifier/medianotifier.cpp:280
#, qt-format
