#: kcmxinerama.cpp:53
msgid "kcmxinerama"
msgstr "kcmxinerama"

#: kcmxinerama.cpp:54
msgid "KDE Multiple Monitor Configurator"
msgstr "केडीई बहुँविध मोनिटर कन्फिगुरेटर"

#: kcmxinerama.cpp:56
msgid "(c) 2002-2003 George Staikos"
msgstr "(सी) २००२-२००३ जर्ज स्टाइकोस"

#: kcmxinerama.cpp:58
msgid "George Staikos"
msgstr "जर्ज स्टाइकोस"

#: kcmxinerama.cpp:61
msgid ""
"<h1>Multiple Monitors</h1> This module allows you to configure KDE support "
"for multiple monitors."
msgstr ""
"<h1>बहुँविध मोनिटर</h1> यस मोड्युलले तपाईँलाई बहुँविध मोनिटरका लागि केडीई समर्थन "
"कन्फिगर गर्न अनुमति दिन्छ ।"

#: kcmxinerama.cpp:85
#, qt-format
msgid "Display %1"
msgstr "%1 प्रदर्शन गर्नुहोस्"

#: kcmxinerama.cpp:96
msgid "Display Containing the Pointer"
msgstr "सूचक समाविष्ट गरेको प्रदर्शन गर्नुहोस्"

#: kcmxinerama.cpp:109
msgid ""
"<qt><p>This module is only for configuring systems with a single desktop "
"spread across multiple monitors. You do not appear to have this "
"configuration.</p></qt>"
msgstr ""
"<qt><p>यो मोड्युल बहुविध मोनिटर वारपार एकल डेस्कटप स्प्रेडसँग प्रणालीहरू कन्फिगर गर्नु "
"मात्र हो । तपाईँसँग यो कन्फिगरेसन हुन तपाईँ देखा नपर्नुहोस् ।</p></qt>"

#: kcmxinerama.cpp:185
msgid "Some settings may affect only newly started applications."
msgstr "तपाईँको सेटिङले भर्खरै सुरु गरिएको अनुप्रयोगलाई मात्र असर गर्नेछ ।"

#: kcmxinerama.cpp:185
msgid "KDE Multiple Monitors"
msgstr "केडीई बहुँविध मोनिटर"

