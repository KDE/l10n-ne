#: dockbarextension.cpp:339
#, qt-format
msgid "The following dockbar applets could not be started: %1"
msgstr "निम्न डकबार एप्लेटहरू सुरुआत हुन सकेन: %1"

#: dockbarextension.cpp:339
msgid "kicker: information"
msgstr "kicker: सूचना"

#: dockcontainer.cpp:153
#, qt-format
msgid "Enter Command Line for Applet %1.%2"
msgstr "%1 एप्लेटका लागि आदेश लाइन प्रविष्ट गर्नुहोस् %2"

#: dockcontainer.cpp:154
msgid ""
"This applet does not behave correctly and the dockbar was unable to find the "
"command line necessary to launch it the next time KDE starts up"
msgstr ""
"यो एप्लेटले ठीक व्यवहार गर्दैन र पछिल्लो KDE सुरु सुरुआत गर्न आवश्यक आदेशलाइन फेला पार्न "
"डकबार अक्षम थियो"

#: dockcontainer.cpp:175
msgid "Kill This Applet"
msgstr "यो एप्लेट नष्ट गर्नुहोस्"

#: dockcontainer.cpp:176
msgid "Change Command"
msgstr "आदेश परिवर्तन गर्नुहोस्"
