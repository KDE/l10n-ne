#: knewthemedlg.cpp:31
msgid "New Theme"
msgstr "नयाँ विषयवस्तु"

#: kthememanager.cpp:58
msgid "KDE Theme Manager"
msgstr "केडीई विषयवस्तु प्रबन्धक"

#: kthememanager.cpp:59 kthememanager.cpp:65
msgid ""
"This control module handles installing, removing and creating visual KDE "
"themes."
msgstr ""
"यो नियन्त्रण मोड्युलले दृश्यात्मक केडीई विषयवस्तुहरू स्थापना, हटाइ र सिर्जना ह्यान्डल गर्दछ ।"

#: kthememanager.cpp:219
msgid "Theme Files"
msgstr "विषयवस्तु फाइल"

#: kthememanager.cpp:220
msgid "Select Theme File"
msgstr "विषयवस्तु फाइल चयन गर्नुहोस्"

#: kthememanager.cpp:254
#, qt-format
msgid "Do you really want to remove the theme <b>%1</b>?"
msgstr "तपाईँ साँच्चै<b>%1</b> विषयवस्तु हटाउन चाहनुहुन्छ ?"

#: kthememanager.cpp:255
msgid "Remove Theme"
msgstr "विषयवस्तु हटाउनुहोस्"

#: kthememanager.cpp:277
msgid "My Theme"
msgstr "मेरो विषयवस्तु"

#: kthememanager.cpp:288
#, qt-format
msgid "Theme %1 already exists."
msgstr "%1 विषयवस्तु पहिले नै अवस्थित छ ।"

#: kthememanager.cpp:308
#, qt-format
msgid "Your theme has been successfully created in %1."
msgstr "तपाईँको विषयवस्तु सफलतापूर्वक %1 मा सिर्जना भयो ।"

#: kthememanager.cpp:309
msgid "Theme Created"
msgstr "विषयवस्तु सिर्जना गरियो"

#: kthememanager.cpp:311
msgid "An error occurred while creating your theme."
msgstr "तपाईँको विषयवस्तु सिर्जना गर्दा त्रुटि देखा पर्यो ।"

#: kthememanager.cpp:312
msgid "Theme Not Created"
msgstr "विषयवस्तु सिर्जना गरिएन"

#: kthememanager.cpp:339
msgid "This theme does not contain a preview."
msgstr "यो विषयवस्तुले पूर्वावलोकन समावेश गर्दैन ।"

#: kthememanager.cpp:343
#, qt-format
msgid "Author: %1<br>Email: %2<br>Version: %3<br>Homepage: %4"
msgstr "लेखक: %1<br>इमेल: %2<br>संस्करण: %3<br>गृहपृष्ठ: %4"

#: rc.cpp:3
msgid "Choose your visual KDE theme:"
msgstr "तपाईँको दृश्यात्मक केडीई विषयवस्तु छनोट गर्नुहोस्:"

#: rc.cpp:6
msgid "Get new themes..."
msgstr "नयाँ विषयवस्तु प्राप्त गर्नुहोस्..."

#: rc.cpp:9
msgid "http://themes.kde.org"
msgstr "http://themes.kde.org"

#: rc.cpp:12
msgid "Go to the KDE themes website"
msgstr "केडीई विषयवस्तुको वेबसाइटमा जानुहोस्"

#: rc.cpp:15
msgid "&Remove Theme"
msgstr "विषयवस्तु हटाउनुहोस्"

#: rc.cpp:18
msgid "Create &New Theme..."
msgstr "नयाँ विषयवस्तु सिर्जना गर्नुहोस्..."

#: rc.cpp:21
msgid "&Install New Theme..."
msgstr "नयाँ विषयवस्तु स्थापना गर्नुहोस्..."

#: rc.cpp:24
msgid "Theme"
msgstr "विषयवस्तु"

#: rc.cpp:27
msgid "Customize your theme:"
msgstr "तपाईँको विषयवस्तु अनुकूलन गर्नुहोस्:"

#: rc.cpp:31
msgid "Background"
msgstr "पृष्ठभूमि"

#: rc.cpp:34
msgid "Customize the desktop background"
msgstr "डेस्कटप पृष्ठभूमि अनुकूलन गर्नुहोस्"

#: rc.cpp:38
msgid "Colors"
msgstr "रङ"

#: rc.cpp:41
msgid "Customize colors"
msgstr "रङ अनुकूलन गर्नुहोस्"

#: rc.cpp:45
msgid "Style"
msgstr "शैली"

#: rc.cpp:48
msgid "Customize the widget style"
msgstr "विजेट शैली अनुकूलन गर्नुहोस्"

#: rc.cpp:52
msgid "Icons"
msgstr "प्रतिमा"

#: rc.cpp:55
msgid "Customize the icon theme"
msgstr "प्रतिमा विषयवस्तु अनुकूलन गर्नुहोस्"

#: rc.cpp:59
#, fuzzy
msgid "Fonts"
msgstr "प्रतिमा"

#: rc.cpp:62
msgid "Customize the font theme"
msgstr "फन्ट विषयवस्तु अनुकूलन गर्नुहोस्"

#: rc.cpp:66
msgid "Screen Saver"
msgstr "स्क्रिन सेभर"

#: rc.cpp:69
msgid "Customize the screen saver"
msgstr "स्क्रिन सेभर अनुकूलन गर्नुहोस्"

