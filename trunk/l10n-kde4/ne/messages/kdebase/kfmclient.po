#: kfmclient.cpp:56
msgid "kfmclient"
msgstr "kfmclient"

#: kfmclient.cpp:57
msgid "KDE tool for opening URLs from the command line"
msgstr "आदेश रेखाबाट यूआरएल खोल्नका लागि केडीई उपकरण"

#: kfmclient.cpp:75
msgid "Non interactive use: no message boxes"
msgstr "अन्तरक्रियात्मक नभएको प्रयोग: कुनै सन्देश बाकस छैन"

#: kfmclient.cpp:77
msgid "Show available commands"
msgstr "उपलब्ध आदेश देखाउनुहोस्"

#: kfmclient.cpp:79
msgid "Command (see --commands)"
msgstr "आदेश (आदेश -- हेर्नुहोस्)"

#: kfmclient.cpp:81
msgid "Arguments for command"
msgstr "आदेशका लागि तर्क"

#: kfmclient.cpp:91
msgid ""
"\n"
"Syntax:\n"
msgstr ""
"\n"
"वाक्य संरचना:\n"

#: kfmclient.cpp:92
msgid ""
"  kfmclient openURL 'url' ['mimetype']\n"
"            # Opens a window showing 'url'.\n"
"            #  'url' may be a relative path\n"
"            #   or file name, such as . or subdir/\n"
"            #   If 'url' is omitted, $HOME is used instead.\n"
"\n"
msgstr ""
"  kfmclient openURL 'url' ['माइमप्रकार']\n"
"            # 'url' देखाउने सञ्झ्याल खोल्दछ ।\n"
"            #  'url' सापेक्षिक मार्ग हुन सक्छ\n"
"            #   वा फाइल नाम, जस्तै . वा subdir/\n"
"            #   यदि 'url' हटाइयो भने, सट्टामा $HOME प्रयोग हुन्छ ।\n"
"\n"

#: kfmclient.cpp:97
msgid ""
"            # If 'mimetype' is specified, it will be used to determine the\n"
"            #   component that Konqueror should use. For instance, set it "
"to\n"
"            #   text/html for a web page, to make it appear faster\n"
"\n"
msgstr ""
"            # यदि 'माइमप्रकार' निर्दिष्ट छ भने, कन्क्वेररले प्रयोग गरेको अवयव निर्धारण "
"गर्न\n"
"            #   यो प्रयोग गरिनेछ । उदाहरणका लागि, यसलाई चाँडो देखाउन, वेब पृष्ठका "
"लागि\n"
"            #   text/html मा सेट गर्नुहोस्\n"
"\n"

#: kfmclient.cpp:101
msgid ""
"  kfmclient newTab 'url' ['mimetype']\n"
"            # Same as above but opens a new tab with 'url' in an existing "
"Konqueror\n"
"            #   window on the current active desktop if possible.\n"
"\n"
msgstr ""
"  kfmclient newTab 'url' ['माइमप्रकार']\n"
"            # माथि दिए जस्तै तर एउटा अवस्थित कन्क्वेररमा 'url' सँगै नयाँ ट्याब खोल्दछ\n"
"            #   यदि सम्भव भए हालको सक्रिय डेस्कटपमा सञ्झ्याल ।\n"
"\n"

#: kfmclient.cpp:105
msgid ""
"  kfmclient openProfile 'profile' ['url']\n"
"            # Opens a window using the given profile.\n"
"            #   'profile' is a file under ~/.kde/share/apps/konqueror/"
"profiles.\n"
"            #   'url' is an optional URL to open.\n"
"\n"
msgstr ""
"  kfmclient openProfile 'profile' ['url']\n"
"            # दिएको प्रोफाइल प्रयोग गरेर सञ्झ्याल खोल्दछ ।\n"
"            #   'प्रोफाइल' ~/.kde/share/apps/konqueror/profiles अन्तर्गतको फाइल "
"हो ।\n"
"            #   'url' खोल्नका लागि एउटा वैकल्पिक यूआरएल हो ।\n"
"\n"

#: kfmclient.cpp:423
#, qt-format
msgid "Profile %1 not found\n"
msgstr "%1 प्रोफाइल फेला परेन\n"

#: kfmclient.cpp:454
msgid "Syntax Error: Not enough arguments\n"
msgstr "वाक्य संरचना त्रुटि: पर्याप्त तर्क छैन\n"

#: kfmclient.cpp:459
msgid "Syntax Error: Too many arguments\n"
msgstr "वाक्य संरचना त्रुटि: अति धेरै तर्क\n"

#: kfmclient.cpp:515
#, qt-format
msgid "Syntax Error: Unknown command '%1'\n"
msgstr "वाक्य संरचना त्रुटि: अज्ञात आदेश '%1'\n"

#~ msgid ""
#~ "  kfmclient openProperties 'url'\n"
#~ "            # Opens a properties menu\n"
#~ "\n"
#~ msgstr ""
#~ "  kfmclient openProperties 'url'\n"
#~ "            # विशेषता मेनु खोल्दछ\n"
#~ "\n"

#~ msgid ""
#~ "  kfmclient exec ['url' ['binding']]\n"
#~ "            # Tries to execute 'url'. 'url' may be a usual\n"
#~ "            #   URL, this URL will be opened. You may omit\n"
#~ "            #   'binding'. In this case the default binding\n"
#~ msgstr ""
#~ "  kfmclient exec ['url' ['बाइन्डिङ']]\n"
#~ "            # 'url' कार्यान्वयन गर्ने प्रयास गर्दछ । 'url' साबिकको URL\n"
#~ "            #   हुन सक्छ, यो URL खोलिनेछ । तपाईँले 'बाइन्डिङ'\n"
#~ "            #   हटाउँनुपर्नेछ । यो केसमा पूर्वनिर्धारित बाइन्डिङ हुन्छ\n"

#~ msgid ""
#~ "            #   is tried. Of course URL may be the URL of a\n"
#~ "            #   document, or it may be a *.desktop file.\n"
#~ msgstr ""
#~ "            #   प्रयास गरियो । वास्तवमा यूआरएल कागजातको\n"
#~ "            #   यूआरएल हो, वा यो *.डेस्कटप फाइल हुन सक्छ ।\n"

#~ msgid ""
#~ "            #   This way you could for example mount a device\n"
#~ "            #   by passing 'Mount default' as binding to \n"
#~ "            #   'cdrom.desktop'\n"
#~ "\n"
#~ msgstr ""
#~ "            #   यो तरिकाले तपाईँ सक्नुहुन्छ जस्तै उदाहरणका लागि 'सीडी रोम.डेस्कटप' "
#~ "मा\n"
#~ "            #   बाइन्डिङ गरे जस्तै 'माउन्ट पूर्वनिर्धारण' पास गरेर\n"
#~ "            #   यन्त्र माउन्ट गर्नुहोस्\n"
#~ "\n"

#~ msgid ""
#~ "  kfmclient move 'src' 'dest'\n"
#~ "            # Moves the URL 'src' to 'dest'.\n"
#~ "            #   'src' may be a list of URLs.\n"
#~ msgstr ""
#~ "  kfmclient ले 'src' 'dest' सार्दछ\n"
#~ "            # यूआरएलको 'src' 'dest'मा सार्दछ ।\n"
#~ "            #   'src' यूआरएलको सूची हुन सक्छ ।\n"

#~ msgid ""
#~ "  kfmclient download ['src']\n"
#~ "            # Copies the URL 'src' to a user specified location'.\n"
#~ "            #   'src' may be a list of URLs, if not present then\n"
#~ "            #   a URL will be requested.\n"
#~ "\n"
#~ msgstr ""
#~ "  kfmclient ले ['src'] डाउनलोड गर्दछ\n"
#~ "            # प्रयोगकर्ताको निर्दिष्ट स्थानमा यूआरएलको 'src' प्रतिलिपि गर्दछ ।\n"
#~ "            #   'src' यूआरएलको सूची हुन सक्छ, यदि प्रस्तुत भएन भने\n"
#~ "            #   एउटा यूआरएललाई अनुरोध गरिनेछ ।\n"
#~ "\n"

#~ msgid ""
#~ "  kfmclient copy 'src' 'dest'\n"
#~ "            # Copies the URL 'src' to 'dest'.\n"
#~ "            #   'src' may be a list of URLs.\n"
#~ "\n"
#~ msgstr ""
#~ "  kfmclient ले 'src' 'dest' प्रतिलिपि गर्दछ\n"
#~ "            # 'dest' मा यूआरएलको 'src' प्रतिलिपि गर्दछ ।\n"
#~ "            #   'src' यूआरएलको सूची हुन सकछ ।\n"
#~ "\n"

#~ msgid ""
#~ "  kfmclient sortDesktop\n"
#~ "            # Rearranges all icons on the desktop.\n"
#~ "\n"
#~ msgstr ""
#~ "  kfmclient क्रमबद्ध डेस्कटपदछ\n"
#~ "            # डेस्कटपमा सबै प्रतिमाहरू पुन: मिलाउँदछ ।\n"
#~ "\n"

#~ msgid ""
#~ "  kfmclient configure\n"
#~ "            # Re-read Konqueror's configuration.\n"
#~ "\n"
#~ msgstr ""
#~ "  kfmclient कन्फिगर\n"
#~ "            # कन्क्वेररको कन्फिगरेसन पुन-पढ्नुहोस् ।\n"
#~ "\n"

#~ msgid ""
#~ "  kfmclient configureDesktop\n"
#~ "            # Re-read kdesktop's configuration.\n"
#~ "\n"
#~ msgstr ""
#~ "  kfmclient कन्फिगर डेस्कटप\n"
#~ "            # के डेस्कटपको कन्फिगरेसन पुन-पढ्नुहोस् ।\n"
#~ "\n"

#~ msgid ""
#~ "*** Examples:\n"
#~ "  kfmclient exec file:/root/Desktop/cdrom.desktop \"Mount default\"\n"
#~ "             // Mounts the CD-ROM\n"
#~ "\n"
#~ msgstr ""
#~ "*** उदाहरणहरू:\n"
#~ "  kfmclient कार्यान्वयन file:/root/Desktop/cdrom.desktop \"Mount default\"\n"
#~ "             // ले सीडी रोम माउन्ट गर्दछ\n"
#~ "\n"

#~ msgid ""
#~ "  kfmclient exec file:/home/weis/data/test.html\n"
#~ "             // Opens the file with default binding\n"
#~ "\n"
#~ msgstr ""
#~ "  kfmclient कार्यान्वयन file:/home/weis/data/test.html\n"
#~ "             // ले पूर्वनिर्धारित बाइन्डिङसँगै फाइल खोल्दछ\n"
#~ "\n"

#~ msgid ""
#~ "  kfmclient exec file:/home/weis/data/test.html Netscape\n"
#~ "             // Opens the file with netscape\n"
#~ "\n"
#~ msgstr ""
#~ "  kfmclient कार्यान्वयन file:/home/weis/data/test.html Netscape\n"
#~ "             // ले नेटस्केपसँगै फाइल खोल्दछ\n"
#~ "\n"

#~ msgid ""
#~ "  kfmclient exec ftp://localhost/\n"
#~ "             // Opens new window with URL\n"
#~ "\n"
#~ msgstr ""
#~ "  kfmclient कार्यान्वयन ftp://localhost/\n"
#~ "             // ले यूआरएल सँगै नयाँ सञ्झ्याल खोल्दछ\n"
#~ "\n"

#~ msgid ""
#~ "  kfmclient exec file:/root/Desktop/emacs.desktop\n"
#~ "             // Starts emacs\n"
#~ "\n"
#~ msgstr ""
#~ "  kfmclient कार्यान्वयन file:/root/Desktop/emacs.desktop\n"
#~ "             // ले इम्याक्स सुरु गर्दछ\n"
#~ "\n"

#~ msgid ""
#~ "  kfmclient exec file:/root/Desktop/cdrom.desktop\n"
#~ "             // Opens the CD-ROM's mount directory\n"
#~ "\n"
#~ msgstr ""
#~ "  kfmclient कार्यान्वयन file:/root/Desktop/cdrom.desktop\n"
#~ "             // ले सीडी रोमको माउन्ट डाइरेक्टरी खोल्दछ\n"
#~ "\n"

#~ msgid ""
#~ "  kfmclient exec .\n"
#~ "             // Opens the current directory. Very convenient.\n"
#~ "\n"
#~ msgstr ""
#~ "  kfmclient कार्यान्वयन .\n"
#~ "             // ले हालको डाइरेक्टरी खोल्दछ । धेरै सुविधाजनक\n"
#~ "\n"

#~ msgid "Unable to download from an invalid URL."
#~ msgstr "एउटा अवैध यूआरएल बाट डाउनलोड गर्न अक्षम ।"
