#: medianotifier.cpp:188
#, fuzzy, qt-format
msgid ""
"An autorun file as been found on your '%1'. Do you want to execute it?\n"
"Note that executing a file on a medium may compromise your system's security"
msgstr ""
"तपाईँको '%1' मा स्वत: चल्ने फाइल फेला परेको छ । के तपाईँ यसलाई कार्यान्वयन गर्न "
"चाहनुहुन्छ?\n"
"याद गर्नुहोस् माध्यममा फाइल कार्यान्वयन गर्दा तपाईँको प्रणाली सूरक्षामा जोखिम आउन सक्छ ।"

#: medianotifier.cpp:192
#, qt-format
msgid "Autorun - %1"
msgstr "स्वत: चल्ने - %1"

#: medianotifier.cpp:261
#, fuzzy, qt-format
msgid ""
"An autoopen file as been found on your '%1'. Do you want to open '%2'?\n"
"Note that opening a file on a medium may compromise your system's security"
msgstr ""
"तपाईँको '%1' मा एउटा स्वत: खुल्ने फाइल फेला परेको छ । के तपाईँ '%2' खोल्न चाहनुहुन्छ?\n"
"याद गर्नुहोस् माध्यममा फाइल खोल्दा तपाईँको प्रणाली सूरक्षामा जोखिम आउन सक्छ ।"

#: medianotifier.cpp:265
#, qt-format
msgid "Autoopen - %1"
msgstr "स्वत: खुल्ने - %1"

