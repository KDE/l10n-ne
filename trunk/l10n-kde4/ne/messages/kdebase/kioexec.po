#: main.cpp:46
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr "KIO Exec - टाढाका फाइलहरू खोल्दछ, परिमार्जनहरू हेर्दछ, अपलोडका लागि सोध्दछ"

#: main.cpp:50
msgid "Treat URLs as local files and delete them afterwards"
msgstr "URL हरूलाई स्थानिय फाइलहरको रूपमा व्यवहार गर्नुहोस् र तिनीहरूलाई त्यसपछि मेट्नुहोस्"

#: main.cpp:51
msgid "Suggested file name for the downloaded file"
msgstr "डाउनलोड गरिएको फाइलका लागि सुझाव गरिएको फाइलनाम"

#: main.cpp:52
msgid "Command to execute"
msgstr "कार्यान्वयन गर्ने आदेश"

#: main.cpp:53
msgid "URL(s) or local file(s) used for 'command'"
msgstr "'आदेश' का लागि प्रयोग गरिने URL(हरू) वा स्थानिय फाइल(हरू)"

#: main.cpp:62
msgid "'command' expected.\n"
msgstr "'आदेश' अपेक्षा गरियो ।\n"

#: main.cpp:91
#, qt-format
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"URL %1\n"
"विकृत छ"

#: main.cpp:93
#, qt-format
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"--टेम्पफाइल स्वीचसँग टाढाको URL %1\n"
"अनुमति प्राप्त छैन"

#: main.cpp:222
#, qt-format
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"मानिएको अस्थायी फाइल\n"
"%1\n"
"परिमर्जित गरिएको छ ।\n"
"तपाईँ अझै यसलाई मेट्न चाहनुहुन्छ ?"

#: main.cpp:223 main.cpp:230
msgid "File Changed"
msgstr "फाइल परिवर्तन गरियो"

#: main.cpp:223
msgid "Do Not Delete"
msgstr "नमेट्नुहोस्"

#: main.cpp:229
#, qt-format
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"फाइल\n"
"%1\n"
"परिमार्जन गरिएको छ ।\n"
"के तपाईँ परिवर्तनहरू अपलोड गर्न चाहनुहन्छ ?"

#: main.cpp:230
msgid "Upload"
msgstr "अपलोड"

#: main.cpp:230
msgid "Do Not Upload"
msgstr "अपलोड नगर्नुहोस्"

#: main.cpp:258
msgid "KIOExec"
msgstr "KIOExec"

