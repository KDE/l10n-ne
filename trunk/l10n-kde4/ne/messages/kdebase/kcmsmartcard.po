msgstr "PCSCLite कन्फिगरेसन"

#. i18n: tag string
#. i18n: file smartcardbase.ui line 251
#: rc.cpp:54
msgid ""
"To add new readers you have to modify /etc/readers.conf file and re-start "
"pcscd"
msgstr ""
"नयाँ रिडरहरू थप्न तपाईँले /etc/readers.conf फाइल परिमार्जन गर्नुपर्छ र pcscd पुन: सुरुआत "
"गर्नुपर्छ"

