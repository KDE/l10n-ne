msgstr "प्रदर्शन सेटिङ परिवर्तन यकिन गर्नुहोस्"

#: randr.cpp:166
msgid "&Accept Configuration"
msgstr "कन्फिगरेसन स्वीकार गर्नुहोस्"

#: randr.cpp:167
