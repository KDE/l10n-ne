#: main.cpp:104
msgid "Import bookmarks from a file in Mozilla format"
msgstr "मोजिला ढाँचामा फाइलबाट पुस्तकचिनो आयात गर्नुहोस्"

#: main.cpp:105
msgid "Import bookmarks from a file in Netscape (4.x and earlier) format"
msgstr "नेटस्केप (4.x र पहिलाका) ढाँचामा फाइलबाट पुस्तकचिनो आयात गर्नुहोस्"

#: main.cpp:106
msgid "Import bookmarks from a file in Internet Explorer's Favorites format"
msgstr "इन्टरनेट एक्सप्लोररको मनपर्ने ढाँचामा फाइलबाट पुस्तकचिनो आयात गर्नुहोस्"

#: main.cpp:107
msgid "Import bookmarks from a file in Opera format"
msgstr "ओपेरा ढाँचामा फाइलबाट पुस्तकचिनो आयात गर्नुहोस्"

#: main.cpp:108
msgid "Export bookmarks to a file in Mozilla format"
msgstr "मोजिला ढाँचामा फाइलमा पुस्तकचिनो निर्यात गर्नुहोस्"

#: main.cpp:109
msgid "Export bookmarks to a file in Netscape (4.x and earlier) format"
msgstr "नेटस्केप (4.x र द्रुत) ढाँचामा फाइलमा पुस्तकचिनोलाई निर्यात गर्नुहोस्"

#: main.cpp:110
msgid "Export bookmarks to a file in a printable HTML format"
msgstr "मुद्रणयोग्य एचटीएमएल ढाँचामा फाइलमा पुस्तकचिनो निर्यात गर्नुहोस्"

#: main.cpp:111
msgid "Export bookmarks to a file in Internet Explorer's Favorites format"
msgstr "इन्टरनेट एक्सप्लोररको मनपर्ने ढाँचामा फाइलमा पुस्तकचिनो निर्यात गर्नुहोस्"

#: main.cpp:112
msgid "Export bookmarks to a file in Opera format"
msgstr "ओपेरा ढाँचामा फाइलमा पुस्तकचिनो निर्यात गर्नुहोस्"

#: main.cpp:113
msgid "Open at the given position in the bookmarks file"
msgstr "पुस्तकचिनो भित्र दिएको स्थितिमा फाइल खोल्नुहोस्"

#: main.cpp:114
msgid "Set the user readable caption for example \"Konsole\""
msgstr "प्रयोगकर्ताको पढ्नयोग्य क्याप्सन सेट गर्नुहोस् जस्तै, उदाहरणका लागि \"कन्सोल\""

#: main.cpp:115
msgid "Hide all browser related functions"
msgstr "ब्राउजरसँग सम्बन्धित सबै प्रकार्य लुकाउनुहोस्"

#: main.cpp:116
msgid ""
"A unique name that represents this bookmark collection, usually the "
"kinstance name.\n"
"This should be \"konqueror\" for the konqueror bookmarks, \"kfile\" for "
"KFileDialog bookmarks, etc.\n"
"The final DBus object path is /KBookmarkManager/dbusObjectName"
msgstr ""
"यो पुस्तकचिनो सङ्ग्रहलाई प्रतिनिधित्व गर्ने एउटा अद्वितिय नाम, प्राय: kinstance नाम हुन्छ ।\n"
"कन्क्वेरर पुस्तकचिनोका लागि \"कन्क्वेरर\", केडीई फाइल संवाद पुस्तकचिनोका लागि \"केडीई फाइल\", इत्यादि ।\n"
"अन्तिम DBus वस्तु मार्ग /KBookmarkManager/dbusObjectName हो"

#: main.cpp:119
msgid "File to edit"
msgstr "सम्पादन गर्नुपर्ने फाइल"

#: main.cpp:157
msgid "You may only specify a single --export option."
msgstr "तपाईँले एकल --निर्यात विकल्प मात्र निर्दिष्ट गर्नुपर्नेछ ।"

#: main.cpp:162
msgid "You may only specify a single --import option."
msgstr "तपाईँले एकल --आयात विकल्प मात्र निर्दिष्ट गर्नुपर्नेछ ।"

