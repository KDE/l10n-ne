#: khtmlkttsd.cpp:51
msgid "&Speak Text"
msgstr "पाठ उच्चारण गर्नुहोस्"

#: khtmlkttsd.cpp:66
msgid "Cannot Read source"
msgstr "स्रोत पढ्न सकिँदैन"

#: khtmlkttsd.cpp:67
msgid ""
"You cannot read anything except web pages with\n"
"this plugin, sorry."
msgstr ""
"माफ गर्नुहोस्, तपाईँ यो प्लगइनसँगको वेब पृष्ठबाहेक\n"
"कुनै पनि पढ्न सक्नुहुन्न ।"

#: khtmlkttsd.cpp:75
msgid "Starting KTTSD Failed"
msgstr "KTTSD सुरुआत गर्दा असफल"

#: khtmlkttsd.cpp:85 khtmlkttsd.cpp:121 khtmlkttsd.cpp:125
msgid "DBUS Call Failed"
msgstr "DBUS बोलावट असफल भयो"

#: khtmlkttsd.cpp:86
msgid "The DBUS call supportsMarkup failed."
msgstr "DBUS बोलावट समर्थनको मार्कअप असफल भयो ।"

#: khtmlkttsd.cpp:122
msgid "The DBUS call setText failed."
msgstr "DBUS बोलावट सेट पाठ असफल भयो ।"

#: khtmlkttsd.cpp:126
msgid "The DBUS call startText failed."
msgstr "DCOP बोलावट सुरुआत पाठ असफल भयो ।"

