msgstr "सत्रमा ताल्चा लाग्दैन, त्यस्तै ताल्चा खोल्न असम्भव हुनेछ:\n"

#: lock/lockprocess.cc:743
msgid "Cannot start <i>kcheckpass</i>."
msgstr "<i>kcheckpass</i> सुरु गर्न सकिदैँन ।"

#: lock/lockprocess.cc:744
