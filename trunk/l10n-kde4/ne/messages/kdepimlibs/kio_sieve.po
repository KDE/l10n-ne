#: sieve.cpp:317
#, kde-format
msgid "Connecting to %1..."
msgstr " %1 मा जडान गर्दैछ..."

#: sieve.cpp:320
msgid "The connection to the server was lost."
msgstr "सर्भरको जडान छुटेको थियो ।"

#: sieve.cpp:332
msgid "Server identification failed."
msgstr "सर्भर पहिचान गर्न असफल भयो ।"

#: sieve.cpp:359
msgid "Authenticating user..."
msgstr "प्रयोगकर्ता प्रमाणीकरण गर्दैछ..."

#: sieve.cpp:362
msgid "Authentication failed."
msgstr "प्रमाणीकरण असफल भयो ।"

#: sieve.cpp:423
#, fuzzy
#| msgid "Done."
msgctxt "special command completed"
msgid "Done."
msgstr "पूरा भयो ।"

#: sieve.cpp:435
msgid "Activating script..."
msgstr "स्क्रिप्ट सक्रिय पार्दैछ..."

#: sieve.cpp:451
msgid "There was an error activating the script."
msgstr "स्क्रिप्ट सक्रिय पार्दा त्यहाँ एउटा त्रुटि थियो ।"

#: sieve.cpp:469
msgid "There was an error deactivating the script."
msgstr "स्क्रिप्ट निस्क्रिय पार्दा त्यहाँ एउटा त्रुटि थियो ।"

#: sieve.cpp:497
msgid "Sending data..."
msgstr "डेटा पठाउदैछ..."

#: sieve.cpp:514
msgid "KIO data supply error."
msgstr "KIO डेटा वितरणमा त्रुटि ।"

#: sieve.cpp:541
msgid "Quota exceeded"
msgstr "भाग बढी भयो"

#: sieve.cpp:574 sieve.cpp:1092
msgid "Network error."
msgstr "सञ्जाल त्रुटि ।"

#: sieve.cpp:585
msgid "Verifying upload completion..."
msgstr "अनलोड समापन रुजु गर्दैछ..."

#: sieve.cpp:611 sieve.cpp:619
#, kde-format
msgid ""
"The script did not upload successfully.\n"
"This is probably due to errors in the script.\n"
"The server responded:\n"
"%1"
msgstr ""
"स्क्रिप्ट सफलतापूर्वक अनलोड गर्न सकेन ।\n"
"यो सम्भवत: स्क्रिप्टमा त्रुटिका कारणले हुन सक्छ ।\n"
"सर्भरले प्रतिक्रिया दियो:\n"
"%1"

#: sieve.cpp:624 sieve.cpp:629
msgid ""
"The script did not upload successfully.\n"
"The script may contain errors."
msgstr ""
"स्क्रिप्ट सफलतापूर्वक अनलोड गर्न सकेन ।\n"
"स्क्रिप्टमा त्रुटि हुन सक्छ ।"

#: sieve.cpp:636
#, fuzzy
#| msgid "Done."
msgctxt "data upload complete"
msgid "Done."
msgstr "पूरा भयो ।"

#: sieve.cpp:664
msgid "Retrieving data..."
msgstr "डेटा पुन: प्राप्त गर्दैछ..."

#: sieve.cpp:713
msgid "Finishing up..."
msgstr "फिनिसिङ गर्दैछ..."

#: sieve.cpp:721
msgid "A protocol error occurred while trying to negotiate script downloading."
msgstr "स्क्रिप्ट डाउनलोडिङ गर्ने प्रयास गर्दा एउटा प्रोटोकल त्रुटि उत्पन्न भयो ।"

#: sieve.cpp:726
#, fuzzy
#| msgid "Done."
msgctxt "data retrival complete"
msgid "Done."
msgstr "पूरा भयो ।"

#: sieve.cpp:733
msgid "Folders are not supported."
msgstr "फोल्डर समर्थन गरिएका छैनन् ।"

#: sieve.cpp:741
msgid "Deleting file..."
msgstr "फाइल मेट्दैछ..."

#: sieve.cpp:756
msgid "The server would not delete the file."
msgstr "सर्भरले फाइल मेट्ने छैन ।"

#: sieve.cpp:760
#, fuzzy
#| msgid "Done."
msgctxt "file removal complete"
msgid "Done."
msgstr "पूरा भयो ।"

#: sieve.cpp:775
msgid "Cannot chmod to anything but 0700 (active) or 0600 (inactive script)."
msgstr ""
"कुनै वस्तुलाई chmod गर्न सकिँदैन तर 0700 (सक्रिय) वा 0600 (निस्क्रिय स्क्रिप्ट) हुनुपर्दछ ।"

#: sieve.cpp:894
msgid "No authentication details supplied."
msgstr "प्रमाणीकरण विवरण वितरण गरिएको छैन ।"

#: sieve.cpp:928
#, kde-format
msgid "An error occurred during authentication: %1"
msgstr "प्रमाणीकरण गर्दा एउटा त्रुटि उत्पन्न भयो: %1"

#: sieve.cpp:952
msgid "Sieve Authentication Details"
msgstr "प्रमाणीकरण विवरण छान्नुहोस्"

#: sieve.cpp:953
msgid ""
"Please enter your authentication details for your sieve account (usually the "
"same as your email password):"
msgstr ""
"कृपया तपाईँको छनौट खाताका लागि प्रमाणीकरण विस्तृत विवरण प्रविष्ट गर्नुहोस् (सधैँ तपाईँको "
"इमेल पासवर्डसँग समान हुन्छ):"

#: sieve.cpp:1024
#, kde-format
msgid ""
"A protocol error occurred during authentication.\n"
"Choose a different authentication method to %1."
msgstr ""
"प्रमाणीकरण गर्दा एउटा प्रोटोकल त्रुटि उत्पन्न भयो ।\n"
"%1 मा फरक प्रमाणीकरण बिधि रोज्नुहोस् ।"

#: sieve.cpp:1062
#, kde-format
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"The server responded:\n"
"%1"
msgstr ""
"प्रमाणीकरण असफल भयो ।\n"
"पासवर्ड गलत हुन सक्छ ।\n"
"सर्भरले प्रतिक्रिया दियो:\n"
"%1"

#: sieve.cpp:1143
msgid "A protocol error occurred."
msgstr "एउटा प्रोटोकल त्रुटि उत्पन्न भयो ।"
