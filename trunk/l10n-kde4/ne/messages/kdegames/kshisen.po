msgid "Select a tile"
msgstr "टायल चयन गर्नुहोस्"

#: app.cpp:125
msgid "Time: 0:00:00"
msgstr "समय: ०:००:००"

#: app.cpp:128
msgid "Removed: 0/0"
msgstr "हटाइएका: ०/०"

#: app.cpp:131
msgid "Cheat mode"
msgstr "छल्ने मोड"

#: app.cpp:188
msgid "This game is solvable."
msgstr "यो खेल समाधान योग्य छ ।"

#: app.cpp:190
msgid "This game is NOT solvable."
msgstr "यो खेल समाधान योग्य छैन ।"

#: app.cpp:264
msgid "No more moves possible!"
msgstr "अब चाल्न सम्भव छैन!"

#: app.cpp:264 app.cpp:301
msgid "End of Game"
msgstr "खेलको अन्त्य"

#: app.cpp:291
#, kde-format
msgid "Congratulations! You made it in %1:%2:%3"
msgstr "बधाइ छ! तपाईँले यसलाई %1:%2:%3 मा समाधान गर्नुभयो"

#: app.cpp:298
msgid ""
"You could have been in the higscores if you did not use Undo or Hint. Try "
"without them next time."
msgstr ""
"यदि तपाईँले पुर्वावस्थामा लैजाने र इशारा प्रयोग गरेको नभएमा उच्च प्राप्ताङ्क सूचीमा "
"हुनुहुन्थ्यो । पछिल्ला समयमा तिनीहरूलाई प्रयोग नगरी प्रयास गर्नुहोस् ।"

#: app.cpp:316
msgid "Select a matching tile"
msgstr "मिल्दो टायल चयन गर्नुहोस्"

#: app.cpp:321
msgid "Select the move you want by clicking on the blue line"
msgstr "निलो रेखामा क्लिक गरेर तपाईँले चाहेको चाल चयन गर्नुहोस्"

#: app.cpp:326
msgid "This tile did not match the one you selected"
msgstr "यो चाल तपाईँले चयन गरेको एकसँग मिलेन"

#: app.cpp:331
msgid "You cannot make this move"
msgstr "तपाईँले यो चाल चाल्न सक्नुहुदैँन"

#: app.cpp:341
msgid "(Paused) "
msgstr "(पज गरिएको) "

#: app.cpp:337
#, kde-format
msgid " Your time: %1:%2:%3 %4"
msgstr " तपाईँको समय: %1:%2:%3 %4"

#: app.cpp:348
#, kde-format
msgid " Removed: %1/%2 "
msgstr " हटाइयो: %1/%2 "

#: app.cpp:385
msgid ""
"You have made it into the \"Hall Of Fame\". Type in\n"
"your name so mankind will always remember\n"
"your cool rating."
msgstr ""
"तपाईँले यसलाई \"प्रसिद्धिको सूची\" मा यतिबनाउनु भएको छ । तपाईँको नाममा टाइप\n"
"गर्नुहोस् जसले तपाईँको राम्रो श्रेणी\n"
"मानव जगतले सधै सम्झने छन् ।"

