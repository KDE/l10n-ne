#: kbbinfowidget.cpp:58
msgid "Balls"
msgstr "बल"

#: kbbinfowidget.cpp:72
msgid "Score"
msgstr "प्राप्ताङ्क"

#: kbbinfowidget.cpp:109
#, qt-format
msgid "1 ball too much"
msgid_plural "%1 balls too much"
msgstr[0] "अति धेरै १ बल"
msgstr[1] "अति धेरै %1 बल"

#: kbbinfowidget.cpp:110
#, qt-format
msgid "You need to remove 1 ball from the black box."
msgid_plural "You need to remove %1 balls from the black box."
msgstr[0] "तपाईँले कालो बाकसबाट १ बल हटाउनु पर्दछ ।"
msgstr[1] "तपाईँले कालो बाकसबाट %1 बल हटाउनु पर्दछ ।"

#: kbbinfowidget.cpp:112
msgid "No more ball to place."
msgstr "धेरै बल राख्नु हुदैँन ।"

#: kbbinfowidget.cpp:113
msgid ""
"If you think you are done: click on \"Solve\" to check if you successful "
"guessed the ball positions!"
msgstr "यदि तपाईँले समाप्त गरेको ठानेमा: तपाईँले बल स्थिति सफलतापूर्वक अनुमान गरेको भएमा जाँच गर्न \"समाधान\" मा क्लिक गर्नुहोस्!"

#: kbbinfowidget.cpp:115
#, qt-format
msgid "1 ball to place"
msgid_plural "%1 balls to place"
msgstr[0] "राखिने १ बल"
msgstr[1] "राखिने %1 बल"

#: kbbinfowidget.cpp:116
#, qt-format
msgid "You need to place 1 more ball on the black box.\n"
msgid_plural "You need to place %1 more balls on the black box.\n"
msgstr[0] "तपाईँले कालो बाकसमा अझ १ बढी बल राख्नु पर्दछ ।\n"
msgstr[1] "तपाईँले कालो बाकसमा अझ %1 धेरै बल राख्नु पर्दछ ।\n"

#: kbbinfowidget.cpp:116
#, qt-format
msgid "You will be done after having found the positions of the ball."
msgid_plural "You will be done after having found the positions of the %1 balls."
msgstr[0] "तपाईँले बलको स्थिति फेला पारेपछि समाप्त गर्नुहुनेछ ।"
msgstr[1] "तपाईँले %1 बलको स्थिति फेला पारेपछि समाप्त गर्नुहुनेछ ।"

#: kbbmainwindow.cpp:118
msgid "Start tutorial"
msgstr "सुरु अभ्यास"

#: kbbmainwindow.cpp:123
msgid "New sandbox game"
msgstr "नयाँ बालुवा भाडोको खेल"

#: kbbmainwindow.cpp:132
msgid "Move Down"
msgstr "तल सार्नुहोस्"

#: kbbmainwindow.cpp:138
msgid "Move Up"
msgstr "माथि सार्नुहोस्"

#: kbbmainwindow.cpp:144
msgid "Move Left"
msgstr "बायाँ सार्नुहोस्"

#: kbbmainwindow.cpp:150
msgid "Move Right"
msgstr "दायाँ सार्नुहोस्"

#: kbbmainwindow.cpp:156
msgid "Switch ball or shoot laser"
msgstr "बललाई स्वीच गर्नुहोस् वा लेजर छोड्नुहोस्"

#: kbbmainwindow.cpp:162
msgid "Switch marker"
msgstr "मार्कर स्विच गर्नुहोस्"

#: kbbmainwindow.cpp:169
msgid "Run: yesno"
msgstr "दौड: हो होइन"

#: kbbmainwindow.cpp:170
msgid "Size: 00 x 00"
msgstr "साइज: ०० x ००"

#: kbbmainwindow.cpp:202
msgid "Run: Tutorial"
msgstr "दौड: अभ्यास"

#: kbbmainwindow.cpp:205
msgid "Run: Yes"
msgstr "दौड: हो"

#: kbbmainwindow.cpp:207
msgid "Run: No"
msgstr "दौड: होइन"

#: kbbmainwindow.cpp:210
#, qt-format
msgid "Size: %1 x %2"
msgstr "साइज: %1 x %2"

#: kbbmainwindow.cpp:279
msgid "Please finish the tutorial before solving the game!"
msgstr "कृपया खेल समाधान गर्नु भन्दा पहिला अभ्यास समाप्त गर्नुहोस्!"

#: kbbmainwindow.cpp:279
msgid "Solve"
msgstr "समाधान"

#: kbbmainwindow.cpp:282
#, qt-format
msgid "You should place %1 ball!\n"
msgid_plural "You should place %1 balls!\n"
msgstr[0] "तपाईँले %1 बल राख्नु पर्दछ!\n"
msgstr[1] "तपाईँले %1 बल राख्नु पर्दछ!\n"

#: kbbmainwindow.cpp:282
#, qt-format
msgid "You have placed %1.\n"
msgid_plural "You have placed %1.\n"
msgstr[0] "तपाईँले %1 राख्नुभएको छ ।\n"
msgstr[1] "तपाईँले %1 राख्नुभएको छ ।\n"

#: kbbmainwindow.cpp:282
msgid "Do you want to give up this game?"
msgstr "के तपाईँले साच्चै नै यो खेल छोड्न चाहनुहुन्छ?"

#: kbbmainwindow.cpp:282
msgid "Give Up"
msgstr "छोड्नुहोस्"

#: kbbmainwindow.cpp:296
#, qt-format
msgid ""
"Your final score is: %1.\n"
"You did really well!"
msgstr ""
"तपाईँको अन्तिम प्राप्ताङ्क: %1\n"
"तपाईँले धेरै राम्रो गर्नु भयो!"

#: kbbmainwindow.cpp:298
#, qt-format
msgid ""
"Your final score is: %1.\n"
"I guess you need more practice."
msgstr ""
"तपाईँको अन्तिम प्राप्ताङ्क: %1\n"
"मेरो विचारमा तपाईँले बढी अभ्यास गर्नु पर्दछ ।"

#: kbbmainwindow.cpp:335
msgid "This will be the end of the current game!"
msgstr "यो हालको खेलको अन्त्य हुनेछ!"

#: kbbmainwindow.cpp:335
msgid "End game"
msgstr "खेल अन्त्य गर्नुहोस्"

#: kbbtutorial.cpp:53
msgid "Tutorial"
msgstr "अभ्यास"

#: kbbtutorial.cpp:70
msgid "Displays the progress of the tutorial."
msgstr "अभ्यासको प्रगति प्रदर्शन गर्दछ ।"

#: kbbtutorial.cpp:92
msgid "Describes what you should do to reach the next tutorial step."
msgstr "पछिल्लो अभ्यास चरणमा पुग्न तपाईँले के गर्नुपर्दछ बर्णन गर्दछ ।"

#: kbbtutorial.cpp:99
msgid "&Previous"
msgstr "अघिल्लो"

#: kbbtutorial.cpp:100
msgid "Go back to the previous tutorial step."
msgstr "अघिल्लो अभ्यास चरणमा फर्कनुहोस् ।"

#: kbbtutorial.cpp:103
msgid "&Next"
msgstr "पछिल्लो"

#: kbbtutorial.cpp:104
msgid "Go to the next tutorial step."
msgstr "पछिल्लो अभ्यास चरणमा जानुहोस् ।"

#: kbbtutorial.cpp:164
msgid "Welcome!"
msgstr "स्वागत छ!"

#: kbbtutorial.cpp:164
msgid ""
"This tutorial will teach you how to play KBlackBox, using a simple example."
"<br /><br />We are playing with a square black box of 6 columns and 6 rows. "
"It has 3 balls <b>hidden</b> inside it and 24 laser probes around it.<br /"
"><br />The goal is to <b>find the positions of the balls.</b>"
msgstr ""
"यो अभ्यासले सामान्य उदाहरण प्रयोग गरेर, तपाईँलाई केडीई कालो बाकस कसरी खेल्ने सिकाउँछ ।"
"<br /><br />हामी ६ वटा स्तम्भ र ६ वटा पङ्क्ति भएको वर्गाकार कालो बाकसमा खेलिरहेका छौ ।"
"यसको भित्रपट्टी ३ वटा बल र यसको वरिपरि २४ वटा लेजर जाँचसियो <b>लुकेका</b> छन् ।<br /"
"><br />लक्ष्य <b>बलको स्थिति फेला पार्नु हो ।</b>"

#: kbbtutorial.cpp:164
msgid "Click on \"Next\""
msgstr "\"पछिल्लो\" मा क्लिक गर्नुहोस्"

#: kbbtutorial.cpp:169
msgid "Black box principles"
msgstr "कालो बाकसका सिद्धान्त"

#: kbbtutorial.cpp:169
msgid ""
"The balls are not visible, but we can shoot laser beams into the box at "
"different entry points and observe if the laser beams leave the box, and if "
"they do, where they come out.<br /><br />The laser beams interact with the "
"balls in various ways."
msgstr "बल देखिदैँनन्, तर हामीले बाकसको बिभिन्न प्रविष्टि बिन्दुमा लेजर किरण छाडेर लेजर किरणले बाकस छाडेमा, र तिनीहरूले त्यसो गरेमा, कहाँ बाहिर आउछन् हेर्न सक्छौँ ।<br /><br />लेजर किरणले बलसँग बिभिन्न तरिकाले प्रतिक्रिया गर्दछ ।"

#: kbbtutorial.cpp:169
msgid "Please click on the marked laser to shoot a beam into the black box."
msgstr "कृपया कालो बाकसमा किरण छाड्नका लागि चिनो लगाइएको लेजरमा क्लिक गर्नुहोस् ।"

#: kbbtutorial.cpp:174
msgid "No interaction"
msgstr "अन्तरक्रिया छैन"

#: kbbtutorial.cpp:174
msgid ""
"If a laser beam does not interact with any ball in the black box, it comes "
"out at the point opposite the entry point.<br /><br />Example: Suppose we "
"have 3 balls in the box as shown. They will not affect laser beam \"1\".<br /"
"><br />As the game progresses, each pair of entry/exit points is marked with "
"a different number."
msgstr ""
"यदि लेजर किरणले कालो बाकसका कुनै पनि बलसँग अन्तरक्रिया नगरेमा, यो प्रविष्टि बिन्दुको बिपरित बिन्दुमा जान्छ ।<br /><br />उदाहरण: अनुमान गर्नुहोस् तल देखाइएको कालो बाकसमा ३ वटा बल छन् । तिनीहरूले लेजर बिम \"1\" लाई प्रभाव पार्ने छैनन् ।<br /"
"><br />खेल अगाडि बढे अनुरुप, भित्रिने/बाहिरिनेको प्रत्येक जोडी फरक नम्बरबाट देखाइन्छ ।"

#: kbbtutorial.cpp:174
msgid "Now shoot the marked laser to discover the first kind of interaction."
msgstr "पहिलो प्रकारको अन्तरक्रिया पत्ता लगाउनका लागि अब चिनो लगाइएको लेजर छोड्नुहोस् ।"

#: kbbtutorial.cpp:182
msgid "Hit"
msgstr "हिट"

#: kbbtutorial.cpp:182
msgid ""
"A direct impact on a ball is called a \"<b>hit</b>\". A beam that hits a "
"ball does <b>not</b> emerge from the black box.<br /><br />Example: The beam "
"might have hit a ball at the position shown, but the exact position of the "
"hit is not certain: There are many other possibilities."
msgstr "बलमा प्रत्यक्ष असर पार्नुलाई \"<b>हिट</b>\" भनिन्छ । बललाई हिट गर्ने किरण कालो बाकसबाट <b>निस्कदैन</b> ।<br /><br />उदाहरण: किरणले देखाइएको स्थितिमा बललाई हिट गरेको हुनसक्छ, तर हिटको ठीक स्थान निश्चित हुँदैन: त्यहाँ अन्य धेरै विकल्प हुन्छन् ।"

#: kbbtutorial.cpp:182
msgid "Shoot the marked laser to discover the second kind of interaction."
msgstr "दोस्रो प्रकारको अन्तरक्रिया पत्ता लगाउन चिनो लगाइएको लेजर छाड्नुहोस् ।"

#: kbbtutorial.cpp:188
msgid "Simple deflection"
msgstr "सामान्य विचलन"

#: kbbtutorial.cpp:188
msgid ""
"The interaction of a beam that does not actually hit a ball, but aims to one "
"side of it, is called a \"<b>deflection</b>\". The angle of deflection of "
"the beam is always <b>90 degrees</b>.<br /><br />Example: The ball shown "
"would deflect beam \"2\" upward, as shown, but this is <b>not</b> the only "
"possibility."
msgstr "बललाई साच्चीकै हिट नगर्ने तर, बलको एक छेउमा पुग्ने किरणको अन्तरक्रियालाई, \"<b>विचलन</b>\" भनिन्छ । किरण विचलनको कोण सधैँ <b>९० डिग्री</b> हुन्छ ।<br /><br />उदाहरण: देखिएको बलले किरण \"2\" लाई, देखिए जस्तै माथितिर विचलन गर्दछ, तर यो मात्र एक सम्भावना <b>होइन</b> ।"

#: kbbtutorial.cpp:188
msgid ""
"Click on \"Next\" to see another combination of ball positions that deflects "
"the laser beam as shown."
msgstr "देखिए अनुरुपको किरण विचलन गर्ने बल स्थितिको अन्य संयोजन हेर्न \"पछिल्लो\" मा क्लिक गर्नुहोस् ।"

#: kbbtutorial.cpp:195
msgid "Several deflections"
msgstr "बिभिन्न विचलन"

#: kbbtutorial.cpp:195
msgid ""
"As you can see, interactions in the black box can be quite complicated!<br /"
">A laser beam entering and exiting at the positions \"2\" might have been "
"deflected by this configuration of 3 balls."
msgstr ""
"तपाईँले देखे जस्तै, कालो बाकसमा अन्तरक्रिया केही कठीन हुन सक्छन्!<br /"
">स्थिति \"2\" मा भित्र पस्ने र बाहिरिने एउटा लेजर किरण ३ बलको कन्फिगरेसनद्वारा विचलन भएको हुनसक्छ ।"

#: kbbtutorial.cpp:195
msgid "Shoot the marked laser to discover another kind of result."
msgstr "अर्को प्रकारको किरण पत्ता लगाउनका लागि चिनो लगाइएको किरण छोड्नुहोस् ।"

#: kbbtutorial.cpp:203
msgid "Reflection"
msgstr "परावर्तन"

#: kbbtutorial.cpp:203
msgid ""
"If the laser beam leaves the black box <b>at the entry point</b>, it has "
"been reflected backward inside the black box.<br /><br />Example: We have "
"placed 2 balls for you in a configuration that would lead to such a "
"reflection."
msgstr "यदि लेजर किरणले कालो बाकस <b>प्रविष्टि हुने बिन्दुमा</b> छोडेमा, यसलाई कालो बाकसको भित्रबाट पछाडि परावर्तन गरिएको हुन्छ ।<br /><br />उदाहरण: हामीले यो कन्फिगरेसनमा तपाईँका लागि त्यस्तो प्रकारको परावर्तन गर्ने २ वटा राखेका छौ ।"

#: kbbtutorial.cpp:203
msgid "Shoot the marked laser to see another backward reflection case."
msgstr "अन्य पछाडि परावर्तन हुने अवस्था हेर्न चिनो लगाइएको लेजर छोड्नुहोस् ।"

#: kbbtutorial.cpp:210
msgid "Special reflection"
msgstr "विशेष परावर्तन"

#: kbbtutorial.cpp:210
msgid ""
"If a ball is <b>at the edge of the box</b> (with no other ball nearby), a "
"beam which is aimed into the black box directly beside it causes a backward "
"reflection.<br /><br />Example: The configuration shown can cause a backward "
"reflection."
msgstr "यदि बल <b>कालो बाकसको किनारामा</b> (नजिकै अरु कुनै बल नहुँदा) छ भने, किरण कालो बाकसको नगीचको साटोमा सीधैँ यसमा लक्षित भएमा यसको कारणले पछिल्तिर परावर्तन हुन्छ ।<br /><br />उदाहरण: देखाइएको कन्फिगरेसनको कारणले पछिल्तिर परावर्तन हुनसक्छ ।"

#: kbbtutorial.cpp:210
msgid "Nearly done. Click on \"Next\"."
msgstr "लगभग समाप्त । \"पछिल्लो\" मा क्लिक गर्नुहोस् ।"

#: kbbtutorial.cpp:217
msgid "Marker for \"free position\""
msgstr "\"स्वतन्त्र\" स्थितिका लागि मार्कर"

#: kbbtutorial.cpp:217
msgid ""
"We are sure there are no balls in the first 2 columns. If there were any, "
"the beam entering at position \"1\" would hit a ball or be deflected by a "
"ball in column 2. You can mark a \"free position\" with a right mouse click "
"(see also keyboard shortcuts).<br /><br />Example: There are 12 markers in "
"the first 2 columns."
msgstr ""
"हामी पहिला २ स्तम्भमा बल नभएकोमा निश्चित छौँ । यदि त्यहाँ केही भएको भए, स्थिति \"1\" मा प्रविष्टि गरेको किरणले बललाई हिट गर्ने थियो वा बलद्वारा स्तम्भ २ मा विचलन हुने थियो । तपाईँले माउसको दायाँ बटन क्लिक गरेर \"स्वतन्त्र स्थिति\""
"(कुञ्जीपाटि सर्टकट पनि हेर्नुहोस्) मा चिनो लगाउन सक्नुहुन्छ ।<br /><br />उदाहरण: त्यहाँ पहिला २ स्तम्भमा 12 वटा मार्कर छन् ।"

#: kbbtutorial.cpp:217 kbbtutorial.cpp:226
msgid "Click on \"Next\"."
msgstr "\"पछिल्लो\" मा क्लिक गर्नुहोस् ।"

#: kbbtutorial.cpp:226
msgid "Marking balls"
msgstr "चिनो लगाउने बल"

#: kbbtutorial.cpp:226
msgid ""
"When you have worked out where a ball is, please use the left mouse button "
"to mark it. To remove a ball, use the left mouse button again. Last tip: If "
"you are not sure about a position, you can use a right click on a ball to "
"mark it as \"unsure\". (See also keyboard shortcuts.)<br /><br />Example: We "
"marked one position as sure, the other one as unsure."
msgstr "तपाईँले बल भएको ठाउँमा कार्य गरेपछि, यसलाई चिनो लगाउन माउसको बायाँ बटन प्रयोग गर्नुहोस् । बल हटाउनका लागि, माउसको बायाँ बटन फेरी प्रयोग गर्नुहोस् । अन्तिम टिप: तपाईँ स्थितिको बारेमा निश्चित नभएमा, यसलाई \"यकीन नभएको\" रुपमा चिनो लगाउन तपाईँले बलमा दायाँ क्लिक गरेर प्रयोग गर्न सक्नुहुन्छ । (कुञ्जीपाटि सर्टकट पनि हेर्नुहोस् ।)<br /><br />उदाहरण: हामीले एउटा स्थिति यकीन भएको, अर्को एकलाई यकीन नभएको रुपमा चिनो लगायौ ।"

#: kbbtutorial.cpp:233
msgid "Let us play!"
msgstr "खेल सुरु गर्नुहोस्!"

#: kbbtutorial.cpp:233
msgid ""
"<b>Congratulations!</b> You now know <b>all the rules</b> for KBlackBox.<br /"
"><br /><b>You can start to play.</b> Try to finish this tutorial game by "
"yourself!<br /><br />Tip: We have sent in enough beams to deduce the "
"positions of the 3 balls with certainty. Of course, you can use some more "
"shots if needed."
msgstr ""
"<b>बधाइ छ!</b> तपाईँले अहिले केडीई कालो बासकका लागि <b>सबै नियम</b> थाहा पाउनु भयो ।<br /"
"><br /><b>तपाईले खेल्न सुरु गर्न सक्नुहुन्छ ।</b> तपाईँ आफैँले यो अभ्यास खेल समाप्त गर्ने प्रयास गर्नुहोस्!<br /><br />टिप: हामीले निश्चितताका साथ ३ बलको स्थिति घटाउन पर्याप्त किरण पठाएका छौ । वास्तवमा, यदि आवश्यक भएमा तपाईँले केही धेरै किरण छोड्न पनि सक्नुहुन्छ ।"

#: kbbtutorial.cpp:233
msgid "Finish placing the balls and click on \"Solve\" when you are done!"
msgstr "तपाईँले खेल समाप्त गरेपछि बल राख्ने काम सिध्याउनुहोस् र \"समाधान\" मा क्लिक गर्नुहोस्!"

