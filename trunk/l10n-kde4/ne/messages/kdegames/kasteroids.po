#: main.cpp:21
msgid "KDE Space Game"
msgstr "केडीई रिक्तस्थान खेल"

#: main.cpp:25
msgid "KAsteroids"
msgstr "केडीई एस्टोरोइड"

#: rc.cpp:3 rc.cpp:6
msgid "Whether power upgrades can be shot."
msgstr "शक्ति अभिवर्द्धनले गोली हान्न सक्ने छ या छैन ।"

#: rc.cpp:9
msgid "The number of ships per game."
msgstr "प्रति खेलमा पानी जहाजको सङ्ख्या ।"

#: rc.cpp:12
msgid "Whether to play sounds."
msgstr "ध्वनी बजाउने या नबजाउने ।"

#: rc.cpp:15
msgid "Sound to play when a ship gets destroyed."
msgstr "पानी जहाज ध्वस्त हुँदा बजाउने ध्वनी ।"

#: rc.cpp:18
msgid "Sound to play when a rock gets destroyed."
msgstr "चट्टान ध्वस्त हुँदा बजाउने ध्वनी ।"

#: rc.cpp:19
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Mahesh Subedi"

#: rc.cpp:20
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "submanesh@gmail.com"

#: toplevel.cpp:109
msgid "Score"
msgstr "प्राप्ताङ्क"

#: toplevel.cpp:123
msgid "Level"
msgstr "स्तर"

#: toplevel.cpp:137
msgid "Ships"
msgstr "पानी जहाज"

#: toplevel.cpp:239
msgid "Fuel"
msgstr "इन्धन"

#: toplevel.cpp:301
msgid "Thrust"
msgstr "धक्का"

#: toplevel.cpp:305
msgid "Rotate Left"
msgstr "बायाँ घुमाउनुहोस्"

#: toplevel.cpp:309
msgid "Rotate Right"
msgstr "दायाँ घुमाउनुहोस्"

#: toplevel.cpp:313
msgid "Shoot"
msgstr "गोली"

#: toplevel.cpp:317
msgid "Brake"
msgstr "विच्छेद"

#: toplevel.cpp:321
msgid "Shield"
msgstr "रक्षक"

#: toplevel.cpp:340
msgid "Launch"
msgstr "सुरुआत गर्नुहोस्"

#: toplevel.cpp:512 toplevel.cpp:606
#, qt-format
msgid "Press %1 to launch."
msgstr "सुरुआत गर्न %1 थिच्नुहोस् ।"

#: toplevel.cpp:537
#, qt-format
msgid "Ship Destroyed. Press %1 to launch."
msgstr "पानी जहाज ध्वस्त भयो । सुरुआत गर्न %1 थिच्नुहोस्"

#: toplevel.cpp:543
msgid "Game Over!"
msgstr "खेल समाप्त!"

#: toplevel.cpp:628
msgid "Start new game with"
msgstr "नयाँ खेल सुरु गर्नुहोस्"

#: toplevel.cpp:633
msgid " ships."
msgstr " पानी जहाज ।"

#: toplevel.cpp:640
msgid "Show highscores on Game Over"
msgstr "खेलको समाप्तिमा उच्च प्राप्ताङ्क देखाउनुहोस्"

#: toplevel.cpp:642
msgid "Player can destroy Powerups"
msgstr "खेलाडीले पावरअप ध्वस्त गर्न सक्दछ"

#: toplevel.cpp:651
msgid "General"
msgstr "साधारण"

#: toplevel.cpp:671
#, qt-format
msgid ""
"Game Over\n"
"\n"
"Shots fired:\t%1\n"
"  Hit:\t%2\n"
"  Missed:\t%3\n"
"Hit ratio:\t%4 %\t\t"
msgstr ""
"खेल समाप्त\n"
"\n"
"हानेको गोली:\t%1\n"
"  लागेको:\t%2\n"
"  नलागेको:\t%3\n"
"लागेको अनुपात:\t%4 %\t\t"

#: toplevel.cpp:695
msgid "KAsteroids is paused."
msgstr "केडीई एस्टेरोइड पज गरिएको छ ।"

#: toplevel.cpp:696
msgid "Paused"
msgstr "पज गरिएको"
