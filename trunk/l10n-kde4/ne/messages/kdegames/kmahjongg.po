#: boardwidget.cpp:68
#, qt-format
msgid ""
"An error occurred when loading the board layout %1\n"
"KMahjongg will continue with the default layout."
msgstr ""
"%1 बोर्ड सजावट लोड गर्दा त्रुटि उत्पन्न भयो\n"
"केडीई मोहजोङ्ग पूर्वनिर्धारित सजावटमा जारी रहनेछ ।"

#: boardwidget.cpp:150
#, qt-format
msgid ""
"KMahjongg could not locate the file: %1\n"
"or the default file of type: %2\n"
"KMahjongg will now terminate"
msgstr ""
"केडीई मोहजिङ्गले फाइल तोक्न सकेन: %1\n"
"वा पूर्वनिर्धारित फाइल वा प्रकार: %2\n"
"केडीई मोहजोङ्ग अब अन्त्य हुनेछ"

#: boardwidget.cpp:614
msgid "Undo operation done successfully."
msgstr "पूर्वस्थितिमा फर्काउने काम सफलतापूर्वक सम्पन्न भयो ।"

#: boardwidget.cpp:618
msgid "What do you want to undo? You have done nothing!"
msgstr "तपाईँले पूर्वस्थितिमा फर्काउन के गर्न चाहनुहुन्छ? तपाईँले केही पनि गर्नु भएको छैन!"

#: boardwidget.cpp:637
msgid "Sorry, you have lost the game."
msgstr "माफ गर्नुहोस्, तपाईँले खेल हार्नु भएको छ ।"

#: boardwidget.cpp:682
msgid "Demo mode. Click mousebutton to stop."
msgstr "डेमो मोड । रोक्नका लागि माउस बटन क्लिक गर्नुहोस् ।"

#: boardwidget.cpp:691
msgid "Now it is you again."
msgstr "अब फेरि यो तपाईँ हो ।"

#: boardwidget.cpp:714
msgid "Your computer has lost the game."
msgstr "तपाईँको कम्प्युटरले खेल हारेको छ ।"

#: boardwidget.cpp:809
msgid "Congratulations. You have won!"
msgstr "बधाइ छ । तपाईँले जित्नु भयो!"

#: boardwidget.cpp:871
msgid "Calculating new game..."
msgstr "नयाँ खेल गणना गर्दैछ..."

#: boardwidget.cpp:876
msgid "Error converting board information!"
msgstr "बोर्ड जानकारी रुपान्तरण गर्दा त्रुटि!"

#: boardwidget.cpp:903
msgid "Ready. Now it is your turn."
msgstr "तयार । अब तपाईँको पालो हो ।"

#: boardwidget.cpp:910
msgid "Error generating new game!"
msgstr "नयाँ खेल उत्पन्न गर्दा त्रुटि!"

#: boardwidget.cpp:1067
msgid "Game over: You have no moves left."
msgstr "खेल समाप्त: तपाईँका लागि चाल बाँकी छैन ।"

