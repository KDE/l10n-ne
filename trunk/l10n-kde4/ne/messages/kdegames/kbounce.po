#: gamewidget.cpp:338
msgid ""
"Welcome to KBounce.\n"
" Press Ctrl+N or space to start a game"
msgstr ""
"केडीई बाउन्समा स्वागत छ ।\n"
" खेल सुरु गर्न Ctrl+N वा space थिच्नुहोस्"

#: gamewidget.cpp:341
msgid "Paused"
msgstr "पज"

#: gamewidget.cpp:344
#, kde-format
msgid "You have successfully cleared more than %1% of the board\n"
msgstr "तपाईँले सफलतापूर्वक बोर्डको %1% भन्दा बढी भाग खाली गर्नुभएको छ ।\n"

#: gamewidget.cpp:345
#, kde-format
msgid "%1 points: %2 points per remaining life\n"
msgstr "%1 बिन्दु: बाँकी प्रत्येक जीवनका लागि %2 अङ्क\n"

#: gamewidget.cpp:346
#, kde-format
msgid "%1 points: Bonus\n"
msgstr "%1 अङ्क: लाभांश\n"

#: gamewidget.cpp:347
#, kde-format
msgid "%1 points: Total score for this level\n"
msgstr "%1 अङ्क: यो स्तरका लागि जम्मा प्राप्ताङ्क\n"

#: gamewidget.cpp:348
#, kde-format
msgid "On to level %1. Remember you get %2 lives this time!"
msgstr "%1 स्तरमा । यो समयमा तपाईँले %2 जीवन प्राप्त गरेको सम्झनुहोस्!"

#: gamewidget.cpp:351
msgid "Game over."
msgstr "खेल समाप्त ।"

