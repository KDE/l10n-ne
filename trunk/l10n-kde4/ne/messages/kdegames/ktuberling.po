msgid "Could not save file."
msgstr "फाइल बचत गर्न सकेन ।"

#: toplevel.cpp:327
msgid ""
"*.xpm|UNIX Pixmaps (*.xpm)\n"
"*.jpg|JPEG Compressed Files (*.jpg)\n"
"*.png|Next Generation Pictures (*.png)\n"
"*.bmp|Windows Bitmaps (*.bmp)\n"
"*|All Picture Formats"
msgstr ""
"*.xpm|यूनिक्स पिक्सम्याप (*.xpm)\n"
"*.jpg|जेपीईजी सङ्कुचित फाइल (*.jpg)\n"
"*.png|पछिल्लो युगका तस्विर (*.png)\n"
"*.bmp|विन्डोज बिटम्याप (*.bmp)\n"
"*|सबै तस्विर ढाँचा"

#: toplevel.cpp:363
msgid "Unknown picture format."
msgstr "अज्ञात तस्विर ढाँचा ।"

#: toplevel.cpp:378
#, qt-format
msgid "Print %1"
msgstr "मुद्रण %1"

#: toplevel.cpp:383
msgid "Could not print picture."
msgstr "तस्विर मुद्रण गर्न सकेन ।"

#: toplevel.cpp:386
msgid "Picture successfully printed."
msgstr "तस्विर सफलतापूर्वक मुद्रण गरियो ।"

