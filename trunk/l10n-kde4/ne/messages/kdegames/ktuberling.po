msgstr "आवाज छैन"

#: toplevel.cpp:277
msgid ""
"The saved file is from an old version of KTuberling and unfortunately can "
"not be open with this version."
msgstr ""

#: toplevel.cpp:281
msgid "Could not load file."
msgstr "फाइल लोड गर्न सकेन ।"

#: toplevel.cpp:302 toplevel.cpp:339
msgid "Only saving to local files is currently supported."
msgstr "स्थानीय फाइलमा बचत भएका मात्र हाल समर्थित छन् ।"

