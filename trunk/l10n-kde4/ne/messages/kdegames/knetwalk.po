#: mainwindow.cpp:227
#, fuzzy
#| msgid ""
#| "<h3>Rules of Game</h3><p>You are the system administrator and your goal "
#| "is to connect each computer to the central server.</p><p>Click the right "
#| "mouse's button for turning the cable in a clockwise direction, and left "
#| "mouse's button for turning the cable in a counter-clockwise direction.</"
#| "p><p>Start the LAN with as few turns as possible!</p>"
msgid ""
"<h3>Rules of Game</h3><p>You are the system administrator and your goal is "
"to connect each terminal and each cable to the central server.</p><p>Click "
"the right mouse's button for turning the cable in a clockwise direction, and "
"left mouse's button for turning the cable in a counter-clockwise direction.</"
"p><p>Start the LAN with as few turns as possible!</p>"
msgstr ""
"<h3>खेलको नियम</h3><p>तपाईँ प्रणाली प्रशासक हुनुहुन्छ र तपाईँको उद्देश्य भनेको सबै "
"कम्प्युटरलाई केन्द्रिय सर्भरमा जडान गर्ने हो ।</p><p>घडीको दिशामा तारलाई घुमाउन दायाँ "
"माउस बटन क्लिक गर्नुहोस् र घडीको विपरित दिशामा यसलाई घुमाउन बायाँ माउस बटन क्लिक "
"गर्नुहोस् </p><p> सम्भव भएसम्म केही घुमाएर LAN सुरु गर्नुहोस्!"

