#: rc.cpp:3038
msgid "Table Title"
msgstr "तालिका शीर्षक"

#. i18n: file: scripts/tablewizard.kmdr:320
#: rc.cpp:3042
msgid "Table Type"
msgstr "तालिका प्रकार"

#. i18n: file: scripts/tablewizard.kmdr:337
#: rc.cpp:3044
msgid "ta&ble"
msgstr "तालिका"

#. i18n: file: scripts/tablewizard.kmdr:358
#: rc.cpp:3046
msgid "Select this option to generate a formal table (table)."
msgstr "औपचारिक तालिका (तालिका) उत्पन्न गर्न यो विकल्प चयन गर्नुहोस् ।"

#. i18n: file: scripts/tablewizard.kmdr:369
#: rc.cpp:3048
msgid "&informaltable"
msgstr "अनौपचारिक तालिका"

#. i18n: file: scripts/tablewizard.kmdr:389
#: rc.cpp:3050
msgid "Select this option to generate an informal table (informaltable)."
msgstr "अनौपचारिक तालिका (अनौपचारिक तालिका) उत्पन्न गर्न यो विकल्प चयन गर्नुहोस् ।"

#. i18n: file: scripts/tablewizard.kmdr:409
#: rc.cpp:3052
msgid ""
"<qt>\n"
"Select the table type:\n"
"<ul>\n"
"<li><b>informaltable:</b> the most used table type in KDE docs. A "
"informaltable does not contain title, table head or entry in the table of "
"contents.</li>\n"
"<li><b>table:</b> a complete and formal table type, including title, table "
"head and entry in the table of contents.</li>\n"
"</ul>\n"
"</qt>"
msgstr ""
"<qt>\n"
"तालिका प्रकार चयन गर्नुहोस्:\n"
"<ul>\n"
"<li><b>अनौपचारिक तालिका:</b> केडीई docs मा सबैभन्दा बढी प्रयोग गरिएको तालिका "
"प्रकार । अनौपचारिक तालिकामा शीर्षक, तालिका हेड वा तालिका सामाग्रीमा प्रविष्टि "
"समावेश हुदैन ।</li>\n"
"<li><b>तालिका:</b> शीर्षक, तालिका हेड र तालिका सामाग्रीमा प्रविष्टि समाविष्ट एउटा "
"पूर्णं र औपचारिक तालिका प्रकार ।</li>\n"
"</ul>\n"
"</qt>"

