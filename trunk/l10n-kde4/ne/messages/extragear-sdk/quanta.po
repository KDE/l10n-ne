#. i18n: ectx: property (text), widget (QLabel, textLabel37)
#: rc.cpp:1334
msgid "Element t&ype expression:"
msgstr "तत्व प्रकार अभिव्यक्ति:"

#. i18n: file: quantacore/dialogs/dtepstructureeditdlgs.ui:294
#. i18n: ectx: property (toolTip), widget (QLabel, textLabel35)
#. i18n: file: quantacore/dialogs/dtepstructureeditdlgs.ui:551
#. i18n: ectx: property (toolTip), widget (KLineEdit, definitionRxEdit)
#. i18n: file: quantacore/dialogs/dtepstructureeditdlgs.ui:294
#. i18n: ectx: property (toolTip), widget (QLabel, textLabel35)
#. i18n: file: quantacore/dialogs/dtepstructureeditdlgs.ui:551
#. i18n: ectx: property (toolTip), widget (KLineEdit, definitionRxEdit)
#: rc.cpp:1337 rc.cpp:1480
msgid "Regular expression to find what belong to this group"
msgstr "यो समूहमा हुने वस्तुहरू फेला पार्ने नियमित अभिव्यक्ति"

#. i18n: file: quantacore/dialogs/dtepstructureeditdlgs.ui:300
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel35)
#. i18n: file: quantacore/dialogs/dtepstructureeditdlgs.ui:557
#. i18n: ectx: property (whatsThis), widget (KLineEdit, definitionRxEdit)
#. i18n: file: quantacore/dialogs/dtepstructureeditdlgs.ui:300
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel35)
#. i18n: file: quantacore/dialogs/dtepstructureeditdlgs.ui:557
#. i18n: ectx: property (whatsThis), widget (KLineEdit, definitionRxEdit)
#: rc.cpp:1340 rc.cpp:1483
msgid ""
"Regular expression used to find text areas in the document, which will "
"belong to this group. The first captured area shouldbe the actual name of "
"the group entry.<br>\n"
"Example for a <i>class</i> group:<br>\n"
"<b>\\bclass[\\\\s]+([0-9a-zA-Z_\\x7f-\\xff]*)[\\\\s]*</b><br>\n"
"The first captured area (between \"<b>(</b>\" and \"<b>)</b>\") holds the "
"class name."
msgstr ""
"नियिमित अभिव्यक्ति कागजातका पाठ क्षेत्र फेला पार्न प्रयोग गरिन्छ, जुन यो समूहमा हुनेछन् । "
"पहिला ग्रहण गरिएको क्षेत्र समूह प्रविष्टिको वास्तविक नाममा हुनुपर्नेछ ।<br>\n"
"उदाहरणका लागि <i>वर्ग/i> समूह:<br>\n"
"<b>\\bclass[\\\\s]+([0-9a-zA-Z_\\x7f-\\xff]*)[\\\\s]*</b><br>\n"
"पहिला ग्रहण गरिएको क्षेत्र (\"<b>(</b>\" र \"<b>)</b>\"बीचमा) वर्ग नाम हुन्छ ।"

#. i18n: file: quantacore/dialogs/dtepstructureeditdlgs.ui:303
#. i18n: ectx: property (text), widget (QLabel, textLabel35)
#: rc.cpp:1346
msgid "Definition e&xpression:"
msgstr "परिभाषा अभिव्यक्ति:"

#. i18n: file: quantacore/dialogs/dtepstructureeditdlgs.ui:332
#. i18n: ectx: property (toolTip), widget (QLabel, textLabel41)
#. i18n: file: quantacore/dialogs/dtepstructureeditdlgs.ui:345
#. i18n: ectx: property (toolTip), widget (KLineEdit, parentGroupEdit)
#. i18n: file: quantacore/dialogs/dtepstructureeditdlgs.ui:332
#. i18n: ectx: property (toolTip), widget (QLabel, textLabel41)
#. i18n: file: quantacore/dialogs/dtepstructureeditdlgs.ui:345
#. i18n: ectx: property (toolTip), widget (KLineEdit, parentGroupEdit)
#: rc.cpp:1364 rc.cpp:1373
msgid "The name of the group that may be the parent of this"
msgstr "यसको प्रमूल हुन सक्ने समूहको नाम"

#. i18n: file: quantacore/dialogs/dtepstructureeditdlgs.ui:335
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel41)
#. i18n: file: quantacore/dialogs/dtepstructureeditdlgs.ui:348
#. i18n: ectx: property (whatsThis), widget (KLineEdit, parentGroupEdit)
#. i18n: file: quantacore/dialogs/dtepstructureeditdlgs.ui:335
#. i18n: ectx: property (whatsThis), widget (QLabel, textLabel41)
#. i18n: file: quantacore/dialogs/dtepstructureeditdlgs.ui:348
#. i18n: ectx: property (whatsThis), widget (KLineEdit, parentGroupEdit)
#: rc.cpp:1367 rc.cpp:1376
msgid ""
"The name of the group that may be the parent of this. For example "
"<b>classes</b> might be a parent of <b>functions</b> in case of member "
"functions. This entry indicates this possible relationship and is used to "
"provide functionality like member autocompletion."
msgstr ""
