#. i18n: file: extrafiles2:213
#. i18n: file: extrafiles2:649
#: rc.cpp:4384 rc.cpp:4444
msgid ""
"The <b>A</b> element denotes an <i>anchor</i>--a hypertext link or the "
"destination of a link.\n"
"     The <b>HREF</b> attribute specifies a hypertext link to another "
"resource, such as an <i>HTML</i> document or a <i>JPEG</i> image.\n"
"   "
msgstr ""
"<b>A</b> तत्वले एउटा <i>एङ्कर</i>--एउटा हाइपरटेक्स्ट लिङ्क वा लिङ्कको गन्तव्य सङ्केत गर्छ "
"।\n"
"     <b>HREF</b> विशेषताले अन्य संसाधनमा हाइपरटेक्स्ट लिङ्क निर्दिष्ट गर्छ, जस्तै एउटा "
"<i>HTML</i> कागजात वा एउटा <i>JPEG</i> छवि ।\n"
"   "

#. i18n: file: extrafiles2:219
#. i18n: file: extrafiles2:655
#. i18n: file: extrafiles2:1464
#. i18n: file: extrafiles2:219
#. i18n: file: extrafiles2:655
#. i18n: file: extrafiles2:1464
#: rc.cpp:4388 rc.cpp:4448 rc.cpp:4519
msgid ""
"The <b>IMG</b> element specifies an <i>inline</i> image.\n"
"     The required <b>SRC</b> attribute specifies the location of the image.\n"
"   "
msgstr ""
"<b>IMG</b> तत्वले एउटा <i>inline</i> छवि निर्दिष्ट गर्छ ।\n"
"     आवश्यक <b>SRC</b> विशेषताले छविको स्थान निर्दिष्ट गर्दछ ।\n"
"   "

#. i18n: file: extrafiles2:225
#. i18n: file: extrafiles2:661
#. i18n: file: extrafiles2:225
#. i18n: file: extrafiles2:661
#: rc.cpp:4392 rc.cpp:4452
msgid ""
"The <b>HR</b> element defines a <i>horizontal rule</i> for visual browsers.\n"
"     While this element is inherently presentational, it can be used "
"structurally as a section divider.\n"
"   "
msgstr ""
"<b>HR</b> तत्वले दृश्यात्मक ब्राउजरका लागि एउटा <i>तेर्सो नियम</i> परिभाषित गर्छ ।\n"
"     यो तत्व अन्तर्निहित रुपमा प्रस्तुतयोग्य हुँदा, यसलाई सेक्सन बिभाजकका रुपमा संरचनात्मक "
"रुपमा प्रयोग गर्न सकिनेछ ।\n"
"   "

