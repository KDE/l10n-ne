"   "

#. i18n: file: extrafiles2:259
#. i18n: file: extrafiles2:695
#. i18n: file: extrafiles2:259
#. i18n: file: extrafiles2:695
#: rc.cpp:4411 rc.cpp:4471
msgid ""
"The <b>DIV ALIGN</b>=<i>justify</i>\n"
