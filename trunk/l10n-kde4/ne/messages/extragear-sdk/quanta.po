#. i18n: file: scripts/listwizard.kmdr:87
#: rc.cpp:1718
msgid ""
"Press this button to cancel the creation of the list or procedure. No action "
"will be performed."
msgstr ""
"सूची वा कार्यबिधिको सिर्जना रद्द गर्न यो बटन क्लिक गर्नुहोस् । कार्य सम्पादन हुने छैन ।"

#. i18n: file: scripts/listwizard.kmdr:123
#: rc.cpp:1722
msgid "Press this button to create the selected list or procedure."
msgstr "चयन गरिएका सूची वा कार्यबिधि सिर्जना गर्न यो बटन थिच्नुहोस् ।"

#. i18n: file: scripts/listwizard.kmdr:133
#: rc.cpp:1724
msgid "List Options"
msgstr "सूची विकल्प"

#. i18n: file: scripts/listwizard.kmdr:183
#. i18n: file: scripts/listwizard.kmdr:194
#. i18n: file: scripts/listwizard.kmdr:183
#. i18n: file: scripts/listwizard.kmdr:194
#: rc.cpp:1726 rc.cpp:1730
msgid ""
"Select or enter in this spin box the number of list entries or steps that "
"should be created by the wizard. After using the wizard, you can add (or "
"remove) more entries or steps manually."
msgstr ""
"विजार्डद्वारा सिर्जना गरिनुपर्ने सूची प्रविष्टिहरूको नम्बर वा चरणहरू यो स्पिन बाकसमा चयन "
"वा प्रविष्ट गर्नुहोस् । यो विजार्ड प्रयोग गरेपछि, तपाईँले धेरै प्रविष्टिहरू वा चरणहरू "
"म्यानुअली थप्न (वा हटाउन) सक्नुहुन्छ ।"

#. i18n: file: scripts/listwizard.kmdr:191
#: rc.cpp:1728
msgid "Number of list items or steps:"
msgstr "सूची वस्तुहरू वा चरणहरूको नम्बर:"

#. i18n: file: scripts/listwizard.kmdr:218
#: rc.cpp:1732
msgid ""
"<qt>\n"
"Select the list type:\n"
"<ul>\n"
"<li><b>variablelist:</b> a list with two sections for each item: the term "
"and the definition.</li>\n"
"<li><b>itemizedlist:</b> a list  used when the order of the items is not "
"important.</li>\n"
"<li><b>orderedlist:</b> a list  used when the order of the items is "
"important (for instance, a list of things in order of preference). Do not "
"use orderedlist to describe the steps required to perform an action.</li>\n"
"<li><b>procedure:</b> list of an sequence of ordered steps, describing to "
"the reader how to perform a task. You can add substeps later.</li>\n"
"</ul>\n"
"</qt>"
msgstr ""
"<qt>\n"
"सूची प्रकार चयन गर्नुहोस्:\n"
"<ul>\n"
"<li><b>variablelist:</b> प्रत्येक वस्तुका लागि दुइ खण्ड: सर्त र परिभाषाहरू भएको सूची "
"।</li>\n"
"<li><b>itemizedlist:</b>वस्तुहरूको क्रम महत्वपूर्ण नहुने बेला प्रयोग गरिने एउटा सूची ।</"
"li>\n"
"<li><b>orderedlist:</b> वस्तुहरूको क्रम महत्वपूर्ण हुने बेला प्रयोग गरिने एउटा सूची "
"(दृष्टन्तका लागि, प्राथमिकता क्रम अनुरुपका वस्तुहरूको सूची) । एउटा कार्य सम्पादन गर्न "
"आवश्यक चरणहरुको व्याख्या गर्न क्रमागत सूची प्रयोग नगर्नुहोस् ।</li>\n"
"<li><b>कार्यबिधि:</b>पाठकलाई कार्य सम्पादन गर्ने तरिका वर्णन गर्ने, क्रमागत चरणहरूको "
"अनुक्रमको सूची । तपाईँले सहायक चरणहरू पछि थप्न सक्नुहुन्छ ।</li>\n"
"</ul>\n"
"</qt>"

#. i18n: file: scripts/listwizard.kmdr:229
#: rc.cpp:1742
msgid "List Type"
msgstr "सूची प्रकार"

#. i18n: file: scripts/listwizard.kmdr:249
#: rc.cpp:1744
msgid "&procedure"
msgstr "कार्यबिधि"

#. i18n: file: scripts/listwizard.kmdr:285
#: rc.cpp:1746
msgid ""
"Select this option to create a procedure. A procedure is a sequence of "
"ordered steps, describing to the reader how to perform a task. You can add "
"nested substeps.\n"
"\n"
"Here is one example of a procedure:\n"
"\n"
"<procedure>\n"
"\n"
"<step><para>First step.</para></step>\n"
"\n"
"<step><para>Second step.</para>\n"
"<substeps>\n"
"<step><para>First substep of the second step.</para></step>\n"
"</substeps>\n"
"</step>\n"
"\n"
"</procedure>"
msgstr ""
"कार्यबिधि सिर्जना गर्न यो विल्प चयन गर्नुहोस् । कार्यबिधि, पाठकलाई कार्य सम्पादन गर्ने "
"तरिका वर्णन गर्ने क्रमागत चरणहरूको अनुक्रम हो । तपाईँले समान सहायक चरणहरू थप्न सक्नुहुन्छ "
"।\n"
"\n"
"यहाँ कार्यबिधिको एउटा उदाहरण छ:\n"
"\n"
"<procedure>\n"
"\n"
"<step><para>पहिलो चरण ।</para></step>\n"
"\n"
"<step><para>दोस्रो चरण ।</para>\n"
"<substeps>\n"
"<step><para>दोस्रो चरणको पहिलो सहायक चरण ।</para></step>\n"
"</substeps>\n"
"</step>\n"
"\n"
"</procedure>"

#. i18n: file: scripts/listwizard.kmdr:293
#: rc.cpp:1762
msgid "itemi&zedlist"
msgstr "itemizedlist"

#. i18n: file: scripts/listwizard.kmdr:326
#: rc.cpp:1764
msgid ""
"Select this option to create a itemizedlist. A itemizedlist is a list used "
"when the order of the items is not important.\n"
"\n"
"Here is one example of a itemizedlist:\n"
"\n"
"<itemizedlist>\n"
"\n"
"<listitem><para>\n"
"First item.\n"
"</para></listitem>\n"
"\n"
"<listitem><para>\n"
"Second item.\n"
"</para></listitem>\n"
"\n"
"</itemizedlist>"
msgstr ""
"itemizedlist सूची सिर्जना गर्न यो विकल्प चयन गर्नुहोस् । itemizedlist सुची वस्तुहरूको "
"क्रम महत्वपूर्ण नभएको बेला प्रयोग हुने सूची हो ।\n"
"\n"
"यहाँ itemizedlist को एउटा उदाहरण छ:\n"
"\n"
"<itemizedlist>\n"
"\n"
"<listitem><para>\n"
"पहिलो वस्तु ।\n"
"</para></listitem>\n"
"\n"
"<listitem><para>\n"
"दोस्रो वस्तु ।\n"
"</para></listitem>\n"
"\n"
"</itemizedlist>"

#. i18n: file: scripts/listwizard.kmdr:340
#: rc.cpp:1780
msgid "or&deredlist"
msgstr "orderedlist"

#. i18n: file: scripts/listwizard.kmdr:376
#: rc.cpp:1782
msgid ""
"Select this option to create a orderedlist. A orderedlist is a list  used "
"when the order of the items is important. A number will be associated with "
"each entry, in order, starting from one.\n"
"\n"
"Here is one example of a orderedlist:\n"
"\n"
"<orderedlist>\n"
"\n"
"<listitem><para>\n"
"First item.\n"
"</para></listitem>\n"
"\n"
"<listitem><para>\n"
"Second item.\n"
"</para></listitem>\n"
"\n"
"</orderedlist>"
msgstr ""
"orderedlist सिर्जना गर्न यो विकल्प चयन गर्नुहोस् । orderedlist वस्तुहरूको क्रम महत्वपूर्ण "
"भएको समयमा प्रयोग हुने सूची हो । एकबाट सुरु, गर्नका लागि, एउटा नम्बर प्रत्येक प्रविष्टिसँग "
"सम्बन्धित हुन्छ ।\n"
"\n"
"यहाँ orderedlist को एउटा उदाहरण छ:\n"
"\n"
"<orderedlist>\n"
"\n"
"<listitem><para>\n"
"पहिलो वस्तु ।\n"
"</para></listitem>\n"
"\n"
"<listitem><para>\n"
"दोस्रो वस्तु ।\n"
"</para></listitem>\n"
"\n"
"</orderedlist>"

#. i18n: file: scripts/listwizard.kmdr:387
#: rc.cpp:1798
msgid "&variablelist"
msgstr "variablelist"

#. i18n: file: scripts/listwizard.kmdr:426
#: rc.cpp:1800
msgid ""
"Select this option to create a variablelist. A variablelist is a list with "
"two sections for each item: the term (the tag used is <term>) and the "
"definition (the tag used is <listitem>). To mark each entry of the list, the "
"<varlistentry> tag is used.\n"
"\n"
"Here is one example of a variablelist:\n"
"\n"
"<variablelist>\n"
"\n"
"<varlistentry>\n"
"<term>Term text</term>\n"
"<listitem><para>Definition text.</para></listitem>\n"
"</varlistentry>\n"
"\n"
"</variablelist>"
msgstr ""
"variablelist सिर्जना गर्न यो विकल्प चयन गर्नुहोस् । variablelist प्रत्येक वस्तु: वस्तु "
"(ट्याग प्रयोग गरिएको <term> हो) र परिभाषा (ट्याग प्रयोग गरिएको<listitem> हो) का "
"लागि दुइ खण्डहरू भएको सूची हो । सुचीका प्रत्येक प्रविष्टिलाई चिनो लगाउन, "
"<varlistentry> ट्याग प्रयोग गरिन्छ ।\n"
"\n"
"यहाँ variablelist को एउटा उदाहरण छ:\n"
"\n"
"<variablelist>\n"
"\n"
"<varlistentry>\n"
"<term>वस्तु पाठ</term>\n"
"<listitem><para>परिभाषा पाठ ।</para></listitem>\n"
"</varlistentry>\n"
"\n"
"</variablelist>"

#. i18n: file: scripts/picturewizard.kmdr:18
#: rc.cpp:1813
msgid "Docbook Image Wizard"
msgstr "डकबुक छवि विजार्ज"

#. i18n: file: scripts/picturewizard.kmdr:87
#: rc.cpp:1817
msgid ""
"Press this button to cancel the creation of the image markup. No action will "
"be performed."
msgstr "छवि मार्कअपको सिर्जना रद्द गर्न यो बटन थिच्नुहोस् । कार्य सम्पादन गरिने छैन ।"

#. i18n: file: scripts/picturewizard.kmdr:103
#: rc.cpp:1819
msgid "O&K"
msgstr "ठीक छ"

#. i18n: file: scripts/picturewizard.kmdr:123
#: rc.cpp:1821
msgid "Press this button to create the image markup."
msgstr "छवि मार्कअप सिर्जना गर्न यो बटन थिच्नुहोस् ।"

#. i18n: file: scripts/picturewizard.kmdr:144
#: rc.cpp:1823
msgid ""
"<qt>\n"
"Select the type of markup appropriated to wrap your image:\n"
"<ul>\n"
"<li><b>screenshot:</b> used for screenshot images.</li>\n"
"<li><b>mediaobject:</b> used for all kinds of images which are not presented "
"inside the flow of text or table entry.</li>\n"
"<li><b>inlinemediaobject:</b> used for images which are presented in the "
"middle of flow of text, or in a table entry. Use mediaobject for all other "
"images.</li>\n"
"</ul>\n"
"</qt>"
msgstr ""
"<qt>\n"
"तपाईँको छवि बेर्नलाई ठीक हुने मार्कअपको प्रकार चयन गर्नुहोस्:\n"
"<ul>\n"
"<li><b>screenshot:</b> स्क्रिनसट छविहरूका लागि प्रयोग ।</li>\n"
"<li><b>mediaobject:</b> पाठको प्रवाह वा तालिका प्रविष्टिको भित्रपट्टी प्रस्तुत "
"नगरिएका सबै प्रकारका छविहरूका लागि प्रयोग ।</li>\n"
"<li><b>inlinemediaobject:</b> पाठको प्रवाहको बीचमा, वा तालिका प्रविष्टिमा प्रस्तुत "
"गरिएका छविहरूका लागि प्रयोग । अन्य सबै छविहरूका लागि mediaobject प्रयोग गर्नुहोस् ।</"
"li>\n"
"</ul>\n"
"</qt>"

#. i18n: file: scripts/picturewizard.kmdr:155
#: rc.cpp:1832
msgid "Wrapper Type"
msgstr "बेरुवा प्रकार"

#. i18n: file: scripts/picturewizard.kmdr:175
#: rc.cpp:1834
msgid "&screenshot"
msgstr "स्क्रिनसट"

#. i18n: file: scripts/picturewizard.kmdr:201
#: rc.cpp:1836
msgid ""
"Select this option to create the necessary markup for a screenshot. The "
"screenshot markup contains the mediaoption markup. Use for screenshots only. "
"Other figures and images should use inlinemediaobject if inside text, or "
"mediaobject to separate the image from the text."
msgstr ""
"स्क्रिनसटका लागि आवश्यक मार्कअप सिर्जना गर्न यो विकल्प चयन गर्नुहोस् । स्क्रिनसट "
"मार्कअपमा mediaoption मार्कअप समावेश हुन्छ । स्क्रिनसटका लागि मात्र प्रयग गर्नुहोस् "
"।पाठको भित्रपट्टी भएमा, वा पाठबाट छवि बिभाजन गर्ने mediaobject भएमा अन्य आकृति र "
"छविहरु inlinemediaobject मा प्रयोग गर्नुपर्छ ।"

#. i18n: file: scripts/picturewizard.kmdr:209
#: rc.cpp:1838
msgid "&mediaobject"
msgstr "mediaobject"

#. i18n: file: scripts/picturewizard.kmdr:226
#: rc.cpp:1840
msgid ""
"Select this option to create the necessary markup for a image outside the "
"normal flow of text. Check the \"Create caption, using the image description "
"text.\" box, to add text description for the image."
msgstr ""
"पाठको सामान्य प्रवाह भन्दा बाहिरपट्टी छविका लागि आवश्यक मार्कअप सिर्जना गर्न यो "
"विकल्प चयन गर्नुहोस् । छविका लागि पाठ वर्णन थप्नका लागि \"छवि वर्णन पाठ प्रयोग गरेर,"
"क्याप्सन सिर्जना गर्नुहोस् ।\" बाकस जाँच गर्नुहोस् ।"

#. i18n: file: scripts/picturewizard.kmdr:240
#: rc.cpp:1842
msgid "i&nlinemediaobject"
msgstr "inlinemediaobject"

#. i18n: file: scripts/picturewizard.kmdr:259
#: rc.cpp:1844
msgid ""
"Select this option to create the necessary markup for a image inside the "
"normal flow of text. You should use this option for images inside a table "
"entry (entry tag) or a paragraph (para tag). This option is specially suited "
"for small images, such as icons."
msgstr ""
"पाठको सामान्य प्रवाहको भित्रपट्टीको छविका लागि आवश्यक मार्कअप सिर्जना गर्न यो विकल्प "
"चयन गर्नुहोस् । तपाईँले यो विकल्प तालिका प्रविष्टि (प्रविष्टि ट्याग) वा अनुच्छेद (अनुच्छेद "
"ट्याग) भित्रपट्टीका छविका लागि प्रयोग गर्नुपर्छ । यो विकल्प विशेषता: प्रतिमा जस्तै साना "
"छविहरूका लागि उछित हुन्छ ।"

