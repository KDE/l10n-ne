#: main.cpp:29
#, kde-format
msgid "KPrinter"
msgstr "केडीई मुद्रक"

#: main.cpp:29
#, kde-format
msgid "A printer tool for KDE"
msgstr "केडीई का लागि मुद्रक"

#: main.cpp:32
#, kde-format
msgid "Make an internal copy of the files to print"
msgstr "मुद्रण गर्नका लागि फाइलको आन्तरिक प्रतिलिपि बनाउनुहोस्"

#: main.cpp:34
#, kde-format
msgid "Printer/destination to print on"
msgstr "मुद्रण गर्नका लागि मुद्रक/गन्तव्य"

#: main.cpp:36
#, kde-format
msgid "Title/Name for the print job"
msgstr "मुद्रण कार्यका लागि शीर्षक/नाम"

#: main.cpp:38
#, kde-format
msgid "Number of copies"
msgstr "प्रतिलिपिहरूको सङ्ख्या"

#: main.cpp:39
#, kde-format
msgid "Printer option"
msgstr "मुद्रक विकल्प"

#: main.cpp:40
#, kde-format
msgid "Job output mode (gui, console, none)"
msgstr "कार्य प्रतिफल शैली (जियुआइ, कन्सोल, कुनै होइन)"

#: main.cpp:41
#, kde-format
msgid "Print system to use (lpd, cups)"
msgstr "प्रयोगका लागि मुद्रण प्रणाली (एलपिडि, कप्स)"

#: main.cpp:42
#, kde-format
msgid "Allow printing from STDIN"
msgstr "STDIN बाट मुद्रण अनुमति दिनुहोस्"

#: main.cpp:43
#, kde-format
msgid "Do not show the print dialog (print directly)"
msgstr "मुद्रण संवाद नदेखाउनुहोस् (प्रत्यक्ष मुद्रण गर्नुहोस्)"

#: main.cpp:44
#, kde-format
msgid "Files to load"
msgstr "लोड गर्न फाइल"

#: printwrapper.cpp:63
#, kde-format
msgid "Print Information"
msgstr "मुद्रण सूचना"

#: printwrapper.cpp:64
#, kde-format
msgid "Print Warning"
msgstr "मुद्रण चेतावनी"

#: printwrapper.cpp:65
#, kde-format
msgid "Print Error"
msgstr "मुद्रण त्रुटि"

#: printwrapper.cpp:71
#, kde-format
msgid "Print info"
msgstr "मुद्रण सूचना"

#: printwrapper.cpp:71
#, kde-format
msgid "Print warning"
msgstr "मुद्रण चेतावनी"

#: printwrapper.cpp:71
#, kde-format
msgid "Print error"
msgstr "मुद्रण त्रुटि"

#: printwrapper.cpp:187
#, kde-format
msgid ""
"A file has been specified on the command line. Printing from STDIN will be "
"disabled."
msgstr "आदेश पङ्क्तिमा फाइल निर्दिष्ट गरियो । STDIN बाट मुद्रण गर्न अक्षम भयो।"

#: printwrapper.cpp:193
#, kde-format
msgid ""
"When using '--nodialog', you must at least specify one file to print or use "
"the '--stdin' flag."
msgstr ""
"जब '--nodialog' प्रयोग गरेको बेला, तपाईंले कम्तिमा एउटा फाइल मुद्रण गर्नका लागि "
"निर्दिष्ट गर्नुपर्दछ वा कुनै '--stdin' झण्डा प्रयोग गर्नुहोस्।"

#: printwrapper.cpp:242
#, kde-format
msgid "The specified printer or the default printer could not be found."
msgstr "निर्दिष्ट मुद्रक वा पूर्वनिर्धारित मुद्रक फेला पार्न सकिएन।"

#: printwrapper.cpp:244
#, kde-format
msgid "Operation aborted."
msgstr "सञ्चालन रद्द गरियो"

#: printwrapper.cpp:274
#, kde-format
msgid "Unable to construct the print dialog."
msgstr "मुद्रण संवाद निर्माण गर्न अक्षम"

#: printwrapper.cpp:315
#, kde-format
msgid "Multiple files (%1)"
msgstr "बहुविध फाइल (%1)"

#: printwrapper.cpp:322
#, kde-format
msgid "Nothing to print."
msgstr "मुद्रणका लागि केही छैन"

#: printwrapper.cpp:347
#, kde-format
msgid "Unable to open temporary file."
msgstr "अस्थायी फाइल खोल्न अक्षम"

#: printwrapper.cpp:362
#, kde-format
msgid "Stdin is empty, no job sent."
msgstr "Stdin खाली छ, कुनै कार्य पठाइएन"

#: printwrapper.cpp:374
#, kde-format
msgid "Unable to copy file %1."
msgstr "%1 फाइल प्रतिलिपि गर्न अक्षम"

#: printwrapper.cpp:391
#, kde-format
msgid "Error while printing files"
msgstr "फाइल मुद्रणमा त्रुटि"
