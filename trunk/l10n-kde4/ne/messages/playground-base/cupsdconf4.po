#: cupsd.conf.template.cpp:1
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Server name (ServerName)</b>\n"
"<p>\n"
"The hostname of your server, as advertised to the world.\n"
"By default CUPS will use the hostname of the system.</p>\n"
"<p>\n"
"To set the default server used by clients, see the client.conf file.</p>\n"
"<p>\n"
"<i>ex</i>: myhost.domain.com</p>\n"
msgstr ""
"<b>सर्भर नाम (ServerName)</b>\n"
"<p>\n"
"संसारमा विज्ञापन गरेको अनुरूपमा, तपाईँको सर्भरको होस्टनाम ।\n"
"पूर्वनिर्धारित रूपमा नै CUPS ले प्रणालीको होस्टनाम प्रयोग गर्दछ ।</p>\n"
"<p>\n"
"क्लाइन्टद्वारा प्रयोग गरिएको पूर्वनिर्धारित सर्भर सेट गर्न, client.conf फाइल हेर्नुहोस् ।</"
"p>\n"
"<p>\n"
"<i>ex</i>: myhost.domain.com</p>\n"

#: cupsd.conf.template.cpp:11
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Server administrator (ServerAdmin)</b>\n"
"<p>\n"
"The email address to send all complaints or problems to.\n"
"By default CUPS will use \"root@hostname\".</p>\n"
"<p>\n"
"<i>ex</i>: root@myhost.com</p>\n"
msgstr ""
"<b>सर्भर प्रशासक (ServerAdmin)</b>\n"
"<p>\n"
"सबै शिकायत वा समस्या पठाउन इमेल ठेगाना\n"
"पूर्वनिर्धारित रूपमा CUPS ले \"root@hostname\"प्रयोग गर्दछ ।</p>\n"
"<p>\n"
"<i>उदाहरण</i>: root@myhost.com</p>\n"

#: cupsd.conf.template.cpp:19
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Access log (AccessLog)</b>\n"
"<p>\n"
"The access log file; if this does not start with a leading /\n"
"then it is assumed to be relative to ServerRoot.  By default set to\n"
"\"/var/log/cups/access_log\".</p>\n"
"<p>\n"
"You can also use the special name <b>syslog</b> to send the output to the\n"
"syslog file or daemon.</p>\n"
"<p>\n"
"<i>ex</i>: /var/log/cups/access_log</p>\n"
msgstr ""
"<b>पहुँच लग (AccessLog)</b>\n"
"<p>\n"
"पहुँच लग फाइल; यदि यो पहिलोको रूपमा सुरु भएन भने /\n"
"यो सर्भर मूलसँग सम्बन्धित छ भन्ने मान्नुपर्दछ । पूर्वनिर्धारितद्वारा \n"
"\"/var/log/cups/access_log\" मा सेट गर्न </p>\n"
"<p>\n"
"तपाईँले syslog फाइल वा डेइमोनमा प्रतिफल पठाउन विशेष नाम <b>syslog</b>प्रयोग गर्न "
"सक्नुहुन्छ ।</p>\n"
"<p>\n"
"<i>ex</i>: /var/log/cups/access_log</p>\n"

#: cupsd.conf.template.cpp:31
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Data directory (DataDir)</b>\n"
"<p>\n"
"The root directory for the CUPS data files.\n"
"By default /usr/share/cups.</p>\n"
"<p>\n"
"<i>ex</i>: /usr/share/cups</p>\n"
msgstr ""
"<b>डेटा डाइरेक्टरी (DataDir)</b>\n"
"<p>\n"
"CUPS डेटा फाइलका लागि मूल डाइरेक्टरी ।\n"
"पूर्वनिर्धारित /usr/share/cups</p>\n"
"<p>\n"
"<i>ex</i>: /usr/share/cups</p>\n"

#: cupsd.conf.template.cpp:39
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Default character set (DefaultCharset)</b>\n"
"<p>\n"
"The default character set to use. If not specified,\n"
"defaults to utf-8.  Note that this can also be overridden in\n"
"HTML documents...</p>\n"
"<p>\n"
"<i>ex</i>: utf-8</p>\n"
msgstr ""
"<b>पूर्वनिर्धारित क्यारेक्टर सेट (DefaultCharset)</b>\n"
"<p>\n"
"प्रयोगका लागि पूर्वनिर्धारित क्यारेक्टर सेट । यदि निर्दिष्ट गरिएको छैन भने,\n"
"utf-8 लाई पूर्वनिर्धारित बनाउनुहोस् । याद राख्नुहोस् यसलाई\n"
"HTML कागजातमा पनि अधिलेखन गर्न सकिन्छ...</p>\n"
"<p>\n"
"<i>ex</i>: utf-8</p>\n"

#: cupsd.conf.template.cpp:48
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Default language (DefaultLanguage)</b>\n"
"<p>\n"
"The default language if not specified by the browser.\n"
"If not specified, the current locale is used.</p>\n"
"<p>\n"
"<i>ex</i>: en</p>\n"
msgstr ""
"<b>पूर्वनिर्धारित भाषा (DefaultLanguage)</b>\n"
"<p>\n"
"ब्राउजरद्वारा निर्दिष्ट गरेको छैन भने पूर्वनिर्धारित भाषा\n"
"यदि निदिष्ट गरिएको छैन भने, हालको स्थानीय प्रयोग गरिन्छ ।</p>\n"
"<p>\n"
"<i>ex</i>: en</p>\n"

#: cupsd.conf.template.cpp:56
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Document directory (DocumentRoot)</b>\n"
"<p>\n"
"The root directory for HTTP documents that are served.\n"
"By default the compiled-in directory.</p>\n"
"<p>\n"
"<i>ex</i>: /usr/share/cups/doc</p>\n"
msgstr ""
"<b>कागजात डाइरेक्टरी (DocumentRoot)</b>\n"
"<p>\n"
"एचटीटीपी कागजातका लागि मूल डाइरेक्टरी जुन सेवारत छ ।\n"
"पूर्वनिर्धारित रूपमा डाइरेक्टरीमा कम्पाइल गरिएको छ ।</p>\n"
"<p>\n"
"<i>ex</i>: /usr/share/cups/doc</p>\n"

#: cupsd.conf.template.cpp:64
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Error log (ErrorLog)</b>\n"
"<p>\n"
"The error log file; if this does not start with a leading /\n"
"then it is assumed to be relative to ServerRoot.  By default set to\n"
"\"/var/log/cups/error_log\".</p>\n"
"<p>\n"
"You can also use the special name <b>syslog</b> to send the output to the\n"
"syslog file or daemon.</p>\n"
"<p>\n"
"<i>ex</i>: /var/log/cups/error_log</p>\n"
msgstr ""
"<b>त्रुटि लग (ErrorLog)</b>\n"
"<p>\n"
"त्रुटि लग फाइल; यदि / पहिलोसँग सुरु भएन भने \n"
"त्यसपछि यसलाई सर्भर मूलसँग सम्बन्धित छ भन्ने मानिन्छ ।  पूर्वनिर्धारित रूपमा\n"
"\"/var/log/cups/error_log\" मा सेट गर्नुहोस्</p>\n"
"<p>\n"
"तपाईँले डेइमोन वा syslog फाइलमा\n"
"निर्गत पठाउन <b>syslog</b> विशेष नाम प्रयोग गर्न सक्नुहुन्छ ।</p>\n"
"<p>\n"
"<i>ex</i>: /var/log/cups/error_log</p>\n"

#: cupsd.conf.template.cpp:76
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Font path (FontPath)</b>\n"
"<p>\n"
"The path to locate all font files (currently only for pstoraster).\n"
"By default /usr/share/cups/fonts.</p>\n"
"<p>\n"
"<i>ex</i>: /usr/share/cups/fonts</p>\n"
msgstr ""
"<b>फन्ट मार्ग (FontPath)</b>\n"
"<p>\n"
"सबै फन्ट फाइल (हाल pstoraster का लागि मात्र) तोक्ने मार्ग ।\n"
"पूर्वनिर्धारित /usr/share/cups/fonts.</p>\n"
"<p>\n"
"<i>ex</i>: /usr/share/cups/fonts</p>\n"

#: cupsd.conf.template.cpp:84
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Log level (LogLevel)</b>\n"
"<p>\n"
"Controls the number of messages logged to the ErrorLog\n"
"file and can be one of the following:</p>\n"
"<ul type=circle>\n"
"<li><i>debug2</i>:     Log everything.</li>\n"
"<li><i>debug</i>:     Log almost everything.</li>\n"
"<li><i>info</i>:      Log all requests and state changes.</li>\n"
"<li><i>warn</i>:      Log errors and warnings.</li>\n"
"<li><i>error</i>:     Log only errors.</li>\n"
"<li><i>none</i>:      Log nothing.</li>\n"
"</ul><p>\n"
"<i>ex</i>: info</p>\n"
msgstr ""
"<b>लग तह (LogLevel)</b>\n"
"<p>\n"
"ErrorLog फाइलमा लग भएका असङ्ख्य सन्देश नियन्त्रण गर्दछ र\n"
"निम्न मध्ये एउटा हुन सक्दछ:</p>\n"
"<ul type=circle>\n"
"<li><i>debug2</i>:     सबै लग गर्नुहोस् ।</li>\n"
"<li><i>debug</i>:     प्राय: सबै लग गर्नुहोस् ।</li>\n"
"<li><i>info</i>:      सबै अनुरोध र वस्तुस्थिति परिवर्तन लग गर्नुहोस् ।</li>\n"
"<li><i>warn</i>:      त्रुटि र चेतावनी लग गर्नुहोस् ।</li>\n"
"<li><i>error</i>:     त्रुटि मात्र लग गर्नुहोस् ।</li>\n"
"<li><i>none</i>:      केही पनि लग नगर्नुहोस् ।</li>\n"
"</ul><p>\n"
"<i>ex</i>: info</p>\n"

#: cupsd.conf.template.cpp:99
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Max log size (MaxLogSize)</b>\n"
"<p>\n"
"Controls the maximum size of each log file before they are\n"
"rotated.  Defaults to 1048576 (1MB).  Set to 0 to disable log rotating.</p>\n"
"<p>\n"
"<i>ex</i>: 1048576</p>\n"
msgstr ""
"<b>अधिकतम लग साइज (MaxLogSize)</b>\n"
"<p>\n"
"हरेक लग फाइलको अधिकतम साइज तिनीको परिक्रमण पछि\n"
"नियन्त्रण गर्दछ । 1048576 (1MB) सम्म पूर्वनिर्धारित ।  लग परिक्रमण अक्षम पार्न ० मा सेट "
"गर्नुहोस् ।</p>\n"
"<p>\n"
"<i>ex</i>: 1048576</p>\n"

#: cupsd.conf.template.cpp:107
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Page log (PageLog)</b>\n"
"<p>\n"
"The page log file; if this does not start with a leading /\n"
"then it is assumed to be relative to ServerRoot.  By default set to\n"
"\"/var/log/cups/page_log\".</p>\n"
"<p>\n"
"You can also use the special name <b>syslog</b> to send the output to the\n"
"syslog file or daemon.</p>\n"
"<p>\n"
"<i>ex</i>: /var/log/cups/page_log</p>\n"
msgstr ""
"<b>पृष्ठ लग (PageLog)</b>\n"
"<p>\n"
"पृष्ठ लग फाइल; यदि यो / पहिलोसँग सुरु भएन भने\n"
"यसलाई सर्भर मूलसँग सम्बन्धित भएको मानिन्छ ।  पूर्वनिर्धारित रूपमा\n"
"\"/var/log/cups/page_log\" मा सेट गर्नुहोस् ।</p>\n"
"<p>\n"
"तपाईँले syslog फाइल वा डेइमोन निर्गत पठाउन <b>syslog</b> विशेष नाम \n"
"प्रयोग गर्न सक्नुहुन्छ ।</p>\n"
"<p>\n"
"<i>ex</i>: /var/log/cups/page_log</p>\n"

#: cupsd.conf.template.cpp:119
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Preserve job history (PreserveJobHistory)</b>\n"
"<p>\n"
"Whether or not to preserve the job history after a\n"
"job is completed, canceled, or stopped.  Default is Yes.</p>\n"
"<p>\n"
"<i>ex</i>: Yes</p>\n"
msgstr ""
"<b>कार्य इतिहास सुरक्षा गर्नुहोस् (PreserveJobHistory)</b>\n"
"<p>\n"
"कार्य पूरा भएपछि, रद्द गरे पछि, वा रोकेपछि कार्य इतिहास\n"
"सुरक्षित गर्ने कि नगर्ने । पूर्वनिर्धारित 'हो' छ ।</p>\n"
"<p>\n"
"<i>ex</i>: हो</p>\n"

#: cupsd.conf.template.cpp:127
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Preserve job files (PreserveJobFiles)</b>\n"
"<p>\n"
"Whether or not to preserve the job files after a\n"
"job is completed, canceled, or stopped.  Default is No.</p>\n"
"<p>\n"
"<i>ex</i>: No</p>\n"
msgstr ""
"<b>कार्य फाइल सुरक्षा गर्नुहोस् (PreserveJobFiles)</b>\n"
"<p>\n"
"कार्य पूर्ण भएपछि, रद्द गरे पछि, वा रोकेपछि कार्य इतिहास\n"
"सुरक्षित गर्ने कि नगर्ने । पूर्वनिर्धारित 'होइन' छ ।</p>\n"
"<p>\n"
"<i>ex</i>: होइन</p>\n"

#: cupsd.conf.template.cpp:135
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Printcap file (Printcap)</b>\n"
"<p>\n"
"The name of the printcap file.  Default is no filename.\n"
"Leave blank to disable printcap file generation.</p>\n"
"<p>\n"
"<i>ex</i>: /etc/printcap</p>\n"
msgstr ""
"<b>प्रिन्टक्याप फाइल (Printcap)</b>\n"
"<p>\n"
"प्रिन्टक्याप फाइलको नाम ।  पूर्वनिर्धारितमा फाइलनाम छैन ।\n"
"प्रिन्टक्याप फाइल उत्पादन अक्षम पार्न खाली छोड्नुहोस् ।</p>\n"
"<p>\n"
"<i>ex</i>: /etc/printcap</p>\n"

#: cupsd.conf.template.cpp:143
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Request directory (RequestRoot)</b>\n"
"<p>\n"
"The directory where request files are stored.\n"
"By default /var/spool/cups.</p>\n"
"<p>\n"
"<i>ex</i>: /var/spool/cups</p>\n"
msgstr ""
"<b>अनुरोध डाइरेक्टरी (RequestRoot)</b>\n"
"<p>\n"
"डाइरेक्टरी जहाँ अनुरोध फाइल भण्डार गरिएको छ ।\n"
"पूर्वनिर्धारित /var/spool/cups.</p>\n"
"<p>\n"
"<i>ex</i>: /var/spool/cups</p>\n"

#: cupsd.conf.template.cpp:151
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Remote root user (RemoteRoot)</b>\n"
"<p>\n"
"The name of the user assigned to unauthenticated accesses\n"
"from remote systems.  By default \"remroot\".</p>\n"
"<p>\n"
"<i>ex</i>: remroot</p>\n"
msgstr ""
"<b>टाढाको मूल प्रयोगकर्ता (RemoteRoot)</b>\n"
"<p>\n"
"टाढाको प्रणालीबाट\n"
"अनधिकृत पहुँचमा मानाङ्कन गरिएको प्रयोगकर्ताको नाम । पूर्वनिर्धारित \"remroot\".</p>\n"
"<p>\n"
"<i>ex</i>: remroot</p>\n"

#: cupsd.conf.template.cpp:159
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Server binaries (ServerBin)</b>\n"
"<p>\n"
"The root directory for the scheduler executables.\n"
"By default /usr/lib/cups or /usr/lib32/cups (IRIX 6.5).</p>\n"
"<p>\n"
"<i>ex</i>: /usr/lib/cups</p>\n"
msgstr ""
"<b>सर्भर बाइनरी (ServerBin)</b>\n"
"<p>\n"
"नियोजकको कार्यान्वयनका लागि मूल डाइरेक्टरी ।\n"
"पूर्वनिर्धारित /usr/lib/cups or /usr/lib32/cups (IRIX 6.5).</p>\n"
"<p>\n"
"<i>ex</i>: /usr/lib/cups</p>\n"

#: cupsd.conf.template.cpp:167
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Server files (ServerRoot)</b>\n"
"<p>\n"
"The root directory for the scheduler.\n"
"By default /etc/cups.</p>\n"
"<p>\n"
"<i>ex</i>: /etc/cups</p>\n"
msgstr ""
"<b>सर्भर फाइल (ServerRoot)</b>\n"
"<p>\n"
"नियोजकका लागि मूल डाइरेक्टरी ।\n"
"पूर्वनिर्धारित /etc/cups.</p>\n"
"<p>\n"
"<i>ex</i>: /etc/cups</p>\n"

#: cupsd.conf.template.cpp:175
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>User (User)</b>\n"
"<p>\n"
"The user the server runs under.  Normally this\n"
"must be <b>lp</b>, however you can configure things for another user\n"
"as needed.</p>\n"
"<p>\n"
"Note: the server must be run initially as root to support the\n"
"default IPP port of 631.  It changes users whenever an external\n"
"program is run...</p>\n"
"<p>\n"
"<i>ex</i>: lp</p>\n"
msgstr ""
"<b>प्रयोगकर्ता (User)</b>\n"
"<p>\n"
"तल चल्ने सर्भरको प्रयोगकर्ता । साधारणतया यो\n"
"<b>lp</b> हुनुपर्दछ, यद्यपि तपाईँले आवश्यक अनुसार अर्को प्रयोगकर्ताका लागि\n"
"वस्तु कन्फिगर गर्न सक्नुहुन्छ ।</p>\n"
"<p>\n"
"द्रष्टव्य: सर्भर 631 को IPP \n"
"पूर्वनिर्धारित 631 को IPP पोर्ट ।  बाह्य कार्यक्रम चलेको बेलामा\n"
"यसले प्रयोगकर्ता परिवर्तन गर्न सक्दछ...</p>\n"
"<p>\n"
"<i>ex</i>: lp</p>\n"

#: cupsd.conf.template.cpp:188
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Group (Group)</b>\n"
"<p>\n"
"The group the server runs under.  Normally this\n"
"must be <b>sys</b>, however you can configure things for another\n"
"group as needed.</p>\n"
"<p>\n"
"<i>ex</i>: sys</p>\n"
msgstr ""
"<b>समूह (Group)</b>\n"
"<p>\n"
"तल चल्ने सर्भरको समूह ।  साधारणतया यो\n"
"<b>sys</b> हुनुपर्दछ, तापनि तपाईँले आवश्यकता अनुसार\n"
"अर्को समूहका लागि कन्फिगर गर्न सक्नुहुन्छ ।</p>\n"
"<p>\n"
"<i>ex</i>: sys</p>\n"

#: cupsd.conf.template.cpp:197
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>RIP cache (RIPCache)</b>\n"
"<p>\n"
"The amount of memory that each RIP should use to cache\n"
"bitmaps.  The value can be any real number followed by \"k\" for\n"
"kilobytes, \"m\" for megabytes, \"g\" for gigabytes, or \"t\" for tiles\n"
"(1 tile = 256x256 pixels).  Defaults to \"8m\" (8 megabytes).</p>\n"
"<p>\n"
"<i>ex</i>: 8m</p>\n"
msgstr ""
"<b>RIP क्यास (RIPCache)</b>\n"
"<p>\n"
"हरेक RIP ले बिटम्याप क्यास गर्न प्रयोग गर्नुपर्ने\n"
"स्मृति परिणाम ।  मान किलोबाइटका लागि \"k\" \n"
"मेगाबाइटका लागि \"m\", गिगाबाइटका लागि \"g\", वा टाइलका लागि \"t\"\n"
"(1 tile = 256x256 pixels) कुनै पनि वास्तविक सङ्ख्या प्रयोग गर्न सकिन्छ ।  \"8m\" (8 "
"मेगाबाइट) मा पूर्वनिर्धारित हो ।</p>\n"
"<p>\n"
"<i>ex</i>: 8m</p>\n"

#: cupsd.conf.template.cpp:207
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Temporary files (TempDir)</b>\n"
"<p>\n"
"The directory to put temporary files in. This directory must be\n"
"writable by the user defined above!  Defaults to \"/var/spool/cups/tmp\" or\n"
"the value of the TMPDIR environment variable.</p>\n"
"<p>\n"
"<i>ex</i>: /var/spool/cups/tmp</p>\n"
msgstr ""
"<b>अस्थायी फाइल (TempDir)</b>\n"
"<p>\n"
"अस्थायी फाइल राख्न डाइरेक्टरी । यो डाइरेक्टरी माथि परिभाषित प्रयोगकर्ता\n"
"द्वारा लेखनयोग्य हुनुपर्नेछ!  \"/var/spool/cups/tmp\" मा वा\n"
"TMPDIR परिवेश चलको मानमा पूर्वानिर्धारित हुन्छ ।</p>\n"
"<p>\n"
"<i>ex</i>: /var/spool/cups/tmp</p>\n"

#: cupsd.conf.template.cpp:216
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Filter limit (FilterLimit)</b>\n"
"<p>\n"
"Sets the maximum cost of all job filters that can be run\n"
"at the same time.  A limit of 0 means no limit.  A typical job may need\n"
"a filter limit of at least 200; limits less than the minimum required\n"
"by a job force a single job to be printed at any time.</p>\n"
"<p>\n"
"The default limit is 0 (unlimited).</p>\n"
"<p>\n"
"<i>ex</i>: 200</p>\n"
msgstr ""
"<b>फिल्टर सीमा (FilterLimit)</b>\n"
"<p>\n"
"एकै समयमा चलाउन सकिने\n"
"सबै कार्य फिल्टरको अधिकतम लागत सेट गर्दछ ।  ० सीमा भन्नुको अर्थ सीमा नहुनु हो ।  कुनै "
"खास कामका लागि\n"
"कम्तिमा पनि २०० को फिल्टर सीमा आवश्यक हुन सक्छ; कुनै पनि समयमा मुद्रण हुन सक्ने कार्य "
"दवाबद्वारा न्यूनतम आवश्यकता\n"
"भन्दा कम कुनै पनि समयमा एकल कार्य सिमित गर्दछ ।</p>\n"
"<p>\n"
"पूर्वनिर्धारित सीमा ० छ (असीमित) ।</p>\n"
"<p>\n"
"<i>ex</i>: २००</p>\n"

#: cupsd.conf.template.cpp:228
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Listen to (Port/Listen)</b>\n"
"<p>\n"
"Ports/addresses that are listened to.  The default port 631 is reserved\n"
"for the Internet Printing Protocol (IPP) and is what is used here.</p>\n"
"<p>\n"
"You can have multiple Port/Listen lines to listen to more than one\n"
"port or address, or to restrict access.</p>\n"
"<p>\n"
"Note: Unfortunately, most web browsers don't support TLS or HTTP Upgrades\n"
"for encryption.  If you want to support web-based encryption you will\n"
"probably need to listen on port 443 (the \"HTTPS\" port...).</p>\n"
"<p>\n"
"<i>ex</i>: 631, myhost:80, 1.2.3.4:631</p>\n"
msgstr ""
"<b>(Port/Listen) मा सुन्नुहोस्</b>\n"
"<p>\n"
"सुन्नुपर्ने पोर्ट/ठेगाना ।  पूर्वनिर्धारित पोर्ट ६३१ लाई\n"
"इन्टरनेट मुद्रण प्रोटोकल (IPP) का लागि सुरक्षित राखिएको छ र जुन यहाँ प्रयोगमा छ ।</p>\n"
"<p>\n"
"तपाईँसँग एक भन्दा बढी पोर्ट वा ठेगाना सुन्नका लागि\n"
", वा पहुँच निषेध गर्न बहुविध पोर्ट/सुन्ने लाइन हुन सक्छ ।</p>\n"
"<p>\n"
"द्रष्टव्य: दुर्भाग्यवश, गुप्तीकरणका लागि धेरै जसो ब्राउजले टीएलएस वा एचटीटीपी स्तरवृद्धि\n"
"समर्थन गर्दैन ।  यदि तपाईँले वेब-आधारित गुप्तीकरणको समर्थन चाहनुहुन्छ भने\n"
"सम्भवत तपाईँले पोर्ट ४४३ सुन्नुपर्दछ ( \"HTTPS\" पोर्ट...).</p>\n"
"<p>\n"
"<i>ex</i>: 631, myhost:80, 1.2.3.4:631</p>\n"

#: cupsd.conf.template.cpp:243
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Hostname lookups (HostNameLookups)</b>\n"
"<p>\n"
"Whether or not to do lookups on IP addresses to get a\n"
"fully-qualified hostname.  This defaults to Off for performance reasons...</"
"p>\n"
"<p>\n"
"<i>ex</i>: On</p>\n"
msgstr ""
"<b>होस्टनाम खोजी (HostNameLookups)</b>\n"
"<p>\n"
"पूर्ण-निपुर्ण होस्टनाम प्राप्त गर्न आईपी ठेगानामा\n"
"खोजी गर्ने की नगर्ने ।  कार्यसम्पादन कारणले पूर्वनिर्धारितमा बन्द...</p>\n"
"<p>\n"
"<i>ex</i>: खुला</p>\n"

#: cupsd.conf.template.cpp:251
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Keep alive (KeepAlive)</b>\n"
"<p>\n"
"Whether or not to support the Keep-Alive connection\n"
"option.  Default is on.</p>\n"
"<p>\n"
"<i>ex</i>: On</p>\n"
msgstr ""
"<b>जीवित राख्नुहोस् (KeepAlive)</b>\n"
"<p>\n"
"जीवित-राख्ने जडान विकल्प समर्थन\n"
"गर्ने कि नगर्ने ।  पूर्वनिर्धारित खुला छ ।</p>\n"
"<p>\n"
"<i>ex</i>: खुला</p>\n"

#: cupsd.conf.template.cpp:259
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Keep-alive timeout (KeepAliveTimeout)</b>\n"
"<p>\n"
"The timeout (in seconds) before Keep-Alive connections are\n"
"automatically closed.  Default is 60 seconds.</p>\n"
"<p>\n"
"<i>ex</i>: 60</p>\n"
msgstr ""
"<b>जीवित राख्ने समय समाप्त (KeepAliveTimeout)</b>\n"
"<p>\n"
"जीवित राख्ने जडान स्वचालित तरिकाले बन्द हुनु अगाडि\n"
"समय समाप्ति (सेकेण्डमा) ।  पूर्वनिर्धारित ६० सेकेण्ड हो ।</p>\n"
"<p>\n"
"<i>ex</i>: ६०</p>\n"

#: cupsd.conf.template.cpp:267
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Max clients (MaxClients)</b>\n"
"<p>\n"
"Controls the maximum number of simultaneous clients that\n"
"will be handled.  Defaults to 100.</p>\n"
"<p>\n"
"<i>ex</i>: 100</p>\n"
msgstr ""
"<b>अधिकतम क्लाइन्ट (MaxClients)</b>\n"
"<p>\n"
"एकै प्रकारको क्लाइन्टको सङ्ख्या नियन्त्रण गर्दछ जुन\n"
"ह्यान्डल गरिनेछ ।  १०० लाई पूर्वनिर्धारित बनाउनुहोस्</p>\n"
"<p>\n"
"<i>ex</i>: १००</p>\n"

#: cupsd.conf.template.cpp:275
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Max request size (MaxRequestSize)</b>\n"
"<p>\n"
"Controls the maximum size of HTTP requests and print files.\n"
"Set to 0 to disable this feature (defaults to 0).</p>\n"
"<p>\n"
"<i>ex</i>: 0</p>\n"
msgstr ""
"<b>अधिकतम अनुरोध साइज (MaxRequestSize)</b>\n"
"<p>\n"
"एचटीटीपी अनुरोध र मुद्रण फाइलको अधिकतम साइज नियन्त्रण गर्दछ ।\n"
"यो विशेषता अक्षम पार्न ० मा सेट गर्नुहोस् (० लाई पूर्वनिर्धारित बनाउनुहोस्) ।</p>\n"
"<p>\n"
"<i>ex</i>: ०</p>\n"

#: cupsd.conf.template.cpp:283
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Client timeout (Timeout)</b>\n"
"<p>\n"
"The timeout (in seconds) before requests time out.  Default is 300 seconds.</"
"p>\n"
"<p>\n"
"<i>ex</i>: 300</p>\n"
msgstr ""
"<b>क्लाइन्ट समय समाप्ति (Timeout)</b>\n"
"<p>\n"
"अनुरोधको समय समाप्ति अघिको समाप्ति समय (सेकेण्डमा) । पूर्वनिर्धारित ३०० सेकेण्ड हो ।</"
"p>\n"
"<p>\n"
"<i>ex</i>: ३००</p>\n"

#: cupsd.conf.template.cpp:290
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Use browsing (Browsing)</b>\n"
"<p>\n"
"Whether or not to <b>listen</b> to printer \n"
"information from other CUPS servers.  \n"
"</p>\n"
"<p>\n"
"Enabled by default.\n"
"</p>\n"
"<p>\n"
"Note: to enable the <b>sending</b> of browsing\n"
"information from this CUPS server to the LAN,\n"
"specify a valid <i>BrowseAddress</i>.\n"
"</p>\n"
"<p>\n"
"<i>ex</i>: On</p>\n"
msgstr ""
"<b>ब्राउजिङ प्रयोग गर्नुहोस् (Browsing)</b>\n"
"<p>\n"
"अन्य CUPS सर्भरबाट मुद्रक सूचनालाई <b>ध्यान दिने</b>\n"
"हो कि होइन ।\n"
"</p>\n"
"<p>\n"
"पूर्वनिर्धारितद्वारा सक्षम पारिएको ।\n"
"</p>\n"
"<p>\n"
"द्रष्टव्य: ब्राउजिङ सूचना CUPS बाट LAN मा <b>पठाउने</b>\n"
"सक्षम पार्न,\n"
"वैध <i>ब्राउज ठेगाना</i> उल्लेख गर्नुहोस् ।\n"
"</p>\n"
"<p>\n"
"<i>ex</i>: खुला</p>\n"

#: cupsd.conf.template.cpp:307
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Use short names (BrowseShortNames)</b>\n"
"<p>\n"
"Whether or not to use \"short\" names for remote printers\n"
"when possible (e.g. \"printer\" instead of \"printer@host\").  Enabled by\n"
"default.</p>\n"
"<p>\n"
"<i>ex</i>: Yes</p>\n"
msgstr ""
"<b>छोटो नाम प्रयोग गर्नुहोस् (BrowseShortNames)</b>\n"
"<p>\n"
"सम्भव भएको बेलामा टाढाको मुद्रकका लागि \"short\" \n"
"नाम प्रयोग गर्ने कि नगर्ने (उदाहरणका लागि \"printer@host\" को सट्टामा \"printer"
"\" ) । पूर्वनिर्धारित अनुरुप\n"
"सक्षम पारिएको</p>\n"
"<p>\n"
"<i>ex</i>: हो</p>\n"

#: cupsd.conf.template.cpp:316
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Browse addresses (BrowseAddress)</b>\n"
"<p>\n"
"Specifies a broadcast address to be used.  By\n"
"default browsing information is broadcast to all active interfaces.</p>\n"
"<p>\n"
"Note: HP-UX 10.20 and earlier do not properly handle broadcast unless\n"
"you have a Class A, B, C, or D netmask (i.e. no CIDR support).</p>\n"
"<p>\n"
"<i>ex</i>: x.y.z.255, x.y.255.255</p>\n"
msgstr ""
"<b>ठेगाना ब्राउज गर्नुहोस् (BrowseAddress)</b>\n"
"<p>\n"
"प्रयोग गर्नका लागि प्रसारित ठेगाना निर्दिष्ट गर्दछ । पूर्वनिर्धारितद्वारा\n"
"ब्राउज सूचना सबै सक्रिय इन्टरफेसमा प्रसारित गरिन्छ ।</p>\n"
"<p>\n"
"द्रष्टव्य: तपाईँसँग कक्ष A, B, C वा D नेटमास्क (जस्तै, CIDR समर्थन छैन) नभइकन HP-UX "
"10.20 र अघिल्लोले\n"
"उपयुक्त तरिकाले ह्यान्डल गर्दैन</p>\n"
"<p>\n"
"<i>ex</i>: x.y.z.255, x.y.255.255</p>\n"

#: cupsd.conf.template.cpp:327
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Browse allow/deny (BrowseAllow/BrowseDeny)</b>\n"
"<p>\n"
"<u>BrowseAllow</u>: specifies an address mask to allow for incoming browser\n"
"packets. The default is to allow packets from all addresses.</p>\n"
"<p>\n"
"<u>BrowseDeny</u>: specifies an address mask to deny for incoming browser\n"
"packets. The default is to deny packets from no addresses.</p>\n"
"<p>\n"
"Both \"BrowseAllow\" and \"BrowseDeny\" accept the following notations for\n"
"addresses:</p>\n"
"<pre>\n"
"All\n"
"None\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"</pre><p>\n"
"The hostname/domainname restrictions only work if you have turned hostname\n"
"lookups on!</p>\n"
msgstr ""
"<b>ब्राउज स्वीकार/ ब्राउज अस्वीकार (BrowseAllow/BrowseDeny)</b>\n"
"<p>\n"
"<u>ब्राउज स्वीकार</u>: आगमन ब्राउजर प्याकेटका लागि अनुमति दिन ठेगाना मास्क निर्दिष्ट\n"
"गर्दछ । पूर्वनिर्धारित सबै ठेगानाबाट प्याकेट अनुमति दिनु हो ।</p>\n"
"<p>\n"
"<u>ब्राउज अस्वीकार</u>: आगमन ब्राउजर प्याकेटका लागि अस्वीकार गर्न ठेगाना मास्क "
"निर्दिष्ट\n"
"गर्दछ । पूर्वनिर्धारित कुनै ठेगानाबाट प्याकेट अस्वीकार गर्नु हो ।</p>\n"
"<p>\n"
"दुबै \"BrowseAllow\" र \"BrowseDeny\"  ठेगानाका लागि निम्न नोटेशन\n"
"स्वीकार गर्दछ:</p>\n"
"<pre>\n"
"सबै\n"
"कुनै पनि होइन\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"</pre><p>\n"
"यदि तपाईँले होस्टनाम\n"
"खोजी खुला राख्नु भयो भने मात्र hostname/domainname सीमा बन्धनले काम गर्दछ !</p>\n"

#: cupsd.conf.template.cpp:354
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Browse interval (BrowseInterval)</b>\n"
"<p>\n"
"The time between browsing updates in seconds.  Default\n"
"is 30 seconds.</p>\n"
"<p>\n"
"Note that browsing information is sent whenever a printer's state changes\n"
"as well, so this represents the maximum time between updates.</p>\n"
"<p>\n"
"Set this to 0 to disable outgoing broadcasts so your local printers are\n"
"not advertised but you can still see printers on other hosts.</p>\n"
"<p>\n"
"<i>ex</i>: 30</p>\n"
msgstr ""
"<b>अन्तराल ब्राउज गर्नुहोस् (BrowseInterval)</b>\n"
"<p>\n"
"ब्राउजिङ अद्यावधिक बीचको समय सेकेन्डमा ।  पूर्वनिर्धारित\n"
"३० सकेण्ड छ ।</p>\n"
"<p>\n"
"याद गर्नुहोस् कि मुद्रकको अवस्था परिवर्तन गर्ने वित्तिकै\n"
"ब्राउजिङ सूचना पठाइन्छ, त्यसैले यसले अद्यावधिक बीचको अधिकतम समय प्रतिनिधित्व गर्दछ ।</"
"p>\n"
"<p>\n"
"तपाईँको मुद्रक विज्ञापन नगरिकन तपाईँले अन्य होस्टमा मुद्रक हेर्न सक्षम हुन निर्गमन प्रसारण "
"अक्षम पार्न\n"
"० मा सेट गर्नुहोस् ।</p>\n"
"<p>\n"
"<i>ex</i>: 30</p>\n"

#: cupsd.conf.template.cpp:368
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Browse order (BrowseOrder)</b>\n"
"<p>\n"
"Specifies the order of BrowseAllow/BrowseDeny comparisons.</p>\n"
"<p>\n"
"<i>ex</i>: allow,deny</p>\n"
msgstr ""
"<b>क्रम ब्राउज गर्नुहोस् (BrowseOrder)</b>\n"
"<p>\n"
"BrowseAllow/BrowseDeny तुलनाको क्रम निर्दिष्ट गर्दछ ।</p>\n"
"<p>\n"
"<i>ex</i>: स्वीकार, अस्वीकार</p>\n"

#: cupsd.conf.template.cpp:375
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Browse poll (BrowsePoll)</b>\n"
"<p>\n"
"Poll the named server(s) for printers.</p>\n"
"<p>\n"
"<i>ex</i>: myhost:631</p>\n"
msgstr ""
"<b>नामवाली ब्राउज गर्नुहोस् (BrowsePoll)</b>\n"
"<p>\n"
"मुद्रकका लागि नामकरण गरिएको सर्भरको नामवाली गर्नुहोस् ।</p>\n"
"<p>\n"
"<i>ex</i>: myhost:631</p>\n"

#: cupsd.conf.template.cpp:382
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Browse port (BrowsePort)</b>\n"
"<p>\n"
"The port used for UDP broadcasts.  By default this is\n"
"the IPP port; if you change this you need to do it on all servers.\n"
"Only one BrowsePort is recognized.</p>\n"
"<p>\n"
"<i>ex</i>: 631</p>\n"
msgstr ""
"<b>पोर्ट ब्राउज गर्नुहोस् (BrowsePort)</b>\n"
"<p>\n"
"UDP प्रसारणका लागि प्रयोग गरिएको पोर्ट ।  पूर्वनिर्धारित  यो\n"
"IPP पोर्ट हो; यदि तपाईँले यो परिवर्तन गर्नु भयो भने तपाईँले यो सबै सर्भूमा गर्नुपर्दछ ।\n"
"एउटा मात्र ब्राउज पोर्ट पहिचान गरएको छो ।</p>\n"
"<p>\n"
"<i>ex</i>: ६३१</p>\n"

#: cupsd.conf.template.cpp:391
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Browse relay (BrowseRelay)</b>\n"
"<p>\n"
"Relay browser packets from one address/network to another.</p>\n"
"<p>\n"
"<i>ex</i>: src-address dest-address</p>\n"
msgstr ""
"<b>ब्राउज प्रसारण (BrowseRelay)</b>\n"
"<p>\n"
"एउटा ठेगाना/सञ्जालबाट अर्कोमा ब्राउजर प्याकेट प्रसारण गर्नुहोस् ।</p>\n"
"<p>\n"
"<i>ex</i>: src-address dest-address</p>\n"

#: cupsd.conf.template.cpp:398
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Browse timeout (BrowseTimeout)</b>\n"
"<p>\n"
"The timeout (in seconds) for network printers - if we don't\n"
"get an update within this time the printer will be removed\n"
"from the printer list.  This number definitely should not be\n"
"less the BrowseInterval value for obvious reasons.  Defaults\n"
"to 300 seconds.</p>\n"
"<p>\n"
"<i>ex</i>: 300</p>\n"
msgstr ""
"<b>ब्राउज समय समाप्ति (BrowseTimeout)</b>\n"
"<p>\n"
"सञ्जाल मुद्रकका लागि समय समाप्ति (सेकेण्डमा) - यदि हामीले\n"
"यस समय भित्र अद्यावधिक प्राप्त गर्न नसकेमा मुद्रक सूचीबाट मुद्रक\n"
"हट्नेछ । यो नम्बर स्पष्ट कारणका लागि\n"
"ब्राउज अन्तराल मान भन्दा कम हुनुहुदैन । ३०० सेकेण्डमा\n"
"पुर्वनिर्धारित ।</p>\n"
"<p>\n"
"<i>ex</i>: ३००</p>\n"

#: cupsd.conf.template.cpp:409
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Implicit classes (ImplicitClasses)</b>\n"
"<p>\n"
"Whether or not to use implicit classes.</p>\n"
"<p>\n"
"Printer classes can be specified explicitly in the classes.conf\n"
"file, implicitly based upon the printers available on the LAN, or\n"
"both.</p>\n"
"<p>\n"
"When ImplicitClasses is On, printers on the LAN with the same name\n"
"(e.g. Acme-LaserPrint-1000) will be put into a class with the same\n"
"name. This allows you to setup multiple redundant queues on a LAN\n"
"without a lot of administrative difficulties.  If a user sends a\n"
"job to Acme-LaserPrint-1000, the job will go to the first available\n"
"queue.</p>\n"
"<p>\n"
"Enabled by default.</p>\n"
msgstr ""
"<b>अस्पष्ट वर्ग (ImplicitClasses)</b>\n"
"<p>\n"
"अस्पष्ट वर्ग प्रयोग गर्ने कि नगर्ने ।</p>\n"
"<p>\n"
"LAN वा दुबैमा उपलब्ध मुद्रकमा अस्पष्ट रूपमा आधारित\n"
"मुद्रक वर्गलाई बाह्य रूपमा classes.conf\n"
"फाइलमा निर्दिष्ट गर्न सकिन्छ ।</p>\n"
"<p>\n"
"जब ImplicitClasses सुरु हुन्छ, LAN सँग उही नामको मुद्रक\n"
"(e.g. Acme-LaserPrint-1000) लाई उही नामको वर्गमा\n"
"राखिन्छ । यसले तपाईँलाई कुनै प्रशासनिक कठिनाइ बिना LAN\n"
"मा बहुविध अतिरिक्त लाम सेट अप गर्न अनुमति दिन्छ ।  यदि प्रयोगकर्ताले\n"
"Acme-LaserPrint-1000 मा काम पठाएमा, सो काम उपलब्ध पहिलो लाममा\n"
"जान्छ ।</p>\n"
"<p>\n"
"पूर्वनिर्धारित अनुसार सक्षम पारियो ।</p>\n"

#: cupsd.conf.template.cpp:427
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>System group (SystemGroup)</b>\n"
"<p>\n"
"The group name for \"System\" (printer administration)\n"
"access.  The default varies depending on the operating system, but\n"
"will be <b>sys</b>, <b>system</b>, or <b>root</b> (checked for in that "
"order).</p>\n"
"<p>\n"
"<i>ex</i>: sys</p>\n"
msgstr ""
"<b>प्रणाली समूह (SystemGroup)</b>\n"
"<p>\n"
"\"प्रणाली\" (मुद्रक प्रशासन) पहुँच का लागि\n"
"समूह नाम ।  पूर्वनिर्धारित परिवर्तन सञ्चालन प्रणालीमा निर्भर रहन्छ, तर \n"
"<b>sys</b>, <b>प्रणाली</b>, वा <b>मूल</b> (त्यस क्रमका लागि जाँचिएको) हुनेछ ।</p>\n"
"<p>\n"
"<i>ex</i>: sys</p>\n"

#: cupsd.conf.template.cpp:436
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Encryption certificate (ServerCertificate)</b>\n"
"<p>\n"
"The file to read containing the server's certificate.\n"
"Defaults to \"/etc/cups/ssl/server.crt\".</p>\n"
"<p>\n"
"<i>ex</i>: /etc/cups/ssl/server.crt</p>\n"
msgstr ""
"<b>गुप्तिकरण प्रमाणपत्र (ServerCertificate)</b>\n"
"<p>\n"
"पढ्नका लागि सर्भरको प्रमाणपत्र समावेश भएको फाइल ।\n"
"\"/etc/cups/ssl/server.crt\" सँग पूर्वनिर्धारित ।</p>\n"
"<p>\n"
"<i>ex</i>: /etc/cups/ssl/server.crt</p>\n"

#: cupsd.conf.template.cpp:444
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Encryption key (ServerKey)</b>\n"
"<p>\n"
"The file to read containing the server's key.\n"
"Defaults to \"/etc/cups/ssl/server.key\".</p>\n"
"<p>\n"
"<i>ex</i>: /etc/cups/ssl/server.key</p>\n"
msgstr ""
"<b>गुप्तिकरण कुञ्जी (ServerKey)</b>\n"
"<p>\n"
"पढ्नका लागि सर्भरको कुञ्जी समावेश भएको फाइल ।\n"
"\"/etc/cups/ssl/server.key\" सँग पूर्वनिर्धारित ।</p>\n"
"<p>\n"
"<i>ex</i>: /etc/cups/ssl/server.key</p>\n"

#: cupsd.conf.template.cpp:452
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"Access permissions\n"
"# Access permissions for each directory served by the scheduler.\n"
"Locations are relative to DocumentRoot...\n"
"# AuthType: the authorization to use:\n"
"#    None   - Perform no authentication\n"
"Basic  - Perform authentication using the HTTP Basic method.\n"
"Digest - Perform authentication using the HTTP Digest method.\n"
"#    (Note: local certificate authentication can be substituted by\n"
"the client for Basic or Digest when connecting to the\n"
"localhost interface)\n"
"# AuthClass: the authorization class; currently only Anonymous, User,\n"
"System (valid user belonging to group SystemGroup), and Group\n"
"(valid user belonging to the specified group) are supported.\n"
"# AuthGroupName: the group name for \"Group\" authorization.\n"
"# Order: the order of Allow/Deny processing.\n"
"# Allow: allows access from the specified hostname, domain, IP address, or\n"
"network.\n"
"# Deny: denies access from the specified hostname, domain, IP address, or\n"
"network.\n"
"# Both \"Allow\" and \"Deny\" accept the following notations for addresses:\n"
"#     All\n"
"None\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"# The host and domain address require that you enable hostname lookups\n"
"with \"HostNameLookups On\" above.\n"
"# Encryption: whether or not to use encryption; this depends on having\n"
"the OpenSSL library linked into the CUPS library and scheduler.\n"
"# Possible values:\n"
"#     Always       - Always use encryption (SSL)\n"
"Never        - Never use encryption\n"
"Required     - Use TLS encryption upgrade\n"
"IfRequested  - Use encryption if the server requests it\n"
"# The default value is \"IfRequested\".\n"
msgstr ""
"पहुँच अनुमति\n"
"# नियोजकद्वारा सेवारत हरेक डाइरेक्टरीका लागि पहुँच अनुमति\n"
"स्थान DocumentRoot सँग सम्बन्धित छ...\n"
"# AuthType: प्रयोगका लागि अधिकारपत्र:\n"
"#    कुनै पनि होइन   - प्रमाणीकरण आधार नभएको\n"
"सम्पादन - एचटीटीपी आधार तरिका प्रयोग गरी प्रमाणीकरण सम्पादन गर्नुहोस् ।\n"
"क्रमबद्ध गर्नुहोस् - एचटीटीपी क्रमबद्ध तरिका प्रयोग गरि प्रमाणीकरण सम्पादन गर्नुहोस् ।\n"
"#    (द्रष्टव्य: localhost इन्टरफेसमा जडान गर्ने बेलामा\n"
"आधारभुत वा क्रमबद्धताका लागि क्लाइन्टद्वारा स्थानीय\n"
"प्रमाणपत्र प्रमाणीकरण प्रतिस्थापन गर्न सकिन्छ)\n"
"# AuthClass: अधिकारपत्र कक्ष; हाल बेनामी, प्रयोगकर्ता,\n"
"प्रणाली (समूह SystemGroup सँग सम्बन्धित वैध प्रयोगकर्ता), र समूह\n"
"(उल्लेखित समूहसँग सम्बन्धित वैध प्रयोगकर्ता) ले मात्र समर्थन गरेको छ ।\n"
"# AuthGroupName: \"समूह\" अधिकारपत्रका लागि समूह नाम ।\n"
"# Order: स्वीकार/अस्वीकार प्रक्रियाको क्रम ।\n"
"# Allow: उल्लेखित होस्टनाम, डोमेन, आई पी ठेगाना, वा\n"
"सञ्जालबाट पहुँच स्वीकार गर्दछ ।\n"
"# अस्वीकार: उल्लेखित होस्टनाम, डोमेन, आई पी ठेगाना, वा\n"
"सञ्जालबाट पहुँच अस्वीकार गर्दछ ।\n"
"# \"स्वीकार\" र \"अस्वीकार\" दुवैले ठेगानाका लागि निम्न सूचना स्वीकार गर्दछ:\n"
"#     सबै\n"
"कुनै पनि होइन\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"# होस्टनाम र डेइमोन ठेगानालाई\n"
"तपाईँले \"HostNameLookups On\" माथिसँग होस्टनाम खोजी सक्षम पार्न आवश्यक छ ।\n"
"# गप्तिकरण: गुप्तिकरण प्रयोग गर्ने की नगर्ने; CUPS लाइब्रेरी र तालिका बनाउनेसँग\n"
"OpenSSL लाइब्रेरी लिङ्क गराइमा भर पर्दछ ।\n"
"# सम्भाव्य मान:\n"
"#     सधैँ       - सधैँ गुप्तिकरण (SSL) प्रयोग गर्नुहोस्\n"
"कहिले पनि होइन        - गुप्तिकरण कहिले पनि प्रयोग नगर्नुहोस्\n"
"आवश्यक    - TLS गुप्तिकरण अपग्रेड प्रयोग गर्नुहोस्\n"
"IfRequested  - यदि सर्भरले सो अनुरोद गरेमा गुप्तिकरण प्रयोग गर्नुहोस्\n"
"# पूर्वनिर्धारित मान \"IfRequested\"हो ।\n"

#: cupsd.conf.template.cpp:495
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Authentication (AuthType)</b>\n"
"<p>\n"
"The authorization to use:<p>\n"
"<ul type=circle>\n"
"<li><i>None</i>   - Perform no authentication.</li>\n"
"<li><i>Basic</i>  - Perform authentication using the HTTP Basic method.</"
"li>\n"
"<li><i>Digest</i> - Perform authentication using the HTTP Digest method.</"
"li>\n"
"</ul><p>\n"
"Note: local certificate authentication can be substituted by\n"
"the client for <i>Basic</i> or <i>Digest</i> when connecting to the\n"
"localhost interface.</p>\n"
msgstr ""
"<b>प्रमाणीकरण (AuthType)</b>\n"
"<p>\n"
"प्रयोगका लागि अधिकारपत्र:<p>\n"
"<ul type=circle>\n"
"<li><i>कुने पनि होइन</i>   - प्रमाणीकरण नभएको सम्पादन गर्नुहोस् ।</li>\n"
"<li><i>आधारभूत</i>  - एचटीटीपी आधारभूत तरिका प्रयोग गरेर प्रमाणीकरण सम्पादन गर्नुहोस् "
"।</li>\n"
"<li><i>क्रमबद्ध गर्नुहोस्</i> - एचटीटीपी क्रमबद्ध गर्ने तरिका प्रयोग गरेर प्रमाणीकरण "
"सम्पादन गर्नुहोस् ।</li>\n"
"</ul><p>\n"
"द्रष्टव्य: स्थानीय होस्ट इन्टरफेसमा जडान गरेको बेलामा\n"
"स्थानीय प्रमाणपत्र प्रमाणीकरण\n"
"<i>आधारभूत</i> वा <i>क्रमबद्धता</i> का लागि क्लाइन्टद्वारा प्रतिस्थापन गर्न सकिन्छ</"
"p>\n"

#: cupsd.conf.template.cpp:508
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Class (AuthClass)</b>\n"
"<p>\n"
"The authorization class; currently only <i>Anonymous</i>, <i>User</i>,\n"
"<i>System</i> (valid user belonging to group SystemGroup), and <i>Group</i>\n"
"(valid user belonging to the specified group) are supported.</p>\n"
msgstr ""
"<b>वर्ग (AuthClass)</b>\n"
"<p>\n"
"प्रमाणीकरण वर्ग; हाल <i>बेनामी</i> मात्र, <i>प्रयोगकर्ता</i>,\n"
"<i>प्रणाली</i> (समूह प्रणालीसमूहसँग सम्बद्ध वैध प्रयोगकर्ता) र <i> समूह</i> (उल्लेखित "
"समूहसँग सम्बद्ध वैध प्रयोगकर्ता) समर्थित छन् ।</p>\n"

#: cupsd.conf.template.cpp:515
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<p>The user/group names allowed to access the resource. The format is a\n"
"comma separated list.</p>\n"
msgstr ""
"<p>प्रयोगकर्ता/समूह नामले स्रोत पहुँच गर्न अनुमति दिन्छ । ढाँचा अल्पविराम\n"
"विभाजक सूची हो ।</p>\n"

#: cupsd.conf.template.cpp:519
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Satisfy (Satisfy)</b>\n"
"<p>\n"
"This directive controls whether all specified conditions must\n"
"be satisfied to allow access to the resource. If set to \"all\",\n"
"then all authentication and access control conditions must be\n"
"satisfied to allow access.\n"
"</p>\n"
"<p>\n"
"Setting Satisfy to \"any\" allows a user to gain access if the\n"
"authentication <i>or</i> access control requirements are satisfied.\n"
"For example, you might require authentication for remote access,\n"
"but allow local access without authentication.\n"
"</p>\n"
"<p>\n"
"The default is \"all\".\n"
"</p> \n"
msgstr ""
"<b>सन्तुष्टि (Satisfy)</b>\n"
"<p>\n"
"यो निर्देशले स्रोतमा पहुँच अनुमति दिन सबै उल्लेखित अवस्था सन्तुष्ट हुनुपर्दछ कि पर्दैन\n"
"नियन्त्रण गर्दछ । यदि \"सबै\" मा सेट गरेमा,\n"
"सबै प्रमाणीकरण र पहुँच नियन्त्रण अवस्था\n"
"पहुँच अनुमति गर्न सन्तुष्टि हुनुपर्दछ ।\n"
"</p>\n"
"<p>\n"
"यदि प्रमाणीकरण <i>वा</i> पहुँच नियन्त्रण सन्तुष्ट भएमा प्रयोगकर्तालाई \"any\" मा सेटिङ "
"सन्तुष्टले\n"
"प्रयोगकर्तालाई पहुँच प्राप्त गर्न अनुमति दिन्छ ।\n"
"उदाहरणका लागि, टाढा पहुँचका लागि तपाईँलाई प्रमाणीकरण आवश्यक पर्दछ,\n"
"तर प्रमाणीकरण बिना स्थानीय पहुँचलाई अनुमति दिनुहोस् ।\n"
"</p>\n"
"<p>\n"
"पूर्वनिर्धारित \"all\" हो ।\n"
"</p> \n"

#: cupsd.conf.template.cpp:537
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Authentication group name (AuthGroupName)</b>\n"
"<p>\n"
"The group name for <i>Group</i> authorization.</p>\n"
msgstr ""
"<b>प्रमाणीकरण समूह नाम (AuthGroupName)</b>\n"
"<p>\n"
"<i>समूह</i> अधिकारका लागि समूह नाम ।</p>\n"

#: cupsd.conf.template.cpp:542
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>ACL order (Order)</b>\n"
"<p>\n"
"The order of Allow/Deny processing.</p>\n"
msgstr ""
"<b>ACL क्रम (Order)</b>\n"
"<p>\n"
"स्वीकार/अस्वीकार प्रक्रियाको क्रम ।</p>\n"

#: cupsd.conf.template.cpp:547
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Allow</b>\n"
"<p>\n"
"Allows access from the specified hostname, domain, IP address, or\n"
"network. Possible values are:</p>\n"
"<pre>\n"
"All\n"
"None\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"</pre><p>\n"
"The host and domain address require that you enable hostname lookups\n"
"with \"HostNameLookups On\" above.</p>\n"
msgstr ""
"<b>अनुमति दिनुहोस्</b>\n"
"<p>\n"
"निर्दिष्ट गरेको होस्टनाम, डोमेन, आइ पी ठेगाना वा\n"
"सञ्झ्यालबाट पहुँच अनुमति दिन्छ । सम्भाव्य मानहरू:</p>\n"
"<pre>\n"
"सबै\n"
"कुनै पनि होइन\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"</pre><p>\n"
"होस्ट र डोमेन ठेगानालाई तपाईँले माथि \"HostNameLookups On\" सँग सक्षम पार्नुभएको "
"होस्टनाम\n"
"खोजी आवश्यक पर्दछ ।</p>\n"

#: cupsd.conf.template.cpp:568
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>ACL addresses (Allow/Deny)</b>\n"
"<p>\n"
"Allows/Denies access from the specified hostname, domain, IP address, or\n"
"network. Possible values are:</p>\n"
"<pre>\n"
"All\n"
"None\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"</pre><p>\n"
"The host and domain address require that you enable hostname lookups\n"
"with \"HostNameLookups On\" above.</p>\n"
msgstr ""
"<b>ACL ठेगाना (Allow/Deny)</b>\n"
"<p>\n"
"निर्दिष्ट होस्टनाम, डोमेन, आइ पी ठेगाना वा\n"
"सञ्झ्यालबाट पहुँच अनुमति दिन्छ/अस्वीकार गर्दछ । सम्भाव्य मान:</p>\n"
"<pre>\n"
"सबै\n"
"कुनै पनि होइन\n"
"*.domain.com\n"
".domain.com\n"
"host.domain.com\n"
"nnn.*\n"
"nnn.nnn.*\n"
"nnn.nnn.nnn.*\n"
"nnn.nnn.nnn.nnn\n"
"nnn.nnn.nnn.nnn/mm\n"
"nnn.nnn.nnn.nnn/mmm.mmm.mmm.mmm\n"
"</pre><p>\n"
"होस्ट र डोमेन ठेगानालाई\n"
"माथि \"HostNameLookups On\" सँग होस्टनाम खोजी तपाईँले सक्षम पार्न आवश्यक पर्दछ ।</"
"p>\n"

#: cupsd.conf.template.cpp:589
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Encryption (Encryption)</b>\n"
"<p>\n"
"Whether or not to use encryption; this depends on having\n"
"the OpenSSL library linked into the CUPS library and scheduler.</p>\n"
"<p>\n"
"Possible values:</p>\n"
"<ul type=circle>\n"
"<li><i>Always</i>       - Always use encryption (SSL)</li>\n"
"<li><i>Never</i>        - Never use encryption</li>\n"
"<li><i>Required</i>     - Use TLS encryption upgrade</li>\n"
"<li><i>IfRequested</i>  - Use encryption if the server requests it</li>\n"
"</ul><p>\n"
"The default value is \"IfRequested\".</p>\n"
msgstr ""
"<b>गुप्तिकरण (Encryption)</b>\n"
"<p>\n"
"गुप्तिकरण प्रयोग गर्ने या नगर्ने; यो कुरा CUPS लाइब्रेरी र नियोजक\n"
"लिङ्क गरिएको OpenSSL लाइब्रेरीमा आधारित हुन्छ ।</p>\n"
"<p>\n"
"# सम्भावित मान:</p>\n"
"<ul type=circle>\n"
"<li><i>Always</i>       - जहिले पनि गुप्तिकरण (SSL) प्रयोग गर्नुहोस्<li>\n"
"<li><i>Never</i>        - गुप्तिकरण कहिले पनि प्रयोग नगर्नुहोस्</li>\n"
"<li><i>IfRequested</i>    - TLS गुप्तिकरण स्तरवृद्धि प्रयोग गर्नुहोस्</li>\n"
"<li><i>IfRequested</i>  - यदि सर्भरले सो अनुरोध गरेमा गुप्तिकरण प्रयोग गर्नुहोस्</li>\n"
"</ul><p>\n"
"पूर्वनिर्धारित मान \"IfRequested\"हो ।</p>\n"

#: cupsd.conf.template.cpp:604
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Access permissions</b>\n"
"<p>\n"
"Access permissions for each directory served by the scheduler.\n"
"Locations are relative to DocumentRoot...</p>\n"
msgstr ""
"<b>पहुँच अनुमति</b>\n"
"<p>\n"
"नियोजकद्वारा सेवारत हरेक डाइरेक्टरीका लागि पहुँच अनुमति ।\n"
"स्थान कागजात मूलसँग सम्बन्धित छ...</p>\n"

#: cupsd.conf.template.cpp:610
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Auto purge jobs (AutoPurgeJobs)</b>\n"
"<p>\n"
"Automatically purge jobs when not needed for quotas.\n"
"Default is No.</p>\n"
msgstr ""
"<b>स्वत: खारेजी कार्य (AutoPurgeJobs)</b>\n"
"<p>\n"
"आवश्यक नपरेको बेला निष्कर्षणका लागि कार्य स्वचालित तरिकाले खारेज हुन्छ ।\n"
"पूर्वनिर्धारित 'होइन' हो ।</p>\n"

#: cupsd.conf.template.cpp:616
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Browse protocols (BrowseProtocols)</b>\n"
"<p>\n"
"Which protocols to use for browsing.  Can be\n"
"any of the following separated by whitespace and/or commas:</p>\n"
"<ul type=circle>\n"
"<li><i>all</i>  - Use all supported protocols.</li>\n"
"<li><i>cups</i> - Use the CUPS browse protocol.</li>\n"
"<li><i>slp</i>  - Use the SLPv2 protocol.</li>\n"
"</ul><p>\n"
"The default is <b>cups</b>.</p>\n"
"<p>\n"
"Note: If you choose to use SLPv2, it is <b>strongly</b> recommended that\n"
"you have at least one SLP Directory Agent (DA) on your\n"
"network.  Otherwise, browse updates can take several seconds,\n"
"during which the scheduler will not response to client\n"
"requests.</p>\n"
msgstr ""
"<b>प्रोटोकोल ब्राउज गर्नुहोस् (BrowseProtocols)</b>\n"
"<p>\n"
"ब्राउज गर्न कुन प्रोटोकोल प्रयोग गरिन्छ । सेतो खालीस्थान र/वा अल्पविरामद्वारा विभाजन "
"गरिएका तलका मध्ये कुनै\n"
"पनि एउटा हुन सक्छ:</p>\n"
"<ul type=circle>\n"
"<li><i>all</i>  - सबै समर्थित प्रोटोकोल प्रयोग गर्नुहोस् ।</li>\n"
"<li><i>cups</i> - CUPS ब्राउज प्रोटोकोल प्रयोग गर्नुहोस् ।</li>\n"
"<li><i>slp</i>  - SLPv2 प्रोटोकोल प्रयोग गर्नुहोस् ।</li>\n"
"</ul><p>\n"
"पूर्वनिर्धारित <b>cups</b> हो।</p>\n"
"<p>\n"
"द्रष्टव्य: यदि तपाईँले SLPv2 प्रयोग गर्न रोज्नु भयो भने, यो <b>कडाईका साथ</b> सिफरिश "
"गरिन्छ कि\n"
"तपाईँसँग आफ्नो सञ्जालमा कम्तिमा एउटा SLP डाइरेक्टरी अभिकर्ता (DA)\n"
"हुनुपर्दछ ।  अन्यथा, ब्राउजर अद्यावधिकले धेरै समय लिन सक्छ,\n"
"सो समयमा नियोजकले क्लाइन्ट अनुरोधलाई\n"
"प्रतिक्रिया दिनेछैन ।</p>\n"

#: cupsd.conf.template.cpp:634
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Classification (Classification)</b>\n"
"<p>\n"
"The classification level of the server.  If set, this\n"
"classification is displayed on all pages, and raw printing is disabled.\n"
"The default is the empty string.</p>\n"
"<p>\n"
"<i>ex</i>: confidential\n"
msgstr ""
"<b>वर्गीकरण (Classification)</b>\n"
"<p>\n"
"सर्भरको वर्गीकरण तह ।  यदि सेट गरेमा, यो वर्गीकरण\n"
"सबै पृष्ठमा प्रदर्शन हुन्छ, र पङ्क्ति मुद्रण अक्षम हुन्छ ।\n"
"पूर्वनिर्धारित खाली स्ट्रिङ हो ।</p>\n"
"<p>\n"
"<i>ex</i>: गोप्य\n"

#: cupsd.conf.template.cpp:643
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Allow overrides (ClassifyOverride)</b>\n"
"<p>\n"
"Whether to allow users to override the classification\n"
"on printouts. If enabled, users can limit banner pages to before or\n"
"after the job, and can change the classification of a job, but cannot\n"
"completely eliminate the classification or banners.</p>\n"
"<p>\n"
"The default is off.</p>\n"
msgstr ""
"<b>अधिरोहण गर्न अनुमति दिनुहोस् (ClassifyOverride)</b>\n"
"<p>\n"
"प्रयोगकर्तालाई मुद्रणमा वर्गिकरण\n"
"अधिरोहण गर्न अनुमति दिने वा नदिने । यदि सक्षम पारिएमा, प्रयोगकर्ताले ब्यानर पृष्ठको\n"
"अगाडि वा पछाडि सिमाबद्ध गर्न सक्दछ, र कामको वर्गिकरण परिवर्तन गर्न सक्दछ, तर "
"पूर्णरूपमा\n"
"ब्यानर वा वर्गीकरण नष्ट गर्न सक्दैन ।</p>\n"
"<p>\n"
"पूर्वनिर्धारित बन्द हो ।</p>\n"

#: cupsd.conf.template.cpp:653
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Hide implicit members (HideImplicitMembers)</b>\n"
"<p>\n"
"Whether or not to show the members of an\n"
"implicit class.</p>\n"
"<p>\n"
"When HideImplicitMembers is On, any remote printers that are\n"
"part of an implicit class are hidden from the user, who will\n"
"then only see a single queue even though many queues will be\n"
"supporting the implicit class.</p>\n"
"<p>\n"
"Enabled by default.</p>\n"
msgstr ""
"<b>अस्पष्ट सदस्य लुकाउनुहोस् (HideImplicitMembers)</b>\n"
"<p>\n"
"अस्पष्ट वर्गका सदस्य\n"
"देखाउने वा नदेखाउने ।</p>\n"
"<p>\n"
"जब HideImplicitMembers खुला हुन्छ, स्पष्ट कक्षको भागको रूपमा रहेका कुनै मुद्रक\n"
"प्रयोगकर्ताबाट लुकाइन्छ, धेरै स्पष्ट वर्गले धेरै लाम समर्थन गर्ने भएता पनि\n"
"उसले केबल एउटा लाम मात्र \n"
"देख्न सक्दछ ।</p>\n"
"<p>\n"
"पूर्वनिर्धारित रूपमा सक्षम पारिएको ।</p>\n"

#: cupsd.conf.template.cpp:666
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Use &quot;any&quot; classes (ImplicitAnyClasses)</b>\n"
"<p>\n"
"Whether or not to create <b>AnyPrinter</b> implicit\n"
"classes.</p>\n"
"<p>\n"
"When ImplicitAnyClasses is On and a local queue of the same name\n"
"exists, e.g. \"printer\", \"printer@server1\", \"printer@server1\", then\n"
"an implicit class called \"Anyprinter\" is created instead.</p>\n"
"<p>\n"
"When ImplicitAnyClasses is Off, implicit classes are not created\n"
"when there is a local queue of the same name.</p>\n"
"<p>\n"
"Disabled by default.</p>\n"
msgstr ""
"<b>quot;anyquot; वर्ग प्रयोग गर्नुहोस् (ImplicitAnyClasses)</b>\n"
"<p>\n"
"<b>AnyPrinter</b> अस्पष्ट कक्ष\n"
"सिर्जना गर्ने कि नगर्ने ।</p>\n"
"<p>\n"
"जब ImplicitAnyClasses खुला हुन्छ र समान नामको स्थानीय लाम देखिन्छ \n"
"उदाहरण \"printer\", \"printer@server1\", \"printer@server1\", त्यसपछि\n"
"सट्टामा \"Anyprinter\" भनिने अस्पष्ट कक्ष सिर्जना गरिन्छ ।</p>\n"
"<p>\n"
"जब ImplicitAnyClasses बन्द हुन्छ,\n"
"समान नामको स्थानीय लाम हुन्छ, अस्पष्ट वर्ग सिर्जना गरिंदैन ।</p>\n"
"<p>\n"
"पूर्वनिर्धारितद्वारा अक्षम पारिएको ।</p>\n"

#: cupsd.conf.template.cpp:681
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Max jobs (MaxJobs)</b>\n"
"<p>\n"
"Maximum number of jobs to keep in memory (active and completed).\n"
"Default is 0 (no limit).</p>\n"
msgstr ""
"<b>अधिकतम कार्य (MaxJobs)</b>\n"
"<p>\n"
"स्मृतिमा राख्न (सक्रिय र पूर्ण) कार्यको अधिकतम सङ्ख्या ।\n"
"पुर्वनिर्धारित ० (असिमित) हो ।</p>\n"

#: cupsd.conf.template.cpp:687
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Max jobs per user (MaxJobsPerUser)</b>\n"
"<p>\n"
"The MaxJobsPerUser directive controls the maximum number of <i>active</i>\n"
"jobs that are allowed for each user. Once a user reaches the limit, new\n"
"jobs will be rejected until one of the active jobs is completed, stopped,\n"
"aborted, or canceled.</p>\n"
"<p>\n"
"Setting the maximum to 0 disables this functionality.\n"
"Default is 0 (no limit).\n"
"</p>\n"
msgstr ""
"<b>प्रत्येक प्रयोगकर्ताका लागि अधिक काम (MaxJobsPerUser)</b>\n"
"<p>\n"
"MaxJobsPerUser निर्देशले प्रत्येक प्रयोकर्ताका लागि अनुमति प्राप्त <i>सक्रिय</i>\n"
"कामको अधिकतम सङ्ख्या नियन्त्रण गर्दछ । प्रयोगकर्ताले एक पटक सो दायरा पुग्छ, सक्रिय काम "
"मध्ये एउटा \n"
"सम्पन्न, रोकिए, \n"
"परित्याग, वा रद्द नभए सम्म नयाँ काम अस्वीकार गरिन्छ ।</p>\n"
"<p>\n"
"अधिकतमलाई ० सेटिङले प्रकार्यत्मकता अक्षम पार्दछ ।\n"
"पूर्वनिर्धारित ० हो (सीमा छैन) ।\n"
"</p>\n"

#: cupsd.conf.template.cpp:699
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Max jobs per printer (MaxJobsPerPrinter)</b>\n"
"<p>\n"
"The MaxJobsPerPrinter directive controls the maximum number of <i>active</"
"i>\n"
"jobs that are allowed for each printer or class. Once a printer or class\n"
"reaches the limit, new jobs will be rejected until one of the active jobs\n"
"is completed, stopped, aborted, or canceled.</p>\n"
"<p>\n"
"Setting the maximum to 0 disables this functionality.\n"
"Default is 0 (no limit).\n"
"</p>\n"
msgstr ""
"<b>प्रत्येक मुद्रकका लागि अधिक कार्य (MaxJobsPerPrinter)</b>\n"
"<p>\n"
"MaxJobsPerPrinter निर्देशनले अधिक सङ्ख्यामा <i>सक्रिय</i>\n"
"कार्य नियन्त्रण गर्दछ जुन हरेक मुद्रक र वर्गका लागि अनुमति छन् । एकपटक मुद्रक वा वर्ग\n"
"सीमा पुगेपछि, कुनै एउटा सक्रिय कार्य पूर्ण नभएसम्म, नरोकेसम्म, परित्याग नभएसम्म, वा रद्द "
"नभएसम्म\n"
"नयाँ कार्य अस्वीकार हुनेछन् ।</p>\n"
"<p>\n"
"अधिकतमलाई ० मा सेटिङ गर्दा यो कार्यात्मकतालाई अक्षम पर्दछ ।\n"
"पूर्वनिर्धारित ० (सीमा छैन) हो ।\n"
"</p>\n"

#: cupsd.conf.template.cpp:711
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Port</b>\n"
"<p>\n"
"The port value that the CUPS daemon is listening to. Default is 631.</p>\n"
msgstr ""
"<b>पोर्ट</b>\n"
"<p>\n"
"CUPS डेइमोनले सुनिरहेको पोर्ट मान । D पूर्वनिर्धारित 631 हो ।</p>\n"

#: cupsd.conf.template.cpp:716
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<b>Address</b>\n"
"<p>\n"
"The address that the CUPS daemon is listening at. Leave it empty or use\n"
"an asterisk (*) to specify a port value on the entire subnetwork.</p>\n"
msgstr ""
"<b>ठेगाना</b>\n"
"<p>\n"
"UPS डेइमोन ले सुनिरहेको ठेगाना । त्यसलाई खाली छोड्नुहोस् वा सम्पूर्ण उपसञ्जालमा पोर्ट मान "
"उल्येख गर्न एस्ट्रिक (*) प्रयोग गर्नुहोस् ।</p>\n"

#: cupsd.conf.template.cpp:722
msgctxt ""
"Do not translate the keyword between brackets (e.g. ServerName, ServerAdmin, "
"etc.)"
msgid ""
"<p>Check this box if you want to use SSL encryption with this address/port.\n"
"</p>\n"
msgstr ""
"<p>यदि तपाईँ यस ठेगाना/पोर्टसँगै SSL गुप्तिकरण प्रयोग गर्न चहानुहुन्छ भने यो बाकस जाँच "
"गर्नुहोस् ।\n"
"</p>\n"

