#: rc.cpp:144
msgid ""
"<font size=\"+1\">Welcome to Project Wizard!</font>\n"
"<br/>\n"
"<p>\n"
"The wizard will help you to setup a new translation\n"
"project for KBabel.\n"
"</p>\n"
"<p>\n"
"First of all, you need to choose the project name\n"
"and the file, where the configuration should be stored.\n"
"</p>\n"
"<p>\n"
"You should also choose a language to translate into\n"
"and also a type of the translation project.\n"
"</p>"
msgstr ""
"<font size=\"+1\">परियोजना विजार्डमा स्वागतम !</font>\n"
"<br/>\n"
"<p>\n"
"विजार्डले केब्याबलका लागि नयाँ अनुवाद परियोजना\n"
"सेटअप गर्न तपाईँलाई मद्दत गर्दछ ।\n"
"</p>\n"
"<p>\n"
"सबभन्दा पहिला तपाईँले कन्फिगरेसन भण्डार गर्नुपर्ने स्थानमा,\n"
"फाइल र परियोजना नाम छनोट गर्नु पर्दछ ।\n"
"</p>\n"
"<p>\n"
"तपाईँले यसका साथै अनुवाद गर्ने भाषा र\n"
"अनुवाद परियोजनाको प्रकार पनि छनोट गर्नु पर्दछ ।\n"
"</p>"

#. i18n: tag string
#. i18n: file ./commonui/projectwizardwidget.ui line 63
#. i18n: tag string
#. i18n: file ./commonui/projectwizardwidget.ui line 179
#: rc.cpp:160 rc.cpp:234
msgid ""
"<qt>\n"
"<p><b>Configuration File Name</b><br/>\n"
"The name of a file to store the configuration of the\n"
"project.</p>\n"
"</qt>"
msgstr ""
"<qt>\n"
"<p><b>कन्फिगरेसन फाइल नाम</b><br/>\n"
"परियोजनाको कन्फिगरेसन भण्डारण गर्न\n"
"फाइलको नाम ।</p>\n"
"</qt>"

#. i18n: tag string
#. i18n: file ./commonui/projectwizardwidget.ui line 76
#. i18n: tag string
#. i18n: file ./commonui/projectwizardwidget.ui line 118
#: rc.cpp:167 rc.cpp:192
msgid ""
"<qt>\n"
"<p>\n"
"<b>Language</b><br/>\n"
"The destination language of the project, i.e., the language\n"
"to translate into. It should follow the ISO 631 language naming\n"
"standard.</p>\n"
"</qt>"
msgstr ""
"<qt>\n"
"<p>\n"
"<b>भाषा</b><br/>\n"
"परियोजनाको गन्तव्य भाषा, जस्तै अनुवाद गर्नुपर्ने \n"
"भाषा । यसले ISO 631 भाषा नाम\n"
"मानक अनुशरण गर्नुपर्दछ ।</p>\n"
"</qt>"

#. i18n: tag string
#. i18n: file ./commonui/projectwizardwidget.ui line 79
#: rc.cpp:176
msgid "&Language:"
msgstr "भाषा:"

#. i18n: tag string
#. i18n: file ./commonui/projectwizardwidget.ui line 99
#. i18n: tag string
#. i18n: file ./commonui/projectwizardwidget.ui line 168
#: rc.cpp:179 rc.cpp:224
msgid ""
"<qt><p><b>Project name</b><br/>\n"
"The project name is an identification of a project for\n"
"you. It is shown in the project configuration dialog\n"
"as well as in the title of windows opened for the project.\n"
"<br/>\n"
"<br/>\n"
"<b>Note:</b> The project name cannot be later changed.<\n"
"</p></qt>"
msgstr ""
"<qt><p><b>परियोजना नाम</b><br/>\n"
"परियोजना नाम तपाईँको परियोजनाको परिचय हो ।\n"
"यो परियोजना कन्फिगरेसन संवादका साथै\n"
"परियोजनाका लागि खोलिएको सञ्झ्यालको शीर्षकमा पनि देखिन्छ ।\n"
"<br/>\n"
"<br/>\n"
"<b>द्रष्टव्य:</b> परियोजना नाम पछि परिवर्तन गर्न सकिदैन ।<\n"
"</p></qt>"

#. i18n: tag string
#. i18n: file ./commonui/projectwizardwidget.ui line 102
#: rc.cpp:189
msgid "Project &name:"
msgstr "परियोजना नाम:"

#. i18n: tag string
#. i18n: file ./commonui/projectwizardwidget.ui line 145
#. i18n: tag string
#. i18n: file ./commonui/projectwizardwidget.ui line 209
#: rc.cpp:201 rc.cpp:244
msgid ""
"<qt>\n"
"<p>\n"
"<b>Project Type</b>\n"
"The project type allows to tune the settings for the\n"
"particular type of the well-known translation projects.\n"
"For example, it sets up the validation tools,\n"
"an accelerator marker and formatting of the header.\n"
"</p>\n"
"<p>Currently known types:\n"
"<ul>\n"
"<li><b>KDE</b>: K Desktop Environment Internalization project</li>\n"
"<li><b>GNOME</b>: GNOME Translation project</li>\n"
"<li><b>Translation Robot</b>: Translation Project Robot</li>\n"
"<li><b>Other</b>: Other kind of project. No tuning will be\n"
"done</li>\n"
"</ul>\n"
"</p>\n"
"</qt>"
msgstr ""
"<qt>\n"
"<p>\n"
"<b>परियोजना प्रकार</b>\n"
"परियोजना प्रकारले सबैलाई राम्रोसँग ज्ञान भएको अनुवाद परियोजनाको\n"
"विशेष प्रकारका लागि सेटिङ ट्युन गर्न अनुमति दिन्छ ।\n"
"उदाहरणका लागि, यसले हेडरको ढाँचाबद्धता गतिवर्धक मार्कर र\n"
"वैधता उपकरण सेटअप गर्छ ।\n"
"</p>\n"
"<p>हाललाई ज्ञात प्रकार:\n"
"<ul>\n"
"<li><b>केडीई</b>: केडीई डेक्सटप परिवेश अन्तर्राष्ट्रियकरण परियोजना</li>\n"
"<li><b>जिनोम</b>: जिनोम अनुवाद परियोजना</li>\n"
