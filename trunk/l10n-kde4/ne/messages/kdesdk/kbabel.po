#: commonui/projectprefwidgets.cpp:283
msgid ""
"<qt><p><b>Update Header</b></p>\n"
"<p>Check this button to update the header information of the file every time "
"it is saved.</p>\n"
"<p>The header normally keeps information about the date and time the file "
"was last\n"
"updated, the last translator etc.</p>\n"
"<p>You can choose which information you want to update from the checkboxes "
"below.\n"
"Fields that do not exist are added to the header.\n"
"If you want to add additional fields to the header, you can edit the header "
"manually by choosing\n"
"<b>Edit->Edit Header</b> in the editor window.</p></qt>"
msgstr ""
"<qt><p><b>हेडर अद्यावधिक गर्नुहोस्</b></p>\n"
"<p>फाइललाई प्रत्येक पटक बचत गर्दा हेडरको सूचना अद्यावधिक गर्न यो बटन चेक गर्नुहोस् ।</"
"p>\n"
"<p>हेडरले सामान्यतया फाइलको अद्यावधिक\n"
"अन्तिम अनुवादक इत्यादि कार्यको मिति र समय जस्ता सूचना कायम गर्दछ ।</p>\n"
"<p>तपाईँले तलको चेकबाकसबाट अद्यावधिक गर्न चाहनुभएको सूचना छनोट गर्न सक्नुहुन्छ ।\n"
"अवस्थित नभएको फिल्डहरू हेडरमा थपिन्छ ।\n"
"तपाईँले हेडरमा अतिरिक्त फिल्ड थप्न चाहनुहुन्छ भने, तपाईँले सम्पादक सञ्झ्यालमा\n"
"<b>सम्पादन->हेडर सम्पादन गर्नुहोस्</b> छनोट गरेर म्यानुअलि सम्पादन गर्न सक्नुहुन्छ ।</p></"
"qt>"

#: commonui/projectprefwidgets.cpp:295
msgid ""
"<qt><p><b>Fields to update</b></p>\n"
"<p>Choose which fields in the header you want to have updated when saving.\n"
"If a field does not exist, it is appended to the header.</p>\n"
"<p>If you want to add other information to the header, you have to edit the "
"header manually\n"
"by choosing <b>Edit->Edit Header</b> in the editor window.</p>\n"
"<p>Deactivate <b>Update Header</b> above if you do not want to have the "
"header\n"
"updated when saving.</p></qt>"
msgstr ""
"<qt><p><b>अद्यावधिक गर्ने फिल्ड</b></p>\n"
"<p>तपाईँले बचत गर्दा अद्यावधिक गर्न चाहनुभएको फिल्ड हेडरमा छनोट गर्नुहोस् ।\n"
"फिल्ड अवस्थित छैन भने, यसलाई हेडरमा थपिन्छ ।</p>\n"
"<p>यदि तपाईँले हेडरमा अन्य सूचना थप्न चाहनुहुन्छ भने, तपाईँले सम्पादक सञ्झ्यालमा\n"
" <b>सम्पादन->हेडर सम्पादन गर्नुहोस्</b> छनोट गरेर म्यानुअली सम्पादन गर्नुपर्दछ ।</p>\n"
"<p>बचत गर्दा हेडर अद्यावधिक गर्न चाहनुहुन्न भने <b>हेडर अद्यावधिक गर्नुहोस्</b>\n"
" निस्क्रिय पार्नुहोस् ।</p></qt>"

#: commonui/projectprefwidgets.cpp:303
#, qt-format
msgid ""
"<qt><p><b>Encoding</b></p><p>Choose how to encode characters when saving to "
"a file. If you are unsure what encoding to use, please ask your translation "
"coordinator.</p><ul><li><b>%1</b>: this is the encoding that fits the "
"character set of your system language.</li><li><b>%2</b>: uses Unicode (UTF-"
"8) encoding.</li></ul></qt>"
msgstr ""
"<qt><p><b>सङ्केतन</b></p><p>फाइल बचत गर्दा क्यारेक्टर सङ्केतन गर्ने तरिका छनोट गर्नुहोस् "
"। कुन सङ्केतन प्रयोग गर्ने भनेर यकिन हुनहुन्न भने, कृपया तपाईँको अनुवादक टोली नेतालाई "
"सोध्नुहोस् ।</p><ul><li><b>%1</b>: यो तपाईँको प्रणाली भाषाको क्यारेक्टर सेटसँग मिल्ने "
"सङ्केतन हो ।</li><li><b>%2</b>: (UTF-8) सङ्केतन प्रयोग गर्दछ ।</li></ul></qt>"

#: commonui/projectprefwidgets.cpp:312
msgid ""
"<qt><p><b>Keep the encoding of the file</b></p><p>If this option is "
"activated, files are always saved in the same encoding as they were read in. "
"Files without charset information in the header (e.g. POT files) are saved "
"in the encoding set above.</p></qt>"
msgstr ""
"<qt><p><b>फाइलको सङ्केतन कायम राख्नुहोस्</b></p><p>यो विकल्प सक्षम पारिएमा, फाइलहरू "
"पढिएको सङ्केतनमा नै सधै बचत गरिन्छ । हेडरमा चारसेट सूचना बिनाको फाइल (उदाहरणका लागि "
"POT फाइल) माथि सेट गरेको सङ्केतनमा बचत गरिन्छ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:318
msgid ""
"<qt><p><b>Check syntax of file when saving</b></p>\n"
"<p>Check this to automatically check syntax of file with \"msgfmt --"
"statistics\"\n"
"when saving a file. You will only get a message, if an error occurred.</p></"
"qt>"
msgstr ""
"<qt><p><b>बचत गर्दा फाइलको वाक्यसंरचना चेक गर्नुहोस्</b></p>\n"
"<p>फाइल बचत गर्दा \"msgfmt --statistics\" सँग फाइलको वाक्यसंरचना स्वचालित रुपमा\n"
"चेक गर्नुपरेमा यसलाई चेक गर्नुहोस् । त्रुटि देखापरेमा, तपाईँले केबल सन्देश प्राप्त गर्नुहुनेछ ।</"
"p></qt>"

#: commonui/projectprefwidgets.cpp:322
msgid ""
"<qt><p><b>Save obsolete entries</b></p>\n"
"<p>If this option is activated, obsolete entries found when the file was "
"open\n"
"will be saved back to the file. Obsolete entries are marked by #~ and are\n"
"created when the msgmerge does not need the translation anymore.\n"
"If the text will appear again, the obsolete entries will be activated "
"again.\n"
"The main drawback is the size of the saved file.</p></qt>"
msgstr ""
"<qt><p><b>अप्रचलित प्रविष्टि बचत गर्नुहोस्</b></p>\n"
"<p>यो विकल्प सक्षम पारिएमा, फाइल खुला हुँदा फेला परेको अप्रचलित प्रविष्टिहरू\n"
"फेरि फाइलमा बचत गरिन्छ । अप्रचलित प्रविष्टिहरू #~ द्वारा चिनो लगाइन्छ र\n"
"msgmerge लाई फेरि अनुवाद गर्नुनपरेमा यसलाई सिर्जना गरिन्छ ।\n"
"पाठ फेरि देखापरेमा, अप्रचलित प्रविष्टिहरू पुन: सक्रिय पारिन्छ ।\n"
"मुख्य बेफाइदा नै बचत गरिएको फाइलको साइज हो ।</p></qt>"

#: commonui/projectprefwidgets.cpp:330
msgid ""
"<qt><p><b>Format of Revision-Date</b></p><p>Choose in which format the date "
"and time of the header field\n"
"<i>PO-Revision-Date</i> is saved: <ul>\n"
"<li><b>Default</b> is the format normally used in PO files.</li>\n"
"<li><b>Local</b> is the format specific to your country.\n"
"It can be configured in KDE's Control Center.</li>\n"
"<li><b>Custom</b> lets you define your own format.</li></ul></p> <p>It is "
"recommended that you use the default format to avoid creating non-standard "
"PO files.</p><p>For more information, see section <b>The Preferences Dialog</"
"b> in the online help.</p></qt>"
msgstr ""
"<qt><p><b>पुनरावलोकन-मितिको ढाँचा</b></p><p>हेडर फिल्डको मिति र समयको ढाँचामा "
"छनोट गर्नुहोस्\n"
"<i>PO-पुरावलोकन-मिति</i> बचत छ: <ul>\n"
"<li><b>पूर्वनिर्धारित</b> सामान्यतया PO फाइलमा प्रयोग गरिने ढाँचा हो ।</li>\n"
"<li><b>स्थानीय</b> तपाईँको देशमा निर्दिष्ट ढाँचा हो ।\n"
"यसलाई केडीईको नियन्त्रण केन्द्रमा कन्फिगर गर्न सकिन्छ ।</li>\n"
"<li><b>अनुकूल</b> तपाईँको आफ्नै ढाँचा परिभाषित गर्न दिन्छ ।</li></ul></p> <p>मानक "
"विहिन PO फाइल सिर्जना उपेक्षा गर्न तपाईँलाई पूर्वनिर्धारित ढाँचा प्रयोग गर्न सिफारिश "
"गरिन्छ ।</p><p>बढि जानकारिका लागि, अनलाइन मद्दतका लागि <b>प्राथमिकता संवाद</b> "
"खण्ड हेर्नुहोस् ।</p></qt>"

#: commonui/projectprefwidgets.cpp:428
#, qt-format
msgid "<font size=\"+1\">Project: %1</font>"
msgstr "<font size=\"+1\">परियोजना: %1</font>"

#: commonui/projectprefwidgets.cpp:435
msgid "&Name:"
msgstr "नाम:"

#: commonui/projectprefwidgets.cpp:440
msgid "Localized na&me:"
msgstr "स्थानीकृत नाम:"

#: commonui/projectprefwidgets.cpp:445
msgid "E&mail:"
msgstr "इमेल:"

#: commonui/projectprefwidgets.cpp:451
msgid "&Full language name:"
msgstr "पूरा भाषा नाम:"

#: commonui/projectprefwidgets.cpp:458
msgid "Lan&guage code:"
msgstr "भाषा सङ्केत:"

#: commonui/projectprefwidgets.cpp:465
msgid "&Language mailing list:"
msgstr "भाषा पत्राचार सूची:"

#: commonui/projectprefwidgets.cpp:471
msgid "&Timezone:"
msgstr "टाइमजोन:"

#: commonui/projectprefwidgets.cpp:478
msgid ""
"<qt><p><b>Identity</b></p>\n"
"<p>Fill in information about you and your translation team.\n"
"This information is used when updating the header of a file.</p>\n"
"<p>You can find the options if and what fields in the header should be "
"updated\n"
"on page <b>Save</b> in this dialog.</p></qt>"
msgstr ""
"<qt><p><b>परिचय</b></p>\n"
"<p>तपाईँको अनुवाद टोली र तपाईँको बारेमा सूचना भर्नुहोस्\n"
"फाइलको हेडर अद्यावधिक गर्दा यो सूचना प्रयोग गरिन्छ ।</p>\n"
"<p>तपाईँले यो संवादको \n"
"<b>बचत</b> पृष्ठमा कुन कुन फिल्डहरू हेडरमा अद्यावधिक गर्ने वा नगर्ने भन्ने विकल्प फेला पार्न "
"सक्नुहुन्छ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:494
msgid "&Number of singular/plural forms:"
msgstr "एकवचन/बहुवचन स्वरूपको सङ्ख्या:"

#: commonui/projectprefwidgets.cpp:500
msgctxt "automatic choose number of plural forms"
msgid "Automatic"
msgstr "स्वचालित"

#: commonui/projectprefwidgets.cpp:507
msgid "Te&st"
msgstr "परिक्षण"

#: commonui/projectprefwidgets.cpp:512
msgid ""
"<qt><p><b>Number of singular/plural forms</b></p><p><b>Note</b>: This option "
"is KDE specific. If you are not translating a KDE application, you can "
"safely ignore this option.</p><p>Choose here how many singular and plural "
"forms are used in your language. This number must correspond to the settings "
"of your language team.</p><p>Alternatively, you can set this option to "
"<i>Automatic</i> and KBabel will try to get this information automatically "
"from KDE. Use the <i>Test</i> button to test if it can find it out.</p></qt>"
msgstr ""
"<qt><p><b>एकवचन/बहुवचन स्वरूपको सङ्ख्या</b></p><p><b>द्रष्टव्य</b>: यो विकल्प केडीई "
"निर्दिष्ट हो । तपाईँले केडीई अनुप्रयोग अनुवाद गरिरहनु भएको छैन भने, तपाईँले सुरक्षित रुपमा "
"यसलाई उपेक्षा गर्न सक्नुहुन्छ ।</p><p>तपाईँको भाषामा प्रयोग गरिने एकवचन र बहुवचन स्वरूप "
"कति छन् यहाँ छनोट गर्नुहोस् । यो सङ्ख्या तपाईँको अनुवाद टोलीको सेटिङसँग संगत हुनुपर्दछ ।</"
"p><p>वैकल्पिक रुपमा, तपाईँले यो विकल्पलाई <i>स्वचालित</i> मा सेट गर्न सक्नुहुन्छ र "
"केब्याबलले यो सूचना केडीईबाट स्वचालित रुपमा प्राप्त गर्न प्रयास गर्दछ । यसलाई फेला पार्न "
"सकेमा परिक्षण गर्नका लागि <i>परिक्षण</i> बटन प्रयोग गर्नुहोस् ।</p></qt>"

#: commonui/projectprefwidgets.cpp:530
msgid "&GNU plural form header:"
msgstr "जीएनयू बहुवचन स्वरूप हेडर:"

#: commonui/projectprefwidgets.cpp:541
msgid "&Lookup"
msgstr "खोजी गर्नुहोस्"

#: commonui/projectprefwidgets.cpp:545
msgid "Re&quire plural form arguments in translation"
msgstr "अनुवादमा आवश्यक बहुवचन स्वरूप तर्क"

#: commonui/projectprefwidgets.cpp:548
#, c-format
msgid ""
"<qt><p><b>Require plural form arguments in translation</b></p>\n"
"<p><b>Note</b>: This option is KDE specific at the moment. If you are not "
"translating a KDE application, you can safely ignore this option.</p>\n"
"<p>If is this option enabled, the validation check will require the %n "
"argument to be present in the message.</p></qt>"
msgstr ""
"<qt><p><b>अनुवादमा बहुवचन स्वरूप तर्क आवश्यक</b></p>\n"
"<p><b>द्रष्टव्य</b>: यो विकल्प अहिले केडीई निर्दिष्ट छ । तपाईँले केडीई अनुप्रयोग अनुवाद "
"गर्दै हुनुहुन्न भने, तपाईँले सुरक्षित रुपमा यसलाई उपेक्षा गर्न सक्नुहुन्छ ।</p>\n"
"<p>यो विकल्प सक्षम पारिएमा, सन्देशमा देखाउनका लागि वैधता जाँचलाई %n आवश्यक पर्दछ ।</"
"p></qt>"

#: commonui/projectprefwidgets.cpp:556
msgid ""
"<qt><p><b>GNU plural form header</b></p>\n"
"<p>Here you can fill a header entry for GNU plural form handling; if you "
"leave the entry empty, the entry in the PO file will not be changed or added."
"</p>\n"
"<p>KBabel can automatically try to determine value suggested by the GNU "
"gettext tools for currently set language; just press the <b>Lookup</b> "
"button.</p></qt>"
msgstr ""
"<qt><p><b>जीएनयू बहुवचन स्वरूप हेडर</b></p>\n"
"<p>यहाँ तपाईँले जीएनयू बहुवचन स्वरूप ह्यान्डलिङका लागि हेडर प्रविष्टि भर्न सक्नुहुन्छ । तपाईँले "
"यसलाई खाली छोड्नुभयो भने, PO फाइलमा प्रविष्टिहरू थपिदैन वा परिवर्तन हुँदैन ।</p>\n"
"<p>केब्याबलले हालै सेट गरेको भाषाका लागि जीएनयू गेटटेक्स उपकरणद्वारा सुझाव गरेको मान "
"स्वचालित रुपमा निर्धारण गर्न प्रयास गर्न सक्दछ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:635 commonui/projectprefwidgets.cpp:669
msgid "Please insert a language code first."
msgstr "कृपया पहिला भाषा सङ्केत घुसाउनुहोस्"

#: commonui/projectprefwidgets.cpp:645
#, qt-format
msgid ""
"It is not possible to find out the number of singular/plural forms "
"automatically for the language code \"%1\".\n"
"Do you have kdelibs.po installed for this language?\n"
"Please set the correct number manually."
msgstr ""
"\"%1\" भाषा सङ्केतका लागि एकवचन/बहुवचन स्वरूप स्वचालित रुपमा पत्ता लगाउन सम्भव हुँदैन ।\n"
"यो भाषाका लागि तपाईँले kdelibs.po स्थापना गर्नुभएको छ ?\n"
"कृपया सही सङ्ख्या म्यानुअली सेट गर्नुहोस् ।"

#: commonui/projectprefwidgets.cpp:653
#, qt-format
msgid ""
"The number of singular/plural forms found for the language code \"%1\" is %2."
msgstr " \"%1\" भाषा सङ्केतका लागि फेला परेको एकवचन/बहुवचन स्वरूपको सङ्ख्या %2 हो ।"

#: commonui/projectprefwidgets.cpp:677
msgid ""
"It was not possible to determine GNU header for plural forms. Maybe your GNU "
"gettext tools are too old or they do not contain a suggested value for your "
"language."
msgstr ""
"बहुवचन स्वरूपका लागि जीएनयू हेडर निर्धारण गर्न सम्भव हुँदैन । बहुवचन स्वरूपका लागि जीएनयू "
"हेडर धेरै पुरानो वा तपाईँको भाषाका लागि तिनीहरूले सुझाव गरेको मानमा समाविष्ट नगरेको "
"हुनसक्दछ ।"

#: commonui/projectprefwidgets.cpp:704
msgid "&Marker for keyboard accelerator:"
msgstr "कुञ्जीपाटी गतिवर्धकका लागि मार्कर:"

#: commonui/projectprefwidgets.cpp:710
msgid ""
"<qt><p><b>Marker for keyboard accelerator</b></p><p>Define here, what "
"character marks the following character as keyboard accelerator. For example "
"in Qt it is '&amp;' and in Gtk it is '_'.</p></qt>"
msgstr ""
"<qt><p><b>कुञ्जीपाटी गतिवर्धकका लागि मार्कर</b></p><p>कुञ्जीपाटी गतिवर्धकको रुपमा "
"निम्न क्यारेक्टरमा चिनो लगाउने क्यारेक्टर यहाँ परिभाषित गर्नुहोस् । उदाहरणका लागिQt मा "
"'&amp;' र Gtk मा '_' हुन्छ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:721
msgid "&Regular expression for context information:"
msgstr "प्रसङ्ग सूचनाका लागि नियमित अभिव्यक्ति:"

#: commonui/projectprefwidgets.cpp:728
msgid ""
"<qt><p><b>Regular expression for context information</b></p><p>Enter a "
"regular expression here which defines what is context information in the "
"message and must not get translated.</p></qt>"
msgstr ""
"<qt><p><b>प्रसङ्ग सूचनाका लागि नियमित अभिव्यक्ति</b></p><p>सन्देशमा प्रसङ्ग सूचना के हो "
"भनेर परिभाषित गर्ने र अनुवाद गर्न नपर्ने नियमित अभिव्यक्ति यहाँ प्रविष्ट गर्नुहोस् ।</p></"
"qt>"

#: commonui/projectprefwidgets.cpp:744
msgid "Compression Method for Mail Attachments"
msgstr "मेल संलग्रका लागि सङ्कुचन विधि"

#: commonui/projectprefwidgets.cpp:749
msgid "tar/&bzip2"
msgstr "tar/bzip2"

#: commonui/projectprefwidgets.cpp:751
msgid "tar/&gzip"
msgstr "tar/gzip"

#: commonui/projectprefwidgets.cpp:753
msgid "&Use compression when sending a single file"
msgstr "एकल फाइल पठाउदा सङ्कुचन प्रयोग गर्नुहोस्"

#: commonui/projectprefwidgets.cpp:832
msgid "On the &fly spellchecking"
msgstr "फ्लाइ हिज्जेपरिक्षणमा"

#: commonui/projectprefwidgets.cpp:836
msgid ""
"<qt><p><b>On the fly spellchecking</b></p><p>Activate this to let KBabel "
"spell check the text as you type. Mispelled words will be colored by the "
"error color.</p></qt>"
msgstr ""
"<qt><p><b>फ्लाइ हिज्जेपरिक्षणमा</b></p><p>तपाईँले टाइप गरेको पाठको केब्याबलले हिज्जे "
"परिक्षण गर्न दिन यसलाई सक्रिय पार्नुहोस् । गलत हिज्जे भएको शब्द छुट्टै रङमा आउछ ।</p></"
"qt>"

#: commonui/projectprefwidgets.cpp:843
msgid "&Remember ignored words"
msgstr "उपेक्षा गरेको शब्द सम्झनुहोस्"

#: commonui/projectprefwidgets.cpp:850
msgid "F&ile to store ignored words:"
msgstr "उपेक्षा गरेको शब्द भण्डारण गर्ने फाइल:"

#: commonui/projectprefwidgets.cpp:861
msgid ""
"<qt><p><b>Remember ignored words</b></p><p>Activate this, to let KBabel "
"ignore the words, where you have chosen <i>Ignore All</i> in the spell check "
"dialog, in every spell check.</p></qt>"
msgstr ""
"<qt><p><b>उपेक्षा गरेको शब्द सम्झनुहोस्</b></p><p>प्रत्येक पटक हिज्जेपरिक्षण गर्दा तपाईँले "
"हिज्जे परिक्षण संवादमा <i>सबै उपेक्षा गर्नुहोस्</i> छनोट गर्नुभएको स्थान, केब्याबलले शब्दहरू "
"उपेक्षा गर्न दिन यसलाई सक्रिय पार्नुहोस् ।</p></qt>"

