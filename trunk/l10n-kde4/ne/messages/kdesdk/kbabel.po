msgid "Ba&se folder of POT files:"
msgstr "POT फाइलको आधार फोल्डर:"

#: commonui/projectprefwidgets.cpp:950
msgid ""
"<qt><p><b>Base folders</b></p>\n"
"<p>Type in the folders which contain all your PO and POT files.\n"
"The files and the folders in these folders will then be merged into one\n"
"tree.</p></qt>"
msgstr ""
"<qt><p><b>आधार फोल्डर</b></p>\n"
"<p>तपाईँको सबै PO र POT फाइल समाविष्ट गर्ने फोल्डरमा टाइप गर्नुहोस् ।\n"
"ती फोल्डरमा रहेका फाइल र फोल्डरहरू एउटा ट्रीमा\n"
"गाभिन्छ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:960
msgid "O&pen files in new window"
msgstr "नयाँ सञ्झ्यालमा फाइल खोल्नुहोस्"

#: commonui/projectprefwidgets.cpp:964
msgid ""
"<qt><p><b>Open files in new window</b></p>\n"
"<p>If this is activated all files that are opened from the Catalog Manager "
"are opened\n"
"in a new window.</p></qt>"
msgstr ""
"<qt><p><b>नयाँ सञ्झ्यालमा फाइल खोल्नुहोस्</b></p>\n"
"<p>यसलाई सक्रिय पारेमा विवरणिका प्रबन्धकबाट खोलिएका सबै फाइलहरू\n"
"नयाँ सञ्झ्यालमा खोलिन्छ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:968
msgid "&Kill processes on exit"
msgstr "अन्त्य गर्दा प्रक्रियाहरू नष्ट गर्नुहोस्"

#: commonui/projectprefwidgets.cpp:971
msgid ""
"<qt><p><b>Kill processes on exit</b></p>\n"
"<p>If you check this, KBabel tries to kill the processes, that have not "
"exited already when KBabel exits,\n"
"by sending a kill signal to them.</p>\n"
"<p>NOTE: It is not guaranteed that the processes will be killed.</p></qt>"
msgstr ""
"<qt><p><b>अन्त्य गर्दा प्रक्रिया नष्ट गर्नुहोस्</b></p>\n"
"<p>तपाईँले यसलाई चेक गर्दा, केब्याबल अन्त्य हुनुपूर्व अन्त्य नभएका प्रक्रियाहरू नष्ट गर्न "
"केब्याबलले\n"
"तिनीहरूमा नष्ट गर्ने सङ्केत पठाएर प्रयास गर्दछ ।</p>\n"
"<p>द्रष्टव्य: प्रक्रियाहरू नष्ट हुन्छ नै भन्ने विश्वास गर्न सकिदैन ।</p></qt>"

#: commonui/projectprefwidgets.cpp:977
msgid "Create inde&x for file contents"
msgstr "फाइल सामग्रीका लागि अनुक्रमणिका सिर्जना गर्नुहोस्"

#: commonui/projectprefwidgets.cpp:980
msgid ""
"<qt><p><b>Create index for file contents</b></p>\n"
"<p>If you check this, KBabel will create an index for each PO file to speed "
"up the find/replace functions.</p>\n"
"<p>NOTE: This will slow down updating the file information considerably.</"
"p></qt>"
msgstr ""
"<qt><p><b>फाइल सामग्रीका लागि अनुक्रमणिका सिर्जना गर्नुहोस्</b></p>\n"
"<p>तपाईँले यसमा चेक गर्दा, केब्याबलले फेला पार्ने/प्रतिस्थापन गर्ने प्रकार्यको गति बढाउन "
"प्रत्येक PO फाइलका लागि अनुक्रमणिका सिर्जना गर्दछ ।</p>\n"
"<p>द्रष्टव्य: यसले फाइल सूचना अद्यावधिकलाई धेरै ढिलो बनाउछ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:984
msgid "Run &msgfmt before processing a file"
msgstr "फाइल प्रक्रिया गर्नुपूर्व msgfmt चलाउनुहोस्"

#: commonui/projectprefwidgets.cpp:987
msgid ""
"<qt><p><b>Run msgfmt before processing a file</b></p><p>If you enable this, "
"KBabel will run Gettext's msgfmt tool before processing a file.</"
"p><p>Enabling this setting is recommended, even if it causes processing to "
"be slower. This setting is enabled by default.</p><p>Disabling is useful for "
"slow computers and when you want to translate PO files that are not "
"supported by the current version of the Gettext tools that are on your "
"system. The drawback of disabling is that hardly any syntax checking is done "
"by the processing code, so invalid PO files could be shown as good ones, "
"even if Gettext tools would reject such files.</p></qt>"
msgstr ""
"<qt><p><b>फाइल प्रक्रिया गर्नुपूर्व msgfmt चलाउनुहोस्</b></p><p>तपाईँले यसलाई सक्षम "
"पार्दा, केब्याबलले फाइल प्रक्रिया गर्नुपूर्व गेटटेक्सको msgfmt उपकरण चलाउछ ।</"
"p><p>प्रकियालाई केहि ढिला बनाए पनि यो सेटिङ सक्षम पार्न सिफारिश गरिन्छ । यो सेटिङ "
"पूर्वनिर्धारित रुपमा सक्षम हुन्छ ।</p><p>तपाईँको कम्प्युटर ढिलो हुँदा र तपाईँको प्रणालीको "
"गेटटेक्स उपकरणलाई हालको संस्करणद्वारा समर्थन नहुँने PO फाइल तपाईँले अनुवाद गर्न चाहनुभएमा "
"अक्षम पार्नु नै उपयोगी हुन्छ । अक्षम पार्दा हुने कमजोरी भनेको प्रक्रिया सङ्केतद्वारा "
"वाक्यससंरचना जाँच नगर्ने सम्भावना धेरै हुन्छ, जसले गर्दा गेटटेक्स उपकरणले अस्वीकार गर्न सक्ने "
"अवैध PO फाइलहरू पनि वैध देखिन्छ ।</p></qt>"

#: commonui/projectprefwidgets.cpp:1028
msgid "Commands for Folders"
msgstr "फोल्डरका लागि आदेश"

#: commonui/projectprefwidgets.cpp:1033
msgid ""
"Replaceables:\n"
"@PACKAGE@, @PODIR@, @POTDIR@\n"
"@POFILES@, @MARKEDPOFILES@"
msgstr ""
"प्रतिस्थापन योग्य:\n"
"@PACKAGE@, @PODIR@, @POTDIR@\n"
"@POFILES@, @MARKEDPOFILES@"

#: commonui/projectprefwidgets.cpp:1038
msgid ""
"<qt><p><b>Commands for folders</b></p><p>Insert here the commands you want "
"to execute in folders from the Catalog Manager. The commands are then shown "
"in the submenu <b>Commands</b> in the Catalog Manager's context menu.</"
"p><p>The following strings will be replaced in a command:<ul><li>@PACKAGE@: "
"The name of the folder without path</li><li>@PODIR@: The name of the PO-"
"folder with path</li><li>@POTDIR@: The name of the template folder with "
"path</li><li>@POFILES@: The names of the PO files with path</"
"li><li>@MARKEDPOFILES@: The names of the marked PO files with path</li></"
"ul></p></qt>"
msgstr ""
"<qt><p><b>फोल्डरका लागि आदेश</b></p><p>विवरणिका प्रबन्धकबाट फोल्डरमा कार्यान्वयन "
"गर्न चाहनुभएको आदेश यहाँ घुसाउनुहोस् । ती आदेशहरू त्यसपछि विवरणिका प्रबन्ध प्रसङ्ग मेनुको "
"सहायक मेनु <b>आदेश</b> मा देखिन्छन् ।</p><p>निम्न स्ट्रिङहरू आदेशमा प्रतिमस्थापन गरिन्छ:"
"<ul><li>@PACKAGE@: मार्ग बिनाको फोल्डरको नाम</li><li>@PODIR@: मार्ग सहितको PO-"
"फोल्डरको नाम</li><li>@POTDIR@: मार्ग सहित टेम्प्लेट फोल्डरको नाम </"
"li><li>@POFILES@: मार्ग सहित PO फाइलको नाम</li><li>@MARKEDPOFILES@: मार्ग सहित "
"चिनो लगाइएको PO फाइलको नाम</li></ul></p></qt>"

#: commonui/projectprefwidgets.cpp:1091
msgid "Commands for Files"
msgstr "फाइलका लागि आदेश"

#: commonui/projectprefwidgets.cpp:1096
msgid ""
"Replaceables:\n"
"@PACKAGE@, @POFILE@,@POTFILE@,\n"
"@PODIR@, @POTDIR@"
msgstr ""
"प्रतिस्थापन योग्य:\n"
"@PACKAGE@, @POFILE@,@POTFILE@,\n"
"@PODIR@, @POTDIR@"

#: commonui/projectprefwidgets.cpp:1101
msgid ""
"<qt><p><b>Commands for files</b></p><p>Insert here the commands you want to "
"execute on files from the Catalog Manager. The commands are then shown in "
"the submenu <b>Commands</b> in the Catalog Manager's context menu.</p><p>The "
"following strings will be replaced in a command:<ul><li>@PACKAGE@: The name "
"of the file without path and extension</li><li>@POFILE@: The name of the PO-"
"file with path and extension</li><li>@POTFILE@: The name of the "
"corresponding template file with path and extension</li><li>@POEMAIL@: The "
"name and email address of the last translator</li><li>@PODIR@: The name of "
"the folder the PO-file is in, with path</li><li>@POTDIR@: The name of the "
"folder the template file is in, with path</li></ul></p></qt>"
msgstr ""
"<qt><p><b>फाइलका लागि आदेश</b></p><p>विवरणिका प्रबन्धकबाट फाइलमा कार्यान्वयन गर्न "
"चाहनुभएको आदेश यहाँ घुसाउनुहोस् । आदेशहरू त्यसपछि विवरणिका प्रबन्धक मेनुको सहायक मेनु "
"<b>आदेश</b> मा देखिन्छ ।</p><p>निम्न स्ट्रिङहरू आदेशमा प्रतिस्थापन गरिन्छ:"
"<ul><li>@PACKAGE@: मार्ग र विस्तार बिनाको फाइलको नाम</li><li>@POFILE@: मार्ग र "
"विस्तार सहित PO-फाइलको नाम</li><li>@POTFILE@: मार्ग र विस्तार सहित संगत टेम्प्लेट "
"फाइलको नाम</li><li>@POEMAIL@: अन्तिम अनुवादकको नाम र इमेल ठेगाना</"
"li><li>@PODIR@: मार्ग सहित PO-फाइल रहेको फोल्डरको नाम</li><li>@POTDIR@: मार्ग "
"सहित टेम्प्लेट फाइल रहेको फोल्डरको नाम</li></ul></p></qt>"

