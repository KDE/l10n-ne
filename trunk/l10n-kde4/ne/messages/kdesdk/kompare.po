#: libdialogpages/diffpage.cpp:218
msgid "Diff Program"
msgstr "फरक कार्यक्रम"

#: libdialogpages/diffpage.cpp:223
msgid ""
"You can select a different diff program here. On Solaris the standard diff "
"program does not support all the options that the GNU version does. This way "
"you can select that version."
msgstr ""
"तपाईँले यहाँ विभिन्न फरक देखाउने (diff) कार्यक्रम चयन गर्न सक्नुहुन्छ । सोलारिसमा मानक "
"फरक कार्यक्रमले जीएनयू संस्करणले जस्तो सबै विकल्प समर्थन गर्दैन । यो तरीकाले तपाईँले त्यो "
"संस्करण चयन गर्न सक्नुहुन्छ ।"

#: libdialogpages/diffpage.cpp:228
msgid "&Diff"
msgstr "फरक"

#: libdialogpages/diffpage.cpp:240
msgid ""
"Select the format of the output generated by diff. Unified is the one that "
"is used most frequently because it is very readable. The KDE developers like "
"this format the best so use it for sending patches."
msgstr ""
"फरक रूपमा सिर्जना गरिएका निर्गातको ढाँचा चयन गर्नुहोस् । प्रायजसो धेरै प्रयोग गरिने "
"एकीकृत हो किनभने यो धेरै पढ्न मिल्ने हुन्छ । केडीई विकासकर्ताहरूले सबैभन्दा बढी मन परायो "
"त्यसैले टुक्राहरू पठाउन यो प्रयोग गर्नुहोस् ।"

#: libdialogpages/diffpage.cpp:242
msgid "Output Format"
msgstr "निर्गत ढाँचा"

#: libdialogpages/diffpage.cpp:257
msgid "Lines of Context"
msgstr "रेखा प्रसङ्ग"

#. i18n: tag string
#. i18n: file komparepart/komparesaveoptionsbase.ui line 312
#: libdialogpages/diffpage.cpp:260 rc.cpp:83
msgid "Number of context lines:"
msgstr "रेखा प्रसङ्गको सङ्ख्या:"

#: libdialogpages/diffpage.cpp:262
msgid ""
"The number of context lines is normally 2 or 3. This makes the diff readable "
"and applicable in most cases. More than 3 lines will only bloat the diff "
"unnecessarily."
msgstr ""
"रेखा प्रसङ्गको सङ्ख्या सामन्यतया २ वा ३ हुन्छ । यसले धेरै जसो केसहरूमा फरक रूपमा पढ्ने र लागू "
"गर्ने बनाउँदछ । ३ भन्दा बढी रेखाहरूले अनावश्यक रूपमा फरक तरीकाले फुलाउँनेछ ।"

#: libdialogpages/diffpage.cpp:268
msgid "&Format"
msgstr "ढाँचा"

#: libdialogpages/diffpage.cpp:281
msgid "General"
msgstr "सामन्य"

#: libdialogpages/diffpage.cpp:284
msgid "&Look for smaller changes"
msgstr "साना परिवर्तनहरूका लागि हेर्नुहोस्"

#: libdialogpages/diffpage.cpp:285
msgid "This corresponds to the -d diff option."
msgstr "यसले -d diff विकल्पलाई देखाउँछ ।"

#: libdialogpages/diffpage.cpp:286
msgid "O&ptimize for large files"
msgstr "ठूला फाइलहरूका लागि अधिक्तम गर्नुहोस्"

#: libdialogpages/diffpage.cpp:287
msgid "This corresponds to the -H diff option."
msgstr "यसले -H diff विकल्पलाई देखाउँछ ।"

#: libdialogpages/diffpage.cpp:288
msgid "&Ignore changes in case"
msgstr "यी केसमा परिवर्तनहरू उपेक्षा गर्नुहोस्"

#: libdialogpages/diffpage.cpp:289
msgid "This corresponds to the -i diff option."
msgstr "यसले -i diff विकल्पलाई देखाउँछ ।"

#: libdialogpages/diffpage.cpp:296
msgid "Ignore regexp:"
msgstr "regexp उपेक्षा गर्नुहोस्:"

#: libdialogpages/diffpage.cpp:297
msgid "This option corresponds to the -I diff option."
msgstr "यो विकल्पले -I diff विकल्पलाई देखाउँछ ।"

#: libdialogpages/diffpage.cpp:301
msgid ""
"Add the regular expression here that you want to use\n"
"to ignore lines that match it."
msgstr ""
"यहाँ तपाईँले नियमित अभिव्यक्ति थप्नुहोस् जुन तपाईँले यससँग मिल्ने\n"
"रेखाहरू उपेक्षा गर्न प्रयोग गर्न चाहनुहुन्छ ।"

#: libdialogpages/diffpage.cpp:307
msgid "&Edit..."
msgstr "सम्पादन गर्नुहोस्..."

#: libdialogpages/diffpage.cpp:308
msgid ""
"Clicking this will open a regular expression dialog where\n"
"you can graphically create regular expressions."
msgstr ""
"यो क्लिक गर्नाले नियमित अभिव्यक्ति संवाद खोल्नेछ जहाँ\n"
"तपाईँ ग्राफिकल रूपमा नियमित अभिव्यक्तिहरू सिर्जना गर्न सक्नुहुन्छ ।"

#: libdialogpages/diffpage.cpp:315
msgid "Whitespace"
msgstr "सेतो खाली स्थान"

#: libdialogpages/diffpage.cpp:318
msgid "E&xpand tabs to spaces in output"
msgstr "निर्गात भित्र खाली स्थानहरूमा ट्याबहरू विस्तार गर्नुहोस्"

#: libdialogpages/diffpage.cpp:319
msgid "This option corresponds to the -t diff option."
msgstr "यो विकल्पले -t diff विकल्पलाई देखाउँछ ।"

#: libdialogpages/diffpage.cpp:320
msgid "I&gnore added or removed empty lines"
msgstr "थपिएका वा हटाइएका खाली रेखाहरू उपेक्षा गर्नुहोस्"

#: libdialogpages/diffpage.cpp:321
msgid "This option corresponds to the -B diff option."
msgstr "यो विकल्पले -B diff विकल्पलाई देखाउँछ ।"

#: libdialogpages/diffpage.cpp:322
msgid "Ig&nore changes in the amount of whitespace"
msgstr "सेतो स्थानको मात्रामा परिवर्तनहरू उपेक्षा गर्नुहोस्"

#: libdialogpages/diffpage.cpp:323
msgid "This option corresponds to the -b diff option."
msgstr "यो विकल्पले -b diff विकल्पलाई देखाउँछ ।"

#: libdialogpages/diffpage.cpp:324
msgid "Ign&ore all whitespace"
msgstr "सबै खाली स्थान उपेक्षा गर्नुहोस्"

#: libdialogpages/diffpage.cpp:325
msgid "This option corresponds to the -w diff option."
msgstr "यो विकल्पले -w diff विकल्पलाई देखाउँछ ।"

#: libdialogpages/diffpage.cpp:326
msgid "Igno&re changes due to tab expansion"
msgstr "ट्याब विस्तारको कारणले परिवर्तनहरू उपेक्षा गर्नुहोस्"

#: libdialogpages/diffpage.cpp:327
msgid "This option corresponds to the -E diff option."
msgstr "यो विकल्पले -E diff विकल्पलाई देखाउँछ ।"

#: libdialogpages/diffpage.cpp:332
msgid "O&ptions"
msgstr "विकल्प"

#: libdialogpages/diffpage.cpp:343
msgid "File Pattern to Exclude"
msgstr "हटाउनुपर्ने फाइल बाँन्की"

#: libdialogpages/diffpage.cpp:345
msgid ""
"If this is checked you can enter a shell pattern in the text box on the "
"right or select entries from the list."
msgstr ""
"यदि यो जाँच गरियो भने तपाईँले दायाँपट्टि पाठ बाकसमा शेल बाँन्की प्रविष्ट गर्न सक्नुहुन्छ वा "
"सूचीबाट प्रविष्टिहरू चयन गर्नुहोस् ।"

#: libdialogpages/diffpage.cpp:347
msgid ""
"Here you can enter or remove a shell pattern or select one or more entries "
"from the list."
msgstr ""
"यहाँ तपाईँ शेल बाँन्की प्रविष्ट गर्न वा हटाउन सक्नुहुन्छ वा सूचीबाट एउटा वा धेरै प्रविष्टिहरू "
"चयन गर्नुहोस् ।"

#: libdialogpages/diffpage.cpp:354
msgid "File with Filenames to Exclude"
msgstr "हटाउनुपर्ने फाइलनामसँग फाइल"

#: libdialogpages/diffpage.cpp:356
msgid ""
"If this is checked you can enter a filename in the combo box on the right."
msgstr ""
"यदि यो जाँच गरियो भने तपाईँ दायाँपट्टि कम्बो बाकसमा फाइलनाम प्रविष्ट गर्न सक्नुहुन्छ ।"

#: libdialogpages/diffpage.cpp:359
msgid ""
"Here you can enter the URL of a file with shell patterns to ignore during "
"the comparison of the folders."
msgstr ""
"फोल्डरहरूको तुलना गर्दा उपेक्षा गर्न यहाँ तपाईँ शेल बाँन्कीसँग फाइलको यूआरएल प्रविष्ट गर्न "
"सक्नुहुन्छ ।"

#: libdialogpages/diffpage.cpp:362
msgid ""
"Any file you select in the dialog that pops up when you click it will be put "
"in the dialog to the left of this button."
msgstr ""
"क्लिक गर्दा पपअप हुने संवादमा तपाईँले चयन गर्नु भएको कुनै फाइललाई यो बटनको बायाँपट्टि "
"संवादमा राखिनेछ ।"

#: libdialogpages/diffpage.cpp:370
msgid "&Exclude"
msgstr "हटाउनुहोस्"

