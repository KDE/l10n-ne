msgid "The server is temporarily unavailable."
msgstr "सर्भर अस्थायी रूपमा अनुपलब्ध छ ।"

#: dict.cpp:1480
#, fuzzy
msgid ""
"The server reported a syntax error.\n"
"This should not happen -- please consider\n"
"writing a bug report."
msgstr ""
"सर्भरले वाक्य संरचना त्रुटि प्रतिवेदन गर्यो ।\n"
"यो हुनुहुँदैन -- कृपया\n"
"बग प्रतिवेदन लेख्ने विचार गर्नुहोस् ।"

#: dict.cpp:1483
#, fuzzy
msgid ""
