msgid "Access to the system requires a password."
msgstr "प्रणालीमा पहुँच गर्न पासवर्ड आवश्यक पर्दछ ।"

#: vnc/kvncview.cpp:467
msgid "Remote host is using an incompatible protocol."
msgstr "टाढाको होस्टले एउटा नमिल्दो प्रोटोकल प्रयोग गरिरहेको छ ।"

#: vnc/kvncview.cpp:472
msgid "The connection to the host has been interrupted."
msgstr "होस्टमा जडान अवरोध भयो ।"

#: vnc/kvncview.cpp:477
msgid "Connection failed. The server does not accept new connections."
msgstr "जडान असफल भयो । सर्भरले नयाँ जडान स्वीकार गर्दैन ।"

#: vnc/kvncview.cpp:482
msgid "Connection failed. A server with the given name cannot be found."
msgstr "जडान असफल भयो । दिएको नामसँग सर्भर फेला परेन ।"

#: vnc/kvncview.cpp:487
msgid "Connection failed. No server running at the given address and port."
msgstr "जडान असफल भयो । दिएको ठेगाना र पोर्टमा कुनै पनि सर्भर चलिरहेको छैन ।"

#: vnc/kvncview.cpp:496
msgid "Authentication failed. Connection aborted."
msgstr "प्रमाणीकरण असफल भयो । जडान परित्याग गरियो ।"

#: vnc/kvncview.cpp:497
msgid "Authentication Failure"
msgstr "प्रमाणीकरण असफलता"

#: vnc/kvncview.cpp:501
msgid "Unknown error."
msgstr "अज्ञात त्रुटि"

#: vnc/kvncview.cpp:502
msgid "Unknown Error"
msgstr "अज्ञात त्रुटि"

