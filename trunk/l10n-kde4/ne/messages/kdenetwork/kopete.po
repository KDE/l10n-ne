#: libkopete/kopetecommandhandler.cpp:111
msgid ""
"USAGE: /help [<command>] - Used to list available commands, or show help for "
"a specified command."
msgstr ""
"उपयोग: /help [<command>] - सूची उपलब्ध आदेश सूचीकृत गर्न वा निर्दिष्ट गरेको आदेशका "
"लागि मद्दत देखाउन प्रयोग गरिन्छ ।"

#: libkopete/kopetecommandhandler.cpp:114
msgid "USAGE: /close - Closes the current view."
msgstr "उपयोग: /close - हालको दृश्य बन्द गर्दछ ।"

#: libkopete/kopetecommandhandler.cpp:118
msgid "USAGE: /part - Closes the current view."
msgstr "उपयोग: /part - हालको दृश्य बन्द गर्दछ ।"

#: libkopete/kopetecommandhandler.cpp:121
msgid "USAGE: /clear - Clears the active view's chat buffer."
msgstr "उपयोग: /clear - सक्रिय दृश्यको कुराकानी बफर खाली गर्दछ ।"

#: libkopete/kopetecommandhandler.cpp:127
msgid ""
"USAGE: /away [<reason>] - Marks you as away/back for the current account "
"only."
msgstr ""
"उपयोग: /away [<reason>] - हालको खातालाई मात्र तपाईँलाई टाढा गएको/फर्केको रूपमा "
"चिन्ह लगाउछ ।"

#: libkopete/kopetecommandhandler.cpp:130
msgid "USAGE: /awayall [<reason>] - Marks you as away/back for all accounts."
msgstr ""
"उपयोग: /awayall [<reason>] - सबै खाताका लागि तपाईँलाई टाढा गएको/फर्केको रूपमा "
"चिन्ह लगाउछ ।"

#: libkopete/kopetecommandhandler.cpp:133
msgid ""
"USAGE: /say <text> - Say text in this chat. This is the same as just typing "
"a message, but is very useful for scripts."
msgstr ""
"उपयोग: /say <text> - यो कुराकानीमा पाठ भन्नुहोस् । यो सन्देश टाइप गरे जस्तै हो, तर "
"स्क्रिप्टका लागि यो धेरै उपयोगी हुन्छ ।"

#: libkopete/kopetecommandhandler.cpp:137
msgid ""
"USAGE: /exec [-o] <command> - Executes the specified command and displays "
"the output in the chat buffer. If -o is specified, the output is sent to all "
"members of the chat."
msgstr ""
"उपयोग: /exec [-o] <command> - निर्दिष्ट गरेको आदेश कार्यान्वयन गर्दछ र कुराकानी "
"बफरमा प्रतिफल प्रदर्शन गर्दछ । यदि -o निर्दिष्ट गरिएको छ भने, प्रतिफल कुराकानीको सबै "
"सदस्यमा पठाइन्छ ।"

