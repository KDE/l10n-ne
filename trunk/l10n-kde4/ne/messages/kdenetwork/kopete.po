msgstr "यो तपाईँले यो उपनाम कार्यान्वयन गर्दा तपाईँले चलाउन चाहनुभएको आदेश हो ।"

#. i18n: file: plugins/alias/aliasdialog.ui:54
#. i18n: ectx: property (whatsThis), widget (KLineEdit, command)
#: rc.cpp:1407
#, no-c-format
msgid ""
"<qt>This is the command that you want to run when you execute this alias.\n"
"\n"
"You can use the variables <b>%1, %2 ... %9</b> in your command, and they "
"will be replaced with the arguments of the alias. The variable <b>%s</b> "
"will be replaced with all arguments. <b>%n</b> expands to your nickname.\n"
"\n"
"Do not include the '/' in the command (if you do it will be stripped off "
"anyway).</qt>"
msgstr ""
"<qt>यो तपाईँले यो उपनाम कार्यान्वयन गर्दा तपाईँले चलाउन चाहनुभएको आदेश हो ।\n"
"\n"
"तपाईँ तपाईँको आदेशमा <b>%1, %2 ... %9</b> चलहरू प्रयोग गर्न सक्नुहुन्छ, र तिनीहरू "
"उपनामको तर्कसँग प्रतिस्थापन हुनेछन् । चल <b>%s</b> सबै तर्कसँग प्रतिस्थापन हुनेछ । <b>%n</"
"b> ले तपाईँको उपनाममा विस्तार गर्दछ ।\n"
"\n"
"आदेशमा '/' समावेश नगर्नुहोस् (यदि तपाईँले गर्नुभयो भने यो जसरी पनि बाहिरिनेछ) ।</qt>"

