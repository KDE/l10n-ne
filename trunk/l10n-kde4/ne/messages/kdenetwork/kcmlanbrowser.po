#: setupwizard.cpp:223
#, fuzzy
#| msgid ""
#| "<br>There are four ways to specify address ranges:<br>1. IP address/"
#| "network mask, like <code>192.168.0.0/255.255.255.0;</code><br>2. single "
#| "IP addresses, like <code>10.0.0.23;</code><br>3. continuous ranges, like "
