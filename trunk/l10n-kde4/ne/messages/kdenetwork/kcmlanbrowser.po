msgstr "होस्टबाट ICMP प्रतिध्वनि अनुरोधमा जवाफका लागि प्रतिक्षा गर्ने समय"

#: kcmlisa.cpp:165 kcmlisa.cpp:173 setupwizard.cpp:334 setupwizard.cpp:356
msgid " ms"
msgstr " मिलि सकेन्ड"

#: kcmlisa.cpp:168
