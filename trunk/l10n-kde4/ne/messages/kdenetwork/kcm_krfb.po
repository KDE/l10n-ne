#: kcm_krfb.cpp:176
msgid ""
"<h1>Desktop Sharing</h1> This module allows you to configure the KDE desktop "
"sharing."
msgstr ""
"<h1>डेस्कटप साझेदारी</h1> यो मोड्युलले तपाईँलाई केडीई डेस्कटप साझेदारी कन्फिगर गर्न अनुमति "
"दिन्छ ।"

#~ msgid "Acc&ess"
#~ msgstr "पहुँच"

#~ msgid "Invitations"
#~ msgstr "निमन्त्रणा"

#~ msgid "You have no open invitations."
#~ msgstr "तपाईँसँग खुल्ला निमन्त्रणा छैन ।"

#~ msgid "Create && &Manage Invitations..."
#~ msgstr "निमन्त्रणा सिर्जना र प्रबन्ध गर्नुहोस्..."

#~ msgid "Click to view or delete the open invitations."
#~ msgstr "खुल्ला निमन्त्रणा हेर्न वा मेट्न क्लिक गर्नुहोस् ।"

#~ msgid "Uninvited Connections"
#~ msgstr "निमन्त्रणा नगरिएको जडान"

#~ msgid "Allow &uninvited connections"
#~ msgstr "निमन्त्रणा नगरिएको जडान अनुमति दिनुहोस्"

#~ msgid ""
#~ "Select this option to allow connecting without inviting. This is useful "
#~ "if you want to access your desktop remotely."
#~ msgstr ""
#~ "निमन्त्रणा बिना जडान अनुमति दिन यो विकल्प चयन गर्नुहोस् । यदि तपाईँले तपाईँको डेस्कटप "
#~ "टाढैबाट पहुँच गर्न चाहनुभयो भने यो उपयोगी हुन्छ ।"

#~ msgid "Announce service &on the network"
#~ msgstr "सञ्जालमा सेवा घोषणा गर्नुहोस्"

#~ msgid ""
#~ "If you allow uninvited connections and enable this option, Desktop "
#~ "Sharing will announce the service and your identity on the local network, "
#~ "so people can find you and your computer."
#~ msgstr ""
#~ "यदि तपाईँले निमन्त्रणा नगरिएको जडान अनुमति दिनुभयो र यो विकल्प सक्षम पार्नुभयो भने, "
#~ "डेस्कटप साझेदारीले स्थानीय सञ्जालमा सेवा र तपाईँको परिचय जानकारी गराउँनेछ, जसले गर्दा "
#~ "मानिसले तपाईँ र तपाईँको कम्प्युटरलाई फेला पार्न सक्छन् ।"

#~ msgid "Confirm uninvited connections &before accepting"
#~ msgstr "स्वीकार गर्नु अघि निमन्त्रणा नगरिएको जडान यकीन गर्नुहोस्"

#~ msgid ""
#~ "If enabled, a dialog will appear when somebody attempts to connect, "
#~ "asking you whether you want to accept the connection."
#~ msgstr ""
#~ "यदि सक्षम पारियो भने, यदि कसैले जडान गर्ने प्रयास गर्यो भने संवाद देखिनेछ, तपाईँलाई "
#~ "जडान स्वीकार गर्नुहुन्छ कि हुन्न भनेर सोध्नेछ ।"

#~ msgid "A&llow uninvited connections to control the desktop"
#~ msgstr "डेस्कटप नियन्त्रण गर्न निमन्त्रणा नगरिएको जडान अनुमति दिनुहोस्"

#~ msgid ""
#~ "Enable this option to allow uninvited user to control your desktop (using "
#~ "mouse and keyboard)."
#~ msgstr ""
#~ "(माउस र कुञ्जीपाटी प्रयोग गरेर) तपाईँको डेस्कटप नियन्त्रण गर्न निमन्त्रणा नगरिएको "
#~ "प्रयोगकर्ता अनुमति दिन यो विकल्प सक्षम पार्नुहोस् ।"

#~ msgid "Pass&word:"
#~ msgstr "पासवर्ड:"

#~ msgid ""
#~ "If you allow uninvited connections, it is highly recommended to set a "
#~ "password in order to protect your computer from unauthorized access."
#~ msgstr ""
#~ "यदि तपाईँले निमन्त्रणा नगरिएको जडानलाई अनुमति दिनुभयो भने, आधिकीकरण प्राप्त नभएको "
#~ "पहुँचबाट तपाईँको कम्प्युटर सुरक्षित राख्न पासवर्ड सेट गर्न जोरदार सिफारिस गरिन्छ ।"

#~ msgid "&Session"
#~ msgstr "सत्र"

#~ msgid "Session Preferences"
#~ msgstr "सत्र प्राथमिकता"

#~ msgid "Always disable &background image"
#~ msgstr "सधै पृष्ठभूमि छवि अक्षम पार्नुहोस्"

#~ msgid ""
#~ "Check this option to always disable the background image during a remote "
#~ "session. Otherwise the client decides whether the background will be "
#~ "enabled or disabled."
#~ msgstr ""
#~ "टाढाको सत्र हुँदा पृष्ठभूमि छवि सधै अक्षम पार्न यो विकल्प चिनो गर्नुहोस् । अन्यथा "
#~ "क्लाइन्टले पृष्ठभूमि सक्षम पार्ने कि अक्षम पार्ने भन्ने निर्णय गर्दछ ।"

#~ msgid "&Network"
#~ msgstr "सञ्जाल"

#~ msgid "Network Port"
#~ msgstr "सञ्जाल पोर्ट"

#~ msgid "Assi&gn port automatically"
#~ msgstr "स्वचालित रूपमा पोर्ट मानाङ्कन गर्नुहोस्"

#~ msgid ""
#~ "Check this option to assign the network port automatically. This is "
#~ "recommended unless your network setup requires you to use a fixed port, "
#~ "for example because of a firewall."
#~ msgstr ""
#~ "सञ्जाल पोर्ट स्वचालित रूपमा मानाङ्कन गर्न यो विकल्प चिनो गर्नुहोस् । तपाईँको सञ्जाल "
#~ "सेटअपले स्थिर पोर्ट प्रयोग गर्न आवश्यक ठाने पनि यो सिफारिस गरिएको छ, उदाहरणका "
#~ "लागि फायरवालको कारण ।"

#~ msgid "P&ort:"
#~ msgstr "पोर्ट:"

#~ msgid "Enter the TCP port number here"
#~ msgstr "यहाँ टीसीपी पोर्ट नम्बर प्रविष्ट गर्नुहोस्"

#~ msgid ""
#~ "Use this field to set a static port number for the desktop sharing "
#~ "service. Note that if the port is already in use the Desktop Sharing "
#~ "service will not be accessible until you free it. It is recommended to "
#~ "assign the port automatically unless you know what you are doing.\n"
#~ "Most VNC clients use a display number instead of the actual port. This "
#~ "display number is the offset to port 5900, so port 5901 has the display "
#~ "number 1."
#~ msgstr ""
#~ "डेस्कटप साझेदार सेवाका लागि स्थिर पोर्ट नम्बर सेट गर्न यो फाँट प्रयोग गर्नुहोस् । याद "
#~ "गर्नुहोस् कि यदि पोर्ट पहिले नै डेस्कटप साझेदारी सेवामा प्रयोग गरिएको छ भने त्यसलाई "
#~ "नहटाएसम्म पहुँचयोग्य हुने छैन । तपाईँलाई आफु के गरिरहेको छ भन्ने थाहा नभए स्वचालित रूपमा "
#~ "पोर्ट मानाङ्कन गर्न सिफारिस गरिन्छ ।\n"
#~ "धेरैजसो भीएनसी क्लाइन्टले वास्तविक पोर्टको सट्टा प्रदर्शन नम्बर प्रयोग गर्दछ । यो "
#~ "प्रदर्शन सङ्ख्या पोर्ट ५९०० सम्म अफसेट गरिएको छ, त्यसैले पोर्ट ५९०१ सँग प्रदर्शन सङ्ख्या "
#~ "१ छ ।"
