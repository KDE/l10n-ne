#. i18n: tag string
#. i18n: file ./advanced/kcm_sambaconf/kcminterface.ui line 73
#: rc.cpp:827
msgid ""
"<qt>\n"
"Here you can edit the Samba users, stored in the smbpasswd file.\n"
"<p>\n"
"Every Samba user must have a corresponding UNIX user.\n"
"On the right you can see all UNIX users, stored in the passwd file and not "
"configured as Samba users.\n"
"You can see the Samba users on the left-hand side.\n"
"<p>\n"
"To add new Samba users simply press the <em>&lt; add</em> button.\n"
"The selected UNIX users will then become Samba users and will be\n"
"removed from the UNIX users list (but they will remain UNIX users).\n"
"<p>\n"
"To remove Samba users click the <em>&gt; remove</em> button.\n"
"The selected Samba users will be removed from the smbpasswd file\n"
"and reappear on the right-hand side, as UNIX users which are not Samba "
"users.\n"
"</qt>"
msgstr ""
"<qt>\n"
"smbpasswd फाइलमा भण्डारण गरिएको साम्बा प्रयोगकर्ताहरू तपाईँले यहाँ सम्पादन गर्न सक्नुहुन्छ "
"।\n"
"<p>\n"
"हरेक साम्बा प्रयोगकर्तासँग सम्बन्धित युनिक्स प्रयोगकर्ता हुनुपर्छ ।\n"
"दायाँपट्टि तपाईँ सबै युनिक्स प्रयोगकर्ता देख्न सक्नुहुन्छ, जुन passwd फाइलमा भण्डारण गरिएको "
"छ र साम्बा प्रयोगकर्ताको रूपमा कन्फिगर गरिएको छैन ।\n"
"तपाईँ साम्बा प्रयोगकर्ता बायाँपट्टि देख्न सक्नुहुन्छ ।\n"
"<p>\n"
"नयाँ साम्बा प्रयोगकर्ता थप्न साधारणतया<em>&lt; थप्नुहोस्</em> बटन थिच्नुहोस् ।\n"
"चयन गरिएको युनिक्स प्रयोगकर्ता त्यसपछि साम्बा प्रयोगकर्ता हुनेछ \n"
"र युनिक्स प्रयोगकर्ता सूचीबाट हटाइनेछ (तर तिनीहरू युनिक्स प्रयोगकर्ताको रूपमा रहनेछ) ।\n"
"<p>\n"
"साम्बा प्रयोगकर्ता हटाउन <em>&gt; हटाउनुहोस्</em> बटन क्लिक गर्नुहोस् ।\n"
"चयन गरिएको साम्बा प्रयोगकर्ता smbpasswd फाइलबाट\n"
"हट्नेछ र युनिक्स प्रयोगकर्ताको रूपमा दायाँपट्टि पुन: देखापर्नेछ, जुन साम्बा प्रयोगकर्ता होइन "
"।\n"
"</qt>"

