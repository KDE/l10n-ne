#: kviewpart.cpp:914
msgid "<qt>The specified service provides no shared library.</qt>"
msgstr "<qt>निर्दिष्ट सेवाले कुनै साझा नभएका लाइब्रेरी उपलब्ध गर्छ ।</qt>"

#: kviewpart.cpp:917
#, qt-format
msgid ""
"<qt><p>The specified library <b>%1</b> could not be loaded. The error "
"message returned was:</p> <p><b>%2</b></p></qt>"
msgstr ""
"<qt><p>निर्दिष्ट लाइब्रेरी <b>%1</b> लोड गर्न सकिने छैन । फर्किएको त्रुटि सन्देश:</p> "
"<p><b>%2</b></p></qt> थियो"

#: kviewpart.cpp:920
msgid "<qt>The library does not export a factory for creating components.</qt>"
msgstr "<qt>लाइब्रेरीले अवयव सिर्जना गर्नका लागि फ्याक्ट्री निर्यात गर्दैन ।</qt>"

#: kviewpart.cpp:923
msgid ""
"<qt>The factory does not support creating components of the specified type.</"
"qt>"
msgstr "<qt>फ्याक्ट्रीले निर्दिष्ट प्रकारको अवयव सिर्जना गर्न समर्थन गर्दैन ।</qt>"

#: kviewpart.cpp:927
#, qt-format
msgid ""
"<qt><p><b>Problem:</b> The document <b>%1</b> cannot be shown.</"
"p><p><b>Reason:</b> The software component <b>%2</b> which is required to "
"display files of type <b>%3</b> could not be initialized. This could point "
"to serious misconfiguration of your KDE system, or to damaged program files."
"</p><p><b>What you can do:</b> You could try to re-install the software "
"packages in question. If that does not help, you could file an error report, "
"either to the provider of your software (e.g. the vendor of your Linux "
"distribution), or directly to the authors of the software. The entry "
"<b>Report Bug...</b> in the <b>Help</b> menu helps you to contact the KDE "
"programmers.</p></qt>"
msgstr ""
"<qt><p><b>समस्या:</b> कागजात <b>%1</b> देखाउन सकिदैन ।</p><p><b>कारण: <b>%3</b> "
"प्रकारको फाइल प्रदर्शन गर्न आवश्यक पर्ने </b> सफ्टवेयर अवयव <b>%2</b> सुरुआत गर्न सकिने "
"छैन । यसले तपाईँको केडीई प्रणालीको विचारधीन मिसकन्फिगरेसनमा, वा नष्ट भएको कार्यक्रम "
"फाइलमा सूचित गर्न सक्छ ।</p><p><b>तपाईँ के गर्न सक्नुहुन्छ:</b> तपाईँ प्रश्नमा सफ्टवेयर "
"प्याकेजहरू पुन-स्थापना गर्ने प्रयास गर्न सक्नुहुन्छ । यदि त्यसले मद्दत गर्देन भने, तपाईँले, या त "
"तपाईँक सफ्टवेयरको उपलब्धकर्तालाई (जस्तै तपाईँको लिनक्स वितरणको विक्रेता), वा सिधै "
"सफ्टवेयरको लेखकलाई, एउटा त्रुटि प्रतिवेदन फाइल गर्न सक्नुहुन्छ । प्रविष्टि <b>प्रतिवेदन बग..."
"</b> मद्दत <b>मेनु</b> ले तपाईँलाई केडीई प्रोग्रामरहरूसँग सम्पर्क राख्न मद्दत गर्दछ ।</p></"
"qt>"

