#: img_saver.cpp:71
msgid "Kooka Save Assistant"
msgstr "कोका बचत सहयोगि"

#: img_saver.cpp:91
msgid ""
"<B>Save Assistant</B><P>Select an image format to save the scanned image."
msgstr ""
"<B>सहायक बचत गर्नुहोस्</B><P>स्क्यान गरिएको छवि बचत गर्न एउटा छवि ढाँचा चयन गर्नुहोस् ।"

#: img_saver.cpp:109
msgid "Available image formats:"
msgstr "उपलब्ध छवि ढाँचा:"

#: img_saver.cpp:131
msgid "-No format selected-"
msgstr "कुनै ढाँचा चयन गरिएको छैन"

#: img_saver.cpp:138
msgid "Select the image sub-format"
msgstr "छवि उप-ढाँचा चयन गर्नुहोस्"

#: img_saver.cpp:143
#, fuzzy
msgid "Do not ask again for the save format if it is defined."
msgstr "ढाँचा परिभाषित भएमा बचतका लागि फेरी नसोध्नुहोस् ।"

#: img_saver.cpp:177
msgid "-no hint available-"
msgstr "कुनै सङ्केत उपलब्ध छैन"

#: img_saver.cpp:291
#, qt-format
msgid ""
"The folder\n"
"%1\n"
" does not exist and could not be created;\n"
"please check the permissions."
msgstr ""
"फोल्डर\n"
"%1\n"
" अवस्थित छैन र सिर्जना गर्न सकेने छैन;\n"
"कृपया अनुमति जाँच गर्नुहोस् ।"

#: img_saver.cpp:298
#, qt-format
msgid ""
"The directory\n"
"%1\n"
" is not writeable;\n"
"please check the permissions."
msgstr ""
"डाइरेक्टरी\n"
"%1\n"
"लेखनयोग्य छैन;\n"
"कृपया अनुमति जाँच गर्नुहोस् ।"

#: img_saver.cpp:357
msgid "Filename"
msgstr "फाइलनाम"

#: img_saver.cpp:357
msgid "Enter filename:"
msgstr "फाइलनाम प्रविष्ट गर्नुहोस्:"

#: img_saver.cpp:501
msgid "palleted color image (16 or 24 bit depth)"
msgstr "रङदानीमा राखिएको रङ्गीन छवि (१६ वा २४ बिट गहिराइ)"

#: img_saver.cpp:504
msgid "palleted gray scale image (16 bit depth)"
msgstr "रङदानीमा राखिएको ग्रेस्केल छवि (१६ बिट गहिराइ)"

#: img_saver.cpp:507
msgid "lineart image (black and white, 1 bit depth)"
msgstr "रेखाचित्र छवि (श्यामश्वेत, १ बिट गहिराइ)"

#: img_saver.cpp:510
msgid "high (or true-) color image, not palleted"
msgstr "उच्च (वा सही) रङ छवि, रङदानीमा राखिएको छैन"

#: img_saver.cpp:513
msgid "Unknown image type"
msgstr "अज्ञात छवि प्रकार"

#: img_saver.cpp:724
msgid " image save OK      "
msgstr " छवि बचत ठीक छ      "

#: img_saver.cpp:725
msgid " permission error   "
msgstr " अनुमति त्रुटि   "

#: img_saver.cpp:726
msgid " bad filename       "
msgstr " गलत फाइलनाम       "

#: img_saver.cpp:727
msgid " no space on device "
msgstr " यन्त्रमा खालीस्थान छैन "

#: img_saver.cpp:728
msgid " could not write image format "
msgstr " छवि ढाँचा लेख्न सकेन "

#: img_saver.cpp:729
msgid " can not write file using that protocol "
msgstr " त्यो प्रोटोकल प्रयोग गरेर फाइल लेख्न सकिँदैन "

#: img_saver.cpp:730
msgid " user canceled saving "
msgstr " प्रयोगकर्ताले बचत रद्द गर्यो "

#: img_saver.cpp:731
msgid " unknown error      "
msgstr " अज्ञात त्रुटि      "

#: img_saver.cpp:732
msgid " parameter wrong    "
msgstr " परिमिति गल्ति    "

#: img_saver.cpp:781 img_saver.cpp:877
msgid ""
"The filename you supplied has no file extension.\n"
"Should the correct one be added automatically? "
msgstr ""
"तपाईँले पूर्ति गर्नु भएको फाइलनामसँग फाइल विस्तार छैन ।\n"
"सही एउटा स्वचालित रूपमा थप्न सकिन्छ ? "

#: img_saver.cpp:782 img_saver.cpp:878
#, qt-format
msgid "That would result in the new filename: %1"
msgstr "त्यसले नयाँ फाइलनाममा असर गर्नेछ: %1"

#: img_saver.cpp:784 img_saver.cpp:880
msgid "Extension Missing"
msgstr "विस्तार हराइरहेको छ"

#: img_saver.cpp:785 img_saver.cpp:881
msgid "Add Extension"
msgstr "विस्तार थप्नुहोस्"

#: img_saver.cpp:785 img_saver.cpp:881
msgid "Do Not Add"
msgstr "नथप्नुहोस्"

#: img_saver.cpp:802 img_saver.cpp:895
msgid "Format changes of images are currently not supported."
msgstr "छविको ढाँचा परिवर्तनहरू हालै समर्थन गरिएका छैनन् ।"

#: img_saver.cpp:803 img_saver.cpp:896
msgid "Wrong Extension Found"
msgstr "गलत विस्तार फेला पर्यो"

#: imgprintdialog.cpp:59
msgid "Image Printing"
msgstr "छवि मुद्रण"

#: imgprintdialog.cpp:64 imgprintdialog.cpp:117
msgid "Image Print Size"
msgstr "छवि मुद्रण साइज"

#: imgprintdialog.cpp:68
msgid "Scale to same size as on screen"
msgstr "पर्दामा जस्तै एउटै साइजमा मापन गर्नुहोस्"

#: imgprintdialog.cpp:70
msgid "Screen scaling. That prints according to the screen resolution."
msgstr "पर्दा मापन । त्यसले पर्दा रिजोल्युसनको आधारमा मुद्रण गर्दछ ।"

#: imgprintdialog.cpp:74
msgid "Original size (calculate from scan resolution)"
msgstr "मौलिक साइज (स्क्यान रिजोल्युसनबाट गणना गर्नुहोस्)"

#: imgprintdialog.cpp:77
msgid ""
"Calculates the print size from the scan resolution. Enter the scan "
"resolution in the dialog field below."
msgstr ""
"स्क्यान रिजोल्युसनबाट मुद्रण साइज गणना गर्दछ । तलको संवाद फिल्डमा स्क्यान रिजोल्युसन "
"प्रविष्ट गर्नुहोस् ।"

#: imgprintdialog.cpp:81
msgid "Scale image to custom dimension"
msgstr "आयाम अनुकूलन गर्न छवि मापन गर्नुहोस्"

#: imgprintdialog.cpp:83
msgid ""
"Set the print size yourself in the dialog below. The image is centered on "
"the paper."
msgstr "तलको संवादमा आफैले मुद्रण साइज सेट गर्नुहोस् । छवि कागजमा केन्द्रिकृत गरिएको छ ।"

#: imgprintdialog.cpp:87
msgid "Scale image to fit to page"
msgstr "पृष्ठमा मिलाउन छवि मापन गर्नुहोस्"

#: imgprintdialog.cpp:88
msgid ""
"Printout uses maximum space on the selected pager. Aspect ratio is "
"maintained."
msgstr ""
"चयन गरिएको पेजरमा मुद्रणले अधिकतम खाली स्थान प्रयोग गर्छ । आकृति अनुपात राखिएको छ ।"

#: imgprintdialog.cpp:98
msgid "Resolutions"
msgstr "रिजोल्युसन"

#: imgprintdialog.cpp:102
msgid "Generate low resolution PostScript (fast draft print)"
msgstr "न्युन रिजोल्युसन पोस्टस्क्रिप्ट सिर्जना गर्नुहोस् (द्रुत ड्राफ्ट मुद्रण)"

#: imgprintdialog.cpp:109
msgid "Scan resolution (dpi) "
msgstr "(डीपीआई) रिजोल्युसन स्क्यान गर्नुहोस् "

#: imgprintdialog.cpp:111
msgid " dpi"
msgstr " डीपीआई"

#: imgprintdialog.cpp:121
msgid "Image width:"
msgstr "छवि चौडाइ:"

#: imgprintdialog.cpp:122 imgprintdialog.cpp:126
msgid " mm"
msgstr " मिलिमिटर"

#: imgprintdialog.cpp:125
msgid "Image height:"
msgstr "छवि उचाइ:"

#: imgprintdialog.cpp:129
msgid "Maintain aspect ratio"
msgstr "आकृति अनुपात राख्नुहोस्"

#: imgprintdialog.cpp:174
#, qt-format
msgid "Screen resolution: %1 dpi"
msgstr "पर्दा रिजोल्युसन: %1 डीपीआई"

#: imgprintdialog.cpp:218
msgid "Please specify a scan resolution larger than 0"
msgstr "कृपया ० भन्दा ठूलो स्क्यान रिजोल्युसन निर्दिष्ट गर्नुहोस्"

#: imgprintdialog.cpp:223
msgid ""
"For custom printing, a valid size should be specified.\n"
"At least one dimension is zero."
msgstr ""
"अनुकूल मुद्रणका लागि, एउटा वैध साइज निर्दिष्ट गर्नुपर्नेछ ।\n"
"कम्तिमा एउटा आयाम शून्य हुन्छ ।"

