msgstr "ओसीआर सफ्टवेयर फेला परेन"

#: kocrgocr.cpp:118 kocrocrad.cpp:129
msgid "Not found"
msgstr "फेला परेन"

#: kocrgocr.cpp:122
msgid "Using GOCR binary: "
msgstr "जीओसीआर बाइनरीको प्रयोग: "

#: kocrgocr.cpp:133
msgid "&Gray level"
msgstr "खैरो स्तर"

#: kocrgocr.cpp:137
msgid ""
"The numeric value gray pixels are \n"
"considered to be black.\n"
"\n"
"Default is 160"
msgstr ""
"खैरो पिक्सेलको सङ्ख्यात्मक मान \n"
"कालो हुने ठानिने छन् ।\n"
"\n"
"पूर्वनिर्धारित १६० हो"

#: kocrgocr.cpp:139
msgid "&Dust size"
msgstr "डस्ट साइज"

#: kocrgocr.cpp:143
msgid ""
"Clusters smaller than this value\n"
"will be considered to be dust and \n"
"removed from the image.\n"
"\n"
"Default is 10"
msgstr ""
"यो मान भन्दा सानो समूह मानालाई\n"
"डस्टको रूपमा मानिने छन् र\n"
"छविबाट हटाइने छन् ।\n"
"\n"
"पूर्वानिर्धारित मान १० हो"

#: kocrgocr.cpp:145
msgid "&Space width"
msgstr "रिक्तस्थान चौडाइ"

#: kocrgocr.cpp:148
msgid ""
"Spacing between characters.\n"
"\n"
"Default is 0 what means autodetection"
msgstr ""
"क्यारेक्टरहरू बीचको रिक्तस्थान ।\n"
"\n"
"पूर्वानिर्धारित ० हुनुको अर्थ स्वत: पत्ता लगाउने हुन्छ"

