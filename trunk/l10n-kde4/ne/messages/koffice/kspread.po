#. i18n: file functions/math.xml line 1064
#: xml_doc.cpp:4564
msgid "Top value"
msgstr "माथिको मान"

#. i18n: tag Text
#. i18n: file functions/math.xml line 1068
#: xml_doc.cpp:4567
msgid ""
"The RANDBETWEEN() function returns a pseudo-random number between bottom and "
"top value. If bottom > top this function returns Err."
msgstr ""
"RANDBETWEEN() प्रकार्यले तल र माथी बीचको कृतिम अनियमित नम्बर मान फर्काउँछ । यदि तल "
"> माथि भएमा यो प्रकार्यले Err फर्काउँछ ।"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 1069
#: xml_doc.cpp:4570
msgid "RANDBETWEEN(bottom;top)"
msgstr "RANDBETWEEN(तल;माथि)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 1070
#: xml_doc.cpp:4573
msgid "RANDBETWEEN(12;78) equals for example 61.0811..."
msgstr "RANDBETWEEN(12;78) उदाहरण 61.0811... बराबर हुन्छ"

#. i18n: tag Comment
#. i18n: file functions/math.xml line 1082
#: xml_doc.cpp:4579
msgid "Multiple"
msgstr "बहुविध"

#. i18n: tag Text
#. i18n: file functions/math.xml line 1086
#: xml_doc.cpp:4582
msgid ""
"The MROUND() function returns the value rounded to the specified multiple. "
"The value and the multiple must have the same sign"
msgstr ""
"MROUND() प्राकार्यले निर्दिष्ट गरिएको गुणामा राउन्ड गरिएको मान फर्काउँछ ।मान र गुणाको "
"समान चिन्ह हुनुपर्छ"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 1087
#: xml_doc.cpp:4585
msgid "MROUND(value; multiple)"
msgstr "MROUND(मान; बहुविध)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 1088
#: xml_doc.cpp:4588
msgid "MROUND(1.252; 0.5) equals 1.5"
msgstr "MROUND(1.252; 0.5) बराबर 1.5"

#. i18n: tag Example
#. i18n: file functions/math.xml line 1089
#: xml_doc.cpp:4591
msgid "MROUND(-1.252; -0.5) equals -1.5"
msgstr "MROUND(-1.252; -0.5) बराबर -1.5"

#. i18n: tag Comment
#. i18n: file functions/math.xml line 1102
#. i18n: tag Comment
#. i18n: file functions/math.xml line 1127
#. i18n: tag Comment
#. i18n: file functions/math.xml line 1149
#: xml_doc.cpp:4597 xml_doc.cpp:4624 xml_doc.cpp:4645
msgid "Digits"
msgstr "अङ्क"

#. i18n: tag Text
#. i18n: file functions/math.xml line 1106
#: xml_doc.cpp:4600
msgid ""
"The ROUND(value;[digits]) function returns value rounded. Digits is the "
"number of digits to which you want to round that number. If digits is zero "
"or omitted, value is rounded up to the nearest integer. If digits is smaller "
"than zero, the corresponding integer part of the number is rounded."
msgstr ""
"ROUND(मान;[अङ्क]) घेरिएको मान फर्काउँछ । अङ्क तपाईँले त्यो नम्बरले राउन्ड गर्न चाहेको अङ्क "
"हो । यदि अङ्क शून्य वा छुटेको भएमा, सबै भन्दा नजिकको इन्टिजर माथि मान घेरिएको हुन्छ । "
"यदि अङ्क शून्य भन्दा कम भएमा, नम्बरको सङ्गति भाग घेरिएको हुन्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 1107
#: xml_doc.cpp:4603
msgid "ROUND(value;[digits])"
msgstr "ROUND(मान;[अङ्क])"

#. i18n: tag Example
#. i18n: file functions/math.xml line 1108
#: xml_doc.cpp:4606
msgid "ROUND(1.252;2) equals 1.25"
msgstr "ROUND(1.252;2) बराबर 1.25"

#. i18n: tag Example
#. i18n: file functions/math.xml line 1109
#: xml_doc.cpp:4609
msgid "ROUND(-1.252;2) equals -1.25"
msgstr "ROUND(-1.252;2) बराबर -1.25"

#. i18n: tag Example
#. i18n: file functions/math.xml line 1110
#: xml_doc.cpp:4612
msgid "ROUND(1.258;2) equals 1.26"
msgstr "ROUND(1.258;2) बराबर 1.26"

#. i18n: tag Example
#. i18n: file functions/math.xml line 1111
#: xml_doc.cpp:4615
msgid "ROUND(-12.25;-1) equals -10"
msgstr "ROUND(-12.25;-1) बराबर -10"

#. i18n: tag Example
#. i18n: file functions/math.xml line 1112
#: xml_doc.cpp:4618
msgid "ROUND(-1.252;0) equals -1"
msgstr "ROUND(-1.252;0) बराबर -1"

#. i18n: tag Text
#. i18n: file functions/math.xml line 1131
#: xml_doc.cpp:4627
msgid ""
"The ROUNDUP(value;[digits]) function returns value rounded up. Digits is the "
"number of digits to which you want to round that number. If digits is zero "
"or omitted, value is rounded up to the nearest integer."
msgstr ""
"ROUNDUP(मान;[अङ्क]) राउन्ड अप गरिएको मान फर्काउँछ । अङ्क तपाईँले त्यो नम्बर घेर्न चाहेको "
"अङ्कको नम्बर हो । यदि अङ्क शून्य भएमा छा छुटेमा, सबै भन्दा नजिकको इन्टिजरको माथि मान "
"घेरिन्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 1132
#: xml_doc.cpp:4630
msgid "ROUNDUP(value;[digits])"
msgstr "ROUNDUP(मान;[अङ्क])"

#. i18n: tag Example
#. i18n: file functions/math.xml line 1133
#: xml_doc.cpp:4633
msgid "ROUNDUP(1.252;2) equals 1.26"
msgstr "ROUNDUP(1.252;2) बराबर 1.26"

#. i18n: tag Example
#. i18n: file functions/math.xml line 1134
#: xml_doc.cpp:4636
msgid "ROUNDUP(-1.252;2) equals -1.25"
msgstr "ROUNDUP(-1.252;2) बराबर -1.25"

#. i18n: tag Example
#. i18n: file functions/math.xml line 1135
#: xml_doc.cpp:4639
msgid "ROUNDUP(-1.252) equals -1"
msgstr "ROUNDUP(-1.252) बराबर -1"

#. i18n: tag Text
#. i18n: file functions/math.xml line 1153
#: xml_doc.cpp:4648
msgid ""
"The ROUNDDOWN(value;[digits]) function returns value rounded down. Digits is "
"the number of digits to which you want to round that number. If digits is "
"zero or omitted, value is rounded down to the nearest integer."
msgstr ""
"ROUNDDOWN(मान;[अङ्क]) प्रकार्यले राउन्ड डाउन गरिएको मान फर्काउँछ । अङ्क त्यो नम्बरको "
"अङ्क हो जसमा तपाईँले त्यो नम्बर राउन्ड गर्न चाहनुहुन्छ । यदि अङ्क शून्य भएमा वा छुटेमा, सबै "
"भन्दा नजिकको इन्टिजरमा राउन्ड डाउन हुने छ ।"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 1154
#: xml_doc.cpp:4651
msgid "ROUNDDOWN(value;[digits])"
msgstr "ROUNDDOWN(मान;[अङ्क])"

#. i18n: tag Example
#. i18n: file functions/math.xml line 1155
#: xml_doc.cpp:4654
msgid "ROUNDDOWN(1.252;2) equals 1.25"
msgstr "ROUNDDOWN(1.252;2) बराबर 1.25"

#. i18n: tag Example
#. i18n: file functions/math.xml line 1156
#: xml_doc.cpp:4657
msgid "ROUNDDOWN(-1.252;2) equals -1.26"
msgstr "ROUNDDOWN(-1.252;2) बराबर -1.26"

#. i18n: tag Example
#. i18n: file functions/math.xml line 1157
#: xml_doc.cpp:4660
msgid "ROUNDDOWN(-1.252) equals -2"
msgstr "ROUNDDOWN(-1.252) बराबर -2"

#. i18n: tag Comment
#. i18n: file functions/math.xml line 1167
#: xml_doc.cpp:4663
msgid "Nth term"
msgstr "Nth सर्त"

#. i18n: tag Text
#. i18n: file functions/math.xml line 1171
#: xml_doc.cpp:4666
msgid ""
"Function FIB calculates the Nth term of a Fibonacci sequence (1, 1, 2, 3, 5, "
"8, 13, 21...), in which each number, after the first two, is the sum of the "
"two numbers immediately preceding it. FIB(0) is defined to be 0."
msgstr ""
"FIB प्रकार्यले फिवोन्याकी क्रमको Nth टर्म (1, 1, 2, 3, 5, 8, 13, 21...) गणना गर्छ, "
"जसमा प्रत्येक नम्बर, पहिला दुइ पछाडि, यसका हालैका अघिल्ला दुइ नम्बरको जोड हुन्छ । FIB"
"(0) ले 0 परिभाषित गर्नेछ ।"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 1172
#: xml_doc.cpp:4669
msgid "FIB(n)"
msgstr "FIB(n)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 1173
#: xml_doc.cpp:4672
msgid "FIB(9) returns 34"
msgstr "FIB(9) फर्काउँछ 34"

#. i18n: tag Example
#. i18n: file functions/math.xml line 1174
#: xml_doc.cpp:4675
msgid "FIB(26) returns 121393"
msgstr "FIB(26) फर्काउँछ 121393"

#. i18n: tag Comment
#. i18n: file functions/math.xml line 1182
#: xml_doc.cpp:4678
msgid "Numerator"
msgstr "अंश"

#. i18n: tag Comment
#. i18n: file functions/math.xml line 1186
#: xml_doc.cpp:4681
msgid "Denumerator"
msgstr "हर"

#. i18n: tag Text
#. i18n: file functions/math.xml line 1190
#: xml_doc.cpp:4684
msgid "Function QUOTIENT returns the integer portion of numerator/denumerator."
msgstr "QUOTIENT ले इन्टिजर भागको अंश/हर फर्काउछ ।"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 1191
#: xml_doc.cpp:4687
msgid "QUOTIENT(numerator;denumerator)"
msgstr "QUOTIENT(अंश;हर)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 1192
#: xml_doc.cpp:4690
msgid "QUOTIENT(21;4) returns 5"
msgstr "QUOTIENT(21;4) ले 5 फर्काउछ"

#. i18n: tag Text
#. i18n: file functions/math.xml line 1205
#: xml_doc.cpp:4696
msgid ""
"Function MDETERM returns the determinant of a given matrix. The matrix must "
"be of type n x n."
msgstr ""
"MDETERM प्रकार्यले दिएको म्याट्रिक्सको निर्धारक फर्काउछ । म्याट्रिक्स n x n प्रकारको "
"हुनुपर्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 1206
#: xml_doc.cpp:4699
msgid "MDETERM(matrix)"
msgstr "MDETERM(म्याट्रिक्स)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 1207
#: xml_doc.cpp:4702
