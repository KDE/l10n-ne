#: xml_doc.cpp:5588 xml_doc.cpp:5591 xml_doc.cpp:5594 xml_doc.cpp:5597
msgid "Floating point values or range of values"
msgstr "उत्प्लावन बिन्दु मानहरू वा मानका दायरा"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 688
#: xml_doc.cpp:5600
msgid ""
"The MEDIAN() function calculates the median of all the values given as "
"parameters. You can calculate the median of a range like MEDIAN(A1:B5) or a "
"list of values like MEDIAN(12; 5; 12.5). Blank cells will be considered as a "
"zero, and cells with text will be ignored."
msgstr ""
"MEDIAN() प्रकार्यले परिमितिको रुपमा दिएका सबै मानको मध्यिका गणना गर्छ । तपाईँले MEDIAN"
"(A1:B5) जस्तो दायराको वा MEDIAN(12; 5; 12.5) जस्तो मानको सूचीको मध्यिका गणना गर्न "
"सक्नुहुन्छ । खाली कक्षलाई शून्यको रुपमा मानिने छ, र कक्षका पाठ उपेक्षा गरिने छ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 689
#: xml_doc.cpp:5603
msgid "MEDIAN(value;value;...)"
msgstr "MEDIAN(मान;मान;...)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 690
#: xml_doc.cpp:5606
msgid "MEDIAN(12; 5; 5.5) equals 5.5"
msgstr "MEDIAN(12; 5; 5.5) बराबर 5.5"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 691
#: xml_doc.cpp:5609
msgid "MEDIAN(12; 7; 8;2) equals 7.5"
msgstr "MEDIAN(12; 7; 8;2) बराबर 7.5"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 699
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 703
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 707
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 711
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 906
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 910
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 914
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 918
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 934
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 938
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 942
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 946
#: xml_doc.cpp:5612 xml_doc.cpp:5615 xml_doc.cpp:5618 xml_doc.cpp:5621
#: xml_doc.cpp:5804 xml_doc.cpp:5807 xml_doc.cpp:5810 xml_doc.cpp:5813
#: xml_doc.cpp:5828 xml_doc.cpp:5831 xml_doc.cpp:5834 xml_doc.cpp:5837
msgid "Float"
msgstr "उत्प्लावन"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 715
#: xml_doc.cpp:5624
msgid ""
"The MODE() function returns the most frequently occuring value in the data "
"set."
msgstr "MODE() प्रकार्यले डेटा सेटमा सबै भन्दा धेरै पटक आउने मान फर्काउछ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 716
#: xml_doc.cpp:5627
msgid "MODE(number; number2; ...)"
msgstr "MODE(नम्बर; नम्बर2; ...)"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 717
#: xml_doc.cpp:5630
msgid "MODE(range)"
msgstr "MODE(दायरा)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 718
#: xml_doc.cpp:5633
msgid "MODE(12; 14; 12; 15) returns 12"
msgstr "MODE(12; 14; 12; 15) ले 12 फर्काउँछ"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 726
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 1585
#: xml_doc.cpp:5636 xml_doc.cpp:6341
msgid "Number of failures"
msgstr "असफल हुने नम्बर"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 730
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 1544
#: xml_doc.cpp:5639 xml_doc.cpp:6305
msgid "Number of successful trials"
msgstr "सफल परीक्षणका नम्बर"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 734
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 1548
#: xml_doc.cpp:5642 xml_doc.cpp:6308
msgid "Probability of success"
msgstr "सफलताको सम्भाव्यता"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 738
#: xml_doc.cpp:5645
msgid "The NEGBINOMDIST() function returns the negative binomial distribution."
msgstr "NEGBINOMDIST() प्रकार्यले ऋणात्मक बाइनोमियल वितरण फर्काउँछ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 739
#: xml_doc.cpp:5648
msgid "NEGBINOMDIST(failures; success; prob_of_success)"
msgstr "NEGBINOMDIST(असफल; सफल; सफलताको सम्भाव्यता)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 740
#: xml_doc.cpp:5651
msgid "NEGBINOMDIST(2;5;0.55) returns 0.152872629"
msgstr "NEGBINOMDIST(2;5;0.55) ले 0.152872629 फर्काउँछ"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 752
#: xml_doc.cpp:5657
msgid "Linear middle of the distribution"
msgstr "वितरणको रेखात्मक मध्यम"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 756
#: xml_doc.cpp:5660
msgid "Standard deviation of the distribution"
msgstr "वितरणको स्ट्यान्डर्ड डेभिएसन"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 764
#: xml_doc.cpp:5666
msgid "The NORMDIST() function returns the normal cumulative distribution."
msgstr "NORMDIST() प्रकार्यले सामान्य क्युमुलेटिभ वितरण फर्काउँछ"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 765
#: xml_doc.cpp:5669
msgid ""
"Number is the value of the distribution based on which the normal "
"distribution is to be calculated."
msgstr "नम्बर वितरणको मान हो जसमा आधारित भएर सामान्य वितरण गणना गरिने छ ।"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 766
#: xml_doc.cpp:5672
msgid "MV is the linear middle of the distribution."
msgstr "MV वितरणको रेखात्मक मध्यम हो ।"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 767
#: xml_doc.cpp:5675
msgid "STD is the standard deviation of the distribution."
msgstr "STD वितरणको स्ट्यान्डर्ड डेभिएसन हो ।"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 768
#: xml_doc.cpp:5678
msgid ""
"K = 0 calculates the density function; K = 1 calculates the distribution."
msgstr "K = 0 ले घनत्व प्रकार्य गणना गर्छ; K = 1 ले वितरण गणना गर्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 769
#: xml_doc.cpp:5681
msgid "NORMDIST(Number;MV;STD;K)"
msgstr "NORMDIST(नम्बर;MV;STD;K)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 770
#: xml_doc.cpp:5684
msgid "NORMDIST(0.859;0.6;0.258;0) equals 0.934236"
msgstr "NORMDIST(0.859;0.6;0.258;0) बराबर 0.934236"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 771
#: xml_doc.cpp:5687
msgid "NORMDIST(0.859;0.6;0.258;1) equals 0.842281"
msgstr "NORMDIST(0.859;0.6;0.258;1) बराबर 0.842281"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 783
#: xml_doc.cpp:5693
msgid "Middle value in the normal distribution"
msgstr "सामान्य वितरणको बीचको मान"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 787
#: xml_doc.cpp:5696
msgid "Standard deviation of the normal distribution"
msgstr "सामान्य वितरणको स्ट्यान्डर्ड डेभिएसन"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 791
#: xml_doc.cpp:5699
msgid ""
"The NORMINV() function returns the inverse of the normal cumulative "
"distribution. The number must be between 0 and 1 (non-inclusive) and STD "
"must be positive."
msgstr ""
"NORMINV() प्रकार्यले सामान्य क्युमुलेटिभ वितरणको उल्टो फर्काउँछ । नम्बर 0 र 1 बीचमा "
"हुनुपर्छ (सम्मिलित नहुने) र STD धनात्मक हुनुपर्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 792
#: xml_doc.cpp:5702
msgid "NORMINV(number;MV;STD)"
msgstr "NORMINV(नम्बर;MV;STD)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 793
#: xml_doc.cpp:5705
msgid "NORMINV(0.9;63;5) equals 69.41"
msgstr "NORMINV(0.9;63;5) बराबर 69.41"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 801
#: xml_doc.cpp:5708
msgid "Value to which the standard normal distribution is calculated"
msgstr "स्ट्यान्डर्ड वितरण मान गणना गर्नुपर्ने मान"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 805
#: xml_doc.cpp:5711
msgid "The NORMSDIST() function returns the standard normal distribution."
msgstr "NORMSDIST() प्रकार्यले स्ट्यान्डर्ड सामान्य वितरण फर्काउँछ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 806
#: xml_doc.cpp:5714
msgid "NORMSDIST(Number)"
msgstr "NORMSDIST(नम्बर)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 807
#: xml_doc.cpp:5717
msgid "NORMSDIST(1) equals 0.84"
msgstr "NORMSDIST(1) बराबर 0.84"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 819
#: xml_doc.cpp:5723
msgid ""
"The NORMSINV() function returns the inverse of the standard normal "
"cumulative distribution. The number must be between 0 and 1 (non-inclusive)."
msgstr ""
"NORMSINV() प्रकार्यले स्टान्डर्ड सामान्य क्युमुलेटिभ वितरणको उल्टो फर्काउँछ । नम्बर 0 र 1 "
"बीचमा(सम्मिलित नहुने) हुनुपर्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 820
#: xml_doc.cpp:5726
msgid "NORMSINV(Number)"
msgstr "NORMSINV(नम्बर)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 821
#: xml_doc.cpp:5729
msgid "NORMSINV(0.908789) returns 1.3333"
msgstr "NORMSINV(0.908789) फर्काउँछ 1.3333"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 837
#: xml_doc.cpp:5738
msgid ""
"The PEARSON() function calculates the correlation coefficient of two cell "
"ranges. It is the same as the CORREL function."
msgstr ""
"PEARSON() प्रकार्यले दुइ कक्ष दायराको कोरिलेसन कोफिसियन्ट गणना गर्छ । यो CORREL "
"प्रकार्यसँग समान छ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 838
#: xml_doc.cpp:5741
msgid "PEARSON(range1; range2)"
msgstr "PEARSON(दायरा 1; दायरा 2)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 839
#: xml_doc.cpp:5744
msgid "PEARSON(A1:A3; B1:B3)"
msgstr "PEARSON(A1:A3; B1:B3)"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 852
#: xml_doc.cpp:5750
msgid "Number of elements to permutate"
msgstr "परम्युट गर्नुपर्ने तत्वको नम्बर"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 856
#: xml_doc.cpp:5753
msgid ""
"The PERMUT() function returns the number of permutations. The first "
"parameter is the number of elements, and the second parameter is the number "
"of elements used in the permutation."
msgstr ""
"PERMUT() प्राकार्यले परम्युटेसनको नम्बर फर्काउँछ । पहिलो परिमिति तत्वको नम्बर हो, र "
"दोस्रो परिमिति परम्युटेसनमा प्रयोग गरिएको तत्वको नम्बर हो ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 857
#: xml_doc.cpp:5756
msgid "PERMUT(total;permutated)"
msgstr "PERMUT(कूल;परम्युट गरिएको)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 858
#: xml_doc.cpp:5759
msgid "PERMUT(8;5) equals 6720"
msgstr "PERMUT(8;5) बराबर 6720"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 859
#: xml_doc.cpp:5762
msgid "PERMUT(1;1) equals 1"
msgstr "PERMUT(1;1) बराबर 1"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 867
#: xml_doc.cpp:5765
msgid ""
"The number for which the standard normal distribution is to be calculated"
msgstr "स्ट्यान्डर्ड सामान्य वितरण गणना गरिनु पर्ने नम्बर"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 871
#: xml_doc.cpp:5768
msgid ""
"The PHI() function returns value of the distribution function for a standard "
"normal distribution."
msgstr "PHI() प्रकार्यले स्ट्यान्डर्ड सामान्य वितरणका लागि वितरण प्रकार्यको मान फर्काउँछ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 872
#: xml_doc.cpp:5771
msgid "PHI(value)"
msgstr "PHI(मान)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 873
#: xml_doc.cpp:5774
msgid "PHI(0.25) equals 0.386668"
msgstr "PHI(0.25) बराबर 0.386668"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 885
#: xml_doc.cpp:5780
msgid "Lambda parameter (the middle value)"
msgstr "ल्याम्ब्डा परिमिति (मध्यम मान)"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 893
#: xml_doc.cpp:5786
msgid "The POISSON() function returns the Poisson distribution."
msgstr "POISSON() प्रकार्यले पोइसन वितरण फर्काउँछ ।"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 894
#: xml_doc.cpp:5789
msgid "The lambda and number parameters must be positive."
msgstr "ल्याम्ब्डा र नम्बर परिमिति धनात्मक हुनुपर्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 896
#: xml_doc.cpp:5795
msgid "POISSON(number;lambda;cumulative)"
msgstr "POISSON(नम्बर;ल्याम्ब्डा;क्युमुलेटिभ)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 897
#: xml_doc.cpp:5798
msgid "POISSON(60;50;0) equals 0.020105"
msgstr "POISSON(60;50;0) बराबर 0.020105"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 898
#: xml_doc.cpp:5801
msgid "POISSON(60;50;1) equals 0.927840"
msgstr "POISSON(60;50;1) बराबर 0.927840"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 922
#: xml_doc.cpp:5816
msgid "The SKEW() function returns an estimate for skewness of a distribution"
msgstr "SKEW() प्रकार्यले वितरणको स्क्युनेसका लागि एउटा अनुमान फर्काउँछ"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 923
#: xml_doc.cpp:5819
msgid "SKEW(number; number2; ...)"
msgstr "SKEW(नम्बर; नम्बर2; ...)"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 924
#: xml_doc.cpp:5822
msgid "SKEW(range)"
msgstr "SKEW(दायरा)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 925
#: xml_doc.cpp:5825
msgid "SKEW(11.4; 17.3; 21.3; 25.9; 40.1) returns 0.9768"
msgstr "SKEW(11.4; 17.3; 21.3; 25.9; 40.1) ले 0.9768 फर्काउँछ"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 950
#: xml_doc.cpp:5840
msgid "The SKEWP() function returns the population skewness of a distribution"
msgstr "SKEWP() प्रकार्यले वितरणको कूल सङ्ख्याको स्क्युनेस फर्काउँछ"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 951
#: xml_doc.cpp:5843
msgid "SKEWP(number; number2; ...)"
msgstr "SKEWP(नम्बर; नम्बर2; ...)"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 952
#: xml_doc.cpp:5846
msgid "SKEWP(range)"
msgstr "SKEWP(दायरा)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 953
#: xml_doc.cpp:5849
msgid "SKEWP(11.4; 17.3; 21.3; 25.9; 40.1) returns 0.6552"
msgstr "SKEWP(11.4; 17.3; 21.3; 25.9; 40.1) ले 0.6552 फर्काउँछ"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 970
#: xml_doc.cpp:5858
#, fuzzy
#| msgid "The COVAR() function calculates the covariance of two cell ranges."
msgid ""
"The SLOPE() function calculates the slope of the linear regression line."
msgstr "COVAR() प्रकार्यले दुइ कक्ष दायराको कोभ्यारियन्स गणना गर्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 971
#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 1157
#: xml_doc.cpp:5861 xml_doc.cpp:6011
#, fuzzy
#| msgid "LOG(x)"
msgid "SLOPE(y;x)"
msgstr "LOG(x)"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 983
#: xml_doc.cpp:5867
msgid "Position (from the smallest)"
msgstr "स्थिति (सबै भन्दा सानो बाट)"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 987
#: xml_doc.cpp:5870
msgid "The SMALL() function returns the k-th smallest value from the data set."
msgstr "SMALL() प्रकार्यले डेटा सेटबाट सबै भन्दा सानो k-th मान फर्काउँछ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 988
#: xml_doc.cpp:5873
msgid "SMALL(range; k)"
msgstr "SMALL(दायरा; k)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 989
#: xml_doc.cpp:5876
msgid "A1: 3, A2: 1, A3: 5 => SMALL(A1:A3; 1) returns 1"
msgstr "A1: 3, A2: 1, A3: 5 => SMALL(A1:A3; 1) ले 1 फर्काउँछ"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 997
#: xml_doc.cpp:5879
msgid "Number to be normalized"
msgstr "सामान्यकरण गरिनुपर्ने नम्बर"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 1001
#: xml_doc.cpp:5882
msgid "Mean of the distribution"
msgstr "वितरणको मध्यक"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 1005
#: xml_doc.cpp:5885
msgid "Standard deviation"
msgstr "स्ट्यान्डर्ड डेभिएसन"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 1009
#: xml_doc.cpp:5888
msgid "The STANDARDIZE() function calculates a normalized value."
msgstr "STANDARDIZE() प्रकार्यले समान्य पारिएको मान गणना गर्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 1010
#: xml_doc.cpp:5891
msgid "STANDARDIZE(x; mean, stdev)"
msgstr "STANDARDIZE(x; मध्यक, stdev)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 1011
#: xml_doc.cpp:5894
msgid "STANDARDIZE(4; 3; 7) returns 0.1429"
msgstr "STANDARDIZE(4; 3; 7) ले 0.1429 फर्काउँछ"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 1039
#: xml_doc.cpp:5912
msgid ""
"The STDEV() function returns the estimate standard deviation based on a "
"sample. The standard deviation is a measure of how widely values are "
"dispersed from the average value."
msgstr ""
"STDEV() प्रकार्यले नमूनामा आधारित स्ट्यान्डर्ड डेभिएसनको अनुमान फर्काउँछ । स्ट्यान्डर्ड "
"डेभिएसन औसत मानबाट फैलिएका मानहरूको माप हो ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 1040
#: xml_doc.cpp:5915
msgid "STDEV(value;value;...)"
msgstr "STDEV(मान;मान;...)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 1041
#: xml_doc.cpp:5918
msgid "STDEV(6;7;8) equals 1"
msgstr "STDEV(6;7;8) बराबर 1"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 1070
#: xml_doc.cpp:5936
msgid ""
"The STDEVA() function returns the estimate standard deviation based on a "
"sample. The standard deviation is a measure of how widely values are "
"dispersed from the average value. If a referenced cell contains text or "
"contains the boolean value FALSE, it is counted as 0. If the boolean value "
"is TRUE it is counted as 1."
msgstr ""
"STDEVA() प्रकार्यले नमूनामा आधारित स्ट्यान्डर्ड डेभिएसनको अनुमान फर्काउँछ । स्ट्यान्डर्ड "
"डेभिएसन औसत मानबाट फैलिएका मानको माप हो । यदि सान्दर्भिक कक्षले पाठ वा बूलियन मान "
"FALSE समाविष्ट गर्छ भने, यो 0 गणना गरिने छ । यदि बूलियन मान TRUE भएमा यो 1 गणना "
"गरिने छ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 1071
#: xml_doc.cpp:5939
msgid "STDEVA(value;value;...)"
msgstr "STDEVA(मान;मान;...)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 1072
#: xml_doc.cpp:5942
msgid "STDEVA(6; 7; A1; 8) equals 1, if A1 is empty"
msgstr "यदि A1 खाली भएमा, STDEVA(6; 7; A1; 8) बराबर 1 हुन्छ"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 1073
#: xml_doc.cpp:5945
msgid "STDEVA(6; 7; A1; 8) equals 3.109, if A1 is TRUE"
msgstr "यदि A1 TRUE भएमा, STDEVA(6; 7; A1; 8) बराबर 3.109 हुन्छ"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 1103
#: xml_doc.cpp:5963
msgid ""
"The STDEVP() function returns the standard deviation based on an entire "
"population"
msgstr "STDEVP() प्रकार्यले पूरै सङ्ख्यामा आधारित स्ट्यान्डर्ड डेभिएसन फर्काउँछ"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 1104
#: xml_doc.cpp:5966
msgid "STDEVP(value;value;...)"
msgstr "STDEVP(मान;मान;...)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 1105
#: xml_doc.cpp:5969
msgid "STDEVP(6;7;8) equals 0.816497..."
msgstr "STDEVP(6;7;8) बराबर 0.816497..."

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 1134
#: xml_doc.cpp:5987
msgid ""
"The STDEVPA() function returns standard deviation based on an entire "
"population. If a referenced cell contains text or contains the boolean value "
"FALSE, it is counted as 0. If the boolean value is TRUE it is counted as 1."
msgstr ""
"STDEVPA() प्रकार्यले पूरै सङ्ख्यामा आधारित स्ट्यान्डर्ड डेभिएसन फर्काउँछ । यदि सान्दर्भिक "
"कक्षले पाठ वा बूलियन मानले FALSE समावेश गरेमा, यो 0 गणना हुन्छ । यदि बूलियनको मान "
"TRUE भएमा यो 1 गणना हुन्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 1135
#: xml_doc.cpp:5990
msgid "STDEVPA(value;value;...)"
msgstr "STDEVPA(मान;मान;...)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 1136
#: xml_doc.cpp:5993
msgid "STDEVPA(6; 7; A1; 8) equals 0.816497..., if A1 is empty"
msgstr "यदि A1 खाली भएमा, STDEVPA(6; 7; A1; 8) बराबर 0.816497... हुन्छ"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 1137
#: xml_doc.cpp:5996
msgid "STDEVPA(6; 7; A1; 8) equals 2.69..., if A1 is TRUE"
msgstr "यदि A1 TRUE भएमा, STDEVPA(6; 7; A1; 8) बराबर 2.69... हुन्छ"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 1138
#: xml_doc.cpp:5999
msgid "STDEVPA(6; 7; A1; 8) equals 3.11..., if A1 is FALSE"
msgstr "यदि A1 FALSE भएमा, STDEVPA(6; 7; A1; 8) बराबर 3.11... हुन्छ"

