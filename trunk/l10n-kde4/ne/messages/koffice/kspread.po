#. i18n: tag Text
#. i18n: file functions/statistical.xml line 515
#: xml_doc.cpp:5459
msgid "The HYPGEOMDIST() function returns the hypergeometric distribution."
msgstr "HYPGEOMDIST() प्रकार्यले हाइपर जेमेट्रिक वितरण फर्काउँछ ।"

