msgid "Order of the function"
msgstr "प्रकार्यको क्रम"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 41
#: xml_doc.cpp:1230
msgid "The BESSELI() function returns the modified Bessel function In(x)."
msgstr "BESSELI() प्राकार्यले परिमार्जित बेसेल प्रकार्यमा फर्काउँछ(x) ।"

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 42
#: xml_doc.cpp:1233
msgid "BESSELI(X;N)"
msgstr "BESSELI(X;N)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 43
#: xml_doc.cpp:1236
msgid "BESSELI(0.7;3) returns 0.007367374"
msgstr "BESSELI(0.7;3) ले 0.007367374 फर्काउँछ"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 62
#: xml_doc.cpp:1245
msgid "The BESSELJ() function returns the Bessel function."
msgstr "BESSELJ() प्राकर्यले बेसेल प्राकार्य फर्काउँछ ।"

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 63
#: xml_doc.cpp:1248
msgid "BESSELJ(X;N)"
msgstr "BESSELJ(X;N)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 64
#: xml_doc.cpp:1251
msgid "BESSELJ(0.89;3) returns 0.013974004"
msgstr "BESSELJ(0.89;3) 0.013974004 फर्काउँछ"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 83
#: xml_doc.cpp:1260
msgid ""
"The BESSELK() function returns the modified Bessel function, which is "
"equivalent to the Bessel function evaluated for purely imaginary arguments."
msgstr ""
"BESSELK() प्राकार्यले सीधा कल्पित तर्कका लागि मूल्याङ्कन गरिएका बेसेल प्रकार्यसँग समान, "
"परिमार्जित बेसेल प्रकार्य फर्काउँछ ।"

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 84
#: xml_doc.cpp:1263
msgid "BESSELK(X;N)"
msgstr "BESSELK(X;N)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 85
#: xml_doc.cpp:1266
msgid "BESSELK(3;9) returns 397.95880"
msgstr "BESSELK(3;9) 397.95880 फर्काउँछ"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 104
#: xml_doc.cpp:1275
msgid ""
"The BESSELY() function returns the Bessel function, which is also called the "
"Weber function or the Neumann function."
msgstr ""
"BESSELY() प्रकार्यले वेबर प्रकार्य वा नेउम्यान प्रकार्य पनि भनिने, बेसेल प्रकार्य फर्काउँछ ।"

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 105
#: xml_doc.cpp:1278
msgid "BESSELY(X;N)"
msgstr "BESSELY(X;N)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 106
#: xml_doc.cpp:1281
msgid "BESSELY(4;2) equals 0.215903595"
msgstr "BESSELY(4;2) ले 0.215903595 बराबर बनाउछ"

#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 121
#: xml_doc.cpp:1287
msgid "From unit"
msgstr "एकाइबाट"

#. i18n: tag Comment
#. i18n: file functions/engineering.xml line 125
#: xml_doc.cpp:1290
msgid "To unit"
msgstr "एकाइमा"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 129
#: xml_doc.cpp:1293
msgid ""
"The CONVERT() function returns a conversion from one measurement system to "
"another."
msgstr "CONVERT() प्राकार्यले एक मापन प्रणालीबाट अर्कोमा रुपान्तरण फर्काउँछ ।"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 130
#: xml_doc.cpp:1296
msgid ""
"Supported mass units: g (gram), sg (pieces), lbm (pound), u (atomic mass), "
"ozm (ounce), stone, ton, grain, pweight (pennyweight), hweight "
"(hundredweight), bron (gross registered ton)."
msgstr ""
"समर्थित मास एकाइ: g (ग्राम), sg (पिसेज), lbm (पाउन्ड), u (परमाणुभार), ozm (अउन्स), "
"ढुङ्गा, टन, अनाज, pweight (पेनी वजन ), hweight (क्विन्टल), ब्रोन (दर्ता गरिएको कुल "
"टन) ।"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 131
#: xml_doc.cpp:1299
msgid ""
"Supported distance units: m (meter), in (inch), ft (feet), mi (mile), Nmi "
"(nautical mile), ang (Angstrom), parsec, lightyear."
msgstr ""
"समर्थित दुरी एकाइ: m (मिटर), in (इन्च), ft (फिट), mi (माइल), Nmi (नौटिकल माइल), "
"ang (एङ्ग्सट्रम), दिग्विकला, प्रकास वर्ष ।"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 132
#: xml_doc.cpp:1302
msgid ""
"Supported pressure units: Pa (Pascal), atm (atmosphere), mmHg (mm of "
"Mercury), psi, Torr."
msgstr ""
"समर्थित चाप एकाइ: Pa (पास्कल), atm (वायुमण्डल), mmHg (पारोको mm), psi, Torr."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 133
#: xml_doc.cpp:1305
msgid "Supported force units: N (Newton), dyn, pound."
msgstr "समर्थित बल एकाइ: N (न्युटन), dyn, पाउन्ड ।"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 134
#: xml_doc.cpp:1308
msgid ""
"Supported energy units: J (Joule), e (erg), c (Thermodynamic calorie), cal "
"(IT calorie), eV (electronvolt), HPh (Horsepower-hour), Wh (Watt-hour), flb "
"(foot-pound), BTU."
msgstr ""
"समर्थित शक्ति एकाइ: J (जुल), e (erg), c (थर्मोडाइनामिक क्यालोरी), cal (IT "
"क्यालोरी), eV (इलेक्ट्रोभोल्ट), HPh (हर्सपावर-घण्टा), Wh (वाट-घण्टा), flb (फुट-"
"पाउन्ड), BTU."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 135
#: xml_doc.cpp:1311
msgid "Supported power units: W (Watt), HP (horsepower), PS (Pferdestaerke)."
msgstr "सामर्थ्य समर्थित एकाइ: W (वाट), HP (हर्सपावर), PS (Pferdestaerke)."

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 136
#: xml_doc.cpp:1314
msgid "Supported magnetism units: T (Tesla), ga (Gauss)."
msgstr "समर्थित आकर्षण एकाइ: T तेस्ला), ga (गउस) ।"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 137
#: xml_doc.cpp:1317
msgid "Supported temperature units: C (Celsius), F (Fahrenheit), K (Kelvin)."
msgstr "समर्थित तापक्रम एकाइ: C (सेल्सियस), F (फरेनहाइट), K (केल्भिन) ।"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 138
#: xml_doc.cpp:1320
msgid ""
"Supported volume units: l (liter), tsp (teaspoon), tbs (tablespoon), oz "
"(ounce liquid), cup, pt (pint), qt (quart), gal (gallone), barrel, m3 (cubic "
"meter), mi3 (cubic mile), Nmi3 (cubic Nautical mile), in3 (cubic inch), ft3 "
"(cubic foot), yd3 (cubic yard)."
msgstr ""
"समर्थित आयातन एकाइ: l (लीटर), tsp (चिया चम्चा), tbs (टेबल चम्चा), oz (अउन्स तरल), "
"कप, pt (पिन्ट), qt (क्वाटर), gal (गेलोन), ब्यारेल, m3 (घन मिटर), mi3 (घन माइल), "
"Nmi3 (घन नउटिकल माइल), in3 (घन इन्च), ft3 (घन फुटt), yd3 (घन यार्ड) ।"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 139
#: xml_doc.cpp:1323
msgid ""
"Supported area units: m2 (square meter), mi2 (square mile), Nmi2 (square "
"Nautical mile), in2 (square inch), ft2 (square foot), yd2 (square yard), "
"acre, ha (hectare)."
msgstr ""
"समर्थित क्षेत्रफल एकाइ: m2 (वर्ग मिटर), mi2 (वर्ग माइल), Nmi2 (वर्ग नउटिकल माइल), "
"in2 (वर्ग इन्च), ft2 (वर्ग फुट), yd2 (वर्ग यार्ड), acre, ha (हेक्टर) ।"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 140
#: xml_doc.cpp:1326
msgid ""
"Supported speed units: m/s (meters per second), m/h (meters per hour), mph "
"(miles per hour), kn (knot)."
msgstr ""
"समर्थित गति एकाइ: m/s (मिटर प्रति सेकेन्ड), m/h (मिटर प्रति घण्टा), mph (माइल प्रति "
"घण्टा) kn (knot) ।"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 141
#: xml_doc.cpp:1329
msgid ""
"For metric units any of the following prefixes can be used: E (exa, 1E+18), "
"P (peta, 1E+15), T (tera, 1E+12), G (giga, 1E+09), M (mega, 1E+06), k (kilo, "
"1E+03), h (hecto, 1E+02), e (dekao, 1E+01), d (deci, 1E-01), c (centi, 1E-"
"02), m (milli, 1E-03), u (micro, 1E-06), n (nano, 1E-09), p (pico, 1E-12), f "
"(femto, 1E-15), a (atto, 1E-18)."
msgstr ""
"मेट्रिक एकाइका लागि निम्न कुनै पनि उपसर्ग प्रयोग गर्न सकिन्छ: E (exa, 1E+18), P (पेटा, "
"1E+15), T (टेरा, 1E+12), G (गिगा, 1E+09), M (मेगा, 1E+06), k (किलो, 1E+03), h "
"(हेक्टो, 1E+02), e (डेको, 1E+01), d (डेसी, 1E-01), c (सेन्टि, 1E-02), m (मिलि, 1E-"
"03), u (माइक्रो, 1E-06), n (नानो, 1E-09), p (पिको, 1E-12), f (फेम्टो, 1E-15), a "
"(अटो, 1E-18) ।"

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 142
#: xml_doc.cpp:1332
msgid "CONVERT(Number; From Unit; To Unit)"
msgstr "CONVERT(नम्बर; एकाइबाट; एकाइसम्म)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 143
#: xml_doc.cpp:1335
msgid "CONVERT(32;\"C\";\"F\") equals 89.6"
msgstr "CONVERT(32;\"C\";\"F\") बराबर 89.6 हुन्छ"

#. i18n: tag Example
