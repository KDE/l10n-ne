msgstr "स्तम्भ नम्बर"

#. i18n: tag Comment
#. i18n: file functions/reference.xml line 19
#: xml_doc.cpp:4771
msgid "Absolute number (optional)"
msgstr "पूर्ण नम्बर (वैकल्पिक)"

#. i18n: tag Comment
