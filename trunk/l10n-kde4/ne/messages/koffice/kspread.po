#. i18n: file functions/math.xml line 368
#: xml_doc.cpp:3968
msgid ""
"The FACT() function calculates the factorial of the parameter. The "
"mathematical expression is (value)!."
msgstr "FACT() प्रकार्यले परिमितिको क्रमगुणन गणना गर्छ । गणितिय अभिव्यक्ति (मान) हो!"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 369
#: xml_doc.cpp:3971
msgid "FACT(number)"
msgstr "FACT(नम्बर)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 370
#: xml_doc.cpp:3974
msgid "FACT(10) returns 3628800"
msgstr "FACT(10) ले 3628800 फर्काउँछ"

#. i18n: tag Example
#. i18n: file functions/math.xml line 371
#: xml_doc.cpp:3977
msgid "FACT(0) returns 1"
msgstr "FACT(0) ले 1 फर्काउँछ"

#. i18n: tag Text
#. i18n: file functions/math.xml line 383
#: xml_doc.cpp:3983
msgid ""
"The FACTDOUBLE() function calculates the double factorial of a number, i.e. "
"x!!."
msgstr "FACTDOUBLE() प्रकार्यले नम्बरको डबल क्रमगुणन गणना गर्छ, जस्तै: x!!"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 384
#: xml_doc.cpp:3986
msgid "FACTDOUBLE(number)"
msgstr "FACTDOUBLE(नम्बर)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 385
#: xml_doc.cpp:3989
msgid "FACTDOUBLE(6) returns 48"
msgstr "FACTDOUBLE(6) ले 48 फर्काउँछ"

#. i18n: tag Example
#. i18n: file functions/math.xml line 386
#: xml_doc.cpp:3992
msgid "FACTDOUBLE(7) returns 105"
msgstr "FACTDOUBLE(7) ले 105 फर्काउँछ"

#. i18n: tag Text
#. i18n: file functions/math.xml line 398
#: xml_doc.cpp:3998
msgid ""
"The SUM() function calculates the sum of all the values given as parameters. "
"You can calculate the sum of a range SUM(A1:B5) or a list of values like SUM"
"(12;5;12.5)."
msgstr ""
"SUM() प्रक्रियाले परिमितिका रुपमा दिएका सबै मानका जोड गणना गर्छ । तपाईँले SUM(A1:B5) "
"वा SUM(12;5;12.5) जस्ता मानको दायराको जोड गणना गर्न सक्नुहुन्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 399
#. i18n: tag Syntax
#. i18n: file functions/math.xml line 417
#: xml_doc.cpp:4001 xml_doc.cpp:4016
msgid "SUM(value;value;...)"
msgstr "SUM(मान;मान;...)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 400
#: xml_doc.cpp:4004
msgid "SUM(12;5;7) equals 24"
msgstr "SUM(12;5;7) बराबर 24"

#. i18n: tag Example
#. i18n: file functions/math.xml line 401
#: xml_doc.cpp:4007
msgid "SUM(12.5;2) equals 14.5"
msgstr "SUM(12.5;2) बराबर 14.5"

#. i18n: tag Text
#. i18n: file functions/math.xml line 416
#: xml_doc.cpp:4013
msgid ""
"The SUMA() function calculates the sum of all the values given as "
"parameters. You can calculate the sum of a range SUMA(A1:B5) or a list of "
"values like SUMA(12;5;12.5). If a parameter contains text or the boolean "
"value FALSE it is counted as 0, if a parameter evaluates to TRUE it is "
"counted as 1."
msgstr ""
"SUMA() प्रकार्यले परिमितिको रुपमा दिएका सबै मानको जोड गणना गर्छ । तपाईँले SUMA(A1:"
"B5) वा SUMA(12;5;12.5) जस्ता मानका सूची दायराको जोड गणना गर्न सक्नुहुन्छ । यदि "
"परिमितिले पाठ वा वूलियन मान FALSE समावेश गरेमा यसलाई 0 गणना गरिने छ, यदि परिमितिले "
"TRUE ठीक मूल्याङ्कन गरेमा 1 गणना गरिन्छ ।"

#. i18n: tag Example
#. i18n: file functions/math.xml line 418
#: xml_doc.cpp:4019
msgid "SUMA(12;5; 7) equals 24"
msgstr "SUMA(12;5; 7) बराबर 24"

#. i18n: tag Example
#. i18n: file functions/math.xml line 419
#: xml_doc.cpp:4022
msgid "SUMA(12.5; 2; TRUE) equals 15.5"
msgstr "SUMA(12.5; 2; TRUE) बराबर 15.5"

#. i18n: tag Comment
#. i18n: file functions/math.xml line 429
#: xml_doc.cpp:4025
msgid "Check range"
msgstr "दायरा जाँच गर्नुहोस्"

#. i18n: tag Comment
#. i18n: file functions/math.xml line 437
#: xml_doc.cpp:4031
msgid "Sum range"
msgstr "दायरा योगफल"

#. i18n: tag Text
#. i18n: file functions/math.xml line 441
#: xml_doc.cpp:4034
msgid ""
"The SUMIF() function calculates the sum of all values given as parameters "
"which match the criteria. The sum range is optional. If not supplied, the "
"values in the check range are summed. The length of the check range should "
"be equal or less than the length of the sum range."
msgstr ""
"SUMIF() प्रकार्यले मापदण्डमा मिल्ने परिमितिको रुपमा दिएका सबै मानको गणना गर्छ । जोड "
"दायरा वैकल्पिक छ । यदि वितरण नगरिएमा, जाँच दायरा भित्रका मान जोडिने छन् । जाँच "
"दायरको लम्बाइ जोड दायराको लम्बाइसँग बराबर वा थोरै हुनुपर्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 442
#: xml_doc.cpp:4037
msgid "SUMIF(checkrange;criteria;sumrange)"
msgstr "SUMIF(जाँच दायरा;मापदण्ड;जोड दायरा)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 443
#: xml_doc.cpp:4040
msgid "SUMIF(A1:A4;\">1\") sums all values in range A1:A4 which match >1"
msgstr "SUMIF(A1:A4;\">1\") ले >1 मा मिल्ने A1:A4 दायरा भित्रका सबै मानको जोड गर्छ"

#. i18n: tag Example
#. i18n: file functions/math.xml line 444
#: xml_doc.cpp:4043
msgid ""
"SUMIF(A1:A4;\"=0\";B1:B4) sums all values in range B1:B4 if the "
"corresponding value in A1:A4 matches =0"
msgstr ""
"SUMIF(A1:A4;\"=0\";B1:B4) ले A1:A4 को सङ्गति मान =0 मिल्ने सबै मान दायरा B1:B4 मा "
"जोड गर्छ"

#. i18n: tag Text
#. i18n: file functions/math.xml line 458
#: xml_doc.cpp:4049
msgid ""
"The PRODUCT() function calculates the product of all the values given as "
"parameters. You can calculate the product of a range: PRODUCT(A1:B5) or a "
"list of values like product(12;5;12.5). If no numeric values are found 0 is "
"returned."
msgstr ""
"PRODUCT() प्राकार्यले परिमितिको रुपमा दिएका सबै मानको गुणनफल गणना गर्छ । तपाईँले: "
"PRODUCT(A1:B5) वा गुणनफल (12;5;12.5) जस्ता मानका सूची दायराको गुणनफल गणना गर्न "
"सक्नुहुन्छ । यदि सङ्ख्यात्मक मान फेला नपरेमा 0 फर्किने छ ।"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 459
#: xml_doc.cpp:4052
msgid "PRODUCT(value;value;...)"
msgstr "PRODUCT(मान;मान;...)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 460
#: xml_doc.cpp:4055
msgid "PRODUCT(3;5;7) equals 105"
msgstr "PRODUCT(3;5;7) बराबर 105"

#. i18n: tag Example
#. i18n: file functions/math.xml line 461
#: xml_doc.cpp:4058
msgid "PRODUCT(12.5;2) equals 25"
msgstr "PRODUCT(12.5;2) बराबर 25"

#. i18n: tag Text
#. i18n: file functions/math.xml line 475
#: xml_doc.cpp:4064
msgid ""
"The KPRODUCT() function calculates the product of all the values given as "
"parameters. You can calculate the product of a range: KPRODUCT(A1:B5) or a "
"list of values like KPRODUCT(12;5;12.5). If no numeric values are found 1 is "
"returned."
msgstr ""
"KPRODUCT() प्रकार्यले परिमितिको रुपमा दिएका सबै मानका गूणनफल गणना गर्छ । तपाईँले: "
"KPRODUCT(A1:B5) वा KPRODUCT(12;5;12.5) जस्ता मानका सूचीको दायाराको गुणनफल गणना "
"गर्न सक्नुहुन्छ । यदि कुनै सङ्ख्यात्मक मान फेला नपरेमा 1 फर्किनेछ ।"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 476
#: xml_doc.cpp:4067
msgid "KPRODUCT(value;value;...)"
msgstr "KPRODUCT(मान;मान...)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 477
#: xml_doc.cpp:4070
msgid "KPRODUCT(3;5;7) equals 105"
msgstr "KPRODUCT(3;5;7) बराबर 105"

#. i18n: tag Example
#. i18n: file functions/math.xml line 478
#: xml_doc.cpp:4073
msgid "KPRODUCT(12.5;2) equals 25"
msgstr "KPRODUCT(12.5;2) बराबर 25"

#. i18n: tag Text
#. i18n: file functions/math.xml line 493
#: xml_doc.cpp:4079
msgid ""
"The G_PRODUCT() function is the same as KPRODUCT. It is provided for "
"Gnumeric compatibility."
msgstr "G_PRODUCT() प्रकार्य KPRODUCT जस्तो छ । यो जिन्यूमेरिक मिल्नेमा उपलब्ध गरिन्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 494
#: xml_doc.cpp:4082
msgid "G_PRODUCT(value;value;...)"
msgstr "G_PRODUCT(मान;मान;...)"

#. i18n: tag Text
#. i18n: file functions/math.xml line 507
#: xml_doc.cpp:4088
msgid "The DIV() function divides the first value by the other values in turn."
msgstr "DIV() प्रकार्यमा पहिलो मानलाई अन्य मानले पालैपालो भाग गर्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 508
#: xml_doc.cpp:4091
msgid "DIV(value;value;...)"
msgstr "DIV(मान;मान;...)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 509
#: xml_doc.cpp:4094
msgid "DIV(20;2;2) returns 5"
msgstr "DIV(20;2;2) ले 5 फर्काउँछ"

#. i18n: tag Example
#. i18n: file functions/math.xml line 510
#: xml_doc.cpp:4097
msgid "DIV(25;2.5) returns 10"
msgstr "DIV(25;2.5) ले 10 फर्काउँछ"

#. i18n: tag Text
#. i18n: file functions/math.xml line 524
#: xml_doc.cpp:4103
msgid ""
"The SUMSQ() function calculates the sum of all the squares of values given "
"as parameters. You can calculate the sum of a range SUMSQ(A1:B5) or a list "
"of values like SUMSQ(12;5;12.5)."
msgstr ""
"SUMSQ() प्रकार्यले परिमितिको रुपमा दिएका सबै बर्ग मानको जोडको गणनागर्छ । तपाईँले SUMSQ"
"(A1:B5) वा SUMSQ(12;5;12.5) जस्ता मानको सूचीको दायराको गणना गर्न सक्नुहुन्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 525
#: xml_doc.cpp:4106
msgid "SUMSQ(value;value;...)"
msgstr "SUMSQ(मान;मान;...)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 526
#: xml_doc.cpp:4109
msgid "SUMSQ(12;5;7) equals 218"
msgstr "SUMSQ(12;5;7) बराबर 218"

#. i18n: tag Example
#. i18n: file functions/math.xml line 527
#: xml_doc.cpp:4112
msgid "SUMSQ(12.5;2) equals 173"
msgstr "SUMSQ(12.5;2) बराबर 173"

#. i18n: tag Text
#. i18n: file functions/math.xml line 541
#: xml_doc.cpp:4118
msgid ""
"The MAX() function returns the largest value given in the parameters. String "
"and logical values are ignored."
msgstr ""
"MAX() प्रकार्यले परिमितिमा दिएको सबै भन्दा ठूलो मान फर्काउँछ । स्ट्रिङ र लजिकल मान "
"उपेक्षा गरिने छ ।"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 542
#: xml_doc.cpp:4121
msgid "MAX(value;value;...)"
msgstr "MAX(मान;मान;...)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 543
#: xml_doc.cpp:4124
msgid "MAX(12;5; 7) returns 12"
msgstr "MAX(12;5; 7) ले 12 फर्काउँछ"

#. i18n: tag Example
#. i18n: file functions/math.xml line 544
#: xml_doc.cpp:4127
msgid "MAX(12.5; 2) returns 12.5"
msgstr "MAX(12.5; 2) ले 12.5 फर्काउँछ"

#. i18n: tag Example
#. i18n: file functions/math.xml line 545
#: xml_doc.cpp:4130
msgid "MAX(0.5; 0.4; TRUE; 0.2) returns 0.5"
msgstr "MAX(0.5; 0.4; TRUE; 0.2) ले 0.5 फर्काउँछ"

#. i18n: tag Text
#. i18n: file functions/math.xml line 562
#: xml_doc.cpp:4136
msgid ""
"The MAXA() function returns the largest value given in the parameters. TRUE "
"evaluates to 1, FALSE evaluates to 0. String values are ignored."
msgstr ""
"MAXA() प्रकार्यले परिमितिमा दिएको सबै भन्दा ठूलो मान फर्काउँछ । TRUE लाई 1 मूल्याङ्कन "
"गरिन्छ, FALSE लाई 0 मूल्याङ्कन गरिन्छ । स्ट्रिङ मान उपेक्षा गरिन्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 563
#: xml_doc.cpp:4139
msgid "MAXA(value;value;...)"
msgstr "MAXA(मान;मान;...)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 564
#: xml_doc.cpp:4142
msgid "MAXA(12;5; 7) returns 12"
msgstr "MAXA(12;5; 7) ले 12 फर्काउँछ"

#. i18n: tag Example
#. i18n: file functions/math.xml line 565
#: xml_doc.cpp:4145
msgid "MAXA(12.5; 2) returns 12.5"
msgstr "MAXA(12.5; 2) ले 12.5 फर्काउँछ"

#. i18n: tag Example
#. i18n: file functions/math.xml line 566
#: xml_doc.cpp:4148
msgid "MAXA(0.5; 0.4; TRUE; 0.2) returns 1"
msgstr "MAXA(0.5; 0.4; TRUE; 0.2) ले 1 फर्काउँछ"

#. i18n: tag Text
#. i18n: file functions/math.xml line 583
#: xml_doc.cpp:4154
msgid ""
"The MIN() function returns the smallest value given in the parameters. "
"String and logical values are ignored."
msgstr ""
"MIN()  प्रकार्यले परिमितिमा दिएको सबै भन्दा सानो मान फर्काउँछ । स्ट्रिङ र लजिकल मान "
"उपेक्षा गरिन्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 584
#: xml_doc.cpp:4157
msgid "MIN(value;value;...)"
msgstr "MIN(मान;मान;...)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 585
#: xml_doc.cpp:4160
msgid "MIN(12;5; 7) returns 5"
msgstr "MIN(12;5; 7) ले 5 फर्काउँछ"

#. i18n: tag Example
#. i18n: file functions/math.xml line 586
#: xml_doc.cpp:4163
msgid "MIN(12.5; 2) returns 2"
msgstr "MIN(12.5; 2) ले 2 फर्काउँछ"

#. i18n: tag Example
#. i18n: file functions/math.xml line 587
#: xml_doc.cpp:4166
msgid "MIN(0.4; 2; FALSE; 0.7) returns 0.4"
msgstr "MIN(0.4; 2; FALSE; 0.7) ले 0.4 फर्काउँछ"

#. i18n: tag Text
#. i18n: file functions/math.xml line 604
#: xml_doc.cpp:4172
msgid ""
"The MINA() function returns the smallest value given in the parameters. TRUE "
"evaluates to 1, FALSE to 0. String values are ignored."
msgstr ""
"MINA() प्रकार्यले परिमितिमा दिएको सबै भन्दा सानो मान फर्काउँछ । TRUE लाई 1 मूल्याङ्कन "
"गरिन्छ, FALSE लाई 0 मूल्याङ्कन गरिन्छ । स्ट्रिङ मान उपेक्षा गरिन्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 605
#: xml_doc.cpp:4175
msgid "MINA(value;value;...)"
msgstr "MINA(मान;मान;...)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 606
#: xml_doc.cpp:4178
msgid "MINA(12;5; 7) returns 5"
msgstr "MINA(12;5; 7) ले 5 फर्काउँछ"

#. i18n: tag Example
#. i18n: file functions/math.xml line 607
#: xml_doc.cpp:4181
msgid "MINA(12.5; 2) returns 2"
msgstr "MINA(12.5; 2) ले 2 फर्काउँछ"

#. i18n: tag Example
#. i18n: file functions/math.xml line 608
#: xml_doc.cpp:4184
msgid "MINA(0.4; 2; FALSE; 0.7) returns 0."
msgstr "MINA(0.4; 2; FALSE; 0.7) ले 0 फर्काउँछ"

#. i18n: tag Text
#. i18n: file functions/math.xml line 625
#: xml_doc.cpp:4190
msgid ""
"The MULTIPLY() function multiplies all the values given in the parameters. "
"You can multiply values given by a range MULTIPLY(A1:B5) or a list of values "
"like MULTIPLY(12;5;12.5). It's equivalent to PRODUCT."
msgstr ""
"MULTIPLY() परिमितिमा दिएका सबै मानको गुणा गर्छ । तपाईँले MULTIPLY(A1:B5) वा "
"MULTIPLY(12;5;12.5) जस्ता मानका दायरा अनुरुप दिएका मानको गुणा गर्न सक्नुहुन्छ । यो "
"PRODUCT समतुल्य हुन्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 626
#: xml_doc.cpp:4193
msgid "MULTIPLY(value;value;...)"
msgstr "MULTIPLY(मान;मान;...)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 627
#: xml_doc.cpp:4196
msgid "MULTIPLY(12;5;7) equals 420"
msgstr "MULTIPLY(12;5;7) बराबर 420"

#. i18n: tag Example
#. i18n: file functions/math.xml line 628
#: xml_doc.cpp:4199
msgid "MULTIPLY(12.5;2) equals 25"
msgstr "MULTIPLY(12.5;2) बराबर 25"

#. i18n: tag Text
#. i18n: file functions/math.xml line 643
#: xml_doc.cpp:4205
msgid ""
"The MULTINOMIAL() function returns the multinomial of each number in the "
"parameters. It uses this formula for MULTINOMIAL(a,b,c):"
msgstr ""
"MULTINOMIAL() प्रकार्यले परिमितिका प्रत्येक नम्बरका मल्टिनोमिनल फर्काउँछ । MULTINOMIAL"
"(a,b,c) का लागि यो सूत्र प्रयोग गरिन्छ:"

#. i18n: tag Text
#. i18n: file functions/math.xml line 644
#: xml_doc.cpp:4208
msgid "(a+b+c)! / a!b!c!"
msgstr "(a+b+c)! / a!b!c!"

#. i18n: tag Syntax
#. i18n: file functions/math.xml line 645
#: xml_doc.cpp:4211
msgid "MULTINOMIAL(value;value;...)"
msgstr "MULTINOMIAL(मान;मान;...)"

#. i18n: tag Example
#. i18n: file functions/math.xml line 646
#: xml_doc.cpp:4214
msgid "MULTINOMIAL(3;4;5) equals 27720"
msgstr "MULTINOMIAL(3;4;5) बराबर 27720"

#. i18n: tag Text
#. i18n: file functions/math.xml line 658
#: xml_doc.cpp:4220
#, fuzzy
#| msgid ""
#| "The SQRT() function returns the non-negative square root of x. If x is "
#| "negative, \"NaN\" is returned."
msgid ""
"The SQRT() function returns the non-negative square root of the argument. It "
"is an error if the argument is negative."
msgstr ""
"SQRT() प्रकार्यले x का ऋणात्मक नभएका बर्गमूल फर्काउँछ । यदि x ऋणात्मक भएमा, \"NaN\" "
"फर्किन्छ ।"

