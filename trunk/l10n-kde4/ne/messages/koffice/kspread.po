#: xml_doc.cpp:1215
msgid ""
"The BASE() function converts a number from base-10 to a string value in a "
"target base from 2 to 36."
msgstr ""
"BASE() प्रकार्यले लक्ष्य आधार 2 देखि 36 सम्मको मानमा आधार 10 देखि स्ट्रिङ सम्म नम्बर "
"रुपान्तरण गर्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 24
#: xml_doc.cpp:1218
msgid "BASE(number;base;prec)"
msgstr "BASE(नम्बर;आधार;prec)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 25
#: xml_doc.cpp:1221
msgid "BASE(128;8) returns \"200\""
msgstr "BASE(128;8) ले \"200\" फर्काउँछ"

