#: xml_doc.cpp:3437
msgid "TYPE(A1) returns 2, if A1 contains \"Text\""
msgstr "TYPE(A1) ले यदि A1 ले \"पाठ\" समावेश गरेमा, 2 फर्काउँछ"

#. i18n: tag Example
#. i18n: file functions/information.xml line 302
#: xml_doc.cpp:3440
msgid "TYPE(-7) returns 1"
msgstr "TYPE(-7) ले 1 फर्काउँछ"

#. i18n: tag Example
