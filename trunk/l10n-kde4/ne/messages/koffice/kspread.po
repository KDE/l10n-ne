#. i18n: tag Example
#. i18n: file functions/engineering.xml line 201
#: xml_doc.cpp:1386
msgid "DEC2BIN(12) returns \"1100\""
msgstr "DEC2BIN(12) \"1100\" फर्काउँछ"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 202
#: xml_doc.cpp:1389
msgid "DEC2BIN(55) returns \"110111\""
msgstr "DEC2BIN(55) \"110111\" फर्काउँछ"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 218
#: xml_doc.cpp:1398
msgid ""
"The DEC2HEX() function returns the value formatted as a hexadecimal number."
msgstr "DEC2HEX() प्रकार्यले हेक्सा छदशमलवका रुपमा ढाँचाबद्ध गरिएका मान फर्काउँछ ।"

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 219
#: xml_doc.cpp:1401
msgid "DEC2HEX(value)"
msgstr "DEC2HEX(मान)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 220
#: xml_doc.cpp:1404
msgid "DEC2HEX(12) returns \"c\""
msgstr "DEC2HEX(12) \"c\" फर्काउँछ"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 221
#: xml_doc.cpp:1407
msgid "DEC2HEX(55) returns \"37\""
msgstr "DEC2HEX(55) \"37\" फर्काउँछ"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 237
#: xml_doc.cpp:1416
msgid "The DEC2OCT() function returns the value formatted as an octal number."
msgstr "DEC2OCT() प्रकार्यले ओक्टल नम्बरका रुपमा ढाँचाबद्ध मान फर्काउँछ ।"

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 238
#: xml_doc.cpp:1419
msgid "DEC2OCT(value)"
msgstr "DEC2OCT(मान)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 239
#: xml_doc.cpp:1422
msgid "DEC2OCT(12) returns \"14\""
msgstr "DEC2OCT(12) \"14\" फर्काउँछ"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 240
#: xml_doc.cpp:1425
msgid "DEC2OCT(55) returns \"67\""
msgstr "DEC2OCT(55) \"67\" फर्काउँछ"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 256
#: xml_doc.cpp:1434
msgid "The OCT2BIN() function returns the value formatted as a binary number."
msgstr "OCT2BIN() प्रकार्यले बाइनरी नम्बरका रुपमा ढाँचाबद्ध मान फर्काउँछ ।"

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 257
#: xml_doc.cpp:1437
msgid "OCT2BIN(value)"
msgstr "OCT2BIN(मान)"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 258
#: xml_doc.cpp:1440
msgid "OCT2BIN(\"12\") returns \"1010\""
msgstr "OCT2BIN(\"12\") \"1010\" फर्काउँछ"

#. i18n: tag Example
#. i18n: file functions/engineering.xml line 259
#: xml_doc.cpp:1443
msgid "OCT2BIN(\"55\") returns \"101101\""
msgstr "OCT2BIN(\"55\") \"101101\" फर्काउँछ"

#. i18n: tag Text
#. i18n: file functions/engineering.xml line 271
