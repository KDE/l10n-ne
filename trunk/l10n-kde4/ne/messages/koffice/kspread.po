msgstr ""
"पानाको पहिलो स्तम्भ पूर्वनिर्धारित रुपमा बायाँ तिर हुन्छ । यदि तपाईँले दायाँदेखि बायाँ "
"रोजेमा, पहिलो स्तम्भ दायाँ हुनेछ र अन्य दायाँ देखि बायाँ तिर थपिनेछ ।"

#. i18n: tag string
#. i18n: file dialogs/SheetPropertiesWidget.ui line 61
#: rc.cpp:432 dialogs/SheetProperties.cpp:70 dialogs/SheetProperties.cpp:86
#: dialogs/SheetPropertiesDialog.cpp:71
msgid "Left to Right"
msgstr "बायाँदेखि दायाँसम्म"

#. i18n: tag string
#. i18n: file dialogs/SheetPropertiesWidget.ui line 66
#: rc.cpp:435 dialogs/SheetProperties.cpp:73 dialogs/SheetProperties.cpp:89
#: dialogs/SheetPropertiesDialog.cpp:74
msgid "Right to Left"
msgstr "दायाँदेखि बायाँसम्म"

#. i18n: tag string
