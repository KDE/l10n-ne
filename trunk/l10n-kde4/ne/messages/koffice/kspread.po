#. i18n: file functions/information.xml line 32
#: xml_doc.cpp:3200
msgid "N(3.14) returns 3.14"
msgstr "N(3.14) ले 3.14 फर्काउँछ"

#. i18n: tag Example
#. i18n: file functions/information.xml line 33
#: xml_doc.cpp:3203
msgid "N(\"7\") returns 0 (because \"7\" is text)"
msgstr "N(\"7\") ले 0 फर्काउँछ (किनभने \"7\" पाठ हो)"

#. i18n: tag Comment
