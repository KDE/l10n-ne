#. i18n: tag Text
#. i18n: file functions/statistical.xml line 562
#: xml_doc.cpp:5495
msgid ""
"The KURT() function calculates an unbiased estimate of the kurtosis of a "
"data set. You have to provide at least 4 values, otherwise an error is "
"returned."
msgstr ""
"KURT() प्रकार्यले डेटा सेटको कुर्टोसिसको निष्पक्ष अनुमान गणना गर्छ । तपाईँले कम्तिमा 4 मान "
"उपलब्ध गराउनु पर्छ, अन्यथा एउटा त्रुटि फर्किन्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 563
#: xml_doc.cpp:5498
msgid "KURT(value; value;...)"
msgstr "KURT(मान; मान;...)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 564
#: xml_doc.cpp:5501
msgid "KURT(A1:A5)"
msgstr "KURT(A1:A5)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 565
#: xml_doc.cpp:5504
msgid "KURT(21; 33; 54; 23) returns 1.344239"
msgstr "KURT(21; 33; 54; 23) ले 1.344239 फर्काउँछ"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 594
#: xml_doc.cpp:5522
msgid ""
"The KURTP() function calculates an population kurtosis of a data set. You "
"have to provide at least 4 values, otherwise an error is returned."
msgstr ""
"KURTP() प्रकार्यले डेटा सेटको कूल सङ्ख्या कुर्टोसिस गणना गर्छ । तपाईँले कम्तिमा 4 मान "
"उपलब्ध गराउनु पर्छ, अन्यथा एउटा त्रुटि फर्किन्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 595
#: xml_doc.cpp:5525
msgid "KURTP(value; value;...)"
msgstr "KURTP(मान;मान;...)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 596
#: xml_doc.cpp:5528
msgid "KURTP(A1:A5)"
msgstr "KURTP(A1:A5)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 597
#: xml_doc.cpp:5531
msgid "KURTP(21; 33; 54; 23) returns -1.021"
msgstr "KURTP(21; 33; 54; 23) ले -1.021 फर्काउँछ"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 610
#: xml_doc.cpp:5537
msgid "Position (from the largest)"
msgstr "स्थिति (सबै भन्दा ठूलोबाट)"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 614
#: xml_doc.cpp:5540
msgid "The LARGE() function returns the k-th largest value from the data set."
msgstr "LARGE() प्रकार्यले डेटा सेटबाट k-th सबै भन्दा ठूलो मान फर्काउँछ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 615
#: xml_doc.cpp:5543
msgid "LARGE(range; k)"
msgstr "LARGE(दायरा; k)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 616
#: xml_doc.cpp:5546
msgid "A1: 3, A2: 1, A3: 5 => LARGE(A1:A3; 2) returns 3"
msgstr "A1: 3, A2: 1, A3: 5 => LARGE(A1:A3; 2) ले 3 फर्काउँछ"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 624
#: xml_doc.cpp:5549
msgid "Probability"
msgstr "सम्भाव्यता"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 628
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 650
#: xml_doc.cpp:5552 xml_doc.cpp:5570
msgid "Mean value of the standard logarithmic distribution"
msgstr "स्ट्यान्डर्ड लघुगणकिय वितरणको मध्यक मान"

