#: xml_doc.cpp:1380
msgid "The DEC2BIN() function returns the value formatted as a binary number."
msgstr "DEC2BIN() प्राकार्यले बाइनरी नम्बरका रुपमा ढाँचाबद्ध गरिएका मान फर्काउँछ ।"

#. i18n: tag Syntax
#. i18n: file functions/engineering.xml line 200
#: xml_doc.cpp:1383
