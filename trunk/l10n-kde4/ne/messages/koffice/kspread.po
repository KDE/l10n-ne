#. i18n: tag Text
#. i18n: file functions/statistical.xml line 344
#: xml_doc.cpp:5305
msgid ""
"The FISHER() function returns the Fisher transformation for x and creates a "
"function close to a normal distribution."
msgstr ""
"FISHER() प्रकार्यले x का लागि फिसर रुपान्तरण फर्काउँछ र सामान्य वितरणमा बन्द गर्न "
"प्रकार्य सिर्जना गर्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 345
#: xml_doc.cpp:5308
msgid "FISHER(number)"
msgstr "FISHER(नम्बर)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 346
#: xml_doc.cpp:5311
msgid "FISHER(0.2859) equals 0.294096"
msgstr "FISHER(0.2859) बराबर 0.294096"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 347
#: xml_doc.cpp:5314
msgid "FISHER(0.8105) equals 1.128485"
msgstr "FISHER(0.8105) बराबर 1.128485"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 359
#: xml_doc.cpp:5320
msgid ""
"The FISHERINV() function returns the inverse of the Fisher transformation "
"for x and creates a function close to a normal distribution."
msgstr ""
"FISHERINV() प्रकार्यले x का लागि फिसर रुपान्तरणको उल्टो फर्काउँछ र सामान्य वितरणमा "
"बन्द गर्न प्रकार्य सिर्जना गर्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 360
#: xml_doc.cpp:5323
msgid "FISHERINV(number)"
msgstr "FISHERINV(नम्बर)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 361
#: xml_doc.cpp:5326
msgid "FISHERINV(0.2859) equals 0.278357"
msgstr "FISHERINV(0.2859) बराबर 0.278357"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 362
#: xml_doc.cpp:5329
msgid "FISHERINV(0.8105) equals 0.669866"
msgstr "FISHERINV(0.8105) बराबर 0.669866"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 370
#: xml_doc.cpp:5332
