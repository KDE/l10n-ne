msgid ""
"The COMBINA() function calculates the count of possible combinations. The "
"first parameter is the total count of elements. The second parameter is the "
"count of elements to choose. Both parameters should be positive and the "
"first parameter should not be less than the second. Otherwise the function "
"returns an error."
msgstr ""
"COMBIN() प्रकार्यले सम्भावित संयोजनको गणना गर्छ । पहिलो परिमिति सम्पूर्ण तत्वको गणना "
"हो । दोस्रो परिमिति रोज्नु पर्ने तत्वको गणना हो । दुवै परिमिति धनात्मक हुनुपर्छ र पहिलो "
"परिमिति दोस्रो भन्दा सानो हुनु हुदैँन । अन्यथा प्रकार्यले त्रुटि फर्काउँछ ।"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 180
#: xml_doc.cpp:5161
msgid "Level of the confidence interval"
msgstr "यकीन अन्तरालको स्तर"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 184
#: xml_doc.cpp:5164
msgid "Standard deviation for the total population"
msgstr "कूल सङ्ख्याका लागि स्ट्यान्डर्ड डेभिएसन"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 188
#: xml_doc.cpp:5167
msgid "Size of the total population"
msgstr "कूल सङ्ख्याको साइज"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 192
#: xml_doc.cpp:5170
msgid ""
"The CONFIDENCE() function returns the confidence interval for a population "
"mean."
msgstr "CONFIDENCE() प्रकार्यले कूल सङ्ख्याको मध्यकका लागि यकीन अन्तराल फर्काउँछ ।"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 193
#: xml_doc.cpp:5173
msgid ""
"The alpha parameter must be between 0 and 1 (non-inclusive), stddev must be "
"positive and size must be greater or equal to 1."
msgstr ""
"अल्फा परिमिति 0 र 1 बीचमा (सम्मिलित नहुने) हुनुपर्छ, stddev धनात्मक हुनुपर्छ र साइज 1 "
"भन्दा ठूलो वा बराबर हुनुपर्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 194
#: xml_doc.cpp:5176
msgid "CONFIDENCE(alpha;stddev;size)"
msgstr "CONFIDENCE(अल्फा;stddev;साइज)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 195
#: xml_doc.cpp:5179
msgid "CONFIDENCE(0.05;1.5;100) equals 0.294059"
msgstr "CONFIDENCE(0.05;1.5;100) बराबर 0.294059"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 203
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 222
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 606
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 829
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 979
#: xml_doc.cpp:5182 xml_doc.cpp:5197 xml_doc.cpp:5534 xml_doc.cpp:5732
#: xml_doc.cpp:5864
msgid "Cell range of values"
msgstr "मानका कक्ष दायरा"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 207
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 226
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 833
#: xml_doc.cpp:5185 xml_doc.cpp:5200 xml_doc.cpp:5735
msgid "Second cell range of values"
msgstr "मानका दोस्रो कक्ष दायरा"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 211
#: xml_doc.cpp:5188
msgid ""
"The CORREL() function calculates the correlation coefficient of two cell "
"ranges."
msgstr "CORREL() प्रकार्यले दुइ कक्ष दायराको कोरिलेसन कोफिसियन्ट गणना गर्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 212
#: xml_doc.cpp:5191
msgid "CORREL(range1; range2)"
msgstr "CORREL(दायरा 1; दायरा 2)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 213
#: xml_doc.cpp:5194
msgid "CORREL(A1:A3; B1:B3)"
msgstr "CORREL(A1:A3; B1:B3)"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 230
#: xml_doc.cpp:5203
msgid "The COVAR() function calculates the covariance of two cell ranges."
msgstr "COVAR() प्रकार्यले दुइ कक्ष दायराको कोभ्यारियन्स गणना गर्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 231
#: xml_doc.cpp:5206
msgid "COVAR(range1; range2)"
msgstr "COVAR(दायरा 1; दायरा 2)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 232
#: xml_doc.cpp:5209
msgid "COVAR(A1:A3; B1:B3)"
msgstr "COVAR(A1:A3; B1:B3)"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 260
#: xml_doc.cpp:5227
msgid "The DEVSQ() function calculates the sum of squares of deviations."
msgstr "DEVSQ() प्रकार्यले विचलनको बर्गको जोड गणना गर्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 261
#: xml_doc.cpp:5230
msgid "DEVSQ(value; value;...)"
msgstr "DEVSQ(मान;मान;...)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 262
#: xml_doc.cpp:5233
msgid "DEVSQ(A1:A5)"
msgstr "DEVSQ(A1:A5)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 263
#: xml_doc.cpp:5236
msgid "DEVSQ(21; 33; 54; 23) returns 684.75"
msgstr "DEVSQ(21; 33; 54; 23) ले 684.75 फर्काउँछ"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 275
#: xml_doc.cpp:5242
msgid "Lambda parameter"
msgstr "ल्याम्ब्डा परिमिति"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 279
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 760
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 889
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 1462
#: xml_doc.cpp:5245 xml_doc.cpp:5663 xml_doc.cpp:5783 xml_doc.cpp:6257
msgid "0 = density, 1 = distribution"
msgstr "0 = घनत्व, 1 = वितरण"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 283
#: xml_doc.cpp:5248
msgid "The EXPONDIST() function returns the exponential distribution."
msgstr "EXPONDIST() प्रकार्यले घाताङ्क वितरण फर्काउँछ ।"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 284
#: xml_doc.cpp:5251
msgid "The lambda parameter must be positive."
msgstr "ल्याम्ब्डा परिमिति धनात्मक हुनुपर्छ ।"

#. i18n: tag Text
#. i18n: file functions/statistical.xml line 285
#. i18n: tag Text
#. i18n: file functions/statistical.xml line 895
#. i18n: tag Text
#. i18n: file functions/statistical.xml line 1468
#: xml_doc.cpp:5254 xml_doc.cpp:5792 xml_doc.cpp:6266
msgid ""
"Cumulative = 0 calculates the density function; cumulative = 1 calculates "
"the distribution."
msgstr "क्युमुलेटिभ = 0 ले प्रकार्यको घनत्व गणना गर्छ; क्युमुलेटिभ = 1 ले वितरण गणना गर्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/statistical.xml line 286
#: xml_doc.cpp:5257
msgid "EXPONDIST(number;lambda;cumulative)"
msgstr "EXPONDIST(नम्बर;ल्याम्ब्डा;क्युमुलेटिभ)"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 287
#: xml_doc.cpp:5260
msgid "EXPONDIST(3;0.5;0) equals 0.111565"
msgstr "EXPONDIST(3;0.5;0) बराबर 0.111565"

#. i18n: tag Example
#. i18n: file functions/statistical.xml line 288
#: xml_doc.cpp:5263
msgid "EXPONDIST(3;0.5;1) equals 0.776870"
msgstr "EXPONDIST(3;0.5;1) बराबर 0.776870"

#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 300
#. i18n: tag Comment
#. i18n: file functions/statistical.xml line 322
#: xml_doc.cpp:5269 xml_doc.cpp:5287
