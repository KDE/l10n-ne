msgid "ATAN(0.8) equals 0.67474094"
msgstr "ATAN(0.8) बराबर 0.67474094"

#. i18n: tag Example
#. i18n: file functions/trig.xml line 114
#: xml_doc.cpp:7058
msgid "ATAN(0) equals 0"
msgstr "ATAN(0) बराबर 0"

#. i18n: tag Text
#. i18n: file functions/trig.xml line 128
#: xml_doc.cpp:7064
msgid ""
"The COSH() function returns the hyperbolic cosine of x, which is defined "
"mathematically as (exp(x) + exp(-x)) / 2."
msgstr ""
"COSH() प्रकार्यले x को हाइपरबोलिक कोसाइन फर्काउँछ, जुन गणितिय रुपमा (exp(x) + exp(-"
"x)) / 2 अनुरुप परिभाषित हुन्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/trig.xml line 129
#: xml_doc.cpp:7067
msgid "COSH(Float)"
msgstr "COSH(उत्प्लावन)"

#. i18n: tag Example
#. i18n: file functions/trig.xml line 130
#: xml_doc.cpp:7070
msgid "COSH(0.8) equals 1.33743495"
msgstr "COSH(0.8) बराबर 1.33743495"

#. i18n: tag Example
#. i18n: file functions/trig.xml line 131
#: xml_doc.cpp:7073
msgid "COSH(0) equals 1"
msgstr "COSH(0) बराबर 1"

#. i18n: tag Text
#. i18n: file functions/trig.xml line 144
#: xml_doc.cpp:7079
msgid ""
"The SINH() function returns the hyperbolic sine of x, which is defined "
"mathematically as (exp(x) - exp(-x)) / 2."
msgstr ""
"SINH() प्रकार्यले x को हाइपरबोलिक साइन फर्काउँछ, जुन गणितिय रुपमा (exp(x) - exp(-"
"x)) / 2 अनुरुप परिभाषित हुनेछ ।"

#. i18n: tag Syntax
#. i18n: file functions/trig.xml line 145
#: xml_doc.cpp:7082
msgid "SINH(Float)"
msgstr "SINH(उत्प्लावन)"

#. i18n: tag Example
#. i18n: file functions/trig.xml line 146
#: xml_doc.cpp:7085
msgid "SINH(0.8) equals 0.88810598"
msgstr "SINH(0.8) बराबर 0.88810598"

#. i18n: tag Example
#. i18n: file functions/trig.xml line 147
#: xml_doc.cpp:7088
msgid "SINH(0) equals 0"
msgstr "SINH(0) बराबर 0"

#. i18n: tag Text
#. i18n: file functions/trig.xml line 160
#: xml_doc.cpp:7094
msgid ""
"The TANH() function returns the hyperbolic tangent of x, which is defined "
"mathematically as sinh(x)/cosh(x)."
msgstr ""
"TANH() प्रकार्यले x को हाइपरबोलिक ट्यान्जेन्ट फर्काउँछ, जुन गणितिय रुपमा sinh(x)/cosh"
"(x) अनुरुप परिभाषित हुन्छ ।"

#. i18n: tag Syntax
#. i18n: file functions/trig.xml line 161
#: xml_doc.cpp:7097
msgid "TANH(Float)"
msgstr "TANH(उत्प्लावन)"

