msgstr "POWER(1.2;3.4) बराबर 1.8572"

#. i18n: tag Example
#. i18n: file functions/math.xml line 141
#: xml_doc.cpp:3770
msgid "POWER(2;3) equals 8"
msgstr "POWER(2;3) बराबर 8"

#. i18n: tag Text
