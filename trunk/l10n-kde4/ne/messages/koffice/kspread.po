#: xml_doc.cpp:3443
msgid "TYPE(A2) returns 1, if A2 contains \"=CURRENTDATE()\""
msgstr "यदि A2 ले \"=CURRENTDATE()\" समावेश गरेमा TYPE(A2) ले 1 फर्काउँछ"

