msgstr ""
"यो बटन क्लिक गरेर तपाईँ समाप्ति सूचीमा एउटा वैयक्तिक शब्द म्यानुअल तरिकाले थप्न सक्नुहुन्छ।"

#. i18n: tag string
#. i18n: file ./kotext/KoCompletionBase.ui line 59
#: rc.cpp:195
msgid ""
"To remove words from the completion list, select the word with the left "
"mouse button from the list, then click this button."
msgstr ""
"समाप्ति सूचीबाट शब्दहरू हटाउन, सूचीबाट बायाँ माउस बटन भएको शब्द चयन गर्नुहोस्, त्यसपछि "
"यो बटन क्लिक गर्नुहोस् ।"

#. i18n: tag string
#. i18n: file ./kotext/KoCompletionBase.ui line 86
#: rc.cpp:198
msgid "Automatically add new words to suggestion list"
msgstr "सुझाव सूचीमा स्वचालित रूपमा नयाँ शब्दहरू थप्नुहोस्"

#. i18n: tag string
#. i18n: file ./kotext/KoCompletionBase.ui line 89
#: rc.cpp:201
msgid ""
"If this option is enabled, any word equal to or longer than the \"Characters "
"needed\" typed in this document will automatically be added to the list of "
"words used by the completion."
msgstr ""
"यदि यो विकल्प सक्षम पारियो भने, यो कागजातमा \"आवश्यक क्यारेक्टर\" भन्दा लामो वा "
"बराबरी टाइप गरिएको कुनै शब्द स्वचालित रूपमा समाप्तिद्वारा प्रयोग गरिएको शब्दको सूचीमा "
"थपिनेछ ।"

#. i18n: tag string
#. i18n: file ./kotext/KoCompletionBase.ui line 96
#: rc.cpp:204
msgid "Completion Options"
msgstr "समाप्ति विकल्प"

#. i18n: tag string
#. i18n: file ./kotext/KoCompletionBase.ui line 105
#: rc.cpp:207
msgid "Show words in tooltip"
