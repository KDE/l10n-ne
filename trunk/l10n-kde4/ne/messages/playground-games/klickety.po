#: field.cpp:21
msgid "Remaining blocks"
msgstr "बाँकी खण्ड"

#: field.cpp:24
msgid ""
"<qt>Display the number of remaining blocks.<br/>It turns <font color=\"blue"
"\">blue</font> if it is a highscore and <font color=\"red\">red</font> if it "
"is the best local score.</qt>"
msgstr ""
"<qt>बाकी खण्डको सङ्ख्या प्रर्दशन गर्नुहोस् ।<br/>यदि यो सबैभन्दा राम्रो प्राप्ताङ्क भएमा "
"<font color=\"blue\">निलो </font> हुन्छ र यदि उच्च प्राप्ताङ्क भएमा <font color="
"\"red\">रातो</font> हुन्छ ।</qt>"

