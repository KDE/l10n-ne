#: engines/fibs/kbgfibs.cpp:212
#, kde-format
msgid "FIBS backgammon engine"
msgstr "FIBS ब्याकगामोन इन्जिन"

#: engines/fibs/kbgfibs.cpp:213
#, kde-format
msgid "FIBS Engine"
msgstr "FIBS इन्जिन"

#: engines/fibs/kbgfibs.cpp:233 kbgboard.cpp:173
#, kde-format
msgid "Options"
msgstr "विकल्प"

#: engines/fibs/kbgfibs.cpp:234
#, kde-format
msgid "Automatic Messages"
msgstr "स्वचालित सन्देश"

#: engines/fibs/kbgfibs.cpp:242
#, kde-format
msgid "Show copy of personal messages in main window"
msgstr "मुख्य सञ्झ्यालमा निजी सन्देशको प्रति देखाउनुहोस्"

#: engines/fibs/kbgfibs.cpp:243
#, kde-format
msgid "Automatically request player info on invitation"
msgstr "निमन्त्रणामा खेलाडी जानकारी स्वचालित रुपमा अनुरोध गर्नुहोस्"

#: engines/fibs/kbgfibs.cpp:245
#, kde-format
msgid ""
"Usually, all messages sent directly to you by other players are displayed "
"only in the chat window. Check this box if you would like to get a copy of "
"these messages in the main window."
msgstr ""
"सधैँ, अन्य खेलाडीले प्रत्यक्ष रुपमा तपाईँलाई पठाएका सबै सन्देश केबल कुराकानी सञ्झ्यालमा मात्र "
"प्रर्दशन गरिन्छ । यदि तपाईँले ति सन्देशका प्रति मुख्य सञ्झ्यालमा प्राप्त गर्न चाहनुहुन्छ भने यो "
"बाकस चिनो लगाउनुहोस् ।"

#: engines/fibs/kbgfibs.cpp:248
#, kde-format
msgid ""
"Check this box if you would like to receive information on players that "
"invite you to games."
msgstr ""
"यदि तपाईँले खेलमा निमन्त्रणा दिएका खेलाडीको बारेमा जानकारी प्राप्त गर्न चाहनुहुन्छ भने यो "
"बाकस चिनो लगाउनुहोस् ।"

#: engines/fibs/kbgfibs.cpp:265
#, kde-format
msgid "Start match:"
msgstr "खेल सुरु गर्नुहोस्:"

#: engines/fibs/kbgfibs.cpp:266
#, kde-format
msgid "Win match:"
msgstr "खेल जित्नुभयो:"

#: engines/fibs/kbgfibs.cpp:267
#, kde-format
msgid "Lose match:"
msgstr "खेल हार्नुभयो:"

#: engines/fibs/kbgfibs.cpp:269
#, kde-format
msgid ""
"If you want to send a standard greeting to your opponent whenever you start "
"a new match, check this box and write the message into the entry field."
msgstr ""
"तपाईँले नयाँ खेल सुरु गर्नु भएको बेलामा विपक्षीलाई राम्रो अभिवादन पठाउन चाहनुहुन्छ भने यो "
"बाकस चिनो लगाउनुहोस् र प्रविष्टि फिल्डमा सन्देश लेख्नुहोस् ।"

#: engines/fibs/kbgfibs.cpp:273
#, kde-format
msgid ""
"If you want to send a standard message to your opponent whenever you won a "
"match, check this box and write the message into the entry field."
msgstr ""
"तपाईँले खेल जितेको बेलामा विपक्षीलाई राम्रो अभिवादन पठाउन चाहनुहुन्छ भने यो बाकस चिनो "
"लगाउनुहोस् र प्रविष्टि फिल्डमा सन्देश लेख्नुहोस् ।"

#: engines/fibs/kbgfibs.cpp:276
#, kde-format
msgid ""
"If you want to send a standard message to your opponent whenever you lost a "
"match, check this box and write the message into the entry field."
msgstr ""
"तपाईँले खेल हारेको बेलामा विपक्षीलाई राम्रो अभिवादन पठाउन चाहनुहुन्छ भने यो बाकस चिनो "
"लगाउनुहोस् र प्रविष्टि फिल्डमा सन्देश लेख्नुहोस् ।"

#: engines/fibs/kbgfibs.cpp:297
#, kde-format
msgid "&Local"
msgstr "स्थानीय"

#: engines/fibs/kbgfibs.cpp:307
#, kde-format
msgid "Server"
msgstr "सर्भर"

#: engines/fibs/kbgfibs.cpp:308
#, kde-format
msgid "Other"
msgstr "अन्य"

#: engines/fibs/kbgfibs.cpp:321
#, kde-format
msgid "Server name:"
msgstr "सर्भर नाम:"

#: engines/fibs/kbgfibs.cpp:322
#, kde-format
msgid "Server port:"
msgstr "सर्भर पोर्ट:"

#: engines/fibs/kbgfibs.cpp:323
#, kde-format
msgid "User name:"
msgstr "प्रयोगकर्ता नाम:"

#: engines/fibs/kbgfibs.cpp:324
#, kde-format
msgid "Password:"
msgstr "पासवर्ड:"

#: engines/fibs/kbgfibs.cpp:333
#, kde-format
msgid ""
"Enter here the host name of FIBS. With almost absolute certainty this should "
"be \"fibs.com\". If you leave this blank, you will be asked again at "
"connection time."
msgstr ""
"FIBS को पोर्ट नम्बर यहाँ प्रविष्ट गर्नुहोस् । प्राय निश्चित यकीनमा यो \"fibs.com\" हुनेछ "
"। यदि तपाईँले यसलाई खाली छोड्नु भएमा, तपाईँलाई जडान समयमा फेरि सोधिनेछ ।"

#: engines/fibs/kbgfibs.cpp:337
#, kde-format
msgid ""
"Enter here the port number of FIBS. With almost absolute certainty this "
"should be \"4321\". If you leave this blank, you will be asked again at "
"connection time."
msgstr ""
"FIBS को पोर्ट नम्बर यहाँ प्रविष्ट गर्नुहोस् । प्राय निश्चित यकीनमा यो \"4321\" हुनेछ । "
"यदि तपाईँले यसलाई खाली छोड्नु भएमा, तपाईँलाई जडान समयमा फेरि सोधिनेछ ।"

#: engines/fibs/kbgfibs.cpp:341
#, kde-format
msgid ""
"Enter your login on FIBS here. If you do not have a login yet, you should "
"first create an account using the corresponding menu entry. If you leave "
"this blank, you will be asked again at connection time."
msgstr ""
"तपाईँले यहाँ लगइन FIBS मा प्रविष्ट गर्नुहोस् । यदि तपाईँको अहिलेसम्म लगइन छैन भने, तपाईँले "
"पहिला सङ्गत मेनु प्रविष्टिको प्रयोग गरेर एउटा खाता सिर्जना गर्नु पर्दछ । तपाईँले यसलाई "
"खाली छोड्नु भएमा, जडान गर्ने समयमा फेरि सोधिनेछ ।"

#: engines/fibs/kbgfibs.cpp:345
#, kde-format
msgid ""
"Enter your password on FIBS here. If you do not have a login yet, you should "
"first create an account using the corresponding menu entry. If you leave "
"this blank, you will be asked again at connection time. The password will "
"not be visible."
msgstr ""
"तपाईँको पासवर्ड FIBS मा प्रविष्ट गर्नुहोस् । यदि तपाईँसँग अझ सम्म पनि लगइन छैन भने, "
"तपाईँले पहिला सङ्गत मेनु प्रविष्टिको प्रयोग गरेर एउटा खाता सिर्जना गर्नु पर्दछ । यदि "
"तपाईँले यसलाई खाली छोड्नु भएमा, जडान गर्ने समयमा फेरि सोधिनेछ । पासवर्ड दृश्यात्मक हुने छैन "
"।"

#: engines/fibs/kbgfibs.cpp:354
#, kde-format
msgid "Keep connections alive"
msgstr "जडानलाई चालु राख्नुहोस्"

#: engines/fibs/kbgfibs.cpp:356
#, kde-format
msgid ""
"Usually, FIBS drops the connection after one hour of inactivity. When you "
"check this box, %1 will try to keep the connection alive, even if you are "
"not actually playing or chatting. Use this with caution if you do not have "
"flat-rate Internet access."
msgstr ""
"सामान्यतया, FIBS ले एक घन्टाको निस्क्रियता पछि जडान छोड्दछ । जब तपाईँले यो बाकस चिनो "
"गर्नुहुन्छ, तपाईँले वास्तवमा नै खेल्नु भएको वा कुराकानी गर्नु भएको छैन भने पनि %1 ले जडान "
"जीवन्त गर्ने प्रयास गर्दछ । यदि तपाईँसँग फ्याल्ट दरको इन्टरनेट पहुँच छैन भने सावधानीपूर्वक "
"यसको प्रयोग गर्नुहोस् ।"

#: engines/fibs/kbgfibs.cpp:371
#, kde-format
msgid "&Connection"
msgstr "जडान"

#: engines/fibs/kbgfibs.cpp:385
#, kde-format
msgid "&Buddy List"
msgstr "साथी सूची"

#: engines/fibs/kbgfibs.cpp:450
#, kde-format
msgctxt "R means resume"
msgid "%1 (R)"
msgstr "%1 (R)"

#: engines/fibs/kbgfibs.cpp:451
#, kde-format
msgid ""
"%1 (experience %2, rating %3) wants to resume a saved match with you. If you "
"want to play, use the corresponding menu entry to join (or type 'join %4')."
msgstr ""
"%1 (अनुभव %2, दर %3) ले तपाईँसँग बचत गरिएको खेललाई पुन: निरन्तरता दिन चाहन्छ । यदि "
"तपाईँले खेल्न चाहनुहुन्छ भने, भाग लिनका लागि सङ्गत मेनु प्रयोग गर्नुहोस् (वा 'join %4' टाइप "
"गर्नुहोस्) ।"

#: engines/fibs/kbgfibs.cpp:454
#, kde-format
msgid "%1 wants to resume a saved match with you"
msgstr "%1 ले तपाईँसँग बचत गरिएको खेल पुन: निरन्तरता दिन चाहन्छ"

#: engines/fibs/kbgfibs.cpp:457
#, kde-format
msgctxt "U means unlimited"
msgid "%1 (U)"
msgstr "%1 (U)"

#: engines/fibs/kbgfibs.cpp:458
#, kde-format
msgid ""
"%1 (experience %2, rating %3) wants to play an unlimited match with you. If "
"you want to play, use the corresponding menu entry to join (or type 'join "
"%4')."
msgstr ""
"%1 (दक्ष %2, दर %3) ले तपाईँसँग असीमित खेल खेल्न चाहन्छ । यदि तपाईँले खेल्न चाहनुहुन्छ भने, "
"भाग लिनका लागि सङ्गत मेनु प्रयोग गर्नुहोस् (वा 'join %4' टाइप गर्नुहोस्) ।"

#: engines/fibs/kbgfibs.cpp:461
#, kde-format
msgid "%1 has invited you to an unlimited match"
msgstr "%1 ले तपाईँलाई असीमित खेलका लागि आमन्त्रण गरेको छ"

#: engines/fibs/kbgfibs.cpp:466
#, kde-format
msgctxt ""
"If the format of the (U) and (R) strings is changed, it should also be "
"changed here"
msgid "%1 (%2)"
msgstr "%1 (%2)"

#: engines/fibs/kbgfibs.cpp:467
#, kde-format
msgid ""
"%1 (experience %2, rating %3) wants to play a %4 point match with you. If "
"you want to play, use the corresponding menu entry to join (or type 'join "
"%5')."
msgstr ""
"%1 (दक्ष %2, दर %3) ले तपाईँसँग %4 बिन्दु खेल खेल्न चाहन्छ । यदि तपाईँले खेल्न चाहनुहुन्छ भने, "
"भाग लिनका लागि सङ्गत मेनु प्रयोग गर्नुहोस् (वा 'join %5' टाइप गर्नुहोस्) ।"

#: engines/fibs/kbgfibs.cpp:470
#, kde-format
msgid "%1 has invited you for a %2 point match"
msgstr "%1 ले तपाईँलाई %2 बिन्दु खेलका लागि आमन्त्रण गरेको छ"

#: engines/fibs/kbgfibs.cpp:662
#, kde-format
msgid "Still connected. Log out first?"
msgstr "हालसम्म जडान गरिएको छ । पहिला लग आउट गर्नुहुन्छ?"

#: engines/fibs/kbgfibs.cpp:662
#, kde-format
msgid "Log Out"
msgstr "लग आउट गर्नुहोस्"

#: engines/fibs/kbgfibs.cpp:662
#, kde-format
msgid "Stay Connected"
msgstr "जडान गरि रहनुहोस्"

#: engines/fibs/kbgfibs.cpp:749
#, kde-format
msgid "Away message"
msgstr "टाढा गएको सन्देश"

#: engines/fibs/kbgfibs.cpp:749
#, kde-format
msgid ""
"Please type the message that should be displayed to other\n"
"users while you are away."
msgstr ""
"कृपया तपाईँ टाढा भएको बेलामा अन्य प्रयोगकर्तामा प्रदर्शित हुने सन्देश\n"
"टाइप गर्नुहोस् ।"

#: engines/fibs/kbgfibs.cpp:902
#, kde-format
msgid "Looking up %1"
msgstr "%1 को खोजी गर्दैछ"

#: engines/fibs/kbgfibs.cpp:913
#, kde-format
msgid "Connecting to %1"
msgstr "%1 मा जडान गर्दैछ"

