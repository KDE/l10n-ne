msgid "Enable timeout"
msgstr "समय समाप्ति सक्षम पार्नुहोस्"

#: kbg.cpp:606
msgid "Move timeout in seconds:"
msgstr "समय समाप्ति सेकेन्डमा सार्नुहोस्:"

