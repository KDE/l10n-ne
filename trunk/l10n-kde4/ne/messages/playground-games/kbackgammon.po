msgstr "त्रुटि, जडान अस्वीकार गरिएको छ"

#: engines/fibs/kbgfibs.cpp:925
msgid "Error, nonexistent host or name server down."
msgstr "त्रुटि, अवस्थित नरहेको होस्ट वा नाम सर्भर बन्द छ ।"

#: engines/fibs/kbgfibs.cpp:928
msgid "Error, reading data from socket"
msgstr "त्रुटि, सकेटबाट लगत पढ्दैछ"

#: engines/fibs/kbgfibs.cpp:1003
msgid "Connected"
msgstr "जडान गरियो"

#: engines/fibs/kbgfibs.cpp:1048
