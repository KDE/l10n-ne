msgstr ""
"%1 (अनुभव %2, दर %3) ले तपाईँसँग बचत गरिएको खेललाई पुन: निरन्तरता दिन चाहन्छ । यदि "
"तपाईँले खेल्न चाहनुहुन्छ भने, भाग लिनका लागि सङ्गत मेनु प्रयोग गर्नुहोस् (वा 'join %4' टाइप "
"गर्नुहोस्) ।"

#: engines/fibs/kbgfibs.cpp:453
#, kde-format
msgid "%1 wants to resume a saved match with you"
msgstr "%1 ले तपाईँसँग बचत गरिएको खेल पुन: निरन्तरता दिन चाहन्छ"

#: engines/fibs/kbgfibs.cpp:456
#, kde-format
msgctxt "U means unlimited"
