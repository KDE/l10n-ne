msgstr "कार्यक्रम mkdosfs फेला पर्यो ।"

#: floppy.cpp:151
msgctxt "Linux"
msgid ""
"Program mkdosfs <b>not found</b>. MSDOS formatting <b>not available</b>."
msgstr "कार्यक्रम mkdosfs <b>फेला परेन</b> । MSDOS ढाँचा <b>उपलब्ध छैन</b> ।"

