msgctxt "BSD"
msgid "Program newfs_msdos found."
msgstr "कार्यक्रम newfs_msdos फेला पर्यो ।"

#: floppy.cpp:180
msgctxt "BSD"
msgid ""
"Program newfs_msdos <b>not found</b>. MSDOS formatting <b>not available</b>."
msgstr "कार्यक्रम newfs_msdos <b>फेला परेन</b> । MSDOS ढाँचा <b>उपलब्ध छैन</b> ।"

#: floppy.cpp:184 floppy.cpp:516 floppy.cpp:641
msgid "UFS"
msgstr "UFS"

#: floppy.cpp:186
msgctxt "BSD"
msgid "Program newfs found."
msgstr "कार्यक्रम newfs फेला परेन ।"

#: floppy.cpp:189
msgctxt "BSD"
msgid "Program newfs <b>not found</b>. UFS formatting <b>not available</b>."
msgstr "कार्यक्रम newfs <b>फेला परेन</b> । UFS ढाँचा <b>उपलब्ध छैन</b> ।"

#: floppy.cpp:204
msgid "&Formatting"
msgstr "ढाँचा"

#: floppy.cpp:207
msgid "Q&uick format"
msgstr "शीघ्र ढाँचा"

#: floppy.cpp:211
msgid ""
"<qt>Quick format is only a high-level format: it creates only a file system."
"</qt>"
msgstr ""
"<qt>शीघ्र ढाँचा मात्र उच्च‍-स्तरको ढाँचा हो: यसले केबल फाइल प्रणाली सिर्जना गर्दछ </qt>"

#: floppy.cpp:214
msgid "&Zero out and quick format"
msgstr "शून्य बनाउनुहोस् र ढाँचा शीघ्र गर्नुहोस्"

#: floppy.cpp:218
msgid ""
"<qt>This first erases the floppy by writing zeros and then it creates the "
"file system.</qt>"
msgstr ""
"<qt>यसले पहिले शून्य लेखेर फ्लपी मेट्दछ र त्यसपछि यसले फाइल प्रणाली सिर्जना गर्दछ ।</qt>"

#: floppy.cpp:220
msgid "Fu&ll format"
msgstr "पूरा ढाँचा"

#: floppy.cpp:224
msgid ""
"Full format is a low-level and high-level format. It erases everything on "
"the disk."
msgstr "पूरा ढाँचा न्यून-स्तर र उच्च-स्तर ढाँचा हो । यसले डिस्कमा सबैकुरा मेट्दछ ।"

#: floppy.cpp:233
msgid "Program fdformat found."
msgstr "कार्यक्रम fdformat फेला पर्यो ।"

#: floppy.cpp:238
msgid "Program fdformat <b>not found</b>. Full formatting <b>disabled</b>."
msgstr "कार्यक्रम fdformat <b>फेला पर्यो</b>। पूरा ढाँचा <b>अक्षम पारिएको छ </b> ।"

#: floppy.cpp:245
msgid "Program dd found."
msgstr "कार्यक्रम dd फेला पर्यो ।"

#: floppy.cpp:249
msgid "Program dd <b>not found</b>. Zeroing-out <b>disabled</b>."
msgstr "कार्यक्रम dd <b>फेला परेन </b> । शून्य पार्ने <b>अक्षम पारिएको छ</b> ।"

#: floppy.cpp:254
msgid "&Verify integrity"
msgstr "पूर्णता रुजु गर्नुहोस्"

#: floppy.cpp:258
msgid ""
"<qt>Check this if you want the floppy disk to be checked after formatting. "
"Please note that the floppy will be checked twice if you have selected full "
"formatting.</qt>"
msgstr ""
"<qt>यदि तपाईँले ढाँचाबद्धता पछि फ्लपी डिस्क जाँच गरियो भन्ने चाहनुहुन्छ भने यो जाँच गर्नुहोस् "
"। यदि तपाईँले पूरा ढाँचाबद्धता चयन गर्नुभएको छ भने फ्लपी जाँच गरिन्छ भन्ने कृपया याद "
"राख्नुहोस् ।</qt>"

#: floppy.cpp:263
msgid "Volume la&bel:"
msgstr "भोल्युम लेबुल:"

#: floppy.cpp:267
msgid ""
"<qt>Check this if you want a volume label for your floppy. Please note that "
"Minix does not support labels at all.</qt>"
msgstr ""
"<qt>तपाईँको फ्लपीका लागि भोल्युम लेबुल चाहनुहुन्छ भने यसलाई जाँच गर्नुहोस् । मिनिक्सले सबै "
"लेबुलमा समर्थन नगर्ने कुरा याद राख्नुहोस् ।</qt>"

#: floppy.cpp:276 floppy.cpp:728
msgctxt "Volume label, maximal 11 characters"
msgid "KDE Floppy"
msgstr "KDE फ्लपी"

#: floppy.cpp:280
msgid ""
"<qt>This is for the volume label. Due to a limitation of MS-DOS the label "
"can only be 11 characters long. Please note that Minix does not support "
"labels, whatever you enter here.</qt>"
msgstr ""
"<qt>यो भोल्युम लेबुलका लागि हो । MS-DOS को सीमाको कारणले गर्दा लेबुल ११ क्यारेक्टर भन्दा "
"लामो हुन सक्दैन । तपाईँले जे प्रविष्ट गरेपनि मिनिक्सले लेबुल समर्थन गर्दैन भन्ने कुरा याद "
"राख्नुहोस् ।</qt>"

#: floppy.cpp:290 floppy.cpp:498
msgid "&Format"
msgstr "ढाँचाबद्ध गर्नुहोस्"

#: floppy.cpp:297
msgid "<qt>Click here to start formatting.</qt>"
msgstr "<qt>ढाँचा सुरु गर्न यहाँ क्लिक गर्नुहोस् ।</qt>"

#: floppy.cpp:321
msgid "<qt>This is the status window, where error messages are displayed.</qt>"
msgstr "<qt>यो वस्तुस्थित सञ्झ्याल हो, जहाँ त्रुटि सन्देश प्रर्दशित हुन्छ ।</qt>"

#: floppy.cpp:335
msgid "<qt>Shows progress of the format.</qt>"
msgstr "<qt>ढाँचाको प्रगति देखाउँदछ ।</qt>"

#: floppy.cpp:343
msgid ""
"KFloppy cannot find any of the needed programs for creating file systems; "
"please check your installation.<br><br>Log:"
msgstr ""
"केडीई फ्लपीले फाइल प्रणाली सिर्जना गर्नका लागि आवश्यक कुनै कार्यक्रम फेला पार्न सकेन; कृपया "
"तपाईँको स्थापना जाँच गर्नुहोस् ।<br><br>लग:"

#: floppy.cpp:375
msgid "KDE Floppy Formatter"
msgstr "KDE फ्लपी ढाँचाकर्ता"

#: floppy.cpp:518
msgctxt "BSD"
msgid "Formatting with BSD on a user-given device is only possible with UFS"
msgstr "प्रयोगकर्ता दिइएको यन्त्रमा BSD सँगको ढाँचाबद्धता केबल UFS सँग मात्र सम्भव हुन्छ ।"

#: floppy.cpp:526
#, qt-format
msgid ""
"<qt>Formatting will erase all data on the device:<br/><b>%1</b><br/>(Please "
"check the correctness of the device name.)<br/>Are you sure you wish to "
"proceed?</qt>"
msgstr ""
"<qt>ढाँचाबद्ध गर्नाले यन्त्रबाट सबै डेटा मेटिन्छ:<br/><b>%1</b><br/>(कृपया तपाईँको यन्त्र "
"नामको शुद्धता जाँच गर्नुहोस् ।)<br/>के तपाईँ अगाडि बढ्न निश्चित हुनुहुन्छ ?</qt>"

#: floppy.cpp:529 floppy.cpp:544
msgid "Proceed?"
msgstr "अगाडि बढ्नुहुन्छ ?"

#: floppy.cpp:543
msgid ""
"Formatting will erase all data on the disk.\n"
"Are you sure you wish to proceed?"
msgstr ""
"ढाँचाबद्ध गर्नाले डिस्कबाट सबै डेटा मेटिन्छ ।\n"
"के तपाईँ अगाडि बढ्न चाहनुहुन्छ ?"

#: format.cpp:270
#, qt-format
msgid "Unexpected drive number %1."
msgstr "अनपेक्षित ड्राइभ नम्बर %1 ।"

#: format.cpp:282
#, qt-format
msgid "Unexpected density number %1."
msgstr "अनपेक्षित घनत्व नम्बर %1 ।"

#: format.cpp:297
#, qt-format
msgid "Cannot find a device for drive %1 and density %2."
msgstr "%1 ड्राइभ र %2 घनत्वका लागि यन्त्र फेला पार्न सकिँदैन ।"

#: format.cpp:316
#, qt-format
msgid ""
"Cannot access %1\n"
"Make sure that the device exists and that you have write permission to it."
msgstr ""
"%1 पहुँच गर्न सकिँदैन\n"
"यन्त्र रहेकोमा र त्यसमा लेख्ने अनुमति भएकोमा निश्चित गर्नुहोस् ।"

#: format.cpp:347
#, qt-format
msgid "The program %1 terminated with an error."
msgstr "%1 कार्यक्रम एउटा त्रुटिसँग बन्द भयो ।"

#: format.cpp:353
#, qt-format
msgid "The program %1 terminated abnormally."
msgstr "%1 कार्यक्रम असामान्य तरिकाले बन्द भयो ।"

#: format.cpp:416 format.cpp:577 format.cpp:676 format.cpp:777 format.cpp:856
#: format.cpp:950
msgid "Internal error: device not correctly defined."
msgstr "आन्तरिक त्रुटि: यन्त्र राम्रोसँग परिभाषित गरिएको छैन ।"

#: format.cpp:423
msgid "Cannot find fdformat."
msgstr "fdformat फेला पार्न सकिँदैन ।"

#: format.cpp:455
msgid "Could not start fdformat."
msgstr "fdformat सुरु गर्न सकिँदैन ।"

#: format.cpp:482
#, qt-format
msgid "Error formatting track %1."
msgstr "%1 ट्रयाक ढाँचा गर्दा त्रुटि ।"

#: format.cpp:490 format.cpp:523
msgid ""
"Cannot access floppy or floppy drive.\n"
"Please insert a floppy and make sure that you have selected a valid floppy "
"drive."
msgstr ""
"फ्लपी वा फ्लपी ड्राइभमा पहुँच गर्न सकिँदैन ।\n"
"फ्लपी घुसाउनुहोस् र तपाईँसँग वैध फ्लपी ड्राइभ भएकोमा यकिन गर्नुहोस् ।"

#: format.cpp:511
#, qt-format
msgid "Low-level formatting error at track %1."
msgstr "%1 ट्रयाकमा न्यून-स्तरको ढाँचा त्रुटि ।"

#: format.cpp:516
#, qt-format
msgid "Low-level formatting error: %1"
msgstr "न्यून-स्तरको ढाँचा त्रुटि: %1"

#: format.cpp:530 format.cpp:733 format.cpp:899 format.cpp:990
msgid ""
"Device busy.\n"
"Perhaps you need to unmount the floppy first."
msgstr ""
"यन्त्र व्यस्त ।\n"
"सम्भवत तपाईँले फ्लपीलाई पहिला अनमाउन्ट गर्नु पर्दछ ।"

#: format.cpp:536
#, qt-format
msgid "Low-level format error: %1"
msgstr "न्यून-स्तर ढाँचा त्रुटि: %1"

#: format.cpp:584
msgid "Cannot find dd."
msgstr "dd फेला पार्न सकिँदैन ।"

#: format.cpp:599
msgid "Could not start dd."
msgstr "dd सुरु गर्न सकेन ।"

#: format.cpp:683
msgid "Cannot find a program to create FAT filesystems."
msgstr "FAT फाइल प्रणाली सिर्जना गर्न कार्यक्रम फेला पार्न सकिँदैन ।"

#: format.cpp:714
msgid "Cannot start FAT format program."
msgstr "FAT ढाँचा कार्यक्रम सुरु गर्न सकिँदैन ।"

#: format.cpp:728 format.cpp:894 format.cpp:985
msgid ""
"Floppy is mounted.\n"
"You need to unmount the floppy first."
msgstr ""
"फ्लपी माउन्ट गरियो ।\n"
"तपाईँले पहिला फ्लपी अनमाउन्ट गर्नु पर्दछ ।"

#: format.cpp:784
msgctxt "BSD"
msgid "Cannot find a program to create UFS filesystems."
msgstr "UFS फाइल प्रणाली सिर्जना गर्न कार्यक्रम सिर्जना गर्न सकिँदैन ।"

#: format.cpp:802
msgctxt "BSD"
msgid "Cannot start UFS format program."
msgstr "UFS ढाँचा कार्यक्रम सुरु गर्न सकिँदैन ।"

#: format.cpp:863
msgid "Cannot find a program to create ext2 filesystems."
msgstr "ext2 फाइल प्रणाली सिर्जना गर्न कार्यक्रम फेला पार्न सकिँदैन ।"

#: format.cpp:880
msgid "Cannot start ext2 format program."
msgstr "ext2 ढाँचा कार्यक्रम सुरु गर्न सकिँदैन ।"

#: format.cpp:957
msgid "Cannot find a program to create Minix filesystems."
msgstr "मिनिक्स फाइल प्रणाली सिर्जना गर्न कार्यक्रम फेला पार्न सकिँदैन ।"

#: format.cpp:974
msgid "Cannot start Minix format program."
msgstr "मिनिक्स ढाँचा कार्यक्रम सुरु गर्न सकिँदैन ।"

