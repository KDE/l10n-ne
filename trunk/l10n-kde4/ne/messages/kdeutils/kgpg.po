#: rc.cpp:58
msgid "Custom encryption command:"
msgstr "अनुकूल गुप्तिकरण आदेश:"

#. i18n: tag string
#. i18n: file conf_encryption.ui line 106
#: rc.cpp:61
msgid ""
"<qt><b>Custom encryption command:</b> <br />\n"
"\t\t\t<p>When activated, an entry field will be shown in the key selection "
"dialog, enabling you to enter a custom command for encryption. This option "
"is recommended for experienced users only.</p></qt>"
msgstr ""
"<qt><b>अनुकूल गुप्तिकरण आदेश:</b> <br />\n"
"\t\t\t<p>सक्रिय पारिएको बेलामा तपाईँलाई गुप्तिकरणका लागि अनुकूल आदेश प्रविष्ट गर्न सक्षम "
"पार्दै कुञ्जी चयन संवादमा प्रविष्ट फिल्ड देखिन्छ । यो विकल्प केबल अनुभवि प्रयोगकर्तालाई "
"मात्र सिफारिश गरिन्छ ।</p></qt>"

