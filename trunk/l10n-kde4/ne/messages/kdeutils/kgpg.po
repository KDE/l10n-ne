#. i18n: tag string
#. i18n: file keyserver.ui line 38
#: rc.cpp:401
msgid ""
"<qt><b>Key Server:</b><br /> <p>A Key Server is a centralized repository of "
"PGP/GnuPG keys connected to the Internet which can be conveniently accessed "
"in order to obtain or deposit keys. Select from the drop down list to "
"specify which key server should be used.</p> <p>Often these keys are held by "
"people whom the user has never met and as such the authenticity is dubious "
"at best. Refer to the GnuPG manual covering \"Web-of-Trust\" relationships "
"to find out how GnuPG works around the problem of verifying authenticity.</"
"p> </qt>"
msgstr ""
"<qt><b>कुञ्जी सर्भर:</b><br /> <p>कुञ्जी सर्भर भनेको कुञ्जीलाई जम्मा गर्न वा प्राप्त "
"गर्नका लागि सजिलोसँग पहुँच गर्ने सकिने इन्टरनेटमा जडान गरिएकोPGP/GnuPG कुञ्जीको केन्द्रिकृत "
"भण्डारण हो । प्रयोग गरिने कुञ्जी सर्भरलाई ड्रप डाउन सूचीबाट चयन गर्नुहोस् ।</p> "
"<p>सामान्यतया प्रयोगकर्ताले कहिल्यै नभेटेको र अस्पष्ट प्रमाणिकरण भएको मानिसले राख्दछन् । "
"प्रमाणिकरणको समस्या आउदा GnuPG ले काम गर्ने बारेमा फेला पार्न \"विश्वासिलो वेब\" सम्बन्ध "
"आवरण GnuPG म्यानुअल हेर्नुहोस् ।</p> </qt>"

