msgstr "ASCII आर्मोरेड गुप्तिकरण"

#. i18n: tag string
#. i18n: file conf_encryption.ui line 46
#: rc.cpp:33
msgid ""
"<qt><b>ASCII armored encryption:</b> <br /> \n"
"\t\t<p>Checking this option outputs all encrypted files in a format that can "
"be opened by a text editor and as such the output is suitable for placing in "
"the body of an e-mail message.</p></qt>"
msgstr ""
"<qt><b>ASCII आर्मन्ड गुप्तिकरण:</b> <br /> \n"
"\t\t<p>यो विकल्प जाँच गर्दा पाठ सम्पादकद्वारा खोल्न सकिने ढाँचामा सबै गुप्तिकरण फाइल "
"निर्गत गर्दछ र इमेल सन्देशको मुख्य भागमा राख्नका लागि निर्गत उपयुक्त हुन्छ ।</p></qt>"

#. i18n: tag string
