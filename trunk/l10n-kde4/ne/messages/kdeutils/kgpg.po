#. i18n: tag string
#. i18n: file conf_encryption.ui line 29
#: rc.cpp:26
msgid ""
"<qt><b>PGP 6 compatibility:</b><br /> \n"
"\t\t<p>Checking this option forces GnuPG to output encrypted packets that "
"are as compliant with PGP (Pretty Good Privacy) 6 standards as possible thus "
"allowing GnuPG users to inter operate with PGP 6 users.</p></qt>"
msgstr ""
"<qt><b>PGP 6 अनुकूलता:</b><br /> \n"
"\t\t<p>यो विकल्प चिनो गर्नाले GnuPG प्रयोगकर्तालाई PGP 6 प्रयोगकर्तासँग इन्टर सञ्चालन "
"गर्न अनुमति दिन सम्भव PGP (Pretty Good Privacy) 6 मानकसँग अनुकूल गुप्तिकरण गरिएको "
"प्याकेट निर्गत गर्न GnuPG लाइ बल गर्दछ ।</p></qt>"

#. i18n: tag string
#. i18n: file conf_encryption.ui line 42
#: rc.cpp:30 selectpublickeydialog.cpp:169
