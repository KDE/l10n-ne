#: iraction.cpp:114
msgid "Exit mode"
msgstr "अन्त्य मोड"

#: iraction.cpp:116
#, kde-format
msgid "Switch to %1"
msgstr "%1 मा स्वीच गर्नुहोस्"

#: iraction.cpp:119
msgid "Just start"
msgstr "मात्र सुरु गर्नुहोस्"

#~ msgid "Do actions before. "
#~ msgstr "अगाडि कार्य गर्नुहोस् । "

#~ msgid "Do actions after. "
#~ msgstr "पछि कार्य गर्नुहोस् । "

#~ msgid "Auto-start. "
#~ msgstr "स्वत:-सुरु । "

#~ msgid "Repeatable. "
#~ msgstr "दोहोरिने । "

#~ msgid "Do nothing if many instances. "
#~ msgstr "यदि थुप्रै दृष्टान्त छन् भने केही नगर्नुहोस् । "

#~ msgid "Send to top instance. "
#~ msgstr "माथिल्लो दृष्टान्तमा पठाउनुहोस् । "

#~ msgid "Send to bottom instance. "
#~ msgstr "तल्लो दृष्टान्तमा पठाउनुहोस् । "

#~ msgid "Send to all instances. "
#~ msgstr "सबै दृष्टान्तमा पठाउनुहोस् । "
