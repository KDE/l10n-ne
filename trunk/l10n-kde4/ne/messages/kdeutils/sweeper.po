#. i18n: tag string
#. i18n: file kprivacysettings.ui line 188
#: rc.cpp:57
msgid ""
"Warn me when I visit a site that shares my personal information with other "
"companies"
msgstr "मेरो व्यक्तिगत सूचना अन्य कम्पनीसँग साझेदारी गर्ने साइटमा जाँदा मलाई सचेत गराउनुहोस्"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 195
#: rc.cpp:60
msgid ""
"Warn me when I visit a site that does not let me know what information they "
"have about me"
msgstr "उनिहरूसँग भएको मेरो सूचना मलाई हेर्न नदिने साइटमा जाँदा मलाई सचेत गराउनुहोस्"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 202
#: rc.cpp:63
msgid "Personal Information"
msgstr "व्यक्तिगत सूचना"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 211
#: rc.cpp:66
msgid ""
"Warn me when I visit a site that may contact me about other products or "
"services:"
msgstr ""
"अन्य उत्पादन वा सेवाका बारेमा मलाई सम्पर्क गर्ने साइटमा जाँदा मलाई सचेत गराउनुहोस्:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 221
#: rc.cpp:69
msgid "Warn me when I visit a site that may use my personal information to:"
msgstr "मेरो व्यक्तिगत सूचना प्रयोग गर्न सक्ने साइटमा जाँदा मलाई सचेत गराउनुहोस्:"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 231
#: rc.cpp:72
msgid "Determine my habits, interests or general behavior"
msgstr "मेरो बानी, रूचिहरू वा सामान्य व्यवहार निर्दिष्ट गर्नुहोस्"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 243
#: rc.cpp:75
msgid "Via telephone"
msgstr "टेलिफोन मार्फत"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 250
#: rc.cpp:78
msgid "Via mail"
msgstr "मेल मार्फत"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 264
#: rc.cpp:81
msgid "Via email"
msgstr "इमेल मार्फत"

#. i18n: tag string
#. i18n: file kprivacysettings.ui line 271
#: rc.cpp:84
msgid "And do not allow me to remove my contact information"
msgstr "र मलाई मेरो सम्पर्क सूचना हटाउन अनुमति नदिनुहोस्"

