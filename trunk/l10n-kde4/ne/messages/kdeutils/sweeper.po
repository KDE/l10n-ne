#: privacy.cpp:96
msgid "Cookies"
msgstr "कुकिज"

#: privacy.cpp:98
msgid "Saved Clipboard Contents"
msgstr "क्लिपबोर्ड सामाग्री बचत गरियो"

#: privacy.cpp:100
msgid "Web History"
msgstr "वेब इतिहास"

#: privacy.cpp:102
msgid "Web Cache"
msgstr "वेब क्यास"

#: privacy.cpp:104
msgid "Form Completion Entries"
msgstr "पूर्ण प्रविष्टि ढाँचा"

#: privacy.cpp:106
msgid "Recent Documents"
msgstr "हालका कागजात"

#: privacy.cpp:108
msgid "Quick Start Menu"
msgstr "द्रुत सुरु मेनु"

#: privacy.cpp:110
msgid "Favorite Icons"
msgstr "रूचाइएको प्रतिमा"

#: privacy.cpp:112
msgid ""
"Check all cleanup actions you would like to perform. These will be executed "
"by pressing the button below"
msgstr ""
"तपाईँले गर्न खोज्नुभएको सबै खाली कार्य चेक गर्नुहोस् । यिनिहरू तलको बटन थिचेर कार्यान्वयन "
"गरिन्छ ।"

#: privacy.cpp:113
msgid "Immediately performs the cleanup actions selected above"
msgstr "माथि चयन गरिएकालाई तुरून्त हटाउने कार्य लागू गर्नुहोस्"

#: privacy.cpp:115
msgid "Clears all cached thumbnails"
msgstr "सबै क्यास थम्बनेल हटाउँछ"

#: privacy.cpp:116
msgid ""
"Clears the history of commands run through the Run Command tool on the "
"desktop"
msgstr "डेस्कटपको आदेश उपकरण चलाउने हुँदै चलेको आदेशको इतिहास खाली गर्दछ ।"

#: privacy.cpp:117
msgid "Clears all stored cookies set by websites"
msgstr "वेबसाइटद्वारा सेट गरेको सङ्ग्रहित सबै कुकिज हटाँउछ"

#: privacy.cpp:118
msgid "Clears the history of visited websites"
msgstr "भ्रमण गरिएको वेबसाइटहरूको इतिहास खाली गर्दछ ।"

#: privacy.cpp:119
msgid "Clears the clipboard contents stored by Klipper"
msgstr "क्लिप्परद्वारा सङ्ग्रह गरेको क्लिपबोर्ड सामग्री हटाँउछ ।"

#: privacy.cpp:120
msgid "Clears the temporary cache of websites visited"
msgstr "भ्रमण गरिएको वेबसाइटका अस्थायी क्यासहरू हटाँउछ ।"

#: privacy.cpp:121
msgid "Clears values which were entered into forms on websites"
msgstr "वेबसाइटहरूको फारममा प्रविष्ट गरिएको मानहरू हटाँउछ ।"

#: privacy.cpp:122
msgid ""
"Clears the list of recently used documents from the KDE applications menu"
msgstr "केडीई अनुप्रयोग मेनुबाट हालै प्रयोग गरिएका कागजातहरूको सूची हटाँउछ"

#: privacy.cpp:123
msgid "Clears the entries from the list of recently started applications"
msgstr "हालै प्रयोग गरिएका अनुप्रयोगहरूको सूचीबाट प्रविष्टिहरू हटाउँछ"

#: privacy.cpp:124
msgid "Clears the FavIcons cached from visited websites"
msgstr "भ्रमण गरिएका वेबसाइटबाट फ्याभ प्रतिमाहरू हटाउँछ"

#: privacy.cpp:247
msgid ""
"You are deleting data that is potentially valuable to you. Are you sure?"
msgstr "तपाईँलाई उपयोगि हुनसक्ने डेटा मेट्दै हुनुहुन्छ । के तपाईँ यकिन हुनुहुन्छ ?"

#: privacy.cpp:250
msgid "Starting cleanup..."
msgstr "खाली गर्न सुरु गर्दैछ..."

#: privacy.cpp:259
msgid "Clearing %1..."
msgstr "%1 हटाउँदैछ..."

#: privacy.cpp:294
msgid "Clearing of %1 failed"
msgstr "%1 खाली गर्न असफल"

#: privacy.cpp:301
msgid "Clean up finished."
msgstr "खाली गरेर सकियो"

