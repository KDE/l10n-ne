msgstr "ल्यापटपको कार्यसम्पादन प्रोफाइल परिवर्तन सक्षम पार्दछ"

#: power.cpp:168 power.cpp:261
msgid "Which profile to change it to"
msgstr "यसलाई कुन प्रोफाइलमा परिवर्तन गर्ने"

#: power.cpp:177 power.cpp:270 profile.cpp:186 buttons.cpp:182 buttons.cpp:258
msgid "CPU throttle"
msgstr "CPU थ्रोटल"

#: power.cpp:178 power.cpp:271
