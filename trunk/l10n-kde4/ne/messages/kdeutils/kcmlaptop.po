msgid "Brightness"
msgstr "चम्किलोपन"

#: power.cpp:148 power.cpp:241
msgid "Enables changing the laptop's back panel brightness"
msgstr "ल्यापटपको पछिल्लो प्यानल चम्किलोपन परिवर्तन सक्षम पार्दछ"

#: power.cpp:153 power.cpp:246
msgid "How bright to change the back panel"
msgstr "पछाडिको प्यानल चम्किलोपन कति परिवर्तन गर्ने"

