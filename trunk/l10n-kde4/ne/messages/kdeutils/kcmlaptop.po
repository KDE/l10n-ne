msgid ""
"Options in this box apply when the laptop is unplugged from the wall and has "
"been idle for a while"
msgstr ""
"ल्यापटपलाई अनप्लग गरिएको र केही बेरका लागि निस्क्रिय गरिएको बेलामा यो बाकसमा विकल्प "
"लागू गरिन्छ"

#: power.cpp:133 warning.cpp:246 buttons.cpp:132
msgid "Standb&y"
msgstr "स्ट्यान्डबाइ"

#: power.cpp:134 power.cpp:227
msgid "Causes the laptop to change to a standby temporary-low power state"
msgstr "ल्यापटपलाई स्ट्यान्डबाइ अस्थायी-न्यून शक्ति अवस्थामा परिवर्तन गर्दछ"

#: power.cpp:137 warning.cpp:252 buttons.cpp:136
msgid "&Suspend"
msgstr "निलम्बन गर्नुहोस्"

#: power.cpp:138 power.cpp:231
msgid "Causes the laptop to change to a suspend 'save-to-ram' state"
msgstr "ल्यापटपलाई निलम्बन 'र्याममा बचत गर्नुहोस्' अवस्थामा परिवर्तन गर्दछ"

#: power.cpp:141 warning.cpp:258 buttons.cpp:140
