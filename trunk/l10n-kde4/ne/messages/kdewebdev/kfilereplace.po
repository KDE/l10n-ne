#: report.cpp:70
msgid "KFileReplace Report"
msgstr "केडीई फाइल बदल्ने प्रतिवेदन"

#: report.cpp:75
msgid "Searching/Replacing Strings Table"
msgstr "खोज्ने/बदल्ने स्ट्रिङ तालिका"

#: report.cpp:78
msgid "Search for"
msgstr "यसको खोजी गर्नुहोस्"

#: report.cpp:113
msgid "Results Table"
msgstr "परिणाम तालिका"

#: report.cpp:203
