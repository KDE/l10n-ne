#: rc.cpp:3514
msgid ""
"The <b>B</b> element suggests that text be rendered as <i>bold text</i>.\n"
"   "
msgstr ""
"<b>B</b> तत्वले पाठ <i>बाक्लो पाठ</i> का रुपमा बदलिने सुझाव गर्छ ।\n"
"   "

#. i18n: tag tooltip
#. i18n: file extrafiles line 2229
#: rc.cpp:3518
msgid ""
"The <b>B</b> element suggests that text be rendered as <i>emphasized text</"
"i>.\n"
"   "
msgstr ""
"<b>B</b> तत्वले पाठ <i>प्रमुख पाठ</i> का रुपमा बदलिने सुझाव गर्छ ।\n"
"   "

#. i18n: tag tooltip
#. i18n: file extrafiles line 2238
#: rc.cpp:3522
msgid ""
"The <b>I</b> element suggests that text be rendered as <i>italic text</i>.\n"
"   "
msgstr ""
"<b>I</b> तत्वले पाठ <i>छड्के पाठ</i> का रुपमा बदलिने सुझाव गर्छ ।\n"
"   "

#. i18n: tag tooltip
#. i18n: file extrafiles line 2243
#: rc.cpp:3526
msgid ""
"The <b>U</b> element suggests that text be rendered as <i>underlined text</"
"i>.\n"
"   "
msgstr ""
"<b>U</b> तत्वले पाठ <i>अधोरेखित पाठ</i> का रुपमा बदलिने सुझाव गर्छ ।\n"
"   "

#. i18n: tag tooltip
#. i18n: file extrafiles line 2246
#: rc.cpp:3530
msgid ""
"The <b>small</b> element suggests that text be rendered as a <i>small font</"
"i>.\n"
"   "
msgstr ""
"<b>small</b> तत्वले पाठ <i>सानो फन्ट</i> का रुपमा बदलिने सुझाव गर्छ ।\n"
"   "

#. i18n: tag tooltip
#. i18n: file extrafiles line 2253
#: rc.cpp:3534
msgid ""
"The <b>big</b> element suggests that text be rendered as a <i>big font</i>.\n"
"   "
msgstr ""
"<b>big</b> तत्वले पाठ <i>ठूलो फन्ट</i> का रुपमा बदलिने सुझाव गर्छ ।\n"
"   "

#. i18n: tag tooltip
#. i18n: file extrafiles line 2260
#: rc.cpp:3538
msgid ""
"The <b>br</b> element forces a <i>break</i> in the current line of text.\n"
"   "
msgstr ""
"<b>br</b> तत्वले पाठको हालको लाइनमा <i>विच्छेद</i> गर्ने प्रयास गर्छ ।\n"
"   "

#. i18n: tag tooltip
#. i18n: file extrafiles line 2270
#: rc.cpp:3542
msgid ""
"The <b>P</b> element defines a <i>paragraph</i>.\n"
"     <br>- ALIGN=[ left | center | right ] (horizontal alignment)\n"
"   "
msgstr ""
"<b>P</b> तत्वले <i>अनुच्छेद</i> परिभाषित गर्छ ।\n"
"     <br>- ALIGN=[ left | center | right ] (horizontal alignment)\n"
"   "

