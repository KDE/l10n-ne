#. i18n: tag tooltip
#. i18n: file extrafiles line 2374
#: rc.cpp:3568
msgid ""
"The <b>anchor</b> element denotes an <i>anchor</i>-- a link to formatted "
"text.\n"
"     The <b>task</b> within the tag is executed when the link is selected, "
"such as an <i>go</i> task or a <i>refresh</i>.\n"
"   "
msgstr ""
"<b>anchor</b> तत्वले <i>एङ्कर</i>-- ढाँचाबद्ध पाठमा एउटा लिङ्क सङ्केत गर्छ ।\n"
"     ट्याग भित्रको <b>task</b> लिङ्क चयन गरिएको समयमा कार्यान्वयन गरिन्छ, जस्तै "
"कार्यमा <i>जानुहोस्</i> वा <i>ताजा पार्नुहोस्</i> ।\n"
"   "

#. i18n: tag tooltip
#. i18n: file extrafiles line 2378
#: rc.cpp:3573
msgid ""
"The <b>a</b> element denotes an <i>anchor</i>--a hypertext link or the "
"destination of a link.\n"
"     The <b>HREF</b> attribute specifies a hypertext link to another <i>wml</"
"i> document.\n"
"   "
msgstr ""
"<b>a</b> तत्वले <i>एङ्कर</i>--एउटा हाइपरटेक्स्ट लिङ्क वा लिङ्कको गन्तव्य सङ्केत गर्छ ।\n"
"     <b>HREF</b> विशेषताले अन्य <i>wml</i> कागजातमा हाइपरटेक्स्ट लिङ्क निर्दिष्ट गर्छ "
"।\n"
"   "

