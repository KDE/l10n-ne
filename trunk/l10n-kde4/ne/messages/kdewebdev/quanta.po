#. i18n: tag string
#. i18n: file ./scripts/tablewizard.kmdr line 409
#: rc.cpp:2839
msgid ""
"<qt>\n"
"Select the table type:\n"
"<ul>\n"
"<li><b>informaltable:</b> the most used table type in KDE docs. A "
"informaltable does not contain title, table head or entry in the table of "
"contents.</li>\n"
"<li><b>table:</b> a complete and formal table type, including title, table "
"head and entry in the table of contents.</li>\n"
"</ul>\n"
"</qt>"
msgstr ""
"<qt>\n"
"तालिका प्रकार चयन गर्नुहोस्:\n"
"<ul>\n"
"<li><b>अनौपचारिक तालिका:</b> केडीई docs मा सबैभन्दा बढी प्रयोग गरिएको तालिका "
"प्रकार । अनौपचारिक तालिकामा शीर्षक, तालिका हेड वा तालिका सामाग्रीमा प्रविष्टि "
"समावेश हुदैन ।</li>\n"
"<li><b>तालिका:</b> शीर्षक, तालिका हेड र तालिका सामाग्रीमा प्रविष्टि समाविष्ट एउटा "
"पूर्णं र औपचारिक तालिका प्रकार ।</li>\n"
"</ul>\n"
"</qt>"

