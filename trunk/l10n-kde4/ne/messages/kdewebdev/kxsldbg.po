#: xsldbgmain.cpp:50
msgid "A KDE console application for xsldbg, an XSLT debugger"
msgstr "xsldbg का लागि एउटा केडीई कन्सोल अनुप्रयोग, एउटा XSLT त्रुटिमोचक"

#: xsldbgmain.cpp:76
#, kde-format
msgid "Using libxml %1, libxslt %2 and libexslt %3\n"
msgstr "libxml %1, libxslt %2 र libexslt %3 प्रयोग\n"

#: xsldbgmain.cpp:77
#, kde-format
msgid "xsldbg was compiled against libxml %1, libxslt %2 and libexslt %3\n"
msgstr ""
"xsldbg लाई libxml %1, libxslt %2 र libexslt %3 को बिरुद्धमा कम्पाइल गरिएको "
"थियो\n"

#: xsldbgmain.cpp:78
#, kde-format
msgid "libxslt %1 was compiled against libxml %2\n"
msgstr "libxslt %1 लाई libxml %2 को बिरुद्धमा कम्पाइल गरिएको थियो\n"

#: xsldbgmain.cpp:79
#, kde-format
msgid "libexslt %1 was compiled against libxml %2\n"
msgstr "libexslt %1 लाई libxml %2 का बिरुद्धमा कम्पाइल गरिएको थियो\n"

#: xsldbgmain.cpp:82
msgid "Xsldbg"
msgstr "Xsldbg"

#: xsldbgmain.cpp:87
msgid "Start a shell"
msgstr "शेल सुरुआत गर्नुहोस्"

#: xsldbgmain.cpp:88
msgid "Path to change into before loading files"
msgstr "फाइलहरू लोड गर्नुभन्दा पहिला परिवर्तन गर्नुपर्ने मार्ग"

#: xsldbgmain.cpp:89
msgid "Add a parameter named <name> and value <value> to XSL environment"
msgstr "XSL परिवेशमा <name> नाम र <value> मान भएको परिमिति थप्नुहोस्"

#: xsldbgmain.cpp:90
msgid "Use ISO 639 language code specified; for example en_US"
msgstr "निर्दिष्ट गरिएको ISO 639 भाषा कोड प्रयोग गर्नुहोस्; उदाहरणका लागि en_US"

#: xsldbgmain.cpp:91
msgid "Save to a given file. See output command documentation"
msgstr "दिएको फाइलमा बचत गर्नुहोस् । निर्गत आदेश मिशिलिकरण हेर्नुहोस्"

#: xsldbgmain.cpp:92
msgid "Show the version of libxml and libxslt used"
msgstr "libxml र libxslt को प्रयोग गरिएको संस्करण देखाउनुहोस्"

#: xsldbgmain.cpp:93
msgid "Show logs of what is happening"
msgstr "पछि आइपर्ने कार्यहरू देखाउनुहोस्"

#: xsldbgmain.cpp:94
msgid "Display the time used"
msgstr "प्रयोग गरिएको समय प्रदर्शन गर्नुहोस्"

#: xsldbgmain.cpp:95
msgid "Run the transformation 20 times"
msgstr "रुपान्तरण २० पटक चलाउनुहोस्"

#: xsldbgmain.cpp:97
msgid "Dump the tree of the result instead"
msgstr "यसको साटोमा परिणामको ट्रि सञ्चित गर्नुहोस्"

#: xsldbgmain.cpp:99
msgid "Disable the DTD loading phase"
msgstr "DTD लोडिङ चरण अक्षम पार्नुहोस्"

#: xsldbgmain.cpp:100
msgid "Disable the output of the result"
msgstr "परिणामको निर्गत अक्षम पार्नुहोस्"

#: xsldbgmain.cpp:101
msgid "Increase the maximum depth"
msgstr "अधिकतम गाढापन बढाउनुहोस्"

#: xsldbgmain.cpp:103
msgid "The input document is(are) an HTML file(s)"
msgstr "आगत कागजात HTML फाइल(हरू) हो(हुन्)"

#: xsldbgmain.cpp:106
msgid "The input document is SGML docbook"
msgstr "आगत कागजात SGML docbook हो"

#: xsldbgmain.cpp:108
msgid "Disable the fetching DTDs or entities over network"
msgstr "सञ्जालमा DTDs वा वस्तुहरू तनाई अक्षम पार्नुहोस्"

#: xsldbgmain.cpp:110
msgid "Use the catalogs from $SGML_CATALOG_FILES"
msgstr "$SGML_CATALOG_FILES बाट विवरणिका प्रयोग गर्नुहोस्"

#: xsldbgmain.cpp:113
msgid "Disable XInclude processing on document input"
msgstr "कागजात आगतमा XInclude प्रक्रिया अक्षम पार्नुहोस्"

#: xsldbgmain.cpp:115
msgid "Print profiling information"
msgstr "प्रोफाइल सूचना मुद्रण गर्नुहोस्"

#: xsldbgmain.cpp:116
msgid "Do not run gdb compatability mode and print less information"
msgstr "gdb सङ्कुचन मोड नचलाउनुहोस् र कम सूचना मुद्रण गर्नुहोस्"

#: xsldbgmain.cpp:117
msgid "Detect and use encodings in the stylesheet"
msgstr "शैलीपानामा सङ्केतन पत्ता लगाउनुहोस् र प्रयोग गर्नुहोस्"

#: xsldbgmain.cpp:118
msgid "Treat command line input as encoded in UTF-8"
msgstr "UTF-8 मा सङ्केतन गरिए अनुरुप आदेश लाइन आगत व्यवहार गर्नुहोस्"

#: xsldbgmain.cpp:119
msgid "Use HTML output when generating search reports"
msgstr "खोजी प्रतिवेदन उत्पन्न गर्दा HTML निर्गत प्रयोग गर्नुहोस्"

#: xsldbgmain.cpp:120
msgid ""
"Print all error messages to stdout, normally error messages go to stderr"
msgstr "stdout मा सबै त्रुटि सन्देश मुद्रण गर्नुहोस्, सामान्यतया त्रुटि सन्देश stderr मा जान्छ"

#: xsldbgmain.cpp:121
msgid ""
"Disable the automatic restarting of execution when current processing pass "
"is complete"
msgstr ""
"हालको पास प्रक्रिया समाप्त हुँदा कार्यान्वयनको स्वचालित पुन: सुरुआत अक्षम पार्नुहोस् ।"
