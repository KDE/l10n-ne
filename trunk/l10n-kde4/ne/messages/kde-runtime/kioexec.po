#: main.cpp:44
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr "KIO Exec - टाढाका फाइलहरू खोल्दछ, परिमार्जनहरू हेर्दछ, अपलोडका लागि सोध्दछ"

#: main.cpp:52
msgid "'command' expected.\n"
msgstr "'आदेश' अपेक्षा गरियो ।\n"

#: main.cpp:81
#, kde-format
msgid ""
"The URL %1\n"
"is malformed"
msgstr ""
"URL %1\n"
"विकृत छ"

#: main.cpp:83
#, kde-format
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"--टेम्पफाइल स्वीचसँग टाढाको URL %1\n"
"अनुमति प्राप्त छैन"

#: main.cpp:216
#, kde-format
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"मानिएको अस्थायी फाइल\n"
"%1\n"
"परिमर्जित गरिएको छ ।\n"
"तपाईँ अझै यसलाई मेट्न चाहनुहुन्छ ?"

#: main.cpp:217 main.cpp:224
msgid "File Changed"
msgstr "फाइल परिवर्तन गरियो"

#: main.cpp:217
msgid "Do Not Delete"
msgstr "नमेट्नुहोस्"

#: main.cpp:223
#, kde-format
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"फाइल\n"
"%1\n"
"परिमार्जन गरिएको छ ।\n"
"के तपाईँ परिवर्तनहरू अपलोड गर्न चाहनुहन्छ ?"

#: main.cpp:224
msgid "Upload"
msgstr "अपलोड"

#: main.cpp:224
msgid "Do Not Upload"
msgstr "अपलोड नगर्नुहोस्"

