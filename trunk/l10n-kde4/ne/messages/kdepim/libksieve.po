#: shared/error.cpp:112
msgid "Parse error: Carriage Return (CR) without Line Feed (LF)"
msgstr "पद वर्णन त्रुटि: रेखा भरण (एलएफ) बिना क्यारिज फिर्ता (सीआर)"

#: shared/error.cpp:115
msgid ""
"Parse error: Unquoted Slash ('/') without Asterisk ('*'). Broken Comment?"
msgstr "पद वर्णन त्रुटि: एस्टेरिक ('*') बिनाको अनकोटेड स्ल्यास ('/') । बिग्रेको टिप्पणी ?"

#: shared/error.cpp:119
msgid "Parse error: Illegal Character"
msgstr "पद वर्णन त्रुटि: गैरकानुनी क्यारेक्टर"

#: shared/error.cpp:122
msgid "Parse error: Unexpected Character, probably a missing space?"
msgstr "पद वर्णन त्रुटि: अनपेक्षित क्यारेक्टर, सम्भवत: रिक्तस्थान हराइरहेको छ ?"

#: shared/error.cpp:125
msgid "Parse error: Tag Name has leading Digits"
msgstr "पद वर्णन त्रुटि: ट्याग नाम अगाडि दशमलव छ ।"

#: shared/error.cpp:128
msgid ""
"Parse error: Only whitespace and #comments may follow \"text:\" on the same "
"line"
msgstr ""
"पद वर्णन त्रुटि: केवल सेतो रिक्तस्थान र #टिप्पणीले मात्र उहि रेखामा \"पाठ:\" अनुशरण गरेको "
"हुनसक्दछ"

#: shared/error.cpp:132
#, qt-format
msgid "Parse error: Number out of Range (must be smaller than %1)"
msgstr "पद वर्णन त्रुटि: सङ्ख्या दायरा भन्दा बाहिर (%1 भन्दा सानो हुनुपर्दछ)"

#: shared/error.cpp:135
msgid "Parse error: Invalid UTF-8 sequence"
msgstr "पद वर्णन त्रुटि: अवैध UTF-8 अनुक्रम"

#: shared/error.cpp:138
msgid ""
"Parse error: Premature end of Multiline String (did you forget the '.'?)"
msgstr "पद वर्णन त्रुटि: बहुविध रेखा स्ट्रिङको असामयिक अन्त्य (तपाईँले '.' बिर्सनुभयो ?)"

#: shared/error.cpp:141
msgid "Parse error: Premature end of Quoted String (missing closing '\"')"
msgstr "पद वर्णन त्रुटि: उद्वरण स्ट्रिङको असामयिक अन्त्य ( '\"' बन्द गर्ने छुटेको छ)"

#: shared/error.cpp:144
msgid "Parse error: Premature end of String List (missing closing ']')"
msgstr "पद वर्णन त्रुटि: स्ट्रिङ सूचीको असामयिक अन्त्य (']' बन्द गर्ने छुटेको छ)"

#: shared/error.cpp:147
msgid "Parse error: Premature end of Test List (missing closing ')')"
msgstr "पद वर्णन त्रुटि: परीक्षण सूचीको असामयिक अन्त्य (')' बन्द गर्ने छुटेको छ)"

#: shared/error.cpp:150
msgid "Parse error: Premature end of Block (missing closing '}')"
msgstr "पद वर्णन त्रुटि: खण्डको असामयिक अन्त्य ('}' बन्द गर्ने छुटेको छ)"

#: shared/error.cpp:153
msgid "Parse error: Missing Whitespace"
msgstr "पद वर्णन त्रुटि: सेतो रिक्तस्थान छुटेको छ"

#: shared/error.cpp:156
msgid "Parse error: Missing ';' or Block"
msgstr "पद वर्णन त्रुटि: ';' वा ब्लक छुटेको छ"

#: shared/error.cpp:159
msgid "Parse error: Expected ';' or '{', got something else"
msgstr "पद वर्णन त्रुटि: ';' वा '{' अपेक्षा गरेको हो तर अरू नै प्राप्त भयो"

#: shared/error.cpp:162 shared/error.cpp:177
msgid "Parse error: Expected Command, got something else"
msgstr "पद वर्णन त्रुटि: आदेश अपेक्षा गरेको हो, अरू नै प्राप्त भयो"

#: shared/error.cpp:165
msgid "Parse error: Trailing, Leading or Duplicate Commas in String List"
msgstr "पद वर्णन त्रुटि: स्ट्रिङ सूचीमा पछाडि, अगाडि वा नक्कल अल्पविरामहरू छन्"

#: shared/error.cpp:168
msgid "Parse error: Trailing, Leading or Duplicate Commas in Test List"
msgstr "पद वर्णन त्रुटि: परीक्षण सूचीमा पछाडि, अगाडि, वा नक्कल अल्पविराम छन्"

#: shared/error.cpp:171
msgid "Parse error: Missing ',' between Strings in String List"
msgstr "पद वर्णन त्रुटि: स्ट्रिङ र स्ट्रिङ सूचीको बिचमा ',' छुटेको छ"

#: shared/error.cpp:174
msgid "Parse error: Missing ',' between Tests in Test List"
msgstr "पद वर्णन त्रुटि: परीक्षण र परीक्षण सूचीको बिचमा ',' छुटेको छ"

#: shared/error.cpp:180
msgid "Parse error: Only Strings allowed in String Lists"
msgstr "पद वर्णन त्रुटि: स्ट्रिङ सूचीमा स्ट्रिङलाई मात्र अनुमति छ"

#: shared/error.cpp:183
msgid "Parse error: Only Tests allowed in Test Lists"
msgstr "पद वर्णन त्रुटि: परीक्षण सूचीमा परीक्षणहरूलाई मात्र अनुमति छ"

#: shared/error.cpp:188
msgid "\"require\" must be first command"
msgstr "\"require\" पहिलो आदेश हुनुपर्दछ"

#: shared/error.cpp:191
#, qt-format
msgid "\"require\" missing for command \"%1\""
msgstr "\"%1\" आदेशमा \"require\" छुटेको छ"

#: shared/error.cpp:194
#, qt-format
msgid "\"require\" missing for test \"%1\""
msgstr "\"%1\" परीक्षणका लागि \"require\" छुटेको छ"

#: shared/error.cpp:197
#, qt-format
msgid "\"require\" missing for comparator \"%1\""
msgstr "\"%1\" तुलनाका लागि \"require\" छुटेको छ"

#: shared/error.cpp:200
#, qt-format
msgid "Command \"%1\" not supported"
msgstr "\"%1\" आदेश समर्थन गर्दैन"

#: shared/error.cpp:203
#, qt-format
msgid "Test \"%1\" not supported"
msgstr "\"%1\" परीक्षण समर्थन गर्दैन"

#: shared/error.cpp:206
#, qt-format
msgid "Comparator \"%1\" not supported"
msgstr "\"%1\" तुलनाकारी समर्थन गर्दैन"

#: shared/error.cpp:209
#, qt-format
msgid "Site Policy Limit Violation: Test nesting too deep (max. %1)"
msgstr "साइट नीति सीमा उल्लघन: नेस्टिङ गहिराई परीक्षण (अधिकतम %1)"

#: shared/error.cpp:212
#, qt-format
msgid "Site Policy Limit Violation: Block nesting too deep (max. %1)"
msgstr "साइट नीति सीमा उल्लघन: गहिराईमा नेस्टिङ निषेध (अधिकतम %1)"

#: shared/error.cpp:215
#, qt-format
msgid "Invalid Argument \"%1\" to \"%2\""
msgstr "\"%2\" मा \"%1\" अवैध तर्क"

#: shared/error.cpp:218
#, qt-format
msgid "Conflicting Arguments: \"%1\" and \"%2\""
msgstr "बाझिएका तर्क: \"%1\" र \"%2\""

#: shared/error.cpp:221
#, qt-format
msgid "Argument \"%1\" Repeated"
msgstr "\"%1\" तर्क दोहोरियो"

#: shared/error.cpp:224
#, qt-format
msgid "Command \"%1\" violates command ordering constraints"
msgstr "\"%1\" आदेशले आदेश क्रम अवरोध उल्लघन गर्दछ"

#: shared/error.cpp:229
#, qt-format
msgid "Incompatible Actions \"%1\" and \"%2\" requested"
msgstr "नमिल्दो कार्य \"%1\" र \"%2\" अनुरोध गरियो"

#: shared/error.cpp:232
msgid "Mail Loop detected"
msgstr "मेल लुप पत्ता लाग्यो"

#: shared/error.cpp:235
#, qt-format
msgid "Site Policy Limit Violation: Too many Actions requested (max. %1)"
msgstr "साइट नीति सीमा उल्लघन: धेरै कार्य अनुरोध गरियो (अधिकतम %1)"

#: shared/error.cpp:238
msgid "Unknown error"
msgstr "अज्ञात त्रुटि"
