#: imap4.cc:632
#, qt-format
msgid "Message from %1 while processing '%2': %3"
msgstr "'%2' मा प्रक्रिया गर्दा %1 बाट सन्देश: %3"

#: imap4.cc:634
#, qt-format
msgid "Message from %1: %2"
msgstr "%1 बाट सन्देश: %2"

#: imap4.cc:957
#, qt-format
msgid ""
"The following folder will be created on the server: %1 What do you want to "
"store in this folder?"
msgstr ""
"सर्भरमा निम्न फोल्डर सिर्जना गरिनेछ: %1 तपाईँ यो फोल्डरमा के भण्डारण गर्न चाहनुहुन्छ?"

#: imap4.cc:959
msgid "Create Folder"
msgstr "फोल्डर सिर्जना गर्नुहोस्"

#: imap4.cc:960
msgid "&Messages"
msgstr "सन्देश"

#: imap4.cc:960
msgid "&Subfolders"
msgstr "सहायक फोल्डर"

#: imap4.cc:1293
#, qt-format
msgid "Unsubscribe of folder %1 failed. The server returned: %2"
msgstr "फोल्डर %1 को सदस्यता हटाउन असफल भयो । सर्भर फिर्ता भयो: %2"

#: imap4.cc:1314
#, qt-format
msgid "Subscribe of folder %1 failed. The server returned: %2"
msgstr "फोल्डर %1 को सदस्यता लिन असफल भयो । सर्भर फिर्ता भयो: %2"

#: imap4.cc:1376 imap4.cc:1388
#, qt-format
msgid "Changing the flags of message %1 failed."
msgstr "सन्देश %1 को झण्डा परिवर्तन गर्दा असफल भयो ।"

#: imap4.cc:1428
#, qt-format
msgid ""
"Setting the Access Control List on folder %1 for user %2 failed. The server "
"returned: %3"
msgstr ""
"प्रयोगकर्ता %2 का लागि %1 फोल्डरमा पहुँच नियन्त्रण सूची सेट गर्न असफल भयो । सर्भर फिर्ता "
"भयो: %3"

#: imap4.cc:1447
#, qt-format
msgid ""
"Deleting the Access Control List on folder %1 for user %2 failed. The server "
"returned: %3"
msgstr ""
"प्रयोगकर्ता %2 का लागि फोल्डर %1 मा पहुँच नियन्त्रण सूची मेट्न असफल भयो । सर्भर फिर्ता "
"भयो: %3"

#: imap4.cc:1464 imap4.cc:1491
#, qt-format
msgid ""
"Retrieving the Access Control List on folder %1 failed. The server returned: "
"%2"
msgstr ""
"फोल्डर %1 मा पहुँच नियन्त्रण सूची पुन: प्राप्त गर्न असफल भयो । सर्भर फिर्ता भयो: %2"

#: imap4.cc:1525
#, qt-format
msgid "Searching of folder %1 failed. The server returned: %2"
msgstr "फोल्डर %1 को खोजी असफल भयो । सर्भर फिर्ता भयो: %2"

#: imap4.cc:1563
#, qt-format
msgid "Setting the annotation %1 on folder %2  failed. The server returned: %3"
msgstr "फोल्डर %2  मा टिप्पणी %1 सेटिङ गर्न असफल भयो । सर्भर फिर्ता भयो: %3"

#: imap4.cc:1587
#, qt-format
msgid ""
"Retrieving the annotation %1 on folder %2 failed. The server returned: %3"
msgstr "फोल्डर %2 मा टिप्पणी %1 पुन: प्राप्त गर्न असफल भयो । सर्भर फिर्ता भयो: %3"

#: imap4.cc:1624
#, qt-format
msgid ""
"Retrieving the quota root information on folder %1 failed. The server "
"returned: %2"
msgstr ""
"फोल्डर %1 मा कोटा मूल जानकारी पुन: प्राप्त गर्न असफल । सर्भरले यो जवाफ दियो: %2"

#: imap4.cc:1680 imap4.cc:1748
msgid "Unable to close mailbox."
msgstr "पत्रमञ्जूषा बन्द गर्न असमर्थ ।"

#: imap4.cc:1778
#, fuzzy, qt-format
msgid "Unable to get information about folder %1. The server replied: %2"
msgstr "फोल्डर  %1 खोल्न असमर्थ । सर्भरले जवाफ दियो: %2"

#: imap4.cc:1935
#, qt-format
msgid ""
"The server %1 supports neither IMAP4 nor IMAP4rev1.\n"
"It identified itself with: %2"
msgstr ""
"सर्भर %1 ले IMAP4 वा IMAP4rev1 समर्थन गर्दैन ।\n"
"यो आफैमा परिचित भयो: %2"

#: imap4.cc:1946
msgid ""
"The server does not support TLS.\n"
"Disable this security feature to connect unencrypted."
msgstr ""
"सर्भरले TLS समर्थन गर्दैन ।\n"
"गुप्तिकरण नगरिएका जडान गर्न यो सुरक्षा विशेषता अक्षम पार्नुहोस् ।"

#: imap4.cc:1971
msgid "Starting TLS failed."
msgstr "TLS सुरुआत गर्न असफल ।"

#: imap4.cc:1981
#, qt-format
msgid "The authentication method %1 is not supported by the server."
msgstr "सर्भरले प्रमाणीकरण बिधि %1 समर्थन गरेन ।"

#: imap4.cc:1996
msgid "Username and password for your IMAP account:"
msgstr "तपाईँको IMAP खाताका लागि प्रयोगकर्ता नाम र पासवर्ड:"

#: imap4.cc:2010
#, qt-format
msgid ""
"Unable to login. Probably the password is wrong.\n"
"The server %1 replied:\n"
"%2"
msgstr ""
"लगइन गर्न असमर्थ । सम्भवत: पासवर्ड गलत छ ।\n"
"सर्भर %1 ले जवाफ दियो:\n"
"%2"

#: imap4.cc:2017
#, qt-format
msgid ""
"Unable to authenticate via %1.\n"
"The server %2 replied:\n"
"%3"
msgstr ""
"%1 बाट प्रमाणीकरण हुन असमर्थ ।\n"
"सर्भर %2 ले जवाफ दियो:\n"
"%3"

#: imap4.cc:2023
msgid "SASL authentication is not compiled into kio_imap4."
msgstr "SASL प्रमाणीकरण kio_imap4 मा कम्पाइल गरिएको छैन ।"

#: imap4.cc:2512
#, qt-format
msgid "Unable to open folder %1. The server replied: %2"
msgstr "फोल्डर  %1 खोल्न असमर्थ । सर्भरले जवाफ दियो: %2"

#~ msgid "LOGIN is disabled by the server."
#~ msgstr "सर्भरद्वारा लगइन अक्षम पारिएको छ ।"
