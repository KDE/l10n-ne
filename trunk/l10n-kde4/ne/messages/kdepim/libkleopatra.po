#. i18n: tag string
#. i18n: file ui/directoryserviceswidgetbase.ui line 60
#: rc.cpp:41
msgid ""
"<qt>\n"
"<h1>X.500 Directory Services</h1>\n"
"You can use X.500 directory services to retrieve certificates and "
"certificate revocation lists that are not saved locally. Ask your local "
"administrator if you want to make use of this feature and are unsure which "
"directory service you can use.\n"
"<p>\n"
"If you do not use a directory service, you can still use local "
"certificates.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>X.500 डाइरेक्टरी सेवा</h1>\n"
"तपाईँले स्थानीय रूपमा बचत नगरेको प्रमाणपत्र र प्रमाणपत्र खारेजी सूची पुन: प्राप्त गर्न "
"X.500 डाइरेक्टरी प्रयोग गर्न सक्नुहुन्छ । यदि तपाईँले यो सेवा प्रयोग गर्न चाहेर कुन "
"डाइरेक्टरी सेवा प्रयोग गर्ने बारेमा अनविज्ञ हुनुहुन्छ भने तपाईँको स्थानीय प्रशासकलाई सोध्नुहोस् "
"।\n"
"<p>\n"
"यदि तपाईँले डाइरेक्टरी सेवा प्रयोग गर्नु हुदैन भने, तपाईँले अझ पनि स्थानीय प्रमाणपत्र प्रयोग "
"गर्न सक्नुहुन्छ ।\n"
"</qt>"

