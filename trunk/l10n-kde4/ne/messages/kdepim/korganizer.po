#: koeditordetails.cpp:191
#, fuzzy
#| msgid ""
#| "Sets the identity corresponding to the organizer of this to-do or event. "
#| "Identities can be set in the 'Personal' section of the KOrganizer "
#| "configuration, or in the 'Security & Privacy'->'Password & User Account' "
#| "section of the KDE Control Center. In addition, identities are gathered "
#| "from your KMail settings and from your address book. If you choose to set "
#| "it globally for KDE in the Control Center, be sure to check 'Use email "
#| "settings from Control Center' in the 'Personal' section of the KOrganizer "
#| "configuration."
msgctxt "@info:whatsthis"
msgid ""
"Sets the identity corresponding to the organizer of this to-do or event. "
"Identities can be set in the 'Personal' section of the KOrganizer "
"configuration, or in the 'Security & Privacy'->'Password & User Account' "
"section of the KDE Control Center. In addition, identities are gathered from "
"your KMail settings and from your address book. If you choose to set it "
"globally for KDE in the Control Center, be sure to check 'Use email settings "
"from Control Center' in the 'Personal' section of the KOrganizer "
"configuration."
msgstr ""
"यो गर्नुपर्ने कार्य वा घटनाको आयोजकसँग सङ्गत परिचय सेट गर्छ । पहिचान केडीई आयोजक "
"कन्फिगरेसन खण्डको 'व्यक्तिगत' खण्डमा, वा केडीई नियन्त्रण केन्द्रको 'सुरक्षित र गोप्य'-"
">'पासवर्ड र प्रयोगकर्ता खाता' खण्डमा सेट गर्न सकिन्छ । यसको अतिरिक्त, परिचय तपाईँको "
"केडीई मेल सेटिङ र ठेगाना पुस्तकबाट सङ्कलन गरिन्छ । यदि तपाईँ यसलाई केडीईको नियन्त्रण "
"केन्द्रमा विश्यव्यापी रूपमा सेट गर्न रोज्नुहुन्छ भने, केडीई आयोजकको कन्फिगरेसनको 'व्यक्तिगत' "
"खण्डको 'नियन्त्रण केन्द्रबाट इमेल सेटिङ प्रयोग गर्नुहोस्' जाँच गर्न निश्चित हुनुहोस् ।"

