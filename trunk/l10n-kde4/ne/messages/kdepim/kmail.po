#, no-c-format
msgid "Sign all message &parts"
msgstr "सबै सन्देश भागमा चिनो लगाउनुहोस्"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 165
#: rc.cpp:1111
#, no-c-format
msgid "Check to have all message parts signed by default"
msgstr "पूर्वनिर्धारित अनुरुप सबै सन्देश भागमा चिन्ह लगाएको हुन चेक गर्नुहोस्"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 173
#: rc.cpp:1115
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Sign All Message Parts By Default</h1>\n"
"If this option is selected, all parts of a message (i.e. the main message "
"body and all attachments) are signed by default.\n"
"<p>\n"
"This is a default setting, you can still override it for each individual "
"message.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>पूर्वनिर्धारितद्वारा सबै सन्देश भागमा चिन्ह लगाउनुहोस्</h1>\n"
"यो विकल्प चयन गरिएमा, सन्देशको सबै भाग (जस्तै: सन्देश मुख्य भाग र सबै सङ्लग्नता) "
"पूर्वनिर्धारित अनुरुप चिन्ह लगाइन्छन् ।\n"
"<p>\n"
"यो पूर्वनिर्धारित सेटिङ हो, तपाईँले अझैपनि यसलाई प्रत्येक सन्देशका लागि अधिरोहण गर्न "
"सक्नुहुन्छ ।\n"
"</qt>"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 181
#: rc.cpp:1124
#, no-c-format
msgid "Ask &before signing each part"
msgstr "प्रत्येक भागमा साइनिङ गर्नु भन्दा पहिले सोध्नुहोस्"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 184
#: rc.cpp:1128
#, no-c-format
msgid "Check to be asked for each part whether to sign"
msgstr "प्रत्येक भागमा चिनो लगाउन वा नलगाउन लागि सोध्नका लागि चेक गर्नुहोस्"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 190
#: rc.cpp:1132
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Ask Before Signing Each Part</h1>\n"
"When this option is selected, you will be asked for each part of the message "
"(i.e. the main message body as well as all attachments) individually whether "
"you want the part to be signed.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>प्रत्येक भागमा साइनिङ गर्नुभन्दा पहिला सोध्नुहोस्</h1>\n"
"यो विकल्प चयन गरिएमा, तपाईँलाई सन्देशको प्रत्येक भागमा (जस्तै: सन्देशको मुख्य भाग तथा सबै "
"सङ्लग्नता) एकल रुपमा चिन्ह लगाउन चाहने वा नचाहने सोधिने छ ।\n"
"</qt>"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 198
#: rc.cpp:1139
#, no-c-format
msgid "Do no&t sign messages"
msgstr "सन्देशमा चिन्ह नलगाउनुहोस्"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 201
#: rc.cpp:1143
#, no-c-format
msgid "Check for not signing a message by default"
msgstr "पूर्वनिर्धारित रुपमा सन्देशमा चिन्ह नलगाउनका लागि चेक गर्नुहोस्"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 209
#: rc.cpp:1147
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Do Not Sign Messages</h1>\n"
"If this option is selected, messages are not signed by default.\n"
"<p>\n"
"This is a default setting, you can still override it for each individual "
"setting.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>सन्देशमा चिन्ह नलगाउनुहोस्</h1>\n"
"यो विकल्प चयन गरिएमा, सन्देश पूर्वनिर्धारित अनुरुप चिन्ह लगाइने छैनन् ।\n"
"<p>\n"
"यो पूर्वनिर्धारित सेटिङ हो, तपाईँले अझैपनि यसलाई प्रत्येक एकल सेटिङका लागि अधिरोहण गर्न "
"सक्नुहुन्छ ।\n"
"</qt>"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 217
#: rc.cpp:1156
#, no-c-format
msgid ""
"The signature certificate is configured on the <em>Certificates</em> page."
msgstr "हस्ताक्षर प्रमाणपत्र <em>प्रमाणपत्र</em> पृष्ठमा कन्फिगर गरिएको छ ।"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 226
#: rc.cpp:1160
#, no-c-format
msgid "RSA + SHA-1"
msgstr "RSA + SHA-1"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 233
#: rc.cpp:1164
#, no-c-format
msgid "Selects the signature algorithm"
msgstr "हस्ताक्षर अलगोरिदम चयन गर्छ"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 243
#: rc.cpp:1168
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Signature Algorithm</h1>\n"
"An algorithm is a description for the computer on how it should perform a "
"certain task. The signature algorithm describes how the computer applies "
"your signature key to your message so that the receiver can determine "
"whether the message really is from you.\n"
"<p>\n"
"The selection of a certain signature algorithm determines how easy or how "
"difficult it is to forge a message. However, all algorithms provided in the "
"SPHINX environment are considered to be very safe. Generally, the default "
"will work just fine here.\n"
"<p>\n"
"This setting is a default, you can override it for each individual message.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>हस्ताक्षर अलगोरिदम</h1>\n"
"एउटा अलगोरिदम कम्प्युटरले निश्चित कार्य सम्पादनका गर्ने तरिकाको वर्णन हो । हस्ताक्षर "
"अलगोरिदमले तपाईँको सन्देशका लागि कम्प्युटरले कसरी हस्ताक्षर कुञ्जी लागू गर्छ जसले गर्दा "
"प्रापकले सन्देश वास्तवमै तपाईँबाट आएको वा नआएको निर्धारण गर्न सक्छ ।\n"
"<p>\n"
"निश्चित हस्ताक्षर अलगोरिदमको चयनले सन्देश कति सजिलो वा असजिलो तरिकाले नक्कल गर्न "
"सकिन्छ निर्धारण गर्छ । तापनि SPHINX परिवेशमा उपलब्ध अलगोरिदम धेरै सुरक्षित हुने ठानिन्छ "
"। साधारणतया, पूर्वनिर्धारितले यहाँ राम्रो कार्य गर्नेछ ।\n"
"<p>\n"
"यो पूर्वनिर्धारित सेटिङ हो, तपाईँले यसलाई प्रत्येक एकल सन्देशका लागि अधिरोहण गर्न सक्नुहुन्छ "
"।\n"
"</qt>"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 251
#: rc.cpp:1179
#, no-c-format
msgid "Signature &algorithm:"
msgstr "हस्ताक्षर अलगोरिदम:"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 265
#: rc.cpp:1183
#, no-c-format
msgid "&Store messages with signatures"
msgstr "हस्ताक्षर भएका सन्देश भण्डारण गर्छ"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 271
#: rc.cpp:1187
#, no-c-format
msgid "Check to store messages with their signatures"
msgstr "सन्देश तिनका हस्ताक्षरसँग भण्डारण गर्न चेक गर्नुहोस्"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 277
#: rc.cpp:1191
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Store Messages With Signatures</h1>\n"
"When this box is checked, sent messages are stored together with the "
"signatures applied to them. This is recommended, because it enables you to "
"check later whether you signed a message or a certain part of it.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>हस्ताक्षर भएका सन्देश भण्डारण गर्नुहोस्</h1>\n"
"यो बाकस जाँच गरेको बेलामा, पठाएका सन्देश तिनलाई लागू गरिएका हस्ताक्षर सँगसँगै भण्डारण "
"गरिन्छन् । यो सिफारिस गरिएको छ, किनभने यसले तपाईँलाई सन्देशमा वा यसको केही भागमा "
"चिन्ह लगाएको वा नलगाएको जाँच गर्न सक्षम पार्छ ।\n"
"</qt>"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 303
#: rc.cpp:1199
#, no-c-format
msgid "Compound mode:"
msgstr "मिश्रित मोड:"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 319
#: rc.cpp:1203
#, no-c-format
msgid "Standa&rd MIME"
msgstr "मानक माइम"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 322
#: rc.cpp:1207
#, no-c-format
msgid "A Multipart/Signed holding Signature and signed data."
msgstr "एउटा मल्टिपार्ट/चिन्ह लगाइएको राख्ने हस्ताक्षर र चिन्ह लगाइएको लगत ।"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 328
#: rc.cpp:1211
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Multipart detached signature</h1>\n"
"When this option is selected, the signature and the signed data will be "
"separate parts of a Multipart/Signed message part. Signed message data will "
"be readable even by Mail User Agents not supporting the signaturing "
"algorithm and not supporting ASN.1 decoding.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>मल्टिपार्ट पत्ता लगाइएको हस्ताक्षर</h1>\n"
"यो विल्प चयन गरेको छ भने, हस्ताक्षर र चिन्ह लगाइएको लगत मल्टिपार्ट/चिन्ह लगाइएको सन्देश "
"भागको फरक भाग हुनेछ । चिन्ह लगाइएका सन्देश लगत पढ्नयोग्य हुनेभए पनि मेल प्रयोगकर्ता "
"अभिकर्ताद्वारा हस्ताक्षर अलगोरिदम र ASN.1 डिकोडिङ समर्थन गर्दैन ।\n"
"</qt>"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 344
#: rc.cpp:1218
#, no-c-format
msgid "Opa&que (only recommended for SPHINX)"
msgstr "अपारदर्शी (SPHINX का लागि मात्र सिफारिस)"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 347
#: rc.cpp:1222
#, no-c-format
msgid "Signature and signed data encoded in one ASN.1 block."
msgstr "हस्ताक्षर चिन्ह लगाइएका लगत एउटा ASN.1 खण्डमा सङ्केतन गरियो ।"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 353
#: rc.cpp:1226
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Opaque signed messages</h1>\n"
"When this option is selected, both the signature and the signed data will be "
"encoded into one ASN.1 block. Messages will be readable only by Mail User "
"Agents supporting ASN.1 decoding.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>चिन्ह लगाएका अपारदर्शी सन्देश</h1>\n"
"यो विकल्प चयन गरिएको छ भने, दुबै हस्ताक्षर र चिन्ह लगाएका लगत एउटा ASN.1 खण्डमा "
"सङ्केतन गरिने छन् । सन्देश ASN.1 समर्थन गर्ने मेल प्रयोगकर्ता अभिकर्ताले मात्र पढ्ने योग्य "
"हुनेछन् ।\n"
"</qt>"

