#. i18n: file encryptionconfigurationdialog.ui line 513
#: rc.cpp:382 rc.cpp:416
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Warn If Certificate Expires</h1>\n"
"If this option is checked, then you will be warned when trying to use a "
"certificate for encrypting that expires within the specified amount of "
"days.\n"
"<p>\n"
"It is recommended to keep this option turned on to avoid using certificates "
"that expire in the near future.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>प्रमाणपत्र समाप्त भएमा चेतावनी दिनुहोस्</h1>\n"
"यो विकल्प चेक गरिएको छ भने, निर्दिष्ट गरिएका दिनमा समाप्त हुने प्रमाणपत्रको तपाईँले "
"गुप्तिकरणका लागि प्रयोग गर्ने प्रयास गर्दा चेतावनी दिनेछ ।\n"
"<p>\n"
"निकट भविश्यमा समाप्त हुने प्रमाणपत्रको प्रयोग हटाउन यो विकल्प खुला राख्न सिफारिस "
"गरिएको छ ।\n"
"</qt>"

#. i18n: tag string
#. i18n: file encryptionconfigurationdialog.ui line 492
#. i18n: tag string
#. i18n: file warningconfiguration.ui line 167
#: rc.cpp:399 rc.cpp:1695
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Warn If Encryption Certificate Expires</h1>\n"
"Select the minimum number of days the encryption certificate should be valid "
"without issuing a warning.\n"
"<p>\n"
"The recommended SPHINX setting is 14 days.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>गुप्तिकरण प्रमाणपत्र समाप्त भएमा चेतावनी दिनुहोस्</h1>\n"
"चेतावनी जारी नगरिकन गुप्तिकरण प्रमाणपत्र वैध हुनुपर्ने न्यूनतम दिनका सङ्ख्या चयन गर्नुहोस् ।\n"
"<p>\n"
"सिफारिस गरिएको SPHINX सेटिङ १४ दिन हो ।\n"
"</qt>"

#. i18n: tag string
#. i18n: file encryptionconfigurationdialog.ui line 499
#: rc.cpp:408
#, no-c-format
msgid "Warn if &receiver certificate expires in less than:"
msgstr "यो भन्दा कम समयमा प्रापक प्रमाणपत्र समाप्त भएमा चेतावनी दिनुहोस्:"

#. i18n: tag string
#. i18n: file encryptionconfigurationdialog.ui line 536
#: rc.cpp:425
#, no-c-format
msgid "Warn if receiver's email address is &not in certificate"
msgstr "प्रापकको इमेल ठेगाना प्रमाणपत्रमा नभएमा चेतावनी दिनुहोस्"

#. i18n: tag string
#. i18n: file encryptionconfigurationdialog.ui line 542
#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 726
#. i18n: tag string
#. i18n: file warningconfiguration.ui line 67
#: rc.cpp:429 rc.cpp:1429 rc.cpp:1645
#, no-c-format
msgid "Check to be warned if the address is not in the certificate"
msgstr "प्रापकको इमेल ठेगाना प्रमाणपत्रमा नभएमा चेतावनी दिनका लागि जाँच गर्नुहोस्"

#. i18n: tag string
#. i18n: file encryptionconfigurationdialog.ui line 550
#. i18n: tag string
#. i18n: file warningconfiguration.ui line 75
#: rc.cpp:433 rc.cpp:1649
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Warn If Receiver's Email Address Is Not In Certificate</h1>\n"
"If this option is checked, a warning is issued if the email address of the "
"receiver is not contained in the certificate used for encrypting.\n"
"<p>\n"
"It is recommended to leave this option turned on for maximum security.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>प्रापकको इमेल ठेगाना प्रमाणपत्रमा नभएमा चेतावनी दिनुहोस्</h1>\n"
"यो विकल्प जाँच गरिएमा, यदि प्रापकको इमेल ठेगाना गुप्तिकरणका लागि प्रयोग गरिएको "
"प्रमाणपत्रमा समावेश भएको नभएमा एउटा चेतावनी निष्कासन गरिने छ ।\n"
"<p>\n"
"अधिकतम सुरक्षाका लागि यो विकल्प खोलेर छोड्न सिफारिस गरिन्छ ।\n"
"</qt>"

