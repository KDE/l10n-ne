#. i18n: file signatureconfigurationdialog.ui line 404
#: rc.cpp:1234
#, no-c-format
msgid "Entering PIN is required:"
msgstr "PIN प्रविष्टको आवश्यकता:"

#. i18n: tag string
#. i18n: file signatureconfigurationdialog.ui line 412
#: rc.cpp:1238
