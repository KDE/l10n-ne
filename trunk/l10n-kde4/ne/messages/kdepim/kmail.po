#. i18n: tag string
#. i18n: file encryptionconfigurationdialog.ui line 307
#: rc.cpp:295
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Warn If CRL Expires In The Near Future</h1>\n"
"If this box is checked, you will be warned if one of the CRLs you are using "
"is about to expire in the near future.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>CRL निकट भविश्यमा समाप्त हुदा चेतावनी दिनुहोस्</h1>\n"
"यो बाकस जाँच गरिएमा, तपाईँले प्रयोग गरिराखेका CRL मध्यको एउटा CRL निकट भविश्यमा "
"समाप्त हुने भएमा सावधानी गराउने छ ।\n"
"</qt>"

