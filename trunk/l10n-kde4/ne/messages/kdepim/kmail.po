msgstr "यी नेमस्पेसले अन्य प्रयोगकर्ताका फोल्डर समावेश गर्दछन् ।"

#: accountdialog.cpp:924 accountdialog.cpp:2227
msgid "Shared"
msgstr "साझा"

#: accountdialog.cpp:925
msgid "These namespaces include the shared folders."
msgstr "यी नेमस्पेसले साझा फोल्डर समावेश गर्दछन् ।"

