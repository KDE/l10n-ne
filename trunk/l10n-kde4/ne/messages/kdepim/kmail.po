#: kmmsgpartdlg.cpp:98
#, qt-format
msgid ""
"<qt><p>The <em>MIME type</em> of the file:</p><p>normally, you do not need "
"to touch this setting, since the type of the file is automatically checked; "
"but, sometimes, %1 may not detect the type correctly -- here is where you "
"can fix that.</p></qt>"
msgstr ""
"<qt><p> फाइलको<em>MIME प्रकार</em>:</p><p>सामान्यतया, फाइल प्रकार स्वचालित रुपमा "
"जाँच भएसम्म; तपाईँलाई यो सेटिङ छुन आवश्यक हुदैन, तर, कहिलेकाही तपाईँले त्यसलाई निश्चित "
"गर्ने ठाउमा %1 ले टाइप ठीक तरिकाले पत्ता नलगाउन सक्छ ।</p></qt>"

#: kmmsgpartdlg.cpp:110
#, qt-format
msgid ""
"<qt><p>The size of the part:</p><p>sometimes, %1 will only give an estimated "
"size here, because calculating the exact size would take too much time; when "
"this is the case, it will be made visible by adding \"(est.)\" to the size "
"displayed.</p></qt>"
msgstr ""
"<qt><p>खण्डको साइज:</p><p>कहिलेकाही, %1 ले यहाँ अनुमानित साइज मात्र दिन्छ, किनभने "
"दुरुस्त साइज गणना गर्दा प्रशस्त समय लिनेछ; यो अवस्थामा, प्रदर्शित हुने साइजमा \"(est.)\" "
"थपेर यसलाई दृश्यात्मक बनाइनेछ ।</p></qt>"

#: kmmsgpartdlg.cpp:125
msgid ""
"<qt><p>The file name of the part:</p><p>although this defaults to the name "
"of the attached file, it does not specify the file to be attached; rather, "
"it suggests a file name to be used by the recipient's mail agent when saving "
"the part to disk.</p></qt>"
msgstr ""
"<qt><p>खण्डको फाइल नाम:</p><p>यसले सङ्लग्न फाइलको नाम पूर्वनिर्धारण गरे पनि, यसले "
"सङ्लग्न हुने फाइलको निर्दिष्ट गर्दैन; यद्यपि, यसले खण्डलाई चक्कामा बचत गर्दा प्रापकको मेल "
"अभिकर्ताद्वारा प्रयोग गरिने फाइल नाम सुझाव गर्छ ।</p></qt>"

#: kmmsgpartdlg.cpp:135
msgid "&Description:"
msgstr "वर्णन:"

#: kmmsgpartdlg.cpp:140
msgid ""
"<qt><p>A description of the part:</p><p>this is just an informational "
"description of the part, much like the Subject is for the whole message; "
"most mail agents will show this information in their message previews "
"alongside the attachment's icon.</p></qt>"
msgstr ""
"<qt><p>खण्डको वर्णन:</p><p>यो खण्डको सूचनात्मक वर्णन मात्र हो, धेरै मिल्ने विषयवस्तु पुरा "
"सन्देशका लागि हो; धेरै मेल अभिकर्ताले सङ्लग्नताको प्रतिमा साथै तिनका सन्देश पूर्वावलोकनमा "
"यो सूचना देखाउनेछन् ।</p></qt>"

#: kmmsgpartdlg.cpp:152
msgid "&Encoding:"
msgstr "सङ्केतन:"

#: kmmsgpartdlg.cpp:157
#, qt-format
msgid ""
"<qt><p>The transport encoding of this part:</p><p>normally, you do not need "
"to change this, since %1 will use a decent default encoding, depending on "
"the MIME type; yet, sometimes, you can significantly reduce the size of the "
"resulting message, e.g. if a PostScript file does not contain binary data, "
"but consists of pure text -- in this case, choosing \"quoted-printable\" "
"over the default \"base64\" will save up to 25% in resulting message size.</"
"p></qt>"
msgstr ""
"<qt><p>यो भागको सवारी सङ्केतन:</p><p>सामान्यतया, %1 ले एमआईएमई प्रकारमा निर्भर, "
"उचित पूर्वनिर्धारित सङ्केतन प्रयोग नगरेसम्म, तपाईँले यसलाई परिवर्तन गर्नु आवश्यक हुदैन; तै "
"पनि, कहिलेकाहि, तपाईँले परिणाम सन्देशको साइज सार्थक रुपमा घटाउन सक्नुहुन्छ, जस्तै; यदि "
"पोस्टस्क्रिप्ट फाइलले बाइनरि लगत समावेश गर्दैन, तर शुद्ध पाठको समावेश गर्छ भने -- यो "
"अवस्थमा, परिणाम सन्देश साइजमा रोजिने \"उद्धरण गरिएको मुद्रणयोग्य\" मा पूर्वनिर्धारित "
"\"base64\" २५% प्रतिशतमा बचत हुन्छ ।</p></qt>"

#: kmmsgpartdlg.cpp:170
msgid "Suggest &automatic display"
msgstr "स्वचालित प्रदर्शन सुझाव गर्नुहोस्"

#: kmmsgpartdlg.cpp:173
msgid ""
"<qt><p>Check this option if you want to suggest to the recipient the "
"automatic (inline) display of this part in the message preview, instead of "
"the default icon view;</p><p>technically, this is carried out by setting "
"this part's <em>Content-Disposition</em> header field to \"inline\" instead "
"of the default \"attachment\".</p></qt>"
msgstr ""
"<qt><p>प्रापकलाई तपाईँले पूर्वनिर्धारित प्रतिमा दृश्यको साटोमा, सन्देश पूर्वावलोकनमा यो "
"भागको स्वचालित (इनलान) प्रदर्शन सुझाव गर्न चाहनुहुन्छ भने यो विकल्प जाँच गर्नुहोस्;</"
"p><p>प्राबिधिक रुपमा, यसलाई यो भागको <em>सामाग्री सजावट</em> द्वारा हेडर फिल्डलाई "
"पूर्वनिर्धारित \"सङ्लग्नता\" को साटोमा \"इनलाइन\" मा सेटिङ गरेर देखाइन्छ ।</p></qt>"

#: kmmsgpartdlg.cpp:182
msgid "&Sign this part"
msgstr "यो खण्डमा चिन्ह लगाउनुहोस्"

#: kmmsgpartdlg.cpp:185
msgid ""
"<qt><p>Check this option if you want this message part to be signed;</"
"p><p>the signature will be made with the key that you associated with the "
"currently-selected identity.</p></qt>"
msgstr ""
"<qt><p>तपाईँ यो सन्देश खण्ड हस्ताक्षरित रुपमा चाहनुहुन्छ भने यो विल्प चेक गर्नुहोस्;</"
"p><p>हस्ताक्षर तपाईँले हालै चयन गरेका परिचयसँग सम्बन्धित कुञ्जीले बनेको हुनेछ ।</p></qt>"

#: kmmsgpartdlg.cpp:192
