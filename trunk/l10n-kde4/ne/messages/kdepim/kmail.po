#. i18n: file: warningconfiguration.ui:19
#. i18n: ectx: property (text), widget (QCheckBox, mWarnUnsigned)
#: rc.cpp:1083
msgid "Warn when trying to send &unsigned messages"
msgstr "चिन्ह नलगाएका सन्देश पठाउने प्रयासमा चेतावनी दिनुहोस्"

#. i18n: file: warningconfiguration.ui:25
#. i18n: ectx: property (toolTip), widget (QCheckBox, mWarnUnsigned)
#: rc.cpp:1086
msgid "Check to be warned when sending unsigned messages."
msgstr "चिन्ह नलगाएका सन्देश पठाउदा चेतावनी दिन चेक गर्नुहोस्"

#. i18n: file: warningconfiguration.ui:33
#. i18n: ectx: property (whatsThis), widget (QCheckBox, mWarnUnsigned)
#: rc.cpp:1089
msgid ""
"<qt>\n"
"<h1>Warn When Trying To Send Unsigned Messages</h1>\n"
"If this box is checked, you will be warned when you try to send parts of or "
"the whole message unsigned.\n"
"<p>\n"
"It is recommended to leave this option turned on for maximum integrity.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>चिन्ह नलगाएका सन्देश पठाउने प्रयासमा चेतावनी दिनुहोस्</h1>\n"
"यो बाकस जाँचिएको छ भने, तपाईँले सन्देश पूरै वा केही भाग चन्ह नलगाई पठाउने प्रयास गर्दा "
"चेतावनी दिनेछ ।\n"
"<p>\n"
"अधिकतम शुद्धताका लागि यो विकल्प खोलेर छोड्न सिफारिस गरिन्छ ।\n"
"</qt>"

#. i18n: file: warningconfiguration.ui:40
#. i18n: ectx: property (text), widget (QCheckBox, warnUnencryptedCB)
#: rc.cpp:1097
msgid "&Warn when trying to send unencrypted messages"
msgstr "गुप्तिकरण नगरिएका सन्देश पठाउने प्रयास गर्दा चेतावनी दिनुहोस्"

#. i18n: file: warningconfiguration.ui:46
#. i18n: ectx: property (toolTip), widget (QCheckBox, warnUnencryptedCB)
#: rc.cpp:1100
msgid "Check to be warned when sending unencrypted messages."
msgstr "गुप्तिकरण नगरिएका सन्देश पठाउदा चेतावनी दिनका लागि जाँच गर्नुहोस् ।"

#. i18n: file: warningconfiguration.ui:54
#. i18n: ectx: property (whatsThis), widget (QCheckBox, warnUnencryptedCB)
#: rc.cpp:1103
msgid ""
"<qt>\n"
"<h1>Warn When Trying To Send Unencrypted Messages</h1>\n"
"If this box is checked, you will be warned when you try to send parts of or "
"the whole message unencrypted.\n"
"<p>\n"
"It is recommended to leave this option turned on for maximum integrity.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>गुप्तिकरण नगरिएका सन्देश पठाउने प्रयास गर्दा चेतावनी दिनुहोस्</h1>\n"
"यो बाकस जाँच गरिएमा, तपाईँले केही भाग वा सम्पूर्ण सन्देश गुप्तिकरण नगरि पठाउने प्रयास "
"गर्दा चेतावनी दिनेछ ।\n"
"<p>\n"
"अधिकतम शुद्धताका लागि यो विकल्प खोलेर छोड्न सिफारिस गरिन्छ ।\n"
"</qt>"

#. i18n: file: warningconfiguration.ui:61
#. i18n: ectx: property (text), widget (QCheckBox, warnReceiverNotInCertificateCB)
