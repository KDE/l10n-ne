#. i18n: tag string
#. i18n: file encryptionconfigurationdialog.ui line 387
#: rc.cpp:327
#, no-c-format
msgid ""
"<qt>\n"
"<h1>Always encrypt to self</h1>\n"
"If this box is checked, encrypted messages sent by you will also be "
"encrypted using your own key.\n"
"<p>\n"
"It is recommended to leave this option turned on to enable you to read the "
"messages you have sent.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>सधै आफै गुप्तिकृत गराउनुहोस्</h1>\n"
"यो बाकस जाँच गरिएको छ भने, तपाईँले पठाएका गुप्तिकृत कुञ्जी पनि आफ्ना कुञ्जी प्रयोग गरेर "
"गुप्तिकृत हुनेछन् ।\n"
"<p>\n"
"तपाईँले पठाएका सन्देश पढ्न आफैलाई सक्षम पार्न यो विकल्प खोलेर छोड्न सिफारिस गरिएको छ ।\n"
"</qt>"

