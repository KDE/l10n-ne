#: main.cpp:73
msgid "Print helpful runtime messages"
msgstr "सहयोगी सञ्चालन समय सन्देश मुद्रण गर्नुहोस्"

#: main.cpp:75
msgid "Print what would have been done, but do not execute"
msgstr "के गर्नुपर्ने हो मुद्रण गर्नुहोस्, तर कार्यान्वयन नगर्नुहोस्"

#: main.cpp:77
msgid "Specify which calendar you want to use"
msgstr "तपाईँ कुन क्यालेन्डर प्रयोग गर्न चाहनुहुन्छ निर्दिष्ट गर्नुहोस्"

#: main.cpp:80
msgid "Incidence types (these options can be combined):"
msgstr "भार प्रकार (यी विकल्प संयोजन गर्न सकिन्छ):"

#: main.cpp:82
msgid "  Operate for Events only (Default)"
msgstr "  (पूर्वनिर्धारित) घटनाको लागि मात्र सञ्चालन गर्नुहोस्"

#: main.cpp:84
msgid "  Operate for To-dos only [NOT WORKING YET]"
msgstr "  [अहिलेसम्म काम नगरेका] गर्नु पर्ने कार्यका लागि मात्र सञ्चालन गर्नुहोस्"

#: main.cpp:86
msgid "  Operate for Journals only [NOT WORKING YET]"
msgstr "  [अहिलेसम्म काम नगरेका] पत्रिकाको लागि मात्र सञ्चालन गर्नुहोस्"

#: main.cpp:89
msgid "Major operation modes:"
msgstr "मुख्य सञ्चालन मोड:"

#: main.cpp:91
msgid "  Print incidences in specified export format"
msgstr "  निर्दिष्ट गरिएको निर्यात ढाँचामा भार मुद्रण गर्नुहोस्"

#: main.cpp:93
msgid "  Insert an incidence into the calendar"
msgstr "  क्यालेन्डरमा एउटा भार घुसाउनुहोस्"

#: main.cpp:95
msgid "  Modify an existing incidence"
msgstr "  एउटा अवस्थित भार परिमार्जन गर्नुहोस्"

#: main.cpp:97
msgid "  Remove an existing incidence"
msgstr "  एउटा अवस्थित भार हटाउनुहोस्"

#: main.cpp:99
msgid "  Create new calendar file if one does not exist"
msgstr "  यदि एउटा अवस्थित छैन भने नयाँ क्यालेन्डर फाइल सिर्जना गर्नुहोस्"

#: main.cpp:101
msgid "  Import this calendar to main calendar"
msgstr "  मुख्य क्यालेन्डरमा यो क्यालेन्डर आयात गर्नुहोस्"

#: main.cpp:103
msgid "Operation modifiers:"
msgstr "सञ्चालन परिमार्जक:"

#: main.cpp:105
#, fuzzy
msgid "  View all calendar entries, ignoring date/time options"
msgstr "  सबै क्यालेन्डर प्रविष्टि हेर्नुहोस्"

#: main.cpp:107
msgid "  View next activity in calendar"
msgstr "  क्यालेन्डरमा पछिल्लो क्रियाकलाप हेर्नुहोस्"

#: main.cpp:109
msgid "  From start date show next # days' activities"
msgstr "  सुरु मितिबाट पछिल्लो # दिनको क्रियाकलाप देखाउनुहोस्"

#: main.cpp:111
msgid "  Incidence Unique-string identifier"
msgstr "  भार युनिक-स्ट्रिङ पहिचायक"

#: main.cpp:113
msgid "  Start from this day [YYYY-MM-DD]"
msgstr "  यो दिनबाट सुरु गर्नुहोस् [वर्ष-महिना-दिन]"

#: main.cpp:115
msgid "  Start from this time [HH:MM:SS]"
msgstr "  यो समयबाट सुरु गर्नुहोस् [घण्टा:मिनेट:सेकेन्ड]"

#: main.cpp:117
msgid "  End at this day [YYYY-MM-DD]"
msgstr "  यो दिनमा समाप्त गर्नुहोस् [वर्ष-महिना-दिन]"

#: main.cpp:119
msgid "  End at this time [HH:MM:SS]"
msgstr "  यो समय अन्त्य गर्नुहोस् [घण्टा:मिनेट:सेकेन्ड]"

#: main.cpp:121
msgid " Start from this time [secs since epoch]"
msgstr " यो समयबाट सुरु गर्नुहोस् [अवधिदेखि सेकेन्ड]"

#: main.cpp:123
msgid "  End at this time [secs since epoch]"
msgstr "  यो समयमा अन्त्य गर्नुहोस् [अवधिदेखि सेकेन्ड]"

#: main.cpp:125
msgid "  Add summary to incidence (for add/change modes)"
msgstr "  (मोड थप्न/परिवर्तन गर्नका लागि) भारमा सारांश थप्नुहोस्"

#: main.cpp:127
msgid "Add description to incidence (for add/change modes)"
msgstr "(मोड थप्न/परिवर्तन गर्नका लागि) भारमा वर्णन थप्नुहोस्"

#: main.cpp:129
msgid "  Add location to incidence (for add/change modes)"
msgstr "  (मोड थप्न/परिवर्तनका लागि) भारमा स्थान थप्नुहोस्"

#: main.cpp:131
msgid "Export options:"
msgstr "विकल्प निर्यात गर्नुहोस्:"

#: main.cpp:133
msgid "Export file type (Default: text)"
msgstr "फाइल प्रकार निर्यात गर्नुहोस् (पूर्वानिर्धारित: पाठ)"

#: main.cpp:135
msgid "Export to file (Default: stdout)"
msgstr "फाइलमा निर्यात गर्नुहोस् (पूर्वानिर्धारित: stdout)"

#: main.cpp:137
msgid "  Print list of export types supported and exit"
msgstr "  निर्यात प्रकारको मुद्रण सूची समर्थन गरियो र बन्द गरियो"

#: main.cpp:140
msgid ""
"Examples:\n"
"  konsolekalendar --view\n"
"  konsolekalendar --add --date 2003-06-04 --time 10:00 --end-time 12:00 \\\n"
"                  --summary \"Doctor Visit\" --description \"Get My Head "
"Examined\"\n"
"  konsolekalendar --delete --uid KOrganizer-1740326.803"
msgstr ""
"उदाहरण:\n"
"  कन्सोलक्यालेन्डर --हेर्नुहोस्\n"
"  कन्सोलक्यालेन्डर --थप्नुहोस् --मिति २००३-०६-०४ --समय १०:०० --समाप्ति समय १२:०० \\\n"
"                  --सारांश \"डाक्टरको भ्रमण\" --वर्णन \"मेरो टाउकोको परीक्षण\"\n"
"  कन्सोलक्यालेन्डर --मेट्नुहोस् --यूआईडी केडीई आयोजक-१७४०३२६.८०३"

#: main.cpp:149
msgid ""
"For more information visit the program home page at:\n"
"  http://pim.kde.org/components/konsolekalendar.php"
msgstr ""
"धेरै जानकारीका लागि:\n"
"  http://pim.kde.org/components/konsolekalendar.php को गृहपृष्ठ कार्यक्रम हेर्नुहोस्"

