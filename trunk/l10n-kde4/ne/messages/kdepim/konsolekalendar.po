#: main.cpp:107
msgid "Incidence types (these options can be combined):"
msgstr "इन्सिडेन्स प्रकार (यी विकल्प संयोजन गर्न सकिन्छ):"

#: main.cpp:109
msgid "  Operate for Events only (Default)"
msgstr "  घटनाको लागि मात्र सञ्चालन गर्नुहोस् (पूर्वनिर्धारित)"

#: main.cpp:111
msgid "  Operate for To-dos only [NOT WORKING YET]"
msgstr "  गर्नु पर्ने कार्यका लागि मात्र सञ्चालन गर्नुहोस् [अहिलेसम्म काम नगरेका]"

#: main.cpp:113
msgid "  Operate for Journals only [NOT WORKING YET]"
