#: karm_part.cpp:267 mainwindow.cpp:352
msgid ""
"This will bring up a dialog box where you may edit the parameters for the "
"selected task."
msgstr "यसले चयन गरिएका कार्यका लागि तपाईँले परिमिति सम्पादन गर्न सक्ने संवाद बाकस ल्याउनेछ ।"

#: karm_part.cpp:276
