#: text_calendar.cpp:225
#, qt-format
msgid "Answer: %1"
msgstr "उत्तर: %1"

#: text_calendar.cpp:227
msgid "Answer: Incidence with no summary"
msgstr "उत्तर: सारांश नभएको घटना"

#: text_calendar.cpp:238
msgid "Could not save file to KOrganizer"
msgstr "केडीई आयोजकमा फाइल बचत गर्न सकेन"

#: text_calendar.cpp:355
msgid "Accept incidence"
msgstr "घटना स्वीकार गर्नुहोस्"

#: text_calendar.cpp:357
msgid "Accept incidence conditionally"
msgstr "ससर्त घटना स्वीकार गर्नुहोस्"

#: text_calendar.cpp:359
msgid "Throw mail away"
msgstr "मेल टाढा फ्याक्नुहोस्"

#: text_calendar.cpp:361
msgid "Decline incidence"
msgstr "घटना घटाउनुहोस्"

#: text_calendar.cpp:363
msgid "Check my calendar..."
msgstr "मेरो क्यालेन्डर जाँच गर्नुहोस्..."

#: text_calendar.cpp:365
msgid "Enter incidence into my calendar"
msgstr "मेरो क्यालेन्डरमा घटना प्रविष्ट गर्नुहोस्"

#: text_calendar.cpp:367
msgid "Remove incidence from my calendar"
msgstr "मेरो क्यालेन्डरबाट घटना हटाउनुहोस्"
