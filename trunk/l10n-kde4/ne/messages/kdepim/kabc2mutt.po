#: kabc2mutt.cpp:116
msgid "preferred"
msgstr "रुचाइएका"

#: main.cpp:30
msgid "kabc2mutt"
msgstr "kabc2mutt"

#: main.cpp:31
msgid "kabc - mutt converter"
msgstr "kabc - मट रुपान्तरणकर्ता"

#: main.cpp:35
msgid "Only show contacts where name or address matches <substring>"
msgstr "नाम वा ठेगाना मिल्ने ठाउमा मात्र सम्पर्क देखाउछ <substring>"

#: main.cpp:36
msgid ""
"Default format is 'alias'. 'query' returns email<tab>name<tab>, as needed by "
"mutt's query_command"
msgstr ""
"पूर्वनिर्धारित ढाँचा 'उपनाम' हो । 'क्वेरी' ले, मटको क्वरी आदेशमा आवश्यक भए अनुरुपको "
"इमेल<tab>नाम<tab> पठाउछ ।"

#: main.cpp:37
msgid "Default key format is 'JohDoe', this option turns it into 'jdoe'"
msgstr "पूर्वनिर्धारित कूञ्जी ढाँचा 'JohDoe' हो, यो विकल्पले यसलाई 'jdoe' मा फर्काउछ"

#: main.cpp:38
msgid "Make queries case insensitive"
msgstr "क्वेरीको अवस्था असम्वेदनशील बनाउनुहोस्"

#: main.cpp:39
msgid "Return all mail addresses, not just the preferred one"
msgstr "रुचाइएको एक मात्र नभइ, सबै मेल ठेगाना फर्काउछ"

#: main.cpp:70
msgid "Searching KDE addressbook"
msgstr "केडीई ठेगाना पुस्तिका खोजी गर्दैछ"
