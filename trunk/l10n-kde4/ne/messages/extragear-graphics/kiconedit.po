msgstr "\"%1\" नामकरण गरिएको फाइल पहिल्यै अवस्थित छ । यसलाई अधिलेखन गर्नुहुन्छ?"

#: kiconediticon.cpp:213
#, kde-format
msgid "Overwrite File?"
msgstr "फाइल अधिलेखन गर्नुहुन्छ ?"

#: kiconediticon.cpp:214
#, kde-format
msgid "&Overwrite"
msgstr "अधिलेखन गर्नुहोस्"

