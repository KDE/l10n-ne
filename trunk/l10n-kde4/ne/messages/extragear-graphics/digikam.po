#: libs/dimg/loaders/pngsettings.cpp:73
msgid "PNG compression:"
msgstr "PNG सङ्कुचन:"

#: libs/dimg/loaders/pngsettings.cpp:75
msgid ""
"<p>The compression value for PNG images:<p><b>1</b>: low compression (large "
"file size but short compression duration - default)<p><b>5</b>: medium "
"compression<p><b>9</b>: high compression (small file size but long "
"compression duration)<p><b>Note: PNG is always a lossless image compression "
"format.</b>"
msgstr ""
"<p>PNG छविका लागि सङ्कुचन मान:<p><b>1</b>: न्यून सङ्कुचन (ठूलो फाइल साइज तर छोटो "
"सङ्कुचन अवधि - पूर्वनिर्धारित)<p><b>५</b>: मध्यम सङ्कुचन<p><b>९</b>: उच्च सङ्कुचन (सानो "
"फाइल साइज तर लामो सङ्कुचन अवधि)<p><b>द्रष्टव्य: PNG सधै नोक्सान रहित छवि सङ्कुचन ढाँचा "
"हो ।</b>"

#: libs/dimg/loaders/tiffsettings.cpp:68
msgid "Compress TIFF files"
msgstr "TIFF फाइल सङ्कुचन गर्नुहोस्"

#: libs/dimg/loaders/tiffsettings.cpp:70
msgid ""
"<p>Toggle compression for TIFF images.<p>If you enable this option, you can "
"reduce the final file size of the TIFF image.</p><p>A lossless compression "
"format (Deflate) is used to save the file.<p>"
msgstr ""
"<p>TIFF छविका लागि सङ्कुचन टगल गर्नुहोस् ।<p>तपाईँले यो विकल्प सक्षम पार्नुभएमा, तपाईँले "
"TIFF छविको अन्तिम फाइल साइज घटाउन सक्नुहुन्छ । </p><p>नोक्सान रहित सङ्कुचन ढाँचा "
"(Deflate) फाइल बचत गर्न प्रयोग गरिन्छ ।<p>"

#: libs/dimg/loaders/jp2ksettings.cpp:75
msgid "LossLess JPEG 2000 files"
msgstr "नोक्सान रहित जेपीईजी २००० फाइल"

#: libs/dimg/loaders/jp2ksettings.cpp:77
msgid ""
"<p>Toggle lossless compression for JPEG 2000 images.<p>If you enable this "
"option, you will use a lossless method to compress JPEG 2000 pictures.<p>"
msgstr ""
"<p>जेपीईजी २००० छविका लागि नोक्सान रहित सङ्कुचन टलग गर्नुहोस् ।<p>तपाईँले यो विकल्प "
"सक्षम पार्नुभएमा, तपाईँले जेपीईजी २००० तस्विर सङ्कुचन गर्न नोक्सान रहित विधि प्रयोग "
"गर्नुहुन्छ ।<p>"

#: libs/dimg/loaders/jp2ksettings.cpp:83
msgid "JPEG 2000 quality:"
msgstr "जेपीईजी २००० गुणस्तर:"

#: libs/dimg/loaders/jp2ksettings.cpp:85
msgid ""
"<p>The quality value for JPEG 2000 images:<p><b>1</b>: low quality (high "
"compression and small file size)<p><b>50</b>: medium quality<p><b>75</b>: "
"good quality (default)<p><b>100</b>: high quality (no compression and large "
"file size)<p><b>Note: JPEG 2000 is not a lossless image compression format "
"when you use this setting.</b>"
msgstr ""
"<p>जेपीईजी २००० छविका लागि गुणस्तर मान:<p><b>१</b>: न्यन गुणस्तर (उच्च सङ्कुचन र सानो "
"फाइल साइज)<p><b>५०</b>: मध्यम गुणस्तर<p><b>७५</b>: राम्रो गुणस्तर (पूर्वनिर्धारित)"
"<p><b>१००</b>: उच्च गुणस्तर (सङ्कुचन हुँदैन र ठूलो फाइल साइज)<p><b>द्रष्टव्य: तपाईँले यो "
"सेटिङ प्रयोग गर्दा जेपीईजी २००० नोक्सान रहित छवि सङ्कुचन ढाँचा होइन ।</b>"

#: libs/dimg/loaders/jpegsettings.cpp:82
msgid "JPEG quality:"
msgstr "जेपीईजी गुणस्तर:"

#: libs/dimg/loaders/jpegsettings.cpp:84
#, fuzzy
#| msgid ""
#| "<p>The quality value for JPEG images:<p><b>1</b>: low quality (high "
#| "compression and small file size)<p><b>50</b>: medium quality<p><b>75</b>: "
#| "good quality (default)<p><b>100</b>: high quality (no compression and "
#| "large file size)<p><b>Note: JPEG use a lossy compression image algorithm."
#| "</b>"
msgid ""
"<p>The JPEG image quality:<p><b>1</b>: low quality (high compression and "
"small file size)<p><b>50</b>: medium quality<p><b>75</b>: good quality "
"(default)<p><b>100</b>: high quality (no compression and large file size)"
"<p><b>Note: JPEG always uses lossy compression.</b>"
msgstr ""
"<p>जेपीईजी छविका लागि गुणस्तर मान:<p><b>1</b>: न्यून गुणस्तर (उच्च सङ्कुचन र सानो फाइल "
"साइज)<p><b>५०</b>: मध्यम गुणस्तर<p><b>७५</b>: राम्रो गुणस्तर (पूर्वनिर्धारित)"
"<p><b>१००</b>: उच्च गुणस्तर (सङ्कुचन हुँदैन र ठूलो फाइल साइज)<p><b>द्रष्टव्य: जेपीईजीले "
"नोक्सान हुँने सङ्कुचन छवि एल्गोरिदम प्रयोग गर्दछ ।</b>"

#: libs/dimg/loaders/jpegsettings.cpp:93
msgid ""
"<qt><font size=-1 color=\"red\"><i>Warning: <a href='http://en.wikipedia.org/"
"wiki/JPEG'>JPEG</a> is a<br>lossy compression<br>image format!</p></i></qt>"
msgstr ""
"<qt><font size=-1 color=\"red\"><i>चेतावनी: <a href='http://en.wikipedia.org/"
"wiki/JPEG'>जेपीईजी</a> नोक्सान हुँने<br>छवि ढाँचा<br> हो!</p></i></qt>"

