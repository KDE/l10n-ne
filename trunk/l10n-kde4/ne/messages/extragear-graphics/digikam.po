#: digikam/main.cpp:95 digikam/welcomepageview.cpp:68
msgid "A Photo-Management Application for KDE"
msgstr "केडीईका लागि फोटो व्यवस्थापन अनुप्रयोग"

#: digikam/welcomepageview.cpp:100
msgid ""
"_: %1: digiKam version; %2: help:// URL; %3: homepage URL; %4: prior digiKam "
"version; %5: prior KDE version; %6: generated list of new features; %7: "
"First-time user text (only shown on first start); %8: generated list of "
"important changes; --- end of comment ---\n"
"<h2 style='margin-top: 0px;'>Welcome to digiKam %1</h2><p>digiKam is a "
"photo-management program for the K Desktop Environment. It is designed to "
"import, organize and export your digital photographs on your computer.</p>\n"
"<ul><li>digiKam has many powerful features which are described in the <a "
"href=\"%2\">documentation</a></li>\n"
"<li>The <a href=\"%3\">digiKam homepage</A> provides information about new "
"versions of digiKam</li></ul>\n"
"%8\n"
"<p>Some of the new features in this release of digiKam include (compared to "
"digiKam %4):</p>\n"
"<ul>\n"
"%5</ul>\n"
"%6\n"
"<p>We hope that you will enjoy digiKam.</p>\n"
"<p>Thank you,</p>\n"
"<p style='margin-bottom: 0px'>&nbsp; &nbsp; The digiKam Team</p>"
msgstr ""
"<h2 style='margin-top: 0px;'>डिजिक्याम %1 मा स्वागतम</h2><p>डिजिक्याम केडीईका लागि फोटो व्यवस्थापन गर्ने कार्यक्रम हो । यसलाई तपाईँको डिजिटल फोटोहरू कम्प्युटरमा आयात गर्न, मिलाउन र निर्यात गर्नका लागि डिजाइन गरिएको हो ।</p>\n"
"<ul><li>डिजिक्याममा रहेको धेरै राम्रो सुविधाहरू <a "
"href=\"%2\">मिसिलीकरण</a>मा वर्णन गरिएको छ ।</li>\n"
"<li> <a href=\"%3\">डिजिक्यामको गृहपृष्ठ</A> मा डिजिक्यामको नयाँ संस्करणका बारेमा सूचना प्रदान गरिन्छ </li></ul>\n"
"%8\n"
"<p>डिजिक्यामको संस्करणमा समावेश गरेको केहि नयाँ सुविधाहरूमा (डिजिक्याम %4 सँग तुलना गर्दा):</p>\n"
"<ul>\n"
"%5</ul>\n"
"%6\n"
"<p>तपाईँलाई डिजिक्याम उपयोगि हुन्छ भन्ने आशा राखेका छौ ।</p>\n"
"<p>धन्यवाद,</p>\n"
"<p style='margin-bottom: 0px'>&nbsp; &nbsp; डिजिक्याम समूह</p>"

