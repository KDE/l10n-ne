msgid "Math Expression Evaluator"
msgstr "गणित अभिव्यक्ति मूल्याङ्कनकर्ता"

#: parser.cpp:663
#, qt-format
msgid ""
"Parser error at position %1:\n"
"Missing parenthesis"
msgstr ""
"%1 स्थितिमा पद वर्णक त्रुटि:\n"
"प्यारेनथेसिस हराइरहेको छ"

#: parser.cpp:667
#, qt-format
msgid ""
"Parser error at position %1:\n"
"Function name unknown"
msgstr ""
"%1 स्थितिमा पद वर्णक त्रुटि:\n"
"प्रकार्य नाम अज्ञात"

#: parser.cpp:671
#, qt-format
msgid ""
"Parser error at position %1:\n"
"Void function variable"
msgstr ""
