"खाली स्थान प्रकार्य चल"

#: parser.cpp:675
#, qt-format
msgid ""
"Parser error at position %1:\n"
"Too many functions"
msgstr ""
"%1 स्थिति पद वर्णक त्रुटि:\n"
"अति धेरै प्रकार्य"

#: parser.cpp:679
#, qt-format
msgid ""
"Parser error at position %1:\n"
"Token-memory overflow"
msgstr ""
"%1 स्थितिमा पद वर्णक त्रुटि:\n"
"टोकन स्मृति अधिप्रवाह"

#: parser.cpp:683
#, qt-format
msgid ""
"Parser error at position %1:\n"
"Stack overflow"
msgstr ""
"%1 स्थितिमा पद वर्णक त्रुटि:\n"
"थाक अधिप्रवाह"

#: parser.cpp:687
#, qt-format
msgid ""
"Parser error at position %1:\n"
