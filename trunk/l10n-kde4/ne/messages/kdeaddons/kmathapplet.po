"%1 स्थितिमा पद वर्णक त्रुटि:\n"
"वाक्य संरचना त्रुटि"

#: parser.cpp:660 parser.cpp:664 parser.cpp:668 parser.cpp:672 parser.cpp:676
#: parser.cpp:680 parser.cpp:684 parser.cpp:688 parser.cpp:692 parser.cpp:695
