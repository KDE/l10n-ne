msgstr "अहिले अल्ट Gr कुञ्जी निष्क्रिय छ ।"

#: kaccess.cpp:76
msgid "The Num Lock key has been activated."
msgstr "नम लक कुञ्जी सक्रिय पारिएको छ ।"

#: kaccess.cpp:78
msgid "The Num Lock key is now inactive."
msgstr "अहिले नम लक कुञ्जी निष्क्रिय छ ।"

#: kaccess.cpp:80
msgid "The Caps Lock key has been activated."
msgstr "क्याप्स लक कुञ्जी सक्रिय पारिएको छ ।"

#: kaccess.cpp:82
