#: kio_floppy.cpp:200
msgid ""
"Could not access drive %1.\n"
"The drive is still busy.\n"
"Wait until it is inactive and then try again."
msgstr ""
"ड्राइभ पहुँच गर्न सकिंदैन %1।\n"
"ड्राइभ अहिले तत्कालै व्यस्त छ।\n"
"सामान्य सक्रिय हुन्जेल सम्म पर्खनुहोस् र त्यसपछि पुन:प्रयास गर्नुहोस्।"

#: kio_floppy.cpp:204 kio_floppy.cpp:1144
msgid ""
"Could not write to file %1.\n"
"The disk in drive %2 is probably full."
msgstr ""
"फाइल %1 मा लेख्न सकिंदैन।\n"
"ड्राइभ %2 मा डिस्क सम्भवत: पूरा छ। "

#: kio_floppy.cpp:214
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2"
msgstr ""
"%1 पहुँच गर्न सकिंदैन।\n"
"त्यहाँ सम्भवत: ड्राइभ %2 मा डिस्क छैन"

#: kio_floppy.cpp:218
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2 or you do not have enough permissions "
"to access the drive."
msgstr ""
" %1 पहुँच गर्न सकिंदैन।\n"
"त्यहाँ सम्भवत: ड्राइभ %2 मा डिस्क छैन वा तँपाइसंग ड्राइभलाई पहुँच गर्ने पूर्ण "
"अनुमतिहरू छैन।"

#: kio_floppy.cpp:222
msgid ""
"Could not access %1.\n"
"The drive %2 is not supported."
msgstr ""
"%1 पहुँच गर्न सकिंदैन।\n"
"ड्राइभ %2 समर्थित छैन।"

#: kio_floppy.cpp:227
msgid ""
"Could not access %1.\n"
"Make sure the floppy in drive %2 is a DOS-formatted floppy disk \n"
"and that the permissions of the device file (e.g. /dev/fd0) are set correctly "
"(e.g. rwxrwxrwx)."
msgstr ""
"%1 पहुँछ गर्न सकिंदैन।\n"
"ढाँचा गरिएको फ्लपी डिस्क ड्राइभ %2 मा निश्चिन्तरूपले बनाउनुहोस्\n"
"र त्यो यन्त्र फाइल (उदाहरणको लागि /dev/fd0) को अनुमतिहरू ठिक सँग सेट(उदाहरणको "
"लागि rwxrwxrwx)हुन्छन्।"

#: kio_floppy.cpp:231
msgid ""
"Could not access %1.\n"
"The disk in drive %2 is probably not a DOS-formatted floppy disk."
msgstr ""
"%1 पहुँच गर्न सकिंदैन।\n"
"संभवत: ड्राइभ %2 मा DOS-ढाँचागरिएको फ्लपी डिस्क छैन।"

#: kio_floppy.cpp:235
msgid ""
"Access denied.\n"
"Could not write to %1.\n"
"The disk in drive %2 is probably write-protected."
msgstr ""
"पहुँच अस्वीकार गर्यो।\n"
"%1 मा लेख्न सकिंदैन।\n"
"ड्राइभ %2 मा डिस्क संभवत: लेख्न सुरक्षित छ।"

#: kio_floppy.cpp:244
msgid ""
"Could not read boot sector for %1.\n"
"There is probably not any disk in drive %2."
msgstr ""
"%1 को लागि बूट खण्ड पढ्न सकिंदैन।\n"
"संभवत: ड्राइभ %2 मा कुनै डिस्क छैन।"

#: kio_floppy.cpp:368
msgid ""
"Could not start program \"%1\".\n"
"Ensure that the mtools package is installed correctly on your system."
msgstr ""
"कार्यक्रम सुरू गर्न सकिंदैन \"%1\".\n"
"तँपाइको प्रणालीमा m उपकरण प्याकेज स्थापना गर्न निश्चित गर्नुहोस्। "
