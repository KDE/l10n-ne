msgstr ""
"Project-Id-Version: kio_smtp\n"
"Report-Msgid-Bugs-To: \n"
"POT-Creation-Date: 2005-05-18 21:24+0200\n"
"PO-Revision-Date: 2006-10-27 00:34+0545\n"
"Last-Translator: Shiva Prasad Pokharel <pokharelshiva@hotmail.com>\n"
"Language-Team: Nepali <info@mpp.org.np>\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2;plural=(n!=1)\n"
"X-Generator: KBabel 1.11.2\n"

#: command.cc:125
msgid ""
"The server rejected both EHLO and HELO commands as unknown or "
"unimplemented.\n"
"Please contact the server's system administrator."
msgstr ""
"सर्भरले अज्ञात वा कार्यान्वयन नभएको रूपमा EHLO र HELO दुवैलाई अस्वीकार गर्यो ।\n"
"कृपया सर्भरको प्रणाली प्रशासकसँग सम्पर्क गर्नुहोस् ।"

#: command.cc:139
msgid ""
"Unexpected server response to %1 command.\n"
"%2"
msgstr ""
"%1 आदेशलाई अनपेक्षित सर्भरले प्रतिक्रिया दियो ।\n"
"%2"

#: command.cc:159
msgid ""
"Your SMTP server does not support TLS. Disable TLS, if you want to connect "
"without encryption."
msgstr "तपाईँको STMP सर्भरले TLS लाई समर्थन गरेन । यदि तपाईँ गुप्तिकरण बिना जडान गर्न चाहनुहुन्छ भने, TLS अक्षम गर्नुहोस् ।"

#: command.cc:173
msgid ""
"Your SMTP server claims to support TLS, but negotiation was unsuccessful.\n"
"You can disable TLS in KDE using the crypto settings module."
msgstr ""
"तपाईँको SMTP सर्भरले TLS समर्थन गर्न दावी गर्दछ, तर सम्झौता असफल भयो ।\n"
"तपाईँ KDE मा क्रिप्टो सेटिङ मोड्युल प्रयोग गरेर TLS अक्षम गर्न सक्नुहुन्छ ।"

#: command.cc:178
msgid "Connection Failed"
msgstr "जडान असफल भयो"

#: command.cc:229
msgid "Authentication support is not compiled into kio_smtp."
msgstr "प्रमाणीकरण समर्थन kio_smtp मा सङ्कलन भएन ।"

#: command.cc:258
msgid "No authentication details supplied."
msgstr "कुनै प्रमाणीकरण विवरणहरू आपूर्ति भएन ।"

#: command.cc:361
msgid ""
"Your SMTP server does not support %1.\n"
"Choose a different authentication method.\n"
"%2"
msgstr ""
"तपाईँको SMTP सर्भरले %1 लाई समर्थन गरेन ।\n"
"भिन्न भिन्नै प्रमाणीकरण विधि रोज्नुहोस् ।\n"
"%2"

#: command.cc:365
#, c-format
msgid ""
"Your SMTP server does not support authentication.\n"
"  %2"
msgstr ""
"तपाईँको SMTP सर्भरले प्रमाणीकरण समर्थन गरेन ।\n"
"  %2"

#: command.cc:369
#, c-format
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"%1"
msgstr ""
"प्रमाणीकरण असफल भयो ।\n"
"धेरैजसो पासवर्ड गलत छ ।\n"
"%1"

#: command.cc:507
msgid "Could not read data from application."
msgstr "अनुप्रयोगबाट डेटा पढ्न सकिएन ।"

#: command.cc:524
#, c-format
msgid ""
"The message content was not accepted.\n"
"%1"
msgstr ""
"सन्देश सामग्री अस्वीकार भयो ।\n"
"%1"

#: response.cc:105
#, c-format
msgid ""
"The server responded:\n"
"%1"
msgstr ""
"सर्भरले प्रतिक्रिया दियो:\n"
"%1"

#: response.cc:108
msgid "The server responded: \"%1\""
msgstr "सर्भरले प्रतिक्रिया दियो: \"%1\""

#: response.cc:111
msgid "This is a temporary failure. You may try again later."
msgstr "यो अस्थायी असफलता हो । तपाईँ फेरि प्रयास गर्न सक्नुहुन्छ ।"

#: smtp.cc:188
msgid "The application sent an invalid request."
msgstr "अनुप्रयोगले एउटा अवैध अनुरोध पठायो ।"

#: smtp.cc:250
msgid "The sender address is missing."
msgstr "प्रेषक ठेगाना हराइरहेको छ ।"

#: smtp.cc:258
msgid "SMTPProtocol::smtp_open failed (%1)"
msgstr "SMTP प्रोटोकल::smtp_open असफल भयो (%1)"

#: smtp.cc:266
msgid ""
"Your server does not support sending of 8-bit messages.\n"
"Please use base64 or quoted-printable encoding."
msgstr ""
"तपाईँको सर्भरले पठाएको ८-बिट सन्देशहरू समर्थन गर्दैन ।\n"
"कृपया आधार६४ वा उद्धरण गरिएको-मुद्रणयोग्य सङ्केतन प्रयोग गर्नुहोस् ।"

#: smtp.cc:345
msgid "Invalid SMTP response (%1) received."
msgstr "अवैध SMTP प्रतिक्रिया (%1) प्राप्त भयो ।"

#: smtp.cc:529
#, c-format
msgid ""
"The server did not accept the connection.\n"
"%1"
msgstr ""
"सर्भरले जडान स्वीकार गरेन ।\n"
"%1"

#: smtp.cc:604
msgid "Username and password for your SMTP account:"
msgstr "तपाईँको SMTP खाताको लागि प्रयोगकर्ता नाम र पासवर्ड:"

#: transactionstate.cc:53
#, c-format
msgid ""
"The server did not accept a blank sender address.\n"
"%1"
msgstr ""
"सर्भरले खाली प्रेषक ठेगाना स्वीकार गरेन ।\n"
"%1"

#: transactionstate.cc:56
msgid ""
"The server did not accept the sender address \"%1\".\n"
"%2"
msgstr ""
"सर्भरले प्रेषक ठेगाना \"%1\" स्वीकार गरेन ।\n"
"%2"

#: transactionstate.cc:97
#, c-format
msgid ""
"Message sending failed since the following recipients were rejected by the "
"server:\n"
"%1"
msgstr ""
"सर्भरले निम्न प्रापकहरू अस्वीकार गरेको बेला सन्देश पठाउन असफल भयो:\n"
"%1"

#: transactionstate.cc:107
#, c-format
msgid ""
"The attempt to start sending the message content failed.\n"
"%1"
msgstr ""
"सन्देश सामग्री पठाउन सुरु गर्ने प्रयास असफल भयो ।\n"
"%1"

#: transactionstate.cc:111
msgid "Unhandled error condition. Please send a bug report."
msgstr "ह्यान्डल गरिएको त्रुटि स्थिति । कृपया बग प्रतिवेदन पठाउनुहोस् ।"

