#. i18n: file kickerSettings.kcfg line 135
#: rc.cpp:96
#, no-c-format
msgid "Show hidden files in Quick Browser"
msgstr "द्रूत ब्राउजरमा लुकेका फाइलहरू देखाउनुहोस्"

#. i18n: file kickerSettings.kcfg line 140
#: rc.cpp:99
#, no-c-format
msgid "Maximum number of entries"
msgstr "प्रविष्टिहरूको लागि अधिकतम सङ्ख्या"

#. i18n: file kickerSettings.kcfg line 146
#: rc.cpp:102
#, no-c-format
msgid "Show bookmarks in KMenu"
msgstr "केमेनूमा पुस्तकचिनोहरू देखाउनुहोस्"

#. i18n: file kickerSettings.kcfg line 151
#: rc.cpp:105
#, no-c-format
msgid "Use the Quick Browser"
msgstr "द्रूत ब्राउजर प्रयोग गर्नुहोस्"

#. i18n: file kickerSettings.kcfg line 156
#: rc.cpp:108
#, no-c-format
msgid "Optional Menus"
msgstr "वैकल्पिक मेनूहरू"

#. i18n: file kickerSettings.kcfg line 161
#: rc.cpp:111
#, no-c-format
msgid "Recently used applications"
msgstr "भर्खर प्रयोग भएका अनुप्रयोगहरू"

#. i18n: file kickerSettings.kcfg line 165
#: rc.cpp:114
#, no-c-format
msgid "Number of visible entries"
msgstr "हेरेका प्रविष्टिहरूको सङख्या"

#. i18n: file kickerSettings.kcfg line 171
#: rc.cpp:117
#, no-c-format
msgid "Show most recently used applications rather than most frequently used"
msgstr "बढि प्रयोग भएका अनुप्रयोगहरू भन्दा हाल प्रयोग गरिएका अनुप्रयोग देखाउनुहोस्"

#. i18n: file kickerSettings.kcfg line 180
#: rc.cpp:120
#, no-c-format
msgid "Enable a tile background image for the KMenu button"
msgstr "केमेनू बटनका लागि टाइल पृष्ठभूमि छवि सक्षम पार्नुहोस्"

#. i18n: file kickerSettings.kcfg line 185
#: rc.cpp:123
#, no-c-format
msgid "Enable a tile background image for the Desktop button"
msgstr "डेस्कटप बटनको लागि टाइल पृष्ठभूमि छवि सक्षम पार्नुहोस्"

#. i18n: file kickerSettings.kcfg line 190
#: rc.cpp:126
#, no-c-format
msgid "Enable a tile background image for Application, URL and special buttons"
msgstr "अनुप्रयोग, युआरएल र स्पेशल बटनहरूका लागि टाइल पृष्ठभूमि सक्षम पार्नुहोस्"

#. i18n: file kickerSettings.kcfg line 195
#: rc.cpp:129
#, no-c-format
msgid "Enable a tile background image for the Quick Browser button"
msgstr "दृत ब्राउजर बटनको लागि टाइल पृष्ठभूमि छवि सक्षम पार्नुहोस्"

#. i18n: file kickerSettings.kcfg line 200
#: rc.cpp:132
#, no-c-format
msgid "Enable a tile background image for the Window List button"
msgstr "सञ्झ्याल सूची बटनको लागि टाइल पृष्ठभूमि छवि सक्षम पार्नुहोस्"

#. i18n: file kickerSettings.kcfg line 205
#: rc.cpp:135
#, no-c-format
msgid "Image tile for Kmenu button background"
msgstr "केमेनू बटन पृष्ठभूमिको लागि छवि टाइल"

#. i18n: file kickerSettings.kcfg line 209
#: rc.cpp:138 rc.cpp:144
#, no-c-format
msgid "Color to use for Kmenu button background"
msgstr "केमेनू बटन पृष्ठभूमिको लागि प्रयोग गरिने रङ्ग"

#. i18n: file kickerSettings.kcfg line 214
#: rc.cpp:141
#, no-c-format
msgid "Image tile for Desktop button background"
msgstr "डेस्कटप बटन पृष्ठभूमिको लागि छवि टाइल"

#. i18n: file kickerSettings.kcfg line 223
#: rc.cpp:147
#, no-c-format
msgid "Image tile for Application, URL and special button backgrounds"
msgstr "अनुप्रयोग, यू आर एल र स्पेशल बटन पृष्ठभूमिहरूका लागि छवि टाइल"

#. i18n: file kickerSettings.kcfg line 227
#: rc.cpp:150
#, no-c-format
msgid "Color to use for Application, URL and special button backgrounds"
msgstr "अनुप्रयोग, यू आर एल र स्पेशल बटन पृष्ठभूमिहरूका लागि रङ्ग"

#. i18n: file kickerSettings.kcfg line 232
#: rc.cpp:153
#, no-c-format
msgid "Image tile for Browser button background"
msgstr "ब्राउजर बटन पृष्ठभूमिका लागि छवि टाइल"

#. i18n: file kickerSettings.kcfg line 236
#: rc.cpp:156
#, no-c-format
msgid "Color to use for Browser button background"
msgstr "ब्राउजर बटन पृष्ठभूमिका लागि रङ्ग"

#. i18n: file kickerSettings.kcfg line 241
#: rc.cpp:159
#, no-c-format
msgid "Image tile for Window List button background"
msgstr "सञ्झ्याल सूची बटन पृष्ठभूमिका लागि छवि टाइल"

#. i18n: file kickerSettings.kcfg line 245
#: rc.cpp:162
#, no-c-format
msgid "Color to use for Window List button background"
msgstr "सञ्झ्याल सूची बटन पृष्ठभूमिका लागि रङ्ग"

#. i18n: file kickerSettings.kcfg line 254
#: rc.cpp:165
#, no-c-format
msgid "Use side image in Kmenu"
msgstr "केमेनूमा साइड छवि प्रयोग गर्नुहोस्"

#. i18n: file kickerSettings.kcfg line 259
#: rc.cpp:168
#, no-c-format
msgid "The name of the file to use as the side image in the K Menu"
msgstr "K मेनूमा साइड छविको रूपमा प्रयोग गरिने फाइलको नाम"

#. i18n: file kickerSettings.kcfg line 264
#: rc.cpp:171
#, no-c-format
msgid ""
"The name of the file used as a tile to fill the height of K Menu that "
"SidePixmapName does not cover"
msgstr ""
"K मेनूको उचाइ भर्न टाइलको रुपमा प्रयोग गरिएको फाइलको नाम जुन SidePixmapName "
"ले पूर्ण गर्दैन"

#. i18n: file kickerSettings.kcfg line 269
#: rc.cpp:174
#, no-c-format
msgid "Show text on the K Menu button"
msgstr "K मेनू बटनमा पाठ देखाउनुहोस्"

#. i18n: file kickerSettings.kcfg line 274
#: rc.cpp:177
#, no-c-format
msgid "Text to be shown on K Menu Button"
msgstr "K मेनू बटनमा देखाइनु पर्ने पाठ"

#. i18n: file kickerSettings.kcfg line 283
#: rc.cpp:180
#, no-c-format
msgid "Enable icon mouse over effects"
msgstr "प्रभावहरू माथि प्रतिमा माउस सक्षम पार्नुहोस्"

#. i18n: file kickerSettings.kcfg line 288
#: rc.cpp:183
#, no-c-format
msgid "Show icons in mouse over effects"
msgstr "प्रभावहरू माथि माउसमा प्रतिमाहरू देखाउनुहोस्"

#. i18n: file kickerSettings.kcfg line 293
#: rc.cpp:186
#, no-c-format
msgid "Show text in mouse over effects"
msgstr "प्रभावहरू माथि माउसमा पाठ देखाउनुहोस्"

#. i18n: file kickerSettings.kcfg line 298
#: rc.cpp:189
#, no-c-format
msgid "Controls how fast the tooltips fade in, measured in thousandths of a second"
msgstr "सेकेण्डको हजारहरूको गणनामा टूलटिपहरूमा कति चाँडो नियण्त्रण हुन्छ भन्ने दर्साउँदछ"

#. i18n: file kickerSettings.kcfg line 304
#: rc.cpp:192
#, no-c-format
msgid "Mouse over effects are shown after the defined time (in milliseconds)"
msgstr "परिभाषित समय (मिलीसेकेण्डहरूमा) पछि प्रभावहरू माथि माउस देखाइन्छ"

#. i18n: file kickerSettings.kcfg line 309
#: rc.cpp:195
#, no-c-format
msgid "Mouse over effects are hidden after the defined time (in milliseconds)"
msgstr "परिभाषित समय (मिलीसेकेण्डहरूमा) पछि प्रभावहरू माथि माउस लुकाइन्छ"

#. i18n: file kickerSettings.kcfg line 314
#: rc.cpp:198
#, no-c-format
msgid "Enable background tiles"
msgstr "पृष्ठभूमि टाइलहरू सक्षम पार्नुहोस्"

#. i18n: file kickerSettings.kcfg line 319
#: rc.cpp:201
#, no-c-format
msgid "The margin between panel icons and the panel border"
msgstr "प्यानल प्रतिमाहरू र प्यानल किनारा बीच सीमान्त"

#. i18n: file kickerSettings.kcfg line 324
#: rc.cpp:204
#, no-c-format
msgid ""
"Buttons that represent KServices (applications, primarily) watch for the "
