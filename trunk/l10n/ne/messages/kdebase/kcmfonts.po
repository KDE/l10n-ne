#: fonts.cpp:539
msgid "Used for normal text (e.g. button labels, list items)."
msgstr "सामान्य पाठका लागि प्रयोग गरियो (जस्तै: बटन तहहरू, सूची वस्तुहरू) ।"

#: fonts.cpp:540
msgid "A non-proportional font (i.e. typewriter font)."
msgstr "एउटा असमानुपातिक फन्ट (जस्तै: टाइप राइटर फन्ट) ।"

#: fonts.cpp:541
msgid "Used to display text beside toolbar icons."
msgstr "उपकरण पट्टी प्रतिमाहरू बाहेकका पाठ प्रदर्शन गर्न प्रयोग गरियो ।"

#: fonts.cpp:542
msgid "Used by menu bars and popup menus."
msgstr "मेनु पट्टी र पपअप मेनुद्वारा प्रयोग गरियो ।"

#: fonts.cpp:543
msgid "Used by the window titlebar."
msgstr "सञ्झ्याल शीर्षक पट्टीद्वारा प्रयोग गरियो ।"

#: fonts.cpp:544
msgid "Used by the taskbar."
msgstr "कार्य पट्टीद्वारा प्रयोग गरियो ।"

#: fonts.cpp:545
msgid "Used for desktop icons."
msgstr "डस्कटप प्रतिमाहरूको लागि प्रयोग गरियो ।"

#: fonts.cpp:596
msgid "Ad&just All Fonts..."
msgstr "सबै फन्टहरू समायोजन गर्नुहोस्..."

#: fonts.cpp:597
msgid "Click to change all fonts"
msgstr "सबै फन्टहरू परिवर्तन गर्न क्लिक गर्नुहोस्"

#: fonts.cpp:604
msgid "Use a&nti-aliasing for fonts"
msgstr "फन्टहरूको लागि एन्टि-एलाइजिङ प्रयोग गर्नुहोस्"

#: fonts.cpp:605
msgid ""
"If this option is selected, KDE will smooth the edges of curves in fonts."
msgstr ""
"यदि यो विकल्प चयन गरिएमा, KDE ले फन्टमा बक्ररेखाका किनाराहरू मिहिन गर्नेछ ।"

#: fonts.cpp:608
msgid "Configure..."
msgstr "कन्फिगर गर्नुहोस्..."

#: fonts.cpp:684
msgid ""
"<p>You have changed anti-aliasing related settings. This change will only "
"affect newly started applications.</p>"
msgstr ""
"<p>तपाईँले एन्टि-एलाइजिङ सम्बन्धित सेटिङ परिवर्तन गर्नुभएको छ । यो परिवर्तनले "
"सुरु गरिएका नयाँ अनुप्रयोगहरूलाई मात्र प्रभाव पार्ने छ ।</p>"

#: fonts.cpp:685
msgid "Anti-Aliasing Settings Changed"
msgstr "एन्टि-एलाइजिङ सेटिङ परिवर्तन गरियो"

