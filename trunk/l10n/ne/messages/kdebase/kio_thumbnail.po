#: thumbnail.cpp:174
msgid "No MIME Type specified."
msgstr "कुनै माइम प्रकार निर्दिष्ट गरिएको छैन ।"

#: thumbnail.cpp:184
msgid "No or invalid size specified."
msgstr "कुनै पनि अवैध साइज निर्दिष्ट गरिएको छैन ।"

#: thumbnail.cpp:265
msgid "No plugin specified."
msgstr "कुनै प्लगइन निर्दिष्ट गरिएको छैन ।"

#: thumbnail.cpp:283
#, c-format
msgid "Cannot load ThumbCreator %1"
msgstr "थम्बसिर्जनाकर्ता %1 लोड गर्न सकिएन"

#: thumbnail.cpp:291
#, c-format
msgid "Cannot create thumbnail for %1"
msgstr "%1 का लागि थम्बनेल सिर्जना गर्न सकिएन"

#: thumbnail.cpp:358
msgid "Failed to create a thumbnail."
msgstr "थम्बनेल सिर्जना गर्न असफल भयो ।"

#: thumbnail.cpp:373
msgid "Could not write image."
msgstr "छवि लेख्न सकिएन ।"

#: thumbnail.cpp:398
#, c-format
msgid "Failed to attach to shared memory segment %1"
msgstr "साझेदार गरिएको स्मृति खण्ड %1 मा फाइल संलग्न गर्न असफल भयो"

#: thumbnail.cpp:403
msgid "Image is too big for the shared memory segment"
msgstr "साझेदार गरिएको स्मृति खण्डको लागि छवि अति ठूलो भयो"
