#: runapplet.cpp:59
msgid "Run command:"
msgstr "सञ्चालन आदेश:"

#: runapplet.cpp:170
msgid "< Run"
msgstr "<चलाउनुहोस्"

#: runapplet.cpp:177
msgid "Run >"
msgstr "चलाउनुहोस् >"

#: runapplet.cpp:226
msgid "You have to enter a command to execute or a URL to be opened first."
msgstr "यू आर एल पहिले खोल्न वा कार्यान्वयन गर्न तपाईँले आदेश प्रविष्ट गर्नुपर्दछ ।"

#: runapplet.cpp:237
msgid ""
"Unable to log out properly.\n"
"The session manager cannot be contacted. You can try to force a shutdown by "
"pressing Ctrl+Alt+Backspace. Note, however, that your current session will "
"not be saved with a forced shutdown."
msgstr ""
"उचित तरीकाले लगआउट गर्न असक्षम ।\n"
"सत्र प्रबन्धक सम्पर्क हुन सकेन । तपाईँ ctrl+Alt+ब्याकसपेस थिचेर बन्द गर्न जोडदार रूपमा प्रयास गर्न सक्नुहुन्छ । याद गर्नुहोस्, जे भए पनि, तपाईँको हालको सत्र जोडदार बन्दद्वारा बचत हुने छैन ।"

#: runapplet.cpp:268
msgid ""
"<qt>The program name or command <b>%1</b>\n"
"cannot be found. Please correct the command\n"
"or URL and try again</qt>"
msgstr ""
"<qt>कार्यक्रम नाम वा आदेश <b>%1</b>\n"
"फेला पार्न सकिएन । कृपया आदेश वा यू आर एल\n"
"सुधार गर्नुहोस् र फेरि प्रयास गर्नुहोस्</qt>"

#: runapplet.cpp:280
msgid ""
"<qt>Could not run <b>%1</b>.\n"
"Please correct the command or URL and try again.</qt>"
msgstr ""
"<qt>सञ्चालन हुन सक्दैन <b>%1</b> ।\n"
"कृपया आदेश वा यू आर एल सुधार गर्नुहोस् र फेरि प्रयास गर्नुहोस् ।</qt>"

