#: ksgrd/HostConnector.cc:76
msgid "Daemon"
msgstr "डेमोन"

#: ksgrd/HostConnector.cc:77
msgid ""
"Select this if you want to connect to a ksysguard daemon that is running on "
"the machine you want to connect to, and is listening for client requests."
msgstr ""
"यो चयन गर्नुहोस् यदि तपाईं ksysguard डेमोन जडान गर्न चाहनुहुन्छ भने जुन तपाईंले जडान गर्न "
"चाहनु भएको मेसिनमा चालु छ, र ग्राहकहरूको अनुरोधमा यो बजिरहेको छ।"

#: ksgrd/HostConnector.cc:80
msgid "Custom command"
msgstr "आदेश अनुकूलित पार्नुहोस्"

#: ksgrd/HostConnector.cc:81
msgid ""
"Select this to use the command you entered below to start ksysguardd on the "
"remote host."
msgstr ""
"दूर होस्टमा ksysguardd शुरू गर्न तपाईंले तल प्रविष्ट गर्नु भएको आदेश प्रयोग गर्न "
"यो चयन गर्नुहोस्।"

#: ksgrd/HostConnector.cc:84
msgid "Port:"
msgstr "पोर्ट:"

#: ksgrd/HostConnector.cc:90
msgid ""
"Enter the port number on which the ksysguard daemon is listening for "
"connections."
msgstr "पोर्ट सङ्ख्या प्रविष्ट गर्नुहोस् जहाँ ksysguard डेमोन जडानहरूका लागि सुनाइरहेको छ।"

#: ksgrd/HostConnector.cc:93
msgid "e.g.  3112"
msgstr "उदाहरण: ३११२"

#: ksgrd/HostConnector.cc:96
msgid "Command:"
msgstr "आदेश:"

#: ksgrd/HostConnector.cc:105
msgid "Enter the command that runs ksysguardd on the host you want to monitor."
msgstr "आदेश प्रविष्ट गर्नुहोस् जुनले होस्टमा ksysguardd चालु हुन्छ जुन तपाईं मनिटर गर्न चाहनुहुन्छ।"

#: ksgrd/HostConnector.cc:109
msgid "e.g. ssh -l root remote.host.org ksysguardd"
msgstr "उदाहरण: ssh -l root remote.host.org ksysguardd"

