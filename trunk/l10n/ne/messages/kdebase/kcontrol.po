msgstr "(c) 1998-2004, KDE नियन्त्रण केन्द्र विकासकर्ता"

#: main.cpp:108
msgid "The KDE Info Center"
msgstr "KDE सूचना केन्द्र"

#: main.cpp:127 main.cpp:129
msgid "Current Maintainer"
msgstr "हालको सञ्भारकर्ता"

#: modules.cpp:155
msgid "<big>Loading...</big>"
msgstr "<big> लोड हुदैछ...</big>"

#: moduletreeview.cpp:65
msgid "The %1 configuration group. Click to open it."
msgstr "%1 कन्फिगरेसन समूह । यसलाई खोल्न क्लिक गर्नुहोस् ।"

#: moduletreeview.cpp:67
msgid ""
"This treeview displays all available control modules. Click on one of the "
"modules to receive more detailed information."
msgstr "यो ट्री दृश्यले सबै उपलब्ध नियन्त्रण मोड्युलहरू प्रदर्शन गर्दछ । धेरै विस्तृत जानकारी प्राप्त गर्न मोड्युल मध्य एउटा क्लिक गर्नुहोस् ।"

#: proxywidget.cpp:54
msgid "The currently loaded configuration module."
msgstr "हालै लोड गरिएको कन्फिगरेसन मोड्युल ।"

#: proxywidget.cpp:88
msgid ""
"<b>Changes in this module require root access.</b><br>Click the "
"\"Administrator Mode\" button to allow modifications in this module."
msgstr "<b>यो मोड्युलमा परिवर्तनहरूलाई प्रमूल पहुँचको आवश्यक पर्दछ ।</b><br>यो मोड्युलमा परिमार्जनहरूलाई अनुमति दिन तल \"प्रशासक मोड\" बटन क्लिक गर्नुहोस् ।"

#: proxywidget.cpp:92
msgid ""
"This module requires special permissions, probably for system-wide "
"modifications; therefore, it is required that you provide the root password "
"to be able to change the module's properties.  If you do not provide the "
"password, the module will be disabled."
msgstr "मोड्युललाई विशेष अनुमतिहरूको आवश्यक पर्दछ, खास गरेर प्रणालीगत परिमार्जनहरूका लागि; त्यसैले, यो आवश्यक छ कि तपाईँले मोड्युलको गुणहरू परिवर्तन गर्ने सक्षम गर्न प्रमूल पासवर्ड उपलब्ध गराउनुहोस् । यदि तपाईँले पासवर्ड उपलब्ध गराउनु भएन भने, मोड्युल अक्षम गरिनेछ ।"

