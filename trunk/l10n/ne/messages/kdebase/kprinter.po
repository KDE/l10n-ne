#: main.cpp:29
msgid "Make an internal copy of the files to print"
msgstr "छाप्नको लागि फाइलहरूको आन्तरिक प्रतिलिपि बनाउनुहोस्"

#: main.cpp:31
msgid "Printer/destination to print on"
msgstr "छाप्नको लागि मुद्रक/गन्तव्य"

#: main.cpp:33
msgid "Title/Name for the print job"
msgstr "छाप्ने कार्यको लागि शीर्षक/नाम"

#: main.cpp:35
msgid "Number of copies"
msgstr "प्रतिलिपिहरूको सङ्ख्या"

#: main.cpp:36
msgid "Printer option"
msgstr "मुद्रक विकल्प"

#: main.cpp:37
msgid "Job output mode (gui, console, none)"
msgstr "कार्य प्रतिफल शैली (जियुआइ, कन्सोल, कुनै पनि होइन)"

#: main.cpp:38
msgid "Print system to use (lpd, cups)"
msgstr "प्रयोगका लागि छाप्ने प्रणाली (एलपिडि, कप्स)"

#: main.cpp:39
msgid "Allow printing from STDIN"
msgstr "STDIN बाट छाप्न अनुमति दिनुहोस्"

#: main.cpp:40
msgid "Do not show the print dialog (print directly)"
msgstr "छाप्ने संवाद नदेखाउनुहोस् (प्रत्यक्ष छाप्नुहोस्)"

#: main.cpp:41
msgid "Files to load"
msgstr "लोड गर्न फाइलहरू"

#: main.cpp:47
msgid "KPrinter"
msgstr "केमुद्रक"

#: main.cpp:47
msgid "A printer tool for KDE"
msgstr "KDE को लागि मुद्रक"

#: printwrapper.cpp:61
msgid "Print Information"
msgstr "छपाइ सूचना"

#: printwrapper.cpp:62
msgid "Print Warning"
msgstr "छपाइ चेतावनी"

#: printwrapper.cpp:63
msgid "Print Error"
msgstr "छपाइ त्रुटि"

#: printwrapper.cpp:69
msgid "Print info"
msgstr "छपाइ सूचना"

#: printwrapper.cpp:69
msgid "Print warning"
msgstr "छपाइ चेतावनी"

#: printwrapper.cpp:69
msgid "Print error"
msgstr "छपाइ त्रुटि"

#: printwrapper.cpp:190
msgid ""
"A file has been specified on the command line. Printing from STDIN will be "
"disabled."
msgstr "आदेश पङ्क्तिमा फाइल निर्दिष्ट गरियो। STDIN बाट छाप्न असक्षम भयो।"

#: printwrapper.cpp:196
msgid ""
"When using '--nodialog', you must at least specify one file to print or use the "
"'--stdin' flag."
msgstr ""
"जब '--nodialog' प्रयोग गरेको बेला, तपाईंले कम्तिमा एउटा फाइल छाप्नको लागि "
"निर्दिष्ट गर्नुपर्दछ वा कुनै '--stdin' झण्डा प्रयोग गर्नुहोस्।"

#: printwrapper.cpp:245
msgid "The specified printer or the default printer could not be found."
msgstr "निर्दिष्ट मुद्रक वा पूर्वनिर्धारित मुद्रक फेला पार्न सकिएन।"

#: printwrapper.cpp:247
msgid "Operation aborted."
msgstr "अपरेसन रद्द गरियो।"

#: printwrapper.cpp:276
msgid "Unable to construct the print dialog."
msgstr "छपाइ संवाद निर्माण गर्न असक्षम।"

#: printwrapper.cpp:317
msgid "Multiple files (%1)"
msgstr "बहु फाइलहरू (%1))"

#: printwrapper.cpp:324
msgid "Nothing to print."
msgstr "छाप्नको लागि केही पनि छैन।"

#: printwrapper.cpp:349
msgid "Unable to open temporary file."
msgstr "अस्थायी फाइल खोल्न असक्षम।"

#: printwrapper.cpp:364
msgid "Stdin is empty, no job sent."
msgstr "Stdin खाली छ, कुनै कार्य पठाइएन।"

#: printwrapper.cpp:376
#, c-format
msgid "Unable to copy file %1."
msgstr "%1 फाइल प्रतिलिपि गर्न असक्षम।"

#: printwrapper.cpp:393
msgid "Error while printing files"
msgstr "फाइलहरू छाप्दा त्रुटि"
