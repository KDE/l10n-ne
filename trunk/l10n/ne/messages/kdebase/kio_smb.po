#: kio_smb_auth.cpp:131
msgid "<qt>Please enter authentication information for <b>%1</b></qt>"
msgstr "<qt>कृपया<b>%1</b>को लागि प्रमाणीकरण सूचना प्रविष्ट गर्नुहोस्</qt>"

#: kio_smb_auth.cpp:135
msgid ""
"Please enter authentication information for:\n"
"Server = %1\n"
"Share = %2"
msgstr ""
"कृपया प्रमाणीकरण सूचना प्रविष्ट गर्नुहोस्:\n"
"सर्भर = %1\n"
"शेयर = %2"

#: kio_smb_auth.cpp:175
msgid "libsmbclient failed to initialize"
msgstr "libsmbclient थालनि गर्न असफल"

#: kio_smb_auth.cpp:181
msgid "libsmbclient failed to create context"
msgstr "libsmbclient प्रसङ्ग सिर्जना गर्न असफल"

#: kio_smb_auth.cpp:191
msgid "libsmbclient failed to initialize context"
msgstr "libsmbclient प्रसङ्ग शुरूवात गर्न असफल"

#: kio_smb_browse.cpp:67
msgid ""
"%1:\n"
"Unknown file type, neither directory or file."
msgstr ""
"%1:\n"
"अज्ञात फाइल प्रकार, न त डाइरेक्टरी न त फाइल।"

#: kio_smb_browse.cpp:126
#, c-format
msgid "File does not exist: %1"
msgstr "फाइल अवस्थित छैन: %1"

#: kio_smb_browse.cpp:242
msgid ""
"Unable to find any workgroups in your local network. This might be caused by "
"an enabled firewall."
msgstr "तपाइँको स्थानिय सञ्जालमा कुनै पनि कार्यसमुहहरू फेला पर्न अयोग्य छ। यो सक्षम पार्ने फायरवालको कारणले हुने सक्छ।"

#: kio_smb_browse.cpp:249
#, c-format
msgid "No media in device for %1"
msgstr "%1 का लागि यन्त्रमा मिडिया छैन"

#: kio_smb_browse.cpp:257
#, c-format
msgid "Could not connect to host for %1"
msgstr "%1 को लागि होस्ट संग जडान गर्न सकिदैन"

#: kio_smb_browse.cpp:273
#, c-format
msgid "Error while connecting to server responsible for %1"
msgstr "%1 विशेष सर्भरमा जडान गर्दा त्रुटि"

#: kio_smb_browse.cpp:281
msgid "Share could not be found on given server"
msgstr "दिएको सर्भरमा शेयर फेला पार्न सकेन"

#: kio_smb_browse.cpp:284
msgid "BAD File descriptor"
msgstr "BAD फाइल वर्णनकर्ता"

#: kio_smb_browse.cpp:291
msgid ""
"The given name could not be resolved to a unique server. Make sure your "
"network is setup without any name conflicts between names used by Windows "
"and by UNIX name resolution."
msgstr "दिइएको नामलाई युनिक सर्भरमा पुन: समाधान गर्न सकिंदैन।  UNIX नाम रिजोलुसन र विन्डोजद्वारा प्रयोग गरिएका नामहरूका बिच कुनै नामहरू एकआपसमा नजुध्ने किसिमले निश्चिन्त तपाइँको सञ्झाल सेटअप बनाउनुहोस्।"

#: kio_smb_browse.cpp:297
msgid ""
"libsmbclient reported an error, but did not specify what the problem is. "
"This might indicate a severe problem with your network - but also might "
"indicate a problem with libsmbclient.\n"
"If you want to help us, please provide a tcpdump of the network interface "
"while you try to browse (be aware that it might contain private data, so do "
"not post it if you are unsure about that - you can send it privately to the "
"developers if they ask for it)"
msgstr ""
"libsmbclient ले एउटा त्रुटि आएको दर्शायो, तर समस्या के हो भनेर निर्दिष्ट गर्न सकेन। यसले तपाइँको सञ्जालसँग सर्भरको समस्या छ भन्ने सूचित गर्दछ -तर पनि libsmbclient संग एउटा समस्या हुन सक्छ।\n"
"यदि तपाईँ हामीलाई मद्दत गर्न चाहानुहुन्छ भने, कृपया तपाईँले ब्राउज गर्ने प्रयास गर्दा सञ्जाल अन्तरमोहडाको tcpdump उपलब्ध गराउनुहोस् (सावधान रहनुहोस् यसले निजी डेटा समाविष्ट गर्न सक्छ, त्यसैले यदि तपाईँ त्यसको बारे निश्चित हुनुहुन्न भने यसलाई प्रविष्टि नगर्नुहोस् - यदि विकासकर्ताहरूले यसलाई सोध्यो भने तपाईँ यसलाई व्यक्तिगत रूपमा पठाउन सक्नुहुन्छ)"

#: kio_smb_browse.cpp:308
#, c-format
msgid "Unknown error condition in stat: %1"
msgstr "stat मा अज्ञात त्रुटि स्थिति: %1"

#: kio_smb_mount.cpp:125 kio_smb_mount.cpp:166
msgid ""
"\n"
"Make sure that the samba package is installed properly on your system."
msgstr ""
"\n"
"तपाईँको प्रणालीमा साम्बा प्याकेज उचित तरीकाले स्थापना गरिएको छ भन्ने निश्चय गर्नुहोस् ।"

#: kio_smb_mount.cpp:135
msgid ""
"Mounting of share \"%1\" from host \"%2\" by user \"%3\" failed.\n"
"%4"
msgstr ""
"प्रयोगकर्ता \"%3\" द्वारा होस्ट \"%2\" बाट शेयर \"%1\" को माउन्टिङ असफल भयो ।\n"
"%4"

#: kio_smb_mount.cpp:176
msgid ""
"Unmounting of mountpoint \"%1\" failed.\n"
"%2"
msgstr ""
"माउन्टबिन्दु \"%1\" को अनमाउन्टिङ असफल भयो ।\n"
"%2"

