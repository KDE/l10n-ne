#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Kapil Timilsina"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "lipak21@gmail.com"

#: main.cpp:30
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"मानक X11R6 सत्र व्यवस्थापन प्रोोटोकल (XSMP) लिने\n"
"विश्वासिलो KDE सत्र व्यवस्थापक ।"

#: main.cpp:35
msgid "Restores the saved user session if available"
msgstr ""
"उपलब्ध भएमा बचत गरिएको प्रयोगकर्ता सत्र पूर्वास्थितिमा फर्काउँछ"

#: main.cpp:37
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"यस सत्रमा कुनै पनि सञ्झ्याल व्यवस्थापक\n"
"संलग्न नभएमा 'डब्लु एम(wm)' सुरु गर्नुहोस् । 'के विन(kwin)' चाँहि पूर्वनिर्धारित हो ।"

#: main.cpp:38
msgid "Also allow remote connections"
msgstr "दूर सम्बन्धहरूलाई पनि अनुमति दिनुहोस्"

#: main.cpp:182
msgid "The KDE Session Manager"
msgstr "KDE सत्र व्यवस्थापक"

#: main.cpp:186
msgid "Maintainer"
msgstr "व्यवस्थापनकर्ता"

#: shutdowndlg.cpp:99
msgid "End Session for \"%1\""
msgstr "\"%1\" को  सत्र अन्त्य गर्नुहुन्छ ?"

#: shutdowndlg.cpp:125
msgid "&End Current Session"
msgstr "हालको सत्र अन्त्य गर्नुहोस्"

#: shutdowndlg.cpp:133
msgid "&Turn Off Computer"
msgstr "कम्प्युटर बन्द गर्नुहोस्"

#: shutdowndlg.cpp:141
msgid "&Restart Computer"
msgstr "कम्प्युटर फेरि सुरु गर्नुहोस्"

#: shutdowndlg.cpp:159
msgid ""
"_: current option in boot loader\n"
" (current)"
msgstr " (चालू)"
