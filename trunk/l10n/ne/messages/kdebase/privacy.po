#: privacy.cpp:96
msgid "Cookies"
msgstr "कुकिज"

#: privacy.cpp:98
msgid "Saved Clipboard Contents"
msgstr "क्लिपबोर्ड सामाग्रीहरू बचत गरियो"

#: privacy.cpp:100
msgid "Web History"
msgstr "वेब इतिहास"

#: privacy.cpp:102
msgid "Web Cache"
msgstr "वेब क्यास"

#: privacy.cpp:104
msgid "Form Completion Entries"
msgstr "पूर्ण प्रविष्टिहरू निर्माण गर्नुहोस्"

#: privacy.cpp:106
msgid "Recent Documents"
msgstr "हालका कागजातहरू"

#: privacy.cpp:108
msgid "Quick Start Menu"
msgstr "द्रुत शुरू मेनु"

#: privacy.cpp:110
msgid "Favorite Icons"
msgstr "प्रिय प्रतिमाहरू"

#: privacy.cpp:112
msgid ""
"Check all cleanup actions you would like to perform. These will be executed by "
"pressing the button below"
msgstr ""
"तपाईंले लागू गर्न खोज्नुभएको सबै कार्यहरू सफा गर्नुहोस्। यीहरू तलको बटन थिचेर "
"कार्यान्वयन हुन्छ"

#: privacy.cpp:113
msgid "Immediately performs the cleanup actions selected above"
msgstr "माथि चयन गरिएकालाई तुरून्त सफा गर्ने कार्यहरू लागू गर्नुहोस्"

#: privacy.cpp:115
msgid "Clears all cached thumbnails"
msgstr "सबै क्यास थम्बनेलहरू सफा गर्नुहोस्"

#: privacy.cpp:116
msgid ""
"Clears the history of commands run through the Run Command tool on the desktop"
msgstr ""
"डेस्कटपको चालु आदेश उपकरण मार्फत चलाइएको आदेशहरूको इतिहास सफा गर्नुहोस्"

#: privacy.cpp:117
msgid "Clears all stored cookies set by websites"
msgstr "वेबसाइटहरू द्वारा सेट भएको सबै संग्रहित कुकिजहरू सफा गर्नुहोस्"

#: privacy.cpp:118
msgid "Clears the history of visited websites"
msgstr "ब्रमण गरिएको वेबसाइटहरूको इतिहास सफा गर्नुहोस्"

#: privacy.cpp:119
msgid "Clears the clipboard contents stored by Klipper"
msgstr "क्लिप्पर द्वारा संग्रहित भएको क्लिपबोर्ड सामाग्रीहरू सफआ गर्नुहोस्"

#: privacy.cpp:120
msgid "Clears the temporary cache of websites visited"
msgstr "भ्रमण गरिएको वेबसाइटका अस्थायी क्यासहरू सफा गर्नुहोस्"

#: privacy.cpp:121
msgid "Clears values which were entered into forms on websites"
msgstr "वेबसाइटहरूको फारममा प्रविष्ट गरिएको मानहरू सफा गर्नुहोस्"

#: privacy.cpp:122
msgid ""
"Clears the list of recently used documents from the KDE applications menu"
msgstr ""
"KDE अनुप्रयोग मेनूहरूबाट हालका प्रयोग गरिएका कागजातहरूको सूची सफा गर्नुहोस्"

#: privacy.cpp:123
msgid "Clears the entries from the list of recently started applications"
msgstr "हालमा प्रयोग गरिएका अनुप्रयोगहरूको सूचीबाट प्रविष्टिहरू सफा गर्नुहोस्"

#: privacy.cpp:124
msgid "Clears the FavIcons cached from visited websites"
msgstr "भ्रमण गरिएका वेबसाइटहरूबाट प्रियप्रतिमाहरू सफा गर्नुहोस्"

#: privacy.cpp:247
msgid ""
"You are deleting data that is potentially valuable to you. Are you sure?"
msgstr ""
"तपाईं डेटा मेटाउँदै हुनुहुन्छ जुन तपाईंलाई अति नै मूल्यवान छ। के तपाईं निश्चित "
"हुनुहुन्छ?"

#: privacy.cpp:250
msgid "Starting cleanup..."
msgstr "सफा गर्ने शुरू गर्दै..."

#: privacy.cpp:259
msgid "Clearing %1..."
msgstr "सफा गर्दै %1..."

#: privacy.cpp:294
msgid "Clearing of %1 failed"
msgstr "%1 फाँटको सफा गर्दै"

#: privacy.cpp:301
msgid "Clean up finished."
msgstr "सफा गर्ने सकियो।"

