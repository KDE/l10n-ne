#: groupwise.cpp:116
msgid "Unknown path. Known paths are '/freebusy/', '/calendar/' and '/addressbook/'."
msgstr "अज्ञात बाटो । पहिचान भएका बाटा '/freebusy/', '/calendar/' and '/addressbook/' हुन् ।"

#: groupwise.cpp:162
msgid "Illegal filename. File has to have '.ifb' suffix."
msgstr "अवैद्य फाइल नाम । फाइलमा '.ifb' प्रत्यय भएको हुनुपर्छ ।"

