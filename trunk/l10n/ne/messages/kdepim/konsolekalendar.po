msgstr "त्यस्तो घटना यूआईडी होइन: असफल भएको घटना परिवर्तन गर्नुहोस्"

#: main.cpp:959
msgid "No such event UID: delete event failed"
msgstr "त्यस्तो घटना यूआईडी होइन: असफल भएको घटना मेट्नुहोस्"

#: main.cpp:973
#, c-format
msgid "Cannot open specified export file: %1"
msgstr "निर्दिष्ट गरिएको निर्यात फाइल खोल्न सकिँदैन: %1"

