#, c-format
msgid "  %1"
msgstr "  %1"

#: main.cpp:255
msgid "  %1 (like %2, but in a month view)"
msgstr "  %1 (जस्तै %2, तर महिना दृश्यमा)"

#: main.cpp:258
msgid "  %1 (Comma-Separated Values)"
msgstr "  %1 (अल्पबिराम विभाजित मान)"

