#: boardwidget.cpp:47
msgid ""
"An error occurred when loading the tileset file %1\n"
"KMahjongg will now terminate."
msgstr ""
"%1 टायल सेट फाइल लोड गर्दा त्रुटि भयो ।\n"
"के मोहजोङ अहिले बन्द हुँदैछ ।"

#: boardwidget.cpp:58
#, c-format
msgid ""
"An error occurred when loading the background image\n"
"%1"
msgstr ""
"पृष्ठभूमि छवि लोड गर्दा त्रुटि भयो\n"
"%1"

#: boardwidget.cpp:59
msgid "KMahjongg will now terminate."
msgstr "के मोहजोड अहिले बन्द हुदैछ"

#: boardwidget.cpp:67
msgid ""
"An error occurred when loading the board layout %1\n"
"KMahjongg will now terminate."
msgstr ""
"%1 बोर्ड सजावट लोड गर्दा त्रुटि भयो\n"
"के मोहजोङ बन्द हुँदैछ"

#: boardwidget.cpp:112
msgid ""
"KMahjongg could not locate the file: %1\n"
"or the default file of type: %2\n"
"KMahjongg will now terminate"
msgstr ""
"के मोहजिङले फाइल तोक्न सकेन: %1\n"
"वा पूर्वनिर्धारित फाइल वा प्रकार: %2\n"
"के मोहजोड बन्द हुँदैछ"

#: boardwidget.cpp:503
msgid "Undo operation done successfully."
msgstr "पूर्वस्थितिमा फर्काउने काम सफल भयो"

#: boardwidget.cpp:507
msgid "What do you want to undo? You have done nothing!"
msgstr ""
"तपाईँले के पूर्वस्थितिमा फर्काउन चाहनुहुन्छ ? तपाईँले केहि पनि गर्नु भएको छैन !"

#: boardwidget.cpp:526
msgid "Sorry, you have lost the game."
