#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Nabin Gautam"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "nabin@mpp.org.np"

#: lskat.cpp:162 lskat.cpp:163
msgid "Starting a new game..."
msgstr "नयाँ खेल सुरुआत गर्दैछ..."

#: lskat.cpp:164
msgid "&End Game"
msgstr "अन्तिम खेल"

#: lskat.cpp:166
msgid "Ending the current game..."
msgstr "हालको खेल अन्त्य हुदैछ..."

#: lskat.cpp:167
msgid "Aborts a currently played game. No winner will be declared."
msgstr "हालै खेलिएको खेल परित्याग गर्छ । बिजेता घोषित हुने छैन ।"

#: lskat.cpp:168
msgid "&Clear Statistics"
msgstr "तथ्याङ्क खाली गर्नुहोस्"

#: lskat.cpp:170
msgid "Delete all time statistics..."
msgstr "सबै समयका तथ्याङ्क मेट्नुहोस्..."

#: lskat.cpp:171
msgid "Clears the all time statistics which is kept in all sessions."
msgstr "सबै सत्रमा राखिएका सबै समयका तथ्याङ्क खाली गर्छ ।"

#: lskat.cpp:172
msgid "Send &Message..."
msgstr "सन्देश पठाउदैछ..."

#: lskat.cpp:174
msgid "Sending message to remote player..."
msgstr "रिमोट खेलाडीलाई सन्देश पठाउदैछ..."

#: lskat.cpp:175
msgid "Allows you to talk with a remote player."
msgstr "तपाईँलाई रिमोट खेलाडी सँग वार्ता गर्न अनुमति दिन्छ ।"

#: lskat.cpp:177
msgid "Exiting..."
msgstr "बाहिर निस्कदैछ..."

#: lskat.cpp:178
msgid "Quits the program."
msgstr "कार्यक्रम अन्त्य गर्छ ।"

#: lskat.cpp:180
msgid "Starting Player"
msgstr "सुरुको खेलाडी"

#: lskat.cpp:182
msgid "Changing starting player..."
msgstr "सुरुको खेलाडी परिवर्तन..."

#: lskat.cpp:183
msgid "Chooses which player begins the next game."
msgstr "पछिल्लो खेल सुरुआत गर्ने खेलाडी रोज्दछ ।"

#: lskat.cpp:185
msgid "Player &1"
msgstr "खेलाडी १"

#: lskat.cpp:186
msgid "Player &2"
msgstr "खेलाडी २"

#: lskat.cpp:189
msgid "Player &1 Played By"
msgstr "खेलाडी १ खेलिसक्यो"

#: lskat.cpp:191 lskat.cpp:192
msgid "Changing who plays player 1..."
msgstr "खेलाडी 1 परिवर्तन गरिदैछ ..."

#: lskat.cpp:194
msgid "&Player"
msgstr "खेलाडी"

#: lskat.cpp:195
msgid "&Computer"
msgstr "कम्प्युटर"

#: lskat.cpp:196
msgid "&Remote"
msgstr "रिमोट"

#: lskat.cpp:198
msgid "Player &2 Played By"
msgstr "खेलाडी २ ले खेलिसक्यो"

#: lskat.cpp:200 lskat.cpp:201
msgid "Changing who plays player 2..."
msgstr "खेलाडी २ परिवर्तन गरिदैछ..."

#: lskat.cpp:204
msgid "&Level"
msgstr "स्तर"

#: lskat.cpp:206
msgid "Change level..."
msgstr "स्तर परिवर्तन गर्नुहोस्..."

#: lskat.cpp:207
msgid "Change the strength of the computer player."
msgstr "कम्प्युटर खेलाडीको शक्ति परिवर्तन गर्नुहोस् ।"

#: lskat.cpp:209
msgid "&Normal"
msgstr "समान्य"

#: lskat.cpp:210
msgid "&Advanced"
msgstr "उन्नत"

#: lskat.cpp:211
msgid "&Hard"
msgstr "कठीन"

#: lskat.cpp:214
msgid "Select &Card Deck..."
msgstr "कार्ड डेक चयन गर्नुहोस्..."

#: lskat.cpp:216
msgid "Configure card decks..."
msgstr "कार्ड डेक कन्फिगर गर्नुहोस्..."

#: lskat.cpp:217
msgid "Choose how the cards should look."
msgstr "तास कसरी हेर्ने रोज्नुहोस् ।"

#: lskat.cpp:219
msgid "Change &Names..."
msgstr "नाम परिवर्तन गर्नुहोस्..."

#: lskat.cpp:221 lskat.cpp:222
msgid "Configure player names..."
msgstr "खेलाडी नाम कन्फिगर गर्नुहोस्..."

#: lskat.cpp:238
msgid "This leaves space for the mover"
msgstr "यसले चालकका लागि खाली ठाउँ छोड्दछ"

#: lskat.cpp:239 lskat.cpp:545 lskat.cpp:875
msgid "Ready"
msgstr "तयार"

#: lskat.cpp:241
msgid "(c) Martin Heni   "
msgstr "(c) मार्टिन हेनी   "

#: lskat.cpp:242
msgid "Welcome to Lieutenant Skat"
msgstr "लेफ्टिनेन्ट एसक्याटमा स्वागत छ"

#: lskat.cpp:264 lskat.cpp:336 lskat.cpp:687 lskatview.cpp:288 main.cpp:33
msgid "Lieutenant Skat"
msgstr "लेफ्टिनेन्ट एसक्याट"

#: lskat.cpp:358
msgid "Do you really want to clear the all time statistical data?"
msgstr "के तपाईँ वास्तवमै सबै समयका तथ्याङ्किय लगत खाली गर्न चाहनुहुन्छ?"

#: lskat.cpp:403
msgid "Game ended...start a new one..."
msgstr "खेल समाप्त...नयाँ एक सुरु गर्नुहोस्..."

#: lskat.cpp:587
msgid "No game running"
msgstr "खेल चलेको छैन"

#: lskat.cpp:590
msgid "%1 to move..."
msgstr "चलाउनका लागि %1..."

#: lskat.cpp:605
msgid ""
"Cannot start player 1. Maybe the network connection failed or the computer "
"player process file is not found."
msgstr "खेलाडी १ ले सुरुआत गर्न सक्दैन । सञ्जाल जडान असफल भएको वा कम्प्युटरको खेलाडी प्रक्रिया फाइल फेला नपरेको हुनसक्छ ।"

#: lskat.cpp:614
msgid ""
"Cannot start player 2. Maybe the network connection failed or the computer "
"player process file is not found."
msgstr "खेलाडी २ ले सुरुआत गर्न सक्दैन । सञ्जाल जडान असफल भएको वा कम्प्युटरको खेलाडी प्रक्रिया फाइल फेला नपरेको हुनसक्छ ।"

#: lskat.cpp:680
msgid "Remote connection to %1:%2..."
msgstr "%1:%2 मा रिमोड जडान..."

#: lskat.cpp:684
msgid "Offering remote connection on port %1..."
msgstr "पोर्ट %1 मा रिमोट जडान प्रस्ताव गर्दैछ..."

#: lskat.cpp:686
msgid "Abort"
msgstr "परित्याग गर्नुहोस्"

#: lskat.cpp:769
msgid "Waiting for the computer to move..."
msgstr "सार्न कम्प्युटरले प्रतिक्षा गर्दैछ..."

#: lskat.cpp:785
msgid "Waiting for remote player..."
msgstr "रिमोट खेलाडीले प्रतिक्षा गर्दैछ..."

#: lskat.cpp:792
msgid "Please make your move..."
msgstr "कृपया तपाईँले सार्नुहोस्..."

#: lskat.cpp:827
msgid "Remote connection lost for player 1..."
msgstr "खेलाडी १ को रिमोट जडान छुट्यो..."

#: lskat.cpp:834
msgid "Remote connection lost for player 2..."
msgstr "खेलाडी २ को रिमोट जडान छुट्यो..."

#: lskat.cpp:846
msgid "Message from remote player:\n"
msgstr "रिमोट खेलाडीको सन्देश:\n"

#: lskat.cpp:864
msgid "Remote player ended game..."
msgstr "रिमोट खेलाडीले खेल अन्त्य गर्यो..."

#: lskat.cpp:889
msgid "You are network client...loading remote game..."
msgstr "तपाईँ सञ्जाल ग्राहाक हुनुहुन्छ...रिमोट खेला लोड गर्नुहोस्..."

#: lskat.cpp:902
msgid "You are network server..."
msgstr "तपाईँ सञ्जाल सर्भर हुनुहुन्छ..."

#: lskat.cpp:960
msgid ""
"Severe internal error. Move to illegal position.\n"
"Restart game and report bug to the developer.\n"
msgstr ""
"सर्भरमा आन्तरिक त्रुटि । अवैधानिक स्थितिमा सार्नुहोस ।\n"
"खेल पुन: सुरु गर्नुहोस् र बिकासकर्तालाई बग प्रतिवेदन गर्नुहोस् ।\n"

#: lskat.cpp:986
msgid ""
"This move would not follow the rulebook.\n"
"Better think again!\n"
msgstr ""
"यो चालले नियम पुस्तिका पालना गर्नेछैन ।\n"
"फेरी त्यो भन्दा उचित सोच्नुहोस्!\n"

#: lskat.cpp:992
msgid "It is not your turn.\n"
msgstr "यो तपाईँको पालो होइन ।\n"

#: lskat.cpp:997
msgid "This move is not possible.\n"
msgstr "यो चाल सम्भव छैन ।\n"

#: lskatdoc.cpp:749
msgid "Alice"
msgstr "एलाइस"

#: lskatdoc.cpp:751
msgid "Bob"
msgstr "बब"

