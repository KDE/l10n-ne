msgid "Game over"
msgstr "खेल समाप्त"

#: lskatview.cpp:417
msgid "Game was aborted - no winner"
msgstr "खेल परित्याग गरिएको थियो - विजेता छैन"

#: lskatview.cpp:428
msgid "      Game is drawn"
msgstr "      खेल तानिएको छ"

#: lskatview.cpp:432
msgid "Player 1 - %1 won "
msgstr "खेलाडी 1 - %1 बिजयी भयो "

#: lskatview.cpp:436
msgid "Player 2 - %1 won "
msgstr "खेलाडी 2 - %1 बिजयी भयो "

