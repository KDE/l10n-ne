#: kocrkadmos.cpp:282
msgid "Font Type Selection"
msgstr "फन्ट प्रकार चयन"

#: kocrkadmos.cpp:284
msgid "Machine print"
msgstr "मेशिन मुद्रण"

#: kocrkadmos.cpp:285
msgid "Hand writing"
msgstr "हाते लेखन"

#: kocrkadmos.cpp:286
msgid "Norm font"
