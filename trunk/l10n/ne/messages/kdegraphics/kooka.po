#: img_saver.cpp:63
msgid "Kooka Save Assistant"
msgstr "कोकाले सहायकलाई बचत गर्यो"

#: img_saver.cpp:81
msgid ""
"<B>Save Assistant</B><P>Select an image format to save the scanned image."
msgstr ""
"<B>सहायक बचत गर्नुहोस्</B><P>स्क्यान गरिएको छवि बचत गर्न एउटा छवि ढाँचा चयन "
"गर्नुहोस् ।"

#: img_saver.cpp:99
msgid "Available image formats:"
msgstr "उपलब्ध छवि ढाँचा:"

#: img_saver.cpp:118
msgid "-No format selected-"
msgstr "कुनै ढाँचा चयन गरिएको छैन"

#: img_saver.cpp:125
msgid "Select the image sub-format"
msgstr "छवि उप-ढाँचा चयन गर्नुहोस्"

#: img_saver.cpp:130
msgid "Don't ask again for the save format if it is defined."
msgstr "यदि यो परिभाषित गरिएको छ भने बचतका लागि फेरी नसोध्नुहोस् ।"

#: img_saver.cpp:164
msgid "-no hint available-"
msgstr "कुनै सङ्केत उपलब्ध छैन"

#: img_saver.cpp:278
msgid ""
"The folder\n"
"%1\n"
" does not exist and could not be created;\n"
"please check the permissions."
msgstr ""
"फोल्डर\n"
"%1\n"
" अवस्थित छैन र सिर्जना गर्न सकिएन;\n"
"कृपया अनुमति जाँच गर्नुहोस् ।"

#: img_saver.cpp:285
msgid ""
"The directory\n"
"%1\n"
" is not writeable;\n"
"please check the permissions."
msgstr ""
"डाइरेक्टरी\n"
"%1\n"
"लेखनयोग्य छैन;\n"
"कृपया अनुमति जाँच गर्नुहोस् ।"

#: img_saver.cpp:344
msgid "Filename"
msgstr "फाइलनाम"

#: img_saver.cpp:344
msgid "Enter filename:"
msgstr "फाइलनाम प्रविष्ट गर्नुहोस्:"

#: img_saver.cpp:488
msgid "palleted color image (16 or 24 bit depth)"
msgstr "रङदानीमा राखिएको रङ्गीन छवि (१६ वा २४ बिट गहिराइ)"

#: img_saver.cpp:491
msgid "palleted gray scale image (16 bit depth)"
msgstr "रङदानीमा राखिएको ग्रेस्केल छवि (१६ बिट गहिराइ)"

#: img_saver.cpp:494
msgid "lineart image (black and white, 1 bit depth)"
msgstr "रेखिय छवि (श्यामश्वेत, १ बिट गहिराइ)"

#: img_saver.cpp:497
msgid "high (or true-) color image, not palleted"
msgstr "उच्च (वा सही) रङ छवि, रङदानीमा राखिएको छैन"

#: img_saver.cpp:500
msgid "Unknown image type"
msgstr "अज्ञात छवि प्रकार"

#: img_saver.cpp:711
msgid " image save OK      "
msgstr "छवि बचत ठीक छ      "

#: img_saver.cpp:712
msgid " permission error   "
msgstr "अनुमति त्रुटि   "

#: img_saver.cpp:713
msgid " bad filename       "
msgstr "खराब फाइलनाम      "

#: img_saver.cpp:714
msgid " no space on device "
msgstr "यन्त्रमा खालीस्थान छैन "

#: img_saver.cpp:715
msgid " could not write image format "
msgstr "छवि ढाँचा लेख्न सकेन "

#: img_saver.cpp:716
msgid " can not write file using that protocol "
msgstr "त्यो प्रोटोकल प्रयोग गरेर फाइल लेख्न सकिँदैन "

#: img_saver.cpp:717
msgid " user canceled saving "
msgstr "प्रयोगकर्ताले बचत रद्द गर्यो "

#: img_saver.cpp:718
msgid " unknown error      "
msgstr " अज्ञात त्रुटि       "

#: img_saver.cpp:719
msgid " parameter wrong    "
msgstr "परामिति गल्ति    "

#: img_saver.cpp:768 img_saver.cpp:865
msgid ""
"The filename you supplied has no file extension.\n"
"Should the correct one be added automatically? "
msgstr ""
"तपाईँले पूर्ति गर्नु भएको फाइलनामसँग फाइल विस्तार छैन ।\n"
"के सही एउटा स्वचालित रूपमा थप्न सकिन्छ ? "

#: img_saver.cpp:769 img_saver.cpp:866
#, c-format
msgid "That would result in the new filename: %1"
msgstr "त्यसले नयाँ फाइलनाममा नतिजा गर्नेछ: %1"

#: img_saver.cpp:771 img_saver.cpp:868
msgid "Extension Missing"
msgstr "विस्तार हराइरहेको छ"

#: img_saver.cpp:772 img_saver.cpp:869
msgid "Add Extension"
msgstr "विस्तार थप्नुहोस्"

#: img_saver.cpp:772 img_saver.cpp:869
msgid "Do Not Add"
msgstr "नथप्नुहोस्"

#: img_saver.cpp:789 img_saver.cpp:883
msgid "Format changes of images are currently not supported."
msgstr "छविको ढाँचा परिवर्तनहरू हालै समर्थन गरिएको छैन ।"

#: img_saver.cpp:790 img_saver.cpp:884
msgid "Wrong Extension Found"
msgstr "गलत विस्तार फेला पर्यो"

#: imgprintdialog.cpp:55
msgid "Image Printing"
msgstr "छवि मुद्रण"

#: imgprintdialog.cpp:60 imgprintdialog.cpp:113
msgid "Image Print Size"
msgstr "छवि मुद्रण साइज"

#: imgprintdialog.cpp:64
msgid "Scale to same size as on screen"
msgstr "पर्दामा जस्तै एउटै साइजमा मापन गर्नुहोस्"

#: imgprintdialog.cpp:66
msgid "Screen scaling. That prints according to the screen resolution."
msgstr "पर्दा मापन । त्यो पर्दा रिजोल्युसनको आधारमा मुद्रण गर्दछ ।"

#: imgprintdialog.cpp:70
msgid "Original size (calculate from scan resolution)"
msgstr "मौलिक साइज (स्क्यान रिजोल्युसनबाट गणना गर्नुहोस्)"

#: imgprintdialog.cpp:73
msgid ""
"Calculates the print size from the scan resolution. Enter the scan resolution "
"in the dialog field below."
msgstr ""
"स्क्यान रिजोल्युसनबाट मुद्रण साइज गणना गर्दछ । तल संवाद फाँटमा स्क्यान "
"रिजोल्युसन प्रविष्ट गर्नुहोस् ।"

#: imgprintdialog.cpp:77
msgid "Scale image to custom dimension"
msgstr "अनुकूल आयाममा छवि मापन गर्नुहोस्"

#: imgprintdialog.cpp:79
msgid ""
"Set the print size yourself in the dialog below. The image is centered on the "
"paper."
msgstr ""
"तल संवादमा आफै मुद्रण साइज सेट गर्नुहोस् । छवि कागजमा केन्द्रिकृत गरिएको छ ।"

#: imgprintdialog.cpp:83
msgid "Scale image to fit to page"
msgstr "पृष्ठमा मिलाउन छवि मापन गर्नुहोस्"

#: imgprintdialog.cpp:84
msgid ""
"Printout uses maximum space on the selected pager. Aspect ratio is maintained."
msgstr ""
"चयन गरिएको पेजरमा प्रयोग गरिएको अधिक्तम खाली स्थान मुद्रण गर्नुहोस् । आकृति "
"अनुपात राखिएको छ ।"

#: imgprintdialog.cpp:94
msgid "Resolutions"
msgstr "रिजोल्युसन"

#: imgprintdialog.cpp:98
msgid "Generate low resolution PostScript (fast draft print)"
msgstr "न्युन रिजोलुसन पोस्टस्क्रिप्ट सिर्जना गर्नुहोस् (द्रुत ड्राफ्ट मुद्रण)"

#: imgprintdialog.cpp:105
msgid "Scan resolution (dpi) "
msgstr "(डी पी आई) रिजोल्युसन स्क्यान गर्नुहोस् "

#: imgprintdialog.cpp:107
msgid " dpi"
msgstr " डी पी आई"

#: imgprintdialog.cpp:117
msgid "Image width:"
msgstr "छवि चौडाइ:"

#: imgprintdialog.cpp:118 imgprintdialog.cpp:122
msgid " mm"
msgstr " मिलिमिटर"

#: imgprintdialog.cpp:121
msgid "Image height:"
msgstr "छवि उचाइ:"

#: imgprintdialog.cpp:125
msgid "Maintain aspect ratio"
msgstr "आकृति अनुपात राख्नुहोस्"

#: imgprintdialog.cpp:170
msgid "Screen resolution: %1 dpi"
msgstr "पर्दा रिजोल्युसन: %1 डी पी आई"

#: imgprintdialog.cpp:214
msgid "Please specify a scan resolution larger than 0"
msgstr "कृपया ० भन्दा ठूलो स्क्यान रिजोल्युसन निर्दिष्ट गर्नुहोस्"

#: imgprintdialog.cpp:219
msgid ""
"For custom printing, a valid size should be specified.\n"
"At least one dimension is zero."
msgstr ""
"अनुकूल मुद्रणका लागि, वैध साइज निर्दिष्ट गर्नुपर्नेछ ।\n"
"कम्तिमा एउटा आयाम शून्य हुनुपर्छ ।"

