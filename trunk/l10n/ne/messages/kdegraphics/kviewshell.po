msgstr ""
"<qt><strong>फाइल त्रुटि!</strong> ले अस्थायी फाइल सिर्जना गर्न सकेन ।</qt>"

#: kviewpart.cpp:679
msgid ""
"<qt><strong>File Error!</strong> Could not create temporary file <nobr><strong>"
