#: insertfileplugin.cpp:79
msgid "Insert File..."
msgstr "फाइल घुसाउनुहोस..."

#: insertfileplugin.cpp:88
msgid "Choose File to Insert"
msgstr "घुसाउनको लागि फाइल रोज्नुहोस्"

#: insertfileplugin.cpp:116
msgid ""
"Failed to load file:\n"
"\n"
msgstr ""
"फाइल लोड गर्न असक्षम:\n"
"\n"

#: insertfileplugin.cpp:116 insertfileplugin.cpp:137 insertfileplugin.cpp:159
msgid "Insert File Error"
msgstr "फाइल त्रुटी घुसाउनुहोस्"

#: insertfileplugin.cpp:130
msgid "<p>The file <strong>%1</strong> does not exist or is not readable, aborting."
msgstr "<p>फाइल <strong>%1</strong> अवस्थित छैन,वा पढ्न योग्य छैन,परित्याग गर्दै ।"

#: insertfileplugin.cpp:134
msgid "<p>Unable to open file <strong>%1</strong>, aborting."
msgstr "<p>फाइल खोल्न असक्षम<strong>%1</strong>, परित्याग गर्दै ।"

#: insertfileplugin.cpp:157
msgid "<p>File <strong>%1</strong> had no contents."
msgstr "<p>फाइल <strong>%1</strong>संग सामाग्रीहरू छैन ।"

