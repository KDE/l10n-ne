#: part/katesearch.cpp:72
msgid "Look up the first occurrence of a piece of text or regular expression."
msgstr "त्यो पाठको टुक्रा वा नियमित अभिव्यक्तिको पहिलो घटना हेर्नुहोस् ।"

#: part/katesearch.cpp:74
msgid "Look up the next occurrence of the search phrase."
msgstr "खोजी वाक्यांशको पछिल्लो घटना हेर्नुहोस् ।"

#: part/katesearch.cpp:76
msgid "Look up the previous occurrence of the search phrase."
msgstr "खोजी वाक्यांशको अघिल्लो घटना हेर्नुहोस् ।"

#: part/katesearch.cpp:78
msgid ""
"Look up a piece of text or regular expression and replace the result with some "
"given text."
msgstr ""
"पाठको टुक्रा वा नियमित अभिव्यक्तिलाई हेर्नुहोस् र दिइएको केही पाठले परिणामलाई "
"बदल्नुहोस् ।"

#: part/katesearch.cpp:329
