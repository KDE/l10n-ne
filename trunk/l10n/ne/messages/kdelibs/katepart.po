msgstr "कागजातको सुरुआतमा पुगियो ।"

#: part/katesearch.cpp:483
msgid "End of selection reached."
msgstr "चयनको अन्त्यमा पुगियो ।"

#: part/katesearch.cpp:484
msgid "Beginning of selection reached."
msgstr "चयनको सुरुआतमा पुगियो ।"

#: part/katesearch.cpp:488
msgid "Continue from the beginning?"
msgstr "सुरुआतबाट जारी राख्नुहुन्छ ?"

#: part/katesearch.cpp:489
msgid "Continue from the end?"
msgstr "अन्त्यबाट जारी राख्नुहुन्छ ?"

#: part/katesearch.cpp:497
msgid "&Stop"
msgstr "रोक्नुहोस्"

#: part/katesearch.cpp:721
msgid "Replace Confirmation"
msgstr "प्रतिस्थापन यकिन"

#: part/katesearch.cpp:723
msgid "Replace &All"
msgstr "सबै बदल्नुहोस्"

#: part/katesearch.cpp:723
msgid "Re&place && Close"
msgstr "बदलेर बन्द गर्नुहोस्"

#: part/katesearch.cpp:723
msgid "&Replace"
msgstr "बदल्नुहोस्"

#: part/katesearch.cpp:725
msgid "&Find Next"
msgstr "पछिल्लो फेला पार्नुहोस्"

#: part/katesearch.cpp:730
msgid "Found an occurrence of your search term. What do you want to do?"
msgstr "तपाईँको खोजी टर्मको घटना फेला पर्यो । तपाईँ के गर्न चाहनुहुन्छ ?"

#: part/katesearch.cpp:782
msgid "Usage: find[:[bcersw]] PATTERN"
msgstr "उपयोग: फेला पार्नुहोस् [:[bcersw]] PATTERN"

#: part/katesearch.cpp:794
msgid "Usage: ifind[:[bcrs]] PATTERN"
msgstr "उपयोग: फेला पार्नुहोस्[:[bcrs]] PATTERN"

#: part/katesearch.cpp:848
msgid "Usage: replace[:[bceprsw]] PATTERN [REPLACEMENT]"
msgstr "उपयोग: बदल्नुहोस् [:[bceprsw]] PATTERN [REPLACEMENT]"

#: part/katesearch.cpp:882
msgid "<p>Usage: <code>find[:bcersw] PATTERN</code></p>"
msgstr "<p>उपयोग: <code>फेला पार्नुहोस् [:bcersw] PATTERN</code></p>"

#: part/katesearch.cpp:885
msgid ""
"<p>Usage: <code>ifind:[:bcrs] PATTERN</code>"
"<br>ifind does incremental or 'as-you-type' search</p>"
msgstr ""
"<p>उपयोग: <code>ifind:[:bcrs] PATTERN</code>"
"<br>ifind बढोत्तरित वा तपाईँले टाइप गरेको जस्तै खोजी हो</p>"

#: part/katesearch.cpp:889
msgid "<p>Usage: <code>replace[:bceprsw] PATTERN REPLACEMENT</code></p>"
msgstr "<p>उपयोग: <code>बदल्नुहोस् [:bceprsw] PATTERN REPLACEMENT</code></p>"

#: part/katesearch.cpp:892
msgid ""
"<h4><caption>Options</h4>"
"<p><b>b</b> - Search backward"
"<br><b>c</b> - Search from cursor"
"<br><b>r</b> - Pattern is a regular expression"
"<br><b>s</b> - Case sensitive search"
msgstr ""
"<h4><caption>विकल्प</h4>"
"<p><b>b</b> - पछिल्तिर खोज्नुहोस् "
"<br><b>c</b> - कर्सरबाट खोज्नुहोस् "
"<br><b>r</b> - बान्की नियमित अभिव्यक्ति हो"
"<br><b>s</b> - केस सम्वेदनशीलता खोजी"

#: part/katesearch.cpp:901
msgid ""
"<br><b>e</b> - Search in selected text only"
"<br><b>w</b> - Search whole words only"
msgstr ""
"<br><b>e</b> -चयन गरिएका पाठमा मात्र खोजी गर्नुहोस्"
"<br><b>w</b> -पुरा शब्दमा मात्र खोजी गर्नुहोस्"

#: part/katesearch.cpp:907
msgid ""
"<br><b>p</b> - Prompt for replace</p>"
"<p>If REPLACEMENT is not present, an empty string is used.</p>"
"<p>If you want to have whitespace in your PATTERN, you need to quote both "
"PATTERN and REPLACEMENT with either single or double quotes. To have the quote "
"characters in the strings, prepend them with a backslash."
msgstr ""
"<br><b>p</b> - बदल्नका लागि तत्पर</p>"
"<p>यदि प्रतिस्थापन प्रस्तुत नभएमा, एउटा खाली स्ट्रिड्ग प्रयोग हुन्छ ।</p>"
"<p>यदि तपाईँ बान्कीमा सेतो खाली स्थान चाहनुहुन्छ भने, दुबै बान्की र "
"प्रतिस्थापनसँग एकल वा दोब्बर उद्धरणहरू उद्धरण गर्न आवश्यक पर्छ । स्टिङमा उद्धरण "
"क्यारेक्टर हुन, तीनिहरू ब्याकस्ल्याससँग प्रिपेन्ड गर्नुहोस् ।"

