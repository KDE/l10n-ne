#, no-c-format
msgid "&Username:"
msgstr "प्रयोगकर्ता नाम:"

#: kio/passdlg.cpp:125
msgid "&Password:"
msgstr "पासवर्ड:"

#: kio/passdlg.cpp:147
msgid "&Keep password"
msgstr "पासवर्ड राख्नुहोस्"

#: kio/passdlg.cpp:345 kpasswdserver/kpasswdserver.cpp:355
msgid "Authorization Dialog"
msgstr "प्रमाणिकरण संवाद"

#: kio/krun.cpp:113
msgid ""
"<qt>Unable to enter <b>%1</b>.\n"
"You do not have access rights to this location.</qt>"
msgstr ""
"<qt>प्रविष्ट गर्न असक्षम <b>%1</b>.\n"
"तपाईँलाई यो तोक्नका लागि पहुँच अधिकार छैन ।</qt>"

#: kio/krun.cpp:152
msgid ""
"<qt>The file <b>%1</b> is an executable program. For safety it will not be "
"started.</qt>"
msgstr ""
"<qt>फाइल <b>%1</b> कार्यान्वयन योग्य कार्यक्रम हो । सुरक्षाका लागि यो सुरु नहुन "
"सक्छ ।</qt>"

#: kio/krun.cpp:159
msgid "<qt>You do not have permission to run <b>%1</b>.</qt>"
msgstr "<qt>तपाईँलाई <b>%1</b> चलाउन अनुमति नहुन सक्छ ।</qt>"

#: kio/krun.cpp:191
msgid "You are not authorized to open this file."
msgstr "तपाईँ यो फाइल खोल्न अधिकारिक हुनुहुन्न ।"

#: kfile/kopenwith.cpp:835 kio/krun.cpp:195
msgid "Open with:"
msgstr "यससँग खोल्नुहोस्:"

#: kio/krun.cpp:524
msgid "You are not authorized to execute this file."
msgstr "तपाईँ यो फाइल कार्यान्वयन गर्न आधिकारिक हुनुहुन्न ।"

#: kio/krun.cpp:544
#, c-format
msgid "Launching %1"
msgstr "%1 सुरुआत"

#: kio/krun.cpp:700
msgid "You are not authorized to execute this service."
msgstr "तपाईँ यो सेवा कार्यान्वयन गर्न आधिकारिक हुनुहुन्न ।"

#: kio/krun.cpp:854
msgid ""
"<qt>Unable to run the command specified. The file or folder <b>%1</b> "
"does not exist.</qt>"
msgstr ""
"<qt>निर्दिष्ट गरिएको आदेश चलाउन असक्षम । फाइल वा फोल्डर <b>%1</b> "
"अवस्थित छैन </qt>"

#: kio/krun.cpp:1349
msgid "Could not find the program '%1'"
msgstr "'%1' कार्यक्रम फेला पार्न सकेन"

#: kio/kfileitem.cpp:722
msgid "Symbolic Link"
msgstr "प्रतिकात्मक लिङ्क"

#: kio/kfileitem.cpp:724
