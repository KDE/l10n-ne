msgid "Password"
msgstr "पासवर्ड"

#: kio/passdlg.cpp:98
msgid "You need to supply a username and a password"
msgstr "तपाईँले प्रयोगकर्ता नाम र पासवर्ड वितरण गर्नआवश्यक हुन्छ"

#. i18n: file ./kfile/kpropertiesdesktopadvbase.ui line 134
