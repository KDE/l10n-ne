#: rc.cpp:178
#, no-c-format
msgid "Click to read configured notification events from a file."
msgstr "फाइलबाट कन्फिगर गरिएका सूचना घटना पढ्न क्लिक गर्नुहोस् ।"

#. i18n: file kcmkttsmgr/kcmkttsmgrwidget.ui line 613
#: rc.cpp:181 rc.cpp:651 rc.cpp:765
#, no-c-format
msgid "&Save..."
msgstr "बचत गर्नुहोस्..."

#. i18n: file kcmkttsmgr/kcmkttsmgrwidget.ui line 616
#: rc.cpp:184
#, no-c-format
msgid "Click to write all the configured application events to a file."
msgstr "फाइलमा कन्फिगर गरिएका सबै अनुप्रयोग घटना लेख्न क्लिक गर्नुहोस् ।"

#. i18n: file kcmkttsmgr/kcmkttsmgrwidget.ui line 637
#: rc.cpp:188
#, no-c-format
msgid "Click to test notification"
msgstr "परीक्षण सूचनामा क्लिक गर्नुहोस्"

#. i18n: file kcmkttsmgr/kcmkttsmgrwidget.ui line 640
#: rc.cpp:191
#, no-c-format
msgid ""
"Click this button to test the notification.  A sample message will be spoken.  "
"Note: The Text-to-Speech system must be enabled."
msgstr ""
"सूचना परीक्षण गर्न यो बटनमा क्लिक गर्नुहोस् ।  एउट नमूना सन्देश वाचन गरिनेछ ।  "
"द्रष्टव्य: पाठबाट संवाद प्रणाली सक्षम पारिएको हुनुपर्छ ।"

#. i18n: file kcmkttsmgr/kcmkttsmgrwidget.ui line 656
#: rc.cpp:194
#, no-c-format
msgid "Ac&tion:"
msgstr "कार्य:"

#. i18n: file kcmkttsmgr/kcmkttsmgrwidget.ui line 662
#: rc.cpp:197 rc.cpp:200 rc.cpp:203
