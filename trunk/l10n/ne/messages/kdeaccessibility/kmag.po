#: kmagzoomview.cpp:159
msgid ""
"This is the main window which shows the contents of the selected region. The "
"contents will be magnified according to the zoom level that is set."
msgstr ""
"यो चयन गरिएका क्षेत्रको सामाग्री देखाउने मुख्य सञ्झ्याल हो । सामाग्री जूम स्तर "
"सेट गरिए अनुरुप अभिवर्धन हुनेछन् ।"

#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Nabin Gautam"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "nabin@mpp.org.np"

#: main.cpp:37
msgid "File to open"
msgstr "फाइल खोल्न"

#: kmagselrect.cpp:228 main.cpp:45
msgid "KMagnifier"
msgstr "केअभिवर्धक"

#: main.cpp:46
msgid "Screen magnifier for the K Desktop Environment (KDE)"
msgstr "K डेस्कटप परिवेशका लागि (KDE) पर्दा अभिवर्धक"

#: main.cpp:53
msgid "Rewrite and current maintainer"
msgstr "पुन: लेख्ने र हालको सम्भारकर्ता"

#: main.cpp:56
msgid "Original idea and author (KDE1)"
msgstr "मौलिक विचार र लेखक (KDE1)"

#: main.cpp:58
msgid ""
"Rework of the user interface, improved selection window, speed optimisation, "
"rotation, bug fixes"
msgstr ""
"पुन: कार्य गर्ने प्रयोगकर्ता इन्टरफेस, सुधार गरिएको चयन सञ्झ्याल, उच्चतम गति, "
"परिक्रमण, स्थिर बग"

#: main.cpp:59
msgid "Some tips"
msgstr "केही टिप"

#: kmagselrect.cpp:228
msgid "Selection Window"
msgstr "सञ्झ्याल चयन गर्नुहोस्"

#: kmag.cpp:92
msgid "&Very Low"
msgstr "सार्है न्यून"

#: kmag.cpp:92
msgid "&Low"
msgstr "न्यून"

#: kmag.cpp:92
msgid "&Medium"
msgstr "मध्यम"

#: kmag.cpp:92
msgid "&High"
msgstr "उच्च"

#: kmag.cpp:92
msgid "V&ery High"
msgstr "सार्है उच्च"

#: kmag.cpp:100
msgid "&No Rotation (0°)"
msgstr "परिक्रमण विहिन (०°)"

#: kmag.cpp:100
msgid "&Left (90°)"
msgstr "बायाँ (९०°)"

#: kmag.cpp:100
msgid "&Upside Down (180°)"
msgstr "तल माथि (१८०°)"

#: kmag.cpp:100
msgid "&Right (270°)"
msgstr "दायाँ (२७०°)"

#: kmag.cpp:129
msgid "New &Window"
msgstr "नयाँ सञ्झ्याल"

#: kmag.cpp:131
msgid "Open a new KMagnifier window"
msgstr "नयाँ केअभिवर्धक सञ्झ्याल खोल्नुहोस्"

#: kmag.cpp:133
msgid "&Stop"
msgstr "रोक्नुहोस्"

#: kmag.cpp:135
msgid "Click to stop window refresh"
msgstr "सञ्झ्याल ताजा पार्नुहोस् रोक्न क्लिक गर्नुहोस्"

#: kmag.cpp:136
msgid ""
"Clicking on this icon will <b>start</b> / <b>stop</b>  "
"updating of the display. Stopping the update will zero the processing power  "
"required (CPU usage)"
msgstr ""
"यो प्रतिमा <b>start</b> / <b>stop</b>  क्लिक गर्दा यो प्रदर्शनको अद्यावधिक "
"गर्नेछ । अद्यावदिक बन्दा गर्दा प्रक्रिया सामर्थ्य शून्य हुनेछ (CPU उपयोग)"

#: kmag.cpp:140
msgid "&Save Snapshot As..."
msgstr "यसका रुपमा स्न्यापसट बचत गर्नुहोस्..."

#: kmag.cpp:142
msgid "Saves the zoomed view to an image file."
msgstr "जूम गरिएको छवि फाइलमा दृश्य बचत गर्छ ।"

#: kmag.cpp:143
msgid "Save image to a file"
msgstr "छवि फाइलमा बचत गर्नुहोस्"

#: kmag.cpp:146
msgid "Click on this button to print the current zoomed view."
msgstr "हालै जूम गरिएको दृश्य मुद्रण गर्न यो बटनना क्लिक गर्नुहोस् ।"

#: kmag.cpp:149 kmag.cpp:150
msgid "Quits the application"
msgstr "अनुप्रयोग अन्त्य गर्छ"

#: kmag.cpp:153
msgid ""
"Click on this button to copy the current zoomed view to the clipboard which you "
"can paste in other applications."
msgstr ""
"क्लिपबोर्डमा हालै जूम गरिएको दृश्य प्रतिलिपि गर्न यो बटनमा क्लिक गर्नुहोस् "
"जसलाई तपाईँले अन्य अनुप्रयोगमा टाँस्न सक्नुहुन्छ ।"

#: kmag.cpp:154
msgid "Copy zoomed image to clipboard"
msgstr "जूम गरिएको छवि क्लिपबोर्डमा प्रतिलिपि गर्नुहोस्"

#: kmag.cpp:156
msgid "Show &Menu"
msgstr "मेनु देखाउनुहोस्"

#: kmag.cpp:159
msgid "Hide &Menu"
msgstr "मेनु लुकाउनुहोस्"

#: kmag.cpp:161
msgid "Show Main &Toolbar"
msgstr "मुख्य उपकरणपट्टी देखाउनुहोस्"

#: kmag.cpp:164
msgid "Hide Main &Toolbar"
msgstr "मुख्य उपकरण पट्टी लुकाउनुहोस्"

#: kmag.cpp:166
msgid "Show &View Toolbar"
msgstr "दृश्य उपकरणपट्टी देखाउनुहोस्"

#: kmag.cpp:169
msgid "Hide &View Toolbar"
msgstr "दृश्य उपकरणपट्टी लुकाउनुहोस्"

#: kmag.cpp:171
msgid "Show &Settings Toolbar"
msgstr "सेटिङ उपकरणपट्टी देखाउनुहोस्"

#: kmag.cpp:174
msgid "Hide &Settings Toolbar"
msgstr "सेटिङ उपकरणपट्टी लुकाउनुहोस्"

#: kmag.cpp:177
msgid "&Follow Mouse Mode"
msgstr "माउस मोड पछ्याउनुहोस्"

#: kmag.cpp:179
msgid "Magnify mouse area into window"
msgstr "सञ्झ्यालमा माउसको क्षेत्र अभिवर्धन गर्नुहोस्"

#: kmag.cpp:180
msgid ""
"In this mode the area around the mouse cursor is shown in a normal window."
msgstr ""
"यो मोडमा सामान्य सञ्झ्याल भित्र माउस कर्सरको वरिपरिको क्षेत्र देखिने छ ।"

#: kmag.cpp:182
msgid "S&election Window Mode"
msgstr "सञ्झ्याल मोड चयन गर्नुहोस्"

#: kmag.cpp:184
msgid "Magnify selected area into window"
msgstr "सञ्झ्यालमा चयन गरिएको क्षेत्र अभिवर्धन गर्नुहोस्"

#: kmag.cpp:185
msgid ""
"In this mode a selection window is opened. The selected area is shown in a "
"normal window."
msgstr ""
"यो मोडमा चयन सञ्झ्याल खुल्ने छ । चयन गरिएको क्षेत्र सामान्य सञ्झ्यालमा देखिने छ "
"।"

#: kmag.cpp:187
msgid "&Top Screen Edge Mode"
msgstr "पर्दा किनाराको माथिल्लो मोड"

#: kmag.cpp:189
msgid "Magnify mouse area to top screen edge"
msgstr "पर्दा किनाराको माथि माउस क्षेत्र अभिवर्धन गर्नुहोस्"

#: kmag.cpp:190
msgid ""
"In this mode the area around the mouse is magnified to the top screen edge."
msgstr ""
"यो मोडमा पर्दाको माथिल्लो किनारामा माउस वरिपरिको क्षेत्र अभिवर्धन हुनेछ ।"

#: kmag.cpp:192
msgid "&Left Screen Edge Mode"
msgstr "पर्दाको बायाँ किनारा मोड"

#: kmag.cpp:194
msgid "Magnify mouse area to left screen edge"
msgstr "माउस क्षेत्र बायाँ पर्दा किनारामा अभिवर्धन गर्नुहोस्"

#: kmag.cpp:195
msgid ""
"In this mode the area around the mouse is magnified to the left screen edge."
msgstr ""
"यो मोडमा माउस वरिपरिको बायाँको क्षेत्र पर्दाको बायाँ किनारामा अभिवर्धन हुनेछ ।"

#: kmag.cpp:197
msgid "&Right Screen Edge Mode"
msgstr "पर्दाको दायाँ किनारा मोड"

#: kmag.cpp:199
msgid "Magnify mouse area to right screen edge"
msgstr "माउसको क्षेत्र दायाँ पर्दा किनारामा अभिवर्धन गर्नुहोस्"

#: kmag.cpp:200
msgid ""
"In this mode the area around the mouse is magnified to the right screen edge."
msgstr "यो मोडमा माउस वरिपरिको क्षेत्र दायाँ पर्दा किनारामा अभिवर्धन हुनेछ ।"

#: kmag.cpp:202
msgid "&Bottom Screen Edge Mode"
msgstr "पर्दा किनाराको तल्लो मोड"

#: kmag.cpp:204
msgid "Magnify mouse area to bottom screen edge"
msgstr "माउस क्षेत्र पर्दा किनाराको तलतिर अभिवर्धन गर्नुहोस्"

#: kmag.cpp:205
msgid ""
"In this mode the area around the mouse is magnified to the bottom screen edge."
msgstr "यो मोडमा माउस वरिपरिको क्षेत्र पर्दा किनाराको तलतिर अभिवर्धन हुनेछ ।"

#: kmag.cpp:207
msgid "Hide Mouse &Cursor"
msgstr "माउस कर्सर लुकाउनुहोस्"

#: kmag.cpp:210
msgid "Show Mouse &Cursor"
msgstr "माउस कर्सर देखाउनुहोस्"

#: kmag.cpp:212
msgid "Hide the mouse cursor"
msgstr "माउस कर्सर लुकाउनुहोस्"

#: kmag.cpp:215
msgid "Click on this button to <b>zoom-in</b> on the selected region."
msgstr "चयन गरिएको क्षेत्रमा <b>जूम बढाउन</b> यो बटनमा क्लिक गर्नुहोस् ।"

#: kmag.cpp:219
msgid "Select the zoom factor."
msgstr "जूम गर्ने तत्व चयन गर्नुहोस् ।"

#: kmag.cpp:220
msgid "Zoom factor"
msgstr "जूम गर्ने तत्व"

#: kmag.cpp:223
msgid "Click on this button to <b>zoom-out</b> on the selected region."
msgstr "चयन गरिएको क्षेत्रमा <b>जूम घटाउन</b> यो बटनमा क्लिक गर्नुहोस् ।"

#: kmag.cpp:225
msgid "&Invert Colors"
msgstr "रङ उल्टाउनुहोस्"

#: kmag.cpp:228
msgid "&Rotation"
msgstr "परिक्रमण"

#: kmag.cpp:230
msgid "Select the rotation degree."
msgstr "परिक्रमण डिग्री चयन गर्नुहोस् ।"

#: kmag.cpp:231
msgid "Rotation degree"
msgstr "परिक्रमण डिग्री"

#: kmag.cpp:239
msgid "Re&fresh"
msgstr "ताजा पार्नुहोस्"

#: kmag.cpp:241
msgid ""
"Select the refresh rate. The higher the rate, the more computing power (CPU) "
"will be needed."
msgstr ""
"ताजा पार्ने दर चयन गर्नुहोस् । उच्च दरका लागि, बढी कम्प्युटर सामर्थ्य (CPU) "
"आवश्यक हुनेछ ।"

#: kmag.cpp:242
msgid "Refresh rate"
msgstr "ताजा पार्ने दर"

#: kmag.cpp:560
msgid "Save Snapshot As"
msgstr "स्न्यापसटका रुपा बचत गर्नुहोस्"

#: kmag.cpp:567
msgid ""
"Unable to save temporary file (before uploading to the network file you "
"specified)."
msgstr ""
"अस्थायी फाइल बचत गर्न असफल (तपाईँले निर्दिष्ट गरेका फाइल सञ्जालमा अपलोड गर्नु "
"भन्दा पहिले) ।"

#: kmag.cpp:568 kmag.cpp:572 kmag.cpp:584
msgid "Error Writing File"
msgstr "त्रुटि लेख्ने फाइल"

#: kmag.cpp:571
msgid "Unable to upload file over the network."
msgstr "सञ्जालमा फाइल अनलोड गर्न असफल ।"

#: kmag.cpp:574 kmag.cpp:586
#, c-format
msgid ""
"Current zoomed image saved to\n"
"%1"
msgstr ""
"हालै जूम गरिएको फाइल\n"
"%1 बचत गरियो"

#: kmag.cpp:583
msgid ""
"Unable to save file. Please check if you have permission to write to the "
"directory."
msgstr ""
"फाइल बचत गर्न असफल । कृपया तपाईँलाई डाइरेक्टरीमा लेख्न अनुमति भएमा जाँच "
"गर्नुहोस् ।"

#: kmag.cpp:603
msgid "Click to stop window update"
msgstr "सञ्झ्याल अद्यावधिक बन्द  गर्न क्लिक गर्नुहोस्"

#: kmag.cpp:606
msgid "Start"
msgstr "सुरुआत"

#: kmag.cpp:607
msgid "Click to start window update"
msgstr "सञ्झ्याल अद्यावधिक सुरु गर्न क्लिक गर्नुहोस्"

#: kmag.cpp:637
msgid "Magnify to Screen Edge - Select Size"
msgstr "चयन साइज पर्दा किनारामा अभिवर्धन गर्नुहोस्"

#: kmag.cpp:638 kmag.cpp:654 kmag.cpp:670 kmag.cpp:686
msgid "Size:"
msgstr "साइज:"

#: kmag.cpp:653
msgid "Magnify to Left Screen Edge - Select Size"
msgstr "बायाँ पर्दा किनारामा अभिवर्धन गर्नुहोस् - साइज चयन"

#: kmag.cpp:669
msgid "Magnify to Right Screen Edge - Select Size"
msgstr "दायाँ पर्दा किनारामा अभिवर्धन गर्नुहोस् - साइज चयन"

#: kmag.cpp:685
msgid "Magnify to Bottom Screen Edge - Select Size"
msgstr "तल्लो पर्दा किनारामा अभिवर्धन गर्नुहोस् - साइज चयन"
