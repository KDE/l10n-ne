#: kvaio.cpp:158
msgid "Memory Stick inserted"
msgstr "स्मृति स्टिक घुसाइयो"

#: kvaio.cpp:161
msgid "Memory Stick ejected"
msgstr "स्मृति स्टिक निकालियो"

#: kvaio.cpp:170
msgid "Unhandled event: "
msgstr "अनह्यान्डल घटना: "

#: kvaio.cpp:387
msgid "AC Connected"
msgstr "AC जडान गरियो"

#: kvaio.cpp:387
msgid "AC Disconnected"
msgstr "AC जडान विच्छेद गरियो"

#: kvaio.cpp:393
msgid "Battery is Fully Charged. "
msgstr "ब्याट्रि पूर्ण चार्ज भयो "

#: kvaio.cpp:400
msgid "Caution: Battery is Almost Empty (%1% remaining)."
msgstr "सावधान: ब्याट्रि लगभग खाली छ (%1% बाकी)"

#: kvaio.cpp:403
msgid "Alert: Battery is Empty!"
msgstr "चेतावनी: ब्याट्रि रित्तो छ !"

#: kvaio.cpp:406
msgid "No Battery Inserted."
msgstr "ब्याट्रि घुसाएको छैन"

#: kvaio.cpp:409
msgid "Remaining Battery Capacity: %1%"
msgstr "ब्याट्रिको बाकी क्षमता: %1%"

#: kvaio.cpp:434 kvaio.cpp:447
msgid "Brightness"
msgstr "चम्किलोपन"

#: kvaio.cpp:455
msgid "Volume"
msgstr "भोल्युम"

#: kvaio.cpp:481 kvaio.cpp:548
msgid "Starting KMix..."
msgstr "KMix सुरु गर्दैछ..."

#: kvaio.cpp:500 kvaio.cpp:571
msgid "It seems that KMix is not running."
msgstr "KMix चलिरहेको जस्तो देखिदैन"

#: kvaio.cpp:592
msgid "Mute on"
msgstr "मौन पार्नुहोस्"

#: kvaio.cpp:595
msgid "Mute off"
msgstr "मौन हटाउनुहोस्"

